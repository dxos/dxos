// Base tsconfig for all projects.
// Don't rename it tsconfig.json. This is specifically non-standard name so TSC doesn't pick it up.
{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "allowJs": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react",
    "rewriteRelativeImportExtensions": true,
    "lib": ["DOM", "ESNext"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noImplicitOverride": true,
    "outDir": "${configDir}/dist/types",
    "types": ["node", "wicg-file-system-access"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedSideEffectImports": false,
    "stripInternal": true,
    "target": "ESNext",

    // Set this to true if you are having performance issues with the Typescript Language Server.
    // See: https://www.typescriptlang.org/docs/handbook/release-notes/typescript-3-7.html#build-free-editing-with-project-references
    "disableSourceOfProjectReferenceRedirect": false,
    "disableReferencedProjectLoad": false,

    "plugins": [
      {
        "name": "@effect/language-service",
        // Force namespace imports instead of named imports.
        // Example: import * as Effect from "effect"
        // Why: namespace imports avoid name collisions and tend to tree-shake better,
        // especially with bundlers like esbuild.
        "namespaceImportPackages": ["effect", "@effect/*"],

        // When a symbol is re-exported through a barrel (e.g. index.ts),
        // the language service will "follow" the re-export and import directly
        // from the original file where the symbol is defined,
        // instead of importing from the barrel.
        "topLevelNamedReexports": "follow",

        // Effect diagnostics gate the build at warning and error, which is the default.
        // The rules below are off ONLY because they have a standing backlog, and every
        // one is meant to come back on as soon as its findings are cleared. Off rather
        // than reported-and-ignored, so what still fires is actionable and a green build
        // means something. Each TODO is scheduled work, not a settled preference: clear
        // the findings, flip the rule, delete the line.
        //
        // Style suggestions stay in the editor and out of build logs: 1529 of them
        // across the repo would bury everything else.
        "includeSuggestionsInTsc": false,
        "diagnosticSeverity": {
          // TODO(wittjosiah): Re-enable once cleared. Untagged errors in the failure
          // channel, 340 findings across the two.
          "globalErrorInEffectFailure": "off",
          "globalErrorInEffectCatch": "off",
          // TODO(wittjosiah): Re-enable once cleared. Stacked Effect.provide calls,
          // 82 findings.
          "multipleEffectProvide": "off",
          // TODO(wittjosiah): Re-enable once cleared. Fires on the generic capability
          // factories, always naming the MultiTag arm of AnyTag. Ruled out by experiment:
          // a minimal generic Effect parameter does not fire, nor does the type
          // parameter's default, the `any` in AnyTag, or Contributions<T> as MultiTag's
          // key value. Removing the MultiTag arm clears it, so the cause is in how a
          // multi capability's identifier reaches Requirements.
          "missingEffectContext": "off",
          // TODO(wittjosiah): Re-enable once cleared. 7 findings across the three,
          // so these are the cheapest to retire.
          "unknownInEffectCatch": "off",
          "layerMergeAllWithDependencies": "off",
          "lazyPromiseInEffectSync": "off"
        }
      }
    ]
  },
  "exclude": ["build", "dist", "node_modules", "out"],
  "include": [],
  "ts-node": {
    "swc": true
  }
}
