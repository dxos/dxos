{
  "permissions": {
    "allow": ["mcp__Trunk__search-test", "mcp__Trunk__investigate-ci-failure", "mcp__Trunk__detect-frameworks"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}/.claude/hooks/guard-worktree.sh\"",
            "statusMessage": "Checking worktree boundary"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}/.claude/hooks/guard-branch.sh\"",
            "statusMessage": "Checking branch/worktree safety"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}/.claude/hooks/mode.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}/.claude/hooks/autonomous.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dxos:composer",
            "tool": "sessions_report",
            "input": {
              "sessionId": "${session_id}",
              "state": "running",
              "worktree": "${cwd}"
            },
            "statusMessage": "Reporting session to Composer"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}/.claude/hooks/autonomous-stop.sh\"",
            "statusMessage": "Checking autonomous mode"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dxos:composer",
            "tool": "sessions_report",
            "input": {
              "sessionId": "${session_id}",
              "state": "running",
              "lastMessage": "${last_assistant_message}",
              "worktree": "${cwd}"
            },
            "statusMessage": "Checking in to Composer"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "logout|prompt_input_exit|other",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dxos:composer",
            "tool": "sessions_report",
            "input": {
              "sessionId": "${session_id}",
              "state": "finished",
              "worktree": "${cwd}"
            },
            "statusMessage": "Closing session in Composer"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "dxos@dxos": true
  },
  "extraKnownMarketplaces": {
    "dxos": {
      "source": {
        "source": "github",
        "repo": "dxos/dxos"
      }
    }
  }
}
