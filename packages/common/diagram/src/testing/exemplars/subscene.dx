scene subscene dim=2d layout=main name="Sub-scene" theme=flat {
  camera center=192,0 zoom=1
}

layout main dim=2d model=parts {
  element a rect "A" @ 0,0 size=96x96 color=blue fill=solid stroke=solid corners=all
  element b detail "B" @ 192,0 size=192x192 color=green fill=tint stroke=solid corners=all
  element c rect "C" @ 384,0 size=96x96 color=amber fill=solid stroke=solid corners=all
  element ab link from=a to=b end=arrow
  element bc link from=b to=c end=arrow
}

layout b-detail dim=2d name="B detail" {
  element x rect "X" @ 0,0 size=96x96 color=green fill=solid stroke=solid corners=all
  element y ellipse "Y" @ 192,0 size=96x96 color=green fill=solid stroke=solid
  element xy link from=x to=y end=arrow
}

model parts dim=2d {
  object detail view parts=b-detail
}
