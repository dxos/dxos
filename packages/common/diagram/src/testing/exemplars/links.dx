scene links dim=2d layout=links name="Links" theme=flat {
  camera center=192,0 zoom=1
}

layout links dim=2d model=shapes {
  element a box "A" @ 0,0 color=blue
  element b box "B" @ 192,0 color=green
  element c box "C" @ 384,0 color=amber
  element ab link from=a to=b end=arrow
  element bc link from=b to=c end=arrow
}

model shapes dim=2d {
  object box rect size=96x96 fill=solid stroke=solid corners=all
}
