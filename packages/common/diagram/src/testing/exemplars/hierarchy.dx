scene org dim=3d layout=org name="Organization" theme=presentation {
  camera target=0,0,0 yaw=-45 pitch=30 distance=24 fov=0.8 projection=perspective
}

layout org dim=3d model=teams {
  element eng engineering "Engineering" @ -5,0,0 scale=8
  element ops operations "Operations" @ 5,0,0 scale=8
  element works link from=eng to=ops
}

layout team-a dim=3d model=teams name="Engineering" {
  element hub sphere "Hub" @ 0,0,0 scale=1.2 hue=blue surface=solid
  element s1 sphere @ 3,0,0 scale=0.6 hue=blue surface=solid
  element s2 sphere @ -1.5,0,2.598 scale=0.6 hue=blue surface=solid
  element sub platform "Platform" @ -1.5,0,-2.598 scale=2.4
  element team group members="s1 s2 sub" arrange=ring arrange-radius=3
  element l1 link from=hub to=s1
  element l2 link from=hub to=s2
  element l3 link from=hub to=sub
}

layout team-c dim=3d name="Platform" {
  element hub sphere "Hub" @ 0,0,0 scale=1.2 hue=indigo surface=solid
  element s1 sphere @ 3,0,0 scale=0.6 hue=indigo surface=solid
  element s2 sphere @ -1.5,0,2.598 scale=0.6 hue=indigo surface=solid
  element s3 sphere @ -1.5,0,-2.598 scale=0.6 hue=indigo surface=solid
  element team group members="s1 s2 s3" arrange=ring arrange-radius=3
  element l1 link from=hub to=s1
  element l2 link from=hub to=s2
  element l3 link from=hub to=s3
}

layout team-b dim=3d name="Operations" {
  element hub sphere "Hub" @ 0,0,0 scale=1.2 hue=teal surface=solid
  element s1 sphere @ 3,0,0 scale=0.6 hue=teal surface=solid
  element s2 sphere @ -1.5,0,2.598 scale=0.6 hue=teal surface=solid
  element s3 sphere @ -1.5,0,-2.598 scale=0.6 hue=teal surface=solid
  element team group members="s1 s2 s3" arrange=ring arrange-radius=3
  element l1 link from=hub to=s1
  element l2 link from=hub to=s2
  element l3 link from=hub to=s3
}

model teams dim=3d {
  object engineering sphere parts=team-a hue=violet surface=glass
  object platform sphere parts=team-c hue=indigo surface=glass
  object operations sphere parts=team-b hue=teal surface=glass
}
