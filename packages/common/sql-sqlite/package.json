{
  "name": "@dxos/sql-sqlite",
  "version": "0.12.0",
  "description": "Sqlite client",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "info@dxos.org",
  "sideEffects": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "default": "./dist/lib/index.mjs"
    },
    "./SqliteClient": {
      "types": "./dist/types/src/SqliteClient.d.ts",
      "default": "./dist/lib/SqliteClient.mjs"
    },
    "./OpfsPool": {
      "types": "./dist/types/src/OpfsPool.d.ts",
      "default": "./dist/lib/OpfsPool.mjs"
    },
    "./OpfsWorker": {
      "types": "./dist/types/src/OpfsWorker.d.ts",
      "default": "./dist/lib/OpfsWorker.mjs"
    },
    "./SqliteMigrator": {
      "types": "./dist/types/src/SqliteMigrator.d.ts",
      "default": "./dist/lib/SqliteMigrator.mjs"
    },
    "./platform": {
      "types": "./dist/types/src/platform/browser.d.ts",
      "browser": "./dist/lib/platform/browser.mjs",
      "bun": "./dist/lib/platform/bun.mjs",
      "node": "./dist/lib/platform/node.mjs"
    },
    "./SqlExport": {
      "types": "./dist/types/src/SqlExport.d.ts",
      "default": "./dist/lib/SqlExport.mjs"
    },
    "./SqlTransaction": {
      "types": "./dist/types/src/SqlTransaction.d.ts",
      "default": "./dist/lib/SqlTransaction.mjs"
    },
    "./SqlMigrations": {
      "types": "./dist/types/src/SqlMigrations.d.ts",
      "default": "./dist/lib/SqlMigrations.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@dxos/effect": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/node-std": "workspace:*",
    "@dxos/wa-sqlite": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/sql-sqlite-wasm": "catalog:",
    "@effect/wa-sqlite": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "beast": {}
}
