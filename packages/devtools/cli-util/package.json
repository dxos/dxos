{
  "name": "@dxos/cli-util",
  "version": "0.12.0",
  "description": "Shared CLI utilities for DXOS CLI commands and plugins",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#platform": {
      "source": {
        "node": "./src/util/platform.node.ts",
        "default": "./src/util/platform.browser.ts"
      },
      "types": "./dist/types/src/util/platform.node.d.ts",
      "node": "./dist/lib/util/platform.node.mjs",
      "default": "./dist/lib/util/platform.browser.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./callback": {
      "source": "./src/callback/index.ts",
      "types": "./dist/types/src/callback/index.d.ts",
      "import": "./dist/lib/callback.mjs"
    },
    "./oauth": {
      "source": "./src/oauth/index.ts",
      "types": "./dist/types/src/oauth/index.d.ts",
      "import": "./dist/lib/oauth.mjs"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "import": "./dist/lib/testing.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/client": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/edge-client": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/protocols": "workspace:*",
    "@dxos/util": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "get-port-please": "catalog:"
  },
  "devDependencies": {
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
