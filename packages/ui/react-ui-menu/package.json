{
  "name": "@dxos/react-ui-menu",
  "version": "0.11.1",
  "description": "Components for facilitating reactive and consistent menus.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
