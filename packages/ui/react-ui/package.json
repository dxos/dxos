{
  "name": "@dxos/react-ui",
  "version": "0.11.1",
  "description": "Low-level React components for DXOS, applying a theme to a core group of primitives",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "import": "./dist/lib/testing.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@ark-ui/react": "catalog:",
    "@dxos/async": "workspace:*",
    "@dxos/i18n": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/lit-ui": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/react-error-boundary": "workspace:*",
    "@dxos/react-focus": "workspace:*",
    "@dxos/react-hooks": "workspace:*",
    "@dxos/react-input": "workspace:*",
    "@dxos/ui-types": "workspace:*",
    "@dxos/util": "workspace:*",
    "@internationalized/date": "catalog:",
    "@radix-ui/react-alert-dialog": "catalog:",
    "@radix-ui/react-context": "catalog:",
    "@radix-ui/react-context-menu": "catalog:",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-dismissable-layer": "catalog:",
    "@radix-ui/react-focus-guards": "catalog:",
    "@radix-ui/react-focus-scope": "catalog:",
    "@radix-ui/react-menu": "catalog:",
    "@radix-ui/react-popper": "catalog:",
    "@radix-ui/react-portal": "catalog:",
    "@radix-ui/react-presence": "catalog:",
    "@radix-ui/react-primitive": "catalog:",
    "@radix-ui/react-select": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-toast": "catalog:",
    "aria-hidden": "catalog:",
    "date-fns": "catalog:",
    "dompurify": "catalog:",
    "error-stack-parser": "catalog:",
    "i18next": "catalog:",
    "react-aria-components": "catalog:",
    "react-error-boundary": "catalog:",
    "react-i18next": "catalog:",
    "react-remove-scroll": "catalog:"
  },
  "devDependencies": {
    "@dxos/random": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@dxos/util": "workspace:*",
    "@phosphor-icons/react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/ui-theme": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
