{
  "name": "@dxos/brand",
  "version": "0.11.1",
  "description": "DXOS brand assets.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./channels": {
      "source": "./src/channels.ts",
      "types": "./dist/types/src/channels.d.ts",
      "import": "./dist/lib/channels.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "channels": [
        "dist/types/src/channels.d.ts"
      ]
    }
  },
  "files": [
    "assets",
    "dist",
    "src"
  ],
  "devDependencies": {
    "@dxos/log": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@phosphor-icons/react": "catalog:",
    "@rive-app/react-canvas": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/d3": "catalog:",
    "d3": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "@dxos/ui-theme": "workspace:^",
    "@phosphor-icons/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
