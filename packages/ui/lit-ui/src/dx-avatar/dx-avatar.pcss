/* Tailwind v4: Fixed @apply directives - converted to direct CSS */
.dx-avatar-group {
  display: inline-flex;
  align-items: center;
  padding-right: 0.5rem;
}

.dx-avatar-group .dx-lit-avatar {
  margin-right: -0.5rem;
}

.dx-avatar-group .dx-lit-avatar {
  &[size='0'],
  &[size='px'],
  &[size='0.5'],
  &[size='1'],
  &[size='1.5'],
  &[size='2'],
  &[size='2.5'] {
    margin-right: -0.25rem;
  }
}

dx-avatar {
  display: contents;
}

.dx-lit-avatar {
  position: relative;
  display: inline-flex;
  flex-shrink: 0;
  /* Tailwind v4 migration: converted @apply to direct CSS properties */

  .dx-lit-avatar__frame {
    width: 100%;
    height: 100%;
  }

  .dx-lit-avatar__frame,
  .dx-lit-avatar__ring {
    border-radius: 9999px;
  }

  &[data-variant='square'] {
    .dx-lit-avatar__frame,
    .dx-lit-avatar__ring {
      border-radius: 0.125rem;
    }
  }

  .dx-lit-avatar__status-icon {
    position: absolute;
    bottom: 0;
    right: 0;
  }

  .dx-lit-avatar__ring {
    position: absolute;
    inset: 0;
    border-width: 2px;
    border-color: var(--surface-bg);
  }

  &[data-status='active'] .dx-lit-avatar__ring {
    border-color: var(--color-success-border);
  }

  &[data-status='inactive'] .dx-lit-avatar__ring {
    border-color: var(--color-neutral-border);
  }

  &[data-status='current'] .dx-lit-avatar__ring {
    border-color: var(--color-focus-ring);
  }

  &[data-status='internal'] .dx-lit-avatar__ring {
    border-color: var(--color-separator);
  }

  &[data-status='error'] .dx-lit-avatar__ring {
    border-color: var(--color-error-border);
  }

  &[data-status='warning'] .dx-lit-avatar__ring {
    border-color: var(--color-warning-border);
  }

  &[data-animation='pulse'] .dx-lit-avatar__ring {
    animation: halo-pulse var(--duration, 1s) ease-in-out infinite;
  }

  &[data-state-loading-status='loaded'] {
    .dx-lit-avatar__fallback-text,
    .dx-lit-avatar__status-icon {
      display: none;
    }
  }

  &[data-state-loading-status='error'] {
    .dx-lit-avatar__image {
      display: none;
    }
  }
}
