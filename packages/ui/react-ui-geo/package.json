{
  "name": "@dxos/react-ui-geo",
  "version": "0.10.0",
  "description": "Geo components.",
  "homepage": "https://github.com/dxos",
  "bugs": "https://github.com/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#translations": "./src/translations.ts"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./data": {
      "source": "./src/data.ts",
      "types": "./dist/types/src/data.d.ts",
      "import": "./dist/lib/data.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "files": [
    "data",
    "dist",
    "src"
  ],
  "dependencies": {
    "@dxos/debug": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/node-std": "workspace:*",
    "@radix-ui/react-context": "catalog:",
    "@types/topojson-specification": "catalog:",
    "d3": "catalog:",
    "geojson": "catalog:",
    "leaflet": "catalog:",
    "react-leaflet": "catalog:",
    "react-resize-detector": "catalog:",
    "topojson-client": "catalog:",
    "topojson-simplify": "catalog:",
    "versor": "catalog:"
  },
  "devDependencies": {
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/d3": "catalog:",
    "@types/geojson": "catalog:",
    "@types/leaflet": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/topojson-client": "catalog:",
    "@types/topojson-simplify": "catalog:",
    "JSONStream": "catalog:",
    "geojson2h3": "catalog:",
    "leva": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
