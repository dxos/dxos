diagram kind=sequence
node A "client A" ref="packages/core/echo/echo-sqlite-sync/src/sync.ts"
node DO "SpaceObject" ref="packages/core/echo/echo-sync-worker/src/space-object.ts"
node B "client B" ref="packages/core/echo/echo-sqlite-sync/src/sync.ts"
edge B sends DO "push x base=2"
edge DO sends B "ack accepted, x@5"
edge DO sends A "records x@5"
edge A sends DO "push x base=2"
edge DO sends A "ack rejected [x]"
note A "merge3(x@2, mine, x@5)"
edge A sends DO "push x base=5"
edge DO sends A "ack accepted, x@6"
edge DO sends B "records x@6"
