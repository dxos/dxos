diagram flow=down
group main "port and data model" {
  node Fact "Fact" ref="packages/core/echo/echo-memory/src/Fact.ts"
  node Query "MemoryQuery" ref="packages/core/echo/echo-memory/src/MemoryQuery.ts"
  node Port "RdfStore" ref="packages/core/echo/echo-memory/src/RdfStore.ts"
}
group rdf "RDF mapping (n3)" {
  node Mapping "Mapping" ref="packages/core/echo/echo-memory/src/Mapping.ts"
  node Graph "Graph" ref="packages/core/echo/echo-memory/src/Graph.ts"
  node Sparql "Sparql" ref="packages/core/echo/echo-memory/src/Sparql.ts"
  node Ontology "Ontology" ref="packages/core/echo/echo-memory/src/Ontology.ts"
}
group users "consumers" {
  node Pipeline "pipeline-rdf"
  node Core "RdfMemory"
}
edge Mapping -> Fact
edge Graph -> Mapping
edge Sparql -> Query
edge Sparql -> Mapping
edge Mapping -> Ontology
edge Pipeline -> Sparql
edge Core -> Sparql
edge Core -> Port
