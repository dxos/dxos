{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["../../../../node_modules/@stryker-mutator/vitest-runner/dist/src/index.js"],
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "coverageAnalysis": "perTest",
  "inPlace": true,
  "mutate": ["src/util/migrate-document.ts", "src/query/query-result-cache.ts"],
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "ignoreStatic": true,
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-core.json"
}
