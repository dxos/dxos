{
  "name": "@dxos/plugin-host-cloudflare",
  "version": "0.16.0",
  "private": true,
  "description": "Hosts Composer plugins inside a Cloudflare Dynamic Worker on EDGE.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "info@dxos.org",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./bundle": {
      "source": "./src/bundle/index.ts",
      "types": "./dist/types/src/bundle/index.d.ts",
      "import": "./dist/lib/bundle.mjs"
    },
    "./bundler": {
      "source": "./src/bundler/index.ts",
      "types": "./dist/types/src/bundler/index.d.ts",
      "import": "./dist/lib/bundler.mjs"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "import": "./dist/lib/testing.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "bundler": [
        "dist/types/src/bundler/index.d.ts"
      ],
      "testing": [
        "dist/types/src/testing/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {},
  "dependencies": {
    "@dxos/ai": "workspace:*",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/compute-runtime": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/edge-compute": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/functions-runtime-cloudflare": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/protocols": "workspace:*",
    "@dxos/util": "workspace:*",
    "effect": "catalog:",
    "esbuild": "catalog:",
    "miniflare": "catalog:",
    "oxc-parser": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "vitest": "catalog:"
  }
}
