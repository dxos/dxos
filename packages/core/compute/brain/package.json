{
  "name": "@dxos/brain",
  "version": "0.12.0",
  "description": "Agent brain: pipeline-rdf facts encoded as Datalog relations, a canonical predicate vocabulary, goal built-ins and an incremental goal-rule evaluator.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./Builtins": {
      "source": "./src/Builtins.ts",
      "types": "./dist/types/src/Builtins.d.ts",
      "import": "./dist/lib/Builtins.mjs"
    },
    "./CompilePrompt": {
      "source": "./src/CompilePrompt.ts",
      "types": "./dist/types/src/CompilePrompt.d.ts",
      "import": "./dist/lib/CompilePrompt.mjs"
    },
    "./Compiler": {
      "source": "./src/Compiler.ts",
      "types": "./dist/types/src/Compiler.d.ts",
      "import": "./dist/lib/Compiler.mjs"
    },
    "./Encoding": {
      "source": "./src/Encoding.ts",
      "types": "./dist/types/src/Encoding.d.ts",
      "import": "./dist/lib/Encoding.mjs"
    },
    "./GoalRules": {
      "source": "./src/GoalRules.ts",
      "types": "./dist/types/src/GoalRules.d.ts",
      "import": "./dist/lib/GoalRules.mjs"
    },
    "./Vocabulary": {
      "source": "./src/Vocabulary.ts",
      "types": "./dist/types/src/Vocabulary.d.ts",
      "import": "./dist/lib/Vocabulary.mjs"
    },
    "./package.json": "./package.json",
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "import": "./dist/lib/testing.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@dxos/datalog": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/pipeline-rdf": "workspace:*",
    "@dxos/util": "workspace:*"
  },
  "devDependencies": {
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
