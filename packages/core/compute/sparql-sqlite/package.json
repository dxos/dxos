{
  "name": "@dxos/sparql-sqlite",
  "version": "0.17.0",
  "description": "SPARQL 1.1 engine that compiles each query to a single SQLite statement over an interned quad store (Durable Object SQLite or node:sqlite).",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "info@dxos.org",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "import": "./dist/lib/testing.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@dxos/errors": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "sparqljs": "catalog:"
  },
  "devDependencies": {
    "@comunica/query-sparql-rdfjs": "catalog:",
    "@dxos/sql-sqlite": "workspace:*",
    "@types/n3": "catalog:",
    "@types/sparqljs": "catalog:",
    "effect": "catalog:",
    "esbuild": "catalog:",
    "fast-xml-parser": "catalog:",
    "n3": "catalog:",
    "oxigraph": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
