<?xml version="1.0"?>
<sparql xmlns="http://www.w3.org/2005/sparql-results#">
  <head>
    <variable name="g"/>
    <variable name="x"/>
  </head>
  <results>
    <result>
      <binding name="g"><uri>http://example.org/g1</uri></binding>
      <binding name="x"><literal datatype="http://www.w3.org/2001/XMLSchema#integer">1</literal></binding>
    </result>
    <result>
      <binding name="g"><uri>http://example.org/g1</uri></binding>
      <binding name="x"><literal datatype="http://www.w3.org/2001/XMLSchema#integer">2</literal></binding>
    </result>
  </results>
</sparql>
