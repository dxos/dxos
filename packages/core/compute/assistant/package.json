      "import": "./dist/lib/session/AiContext.mjs"
    },
    "./AiRequest": {
      "source": "./src/request/AiRequest.ts",
      "types": "./dist/types/src/request/AiRequest.d.ts",
      "import": "./dist/lib/request/AiRequest.mjs"
    },
    "./AiSession": {
      "source": "./src/session/AiSession.ts",
      "types": "./dist/types/src/session/AiSession.d.ts",
      "import": "./dist/lib/session/AiSession.mjs"
    },
    "./Alarm": {
      "source": "./src/session/Alarm.ts",
      "types": "./dist/types/src/session/Alarm.d.ts",
      "import": "./dist/lib/session/Alarm.mjs"
    },
    "./ExecutionGraph": {
      "source": "./src/util/execution-graph.ts",
