    },
    "./Harness": {
      "source": "./src/session/Harness.ts",
      "types": "./dist/types/src/session/Harness.d.ts",
      "import": "./dist/lib/session/Harness.mjs"
    },
    "./SessionLink": {
      "source": "./src/session/SessionLink.ts",
      "types": "./dist/types/src/session/SessionLink.d.ts",
      "import": "./dist/lib/session/SessionLink.mjs"
    },
    "./SkillHooks": {
      "source": "./src/session/SkillHooks.ts",
      "types": "./dist/types/src/session/SkillHooks.d.ts",
      "import": "./dist/lib/session/SkillHooks.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "files": [
    "dist",
    "src"
