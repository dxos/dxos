{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-core.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "coverageAnalysis": "perTest",
  "inPlace": true,
  "mutate": [
    "src/ProcessManager.ts",
    "src/ProcessHandle.ts",
    "src/process-store.ts",
    "src/triggers/trigger-dispatcher.ts"
  ],
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "concurrency": 6,
  "timeoutMS": 60000,
  "tempDirName": ".stryker-tmp",
  "plugins": ["../../../../node_modules/@stryker-mutator/vitest-runner/dist/src/index.js"],
  "ignoreStatic": true
}
