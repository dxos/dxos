{
  "name": "@dxos/pipeline-rdf",
  "version": "0.12.0",
  "description": "Pipeline stages that extract attributed propositions from text into an RDF fact store and answer SPARQL queries over them.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "info@dxos.org",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "import": "./dist/lib/testing.mjs"
    },
    "./fact-store": {
      "source": "./src/store/fact-store.ts",
      "types": "./dist/types/src/store/fact-store.d.ts",
      "import": "./dist/lib/fact-store.mjs"
    },
    "./types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "import": "./dist/lib/types.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@comunica/query-sparql-rdfjs": "catalog:",
    "@dxos/ai": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/pipeline": "workspace:*",
    "@dxos/sql-sqlite": "workspace:*",
    "@dxos/util": "workspace:*",
    "asynciterator": "catalog:",
    "n3": "catalog:",
    "sparqljs": "catalog:"
  },
  "devDependencies": {
    "@effect/sql-sqlite-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/n3": "catalog:",
    "@types/sparqljs": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "beast": {}
}
