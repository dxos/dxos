{
  "name": "@dxos/mcp-server",
  "version": "0.11.1",
  "description": "DXOS MCP server: the tool and prompt surface projected from the operation registry.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "info@dxos.org",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./DxMcpService": {
      "source": "./src/DxMcpService.ts",
      "types": "./dist/types/src/DxMcpService.d.ts",
      "import": "./dist/lib/DxMcpService.mjs"
    },
    "./Gateway": {
      "source": "./src/Gateway.ts",
      "types": "./dist/types/src/Gateway.d.ts",
      "import": "./dist/lib/Gateway.mjs"
    },
    "./Server": {
      "source": "./src/Server.ts",
      "types": "./dist/types/src/Server.d.ts",
      "import": "./dist/lib/Server.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@dxos/echo": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "effect": "catalog:",
    "@dxos/compute": "workspace:*"
  },
  "devDependencies": {
    "@dxos/effect": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "beast": {}
}
