// A graph database in the browser, with a Durable Object per space fronting R2 for the copy.
// Deploy: `moon run echo-sqlite-demo:bundle && pnpm exec wrangler deploy -c packages/apps/echo-sqlite-demo/wrangler.jsonc`
// Local:  `moon run echo-sqlite-demo:bundle`, then `pnpm exec wrangler dev` here (local DO and R2).
{
  "name": "echo-sqlite-demo",
  "main": "./src/worker/main.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out/echo-sqlite-demo",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything else is asset-first; only the space API needs the Worker.
    "run_worker_first": ["/api/*"],
  },
  // One object per space id: single-threaded, so concurrent pushes queue instead of racing in R2.
  "durable_objects": {
    "bindings": [{ "name": "SPACE", "class_name": "SpaceObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SpaceObject"] }],
  // The exported SQLite file per space. R2 rather than DO storage: its KV values cap at 128 KiB.
  "r2_buckets": [{ "binding": "SPACES", "bucket_name": "echo-sqlite-demo-spaces" }],
  "observability": { "enabled": true },
}
