---
// The splash home page's header has a Docs link where Starlight puts search; the docs pages keep search.
import Default from '@astrojs/starlight/components/Search.astro';

const isSplash = Astro.locals.starlightRoute.entry.data.template === 'splash';
---

{
  isSplash ? (
    <nav class="links" aria-label="Site">
      <a href="/docs/">Docs</a>
    </nav>
  ) : (
    <Default />
  )
}

<style>
  .links {
    display: flex;
    justify-content: flex-end;
    width: 100%;
    font-size: var(--sl-text-sm);
  }
  .links a {
    color: var(--muted);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--ink);
  }
</style>
