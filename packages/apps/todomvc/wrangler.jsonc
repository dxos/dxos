{
  // Cloudflare Workers (Static Assets) config for todomvc — assets-only (no Worker script).
  // Deployed by .github/workflows/scripts/deploy-env.mjs via `wrangler deploy --config <this> --env <env>`.
  // Local dev: `moon run todomvc:bundle && wrangler dev`.
  "name": "todomvc",
  "compatibility_date": "2024-11-01",
  // Served only on the custom domains in each env; both keys are inherited.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out/todomvc",
    "not_found_handling": "single-page-application",
  },
  "env": {
    "production": {
      "name": "todomvc",
      "routes": [{ "pattern": "todomvc.dxos.network", "custom_domain": true }],
    },
    "preview": {
      "name": "todomvc-preview",
      "routes": [{ "pattern": "preview.todomvc.dxos.network", "custom_domain": true }],
    },
  },
}
