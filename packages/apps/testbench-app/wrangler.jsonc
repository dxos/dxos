{
  // Cloudflare Workers (Static Assets) config for testbench — assets-only (no Worker script).
  // Deployed by .github/workflows/scripts/deploy-env.mjs via `wrangler deploy --config <this> --env <env>`.
  // Local dev: `moon run testbench-app:bundle && wrangler dev`.
  "name": "testbench",
  "compatibility_date": "2024-11-01",
  // Served only on the custom domains in each env; both keys are inherited.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out/testbench-app",
    "not_found_handling": "single-page-application",
  },
  "env": {
    "production": {
      "name": "testbench",
      "routes": [{ "pattern": "testbench.dxos.network", "custom_domain": true }],
    },
    "preview": {
      "name": "testbench-preview",
      "routes": [{ "pattern": "preview.testbench.dxos.network", "custom_domain": true }],
    },
  },
}
