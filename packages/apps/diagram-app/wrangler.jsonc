{
  // Deployed by .github/workflows/scripts/deploy-env.mjs via `wrangler deploy --config <this> --env <env>`.
  // Local dev: `moon run diagram-app:bundle && wrangler dev`.
  "name": "diagram",
  "main": "./src/functions/worker.ts",
  "compatibility_date": "2024-11-01",
  "workers_dev": true,
  // Default / local-dev bindings (wrangler dev); vars and secrets are not inherited, so each env repeats them.
  "vars": {
    "POSTHOG_OTLP_URL": "https://eu.i.posthog.com/i",
  },
  "assets": {
    "directory": "./out/diagram-app",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "env": {
    // On demand, against EDGE preview, as Composer's `dev`.
    "dev": {
      "name": "diagram-dev",
      "vars": { "POSTHOG_OTLP_URL": "https://eu.i.posthog.com/i" },
      "secrets": { "required": ["POSTHOG_PROJECT_TOKEN"] },
    },
    // Daily from `main`, against EDGE production, as Composer's `preview`.
    "preview": {
      "name": "diagram-preview",
      "vars": { "POSTHOG_OTLP_URL": "https://eu.i.posthog.com/i" },
      "secrets": { "required": ["POSTHOG_PROJECT_TOKEN"] },
    },
    "staging": {
      "name": "diagram-staging",
      "vars": { "POSTHOG_OTLP_URL": "https://eu.i.posthog.com/i" },
      "secrets": { "required": ["POSTHOG_PROJECT_TOKEN"] },
    },
  },
}
