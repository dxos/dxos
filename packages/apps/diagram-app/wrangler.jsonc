{
  // Cloudflare Workers (Static Assets) config for the diagram app — assets-only (no Worker script).
  // Deployed by .github/workflows/scripts/deploy-env.mjs via `wrangler deploy --config <this> --env <env>`.
  // Local dev: `moon run diagram-app:bundle && wrangler dev`.
  "name": "diagram",
  "compatibility_date": "2024-11-01",
  // No custom domain yet, so each env serves from `<worker>.dxos.workers.dev`.
  "workers_dev": true,
  "assets": {
    "directory": "./out/diagram-app",
    "not_found_handling": "single-page-application",
  },
  "env": {
    // On demand, against EDGE preview, as Composer's `dev`.
    "dev": { "name": "diagram-dev" },
    // Daily from `main`, against EDGE production, as Composer's `preview`.
    "preview": { "name": "diagram-preview" },
    "staging": { "name": "diagram-staging" },
  },
}
