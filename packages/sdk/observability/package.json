{
  "name": "@dxos/observability",
  "version": "0.12.0",
  "description": "Provides a common interface for app and platform observability",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#storage": {
      "source": {
        "node": "./src/storage/node.ts",
        "default": "./src/storage/browser.ts"
      },
      "types": "./dist/types/src/storage/node.d.ts",
      "node": "./dist/lib/storage.node.mjs",
      "default": "./dist/lib/storage.mjs"
    },
    "#otel-traces": {
      "source": {
        "node": "./src/extensions/otel/traces.ts",
        "default": "./src/extensions/otel/traces-browser.ts"
      },
      "types": "./dist/types/src/extensions/otel/traces.d.ts",
      "node": "./dist/lib/traces.node.mjs",
      "default": "./dist/lib/traces.mjs"
    },
    "#posthog-transport": {
      "source": {
        "node": "./src/extensions/posthog/node.ts",
        "default": "./src/extensions/posthog/node-stub.ts"
      },
      "types": "./dist/types/src/extensions/posthog/node.d.ts",
      "node": "./dist/lib/posthog-transport.node.mjs",
      "default": "./dist/lib/posthog-transport.mjs"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./AiObservability": {
      "types": "./dist/types/src/ai/AiObservability.d.ts",
      "import": "./dist/lib/ai/AiObservability.mjs"
    },
    "./Observability": {
      "types": "./dist/types/src/Observability.d.ts",
      "import": "./dist/lib/Observability.mjs"
    },
    "./ObservabilityClientProvider": {
      "types": "./dist/types/src/providers/ObservabilityClientProvider.d.ts",
      "import": "./dist/lib/providers/ObservabilityClientProvider.mjs"
    },
    "./ObservabilityExtension": {
      "types": "./dist/types/src/ObservabilityExtension.d.ts",
      "import": "./dist/lib/ObservabilityExtension.mjs"
    },
    "./ObservabilityProvider": {
      "types": "./dist/types/src/providers/ObservabilityProvider.d.ts",
      "import": "./dist/lib/providers/ObservabilityProvider.mjs"
    },
    "./OtelLogSink": {
      "types": "./dist/types/src/extensions/otel/OtelLogSink.d.ts",
      "import": "./dist/lib/extensions/otel/OtelLogSink.mjs"
    },
    "./OtelMetricsSink": {
      "types": "./dist/types/src/extensions/otel/OtelMetricsSink.d.ts",
      "import": "./dist/lib/extensions/otel/OtelMetricsSink.mjs"
    },
    "./OtelSpanSink": {
      "types": "./dist/types/src/extensions/otel/OtelSpanSink.d.ts",
      "import": "./dist/lib/extensions/otel/OtelSpanSink.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/types/src/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@dxos/async": "workspace:*",
    "@dxos/client": "workspace:*",
    "@dxos/config": "workspace:*",
    "@dxos/context": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/log-store-idb": "workspace:*",
    "@dxos/node-std": "workspace:*",
    "@dxos/protocols": "workspace:*",
    "@dxos/tracing": "workspace:*",
    "@dxos/util": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:",
    "@opentelemetry/auto-instrumentations-web": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/exporter-logs-otlp-http": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-http": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/instrumentation": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@opentelemetry/sdk-trace-web": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "@posthog/mcp": "catalog:",
    "js-yaml": "catalog:",
    "localforage": "catalog:",
    "posthog-js": "catalog:",
    "posthog-node": "catalog:",
    "uuid": "catalog:",
    "zone.js": "catalog:"
  },
  "devDependencies": {
    "@dxos/ai": "workspace:*",
    "@dxos/client-services": "workspace:*",
    "@dxos/network-manager": "workspace:*",
    "@types/js-yaml": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
