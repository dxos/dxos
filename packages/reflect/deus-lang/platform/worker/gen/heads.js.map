/-- Answers `/v1/<project>/headlog/<branch>` for `request`: every head the branch had, oldest first, one
  `<ms>-<causal>` per line. Only pushes write the log. -/
def Worker.Heads.serveLog
    (request : Js)
    (bucket : Js)
    (project : Text)
    (rest : List Text)
    : {Async} Js := if Http.method request != "GET" then Http.problem 405 "the head log is written only by pushes" else
  let segments := List.filter (fun segment => not (Text.isEmpty segment)) rest
  let branch := Text.join "/" (List.map
    (fun part => Js.toText (Js.call (Js.global "decodeURIComponent") [Js.text part]))
    segments)
  if not (isBranch branch) then Http.problem 404 "the head log is read as /headlog/<branch>"
    else Http.lines (List.filter isLogged (listAll bucket (headLogKey project branch)))