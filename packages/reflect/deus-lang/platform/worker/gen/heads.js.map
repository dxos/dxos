/-- What a refusal tells the pusher to do. -/
def Worker.Heads.refusalMessage (refusal : Refusal) : Text :=
  match refusal with
  | Refusal.unclaimed => "a push must name the head it builds on (x-deus-claim); update deus by merging #13952"
  | Refusal.malformed => "x-deus-claim is `<branch> <head> <base>[,<base>…]`"
  | Refusal.outdated branch required sent => branch ++ " needs a deus with data-safety epoch " ++ Int.toText required ++
      " (Safety.epoch) or newer, and this one has " ++ Int.toText sent ++ ": its merge or push may lose data; update deus by merging #13952, then push again"
  | Refusal.overtaken branch head => branch ++ " moved to #" ++ Text.take 10 head ++
      " since you pulled; run `deus pull` and `deus merge`, then push again"