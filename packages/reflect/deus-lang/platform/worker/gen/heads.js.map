/-- Moves `claim.branch` as the claim asks, if it may (D167, D181): reads the current head through `readCurrent` (in
  JavaScript, a branch to a promise of `{causal, etag}` or `undefined`, which also reads heads older than D181), asks
  `epochAt` (a head to a promise of the epoch it asks for) only when the head would change, decides by `verdict`, and
  writes and logs the move by a conditional write, so of two pushes from one head exactly one moves it. -/
def Worker.Heads.moveHead (bucket : Js) (project : Text) (claim : Claim) (sent : Int) (keyId : Option Text) (readCurrent : Text -> Js) (epochAt : Text -> Js) : {Async} Moved :=
  let current := toOption (Async.await (readCurrent (Claim.branch claim)))
  let causal := Option.map (fun c => Js.toText (Js.get c "causal")) current
  let required :=
    match causal with
    | Option.some head => if head == Claim.head claim then 0 else toInt (Async.await (epochAt head))
    | Option.none => 0
  let etag := Option.bind current (fun c => Option.map Js.toText (toOption (Js.get c "etag")))
  let decided := Heads.verdict causal claim required sent
  if decided == "same" then Moved.mk 0 required (Claim.head claim) else if decided == "epoch" then Moved.mk 426 required "" else if decided == "write" && writeHead bucket project (Claim.branch claim) (Claim.head claim) etag then
    logHead bucket project (Claim.branch claim) (Claim.head claim) causal keyId
    Moved.mk 0 required (Claim.head claim)
  else
    let latest := toOption (Async.await (readCurrent (Claim.branch claim)))
    Moved.mk
      409
      required
      (Option.getOr (Option.map (fun c => Js.toText (Js.get c "causal")) latest) "")