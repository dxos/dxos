/-- Moves `claim.branch` as the claim asks, if it may (D167, D181): reads the current head, asks its epoch only when
  the head would change, decides by `verdict`, and swaps and logs the move by a conditional write, so of two pushes
  from one head exactly one moves it. -/
def Worker.Heads.move (store : HeadStore) (claim : Claim) (sent : Int) : {Async} Moved :=
  let current := HeadStore.current store (Claim.branch claim)
  let causal := Option.map fst current
  let required :=
    match causal with
    | Option.some head => if head == Claim.head claim then 0 else epochAt store head
    | Option.none => 0
  let tag := Option.bind current snd
  let decided := Heads.verdict causal claim required sent
  if decided == "same" then Moved.mk 0 required (Claim.head claim)
    else if decided == "epoch" then Moved.mk 426 required ""
    else if decided == "write" && HeadStore.swap store (Claim.branch claim) (Claim.head claim) tag then
    HeadStore.log store (Claim.branch claim) (Claim.head claim) causal
    Moved.mk 0 required (Claim.head claim)
  else Moved.mk 409 required (match HeadStore.current store (Claim.branch claim) with
  | Option.some (head, _) => head
  | Option.none => "")