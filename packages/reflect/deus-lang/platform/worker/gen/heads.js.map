/-- The epoch the pushing CLI has, from `x-deus-epoch`: up to nine decimal digits, so it stays an `Int`; anything
  else counts as none. -/
def Worker.Heads.sentEpoch (header : Option Text) : Int :=
  match Option.map Text.trim header with
  | Option.some digits => if Text.length digits >= 1 && Text.length digits <= 9 && List.all Text.isDigit (Text.utf8 digits) then Option.getOr (Int.fromText digits) 0
      else 0
  | Option.none => 0