/-- Moves the branch head a push to `project` claims (D167), as remote.mjs asks before a bundle is stored: a promise
  of `undefined` when the head is where the push needs it, else of the response that refuses it. `logged` is the
  key's audit callback, carrying its `keyId` and `scopes`; `readCurrent` and `epochAt` are as for `r2Heads`. -/
def Worker.Heads.gate
    (request : Js)
    (bucket : Js)
    (project : Text)
    (logged : Js)
    (readCurrent : Text -> Js)
    (epochAt : Text -> Js)
    : {Async} Js :=
  let scopes := List.map Js.toText (Js.toList (Js.get logged "scopes"))
  let keyId := Option.map Js.toText (toOption (Js.get logged "keyId"))
  let refused := claimed
    (Http.header request "x-deus-claim")
    (Http.header request "x-deus-epoch")
    scopes
    (fun claim sent => move (r2Heads bucket project keyId readCurrent epochAt) claim sent)
  match refused with
  | Option.none => undefined
  | Option.some refusal =>
      let extra :=
        match refusal with
        | Refusal.outdated _ required _ => [("epoch", Js.int required)]
        | Refusal.overtaken _ head => [("head", if Text.isEmpty head then Js.null else Js.text head)]
        | _ => []
      json (Js.obj (("error", Js.text (refusalMessage refusal)) :: extra)) (refusalStatus refusal)