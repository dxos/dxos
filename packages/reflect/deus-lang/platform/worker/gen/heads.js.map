/-- The head of `branch` as remote.mjs and live.mjs read it: `{causal, etag, uploaded}` from the bucket, else
  `{causal}` from the D1 `db` (none when the Worker has no `db`), else `undefined`. The first push after D181 copies a
  D1 head to the bucket, since its conditional write creates the bucket's copy. -/
def Worker.Heads.readHead (bucket : Js) (db : Js) (project : Text) (branch : Text) : {Async} Js :=
  let stored := Option.map
    (fun head => Js.obj [("causal", Js.text head.causal), ("etag", Js.text head.etag), ("uploaded", head.uploaded)])
    (readStored bucket project branch)
  let legacy := fun _ =>
    match toOption db with
    | Option.none => Option.none
    | Option.some database =>
        match D1.first
          database
          "select causal from heads where project = ? and branch = ?"
          [Js.text project, Js.text branch] with
        | Option.none => Option.none
        | Option.some row => Option.some (Js.obj [("causal", Js.get row "causal")])
  Option.getOr (preferStored stored legacy) undefined