/-- Records that `branch` moved to `causal` from `previous` by the key `keyId`, under the time it moved. The time is a
  JavaScript number: milliseconds pass the 32-bit `Int`. -/
def Worker.Heads.logHead (bucket : Js) (project : Text) (branch : Text) (causal : Text) (previous : Option Text) (keyId : Option Text) : {Async} Unit :=
  let at := Js.call (Js.path globalThis ["Date", "now"]) []
  let orNull := fun value => Option.getOr (Option.map Js.text value) Js.null
  let entry := stringify (Js.obj [("causal", Js.text causal), ("previous", orNull previous), ("at", at), ("key", orNull keyId)])
  let options := Js.obj [("httpMetadata", Js.obj [("contentType", Js.text "application/json")])]
  Async.await (method
    bucket
    "put"
    [Js.text (headLogKey project branch ++ Heads.padded 13 (Js.toText at) ++ "-" ++ causal), Js.text entry, options])
  ()