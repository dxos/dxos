/-- A branch name: a letter or digit, then up to 99 letters, digits, `.`, `_`, `/` or `-`. -/
def Worker.Heads.isBranch (t : Text) : Bool :=
  match utf8 t with
  | first :: rest => (isDigit first || isAlpha first) && List.length rest <= 99 && List.all (fun c => isDigit c || isAlpha c || c == '.' || c == '_' || c == '/' || c == '-') rest
  | [] => false