/-- The heads of `project` in the R2 `bucket`, read through `readCurrent` (in JavaScript, a branch to a promise of
  `{causal, etag}` or `undefined`, which also reads heads older than D181) and `epochAt` (a head to a promise of
  its epoch), logged as moved by the key `keyId`. -/
def Worker.Heads.r2Heads
    (bucket : Js)
    (project : Text)
    (keyId : Option Text)
    (readCurrent : Text -> Js)
    (epochAt : Text -> Js)
    : HeadStore := HeadStore.mk (fun branch =>
  match toOption (Async.await (readCurrent branch)) with
  | Option.none => Option.none
  | Option.some found => Option.some (Js.toText (Js.get found "causal"), Option.map Js.toText (toOption (Js.get found "etag")))) (fun head => toInt (Async.await (epochAt head))) (fun branch head tag => writeHead bucket project branch head tag) (fun branch head previous => logHead bucket project branch head previous keyId)