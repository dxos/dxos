/-- `<branch> <head> <base>[,<base>…]`, with `-` for no base; none when the header is anything else. -/
def Worker.Heads.parseClaim (header : Text) : Option Claim :=
  match Text.split header " " with
  | branch :: head :: bases :: [] =>
      let based := if bases == "-" then [] else Text.split bases ","
      if isBranch branch && Heads.isHash head && List.all Heads.isHash based then Option.some (Claim.mk branch head based)
        else Option.none
  | _ => Option.none