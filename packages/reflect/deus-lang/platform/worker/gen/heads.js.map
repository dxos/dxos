/-- The head of `branch` in the R2 `bucket`, or none; a head moved before D181 is a D1 row, which remote.mjs reads. -/
def Worker.Heads.readStored
    (bucket : Js)
    (project : Text)
    (branch : Text)
    : {Async} Option Stored :=
  match toOption (Async.await (Js.method bucket "get" [Js.text (headKey project branch)])) with
  | Option.none => Option.none
  | Option.some object =>
      let text := Js.toText (Async.await (Js.method object "text" []))
      Option.some (Stored.mk (Text.trim text) (Js.toText (Js.get object "etag")) (Js.get object "uploaded"))