/-- The bucket's head when there is one, else `legacy`'s, which is read only then: heads moved before D181 are D1
  rows, and reading one costs no write. -/
def Worker.Heads.preferStored
    (stored : Option a)
    (legacy : Unit -> {Async} Option a)
    : {Async} Option a :=
  match stored with
  | Option.some head => Option.some head
  | Option.none => legacy ()