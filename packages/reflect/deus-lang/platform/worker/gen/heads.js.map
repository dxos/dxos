/-- Moves the branch a push claims (header `claim`, the CLI's epoch header `epoch`), by `moveTo`, for a key holding
  `scopes`; none when the head is where the push needs it, else why not. -/
def Worker.Heads.claimed
    (claim : Option Text)
    (epoch : Option Text)
    (scopes : List Text)
    (moveTo : Claim -> Int -> {Async} Moved)
    : {Async} Option Refusal :=
  match Option.bind claim (fun header => if Text.isEmpty header then Option.none else Option.some header) with
  | Option.none => if List.contains "compact" scopes || List.contains "admin" scopes then Option.none
      else Option.some Refusal.unclaimed
  | Option.some header =>
      match parseClaim header with
      | Option.none => Option.some Refusal.malformed
      | Option.some parsed =>
          let sent := sentEpoch epoch
          let moved := moveTo parsed sent
          if Moved.status moved == 0 then Option.none
            else if Moved.status moved == 426 then Option.some (Refusal.outdated (Claim.branch parsed) moved.required sent)
            else Option.some (Refusal.overtaken (Claim.branch parsed) (Moved.head moved))