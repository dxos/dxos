--
--
/-- `List.map` splits into ("List", "map"); a name without an inner dot has no namespace. -/
def lib.toolchain.Codebase.splitName (name : Text) : Option (Text, Text) :=
  let i := Text.indexOf name "." 1
  if i < 1 || i + 1 >= Text.length name then Option.none else Option.some (Text.take i name, Text.drop (i + 1) name)