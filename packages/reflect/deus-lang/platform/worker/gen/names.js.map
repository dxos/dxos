/-- Answers `verb` on `/names/<branch>/<Name>` (`path`, decoded), without a request, so tests run it over heads and
  namespaces in memory (task 019e7afe). `headOf branch` is the branch's head, and `nameAt head name` what the name
  holds there. -/
def Worker.Names.answer
    (verb : Text)
    (path : List Text)
    (headOf : Text -> {Async} Option Text)
    (nameAt : Text -> Text -> {Async} Option a)
    : {Async} Answer a := if verb != "GET" then Answer.problem 405 "method not allowed" else
  match path with
  | branch :: name :: [] => if Text.isEmpty branch || Text.isEmpty name then Answer.problem 404 "a name is looked up as /names/<branch>/<Name>" else
      match headOf branch with
      | Option.none => Answer.problem 404 ("no branch " ++ branch)
      | Option.some causal =>
          match nameAt causal name with
          | Option.none => Answer.problem 404 ("no " ++ name ++ " on " ++ branch)
          | Option.some found => Answer.named name branch causal found
  | _ => Answer.problem 404 "a name is looked up as /names/<branch>/<Name>"