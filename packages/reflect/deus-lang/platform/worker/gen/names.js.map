/-- `name` in the namespace of history node `causal`, reading object texts through `read`: the node names its
  snapshot by the toolchain's own rule (`Codebase.causalFromSexp`), and the walk is `entryWith`. -/
def Worker.Names.resolveWith
    (read : Text -> {Async} Option Text)
    (causal : Text)
    (name : Text)
    : {Async} Resolved :=
  let without := fun outcome message => Resolved.mk outcome message "" "" "" false
  match read causal with
  | Option.none => without "missing" ("the head " ++ causal ++ " is in no pack yet")
  | Option.some node =>
      let snapshot := (causalFromSexp (Sexp.read node)).snapshot
      if Text.isEmpty snapshot then without "unbound" "" else
        let found := entryWith read snapshot name
        if not (Text.isEmpty found.missing) then without "missing" found.missing
          else if not found.bound then without "unbound" ""
          else if Text.isEmpty (Lookup.hash found) then Resolved.mk "found" "" (Lookup.entry found) "" "" false else
          match read (Lookup.hash found) with
          | Option.some text => Resolved.mk "found" "" (Lookup.entry found) (Lookup.hash found) text true
          | Option.none => Resolved.mk "found" "" (Lookup.entry found) (Lookup.hash found) "" false