/-- The stored form of a name's entry (`(term "<hash>")`), as the snapshot holds it: a reader that does not know an
  entry's kind, such as a Worker older than the CLI that pushed it, still finds it. -/
def lib.toolchain.Codebase.lookupFormWith
    (read : Text -> {e} Option Sexp)
    (h : Text)
    (name : Text)
    : {Throw Text | e} Option Sexp :=
  let items := nodeItemsWith read h
  let entry := List.head? (List.filterMap (fun item =>
    match item with
    | Sexp.list (Sexp.sym "n" :: Sexp.str n :: e :: []) => if n == name then Option.some e else Option.none
    | _ => Option.none) items)
  match (entry, splitName name) with
  | (Option.some e, _) => Option.some e
  | (Option.none, Option.some (seg, rest)) =>
      match List.head? (List.filterMap (fun item =>
        match item with
        | Sexp.list (Sexp.sym "sub" :: Sexp.str s :: Sexp.str child :: []) => if s == seg then Option.some child else Option.none
        | _ => Option.none) items) with
      | Option.some child => lib.toolchain.Codebase.lookupFormWith read child rest
      | Option.none => Option.none
  | (Option.none, Option.none) => Option.none