def lib.toolchain.Entry.fromSexp (s : Sexp) : Entry :=
  let a := Sexp.args s
  let txt := fun k => asText (Option.getOr (List.get? a k) (Sexp.str ""))
  let num := fun k => Sexp.asInt (Option.getOr (List.get? a k) (Sexp.int 0))
  let h := Sexp.head s
  if h == "term" then Entry.term (txt 0) else if h == "ctor" then Entry.ctor (txt 0) (num 1) (num 2) else if h == "type" then Entry.type
    (txt 0)
    (txt 1)
    (List.map asText (Sexp.asList (Option.getOr (List.get? a 2) (Sexp.list [])))) else if h == "ability" then Entry.ability (txt 0) (txt 1) else if h == "op" then Entry.op (txt 0) (num 1) (num 2) else if h == "test" then Entry.test (txt 0) else if h == "theorem" then Entry.theorem (txt 0) else if h == "spec" then Entry.spec (txt 0) else defect ("unknown entry " ++ Sexp.print s)