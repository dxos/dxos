/-- The hash an entry names (a constructor or operation names its type's or ability's). -/
def lib.toolchain.Entry.hash : Entry -> Text
| Entry.term h => h
| Entry.ctor t _ _ => t
| Entry.type h _ _ => h
| Entry.ability h _ => h
| Entry.op a _ _ => a
| Entry.test h => h
| Entry.theorem h => h
| Entry.spec h => h