/-- Adds a finished form to the innermost open list, or to the top-level forms. -/
def lib.base.Sexp.push (form : Sexp) (stack : List (List Sexp)) (done : List Sexp) : (List (List Sexp), List Sexp) :=
  match stack with
  | [] => (stack, form :: done)
  | top :: rest => ((form :: top) :: rest, done)