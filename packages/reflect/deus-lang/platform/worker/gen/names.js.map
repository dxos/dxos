/-- A namespace node's items, its parts expanded, with objects read by `read`: the store here, a remote's packs in the
  Worker (task 41714c0d). -/
def lib.toolchain.Codebase.nodeItemsWith
    (read : Text -> {e} Option Sexp)
    (h : Text)
    : {Throw Text | e} List Sexp :=
  match read h with
  | Option.none => Throw.throw ("missing namespace #" ++ h)
  | Option.some form => List.concatMap (fun item =>
      match item with
      | Sexp.list (Sexp.sym "part" :: Sexp.str child :: []) => lib.toolchain.Codebase.nodeItemsWith read child
      | _ => [item]) (Sexp.args form)