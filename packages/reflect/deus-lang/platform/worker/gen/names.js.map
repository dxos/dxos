/-- `name` in the namespace snapshot `snapshot`, reading objects through `lookup` (in JavaScript, a hash to a promise
  of its text or `undefined`). -/
def Worker.Names.entryAt (lookup : Text -> Js) (snapshot : Text) (name : Text) : {Async} Lookup :=
  let read := fun h => Option.map (fun text => Sexp.read (Js.toText text)) (toOption (Async.await (lookup h)))
  match try (fun _ => lookupNameWith read snapshot name) with
  | Result.ok (Option.some e) => Lookup.mk true (Sexp.print (Entry.toSexp e)) (Entry.hash e) ""
  | Result.ok Option.none => Lookup.mk false "" "" ""
  | Result.err problem => Lookup.mk false "" "" problem