/-- Answers `/v1/<project>/names/<branch>/<Name>` for `request` (`answer`): the entry, hash and text of a name at the
  branch's head. `readHead branch` gives a promise of the head (`{causal}`) or `undefined`; `nameAt causal name` a
  promise of `{entry, hash, text}` or `undefined`, rejected with a 404 while the head is in no pack yet. -/
def Worker.Names.serve
    (request : Js)
    (rest : List Text)
    (readHead : Text -> Js)
    (nameAt : Text -> Text -> Js)
    : {Async} Js :=
  let verb := Http.method request
  -- Decoded only for a GET: a malformed escape in a request refused as 405 throws.
  let path := if verb == "GET" then List.map (fun part => Js.toText (Js.call (Js.global "decodeURIComponent") [Js.text part])) rest
    else rest
  let reply := Names.answer verb path (fun branch =>
    match toOption (Async.await (readHead branch)) with
    | Option.none => Option.none
    | Option.some head => Option.some (Js.toText (Js.get head "causal"))) (fun causal name => toOption (Async.await (nameAt causal name)))
  match reply with
  | Answer.problem status message => Http.problem status message
  | Answer.named name branch causal found =>
      let named := Js.obj [("name", Js.text name), ("branch", Js.text branch), ("head", Js.text causal)]
      Http.json (Js.method (Js.global "Object") "assign" [named, found]) 200