/-- `lookupName` with objects read by `read`, so the Worker resolves names by the same rule (task 41714c0d). -/
def lib.toolchain.Codebase.lookupNameWith (read : Text -> {e} Option Sexp) (h : Text) (name : Text) : {Throw Text | e} Option Entry :=
  let items := nodeItemsWith read h
  let entry := List.head? (List.filterMap (fun item =>
    match item with
    | Sexp.list (Sexp.sym "n" :: Sexp.str n :: e :: []) => if n == name then Option.some (Entry.fromSexp e) else Option.none
    | _ => Option.none) items)
  match (entry, splitName name) with
  | (Option.some e, _) => Option.some e
  | (Option.none, Option.some (seg, rest)) =>
      match List.head? (List.filterMap (fun item =>
        match item with
        | Sexp.list (Sexp.sym "sub" :: Sexp.str s :: Sexp.str child :: []) => if s == seg then Option.some child else Option.none
        | _ => Option.none) items) with
      | Option.some child => lib.toolchain.Codebase.lookupNameWith read child rest
      | Option.none => Option.none
  | (Option.none, Option.none) => Option.none