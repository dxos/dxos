/-- The request `source` holds, as a JavaScript object with its fields and `assets` (`{hash, type, name}` each). -/
def Worker.Inbox.request (source : Text) : Js :=
  let items :=
    match readAll source with
    | Sexp.list (_ :: rest) :: _ => rest
    | _ => []
  let asset := fun a =>
    match a with
    | Sexp.list (_ :: hash :: type :: name :: []) => Option.some (Js.obj [("hash", Js.text (Option.getOr (Inbox.value hash) "")),
        ("type", Js.text (Option.getOr (Inbox.value type) "")),
        ("name", Js.text (Option.getOr (Inbox.value name) ""))])
    | _ => Option.none
  let assets := List.concatMap (fun item =>
    match item with
    | Sexp.list (Sexp.sym "assets" :: listed) => List.filterMap asset listed
    | _ => []) items
  let pairs := List.filterMap (fun item =>
    match item with
    | Sexp.list (Sexp.sym "assets" :: _) => Option.none
    | Sexp.list (Sexp.sym key :: v :: _) => Option.map (fun t => (key, Js.text t)) (Inbox.value v)
    | _ => Option.none) items
  Js.obj (("assets", Js.list assets) :: pairs)