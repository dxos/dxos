/-- Why an upload of `size` bytes of `type` is refused, with its status; none when it may be stored. -/
def Worker.Writes.uploadProblem (type : Text) (size : Int) : Option (Int, Text) := if not (List.contains type assetTypes) then Option.some (415, "attach a PNG, JPEG, GIF, WebP image or a PDF")
  else if size == 0 || size > maxAssetBytes then Option.some (413, "an attachment must be under 10 MB")
  else Option.none