/-- An attachment a write names (`{hash, type, name}`), cut to size; `{status, error}` when its hash is not one. -/
def Worker.Writes.attachment (item : Js) : Js :=
  let hash := Writes.text (Js.get item "hash") 64
  if not (Heads.isHash hash) then refuse 400 "an attachment was not uploaded"
    else Js.obj [("hash", Js.text hash),
    ("type", Js.text (Writes.text (Js.get item "type") 100)),
    ("name", Js.text (safeName (Writes.text (Js.get item "name") 200)))]