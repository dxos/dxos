/-- A label: a lowercase letter or digit, then up to 31 lowercase letters, digits or `-`. -/
def Worker.Writes.isLabel (label : Text) : Bool :=
  let lowerOrDigit := fun c => c >= 'a' && c <= 'z' || Text.isDigit c
  match Text.utf8 label with
  | first :: rest => lowerOrDigit first
      && List.length rest <= 31
      && List.all (fun c => lowerOrDigit c || c == '-') rest
  | [] => false