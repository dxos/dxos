/-- What a comment is on: `def:<name>` (one line) or `change:<causal>`. -/
def Worker.Writes.isSubject (subject : Text) : Bool := Text.startsWith "def:" subject && Text.length subject > 4 && not (Text.contains "\n" subject) && not (Text.contains "\r" subject) || Text.startsWith "change:" subject && Heads.isHash (Text.drop 7 subject)