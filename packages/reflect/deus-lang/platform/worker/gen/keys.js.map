/-- Whether two texts are equal, taking as long whichever character differs, so a guess at a secret's hash learns
  nothing from how fast it is refused. -/
def Worker.Keys.sameText (a : Text) (b : Text) : Bool := Text.length a == Text.length b && List.foldl
  (fun acc pair => Int.or acc (Int.xor (fst pair) (snd pair)))
  0
  (List.zip (Text.utf8 a) (Text.utf8 b)) == 0