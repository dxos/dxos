/-- The key an `Authorization` header names; none for anything else. -/
def Worker.Keys.parseKey (header : Text) : Option Named := if not (startsWith "Bearer deus_" header) then Option.none else
  match Text.split (Text.drop 12 header) "_" with
  | id :: secret :: [] => if Keys.isHex 16 id && Keys.isHex 64 secret then Option.some (Named.mk id secret) else Option.none
  | _ => Option.none