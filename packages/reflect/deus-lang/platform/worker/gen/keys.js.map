/-- Whether a key's database row lets a request act in `scope` on the project in `folder` ("" for none, as key
  management): the row exists and its secret hashes to `secretHash`, it is neither revoked nor expired at `now`
  (milliseconds, a JavaScript number), and its scopes and projects allow the request. -/
def Worker.Keys.judge
    (row : Js)
    (secretHash : Text)
    (now : Js)
    (scope : Text)
    (folder : Text)
    : Keys.Verdict := if isNull row || not (sameText (Js.toText (Js.get row "secret_hash")) secretHash) then Verdict.mk 401 "unknown API key"
  else if not (isNull (Js.get row "revoked_at")) then Verdict.mk 401 "this API key was revoked" else
  let expires := Js.get row "expires_at"
  if not (isNull expires) && lessThan expires now then Verdict.mk 401 "this API key has expired"
    else if not (allows (List.map Js.toText (Js.toList (Js.parse (Js.toText (Js.get row "scopes"))))) scope) then Verdict.mk 403 ("this API key lacks the " ++ scope ++ " scope") else
    let projects := Js.parse (Js.toText (Js.get row "projects"))
    let everywhere := Js.typeOf projects == "string" && Js.toText projects == "*"
    if Text.isEmpty folder || everywhere || grants (List.map Js.toText (Js.toList projects)) folder then Verdict.mk 0 ""
      else Verdict.mk 403 ("this API key cannot write to " ++ Option.getOr (addressOfFolder folder) folder)