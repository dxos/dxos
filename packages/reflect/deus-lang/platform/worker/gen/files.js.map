/-- One segment of a file's path: a letter, digit or `_`, then up to 199 letters, digits, `.`, `_` or `-`; so no
  segment is `.`, `..` or empty, and a path cannot climb out of its folder. -/
def Worker.Paths.isSegment (segment : Text) : Bool :=
  match Text.utf8 segment with
  | first :: rest => (Text.isAlpha first || Text.isDigit first || first == '_') && List.length rest <= 199 && List.all (fun c => Text.isAlpha c || Text.isDigit c || c == '.' || c == '_' || c == '-') rest
  | [] => false