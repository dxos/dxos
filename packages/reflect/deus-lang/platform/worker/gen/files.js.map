/-- Deletes `<project>/<folder>/<name>` by moving it to `<project>/trash/<folder>/<name>`, which no client can write
  or delete, so a deleting bug costs storage, never data. R2 has no rename: it is a copy, then the delete. -/
def Worker.R2.toTrash (bucket : Js) (project : Text) (folder : Text) (name : Text) : {Async} Unit :=
  let key := project ++ "/" ++ folder ++ "/" ++ name
  match R2.get bucket key with
  | Option.none => ()
  | Option.some object =>
      let body := R2.bytes (Async.await (Js.method (Js.construct (Js.global "Response") [Js.get object "body"]) "arrayBuffer" []))
      let deletedAt := Js.toText (Js.call (Js.path globalThis ["Date", "now"]) [])
      let options := Js.obj [("httpMetadata", Js.get object "httpMetadata"),
        ("customMetadata", Js.obj [("deletedAt", Js.text deletedAt)])]
      Async.await (Js.method
        bucket
        "put"
        [Js.text (project ++ "/trash/" ++ folder ++ "/" ++ name), body, options])
      R2.delete bucket key