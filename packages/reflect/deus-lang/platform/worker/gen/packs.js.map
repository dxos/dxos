/-- What is wrong with a combined index, if anything: the magic, the pack names, 1024 fanout bytes and 48-byte
  records, and the fanout counts the records. A corrupt one is refused rather than searched as garbage. -/
def Worker.Packs.checkCombined (bytes : Js) : Option Text :=
  let size := Bytes.length bytes
  if size < 12 || not (List.all (fun x0 =>
    let (at, byte) := x0
    u8 bytes at == byte) (zip (range 0 8) Packs.magic)) then Option.some "a combined index starts with DEUSIX1" else
    let start := combinedFanout bytes
    -- `start` is 32-bit arithmetic, so a name length past 2³¹ wraps below 12.
    if start < 12 || start > size || size - start < fanout || (size - start - fanout) % Packs.record != 0 then Option.some "a combined index is a header, pack names, 1024 fanout bytes and 48-byte records" else fanoutProblem bytes start ((size - start - fanout) / Packs.record)