/-- What is wrong with a pack index, if anything: it is 1024 fanout bytes and 48-byte records, and the fanout is a
  non-decreasing count that ends at the number of records. -/
def Worker.Packs.checkIndex (bytes : Js) : Option Text :=
  let size := Bytes.length bytes
  if size < fanout || (size - fanout) % Packs.record != 0 then Option.some "an index is 1024 fanout bytes and 48-byte records" else
    let rec walk byte previous := if byte == 256 then if previous != (size - fanout) / Packs.record then Option.some "the fanout does not count the records" else Option.none else
      let count := Bytes.u32 bytes (byte * 4)
      if count < previous then Option.some "the fanout decreases" else walk (byte + 1) count
    walk 0 0