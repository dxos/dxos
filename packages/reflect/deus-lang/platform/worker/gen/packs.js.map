/-- The big-endian unsigned 32-bit number at `at`, as an `Int` (counts and offsets stay below 2³¹). -/
def Worker.Bytes.u32 (bytes : Js) (at : Int) : Int :=
  let view := Js.construct
    (Js.global "DataView")
    [Js.get bytes "buffer", Js.get bytes "byteOffset", Js.get bytes "byteLength"]
  toInt (method view "getUint32" [Js.int at])