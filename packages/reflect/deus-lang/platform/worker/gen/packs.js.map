/-- Of the records equal to the one at `at` (several packs can hold one key), the one from the pack merged last
  (the larger number at byte 32). Metadata is rewritten in place, so only its newest copy is current; an object's
  copies are all the same, so objects (kind 1) keep the first match. -/
def Worker.Packs.newestAt (records : Js) (at : Int) (first : Int) (last : Int) (key : Js) (kind : Int) : Int := if kind != 2 then at else
  let same := fun offset => compareKey records offset key == 0 && u8 records (offset + 44) == kind
  let rec walk offset step best := if offset < first * Packs.record || offset > last * Packs.record || not (same offset) then best else walk
    (offset + step)
    step
    (if Bytes.u32 records (offset + 32) > Bytes.u32 records (best + 32) then offset else best)
  walk (at + Packs.record) Packs.record (walk (at - Packs.record) (0 - Packs.record) at)