/-- `bytes=<first>-[<last>]` as a range; other forms (suffixes, several ranges) read the whole file. -/
def Worker.Packs.parseRange (header : Text) : Option Range := if not (startsWith "bytes=" header) then Option.none else
  match Text.split (Text.drop 6 header) "-" with
  | first :: last :: [] =>
      match (digits first, if Text.isEmpty last then Option.some Option.none else Option.map Option.some (digits last)) with
      | (Option.some offset, Option.some (Option.some final)) => Option.some (Range.mk offset (Option.some (final - offset + 1)))
      | (Option.some offset, Option.some Option.none) => Option.some (Range.mk offset Option.none)
      | _ => Option.none
  | _ => Option.none