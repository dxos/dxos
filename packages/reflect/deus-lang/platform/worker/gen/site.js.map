/-- What answers `pathname` on a project (`scoped`: one at `/@owner/project`) at a pinned version (`pinned`). -/
def Worker.Site.plan (pathname : Text) (scoped : Bool) (pinned : Bool) : Site.Step :=
  let path := if pathname == "/" then "/index.html" else pathname
  let topLevel := isTopLevel path
  if not scoped && not pinned && Text.startsWith "/demo/todo" path then Site.demo path
    else if Text.contains ".." path then Site.Step.mk "missing" "" else if topLevel && not pinned then
    -- The host's front page lists every project (D200); a project's explorer is at its own path.
    if not scoped && pathname == "/" then Site.Step.mk "hub" "hub.html"
      else if not scoped && path == "/hub.js" then Site.Step.mk "hub" "hub.js"
      else if List.contains (Text.drop 1 path) Site.appFiles then Site.Step.mk "app" (Text.drop 1 path)
      else if path == "/index.html" then Site.Step.mk "page" path else Site.Step.mk "current" path
  else Site.Step.mk "file" path