/-- A path of the todo demo, built from examples/react: `/demo/todo` redirects so the page's relative links resolve. -/
def Worker.Site.demo (path : Text) : Site.Step :=
  if path == "/demo/todo" then Site.Step.mk "redirect" "/demo/todo/" else
    let name := if path == "/demo/todo/" then "index.html" else Text.drop 11 path
    if List.contains name ["index.html", "app.css", "bundle.js"] then Site.Step.mk "demo" name
      else Site.Step.mk "missing" ""