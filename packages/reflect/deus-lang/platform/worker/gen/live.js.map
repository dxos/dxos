/-- A page of definitions or changes: `<hash>.json`, `<hash>.<member>.json` for a member of a recursive group, or
  `_<Name>.json` for a builtin's page. -/
def Worker.Live.isPage (name : Text) : Bool :=
  match Live.json name with
  | Option.none => false
  | Option.some stem => if Text.startsWith "_" stem then Live.word
      (fun c => Text.isAlpha c || Text.isDigit c || c == '_' || c == '.')
      99
      (Text.drop 1 stem) else
      match Text.split stem "." with
      | hash :: [] => Heads.isHash hash
      | hash :: member :: [] => Heads.isHash hash
          && Text.length member >= 1
          && Text.length member <= 6
          && List.all Text.isDigit (Text.utf8 member)
      | _ => false