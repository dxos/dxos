/-- A spec document's page, named like a namespace (`Address.Spec.json`): one to ten segments. -/
def Worker.Live.isDocument (name : Text) : Bool :=
  match Live.json name with
  | Option.none => false
  | Option.some stem =>
      let segments := Text.split stem "."
      List.length segments <= 10 && List.all (Live.word (fun c => Text.isAlpha c || Text.isDigit c || c == '_') 99) segments