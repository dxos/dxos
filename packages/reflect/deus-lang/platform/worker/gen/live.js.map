/-- The hub's summary of a head's `index` (its `names`, `meta` and `features`), as live.mjs stores it with
  `summaryVersion`. -/
def Worker.Live.summaryOf (index : Js) (version : Int) : Js :=
  let listed := fun field => Option.getOr (Option.map Js.toList (toOption (Js.get index field))) []
  let names := List.map
    (fun entry => (Js.toText (Js.get entry "name"), Js.toText (Js.get entry "kind"), Js.toText (Js.get entry "hash")))
    (listed "names")
  let documents := List.filterMap
    (fun entry => Option.map Js.toText (toOption (Js.get entry "document")))
    (listed "features")
  let meta := Option.getOr (toOption (Js.get index "meta")) (Js.obj [])
  let found := Live.summary names documents
  let features := Option.getOr (toOption (Js.get meta "features")) (Js.int 0)
  Js.obj ([("branch", Js.get meta "branch"),
    ("definitions", Js.get meta "definitions"),
    ("own", Js.int found.own),
    ("tasks", Js.get meta "tasks"),
    ("open", Js.get meta "open"),
    ("features", features),
    ("kinds", Js.obj (List.map (fun pair => (fst pair, Js.int (snd pair))) found.kinds)),
    ("namespaces", Js.list (List.map Js.text found.namespaces)),
    ("checked", Js.list (List.map Js.text (Summary.checked found))),
    ("summaryVersion", Js.int version)] ++ Option.getOr (Option.map (fun map => [("featureMap", Js.text map)]) found.featureMap) [])