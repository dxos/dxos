def Worker.Live.summary (names : List (Text, (Text, Text))) (documents : List Text) : Summary :=
  let own := List.filter (fun entry =>
    let (name, _, _) := entry
    not (Text.startsWith "lib." name)) names
  let tops := List.filterMap (fun entry =>
    let (name, _, _) := entry
    -- Only the first two segments matter, so the name is not split whole.
    let dot := Text.indexOf name "." 0
    if dot < 1 then Option.none else
      let top := Text.take dot name
      let next := Text.indexOf name "." (dot + 1)
      let second := if next < 0 then Text.drop (dot + 1) name else Text.slice name (dot + 1) next
      if top == "lib" || second == "Spec" || second == "Features" || second == "QA" then Option.none
        else Option.some top) names
  let ranked := List.sortBy (fun left right => snd right - snd left) (Live.tally tops)
  Summary.mk (List.length own) (Live.tally (List.map (fun entry =>
    let (_, kind, _) := entry
    kind) own)) (List.map fst (List.take 6 ranked)) (List.filterMap (fun entry =>
    let (_, kind, hash) := entry
    if kind == "test" || kind == "theorem" then Option.some hash else Option.none) own) (List.find (fun document => Text.endsWith ".Features" document) documents)