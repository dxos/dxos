def List.merge (cmp : a -> a -> Int) (xs : List a) (ys : List a) : List a :=
  let rec go acc l r :=
    match (l, r) with
    | ([], _) => List.reverse acc ++ r
    | (_, []) => List.reverse acc ++ l
    | (x :: xt, y :: yt) => if cmp x y <= 0 then go (x :: acc) xt r else go (y :: acc) l yt
  go [] xs ys