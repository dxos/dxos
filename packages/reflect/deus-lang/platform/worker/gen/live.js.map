/-- How many times each key occurs, in the order each first occurs; counted in a hash map, since a tree map's
  rebalancing allocates per key and this runs over every name of a project. -/
def Worker.Live.tally (keys : List Text) : List (Text, Int) :=
  let counts := MutMap.new ()
  let firsts := List.filter (fun key =>
    match MutMap.get counts key with
    | Option.some n =>
        MutMap.set counts key (n + 1)
        false
    | Option.none =>
        MutMap.set counts key 1
        true) keys
  List.map (fun key => (key, Option.getOr (MutMap.get counts key) 0)) firsts