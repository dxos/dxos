/-- How many messages each queue batch takes, given each message's size in bytes: a batch holds at most 100 messages
  and, unless it is one message, at most 200,000 bytes, as Cloudflare Queues' `sendBatch` allows. -/
def Worker.Live.batchLengths (sizes : List Int) : List Int :=
  let step := fun acc size =>
    let (done, count, bytes) := acc
    if count > 0 && (count == 100 || bytes + size > 200000) then (count :: done, 1, size)
      else (done, count + 1, bytes + size)
  let (done, count, _) := List.foldl step ([], 0, 0) sizes
  List.reverse (if count > 0 then count :: done else done)