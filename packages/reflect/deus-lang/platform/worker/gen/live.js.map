/-- A history node's parents and the snapshots besides its namespace that a history page reads (tasks, prior record,
  comments), by the toolchain's own reading of a node (`Codebase.causalFromSexp`); none but whole hashes. -/
def Worker.Live.links (text : Text) : (List Text, List Text) :=
  let node := causalFromSexp (Sexp.read text)
  (node.parents, List.filter Heads.isHash [node.tasks, node.prior, node.threads])