/-- A branch name: a letter or digit, then up to 99 letters, digits, `.`, `_`, `/` or `-`. -/
def Worker.Heads.isBranch (t : Text) : Bool :=
  match Text.utf8 t with
  | first :: rest => (Text.isDigit first || Text.isAlpha first) && List.length rest <= 99 && List.all
      (fun c => Text.isDigit c || Text.isAlpha c || c == '.' || c == '_' || c == '/' || c == '-')
      rest
  | [] => false