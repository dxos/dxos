/-- True when a string needs no escaping, which is the common case and skips the per-code loop. -/
def lib.base.Sexp.plain (t : Text) : Bool :=
  let n := Text.length t
  let rec go i := if i >= n then true else
    let c := Text.code t i
    if c == 34 || c == 92 || c < 32 || c == 127 then false else go (i + 1)
  go 0