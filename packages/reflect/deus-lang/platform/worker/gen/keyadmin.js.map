/-- A response: `body`, `status` and `headers`. -/
def Worker.Http.response (body : Js) (status : Int) (headers : List (Text, Text)) : Js :=
  let named := Js.obj (List.map (fun pair => (fst pair, Js.text (snd pair))) headers)
  Js.construct (Js.global "Response") [body, Js.obj [("status", Js.int status), ("headers", named)]]