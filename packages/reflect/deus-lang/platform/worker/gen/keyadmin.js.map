/-- What is wrong with a key an admin asks to mint, if anything: it needs a label and some of the `known`
  scopes. -/
def Worker.Keys.mintProblem (label : Text) (scopes : List Text) (known : List Text) : Option Text := if Text.isEmpty label then Option.some "a key needs a label"
  else if List.isEmpty scopes || not (List.all (fun scope => List.contains scope known) scopes) then Option.some ("scopes are some of " ++ Text.join ", " known)
  else Option.none