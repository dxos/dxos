/-- Runs `sql`, giving how many rows it changed. -/
def Worker.D1.run (db : Js) (sql : Text) (values : List Js) : {Async} Int :=
  let result := Async.await (Js.method (D1.statement db sql values) "run" [])
  match Option.bind (toOption (Js.get result "meta")) (fun meta => toOption (Js.get meta "changes")) with
  | Option.some changes => toInt changes
  | Option.none => 0