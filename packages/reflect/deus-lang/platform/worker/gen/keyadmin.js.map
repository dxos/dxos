/-- A project a key may be granted: an address, every project of an owner (`@owner/*`), or a legacy folder name. -/
def lib.toolchain.Address.isGrantable (project : Text) : Bool :=
  let segments := Text.split project "/"
  match segments with
  | owner :: "*" :: [] => namesAddress [owner, "x"]
  | _ => isLegacy project || Text.startsWith "@" project && List.length segments == 2 && namesAddress segments