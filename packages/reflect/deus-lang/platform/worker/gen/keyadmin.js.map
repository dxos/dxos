/-- A key's row as the listing shows it: its scopes and projects read from their stored JSON. -/
def Worker.KeyAdmin.listed (row : Js) : Js :=
  let parsed := Js.obj [("scopes", Js.parse (Js.toText (Js.get row "scopes"))),
    ("projects", Js.parse (Js.toText (Js.get row "projects")))]
  Js.method (Js.global "Object") "assign" [Js.obj [], row, parsed]