/-- Mints the key a `POST` body asks for, or answers what is wrong with it. `known` is every scope a key can hold. -/
def Worker.KeyAdmin.create
    (db : Js)
    (request : Js)
    (known : List Text)
    (logged : Js)
    : {Async} Js :=
  let asked := KeyAdmin.body request
  let labelValue := Js.get asked "label"
  let label := if isText labelValue then Text.take 200 (Text.trim (Js.toText labelValue)) else ""
  let scopesValue := Js.get asked "scopes"
  let scopes := if KeyAdmin.isArray scopesValue then Js.toList scopesValue else []
  let projectsValue := Js.get asked "projects"
  let projects := if Js.typeOf projectsValue == "undefined" then Js.text "*" else projectsValue
  -- Scopes are read as text below, which would turn `["push"]` into "push", so anything else is refused first.
  let problem := if List.all isText scopes then mintProblem label (List.map Js.toText scopes) known
    else Option.some ("scopes are some of " ++ Text.join ", " known)
  let everywhere := isText projects && Js.toText projects == "*"
  let grantable := KeyAdmin.isArray projects && List.all (fun project => isText project && isGrantable (Js.toText project)) (Js.toList projects)
  match problem with
  | Option.some message => Http.problem 400 message
  | Option.none => if not everywhere && not grantable then Http.problem 400 "projects is \"*\" or a list of project addresses (@owner/project or @owner/*)" else
      let days := Js.call (Js.global "Number") [Js.get asked "expiresInDays"]
      -- Milliseconds pass the 32-bit `Int`, so the expiry is summed by the database; a null `days` (none asked, or
      -- not a positive number) makes it null.
      let lasting := if lessThan (Js.int 0) days then days else Js.null
      let minted := mint ()
      let at := KeyAdmin.now ()
      D1.run
        db
        "insert into api_keys (id, secret_hash, label, scopes, projects, created_at, expires_at) values (?, ?, ?, ?, ?, ?, ? + ? * 86400000)"
        [Js.text (Minted.id minted),
          Js.text minted.secretHash,
          Js.text label,
          Js.text (stringify (Js.list scopes)),
          Js.text (stringify projects),
          at,
          at,
          lasting]
      let answer := Js.obj [("id", Js.text (Minted.id minted)),
        ("key", Js.text minted.key),
        ("label", Js.text label),
        ("scopes", Js.list scopes),
        ("projects", projects)]
      Js.call logged [json answer 201]