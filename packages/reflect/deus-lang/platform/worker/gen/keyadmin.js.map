/-- A new key: an 8-byte id and a 32-byte secret, from the platform's random source. -/
def Worker.KeyAdmin.mint (u : Unit) : {Async} Minted :=
  let id := randomHex 8
  let secret := randomHex 32
  let encoded := Js.method (Js.construct (Js.global "TextEncoder") []) "encode" [Js.text secret]
  Minted.mk id ("deus_" ++ id ++ "_" ++ secret) (Crypto.sha256 encoded)