/-- Answers `/v1/keys/<rest>` for `request` on the key database `db`. `authorize scope` is remote.mjs's key check;
  only an `admin` key may list, mint or revoke. -/
def Worker.KeyAdmin.serve
    (request : Js)
    (db : Js)
    (rest : List Text)
    (known : List Text)
    (authorize : Text -> Js)
    : {Async} Js :=
  let logged := Async.await (authorize "admin")
  let verb := Http.method request
  match rest with
  | [] => if verb == "GET" then
      let rows := D1.all
        db
        "select id, label, scopes, projects, created_at, expires_at, revoked_at, last_used_at from api_keys order by created_at"
        []
      json (Js.list (List.map KeyAdmin.listed rows)) 200
    else if verb == "POST" then create db request known logged else Http.problem 405 "method not allowed"
  | id :: [] => if verb == "DELETE" then
      let changed := D1.run
        db
        "update api_keys set revoked_at = ? where id = ? and revoked_at is null"
        [KeyAdmin.now (), Js.text id]
      if changed == 0 then Http.problem 404 "no such active key"
        else Js.call logged [json (Js.obj [("id", Js.text id), ("revoked", Js.bool true)]) 200]
    else Http.problem 405 "method not allowed"
  | _ => Http.problem 405 "method not allowed"