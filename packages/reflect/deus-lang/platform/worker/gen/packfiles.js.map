/-- What is wrong with a pack index, if anything: it is 1024 fanout bytes and 48-byte records, and the fanout counts
  the records. -/
def Worker.Packs.checkIndex (bytes : Js) : Option Text :=
  let size := Bytes.length bytes
  if size < fanout || (size - fanout) % Packs.record != 0 then Option.some "an index is 1024 fanout bytes and 48-byte records"
    else fanoutProblem bytes 0 ((size - fanout) / Packs.record)