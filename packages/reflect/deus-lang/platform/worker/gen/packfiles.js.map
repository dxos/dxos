/-- Digits only, as a number; none when `t` is empty, holds anything else, or passes nine digits, which an `Int`
  (32 bits) could wrap: such a range reads the whole file, as one the Worker does not understand. -/
def Worker.Packs.digits (t : Text) : Option Int := if not (Text.isEmpty t) && Text.length t <= 9 && List.all (fun c => Text.isDigit c) (Text.utf8 t) then Int.fromText t
  else Option.none