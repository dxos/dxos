/-- What is wrong with the fanout at byte `start` of `bytes`, if anything: a non-decreasing count that ends at
  `records`, the number of records after it. -/
def Worker.Packs.fanoutProblem (bytes : Js) (start : Int) (records : Int) : Option Text :=
  let rec walk byte previous := if byte == 256 then if previous != records then Option.some "the fanout does not count the records" else Option.none else
    let count := Bytes.u32 bytes (start + byte * 4)
    if count < previous then Option.some "the fanout decreases" else walk (byte + 1) count
  walk 0 0