/-- Answers `/v1/<project>/packs/<rest>` for `request`, on the R2 `bucket`. `authorize scope` is remote.mjs's key
  check; `merge bundles` adds packs to the combined index, a promise of how many it holds; `indexed ()` is called
  once a pack's index is stored, so the head's explorer is drawn before its first visitor asks (D192). -/
def Worker.PackFiles.serve
    (request : Js)
    (bucket : Js)
    (project : Text)
    (rest : List Text)
    (authorize : Text -> Js)
    (merge : List Text -> Js)
    (completed : Unit -> Unit)
    : {Async} Js :=
  let folder := project ++ "/packs/"
  let verb := Http.method request
  if rest == [] || rest == [""] then if verb == "POST" then
    -- Adds every listed pack to the combined index: for packs written before it existed.
    let logged := Async.await (authorize "push")
    let merged := Async.await (merge (indexed (listAll bucket folder)))
    Js.call logged [Http.json (Js.obj [("packs", merged)]) 200]
  else if verb == "GET" then Http.lines (listAll bucket folder)
    else Http.problem 405 "method not allowed" else
    match (rest, Option.bind (List.head? rest) parseName) with
    | (name :: [], Option.some (bundle, index)) =>
        let key := folder ++ name
        if verb == "GET" then PackFiles.read bucket key (Option.getOr (Http.header request "range") "")
          else if verb == "PUT" then
          let logged := Async.await (authorize "push")
          -- A pack only ever describes a bundle the remote holds, so bundles stay the remote's record.
          if not (R2.exists bucket (project ++ "/bundles/" ++ bundle)) then Http.problem 409 ("no bundle " ++ bundle ++ " for this pack") else
            let bytes := R2.bytes (Async.await (Js.method request "arrayBuffer" []))
            let problem := if index then if not (R2.exists bucket (folder ++ bundle)) then Option.some (409, "the pack goes up before its index")
              else Option.map (fun message => (400, message)) (checkIndex bytes) else if Js.toText (Js.method
              (Js.construct (Js.global "TextDecoder") [])
              "decode"
              [Js.method bytes "subarray" [Js.int 0, Js.int 8]]) != "DEUSLN1\n" then Option.some (400, "a pack is line text starting DEUSLN1") else Option.none
            match problem with
            | Option.some (status, message) => Http.problem status message
            | Option.none => if R2.exists bucket key then Js.call logged [PackFiles.report name false 200] else
                R2.put
                  bucket
                  key
                  bytes
                  (if index then "application/octet-stream" else "text/plain; charset=utf-8")
                if index then
                  Async.await (merge [bundle])
                  completed ()
                else ()
                Js.call logged [PackFiles.report name true 201]
        else Http.problem 405 "method not allowed"
    | _ => Http.problem 404 "not a pack name"