/-- Reads `key` whole, or the range a `Range` header asks for, as a 206 that says which bytes it holds. -/
def Worker.PackFiles.read (bucket : Js) (key : Text) (rangeHeader : Text) : {Async} Js :=
  let range := parseRange rangeHeader
  let options :=
    match range with
    | Option.some r =>
        let bounds := ("offset", Js.int r.offset) :: Option.getOr (Option.map (fun n => [("length", Js.int n)]) r.length) []
        [Js.obj [("range", Js.obj bounds)]]
    | Option.none => []
  match toOption (Async.await (Js.method bucket "get" (Js.text key :: options))) with
  | Option.none => Http.problem 404 "no such pack"
  | Option.some object =>
      -- A pack never changes once its index is listed, so a cached copy is always right.
      let headers := [("content-type", R2.contentType object),
        ("cache-control", "public, max-age=31536000, immutable"),
        ("accept-ranges", "bytes")]
      match range with
      | Option.none => response (Js.get object "body") 200 headers
      | Option.some r =>
          let size := toInt (Js.get object "size")
          let held := toOption (Js.get object "range")
          let offset := Option.getOr (Option.map (fun h => toInt (Js.get h "offset")) held) r.offset
          let length := Option.getOr
            (Option.bind held (fun h => Option.map toInt (toOption (Js.get h "length"))))
            (Option.getOr r.length (size - offset))
          let span := "bytes " ++ Int.toText offset ++ "-" ++ Int.toText (offset + length - 1) ++ "/" ++
            Int.toText size
          response (Js.get object "body") 206 (headers ++ [("content-range", span)])