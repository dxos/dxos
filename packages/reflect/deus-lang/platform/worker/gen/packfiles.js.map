/-- Stores `body` (text, bytes or a stream) at `key` with `contentType`. -/
def Worker.R2.put (bucket : Js) (key : Text) (body : Js) (contentType : Text) : {Async} Unit :=
  let options := Js.obj [("httpMetadata", Js.obj [("contentType", Js.text contentType)])]
  Async.await (Js.method bucket "put" [Js.text key, body, options])
  ()