/-
  What the Worker accepts as a name in a project's bucket folder, in DEUS (task 41714c0d, D164): bundle names, file
  path segments, the file folders clients write, and the scope that writes each. platform/worker/remote.mjs answers
  the requests around them.
-/
/-- A bundle's name: a level of one to three digits, `-`, and its SHA-256 (D50, D91). -/
def Worker.Paths.isBundle (name : Text) : Bool :=
  match Text.split name "-" with
  | level :: hash :: [] => Text.length level >= 1 && Text.length level <= 3 && List.all Text.isDigit (Text.utf8 level) && Heads.isHash hash
  | _ => false