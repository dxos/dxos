/-- The bundles of `project` in the R2 `bucket`. -/
def Worker.Bundles.r2Store (bucket : Js) (project : Text) : Store Js :=
  let folder := project ++ "/bundles/"
  Store.mk (fun _ => listAll bucket folder) (fun name =>
    match R2.get bucket (folder ++ name) with
    | Option.none => Option.none
    | Option.some object => Option.some (Js.get object "body")) (fun name => R2.exists bucket (folder ++ name)) (fun name bytes => R2.put bucket (folder ++ name) bytes "application/gzip") (fun name => toTrash bucket project "bundles" name) (fun bytes =>
    match Crypto.gunzip bytes with
    | Option.none => Option.none
    | Option.some inflated => Option.some (Crypto.sha256 inflated))