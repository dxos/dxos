/-- `bytes` gunzipped, or none when they are not gzip. -/
def Worker.Crypto.gunzip (bytes : Js) : {Async} Option Js :=
  let stream := Js.method
    (Js.method (Js.construct (Js.global "Blob") [Js.list [bytes]]) "stream" [])
    "pipeThrough"
    [Js.construct (Js.global "DecompressionStream") [Js.text "gzip"]]
  let read := Js.method (Js.construct (Js.global "Response") [stream]) "arrayBuffer" []
  -- A stream that is not gzip rejects; the rejection becomes none, so the caller answers 400 rather than failing.
  let buffer := Async.await (Js.method read "then" [Js.fn (fun value => value), Js.fn (fun _ => Js.null)])
  Option.map R2.bytes (toOption buffer)