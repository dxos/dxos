/-- A push of `name`: kept once, refused when it is not what its name says, and stored only once the head moved. -/
def Worker.Bundles.push
    (store : Store b)
    (name : Text)
    (verify : Bool)
    (body : Unit -> {Async} b)
    (authorize : Text -> {Async} Unit)
    (moveHead : Unit -> {Async} Option f)
    : {Async} Bundles.Reply b f :=
  authorize "push"
  let sent := body ()
  if Store.holds store name then Reply.report name "stored" false 200 else
    let problem := if verify then pushProblem name (digest store sent) else Option.none
    match problem with
    | Option.some (status, message) => Reply.problem status message
    | Option.none =>
        match moveHead () with
        | Option.some refusal => Reply.refused refusal
        | Option.none =>
            Store.write store name sent
            Reply.report name "stored" true 201