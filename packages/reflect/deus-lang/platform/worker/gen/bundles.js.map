/-- Answers `/v1/<project>/bundles/<rest>` for `request`, on the R2 `bucket`. `verify` checks that a bundle sent is
  gzip and hashes to its name. `authorize scope` is remote.mjs's key check (as for `Worker.Files.serve`), and
  `moveHead logged` moves the branch head the push claims, giving a promise of the response that refuses the push, or
  of `undefined` when the head moved. -/
def Worker.Bundles.serve (request : Js) (bucket : Js) (project : Text) (rest : List Text) (verify : Bool) (authorize : Text -> Js) (moveHead : Js -> Js) : {Async} Js :=
  let folder := project ++ "/bundles/"
  let verb := Http.method request
  match rest with
  | [] => if verb == "GET" then Http.lines (listAll bucket folder) else problem 405 "method not allowed"
  | "" :: [] => if verb == "GET" then Http.lines (listAll bucket folder) else problem 405 "method not allowed"
  | name :: [] => if not (isBundle name) then problem 404 "not a bundle name" else
      let key := folder ++ name
      if verb == "GET" then
        match R2.get bucket key with
        | Option.none => problem 404 "no such bundle"
        | Option.some object =>
            -- A bundle never changes, so a cached copy is always right.
            response
              (Js.get object "body")
              200
              [("content-type", "application/gzip"), ("cache-control", "public, max-age=31536000, immutable")]
      else if verb == "PUT" then
        let logged := Async.await (authorize "push")
        let bytes := R2.bytes (Async.await (Js.method request "arrayBuffer" []))
        if R2.exists bucket key then Js.call logged [report name "stored" false 200] else
          let problem := if not verify then Option.none else
            match Crypto.gunzip bytes with
            | Option.none => Option.some (problem 400 "a bundle is sent gzipped")
            | Option.some text => if Option.some (Crypto.sha256 text) == List.get? (Text.split name "-") 1 then Option.none else Option.some (problem 400 "the bundle does not hash to its name")
          match problem with
          | Option.some answer => answer
          | Option.none =>
              match toOption (Async.await (moveHead logged)) with
              | Option.some refused => Js.call logged [refused]
              | Option.none =>
                  R2.put bucket key bytes "application/gzip"
                  Js.call logged [report name "stored" true 201]
      else if verb == "DELETE" then
        -- Only compaction deletes a bundle, once strata hold everything it lists (D73), and into the trash, so a
        -- compaction bug costs storage, never history.
        let logged := Async.await (authorize "compact")
        toTrash bucket project "bundles" name
        Js.call logged [report name "deleted" true 200]
      else problem 405 "method not allowed"
  | _ => problem 404 "not a bundle name"