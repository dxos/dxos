/-- Answers `verb` on `/v1/<project>/bundles/<rest>` over `store`, without R2 or a request, so a simulated store
  drives it in tests (task 019e7afe). `body` reads what a push sends; `authorize scope` checks the key, failing
  the request when it does not allow `scope`; `moveHead` moves the branch head a push claims, giving the refusal
  when it cannot. -/
def Worker.Bundles.answer
    (store : Store b)
    (verb : Text)
    (rest : List Text)
    (verify : Bool)
    (body : Unit -> {Async} b)
    (authorize : Text -> {Async} Unit)
    (moveHead : Unit -> {Async} Option f)
    : {Async} Bundles.Reply b f :=
  match rest with
  | [] => Bundles.listing store verb
  | "" :: [] => Bundles.listing store verb
  | name :: [] => if not (isBundle name) then Reply.problem 404 "not a bundle name" else if verb == "GET" then
      match Store.read store name with
      | Option.none => Reply.problem 404 "no such bundle"
      | Option.some found => Reply.bundle found
    else if verb == "PUT" then Bundles.push store name verify body authorize moveHead
      else if verb == "DELETE" then
      -- Only compaction deletes a bundle, once strata hold everything it lists (D73), and into the trash, so a
      -- compaction bug costs storage, never history.
      authorize "compact"
      trash store name
      Reply.report name "deleted" true 200
    else Reply.problem 405 "method not allowed"
  | _ => Reply.problem 404 "not a bundle name"