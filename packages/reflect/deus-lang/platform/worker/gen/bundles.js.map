/-- Answers `/v1/<project>/bundles/<rest>` for `request`, on the R2 `bucket` (`answer`). `authorize scope` is
  remote.mjs's key check (as for `Worker.Files.serve`), giving the function that records a write, and `moveHead
  logged` moves the branch head the push claims, giving a promise of the response that refuses the push, or of
  `undefined` when the head moved. -/
def Worker.Bundles.serve
    (request : Js)
    (bucket : Js)
    (project : Text)
    (rest : List Text)
    (verify : Bool)
    (authorize : Text -> Js)
    (moveHead : Js -> Js)
    : {Async} Js :=
  let logged := Ref.new undefined
  let reply := Bundles.answer
    (r2Store bucket project)
    (Http.method request)
    rest
    verify
    (fun _ => R2.bytes (Async.await (Js.method request "arrayBuffer" [])))
    (fun scope => Ref.set logged (Async.await (authorize scope)))
    (fun _ => toOption (Async.await (moveHead (Ref.get logged))))
  match reply with
  | Reply.listing names => Http.lines names
  | Reply.bundle body =>
      -- A bundle never changes, so a cached copy is always right.
      response body 200 [("content-type", "application/gzip"),
        ("cache-control", "public, max-age=31536000, immutable")]
  | Reply.report name field value status => Js.call (Ref.get logged) [Bundles.report name field value status]
  | Reply.problem status message => Http.problem status message
  | Reply.refused refusal => Js.call (Ref.get logged) [refusal]