/-- The keys under `prefix`, without it, from the page `cursor` names to the last. -/
def Worker.R2.listFrom (bucket : Js) (prefix : Text) (cursor : Option Text) : {Async} List Text :=
  let at := Option.getOr (Option.map (fun c => [("cursor", Js.text c)]) cursor) []
  let page := Async.await (Js.method bucket "list" [Js.obj (("prefix", Js.text prefix) :: at)])
  let skip := Text.length prefix
  let keys := List.map
    (fun object => Text.drop skip (Js.toText (Js.get object "key")))
    (Js.toList (Js.get page "objects"))
  if toBool (Js.get page "truncated") then keys ++ Worker.R2.listFrom bucket prefix (Option.some (Js.toText (Js.get page "cursor"))) else keys