/-- Answers `/v1/<project>/<area>/<rest>`, where `area` is `objects` or `meta`, for `request`. `lookup id kind`
  finds a text in the packs (kind 1 an object, 2 its metadata), giving a promise of the text or `undefined`. -/
def Worker.Objects.serve
    (request : Js)
    (area : Text)
    (rest : List Text)
    (lookup : Text -> Int -> Js)
    : {Async} Js :=
  let id := Js.toText (Js.call (Js.global "decodeURIComponent") [Js.text (Text.join "/" rest)])
  if Http.method request != "GET" then Http.problem 405 "method not allowed"
    else if List.length rest != 1 || not (isObjectId id) then Http.problem 404 "an object is named by its hash or a builtin id" else
    match toOption (Async.await (lookup id (if area == "meta" then 2 else 1))) with
    | Option.none => Http.problem 404 ("no " ++ (if area == "meta" then "metadata" else "object") ++ " " ++ id ++
        " in this project's packs")
    | Option.some text =>
        -- An object never changes, so a cached copy is always right.
        response text 200 [("content-type", "text/plain; charset=utf-8"),
          ("cache-control", "public, max-age=31536000, immutable")]