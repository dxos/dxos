/-- A member's id: a hash, `.`, and its index, one to six digits. -/
def Worker.Objects.isMember (id : Text) : Bool :=
  match Text.split id "." with
  | hash :: index :: [] => Heads.isHash hash && Text.length index >= 1 && Text.length index <= 6 && List.all Text.isDigit (Text.utf8 index)
  | _ => false