/-- The area that answers a path within a project. -/
def Worker.Routes.areaOf (path : Text) : Text := if path == "/v1" || Text.startsWith "/v1/" path then "v1"
  else if Text.startsWith "/auth/" path then "auth" else if Text.startsWith "/api/" path then "api"
  else if Text.startsWith "/assets/" path then "assets" else "site"