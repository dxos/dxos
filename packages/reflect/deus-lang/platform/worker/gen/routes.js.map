/-- A path a page pinned to a site version: `/v/<16 hex digits>/…`, as (version, the path after it). -/
def Worker.Routes.pinned (path : Text) : Option (Text, Text) := if not (Text.startsWith "/v/" path) then Option.none else
  let rest := Text.drop 3 path
  let version := Text.take 16 rest
  let after := Text.drop 16 rest
  if Text.length version == 16 && List.all (fun c => Text.isDigit c || c >= 'a' && c <= 'f') (Text.utf8 version) && Text.startsWith "/" after then Option.some (version, after)
    else Option.none