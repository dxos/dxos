/-- A spec document's page (D196): its `.mdl` text and its blocks in reading order, so the explorer can
  show the document itself, with each requirement, api and law linked to what proves or implements it. -/
def Explorer.docJson (s : Site) (d : Text) : {IO} Json :=
  let text := document s.dir (Site.ns s) d
  let blockJson := fun b => Json.obj [("type", Json.str b.blockType), ("id", Json.str b.blockId), ("title", Json.str b.blockTitle), ("line", Json.num b.lineNo), ("props", Json.obj (List.map (fun p => (fst p, Json.str (snd p))) b.props))]
  Json.obj [("name", Json.str d), ("text", Json.str text), ("blocks", Json.arr (List.map blockJson (Mdl.parse text).blocks))]