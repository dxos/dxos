/-- A row argument is always printed in braces, even when it is only a variable. -/
def Types.rowArgument (text : Text) (tail : Option Int) (seen : Ref (Map Text Text)) : Text := if text != "" then text else
  match tail with
  | Option.some id => "{" ++ varName seen ("r" ++ Int.toText id) true ++ "}"
  | Option.none => "{}"