def Types.rowVarCounts (t : TType) (acc : Map Int Int) : Map Int Int :=
  match t with
  | TType.con _ args => foldl (fun m a => Types.rowVarCounts a m) acc args
  | TType.fn a r b => Types.rowVarCounts b (rowCounts r (Types.rowVarCounts a acc))
  | TType.var _ => acc
  | TType.row r => rowCounts r acc