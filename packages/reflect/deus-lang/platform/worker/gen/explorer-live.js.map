def Print.application (p : Printer) (f : Sexp) (args : List Sexp) (env : List Text) (ind : Int) (prec : Int) : Text :=
  let supply := Ref.get p.supply
  let fresh := Ref.get p.fresh
  let names := hintNames p f args
  let flat := Print.expr p f env ind 90 ++
    Text.concat (mapIndexed (fun i a => " " ++ hinted names i (Print.expr p a env ind 100)) args)
  if fits ind flat || List.length args < 2 then paren 90 prec flat else
    Ref.set p.supply supply
    Ref.set p.fresh fresh
    let head := Print.expr p f env ind 90
    paren 90 prec (head ++ Text.concat (mapIndexed
      (fun i a => "\n" ++ spaces (ind + 2) ++ hinted names i (Print.expr p a env (ind + 2) 100))
      args))