/-- The event type a `@[event]` structure declares; a field that is not flat is an error. -/
def Analytics.typeOf (dir : Text) (name : Text) (h : Text) (fieldNames : List Text) : {IO, Throw Text} EventType :=
  let types :=
    match readObject dir h with
    | Option.some (Sexp.list (Sexp.sym "type" :: _ :: Sexp.int 0 :: Sexp.list (Sexp.sym "ctor" :: _ :: tys) :: [])) => tys
    | _ => Throw.throw (name ++ " is marked @[event] but is not a structure without parameters")
  let columns := List.map (fun pair =>
    match Analytics.columnTypeOf (snd pair) with
    | Option.some kind => Column.mk (fst pair) kind
    | Option.none => Throw.throw ("event " ++ name ++ ": field " ++ fst pair ++ " is not Int, Bool, Text or CodeRef")) (zip fieldNames types)
  EventType.mk name h columns