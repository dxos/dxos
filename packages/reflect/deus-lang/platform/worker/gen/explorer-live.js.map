/-- Every event type in a namespace, by name. -/
def Analytics.types (dir : Text) (ns : Map Text Entry) : {IO, Throw Text} List EventType := filterMap (fun pair =>
  match snd pair with
  | Entry.type h _ fields => if isEvent dir h then Option.some (Analytics.typeOf dir (fst pair) h fields) else Option.none
  | _ => Option.none) (Map.toList ns)