def Types.showTypeWith (names : Map Text Text) (t : TType) (seen : Ref (Map Text Text)) (prec : Int) (shared : Map Int Unit) : Text :=
  match t with
  | TType.var id => varName seen ("t" ++ Int.toText id) false
  | TType.con "#Pair" (a :: b :: []) => "(" ++ Types.showTypeWith names a seen 0 shared ++ ", " ++
      Types.showTypeWith names b seen 0 shared ++ ")"
  | TType.con iri [] => Types.nameOf names iri
  | TType.con iri args => paren 90 prec (Types.nameOf names iri ++
      Text.concat (List.map (fun a => " " ++ Types.showTypeWith names a seen 100 shared) args))
  | TType.fn a r b =>
      let rowText := showRowWith names r seen shared
      paren 10 prec (Types.showTypeWith names a seen 11 shared ++ " -> " ++
        (if rowText == "" then "" else rowText ++ " ") ++ Types.showTypeWith names b seen 10 shared)
  | TType.row r => rowArgument (showRow r seen) (resolveTail r) seen