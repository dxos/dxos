/-- The parts of a notation with its holes written in, on one line when it fits, else with its last
  repetition one item per line. -/
def Print.notationText (p : Printer) (rule : Loaded) (holes : List Sexp) (named : List (List Text)) (env : List Text) (ind : Int) : Option Text :=
  let render := fun at => pieces p rule holes named env at
  match render ind with
  | Option.none => Option.none
  | Option.some pieces =>
      let flat := spaced (List.map (fun piece => flatPiece piece) pieces)
      let lastRepeat := last? (filterMap (fun pair =>
        match snd pair with
        | Part.hole _ _ _ repeat => if repeat != "" then Option.some (fst pair) else Option.none
        | _ => Option.none) (mapIndexed (fun k part => (k, part)) rule.ruleParts))
      let breakable :=
        match lastRepeat with
        | Option.some k =>
            match get? pieces k with
            | Option.some items => List.length items > 0
            | Option.none => false
        | Option.none => false
      if fits ind flat || not breakable then Option.some flat else
        match (lastRepeat, render (ind + 2)) with
        | (Option.some k, Option.some deeper) =>
            let before := spaced (List.map flatPiece (List.take k pieces))
            let after := spaced (List.map flatPiece (List.drop (k + 1) pieces))
            let items := getOr (get? deeper k) []
            Option.some (before ++ Text.concat (List.map (fun item => "\n" ++ spaces (ind + 2) ++ item) items) ++
              "\n" ++ spaces ind ++ after)
        | _ => Option.some flat