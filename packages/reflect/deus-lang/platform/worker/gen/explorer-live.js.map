/-- Feature maps as `deus features --json` prints them and the explorer's `features.json` holds them
  (D118): per document, its features in tree order with status, links, open tasks and problems,
  then notes on blocks that do not parse and features whose parent is missing. -/
def Cli.featuresJson (dir : Text) (ns : Map Text Entry) (docs : List Text) : {IO, Throw Text} Json :=
  let facts := featureFacts dir ns
  Json.arr (List.map (fun d =>
    let (fs, bad) := featuresOf dir ns d
    Json.obj [("document", Json.str d), ("features", Json.arr (List.map (fun pair =>
      let (depth, f) := pair
      let opened := List.filter (fun id =>
        match facts ("task:" ++ id) with
        | Result.ok known => isOpenState (prop0 known "state")
        | Result.err _ => false) f.taskIds
      Json.obj [("id", Json.str f.featureId), ("title", Json.str f.featureTitle), ("status", Json.str f.featureStatus), ("parent", Json.str f.parentId), ("depth", Json.num depth), ("specs", Json.arr (List.map Json.str f.specDocs)), ("defs", Json.arr (List.map Json.str f.definitions)), ("tasks", Json.arr (List.map Json.str f.taskIds)), ("openTasks", Json.arr (List.map Json.str opened)), ("problems", Json.arr (List.map Json.str (Features.problems f facts)))]) (Features.tree fs))), ("notes", Json.arr (List.map Json.str (featureNotes facts fs bad)))]) docs)