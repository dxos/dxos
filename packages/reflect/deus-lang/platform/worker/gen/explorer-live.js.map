/-- A spec document as `.mdl` text (D99): its frontmatter, then each block after the prose that
  preceded it, in the stored order, then the closing prose. The Extensions table is written from
  the blocks' URIs under the document's own Extensions heading, or at the top when it has none.
  Blocks with no stored order (added before D99) come last, by name. -/
def Export.document (dir : Text) (ns : Map Text Entry) (d : Text) : {IO} Text :=
  let blocks := filterMap (fun pair =>
    match pair with
    | (name, Entry.spec h) => if documentOf name == d then Option.map (fun obj =>
        let meta := readMeta dir h
        let order :=
          match metaField meta "order" with
          | Option.some (Sexp.int k) => k
          | _ => 1000000
        (order, name, Mdl.fromSexp obj, meta)) (readObject dir h) else Option.none
    | _ => Option.none) (Map.toList ns)
  let sorted := sortBy (fun a b =>
    let ((oa, na, _, _), ob, nb, _, _) := (a, b)
    if oa == ob then compare na nb else compare oa ob) blocks
  let text := fun meta key => getOr (Option.map asText (metaField meta key)) ""
  let front :=
    match sorted with
    | (_, _, _, meta) :: _ => filterMap (fun kv =>
        match kv with
        | Sexp.list (k :: v :: []) => Option.some (asText k, asText v)
        | _ => Option.none) (metaList meta "front")
    | [] => []
  let frontLines := if any (fun kv => fst kv == "name") front then front else ("name", d) :: List.filter (fun kv => fst kv != "name") front
  let terms := dedup (sort (List.map (fun x =>
    let (_, _, (uri, b), _) := x
    "| `" ++ b.blockType ++ "` | `" ++ uri ++ "` |") sorted))
  let table := join "\n" (["| Term | URI |", "| --- | --- |"] ++ terms)
  let pieces := concatMap (fun x =>
    let (_, _, (_, b), meta) := x
    List.filter (fun t => not (Text.isEmpty t)) [text meta "lead", Mdl.render b]) sorted
  let tail :=
    match last? sorted with
    | Option.some (_, _, _, meta) => text meta "tail"
    | Option.none => ""
  let bodyLines := Text.lines (join "\n\n" (pieces ++ (if Text.isEmpty tail then [] else [tail])))
  let isExtensions := fun l => startsWith "#" (trim l) && headingOf (trim l) == "Extensions"
  let body := if any isExtensions bodyLines then
    let at := findIndex isExtensions bodyLines
    join "\n" (List.take (at + 1) bodyLines ++ ["", table] ++ List.drop (at + 1) bodyLines)
  else join "\n" (["## Extensions", "", table, ""] ++ bodyLines)
  join
    "\n"
    (["---"] ++ List.map (fun kv => fst kv ++ ": " ++ snd kv) frontLines ++ ["---", "", body]) ++ "\n"