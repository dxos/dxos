def Types.showRowWith (names : Map Text Text) (r : TRow) (seen : Ref (Map Text Text)) (shared : Map Int Unit) : Text :=
  let rec labels row acc :=
    match row with
    | TRow.extend l rest => labels rest (showTypeWith names l seen 0 shared :: acc)
    | TRow.var id => (reverse acc, if Set.contains id shared then Option.some (varName seen ("r" ++ Int.toText id) true) else Option.none, true)
    | TRow.empty => (reverse acc, Option.none, false)
  match labels r [] with
  | ([], Option.none, true) => ""
  | ([], Option.none, false) => "{}"
  | ([], Option.some tail, _) => "{" ++ tail ++ "}"
  | (ls, Option.none, _) => "{" ++ join ", " ls ++ "}"
  | (ls, Option.some tail, _) => "{" ++ join ", " ls ++ " | " ++ tail ++ "}"