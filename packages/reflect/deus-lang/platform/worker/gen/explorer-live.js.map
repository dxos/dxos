def Sexp.quote (t : Text) : Text := if Sexp.plain t then "\"" ++ t ++ "\"" else
  let n := Text.length t
  -- Copies each run of plain codes as one slice, so only the codes that need escaping cost a call.
  let rec go start i acc := if i >= n then Text.slice t start n :: acc else
    let c := code t i
    if c == 34 || c == 92 || c < 32 || c == 127 then go (i + 1) (i + 1) (quoteCode c :: Text.slice t start i :: acc) else go start (i + 1) acc
  "\"" ++ Text.concat (reverse (go 0 0 [])) ++ "\""