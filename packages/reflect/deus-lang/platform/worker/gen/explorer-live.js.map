/-- `tasks.json`: every task, with the changes that touched it. -/
def Explorer.tasksJson (s : Site) : {IO, Throw Text} Json :=
  let histories := histories s.dir 200
  Json.arr (List.map
    (fun t => Explorer.taskJson s.dir (Site.ns s) (getOr (Map.lookup (Task.id t) histories) []) t)
    s.allTasks)