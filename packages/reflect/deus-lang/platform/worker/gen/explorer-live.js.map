/-- A history node's comments snapshot: subject -> thread hash. -/
def Comments.snapshotOf (dir : Text) (c : Causal) : {IO, Throw Text} Map Text Text := if Text.isEmpty c.threads then Map.empty else
  match readObject dir c.threads with
  | Option.none => Throw.throw ("missing comments snapshot #" ++ c.threads)
  | Option.some form => Map.fromList (List.map (fun item =>
      match Sexp.args item with
      | subject :: ref :: [] => (asText subject, asText (getOr (head? (Sexp.args ref)) (Sexp.str "")))
      | _ => defect ("bad comments entry " ++ Sexp.print item)) (Sexp.args form))