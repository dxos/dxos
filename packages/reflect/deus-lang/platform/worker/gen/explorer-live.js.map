/-- `restore`, also putting back the notations each node was written with as `(notation "key" e)`,
  outermost first (Syntax.Spec R-5). -/
def Print.restoreAll (notes : List (Int, Text)) (spellings : List (Int, Text)) (notations : List (Int, Text)) (core : Sexp) : Sexp := if List.isEmpty notes && List.isEmpty spellings && List.isEmpty notations then core else
  let byIndex := Map.fromList notes
  let spelledAt := Map.fromList spellings
  let notationsAt := foldl
    (fun m pair => Map.insert (fst pair) (getOr (Map.lookup (fst pair) m) [] ++ [snd pair]) m)
    Map.empty
    notations
  let rec go x count :=
    match x with
    | Sexp.list items =>
        let rec each rest out c :=
          match rest with
          | [] => (reverse out, c)
          | y :: more =>
              let (y2, c2) := go y c
              each more (y2 :: out) c2
        let (children, next) := each items [] (count + 1)
        let spelled :=
          match Map.lookup count spelledAt with
          | Option.some text => Sexp.node "spelled" [Sexp.str text, Sexp.list children]
          | Option.none => Sexp.list children
        let rebuilt := List.foldr
          (fun key e => Sexp.node "notation" [Sexp.str key, e])
          spelled
          (getOr (Map.lookup count notationsAt) [])
        match Map.lookup count byIndex with
        | Option.some text => (Sexp.node "note" [Sexp.str text, rebuilt], next)
        | Option.none => (rebuilt, next)
    | _ => (x, count)
  fst (go core 0)