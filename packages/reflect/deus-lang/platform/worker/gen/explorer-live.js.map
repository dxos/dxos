/-- Text without its inlay hints: what a reader counts when a line is measured. -/
def Print.unhinted (text : Text) : Text :=
  let start := indexOf text hintOpen 0
  if start < 0 then text else
    let stop := indexOf text hintClose start
    if stop < 0 then text else Print.unhinted (Text.slice text 0 start ++ Text.drop (stop + 1) text)