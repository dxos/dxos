/-- Shortest suffix of `fqn`, of at least `least` segments, that names nothing else in the namespace. -/
def Print.suffixifyAtLeast (least : Int) (all : Dict Text (List Text)) (fqn : Text) : Text :=
  let segments := Text.split fqn "."
  let count := List.length segments
  let rec go k := if k >= count then fqn else
    let candidate := join "." (List.drop (count - k) segments)
    let clashes := List.filter
      (fun other => other == candidate || endsWith ("." ++ candidate) other)
      (getOr (Dict.lookup (lastSegment fqn) all) [])
    if List.length clashes <= 1 then candidate else go (k + 1)
  go least