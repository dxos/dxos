def Mdl.block (start : Int) (lines : List Text) : Block :=
  match List.filter (fun l => not (Text.isEmpty (trim l))) lines with
  | [] => Block.mk "" "" "" [] start
  | first :: rest =>
      match Mdl.header (trim first) start with
      | Block.mk x0 x1 x2 x3 x4 => Block.mk x0 x1 x2 (Mdl.body rest) x4