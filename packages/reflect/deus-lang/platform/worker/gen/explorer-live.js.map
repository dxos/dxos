/-- Elements of a list built from cons cells ending in nil, if it is one. -/
def Print.listItems (t : Sexp) : Option (List Sexp) :=
  match t with
  | Sexp.list (Sexp.sym "con" :: Sexp.str "#List" :: Sexp.int 0 :: Sexp.int 0 :: []) => Option.some []
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "con" :: Sexp.str "#List" :: Sexp.int 1 :: Sexp.int 2 :: []) :: h :: rest :: []) => Option.map (fun items => h :: items) (Print.listItems rest)
  | _ => Option.none