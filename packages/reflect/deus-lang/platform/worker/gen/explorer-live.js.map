/-- `runs` with a dialect's keywords; comments are DEUS's (`--`, `/- -/`) or TypeScript's (`//`, `/* */`). -/
def Highlight.runsWith (kws : Map Text Unit) (source : Text) : List (Text, Text) :=
  let n := Text.length source
  let rec scan i acc := if i >= n then reverse acc else
    let c := code source i
    if c == 1 then
      let stop := indexOf source (fromCode 2) i
      let j := if stop < 0 then n else stop
      scan (j + 1) (("hint", Text.slice source (i + 1) j) :: acc)
    else if c == '"' then
      let rec close j := if j >= n then n else if code source j == '\\' then close (j + 2) else if code source j == '"' then j + 1 else close (j + 1)
      let j := close (i + 1)
      scan j (("str", Text.slice source i j) :: acc)
    else if c == '/' && i + 1 < n && code source (i + 1) == '-' then
      let stop := indexOf source "-/" (i + 2)
      let j := if stop < 0 then n else stop + 2
      scan j (("cm", Text.slice source i j) :: acc)
    else if c == '/' && i + 1 < n && code source (i + 1) == '*' then
      let stop := indexOf source "*/" (i + 2)
      let j := if stop < 0 then n else stop + 2
      scan j (("cm", Text.slice source i j) :: acc)
    else if (c == '-' || c == '/') && i + 1 < n && code source (i + 1) == c then
      let stop := indexOf source "\n" i
      let j := if stop < 0 then n else stop
      scan j (("cm", Text.slice source i j) :: acc)
    else if isAlpha c || c == '_' then
      let rec word j := if j < n && isWordChar (code source j) then word (j + 1) else j
      let j := word i
      let w := Text.slice source i j
      let kind := if Map.contains w kws then "kw" else if c >= 'A' && c <= 'Z' then "ty" else "plain"
      scan j ((kind, w) :: acc)
    else scan (i + 1) (("plain", fromCode c) :: acc)
  scan 0 []