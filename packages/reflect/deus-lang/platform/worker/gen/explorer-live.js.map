/-- Whether a match scrutinizes the equation parameters: `(var 0)`, or their tuple in order. -/
def Print.equationScrutinee (scrut : Sexp) (count : Int) : Bool := if count == 1 then scrut == Sexp.node "var" [Sexp.int 0] else scrut ==
  Resolve.tuple (List.map (fun i => Sexp.node "var" [Sexp.int (count - 1 - i)]) (range 0 count))