/-- The type hashes of `Syntax.Notation` and `Syntax.Part`, which a stored notation is built from. -/
def Cli.notationTypes (ns : Map Text Entry) : Option (Text, Text) :=
  match (Map.lookup "Syntax.Notation" ns, Map.lookup "Syntax.Part" ns) with
  | (Option.some (Entry.type n _ _), Option.some (Entry.type t _ _)) => Option.some (n, t)
  | _ => Option.none