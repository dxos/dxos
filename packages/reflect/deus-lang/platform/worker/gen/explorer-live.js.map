/-- Whether a one-arm match on `pat` reads as `let pat := value` (D176): a tuple of names, `_` and
  tuples, which always matches. `let` of a plain name compiles to `let`, not `match`, so it is not one. -/
def Print.destructures (pat : Sexp) : Bool :=
  match pat with
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str "#Pair" :: _ :: subs) => List.all alwaysMatches subs
  | _ => false