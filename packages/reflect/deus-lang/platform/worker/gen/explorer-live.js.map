/-- Reads a stored notation: `Syntax.Notation.mk category precedence parts expansion` with literal
  arguments, where `notationType` and `partType` are the two types' hashes. -/
def Syntax.decodeRule (notationType : Text) (partType : Text) (key : Text) (fqn : Text) (core : Sexp) : Option Loaded :=
  let text := fun s =>
    match s with
    | Sexp.list (Sexp.sym "text" :: Sexp.str v :: []) => Option.some v
    | _ => Option.none
  let number := fun s =>
    match s with
    | Sexp.list (Sexp.sym "int" :: Sexp.int v :: []) => Option.some v
    | _ => Option.none
  let part := fun s =>
    match s with
    | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "con" :: Sexp.str t :: Sexp.int tag :: _) :: args) => if t != partType then Option.none else if tag == 0 then Option.map Part.lit (Option.bind (head? args) text) else if tag == 2 then Option.map Part.again (Option.bind (head? args) number) else
        match args with
        | i :: c :: p :: r :: [] =>
            match (number i, text c, number p, text r) with
            | (Option.some index, Option.some category, Option.some prec, Option.some repeat) => Option.some (Part.hole index category prec repeat)
            | _ => Option.none
        | _ => Option.none
    | _ => Option.none
  match core with
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "con" :: Sexp.str t :: Sexp.int 0 :: _) :: category :: prec :: parts :: template :: []) => if t != notationType then Option.none else
      match (text category, number prec, listItems parts) with
      | (Option.some c, Option.some n, Option.some items) =>
          let decoded := List.map part items
          if List.all isSome decoded then Option.some (Loaded.mk key fqn c n (filterMap (fun x => x) decoded) (Option.some template)) else Option.none
      | _ => Option.none
  | _ => Option.none