--
--
/-- The argument types of a run of pure arrows and what follows them; an arrow with a row ends the run. -/
def Ts.arrows (t : Sexp) : (List Sexp, Sexp) :=
  match t with
  | Sexp.list (Sexp.sym "tfun" :: a :: b :: []) =>
      let (args, result) := Ts.arrows b
      (a :: args, result)
  | Sexp.list (Sexp.sym "tfun" :: a :: b :: row :: []) => ([a], Sexp.node "teff" [row, b])
  | _ => ([], t)