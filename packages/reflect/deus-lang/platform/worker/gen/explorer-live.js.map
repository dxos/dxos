--
--
def Types.typeToSexp (t : TType) : Sexp :=
  match t with
  | TType.con iri args => if List.isEmpty args then Sexp.node "tref" [Sexp.str iri] else Sexp.node "tapp" (Sexp.node "tref" [Sexp.str iri] :: List.map Types.typeToSexp args)
  | TType.fn a r b => Sexp.node "tfun" [Types.typeToSexp a, Types.typeToSexp b, rowToSexp r]
  | TType.var id => Sexp.node "tvar" [Sexp.str ("t" ++ Int.toText id)]
  | TType.row r => Sexp.node "trow" (Sexp.args (rowToSexp r))