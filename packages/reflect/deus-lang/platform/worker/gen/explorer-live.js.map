/-- A notation definition as the `notation` declaration it came from (Syntax.Spec R-9): a hole
  prints its category, and its precedence only when the parser would not settle on the same one. -/
def Print.notationDecl (p : Printer) (name : Text) (rule : Loaded) : Option Text :=
  match rule.ruleTemplate with
  | Option.none => Option.none
  | Option.some template =>
      let count := holeCount rule.ruleParts
      let rec binders t k env := if k == 0 then Option.some (t, env) else
        match t with
        | Sexp.list (Sexp.sym "lam" :: b :: []) => binders b (k - 1) (Print.bind p env :: env)
        | _ => Option.none
      match binders template count [] with
      | Option.none => Option.none
      | Option.some (body, env) =>
          let holeNames := reverse env
          let nameOf := fun i => getOr (get? holeNames i) "_"
          let parts := rule.ruleParts
          let partText := fun k part =>
            match part with
            | Part.lit text => quoteText text
            | Part.again i => nameOf i
            | Part.hole i c n repeat =>
                let kind := if c != "term" then ":" ++ c else if n == defaultPrec rule.ruleCategory rule.rulePrec parts k then "" else ":" ++ Int.toText n
                nameOf i ++ kind ++ repeat
          let head := if rule.ruleCategory == "term" && rule.rulePrec == 65 then "" else " : " ++ rule.ruleCategory ++
            (if rule.rulePrec == 65 then "" else " " ++ Int.toText rule.rulePrec)
          Option.some ("notation " ++ name ++ head ++ " := " ++ join " " (mapIndexed partText parts) ++ " =>" ++
            Print.body p body env 0)