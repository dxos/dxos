/-- The parents of a causal node that the store has. History a remote trimmed before D73 is
  shallow: its oldest nodes have parents nobody keeps, and they act as roots. -/
def Codebase.parentsOf (dir : Text) (h : Text) : {IO, Throw Text} List Text := List.filter (fun p => IO.exists (objectPath dir p)) (readCausal dir h).parents