/-- The patterns of an equation arm: a right-nested pair pattern split into `count` columns. -/
def Print.patternColumns (p : Printer) (pat : Sexp) (env : List Text) (count : Int) : (Text, List Text) := if count <= 1 then patternAt p pat env 0 else
  match pat with
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str "#Pair" :: Sexp.int 0 :: a :: rest :: []) =>
      let (at, env2) := patternAt p a env 0
      let (more, env3) := Print.patternColumns p rest env2 (count - 1)
      (at ++ ", " ++ more, env3)
  | _ => patternAt p pat env 0