/-- A type's display name from its IRI: the last segment after `/`, `:` and `.`, or a builtin without its `#`. -/
def Types.iriName (iri : Text) : Text := if startsWith "#" iri then Text.drop 1 iri else
  let afterSlash := getOr (last? (Text.split iri "/")) iri
  lastSegment (getOr (last? (Text.split afterSlash ":")) afterSlash)