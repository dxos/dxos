def Ts.expr (p : Printer) (t : Sexp) (env : List Text) (ind : Int) (prec : Int) : Text :=
  match t with
  | Sexp.list (Sexp.sym "var" :: Sexp.int i :: []) => getOr (get? env i) ("$" ++ Int.toText i)
  | Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) => refName p h env
  | Sexp.list (Sexp.sym "int" :: Sexp.int v :: []) => if v < 0 then paren 95 prec (Int.toText v) else Int.toText v
  | Sexp.list (Sexp.sym "text" :: Sexp.str v :: []) => quoteText v
  | Sexp.list (Sexp.sym "prim" :: Sexp.str name :: []) => "prim(" ++ quoteText name ++ ")"
  | Sexp.list (Sexp.sym "con" :: Sexp.str ty :: Sexp.int tag :: _ :: []) => Ts.conName p ty tag
  | Sexp.list (Sexp.sym "op" :: Sexp.str a :: Sexp.int index :: _ :: []) => nameFor p (a ++ "!" ++ Int.toText index)
  | Sexp.list (Sexp.sym "if" :: a :: b :: Sexp.list (Sexp.sym "con" :: Sexp.str "#Bool" :: Sexp.int 0 :: _ :: []) :: []) => paren 35 prec (Ts.expr p a env ind 36 ++ " && " ++ Ts.expr p b env ind 35)
  | Sexp.list (Sexp.sym "if" :: a :: Sexp.list (Sexp.sym "con" :: Sexp.str "#Bool" :: Sexp.int 1 :: _ :: []) :: b :: []) => paren 30 prec (Ts.expr p a env ind 31 ++ " || " ++ Ts.expr p b env ind 30)
  | Sexp.list (Sexp.sym "if" :: c :: yes :: no :: []) => if isStatement t then doBlock p t env ind else paren
      5
      prec
      (Ts.expr p c env ind 6 ++ " ? " ++ Ts.expr p yes env ind 5 ++ " : " ++ Ts.expr p no env ind 5)
  | Sexp.list (Sexp.sym "lam" :: _) =>
      let (names, b, env2) := Ts.params p t env
      let rendered := if isStatement b then functionBody p b env2 ind else Ts.expr p b env2 ind 1
      -- A generated name (`x0`) the body never mentions was `_` in the source.
      let shown := List.map (fun x => if isGenerated x && not (Print.mentions x rendered) then "_" else x) names
      -- A lone ignored parameter reads as none: JavaScript drops extra arguments.
      let paramText := if shown == ["_"] then "" else join ", " shown
      paren 1 prec ("(" ++ paramText ++ ") => " ++ rendered)
  | Sexp.list (Sexp.sym "app" :: f :: args) =>
      match (f, args) with
      | (Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []), a :: []) =>
          match Map.lookup h p.fieldNames with
          | Option.some field => Ts.expr p a env ind 100 ++ "." ++ field
          | Option.none => Ts.application p f args env ind prec
      | (Sexp.list (Sexp.sym "prim" :: Sexp.str name :: []), a :: b :: []) =>
          match Ts.infixOf name with
          | Option.some (op, level) =>
              let supply := Ref.get p.supply
              let fresh := Ref.get p.fresh
              let flat := Ts.expr p a env ind level ++ " " ++ op ++ " " ++ Ts.expr p b env ind (level + 1)
              if fits ind flat then paren level prec flat else
                Ref.set p.supply supply
                Ref.set p.fresh fresh
                let left := Ts.expr p a env ind level
                paren level prec (left ++ " " ++ op ++ "\n" ++ spaces (ind + 2) ++
                  Ts.expr p b env (ind + 2) (level + 1))
          | Option.none => Ts.application p f args env ind prec
      | (Sexp.list (Sexp.sym "prim" :: Sexp.str "Int.neg" :: []), a :: []) => paren 95 prec ("-" ++ Ts.expr p a env ind 100)
      | (Sexp.list (Sexp.sym "con" :: Sexp.str "#Pair" :: Sexp.int 0 :: Sexp.int 2 :: []), _ :: _ :: []) => Ts.sequence p "#[" (Print.tupleItems t) env ind
      | (Sexp.list (Sexp.sym "con" :: Sexp.str "#List" :: Sexp.int 1 :: Sexp.int 2 :: []), h :: rest :: []) =>
          match listItems t with
          | Option.some items => Ts.sequence p "[" items env ind
          | Option.none => "[" ++ Ts.expr p h env ind 0 ++ ", ..." ++ Ts.expr p rest env ind 100 ++ "]"
      | _ => Ts.application p f args env ind prec
  | _ => if isBlock t then doBlock p t env ind else paren 100 prec (Sexp.print t)