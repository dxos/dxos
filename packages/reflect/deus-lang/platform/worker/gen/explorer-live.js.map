/-- A balanced tree from strictly ascending pairs in linear time: the middle pair is the root. -/
def Map.fromAscending (pairs : List (k, v)) : Map k v :=
  let rec build n xs := if n == 0 then (Map.tip, xs) else
    let half := n / 2
    let (l, rest) := build half xs
    match rest with
    | pair :: rest2 =>
        let (r, rest3) := build (n - half - 1) rest2
        (Map.mk l (fst pair) (snd pair) r, rest3)
    | [] => (l, [])
  fst (build (List.length pairs) pairs)