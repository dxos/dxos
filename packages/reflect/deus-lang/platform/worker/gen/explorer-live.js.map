/-- First-parent history of a branch, newest first. -/
def Codebase.history (dir : Text) (branch : Text) (limit : Int) : {IO, Throw Text} List (Text, Causal) :=
  let rec go h k acc := if k <= 0 then reverse acc else
    let c := peekCausal dir h
    match List.filter (fun p => IO.exists (objectPath dir p)) c.parents with
    | [] => reverse ((h, c) :: acc)
    | p :: _ => go p (k - 1) ((h, c) :: acc)
  go (headOf dir branch) limit []