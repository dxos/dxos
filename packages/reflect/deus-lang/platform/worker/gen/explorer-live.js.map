/-- `f a b` on one line when it fits, else `f` then one argument per line, indented. Binder names
  are drawn as text is made, so the one-line attempt is undone before the second. -/
def Print.ifThenElse (p : Printer) (c : Sexp) (yes : Sexp) (no : Sexp) (env : List Text) (ind : Int) (prec : Int) : Text :=
  let text := "if " ++ Print.expr p c env ind 0 ++ " then" ++ Print.body p yes env ind ++
    (if isBlock yes then "\n" ++ spaces ind else " ") ++ "else" ++ Print.body p no env ind
  paren 1 prec text