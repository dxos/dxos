/-- A namespace node's items, with its parts expanded: `(n name entry)` and `(sub segment hash)` forms. -/
def Codebase.nodeItems (dir : Text) (h : Text) : {IO, Throw Text} List Sexp :=
  match readObject dir h with
  | Option.none => Throw.throw ("missing namespace #" ++ h)
  | Option.some form => concatMap (fun item =>
      match item with
      | Sexp.list (Sexp.sym "part" :: Sexp.str child :: []) => Codebase.nodeItems dir child
      | _ => [item]) (Sexp.args form)