/-- Whether keys strictly ascend, as `toList` returns them and as stored snapshots hold them. -/
def Map.ascending (pairs : List (k, v)) : Bool :=
  match pairs with
  | a :: rest =>
      match rest with
      | b :: _ => compare (fst a) (fst b) < 0 && Map.ascending rest
      | [] => true
  | [] => true