/-- The row a type's parameter `i` stands for; a parameter first used as a row becomes one. -/
def Types.paramRow (u : Unifier) (params : List TType) (i : Int) : TRow :=
  match Option.map (fun t => Types.resolve u t) (get? params i) with
  | Option.some (TType.row r) => r
  | Option.some (TType.var id) =>
      let r := freshRow u
      MutMap.set u.types id (TType.row r)
      r
  | _ => freshRow u