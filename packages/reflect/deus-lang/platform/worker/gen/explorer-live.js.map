/-- `<type> [<id>][: <title>]`. -/
def Mdl.header (line : Text) (at : Int) : Block :=
  let colon := indexOf line ":" 0
  let head := if colon < 0 then line else Text.take colon line
  let title := if colon < 0 then "" else trim (Text.drop (colon + 1) line)
  match List.filter (fun w => not (Text.isEmpty w)) (Text.split (trim head) " ") with
  | [] => Block.mk "" "" title [] at
  | kind :: [] => Block.mk kind "" title [] at
  | kind :: ident :: _ => Block.mk kind ident title [] at