/-- A `key: value` line indented deeper than the block's first key continues the last value with
  two leading spaces, so a list item can carry fields of its own (a `qa` step's `send:`). -/
def Mdl.body (lines : List Text) : List (Text, Text) :=
  let base :=
    match List.filter (fun l => not (Text.isEmpty (trim l))) lines with
    | [] => 0
    | first :: _ => indentOf first
  reverse (foldl (fun acc line =>
    let t := trim line
    if Text.isEmpty t || startsWith "#" t then acc else if startsWith "- " t then continueWith acc (Text.drop 2 t) else
      match keyValue t with
      | Option.some kv => if indentOf line > base && not (List.isEmpty acc) then continueWith acc ("  " ++ t) else kv :: acc
      | Option.none => continueWith acc t) [] lines)