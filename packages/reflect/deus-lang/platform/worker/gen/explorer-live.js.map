/-- Pieces joined with a space wherever the two would otherwise read as one token or start a comment. -/
def Print.spaced (pieces : List Text) : Text := foldl
  (fun acc piece => if Text.isEmpty acc || Text.isEmpty piece then acc ++ piece else if needsSpace (code acc (Text.length acc - 1)) (code piece 0) then acc ++ " " ++ piece else acc ++ piece)
  ""
  pieces