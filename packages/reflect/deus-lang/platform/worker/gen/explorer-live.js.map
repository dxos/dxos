/-- Indexed metadata: `(<field> (n i "text") …)`, as notes (D66) and spellings (D88) are stored. -/
def Print.indexedOf (meta : Option Sexp) (field : Text) : List (Int, Text) := filterMap (fun x =>
  match x with
  | Sexp.list (Sexp.sym "n" :: Sexp.int i :: Sexp.str text :: []) => Option.some (i, text)
  | _ => Option.none) (metaList meta field)