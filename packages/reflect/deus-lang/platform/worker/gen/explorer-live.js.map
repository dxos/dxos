/-- `meta.json`: the project, branches, counts and the log. -/
def Explorer.metaJson (s : Site) (console : Bool) (events : Int) (features : Int) : {IO, Throw Text} Json := Json.obj [("project", Json.str (Site.project s)), ("branch", Json.str s.branch), ("branches", Json.arr (List.map Json.str (branches s.dir))), ("definitions", Json.num (List.length (Site.entries s))), ("tasks", Json.num (List.length s.allTasks)), ("open", Json.num (List.length (List.filter isOpen s.allTasks))), ("console", Json.bool console), ("events", Json.num events), ("features", Json.num features), ("history", Json.arr (List.map (logJson s.dir) (fullLog s.dir historyLimit)))]