/-- ` x y :=` plus the body, for a lambda printed as a local function. -/
def Print.lambdaHead (p : Printer) (fn : Sexp) (env : List Text) (ind : Int) : Text :=
  let rec params t env2 acc :=
    match t with
    | Sexp.list (Sexp.sym "lam" :: b :: []) =>
        let name := Print.bind p env2
        params b (name :: env2) (name :: acc)
    | _ => (reverse acc, t, env2)
  let (names, b, env2) := params fn env []
  Text.concat (List.map (fun x => " " ++ x) names) ++ " :=" ++ Print.body p b env2 ind