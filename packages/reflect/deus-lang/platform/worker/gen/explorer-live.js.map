def Types.showType (t : TType) (seen : Ref (Map Text Text)) (prec : Int) : Text :=
  match t with
  | TType.var id => varName seen ("t" ++ Int.toText id) false
  | TType.con "#Pair" (a :: b :: []) => "(" ++ Types.showType a seen 0 ++ ", " ++ Types.showType b seen 0 ++ ")"
  | TType.con iri [] => iriName iri
  | TType.con iri args => paren
      90
      prec
      (iriName iri ++ Text.concat (List.map (fun a => " " ++ Types.showType a seen 100) args))
  | TType.fn a r b =>
      let rowText := showRow r seen
      paren
        10
        prec
        (Types.showType a seen 11 ++ " -> " ++ (if rowText == "" then "" else rowText ++ " ") ++
          Types.showType b seen 10)
  | TType.row r => rowArgument (showRow r seen) (resolveTail r) seen