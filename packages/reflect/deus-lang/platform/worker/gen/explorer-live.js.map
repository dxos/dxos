/-- A printer that shows parameter names before call arguments (D174); `hints` maps a callee (a hash, or `type#tag` for a constructor) to its parameter names. -/
def Print.withHints (base : Printer) (hints : Map Text (List Text)) : Printer := Printer.mk
  base.display
  base.fullNames
  base.typeNames
  base.fieldNames
  base.declared
  (Printer.namesByHash base)
  base.supply
  base.fresh
  hints
  base.rules