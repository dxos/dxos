/-- Statements: `let` lines and expressions at one indentation. -/
def Print.stmts (p : Printer) (t : Sexp) (env : List Text) (ind : Int) : Text :=
  let nl := "\n" ++ spaces ind
  match t with
  | Sexp.list (Sexp.sym "note" :: Sexp.str text :: inner :: []) => commentLines text ind ++ Print.stmts p inner env ind
  | Sexp.list (Sexp.sym "let" :: v :: b :: []) =>
      let name := Print.bind p env
      let value := Print.body p v env ind
      "let " ++ name ++ " :=" ++ value ++ nl ++ Print.stmts p b (name :: env) ind
  | Sexp.list (Sexp.sym "seq" :: a :: b :: []) => Print.expr p a env ind 0 ++ nl ++ Print.stmts p b env ind
  | Sexp.list (Sexp.sym "letrec" :: Sexp.list fns :: b :: []) =>
      let names := List.map (fun _ => Print.bind p env) fns
      let inner := reverse names ++ env
      let defs := List.map (fun pair =>
        let (name, fn) := pair
        "let rec " ++ name ++ lambdaHead p fn inner ind) (zip names fns)
      join nl defs ++ nl ++ Print.stmts p b inner ind
  | Sexp.list (Sexp.sym "match" :: scrut :: Sexp.list (Sexp.sym "case" :: pat :: b :: []) :: []) => if destructures pat then
      -- Binder names come in pre-order, so the value is printed before the pattern.
      let value := Print.body p scrut env ind
      let (text, env2) := Print.pattern p pat env
      "let " ++ text ++ " :=" ++ value ++ nl ++ Print.stmts p b env2 ind
    else Print.expr p t env ind 0
  | _ => Print.expr p t env ind 0