/-- A tasks snapshot by its hash, as id -> task object hash; `""` is no tasks. -/
def Tasks.snapshotAt (dir : Text) (h : Text) : {IO, Throw Text} Map Text Text := if Text.isEmpty h then Map.empty else
  -- Not cached: a task history reads one snapshot per change, and keeping them all held tens of MB (D192).
  match peekObject dir h with
  | Option.none => Throw.throw ("missing tasks snapshot #" ++ h)
  | Option.some form => Map.fromList (List.map (fun item =>
      match Sexp.args item with
      | id :: ref :: [] => (asText id, asText (getOr (head? (Sexp.args ref)) (Sexp.str "")))
      | _ => defect ("bad tasks entry " ++ Sexp.print item)) (Sexp.args form))