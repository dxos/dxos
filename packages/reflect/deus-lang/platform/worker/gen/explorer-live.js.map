/-- The name and printed signature of a stripped `stub` body, after its parameters' lambdas. -/
def Resolve.stubOf (body : Sexp) : Option (Text, Text) :=
  match body with
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "lam" :: Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "prim" :: Sexp.str "defect" :: []) :: Sexp.list (Sexp.sym "text" :: Sexp.str message :: []) :: []) :: []) :: Sexp.list (Sexp.sym "text" :: Sexp.str signature :: []) :: []) => if startsWith "not implemented: " message then Option.some (Text.drop 17 message, signature) else Option.none
  | _ => Option.none