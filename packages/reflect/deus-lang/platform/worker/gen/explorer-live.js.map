/-- `readObject` without keeping the form: a pass over every object (the explorer's, D192) holds one at a time. -/
def Codebase.peekObject (dir : Text) (h : Text) : {IO} Option Sexp :=
  match MutMap.get objectCache h with
  | Option.some form => Option.some form
  | Option.none => Option.map Sexp.read (IO.readFile (objectPath dir h))