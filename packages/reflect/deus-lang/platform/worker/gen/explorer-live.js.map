/-- The holes that make the expansion `template` equal `term`, the inverse of `expandWith`: none when
  the term is not an instance, a hole would use a variable the expansion binds, or a hole used twice
  differs (Syntax.Spec R-6). -/
def Syntax.holesOf (template : Sexp) (count : Int) (term : Sexp) : Option (List Sexp) :=
  let found := Ref.new Map.empty
  let fits := Ref.new true
  let rec walk t e depth := if not (Ref.get fits) then () else
    match t with
    | Sexp.list (Sexp.sym "var" :: Sexp.int k :: []) => if k < depth then if e == t then () else Ref.set fits false else if usesVars depth 0 e then Ref.set fits false else
        let index := count - 1 - (k - depth)
        let lowered := liftVars (0 - depth) depth e
        match Map.lookup index (Ref.get found) with
        | Option.some earlier => if earlier == lowered then () else Ref.set fits false
        | Option.none => Ref.set found (Map.insert index lowered (Ref.get found))
    | Sexp.list items =>
        match e with
        | Sexp.list others => if List.length items != List.length others then Ref.set fits false else forEach (zip (zip items others) (binderCounts items)) (fun triple =>
            let ((a, b), extra) := triple
            walk a b (depth + extra))
        | _ => Ref.set fits false
    | _ => if e == t then () else Ref.set fits false
  walk (templateBody template count) term 0
  if not (Ref.get fits) then Option.none else
    let holes := List.map (fun i => Map.lookup i (Ref.get found)) (range 0 count)
    if List.all isSome holes then Option.some (filterMap (fun x => x) holes) else Option.none