def Project.fromSexp (form : Sexp) : Project :=
  let items := Sexp.args form
  let iri := getOr (Option.map asText (metaField (Option.some form) "iri")) ""
  let libs := filterMap (fun item =>
    match item with
    | Sexp.list (Sexp.sym "lib" :: Sexp.str name :: Sexp.str libIri :: Sexp.str causal :: []) => Option.some (Lib.mk name libIri causal)
    | _ => Option.none) items
  Project.mk iri libs