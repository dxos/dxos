/-- How many binder names a Core node hands out itself, before its children (`Resolve.strip`'s order):
  one for a lambda, let, pattern variable or return clause, one per function of a letrec, and an
  operation clause's arguments and continuation. -/
def Syntax.ownBinders (items : List Sexp) : Int :=
  match items with
  | Sexp.sym "lam" :: _ => 1
  | Sexp.sym "let" :: _ => 1
  | Sexp.sym "ret" :: _ => 1
  | Sexp.sym "pvar" :: _ => 1
  | Sexp.sym "pas" :: _ => 1
  | Sexp.sym "letrec" :: fns :: _ :: [] => List.length (Sexp.asList fns)
  | Sexp.sym "on" :: _ :: _ :: Sexp.int arity :: _ :: [] => arity + 1
  | _ => 0