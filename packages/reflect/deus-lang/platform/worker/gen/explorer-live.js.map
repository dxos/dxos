/-- `names.json`: every visible name with its kind, hash, signature, doc summary and test status, so the
  app can list, search and preview names without opening their pages. -/
def Explorer.namesJson (s : Site) : {IO} Json := Json.arr (List.map (fun pair =>
  let h := Entry.hash (snd pair)
  let (sig, summary) := getOr (Map.lookup (fst pair) s.info) ("", "")
  Json.obj [("name", Json.str (fst pair)), ("kind", Json.str (Entry.kind (snd pair))), ("hash", Json.str h), ("sig", Json.str sig), ("summary", Json.str summary), ("status", Json.str (if Explorer.checked (snd pair) then statusOf (Explorer.verdictOf s.dir h) else ""))]) (Site.entries s))