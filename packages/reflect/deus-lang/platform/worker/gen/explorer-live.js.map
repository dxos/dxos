/-- `vitest:<file> > <test>` evidence: the file must declare that test; the suite runs it (Compile.Spec R-17). -/
def Cli.vitestFact (cited : Text) : {IO} Result Text (List (Text, Text)) :=
  let i := indexOf cited " > " 0
  if i < 0 then Result.err ("vitest:" ++ cited ++ " names no test: write vitest:<file> > <test name>") else
    let file := trim (Text.take i cited)
    let testName := trim (Text.drop (i + 3) cited)
    let home := Option.map (fun dir => dir ++ "/" ++ file) (IO.getEnv "DEUS_HOME")
    let source :=
      match IO.readFile file with
      | Option.some text => Option.some text
      | Option.none => Option.bind home IO.readFile
    match source with
    | Option.none => Result.err ("vitest:" ++ cited ++ ": no file " ++ file)
    | Option.some text =>
        let declares := fun call => any
          (fun quote => Text.contains (call ++ "(" ++ quote ++ testName ++ quote) text)
          ["'", "\"", "`"]
        if declares "test" || declares "it" then Result.ok [("kind", "vitest"), ("verdict", "external"), ("file", file)] else Result.err ("vitest:" ++ cited ++ ": " ++ file ++ " declares no test named " ++ testName)