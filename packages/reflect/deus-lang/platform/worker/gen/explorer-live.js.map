/-- Features whose parent the document does not have. -/
def Features.orphans (features : List Feature) : List Text :=
  let ids := List.map (fun f => f.featureId) features
  filterMap
    (fun f => if Text.isEmpty f.parentId || List.contains f.parentId ids then Option.none else Option.some (f.featureId ++ ": no parent " ++ f.parentId))
    features