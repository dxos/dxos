def Map.insert (key : k) (value : v) (m : Map k v) : Map k v :=
  match m with
  | Map.tip => Map.node 1 Map.tip key value Map.tip
  | Map.node h l k2 v2 r =>
      let c := compare key k2
      if c < 0 then balance (Map.insert key value l) k2 v2 r else if c > 0 then balance l k2 v2 (Map.insert key value r) else Map.node h l key value r