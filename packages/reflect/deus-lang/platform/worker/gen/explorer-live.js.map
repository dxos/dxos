/-- A node as notation `key` writes it, with the precedence of the text (Syntax.Spec R-5); none when
  the printer does not know the notation or the notation cannot write this node (R-6). -/
def Print.throughNotation (p : Printer) (key : Text) (term : Sexp) (env : List Text) (ind : Int) : Option (Text, Int) :=
  match Map.lookup key p.rules with
  | Option.none => Option.none
  | Option.some rule =>
      match rule.ruleTemplate with
      | Option.none => Option.none
      | Option.some template =>
          let count := holeCount rule.ruleParts
          match holesOf template count term with
          | Option.none => Option.none
          | Option.some holes =>
              -- Binder names are handed out in pre-order, so each hole takes the names its own binders had.
              let supply := Ref.get p.supply
              let (slices, total) := holeSlices template count term
              let named := List.map (fun i =>
                match Map.lookup i slices with
                | Option.some (from, length) => List.take length (List.drop from supply)
                | Option.none => []) (range 0 count)
              let text := notationText p rule holes named env ind
              Ref.set p.supply (List.drop total supply)
              Option.map (fun t => (t, notationLevel rule)) text