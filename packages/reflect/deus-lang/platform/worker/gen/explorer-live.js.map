/-- Where in the binder names a term hands out each hole's start, and how many it takes, with the
  number the whole term takes: the expansion's own binders take names too, which no hole gets. -/
def Syntax.holeSlices (template : Sexp) (count : Int) (term : Sexp) : (Map Int (Int, Int), Int) :=
  let slices := Ref.new Map.empty
  let used := Ref.new 0
  let rec walk t e depth :=
    match t with
    | Sexp.list (Sexp.sym "var" :: Sexp.int k :: []) => if k < depth then () else
        let index := count - 1 - (k - depth)
        let width := binderTotal e
        if Map.contains index (Ref.get slices) then () else Ref.set slices (Map.insert index (Ref.get used, width) (Ref.get slices))
        Ref.set used (Ref.get used + width)
    | Sexp.list items =>
        Ref.set used (Ref.get used + ownBinders items)
        match e with
        | Sexp.list others => forEach (zip (zip items others) (binderCounts items)) (fun triple =>
            let ((a, b), extra) := triple
            walk a b (depth + extra))
        | _ => ()
    | _ => ()
  walk (templateBody template count) term 0
  (Ref.get slices, Ref.get used)