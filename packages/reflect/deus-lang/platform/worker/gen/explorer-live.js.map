/-- Follows bound variables at the top of a type. -/
def Types.resolve (u : Unifier) (t : TType) : TType :=
  match t with
  | TType.var id =>
      match MutMap.get u.types id with
      | Option.some bound =>
          let r := Types.resolve u bound
          MutMap.set u.types id r
          r
      | Option.none => t
  | _ => t