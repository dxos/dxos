/-- A hole's text, from its term, with `names` for the binders inside it. -/
def Print.holeText (p : Printer) (c : Text) (prec : Int) (core : Sexp) (names : List Text) (env : List Text) (ind : Int) : Option Text :=
  let saved := Ref.get p.supply
  Ref.set p.supply names
  let text := if c == "term" then Option.some (Print.expr p core env ind prec) else if c == "name" then
    match core with
    | Sexp.list (Sexp.sym "text" :: Sexp.str v :: []) => if isWord v then Option.some v else Option.none
    | _ => Option.none
  else if c == "str" then
    match core with
    | Sexp.list (Sexp.sym "text" :: Sexp.str v :: []) => Option.some (quoteText v)
    | _ => Option.none
  else if c == "num" then
    match core with
    | Sexp.list (Sexp.sym "int" :: Sexp.int v :: []) => if v >= 0 then Option.some (Int.toText v) else Option.none
    | _ => Option.none
  else if c == "ident" then
    match core with
    | Sexp.list (Sexp.sym "var" :: Sexp.int k :: []) => get? env k
    | Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) => Option.some (refName p h env)
    | _ => Option.none
  else
    match core with
    | Sexp.list (Sexp.sym "notation" :: Sexp.str key :: inner :: []) =>
        match Map.lookup key p.rules with
        | Option.some rule => if rule.ruleCategory == c then Option.map fst (throughNotation p key inner env ind) else Option.none
        | Option.none => Option.none
    | _ => Option.none
  Ref.set p.supply saved
  text