def Print.needsSpace (a : Int) (b : Int) : Bool :=
  let wordish := fun c => isAlpha c || isDigit c || c == '_' || c == '\'' || c == '"' || c == '?' || c == '!' || c == '.'
  let pair := fromCode a ++ fromCode b
  wordish a && wordish b || Dict.contains pair twoCharSymbols || pair == "--" || pair == "/-" || pair == "-/"