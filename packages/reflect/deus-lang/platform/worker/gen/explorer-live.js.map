/-- Fully substituted type (for printing and generalizing). -/
def Types.zonk (u : Unifier) (t : TType) : TType :=
  match Types.resolve u t with
  | TType.con iri args => TType.con iri (List.map (fun a => Types.zonk u a) args)
  | TType.fn a r b => TType.fn (Types.zonk u a) (zonkRow u r) (Types.zonk u b)
  | TType.row r => TType.row (zonkRow u r)
  | v => v