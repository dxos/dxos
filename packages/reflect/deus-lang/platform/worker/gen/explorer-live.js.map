/-- A type; `prec` 3 is a comma-separated position, where an effectful function type is parenthesized. -/
def Ts.ty (p : Printer) (t : Sexp) (prec : Int) : Text :=
  match t with
  | Sexp.list (Sexp.sym "tapp" :: Sexp.list (Sexp.sym "tref" :: Sexp.str "#Pair" :: []) :: args) => "#[" ++ join ", " (List.map (fun x => Ts.ty p x 3) args) ++ "]"
  | Sexp.list (Sexp.sym "tapp" :: f :: args) => Ts.ty p f 100 ++ "<" ++ join ", " (List.map (fun x => Ts.ty p x 3) args) ++ ">"
  | Sexp.list (Sexp.sym "tfun" :: _) =>
      let (args, result) := Ts.arrows t
      -- `Unit -> a` reads as `() => a`, as `f(())` reads as `f()`.
      let argText := if args == [Sexp.node "tref" [Sexp.str "#Unit"]] then "" else join ", " (List.map (fun x => Ts.ty p x 3) args)
      paren (if hasUses result then 2 else 10) prec ("(" ++ argText ++ ") => " ++ Ts.ty p result 0)
  | Sexp.list (Sexp.sym "trow" :: effs) => uses p effs
  | Sexp.list (Sexp.sym "teff" :: Sexp.list (Sexp.sym "eff" :: effs) :: b :: []) => if List.isEmpty effs then Ts.ty p b prec else Ts.ty p b 11 ++ " uses " ++ uses p effs
  | _ => Print.ty p t prec