/-- Each type's and ability's IRI, mapped to the last segment of its name in `ns`. -/
def Types.declaredNames (ns : Map Text Entry) : Map Text Text := Map.foldr (fun name e acc =>
  match e with
  | Entry.type _ iri _ => Map.insert iri (lastSegment name) acc
  | Entry.ability _ iri => Map.insert iri (lastSegment name) acc
  | _ => acc) Map.empty ns