/-- The parameter names a call shows: for a callee with known names, taking three or more arguments or a literal. -/
def Print.hintNames (p : Printer) (f : Sexp) (args : List Sexp) : List Text :=
  let key :=
    match f with
    | Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) => h
    | Sexp.list (Sexp.sym "con" :: Sexp.str ty :: Sexp.int tag :: _ :: []) => ty ++ "#" ++ Int.toText tag
    | _ => ""
  match Map.lookup key p.hints with
  | Option.some names => if List.length args >= 3 || any isLiteral args then names else []
  | Option.none => []