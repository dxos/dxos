/-- A type with its parameters (stored by index) under their chosen names. -/
def View.nameParams (names : List Text) (t : Sexp) : Sexp :=
  match t with
  | Sexp.list (Sexp.sym "tvar" :: Sexp.int i :: []) =>
      match get? names i with
      | Option.some n => Sexp.node "tvar" [Sexp.str n]
      | Option.none => t
  | Sexp.list items => Sexp.list (List.map (View.nameParams names) items)
  | _ => t