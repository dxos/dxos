/-- Pairs grouped by key, each group's values in descending order; sorting once is cheaper than a map insert per pair. -/
def Names.groups (pairs : List (Text, Text)) : List (Text, List Text) :=
  let rec go xs key acc out :=
    match xs with
    | [] => if List.isEmpty acc then out else (key, acc) :: out
    | pair :: rest => if fst pair == key then go rest key (snd pair :: acc) out else go rest (fst pair) [snd pair] (if List.isEmpty acc then out else (key, acc) :: out)
  go (sort pairs) "" [] []