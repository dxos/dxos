/-- `displayScheme`, naming each type in `names` (from `declaredNames`) as it is named, not by its IRI. -/
def Types.displaySchemeNamed (names : Map Text Text) (scheme : Sexp) : Text :=
  let u := newUnifier ()
  let t := zonk u (Types.fromSexp u scheme (Ref.new Map.empty) (Ref.new Map.empty) [] false)
  -- A row variable that occurs once constrains nothing and is not printed; a shared one is.
  let shared := List.filter (fun pair => snd pair > 1) (Map.toList (rowVarCounts t Map.empty))
  showTypeWith names t (Ref.new Map.empty) 0 (Set.fromList (List.map fst shared))