/-- How many variables each element of a Core node binds around itself: the body of `lam`, `let`,
  `letrec`, a match arm, a `return` clause or an operation clause; Core before or after names are stripped. -/
def Syntax.binderCounts (items : List Sexp) : List Int :=
  let last := List.length items - 1
  let onLast := fun k => List.map (fun i => if i == last then k else 0) (range 0 (last + 1))
  match items with
  | Sexp.sym "lam" :: _ => onLast 1
  | Sexp.sym "let" :: _ => onLast 1
  | Sexp.sym "ret" :: _ => onLast 1
  | Sexp.sym "letrec" :: _ =>
      let fns := getOr (get? items (last - 1)) (Sexp.list [])
      let k := List.length (Sexp.asList fns)
      List.map (fun i => if i == 0 then 0 else k) (range 0 (last + 1))
  | Sexp.sym "case" :: pat :: _ => onLast (patternBinders pat)
  | Sexp.sym "on" :: _ :: _ :: _ :: Sexp.list names :: _ :: [] => onLast (List.length names)
  | Sexp.sym "on" :: _ :: _ :: Sexp.int arity :: _ :: [] => onLast (arity + 1)
  | _ => List.map (fun _ => 0) items