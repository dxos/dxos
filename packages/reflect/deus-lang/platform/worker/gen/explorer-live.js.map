/-- A printer that writes nodes with the notations in `rules`, by key (Syntax.Spec R-5). -/
def Print.withRules (base : Printer) (rules : Map Text Loaded) : Printer := Printer.mk
  base.display
  base.fullNames
  base.typeNames
  base.fieldNames
  base.declared
  (Printer.namesByHash base)
  base.supply
  base.fresh
  base.hints
  rules