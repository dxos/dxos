/-- Tasks linking a definition, by name or by any hash it was linked at. -/
def Tasks.about (tasks : Map Text Task) (name : Text) (h : Text) : List Task := List.filter (fun t => any (fun a =>
  match a with
  | Attachment.definition n linked => n == name || linked == h
  | Attachment.change _ => false) t.links) (Map.values tasks)