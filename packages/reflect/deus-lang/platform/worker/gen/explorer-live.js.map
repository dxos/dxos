--
--
/-- Names for type variables in order of appearance: a, b, …; rows: e, e1, …. -/
def Types.varName (seen : Ref (Map Text Text)) (key : Text) (row : Bool) : Text :=
  match Map.lookup key (Ref.get seen) with
  | Option.some name => name
  | Option.none =>
      let count := List.length (List.filter
        (fun pair => startsWith (if row then "r" else "t") (fst pair))
        (Map.toList (Ref.get seen)))
      let name := if row then if count == 0 then "e" else "e" ++ Int.toText count else if count < 4 then fromCode ('a' + count) else "t" ++ Int.toText count
      Ref.set seen (Map.insert key name (Ref.get seen))
      name