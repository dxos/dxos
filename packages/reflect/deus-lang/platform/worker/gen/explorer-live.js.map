/-- A written row: closed, unless it ends in a named tail (`{IO | r}`), which the signature shares. -/
def Types.signatureRow (u : Unifier) (effs : List Sexp) (vars : Ref (Map Text TType)) (rowVars : Ref (Map Text TRow)) : TRow :=
  match effs with
  | [] => TRow.empty
  | Sexp.list (Sexp.sym "tvar" :: Sexp.str name :: []) :: [] =>
      match Map.lookup name (Ref.get rowVars) with
      | Option.some r => r
      | Option.none =>
          let r := freshRow u
          Ref.set rowVars (Map.insert name r (Ref.get rowVars))
          r
  | e :: rest => TRow.extend (signatureType u e vars rowVars) (Types.signatureRow u rest vars rowVars)