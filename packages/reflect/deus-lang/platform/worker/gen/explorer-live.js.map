def Types.rowFromSexp (u : Unifier) (effs : List Sexp) (vars : Ref (Map Text TType)) (rowVars : Ref (Map Text TRow)) (params : List TType) (openArrows : Bool) : TRow :=
  match effs with
  | [] =>
      -- Instantiating for a use opens every row (Koka's `open`): a function that performs E can be
      -- called wherever E and more may happen. A signature being checked keeps its rows closed.
      if openArrows then freshRow u else TRow.empty
  | Sexp.list (Sexp.sym "tvar" :: Sexp.str name :: []) :: [] =>
      match Map.lookup name (Ref.get rowVars) with
      | Option.some r => r
      | Option.none =>
          let r := freshRow u
          Ref.set rowVars (Map.insert name r (Ref.get rowVars))
          r
  | Sexp.list (Sexp.sym "tvar" :: Sexp.int i :: []) :: [] => paramRow u params i
  | e :: rest => TRow.extend
      (Types.fromSexp u e vars rowVars params false)
      (Types.rowFromSexp u rest vars rowVars params openArrows)