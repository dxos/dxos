/-- Instantiates a type written as Core (a signature, a field, an operation, a stored scheme). -/
def Types.fromSexp (u : Unifier) (s : Sexp) (vars : Ref (Map Text TType)) (rowVars : Ref (Map Text TRow)) (params : List TType) (openArrows : Bool) : TType :=
  let named := fun key =>
    match Map.lookup key (Ref.get vars) with
    | Option.some t => t
    | Option.none =>
        let t := freshType u
        Ref.set vars (Map.insert key t (Ref.get vars))
        t
  match s with
  | Sexp.list (Sexp.sym "tref" :: Sexp.str iri :: []) => TType.con iri []
  | Sexp.list (Sexp.sym "tvar" :: Sexp.int i :: []) => getOr (get? params i) (named ("#" ++ Int.toText i))
  | Sexp.list (Sexp.sym "tvar" :: Sexp.str "?" :: []) => freshType u
  | Sexp.list (Sexp.sym "tvar" :: Sexp.str name :: []) => named name
  | Sexp.list (Sexp.sym "teff" :: _ :: t :: []) => Types.fromSexp u t vars rowVars params openArrows
  | Sexp.list (Sexp.sym "trow" :: effs) => TType.row (rowFromSexp u effs vars rowVars params false)
  | Sexp.list (Sexp.sym "tapp" :: Sexp.list (Sexp.sym "tref" :: Sexp.str iri :: []) :: args) => TType.con iri (List.map (fun a => Types.fromSexp u a vars rowVars params false) args)
  | Sexp.list (Sexp.sym "tapp" :: head :: args) =>
      -- Applying a type variable is beyond this checker; treat it as unknown.
      freshType u
  | Sexp.list (Sexp.sym "tfun" :: a :: b :: []) =>
      -- Only the spine is opened: an argument's row is a contract on what may be passed in.
      -- An arrow written without braces constrains nothing: its row is fresh wherever it appears.
      TType.fn
        (Types.fromSexp u a vars rowVars params false)
        (freshRow u)
        (Types.fromSexp u b vars rowVars params openArrows)
  | Sexp.list (Sexp.sym "tfun" :: a :: b :: Sexp.list (Sexp.sym "eff" :: effs) :: []) => TType.fn
      (Types.fromSexp u a vars rowVars params false)
      (rowFromSexp u effs vars rowVars params openArrows)
      (Types.fromSexp u b vars rowVars params openArrows)
  | _ => freshType u