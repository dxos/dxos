/-- Splits a signature into its first `n` argument types and the rest; the last arrow's row stays on the rest (`{E} B`). -/
def Print.splitSig (sig : Sexp) (n : Int) : (List Sexp, Option Sexp) := if n == 0 then ([], Option.some sig) else
  match sig with
  | Sexp.list (Sexp.sym "tfun" :: a :: b :: row :: []) => if n == 1 then ([a], Option.some (Sexp.node "teff" [row, b])) else Print.splitSig (Sexp.node "tfun" [a, b]) n
  | Sexp.list (Sexp.sym "tfun" :: a :: b :: _) =>
      match Print.splitSig b (n - 1) with
      | (args, rest) => (a :: args, rest)
      | _ => ([], Option.none)
  | _ => ([], Option.none)