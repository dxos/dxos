def Codebase.readObject (dir : Text) (h : Text) : {IO} Option Sexp :=
  match MutMap.get objectCache h with
  | Option.some form => Option.some form
  | Option.none =>
      match IO.readFile (objectPath dir h) with
      | Option.none => Option.none
      | Option.some text =>
          let form := Sexp.read text
          MutMap.set objectCache h form
          Option.some form