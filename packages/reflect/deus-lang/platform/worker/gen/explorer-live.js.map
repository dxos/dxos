/-- The explorer's `events.json` (D104): every event type with its columns, counts and latest rows
  (at most `limit`), and the counts per definition hash. -/
def Analytics.siteJson (dir : Text) (project : Text) (ns : Map Text Entry) (limit : Int) : {IO, Throw Text} Json :=
  let ts := Analytics.types dir ns
  let index := Codebase.namesByHash ns
  let tallies := Map.toList (byDefinition dir project ns ts)
  Json.obj [("project", Json.str project), ("types", Json.arr (List.map (typeJson dir limit) ts)), ("byDefinition", Json.obj (List.map (fun pair => (fst pair, definitionJson index (fst pair) (snd pair))) tallies))]