/-- An argument's text behind parameter `i`'s hint, unless it already reads as that name. -/
def Print.hinted (names : List Text) (i : Int) (text : Text) : Text :=
  match get? names i with
  | Option.some name => if Text.length name < 2 || isGenerated name || name == text then text else hintOpen ++ name ++ hintClose ++ text
  | Option.none => text