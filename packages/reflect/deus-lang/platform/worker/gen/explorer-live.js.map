/-- `[a, b]` or `#[a, b]` on one line when it fits, else one item per line. -/
def Ts.sequence (p : Printer) (opener : Text) (items : List Sexp) (env : List Text) (ind : Int) : Text :=
  let supply := Ref.get p.supply
  let fresh := Ref.get p.fresh
  let flat := opener ++ join ", " (List.map (fun x => Ts.expr p x env ind 0) items) ++ "]"
  if fits ind flat || List.length items < 2 then flat else
    Ref.set p.supply supply
    Ref.set p.fresh fresh
    opener ++
      Text.concat (List.map (fun x => "\n" ++ spaces (ind + 2) ++ Ts.expr p x env (ind + 2) 0 ++ ",") items) ++ "\n" ++ spaces ind ++ "]"