--
--
/-- The column type of a field type, or `none` when the field is not flat. -/
def Analytics.columnTypeOf (t : Sexp) : Option Text :=
  match t with
  | Sexp.list (Sexp.sym "tref" :: Sexp.str iri :: []) => if iri == "#Int" then Option.some "int" else if iri == "#Bool" then Option.some "bool" else if iri == "#Text" then Option.some "text" else if iri == "urn:deus:analytics:CodeRef" then Option.some "ref" else Option.none
  | _ => Option.none