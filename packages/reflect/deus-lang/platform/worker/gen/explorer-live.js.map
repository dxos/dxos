def Print.plainDefinition (p : Printer) (name : Text) (docText : Text) (names : List Text) (b : Sexp) (env : List Text) (sig : Option Sexp) : Text :=
  let count := List.length names
  let header :=
    match Option.map (fun s => splitSig s count) sig with
    | Option.some (types, Option.some result) => if List.length types == count then Text.concat (List.map (fun pair =>
        let (x, t) := pair
        if head t == "tvar" && Sexp.args t == [Sexp.str "?"] then " " ++ x else " (" ++ x ++ " : " ++ Print.ty p t 0 ++ ")") (zip names types)) ++ (if Sexp.args result == [Sexp.str "?"] then "" else " : " ++ Print.ty p result 0) else Text.concat (List.map (fun x => " " ++ x) names)
    | _ => Text.concat (List.map (fun x => " " ++ x) names)
  -- A declaration prints without a body only when it compiles back to this hash (D93).
  let declared :=
    match (stubOf b, sig) with
    | (Option.some (stubName, sigText), Option.some s) => stubName == name && sigText == Sexp.print s
    | _ => false
  docText ++ "def " ++ name ++ header ++ (if declared then "" else " :=" ++ Print.body p b env 0)