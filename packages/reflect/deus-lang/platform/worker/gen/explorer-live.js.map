/-- One event type's entry in `events.json`: columns, counts and the latest rows, newest first. -/
def Analytics.typeJson (dir : Text) (limit : Int) (t : EventType) : {IO} Json :=
  let (pending, pushed) := Analytics.rows dir t
  let newest := reverse (pushed ++ pending)
  Json.obj [("name", Json.str t.typeName), ("hash", Json.str t.typeHash), ("columns", columnsJson t.columns), ("count", Json.num (List.length newest)), ("pending", Json.num (List.length pending)), ("pushed", Json.num (List.length pushed)), ("latest", Json.arr (List.map (rowJson t) (List.take limit newest)))]