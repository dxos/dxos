/-- The precedence the term hole at `k` reads at unless the notation gives one: 0 before a literal,
  which delimits it; a trailing rule's own precedence on its left and one more on its right, so it
  groups to the left; and the rule's precedence last in a leading rule. -/
def Syntax.defaultPrec (category : Text) (prec : Int) (parts : List Part) (k : Int) : Int :=
  let trailing := isTrailing category parts
  let delimited :=
    match get? parts (k + 1) with
    | Option.some (Part.lit _) => true
    | _ => false
  if delimited then 0 else if k == 0 && trailing then prec else if k == List.length parts - 1 then if trailing then prec + 1 else prec else 0