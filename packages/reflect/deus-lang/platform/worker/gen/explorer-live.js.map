/-- A reference's parts: (name IRI or `""`, hash or `""`). -/
def Analytics.parts (ref : Text) : (Text, Text) :=
  let rec lastHash i := if i < 0 then -1 else if code ref i == '#' then i else lastHash (i - 1)
  let mark := lastHash (Text.length ref - 1)
  if mark < 0 then (ref, "") else (Text.take mark ref, Text.drop (mark + 1) ref)