/-- The precedence of a notation's text: a trailing rule's own; a leading one that ends with a literal
  reads as an atom, but one that ends in a hole is its rule's. Either needs parentheses as an argument. -/
def Print.notationLevel (rule : Loaded) : Int := if isTrailing rule.ruleCategory rule.ruleParts then rule.rulePrec else
  match last? rule.ruleParts with
  | Option.some (Part.lit _) => 99
  | _ => min rule.rulePrec 99