/-- A body after `:=`, `=>`, `then` or `else`: inline, or a block on the next lines. -/
def Print.body (p : Printer) (t : Sexp) (env : List Text) (ind : Int) : Text := if isBlock t then "\n" ++ spaces (ind + 2) ++ Print.stmts p t env (ind + 2) else
  let supply := Ref.get p.supply
  let fresh := Ref.get p.fresh
  let inline := Print.expr p t env ind 0
  -- A notation laid out over lines (a JSX tree) starts on its own line, so its closing literal lines up with its start.
  if head t == "notation" && Text.contains "\n" inline then
    Ref.set p.supply supply
    Ref.set p.fresh fresh
    "\n" ++ spaces (ind + 2) ++ Print.expr p t env (ind + 2) 0
  else " " ++ inline