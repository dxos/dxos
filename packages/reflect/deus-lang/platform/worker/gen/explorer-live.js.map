/-- A printer sharing `base`'s name tables (built once per namespace) with its own locals. -/
def Print.withLocals (base : Printer) (locals : List Text) : Printer := Printer.mk
  base.display
  base.fullNames
  base.typeNames
  base.fieldNames
  base.declared
  (Printer.namesByHash base)
  (Ref.new locals)
  (Ref.new 0)
  base.hints
  base.rules