/-- A printer for a namespace: hash (or `type#tag`, `ability!index`) to display name. -/
def Print.printer (ns : Map Text Entry) (locals : List Text) : Printer :=
  let names := Names.build ns
  let bySegment := names.bySegment
  let index := nameIndex ns
  -- Constructors and operations keep their owner (`Result.ok`, `Prices.priceOf`): a bare `ok` reads as a variable in a pattern.
  let display := Map.fromList (List.map (fun pair =>
    let (key, fqn) := pair
    (key, suffixifyAtLeast (if Text.contains "#" key || Text.contains "!" key then 2 else 1) bySegment fqn)) (Map.toList index))
  let typeNames := foldl (fun m pair =>
    match pair with
    | (name, Entry.type _ iri _) => Map.insert iri (suffixify bySegment name) m
    | (name, Entry.ability _ iri) => Map.insert iri (suffixify bySegment name) m
    | _ => m) Map.empty (Map.toList ns)
  -- Accessors print as `e.field` when the field name is unique among structures.
  let fieldNames := foldl (fun m pair =>
    match pair with
    | (owner, Entry.type _ _ fields) => foldl (fun m2 f =>
        match (Map.lookup (owner ++ "." ++ f) ns, Dict.lookup f names.fieldOwners) with
        | (Option.some (Entry.term h), Option.some (_ :: [])) => Map.insert h f m2
        | _ => m2) m fields
    | _ => m) Map.empty (Map.toList ns)
  -- Headers name types by their last segment and list a constructor's names; built here once, not per view.
  Printer.mk
    display
    index
    typeNames
    fieldNames
    (declaredNames ns)
    (Codebase.namesByHash ns)
    (Ref.new locals)
    (Ref.new 0)
    Map.empty
    Map.empty