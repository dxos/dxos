/-- How many events refer to each hash: hash -> list of (event type, column, count). A pinned
  reference counts under its hash; a name IRI counts under the hash the name has now. -/
def Analytics.byDefinition (dir : Text) (project : Text) (ns : Map Text Entry) (ts : List EventType) : {IO} Map Text (List (Text, (Text, Int))) :=
  let tally := MutMap.new ()
  forEach ts (fun t =>
    let (pending, pushed) := Analytics.rows dir t
    let refColumns := List.filter
      (fun pair => (snd pair).columnType == "ref")
      (zip (range 0 (List.length t.columns)) t.columns)
    forEach (pending ++ pushed) (fun r => forEach refColumns (fun pair =>
      match get? r.cells (fst pair) with
      | Option.some (Cell.text ref) =>
          let h := refHash project ns ref
          if Text.isEmpty h then () else
            let key := h ++ "\n" ++ t.typeName ++ "\n" ++ (snd pair).columnName
            MutMap.set tally key (getOr (MutMap.get tally key) 0 + 1)
      | _ => ())))
  foldl (fun m key =>
    match Text.split key "\n" with
    | h :: typeName :: column :: [] => Map.insert
        h
        (getOr (Map.lookup h m) [] ++ [(typeName, column, getOr (MutMap.get tally key) 0)])
        m
    | _ => m) Map.empty (sort (MutMap.keys tally))