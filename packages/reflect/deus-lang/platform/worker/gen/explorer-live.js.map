/-- Events about the codebase (D104) and how many there are; a codebase whose event types cannot be
  read gets no events rather than no site. -/
def Explorer.eventsOf (s : Site) : {IO} (Json, Int) :=
  match try (fun _ =>
    let ts := Analytics.types s.dir (Site.ns s)
    (siteJson s.dir (Site.project s) (Site.ns s) 20, sum (List.map (fun c =>
      let (_, pending, pushed) := c
      pending + pushed) (counts s.dir ts)))) with
  | Result.ok pair => pair
  | Result.err _ => (Json.obj [("project", Json.str (Site.project s)), ("types", Json.arr []), ("byDefinition", Json.obj [])], 0)