/-- The names under a namespace node, flat (`List.map`); reads tree nodes and older flat snapshots alike. -/
def Codebase.readNamespace (dir : Text) (h : Text) : {IO, Throw Text} Map Text Entry :=
  let rec go prefix node acc := foldl (fun m item =>
    match item with
    | Sexp.list (Sexp.sym "sub" :: Sexp.str seg :: Sexp.str child :: []) => go (prefix ++ seg ++ ".") child m
    | Sexp.list (Sexp.sym "n" :: name :: entry :: []) => Map.insert (prefix ++ asText name) (Entry.fromSexp entry) m
    | _ => defect "bad namespace entry") acc (nodeItems dir node)
  go "" h Map.empty