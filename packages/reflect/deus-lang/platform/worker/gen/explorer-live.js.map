/-- `t` with its variables from `cut` up moved by `amount`, as when it goes under (or out of) binders. -/
def Syntax.liftVars (amount : Int) (cut : Int) (t : Sexp) : Sexp :=
  match t with
  | Sexp.list (Sexp.sym "var" :: Sexp.int k :: []) => if k >= cut then Sexp.node "var" [Sexp.int (k + amount)] else t
  | Sexp.list items => Sexp.list (List.map
      (fun pair => Syntax.liftVars amount (cut + snd pair) (fst pair))
      (zip items (binderCounts items)))
  | _ => t