/-- The variables a pattern binds. -/
def Syntax.patternBinders (pat : Sexp) : Int :=
  match pat with
  | Sexp.list (Sexp.sym "pvar" :: _) => 1
  | Sexp.list (Sexp.sym "pas" :: rest) => 1 + sum (List.map Syntax.patternBinders rest)
  | Sexp.list items => sum (List.map Syntax.patternBinders items)
  | _ => 0