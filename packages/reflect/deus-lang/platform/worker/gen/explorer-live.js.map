def Explorer.taskJson (dir : Text) (ns : Map Text Entry) (history : List (Text, Causal)) (t : Task) : {IO, Throw Text} Json :=
  let link := fun a =>
    match a with
    | Attachment.definition name linked => Json.obj [("definition", Json.str name), ("hash", Json.str linked), ("current", getOr (Option.map (fun e => Json.str (Entry.hash e)) (Map.lookup name ns)) Json.null)]
    | Attachment.change h =>
        let message :=
          match readObject dir h with
          | Option.some form => (causalFromSexp form).message
          | Option.none => ""
        Json.obj [("change", Json.str h), ("message", Json.str message)]
  Json.obj [("id", Json.str (Task.id t)), ("title", Json.str (Task.title t)), ("state", Json.str (stateText t.state)), ("priority", Json.num t.priority), ("assignee", Json.str t.assignee), ("labels", Json.arr (List.map Json.str t.labels)), ("parent", Json.str t.parent), ("details", Json.str t.details), ("links", Json.arr (List.map link t.links)), ("comments", Json.arr (List.map commentJson t.comments)), ("history", Json.arr (List.map (Explorer.changeJson dir) history))]