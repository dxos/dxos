/-- An effect row as written: abilities, then a row variable after `|` (`{Prices | r}`). -/
def Print.effRow (p : Printer) (effs : List Sexp) : Text :=
  let tails := List.filter (fun x => head x == "tvar") effs
  let named := List.filter (fun x => head x != "tvar") effs
  let shown := join ", " (List.map (fun x => Print.ty p x 0) named)
  let tail := join ", " (List.map (fun x => Print.ty p x 0) tails)
  "{" ++
    (if Text.isEmpty tail then shown else if Text.isEmpty shown then tail else shown ++ " | " ++ tail) ++ "}"