/-- A written signature: arrows without braces constrain nothing; written rows are closed. -/
def Types.signatureType (u : Unifier) (s : Sexp) (vars : Ref (Map Text TType)) (rowVars : Ref (Map Text TRow)) : TType :=
  match s with
  | Sexp.list (Sexp.sym "tfun" :: a :: b :: []) => TType.fn
      (Types.signatureType u a vars rowVars)
      (freshRow u)
      (Types.signatureType u b vars rowVars)
  | Sexp.list (Sexp.sym "tfun" :: a :: b :: Sexp.list (Sexp.sym "eff" :: effs) :: []) => TType.fn
      (Types.signatureType u a vars rowVars)
      (signatureRow u effs vars rowVars)
      (Types.signatureType u b vars rowVars)
  | Sexp.list (Sexp.sym "trow" :: effs) => TType.row (rowFromSexp u effs vars rowVars [] false)
  | Sexp.list (Sexp.sym "tapp" :: Sexp.list (Sexp.sym "tref" :: Sexp.str iri :: []) :: args) => TType.con iri (List.map (fun x => Types.signatureType u x vars rowVars) args)
  | _ => Types.fromSexp u s vars rowVars [] true