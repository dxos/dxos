/-- The next binder name: the author's, made unique against the names in scope. -/
def Print.bind (p : Printer) (env : List Text) : Text :=
  let given :=
    match Ref.get p.supply with
    | x :: rest =>
        Ref.set p.supply rest
        x
    | [] => ""
  let base := if given == "" then
    let k := Ref.get p.fresh
    Ref.set p.fresh (k + 1)
    "x" ++ Int.toText k
  else given
  let rec unique candidate k := if List.contains candidate env then unique (base ++ Int.toText k) (k + 1) else candidate
  unique base 1