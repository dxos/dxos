/-- The notation stored as `name`, keyed by its hash, if `name` is one. -/
def Cli.loadRule (dir : Text) (ns : Map Text Entry) (name : Text) : {IO} Option Loaded :=
  match (notationTypes ns, Map.lookup name ns) with
  | (Option.some (n, t), Option.some (Entry.term h)) =>
      match readObject dir h with
      | Option.some (Sexp.list (Sexp.sym "term" :: core :: [])) => decodeRule n t h name core
      | _ => Option.none
  | _ => Option.none