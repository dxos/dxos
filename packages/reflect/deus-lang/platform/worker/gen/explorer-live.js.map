def Tasks.commentFromSexp (c : Sexp) : Comment :=
  match Sexp.args c with
  | author :: note :: rest =>
      let at := getOr (Option.map asText (metaField (Option.some c) "at")) ""
      Comment.mk
        (asText author)
        (asText note)
        at
        (List.map assetFromSexp (metaList (Option.some c) "assets"))
  | _ => defect ("bad comment " ++ Sexp.print c)