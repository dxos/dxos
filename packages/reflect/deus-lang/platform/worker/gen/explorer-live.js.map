--
--
def Ts.pattern (p : Printer) (pat : Sexp) (env : List Text) : (Text, List Text) :=
  match pat with
  | Sexp.list (Sexp.sym "pany" :: []) => ("_", env)
  | Sexp.list (Sexp.sym "pvar" :: []) =>
      let name := Print.bind p env
      (name, name :: env)
  | Sexp.list (Sexp.sym "pas" :: inner :: []) =>
      let name := Print.bind p env
      let (text, env2) := Ts.pattern p inner (name :: env)
      (name ++ " @ " ++ text, env2)
  | Sexp.list (Sexp.sym "pint" :: Sexp.int v :: []) => (Int.toText v, env)
  | Sexp.list (Sexp.sym "ptext" :: Sexp.str v :: []) => (quoteText v, env)
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str ty :: Sexp.int tag :: subs) => if ty == "#List" && tag == 1 || ty == "#Pair" then
      match subs with
      | a :: b :: [] =>
          let (at, env2) := Ts.pattern p a env
          let (bt, env3) := Ts.pattern p b env2
          -- `[h, ...[x, ...t]]` reads as `[h, x, ...t]`, and nested pairs as one tuple.
          let opener := if ty == "#Pair" then "#[" else "["
          let sameKind :=
            match b with
            | Sexp.list (Sexp.sym "pcon" :: Sexp.str ty2 :: _) => ty2 == ty
            | _ => false
          if ty == "#List" && bt == "[]" then ("[" ++ at ++ "]", env3) else if sameKind then (opener ++ at ++ ", " ++ Text.drop (Text.length opener) bt, env3) else if ty == "#Pair" then ("#[" ++ at ++ ", " ++ bt ++ "]", env3) else ("[" ++ at ++ ", ..." ++ bt ++ "]", env3)
      | _ => ("?", env)
    else
      let rec go rest env2 acc :=
        match rest with
        | [] => (reverse acc, env2)
        | x :: more =>
            let (text, env3) := Ts.pattern p x env2
            go more env3 (text :: acc)
      let (texts, env2) := go subs env []
      let name := Ts.conName p ty tag
      if List.isEmpty texts then (name, env2) else (name ++ "(" ++ join ", " texts ++ ")", env2)
  | _ => (Sexp.print pat, env)