/-- The scheme a declared signature stands for, read as `Compile.typecheck` reads it (a constant's row aside, D95). -/
def Types.declaredScheme (sig : Sexp) : Sexp :=
  let u := newUnifier ()
  let declared :=
    match sig with
    | Sexp.list (Sexp.sym "teff" :: _ :: result :: []) => result
    | other => other
  scheme u (signatureType u declared (Ref.new Map.empty) (Ref.new Map.empty))