/-- `{IO, Throw Text | e}`; an unconstrained row prints as nothing. -/
def Types.showRow (r : TRow) (seen : Ref (Map Text Text)) : Text :=
  let rec labels row acc :=
    match row with
    | TRow.extend l rest => labels rest (showType l seen 0 :: acc)
    | TRow.var id => (reverse acc, Option.some (varName seen ("r" ++ Int.toText id) true))
    | TRow.empty => (reverse acc, Option.none)
  match labels r [] with
  | ([], Option.some _) => ""
  | ([], Option.none) => "{}"
  | (ls, Option.none) => "{" ++ join ", " ls ++ "}"
  | (ls, Option.some tail) => "{" ++ join ", " ls ++ " | " ++ tail ++ "}"