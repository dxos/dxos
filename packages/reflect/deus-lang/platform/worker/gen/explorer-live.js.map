/-- When a change was made, in seconds since the Unix epoch: its history node's `at` (D165), or
  else the time this store's provenance recorded (nanoseconds) for a change made here. -/
def Cli.madeAt (dir : Text) (causal : Text) : {IO} Option Int :=
  let fromNode :=
    match readObject dir causal with
    | Option.some form => fromText (Causal.at (causalFromSexp form))
    | Option.none => Option.none
  Option.orElse fromNode (fun _ => Option.bind
    (IO.readFile (dir ++ "/provenance/" ++ causal))
    (fun text => Option.bind (metaField (Option.some (Sexp.read text)) "at") (fun at =>
      let ns := asText at
      if Text.length ns > 9 then fromText (Text.take (Text.length ns - 9) ns) else Option.none)))