/-- The handler for `area` and the path after it (`Dispatch`). -/
def Worker.Paths.dispatch (area : Text) (rest : List Text) : Dispatch :=
  if List.contains area ["bundles", "packs", "names", "live", "headlog"] then Dispatch.mk area rest
    else if area == "objects" || area == "meta" then Dispatch.mk "objects" rest
    else if area == "files" then
    match rest with
    | "packs" :: after => Dispatch.mk "packs" after
    | folder :: _ => if isFolder folder then Dispatch.mk "files" rest else Dispatch.mk "" []
    | [] => Dispatch.mk "" []
  else Dispatch.mk "" []