-- context: @dxos/worker/Worker
/-
  A project's bundles (task 41714c0d, D50, D164): the history a push sends, one gzipped file per bundle, named by
  its level and the SHA-256 of its text. Reads are open; a push writes one and moves the branch head with it, and only
  compaction deletes one, into the trash (DataSafety.Spec).
-/

namespace Worker.Bundles

/-- `{"bundle": name, <field>: true or false}`, how the API reports a write. -/
def report (name : Text) (field : Text) (value : Bool) (status : Int) : Js :=
  Worker.Http.json (Js.obj [("bundle", Js.text name), (field, Js.bool value)]) status

/-- Why the Worker refuses a bundle sent as `name`, given the SHA-256 of its text gunzipped (none when it was not
  gzip): the status and message, or none to keep it. Kept apart from `serve` so the rule runs without R2 or a
  request, in the simulator and in tests (task 019e7afe). -/
def pushProblem (name : Text) (digest : Option Text) : Option (Int, Text) :=
  match digest with
  | Option.none => Option.some (400, "a bundle is sent gzipped")
  | Option.some digest =>
      if Option.some digest == List.get? (Text.split name "-") 1 then Option.none
      else Option.some (400, "the bundle does not hash to its name")

test pushRefusesWhatIsNotGzip := pushProblem "0-abc" Option.none == Option.some (400, "a bundle is sent gzipped")

test pushRefusesAMisnamedBundle := pushProblem "0-abc" (Option.some "def") == Option.some (400, "the bundle does not hash to its name")

test pushKeepsABundleNamedByItsHash := pushProblem "0-abc" (Option.some "abc") == Option.none

/-- Answers `/v1/<project>/bundles/<rest>` for `request`, on the R2 `bucket`. `verify` checks that a bundle sent is
  gzip and hashes to its name. `authorize scope` is remote.mjs's key check (as for `Worker.Files.serve`), and
  `moveHead logged` moves the branch head the push claims, giving a promise of the response that refuses the push, or
  of `undefined` when the head moved. -/
def serve (request : Js) (bucket : Js) (project : Text) (rest : List Text) (verify : Bool) (authorize : Text -> Js) (moveHead : Js -> Js) : {Js.Async} Js :=
  let folder := project ++ "/bundles/"
  let verb := Worker.Http.method request
  match rest with
  | [] => if verb == "GET" then Worker.Http.lines (Worker.R2.listAll bucket folder) else Worker.Http.problem 405 "method not allowed"
  | [""] => if verb == "GET" then Worker.Http.lines (Worker.R2.listAll bucket folder) else Worker.Http.problem 405 "method not allowed"
  | [name] =>
      if not (Worker.Paths.isBundle name) then Worker.Http.problem 404 "not a bundle name"
      else
        let key := folder ++ name
        if verb == "GET" then
          match Worker.R2.get bucket key with
          | Option.none => Worker.Http.problem 404 "no such bundle"
          -- A bundle never changes, so a cached copy is always right.
          | Option.some object =>
              Worker.Http.response
                (Js.get object "body")
                200
                [("content-type", "application/gzip"), ("cache-control", "public, max-age=31536000, immutable")]
        else if verb == "PUT" then
          let logged := Js.Async.await (authorize "push")
          let bytes := Worker.R2.bytes (Js.Async.await (Js.method request "arrayBuffer" []))
          if Worker.R2.exists bucket key then Js.call logged [report name "stored" false 200]
          else
            let problem :=
              if not verify then Option.none
              else
                -- Matched, not mapped: on the js target a function that waits cannot be passed where none is expected.
                match Worker.Crypto.gunzip bytes with
                | Option.none => pushProblem name Option.none
                | Option.some inflated => pushProblem name (Option.some (Worker.Crypto.sha256 inflated))
            match problem with
            | Option.some (status, message) => Worker.Http.problem status message
            | Option.none =>
                match Js.toOption (Js.Async.await (moveHead logged)) with
                | Option.some refused => Js.call logged [refused]
                | Option.none =>
                    let _ := Worker.R2.put bucket key bytes "application/gzip"
                    Js.call logged [report name "stored" true 201]
        else if verb == "DELETE" then
          -- Only compaction deletes a bundle, once strata hold everything it lists (D73), and into the trash, so a
          -- compaction bug costs storage, never history.
          let logged := Js.Async.await (authorize "compact")
          let _ := Worker.R2.toTrash bucket project "bundles" name
          Js.call logged [report name "deleted" true 200]
        else Worker.Http.problem 405 "method not allowed"
  | _ => Worker.Http.problem 404 "not a bundle name"

end Worker.Bundles
