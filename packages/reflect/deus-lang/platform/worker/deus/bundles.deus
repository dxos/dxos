-- context: @dxos/worker/Worker
/-
  A project's bundles (task 41714c0d, D50, D164): the history a push sends, one gzipped file per bundle, named by
  its level and the SHA-256 of its text. Reads are open; a push writes one and moves the branch head with it, and only
  compaction deletes one, into the trash (DataSafety.Spec).
-/

namespace Worker.Bundles

/-- `{"bundle": name, <field>: true or false}`, how the API reports a write. -/
def report (name : Text) (field : Text) (value : Bool) (status : Int) : Js :=
  Worker.Http.json (Js.obj [("bundle", Js.text name), (field, Js.bool value)]) status

/-- Why the Worker refuses a bundle sent as `name`, given the SHA-256 of its text gunzipped (none when it was not
  gzip): the status and message, or none to keep it. Kept apart from `serve` so the rule runs without R2 or a
  request, in the simulator and in tests (task 019e7afe). -/
def pushProblem (name : Text) (digest : Option Text) : Option (Int, Text) :=
  match digest with
  | Option.none => Option.some (400, "a bundle is sent gzipped")
  | Option.some digest =>
      if Option.some digest == List.get? (Text.split name "-") 1 then Option.none
      else Option.some (400, "the bundle does not hash to its name")

test pushRefusesWhatIsNotGzip := pushProblem "0-abc" Option.none == Option.some (400, "a bundle is sent gzipped")

test pushRefusesAMisnamedBundle := pushProblem "0-abc" (Option.some "def") == Option.some (400, "the bundle does not hash to its name")

test pushKeepsABundleNamedByItsHash := pushProblem "0-abc" (Option.some "abc") == Option.none

/-- Where a project's bundles live, by name, holding bodies of type `b`: R2 at the edge, a map in tests. `digest`
  is the SHA-256 of a body's text gunzipped, or none when it is not gzip. -/
structure Store (b : Type) where
  names : Unit -> {Js.Async} List Text
  read : Text -> {Js.Async} Option b
  holds : Text -> {Js.Async} Bool
  write : Text -> b -> {Js.Async} Unit
  trash : Text -> {Js.Async} Unit
  digest : b -> {Js.Async} Option Text

/-- What a bundles request answers; `report` and `refused` are writes, which the audit table records. -/
inductive Reply (b f : Type) where
  | listing (names : List Text)
  | bundle (body : b)
  | report (name : Text) (field : Text) (value : Bool) (status : Int)
  | problem (status : Int) (message : Text)
  | refused (refusal : f)

def listing (store : Store b) (verb : Text) : {Js.Async} Reply b f :=
  if verb == "GET" then Reply.listing (store.names ()) else Reply.problem 405 "method not allowed"

/-- A push of `name`: kept once, refused when it is not what its name says, and stored only once the head moved. -/
def push (store : Store b) (name : Text) (verify : Bool) (body : Unit -> {Js.Async} b) (authorize : Text -> {Js.Async} Unit) (moveHead : Unit -> {Js.Async} Option f) : {Js.Async} Reply b f :=
  let _ := authorize "push"
  let sent := body ()
  if store.holds name then Reply.report name "stored" false 200
  else
    let problem := if verify then pushProblem name (store.digest sent) else Option.none
    match problem with
    | Option.some (status, message) => Reply.problem status message
    | Option.none =>
        match moveHead () with
        | Option.some refusal => Reply.refused refusal
        | Option.none =>
            let _ := store.write name sent
            Reply.report name "stored" true 201

/-- Answers `verb` on `/v1/<project>/bundles/<rest>` over `store`, without R2 or a request, so a simulated store
  drives it in tests (task 019e7afe). `body` reads what a push sends; `authorize scope` checks the key, failing
  the request when it does not allow `scope`; `moveHead` moves the branch head a push claims, giving the refusal
  when it cannot. -/
def answer (store : Store b) (verb : Text) (rest : List Text) (verify : Bool) (body : Unit -> {Js.Async} b) (authorize : Text -> {Js.Async} Unit) (moveHead : Unit -> {Js.Async} Option f) : {Js.Async} Reply b f :=
  match rest with
  | [] => listing store verb
  | [""] => listing store verb
  | [name] =>
      if not (Worker.Paths.isBundle name) then Reply.problem 404 "not a bundle name"
      else if verb == "GET" then
        match store.read name with
        | Option.none => Reply.problem 404 "no such bundle"
        | Option.some found => Reply.bundle found
      else if verb == "PUT" then push store name verify body authorize moveHead
      else if verb == "DELETE" then
        -- Only compaction deletes a bundle, once strata hold everything it lists (D73), and into the trash, so a
        -- compaction bug costs storage, never history.
        let _ := authorize "compact"
        let _ := store.trash name
        Reply.report name "deleted" true 200
      else Reply.problem 405 "method not allowed"
  | _ => Reply.problem 404 "not a bundle name"

/-- Bundles held in `held` as text, a body being gzip when it starts `gz:`; `answer` in tests, with no R2. -/
def memoryStore (held : Ref (Map Text Text)) : Store Text :=
  { names := fun _ => Map.keys (Ref.get held),
    read := fun name => Map.lookup name (Ref.get held),
    holds := fun name => Map.contains name (Ref.get held),
    write := fun name body => Ref.set held (Map.insert name body (Ref.get held)),
    trash := fun name => Ref.set held (Map.remove name (Ref.get held)),
    digest := fun body => if Text.startsWith "gz:" body then Option.some (Text.sha256 (Text.drop 3 body)) else Option.none }

/-- Runs `body` with nothing to wait for, as `answer` over `memoryStore` has. -/
def offline (body : Unit -> {Js.Async | r} a) : {r} a :=
  handle body () with
  | Js.Async.await promise -> k => k promise

test bundlesArePushedReadListedAndTrashed :=
  offline (fun _ =>
    let held := Ref.new Map.empty
    let scopes := Ref.new []
    let store := memoryStore held
    let name := "0-" ++ Text.sha256 "(bundle)"
    let other := "1-" ++ Text.sha256 "(other)"
    let send := fun verb rest body refusal =>
      answer store verb rest true (fun _ => body) (fun scope => Ref.set scopes (Ref.get scopes ++ [scope])) (fun _ => refusal)
    let pushed := send "PUT" [name] "gz:(bundle)" Option.none
    let kept := send "PUT" [name] "gz:(bundle)" Option.none
    let misnamed := send "PUT" [other] "gz:(bundle)" Option.none
    let plain := send "PUT" [other] "(other)" Option.none
    let refused := send "PUT" [other] "gz:(other)" (Option.some "behind")
    let read := send "GET" [name] "" Option.none
    let listed := send "GET" [] "" Option.none
    let missing := send "GET" [other] "" Option.none
    let trashed := send "DELETE" [name] "" Option.none
    pushed == Reply.report name "stored" true 201
      && kept == Reply.report name "stored" false 200
      && misnamed == Reply.problem 400 "the bundle does not hash to its name"
      && plain == Reply.problem 400 "a bundle is sent gzipped"
      && refused == Reply.refused "behind"
      && read == Reply.bundle "gz:(bundle)"
      && listed == Reply.listing [name]
      && missing == Reply.problem 404 "no such bundle"
      && trashed == Reply.report name "deleted" true 200
      && Map.keys (Ref.get held) == []
      && Ref.get scopes == ["push", "push", "push", "push", "push", "compact"])

test bundlesRefuseOtherPathsAndVerbs :=
  offline (fun _ =>
    let store := memoryStore (Ref.new Map.empty)
    let send := fun verb rest =>
      answer store verb rest true (fun _ => "") (fun _ => ()) (fun _ => Option.none)
    send "POST" [] == Reply.problem 405 "method not allowed"
      && send "GET" ["0-abc"] == Reply.problem 404 "not a bundle name"
      && send "GET" ["a", "b"] == Reply.problem 404 "not a bundle name"
      && send "PATCH" ["0-" ++ Text.sha256 ""] == Reply.problem 405 "method not allowed"
      && send "GET" [""] == Reply.listing [])

/-- The bundles of `project` in the R2 `bucket`. -/
def r2Store (bucket : Js) (project : Text) : Store Js :=
  let folder := project ++ "/bundles/"
  { names := fun _ => Worker.R2.listAll bucket folder,
    read := fun name =>
      match Worker.R2.get bucket (folder ++ name) with
      | Option.none => Option.none
      | Option.some object => Option.some (Js.get object "body"),
    holds := fun name => Worker.R2.exists bucket (folder ++ name),
    write := fun name bytes => Worker.R2.put bucket (folder ++ name) bytes "application/gzip",
    trash := fun name => Worker.R2.toTrash bucket project "bundles" name,
    digest := fun bytes =>
      match Worker.Crypto.gunzip bytes with
      | Option.none => Option.none
      | Option.some inflated => Option.some (Worker.Crypto.sha256 inflated) }

/-- Answers `/v1/<project>/bundles/<rest>` for `request`, on the R2 `bucket` (`answer`). `authorize scope` is
  remote.mjs's key check (as for `Worker.Files.serve`), giving the function that records a write, and `moveHead
  logged` moves the branch head the push claims, giving a promise of the response that refuses the push, or of
  `undefined` when the head moved. -/
def serve (request : Js) (bucket : Js) (project : Text) (rest : List Text) (verify : Bool) (authorize : Text -> Js) (moveHead : Js -> Js) : {Js.Async} Js :=
  let logged := Ref.new Js.undefined
  let reply :=
    answer
      (r2Store bucket project)
      (Worker.Http.method request)
      rest
      verify
      (fun _ => Worker.R2.bytes (Js.Async.await (Js.method request "arrayBuffer" [])))
      (fun scope => Ref.set logged (Js.Async.await (authorize scope)))
      (fun _ => Js.toOption (Js.Async.await (moveHead (Ref.get logged))))
  match reply with
  | Reply.listing names => Worker.Http.lines names
  -- A bundle never changes, so a cached copy is always right.
  | Reply.bundle body => Worker.Http.response body 200 [("content-type", "application/gzip"), ("cache-control", "public, max-age=31536000, immutable")]
  | Reply.report name field value status => Js.call (Ref.get logged) [report name field value status]
  | Reply.problem status message => Worker.Http.problem status message
  | Reply.refused refusal => Js.call (Ref.get logged) [refusal]

end Worker.Bundles
