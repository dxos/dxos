-- context: @dxos/worker/Worker
/-
  The Worker's pack rules in DEUS (task 41714c0d): what platform/worker/packs.mjs checks of a request and of a pack
  index, compiled to JavaScript by `scripts/build-worker.mjs --live` from the `@dxos/worker` codebase. Bytes are
  JavaScript `Uint8Array`s, read through the `Js` library of `@dxos/web`.
-/

namespace Worker.Bytes

/-- How many bytes `bytes` holds. -/
def length (bytes : Js) : Int := Js.toInt (Js.get bytes "length")

/-- The big-endian unsigned 32-bit number at `at`, as an `Int` (counts and offsets stay below 2³¹). -/
def u32 : Js -> Int -> Int := Js.import "deus:runtime" "js.u32At"

/-- The byte at `at`: a direct read, since a binary search reads bytes by the hundred. -/
def u8 : Js -> Int -> Int := Js.import "deus:runtime" "js.byteAt"

/-- How `length` bytes of `a` from `aAt` order against those of `b` from `bAt`: negative, zero or positive. -/
def compare : Js -> Int -> Js -> Int -> Int -> Int := Js.import "deus:runtime" "js.compareBytes"

end Worker.Bytes

namespace Worker.Packs

/-- An index's fanout: 256 big-endian counts of the records whose key starts with each byte. -/
def fanout : Int := 1024

/-- One index record: a 32-byte key, a 32-bit kind, 32-bit offset, 32-bit length and 32-bit flags. -/
def record : Int := 48

/-- A byte range a request asks for: `bytes=<first>-[<last>]`; no length reads to the end. -/
structure Range @"urn:deus:worker:Range" where
  offset : Int
  length : Option Int

/-- Digits only, as a number; none when `t` is empty, holds anything else, or passes nine digits, which an `Int`
  (32 bits) could wrap: such a range reads the whole file, as one the Worker does not understand. -/
def digits (t : Text) : Option Int := if not (Text.isEmpty t) && Text.length t <= 9 && List.all (fun c => Text.isDigit c) (Text.utf8 t) then Int.fromText t else Option.none

/-- `bytes=<first>-[<last>]` as a range; other forms (suffixes, several ranges) read the whole file. -/
def parseRange (header : Text) : Option Range := if not (startsWith "bytes=" header) then Option.none else
  match Text.split (Text.drop 6 header) "-" with
  | [first, last] =>
      match (digits first, if Text.isEmpty last then Option.some Option.none else Option.map Option.some (digits last)) with
      | (Option.some offset, Option.some (Option.some final)) => Option.some (Range.mk offset (Option.some (final - offset + 1)))
      | (Option.some offset, Option.some Option.none) => Option.some (Range.mk offset Option.none)
      | _ => Option.none
  | _ => Option.none

/-- What is wrong with the fanout at byte `start` of `bytes`, if anything: a non-decreasing count that ends at
  `records`, the number of records after it. -/
def fanoutProblem (bytes : Js) (start : Int) (records : Int) : Option Text :=
  let rec walk byte previous :=
    if byte == 256 then
      if previous != records then Option.some "the fanout does not count the records" else Option.none
    else
      let count := Worker.Bytes.u32 bytes (start + byte * 4)
      if count < previous then Option.some "the fanout decreases" else walk (byte + 1) count
  walk 0 0

/-- What is wrong with a pack index, if anything: it is 1024 fanout bytes and 48-byte records, and the fanout counts
  the records. -/
def checkIndex (bytes : Js) : Option Text :=
  let size := Worker.Bytes.length bytes
  if size < fanout || (size - fanout) % record != 0 then Option.some "an index is 1024 fanout bytes and 48-byte records"
  else fanoutProblem bytes 0 ((size - fanout) / record)

/-- The bytes a combined index starts with: `DEUSIX1` and a newline. -/
def magic : List Int := [68, 69, 85, 83, 73, 88, 49, 10]

/-- Where the fanout of a combined index starts: after the magic, a u32 byte length and that many bytes of pack
  names. -/
def combinedFanout (bytes : Js) : Int := 12 + Worker.Bytes.u32 bytes 8

/-- What is wrong with a combined index, if anything: the magic, the pack names, 1024 fanout bytes and 48-byte
  records, and the fanout counts the records. A corrupt one is refused rather than searched as garbage. -/
def checkCombined (bytes : Js) : Option Text :=
  let size := Worker.Bytes.length bytes
  if size < 12 || not (List.all (fun (at, byte) => Worker.Bytes.u8 bytes at == byte) (zip (range 0 8) magic)) then
    Option.some "a combined index starts with DEUSIX1"
  else
    let start := combinedFanout bytes
    -- `start` is 32-bit arithmetic, so a name length past 2³¹ wraps below 12.
    if start < 12 || start > size || size - start < fanout || (size - start - fanout) % record != 0 then
      Option.some "a combined index is a header, pack names, 1024 fanout bytes and 48-byte records"
    else fanoutProblem bytes start ((size - start - fanout) / record)

/-- How the 32-byte key of the record at byte `at` of `records` orders against `key`: negative, zero or positive. -/
def compareKey (records : Js) (at : Int) (key : Js) : Int := Worker.Bytes.compare records at key 0 32

/-- The record for (`key`, `kind`) among the sorted records `first` to `last` of `records`, as its byte offset there,
  or -1: a binary search by key, then kind (byte 44). -/
def search (records : Js) (first : Int) (last : Int) (key : Js) (kind : Int) : Int :=
  let rec go low high := if low > high then -1 else
    let middle := Int.shr (low + high) 1
    let at := middle * record
    let byKey := compareKey records at key
    let order := if byKey != 0 then byKey else Worker.Bytes.u8 records (at + 44) - kind
    if order < 0 then go (middle + 1) high else if order > 0 then go low (middle - 1) else at
  go first last

/-- Of the records equal to the one at `at` (several packs can hold one key), the one from the pack merged last
  (the larger number at byte 32). Metadata is rewritten in place, so only its newest copy is current; an object's
  copies are all the same, so objects (kind 1) keep the first match. -/
def newestAt (records : Js) (at : Int) (first : Int) (last : Int) (key : Js) (kind : Int) : Int := if kind != 2 then at else
  let same := fun offset => compareKey records offset key == 0 && Worker.Bytes.u8 records (offset + 44) == kind
  let rec walk offset step best :=
    if offset < first * record || offset > last * record || not (same offset) then best
    else walk (offset + step) step (if Worker.Bytes.u32 records (offset + 32) > Worker.Bytes.u32 records (best + 32) then offset else best)
  walk (at + record) record (walk (at - record) (0 - record) at)

end Worker.Packs
