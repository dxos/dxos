/-
  Performance requirements as MDL blocks (D46). Costs are machine steps, which are deterministic
  and the same on every kernel, so a requirement is a test with a verdict, not a benchmark with a
  tolerance for noise.

    ```mdl
    perf P-1: insertion sort is quadratic
      run: fun n => Sort.isort (List.reverse (List.range 0 n))
      sizes: 20 | 40 | 80
      order: n^2
      budget: 50000
    ```

  - `run:` an expression; with `sizes:` a function of the size, applied to each.
  - `budget:` the most steps `run` may take (at the largest size).
  - `order:` `1`, `log n`, `n`, `n log n` or `n^2`: from one size to the next the cost may grow
    by at most the order's ratio, plus 25% for lower-order terms.
-/

namespace Perf

def log2 (n : Int) : Int := if n <= 2 then 1 else 1 + log2 (n / 2)

/-- An order's growth function at `n`; none for an order this extension does not know. -/
def growth (order : Text) (n : Int) : Option Int :=
  if order == "1" then some 1
  else if order == "log n" then some (log2 n)
  else if order == "n" then some n
  else if order == "n log n" then some (n * log2 n)
  else if order == "n^2" then some (n * n)
  else none

/-- A ratio scaled by 100, as `x.yz`. -/
def ratio (hundredths : Int) : Text :=
  let cents := hundredths % 100
  Int.toText (hundredths / 100) ++ (if cents < 10 then ".0" else ".") ++ Int.toText cents

def overBudget (b : Block) (steps : Int) : List Text :=
  match List.lookup "budget" b.props with
  | none => []
  | some text =>
    match Int.fromText text with
    | none => ["budget: " ++ text ++ " is not a number of steps"]
    | some limit => if steps <= limit then [] else ["took " ++ Int.toText steps ++ " steps; the budget is " ++ text]

/-- Whether the cost grows no faster than `order` between two (size, steps) samples. -/
def tooFast (order : Text) (small : (Int, Int)) (large : (Int, Int)) : List Text :=
  match (small, large) with
  | ((n1, c1), (n2, c2)) =>
    match (growth order n1, growth order n2) with
    | (some g1, some g2) =>
      let observed := c2 * 100 / (if c1 < 1 then 1 else c1)
      let allowed := g2 * 125 / g1
      if observed <= allowed then []
      else ["cost grew x" ++ ratio observed ++ " from n=" ++ Int.toText n1 ++ " to n=" ++ Int.toText n2 ++ " (" ++ Int.toText c1 ++ " -> " ++ Int.toText c2 ++ " steps); order " ++ order ++ " allows x" ++ ratio allowed]
    | _ => ["order: " ++ order ++ " is not one of 1, log n, n, n log n, n^2"]

def pairs (xs : List a) : List (a, a) :=
  match xs with
  | x :: y :: rest => (x, y) :: pairs (y :: rest)
  | _ => []

def scaling (b : Block) (run : Text) (sizes : List Int) : {MdlHost} List Text :=
  let samples := List.map (fun n => (n, MdlHost.cost ("(" ++ run ++ ") " ++ Int.toText n))) sizes
  let failed := List.filterMap (fun s =>
    match snd s with
    | Result.err message => some message
    | Result.ok _ => none) samples
  if not (List.isEmpty failed) then failed
  else
    let costs := List.filterMap (fun s =>
      match s with
      | (n, Result.ok steps) => some (n, steps)
      | _ => none) samples
    let largest := List.foldl (fun _ s => snd s) 0 costs
    let growthProblems := match List.lookup "order" b.props with
      | none => []
      | some order => List.concatMap (fun p => tooFast order (fst p) (snd p)) (pairs costs)
    growthProblems ++ overBudget b largest

/-- The `perf` block type. -/
@[ext "org.dxos.deus.perf@1.0"]
def check (b : Block) : {MdlHost} List Text :=
  match List.lookup "run" b.props with
  | none => ["perf needs run:"]
  | some run =>
    match List.lookup "sizes" b.props with
    | none =>
      match MdlHost.cost run with
      | Result.ok steps => overBudget b steps
      | Result.err message => [message]
    | some sizes =>
      let parsed := List.map (fun s => Int.fromText (Text.trim s)) (Text.split sizes "|")
      if List.any Option.isNone parsed then ["sizes: " ++ sizes ++ " is not a list of numbers like 10 | 20 | 40"]
      else scaling b run (List.filterMap (fun s => s) parsed)

end Perf
