/-
  The web as DEUS data and abilities (P7, D45, D57), independent of where it runs.

  A handler is a function `Request -> {Storage, Http, Actors, Alarm, IO} Response` named by its
  definition. It serves a named object (a Durable Object, an actor). Its row says what it
  touches: `Storage` is the object's own storage, `Http` is outbound requests, `Actors` calls
  other objects by name, and `Alarm` schedules a later request to itself.

  Three runtimes run the same handler:
  - `Web.simulate` and `Web.simulateMany`: in memory, on a logical clock, for tests.
  - `deus build <handler> --server` (or `deus serve`): a standalone native binary, serving
    HTTP with storage on disk (`deus-kernel/src/server.rs`).
  - `deus build <handler> --worker`: a Cloudflare Worker, with one Durable Object per name
    (`deus-kernel/embed/worker.mjs`).
-/

structure Request @"urn:deus:web:Request" where
  verb : Text
  url : Text
  payload : Text

structure Response @"urn:deus:web:Response" where
  status : Int
  content : Text
  headers : List (Text, Text)

/-- A Durable Object's own transactional storage. -/
ability Storage @"urn:deus:web:Storage" where
  get : Text -> Option Text
  put : Text -> Text -> Unit
  delete : Text -> Bool

/-- Outbound HTTP. -/
ability Http @"urn:deus:web:Http" where
  fetch : Request -> Response

/-- Other objects of the same class, by name: a call is a request served by that object. -/
ability Actors @"urn:deus:web:Actors" where
  call : Text -> Request -> Response

/-- The object's alarm: `set` schedules one `ALARM /alarm` request after the given milliseconds, replacing any earlier one. -/
ability Alarm @"urn:deus:web:Alarm" where
  set : Int -> Unit

namespace Web

def ok (content : Text) : Response := Response.mk 200 content []

/-- An HTML page. -/
def html (content : Text) : Response := Response.mk 200 content [("content-type", "text/html; charset=utf-8")]

/-- A response with a status and no headers. -/
def reply (code : Int) (content : Text) : Response := Response.mk code content []

def notFound (path : Text) : Response := Response.mk 404 ("no route " ++ path) []

/--
  Runs an actor on a sequence of requests against one in-memory storage, as a Durable Object
  would serve them; `Http` answers 503. Returns the responses and the final storage.
-/
def simulate (actor : Request -> {Storage, Http | r} Response) (requests : List Request) : {r} (List Response, Map Text Text) :=
  let store := Ref.new Map.empty
  let serve := fun (request : Request) =>
    handle actor request with
    | Storage.get key -> k => k (Map.lookup key (Ref.get store))
    | Storage.put key value -> k =>
      Ref.set store (Map.insert key value (Ref.get store))
      k ()
    | Storage.delete key -> k =>
      let had := Map.contains key (Ref.get store)
      Ref.set store (Map.remove key (Ref.get store))
      k had
    | Http.fetch _ -> k => k (Response.mk 503 "no network in simulation" [])
  let responses := List.map serve requests
  (responses, Ref.get store)

/-- The request an alarm delivers. -/
def alarmRequest : Request := Request.mk "ALARM" "/alarm" ""

/--
  Serves `(object, request)` pairs on named objects of one class, each with its own storage.
  `Actors.call` is served at once on the named object; `Alarm.set` schedules on a logical clock,
  and once the requests are served, due alarms run in time order (ties by name). Returns the
  responses to `requests`, every object's storage, and the alarms that ran as (object, time).
-/
def simulateMany (actor : Request -> {Storage, Http, Actors, Alarm | r} Response) (requests : List (Text, Request)) : {r} (List Response, Map Text (Map Text Text), List (Text, Int)) :=
  let stores := Ref.new Map.empty
  let alarms := Ref.new Map.empty
  let clock := Ref.new 0
  let storeOf := fun (name : Text) => Option.getOr (Map.lookup name (Ref.get stores)) Map.empty
  let update := fun (name : Text) (f : Map Text Text -> Map Text Text) => Ref.set stores (Map.insert name (f (storeOf name)) (Ref.get stores))
  let rec serve name request :=
    handle actor request with
    | Storage.get key -> k => k (Map.lookup key (storeOf name))
    | Storage.put key value -> k =>
      update name (fun m => Map.insert key value m)
      k ()
    | Storage.delete key -> k =>
      let had := Map.contains key (storeOf name)
      update name (fun m => Map.remove key m)
      k had
    | Http.fetch _ -> k => k (Response.mk 503 "no network in simulation" [])
    | Actors.call other inner -> k => k (serve other inner)
    | Alarm.set delay -> k =>
      Ref.set alarms (Map.insert name (Ref.get clock + delay) (Ref.get alarms))
      k ()
  let responses := List.map (fun pair => serve (fst pair) (snd pair)) requests
  -- An alarm may set another; a bound keeps a self-rescheduling actor from running forever.
  let rec fire count acc :=
    let due := List.sortBy (fun a b => compare (snd a, fst a) (snd b, fst b)) (Map.toList (Ref.get alarms))
    match due with
    | [] => List.reverse acc
    | (name, at) :: _ =>
      if count >= 1000 then defect "alarms kept rescheduling past 1000 runs"
      else
        Ref.set alarms (Map.remove name (Ref.get alarms))
        Ref.set clock at
        serve name alarmRequest
        fire (count + 1) ((name, at) :: acc)
  let fired := fire 0 []
  (responses, Ref.get stores, fired)

end Web
