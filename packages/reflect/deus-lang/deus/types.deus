/-
  Types: Hindley–Milner inference with row-polymorphic ability sets (Leijen's scoped
  labels, as in Koka), over resolved Core.

  - `a -> {E | r} b`: a function whose call may perform the abilities in its row. Rows are
    inferred; an arrow written without braces in a signature has a fresh row (it constrains no
    effects), and a written row such as `{IO, Throw Text}` is closed.
  - A handler removes the ability it handles from the row of its body; anything else flows
    out. So a `Throw e` the caller does not handle stays in the caller's type: errors are
    checked (D14). Defects are not in types.
  - Top-level definitions are generalized; locals are monomorphic. A recursive group is
    inferred together.
  - A type parameter used as a row inside a field (`run : Unit -> {r} Int`) is a row parameter
    (D55): the type is applied to a row, `Box {IO | r}`, and the field's effects are the row's.
    Field arrows are closed, and one written without braces is pure, so a function stored in
    data keeps its effects.
-/

inductive TType where
  | con (iri : Text) (args : List TType)
  | fn (from : TType) (row : TRow) (to : TType)
  | var (id : Int)
  -- The argument of a row parameter (D55): `Box {IO | r}`.
  | row (r : TRow)

inductive TRow where
  | empty
  | extend (label : TType) (rest : TRow)
  | var (id : Int)

/-- Mutable unification state for one batch. -/
structure Unifier where
  types : MutMap Int TType
  rows : MutMap Int TRow
  next : Ref Int

namespace Types

def newUnifier (u : Unit) : Unifier := Unifier.mk (MutMap.new ()) (MutMap.new ()) (Ref.new 0)

def fresh (u : Unifier) : Int :=
  let k := Ref.get u.next
  Ref.set u.next (k + 1)
  k

def freshType (u : Unifier) : TType := TType.var (fresh u)

def freshRow (u : Unifier) : TRow := TRow.var (fresh u)

def int : TType := TType.con "#Int" []

def text : TType := TType.con "#Text" []

def bool : TType := TType.con "#Bool" []

def unitT : TType := TType.con "#Unit" []

/-- Follows bound variables at the top of a type. -/
def resolve (u : Unifier) (t : TType) : TType :=
  match t with
  | TType.var id =>
    match MutMap.get u.types id with
    | some bound =>
      let r := resolve u bound
      MutMap.set u.types id r
      r
    | none => t
  | _ => t

def resolveRow (u : Unifier) (r : TRow) : TRow :=
  match r with
  | TRow.var id =>
    match MutMap.get u.rows id with
    | some bound => resolveRow u bound
    | none => r
  | _ => r

/-- Fully substituted type (for printing and generalizing). -/
def zonk (u : Unifier) (t : TType) : TType :=
  match resolve u t with
  | TType.con iri args => TType.con iri (List.map (fun a => zonk u a) args)
  | TType.fn a r b => TType.fn (zonk u a) (zonkRow u r) (zonk u b)
  | TType.row r => TType.row (zonkRow u r)
  | v => v

def zonkRow (u : Unifier) (r : TRow) : TRow :=
  match resolveRow u r with
  | TRow.extend l rest => TRow.extend (zonk u l) (zonkRow u rest)
  | other => other

def occurs (u : Unifier) (id : Int) (t : TType) : Bool :=
  match resolve u t with
  | TType.var other => other == id
  | TType.con _ args => List.any (fun a => occurs u id a) args
  | TType.fn a r b => occurs u id a || occursInRow u id r || occurs u id b
  | TType.row r => occursInRow u id r

def occursInRow (u : Unifier) (id : Int) (r : TRow) : Bool :=
  match resolveRow u r with
  | TRow.extend l rest => occurs u id l || occursInRow u id rest
  | TRow.var other => other == id
  | TRow.empty => false

def rowTailIs (u : Unifier) (id : Int) (r : TRow) : Bool :=
  match resolveRow u r with
  | TRow.extend _ rest => rowTailIs u id rest
  | TRow.var other => other == id
  | TRow.empty => false

def labelIri (t : TType) : Text :=
  match t with
  | TType.con iri _ => iri
  | _ => ""

def rowTailVar (u : Unifier) (r : TRow) : Option Int :=
  match resolveRow u r with
  | TRow.extend _ rest => rowTailVar u rest
  | TRow.var id => some id
  | TRow.empty => none

def hasLabel (u : Unifier) (r : TRow) (label : TType) : Bool :=
  match resolveRow u r with
  | TRow.extend l rest => labelIri (resolve u l) == labelIri (resolve u label) || hasLabel u rest label
  | _ => false

/--
  Leijen's side condition: moving `label` out of `other` would extend a tail that `rest` shares,
  which can never terminate, so the rows differ.
-/
def sharedTailMissing (u : Unifier) (label : TType) (rest : TRow) (other : TRow) : Bool :=
  not (hasLabel u other label) && Option.isSome (rowTailVar u rest) && rowTailVar u rest == rowTailVar u other

--
-- Printing (for errors and `view`).
--

/-- Names for type variables in order of appearance: a, b, …; rows: e, e1, …. -/
def varName (seen : Ref (Map Text Text)) (key : Text) (row : Bool) : Text :=
  match Map.lookup key (Ref.get seen) with
  | some name => name
  | none =>
    let count := List.length (List.filter (fun pair => Text.startsWith (if row then "r" else "t") (fst pair)) (Map.toList (Ref.get seen)))
    let name := if row then (if count == 0 then "e" else "e" ++ Int.toText count) else (if count < 4 then Text.fromCode ('a' + count) else "t" ++ Int.toText count)
    Ref.set seen (Map.insert key name (Ref.get seen))
    name

/-- A type's display name from its IRI: the last segment after `/`, `:` and `.`, or a builtin without its `#`. -/
def iriName (iri : Text) : Text :=
  if Text.startsWith "#" iri then Text.drop 1 iri
  else
    let afterSlash := Option.getOr (List.last? (Text.split iri "/")) iri
    Names.lastSegment (Option.getOr (List.last? (Text.split afterSlash ":")) afterSlash)

def showType (t : TType) (seen : Ref (Map Text Text)) (prec : Int) : Text :=
  match t with
  | TType.var id => varName seen ("t" ++ Int.toText id) false
  | TType.con "#Pair" [a, b] => "(" ++ showType a seen 0 ++ ", " ++ showType b seen 0 ++ ")"
  | TType.con iri [] => iriName iri
  | TType.con iri args => Print.paren 90 prec (iriName iri ++ Text.concat (List.map (fun a => " " ++ showType a seen 100) args))
  | TType.fn a r b =>
    let rowText := showRow r seen
    Print.paren 10 prec (showType a seen 11 ++ " -> " ++ (if rowText == "" then "" else rowText ++ " ") ++ showType b seen 10)
  | TType.row r => rowArgument (showRow r seen) (resolveTail r) seen

/-- `{IO, Throw Text | e}`; an unconstrained row prints as nothing. -/
def showRow (r : TRow) (seen : Ref (Map Text Text)) : Text :=
  let rec labels row acc :=
    match row with
    | TRow.extend l rest => labels rest (showType l seen 0 :: acc)
    | TRow.var id => (List.reverse acc, some (varName seen ("r" ++ Int.toText id) true))
    | TRow.empty => (List.reverse acc, none)
  match labels r [] with
  | ([], some _) => ""
  | ([], none) => "{}"
  | (ls, none) => "{" ++ Text.join ", " ls ++ "}"
  | (ls, some tail) => "{" ++ Text.join ", " ls ++ " | " ++ tail ++ "}"

/-- The open tail of a row as written, if any. -/
def resolveTail (r : TRow) : Option Int :=
  match r with
  | TRow.extend _ rest => resolveTail rest
  | TRow.var id => some id
  | TRow.empty => none

/-- A row argument is always printed in braces, even when it is only a variable. -/
def rowArgument (text : Text) (tail : Option Int) (seen : Ref (Map Text Text)) : Text :=
  if text != "" then text
  else
    match tail with
    | some id => "{" ++ varName seen ("r" ++ Int.toText id) true ++ "}"
    | none => "{}"

--
-- Unification.
--

def mismatch (u : Unifier) (a : TType) (b : TType) : {Throw Text} x :=
  let seen := Ref.new Map.empty
  throw ("type mismatch: " ++ showType (zonk u a) seen 0 ++ " vs " ++ showType (zonk u b) seen 0)

def unify (u : Unifier) (a : TType) (b : TType) : {Throw Text} Unit :=
  match (resolve u a, resolve u b) with
  | (TType.var x, TType.var y) => if x == y then () else MutMap.set u.types x (TType.var y)
  | (TType.var x, t) => if occurs u x t then throw "infinite type" else MutMap.set u.types x t
  | (t, TType.var y) => if occurs u y t then throw "infinite type" else MutMap.set u.types y t
  | (TType.con i1 a1, TType.con i2 a2) =>
    if i1 != i2 || List.length a1 != List.length a2 then mismatch u a b
    else List.forEach (List.zip a1 a2) (fun pair => unify u (fst pair) (snd pair))
  | (TType.fn a1 r1 b1, TType.fn a2 r2 b2) =>
    unify u a1 a2
    unifyRow u r1 r2
    unify u b1 b2
  | (TType.row r1, TType.row r2) => unifyRow u r1 r2
  | (x, y) => mismatch u x y

/-- Finds `label`'s ability in a row: (its occurrence, the row without it). Extends an open tail. -/
def rewriteRow (u : Unifier) (r : TRow) (label : TType) : {Throw Text} (TType, TRow) :=
  match resolveRow u r with
  | TRow.extend l rest =>
    if labelIri (resolve u l) == labelIri (resolve u label) then (l, rest)
    else
      match rewriteRow u rest label with
      | (found, rest2) => (found, TRow.extend l rest2)
  | TRow.var id =>
    let tail := freshRow u
    let l := label
    MutMap.set u.rows id (TRow.extend l tail)
    (l, tail)
  | TRow.empty => throw ("unhandled ability " ++ showType (zonk u label) (Ref.new Map.empty) 0)

def rowMismatch (u : Unifier) (a : TRow) (b : TRow) : {Throw Text} x :=
  let seen := Ref.new Map.empty
  throw ("ability mismatch: " ++ showRow (zonkRow u a) seen ++ " vs " ++ showRow (zonkRow u b) seen)

def unifyRow (u : Unifier) (a : TRow) (b : TRow) : {Throw Text} Unit :=
  match (resolveRow u a, resolveRow u b) with
  | (TRow.empty, TRow.empty) => ()
  | (TRow.var x, TRow.var y) => if x == y then () else MutMap.set u.rows x (TRow.var y)
  | (TRow.var x, r) => if rowTailIs u x r then rowMismatch u a b else MutMap.set u.rows x r
  | (r, TRow.var y) => if rowTailIs u y r then rowMismatch u a b else MutMap.set u.rows y r
  | (TRow.extend l rest, other) =>
    if sharedTailMissing u l rest other then rowMismatch u a b
    else
      match rewriteRow u other l with
      | (found, other2) =>
        unify u l found
        unifyRow u rest other2
  | (TRow.empty, TRow.extend l _) => throw ("unexpected ability " ++ showType (zonk u l) (Ref.new Map.empty) 0)

--
-- Schemes: types with quantified variables, stored as S-expressions in metadata.
--

def typeToSexp (t : TType) : Sexp :=
  match t with
  | TType.con iri args => if List.isEmpty args then Sexp.node "tref" [Sexp.str iri] else Sexp.node "tapp" (Sexp.node "tref" [Sexp.str iri] :: List.map typeToSexp args)
  | TType.fn a r b => Sexp.node "tfun" [typeToSexp a, typeToSexp b, rowToSexp r]
  | TType.var id => Sexp.node "tvar" [Sexp.str ("t" ++ Int.toText id)]
  | TType.row r => Sexp.node "trow" (Sexp.args (rowToSexp r))

def rowToSexp (r : TRow) : Sexp :=
  let rec items row acc :=
    match row with
    | TRow.extend l rest => items rest (typeToSexp l :: acc)
    | TRow.var id => List.reverse (Sexp.node "tvar" [Sexp.str ("r" ++ Int.toText id)] :: acc)
    | TRow.empty => List.reverse acc
  Sexp.node "eff" (items r [])

/-- Instantiates a type written as Core (a signature, a field, an operation, a stored scheme). -/
def fromSexp (u : Unifier) (s : Sexp) (vars : Ref (Map Text TType)) (rowVars : Ref (Map Text TRow)) (params : List TType) (openArrows : Bool) : TType :=
  let named := fun (key : Text) =>
    match Map.lookup key (Ref.get vars) with
    | some t => t
    | none =>
      let t := freshType u
      Ref.set vars (Map.insert key t (Ref.get vars))
      t
  match s with
  | Sexp.list [Sexp.sym "tref", Sexp.str iri] => TType.con iri []
  | Sexp.list [Sexp.sym "tvar", Sexp.int i] => Option.getOr (List.get? params i) (named ("#" ++ Int.toText i))
  | Sexp.list [Sexp.sym "tvar", Sexp.str "?"] => freshType u
  | Sexp.list [Sexp.sym "tvar", Sexp.str name] => named name
  | Sexp.list [Sexp.sym "teff", _, t] => fromSexp u t vars rowVars params openArrows
  | Sexp.list (Sexp.sym "trow" :: effs) => TType.row (rowFromSexp u effs vars rowVars params false)
  | Sexp.list (Sexp.sym "tapp" :: Sexp.list [Sexp.sym "tref", Sexp.str iri] :: args) => TType.con iri (List.map (fun a => fromSexp u a vars rowVars params false) args)
  | Sexp.list (Sexp.sym "tapp" :: head :: args) =>
    -- Applying a type variable is beyond this checker; treat it as unknown.
    freshType u
  -- Only the spine is opened: an argument's row is a contract on what may be passed in.
  -- An arrow written without braces constrains nothing: its row is fresh wherever it appears.
  | Sexp.list [Sexp.sym "tfun", a, b] =>
    TType.fn (fromSexp u a vars rowVars params false) (freshRow u) (fromSexp u b vars rowVars params openArrows)
  | Sexp.list [Sexp.sym "tfun", a, b, Sexp.list (Sexp.sym "eff" :: effs)] =>
    TType.fn (fromSexp u a vars rowVars params false) (rowFromSexp u effs vars rowVars params openArrows) (fromSexp u b vars rowVars params openArrows)
  | _ => freshType u

def rowFromSexp (u : Unifier) (effs : List Sexp) (vars : Ref (Map Text TType)) (rowVars : Ref (Map Text TRow)) (params : List TType) (openArrows : Bool) : TRow :=
  match effs with
  -- Instantiating for a use opens every row (Koka's `open`): a function that performs E can be
  -- called wherever E and more may happen. A signature being checked keeps its rows closed.
  | [] => if openArrows then freshRow u else TRow.empty
  | [Sexp.list [Sexp.sym "tvar", Sexp.str name]] =>
    match Map.lookup name (Ref.get rowVars) with
    | some r => r
    | none =>
      let r := freshRow u
      Ref.set rowVars (Map.insert name r (Ref.get rowVars))
      r
  | [Sexp.list [Sexp.sym "tvar", Sexp.int i]] => paramRow u params i
  | e :: rest => TRow.extend (fromSexp u e vars rowVars params false) (rowFromSexp u rest vars rowVars params openArrows)

/-- The row a type's parameter `i` stands for; a parameter first used as a row becomes one. -/
def paramRow (u : Unifier) (params : List TType) (i : Int) : TRow :=
  match Option.map (fun t => resolve u t) (List.get? params i) with
  | some (TType.row r) => r
  | some (TType.var id) =>
    let r := freshRow u
    MutMap.set u.types id (TType.row r)
    r
  | _ => freshRow u

/-- A field's type with every arrow closed: one written without braces is pure (D55). -/
def closeArrows (s : Sexp) : Sexp :=
  match s with
  | Sexp.list [Sexp.sym "tfun", a, b] => Sexp.list [Sexp.sym "tfun", closeArrows a, closeArrows b, Sexp.list [Sexp.sym "eff"]]
  | Sexp.list [Sexp.sym "tfun", a, b, effs] => Sexp.list [Sexp.sym "tfun", closeArrows a, closeArrows b, effs]
  | Sexp.list items => Sexp.list (List.map closeArrows items)
  | other => other

def instantiate (u : Unifier) (scheme : Sexp) : TType := fromSexp u scheme (Ref.new Map.empty) (Ref.new Map.empty) [] true

--
-- The environment: what the checker knows about hashes.
--

/--
  Lookups the checker needs: objects and metadata by hash, schemes of definitions in this batch.
  Reading the store may fail or perform the caller's abilities, `r`.
-/
structure TypeEnv (r : Effect) where
  object : Text -> {Throw Text | r} Option Sexp
  meta : Text -> {Throw Text | r} Option Sexp
  group : Ref (Map Text TType)
  schemes : Ref (Map Text Sexp)
  prims : Text -> {Throw Text | r} Option Sexp

/-- A definition's type: in this batch (monomorphic while its group is inferred), stored, or unknown. -/
def globalType (u : Unifier) (env : TypeEnv {r}) (h : Text) : TType :=
  match Map.lookup h (Ref.get env.group) with
  | some t => t
  | none =>
    match Map.lookup h (Ref.get env.schemes) with
    | some scheme => instantiate u scheme
    | none => storedType u env h

/-- A codebase definition's type: its inferred scheme, else its signature, else unknown. -/
def storedType (u : Unifier) (env : TypeEnv {r}) (h : Text) : TType :=
  match Codebase.metaField (env.meta h) "scheme" with
  | some scheme => instantiate u scheme
  | none =>
    match Codebase.metaField (env.meta h) "sig" with
    | some sig => fromSexp u sig (Ref.new Map.empty) (Ref.new Map.empty) [] true
    | none => freshType u

/-- A constructor's type: fields to the type, with the type's parameters fresh. -/
def ctorType (u : Unifier) (env : TypeEnv {r}) (typeHash : Text) (tag : Int) : TType :=
  match env.object typeHash with
  | some (Sexp.list (Sexp.sym "type" :: Sexp.str iri :: Sexp.int count :: ctors)) =>
    let params := List.map (fun _ => freshType u) (List.range 0 count)
    let result := TType.con iri params
    match List.get? ctors tag with
    | some (Sexp.list (Sexp.sym "ctor" :: _ :: fields)) =>
      -- Fields are closed: what a stored function may perform is what its field says (D55).
      List.foldr (fun f acc => TType.fn (fromSexp u (closeArrows f) (Ref.new Map.empty) (Ref.new Map.empty) params false) (freshRow u) acc) result fields
    | _ => freshType u
  | _ => freshType u

/-- The result type of a constructor pattern and its field types. -/
def ctorFields (u : Unifier) (env : TypeEnv {r}) (typeHash : Text) (tag : Int) : (TType, List TType) :=
  let rec split t acc :=
    match t with
    | TType.fn a _ b => split b (a :: acc)
    | other => (other, List.reverse acc)
  split (ctorType u env typeHash tag) []

/-- An operation's type; its last arrow performs the ability (with the given parameters). -/
def opType (u : Unifier) (env : TypeEnv {r}) (abilityHash : Text) (index : Int) (params : List TType) : (TType, TType) :=
  match env.object abilityHash with
  | some (Sexp.list (Sexp.sym "ability" :: Sexp.str iri :: Sexp.int count :: ops)) =>
    let ps := if List.length params == count then params else List.map (fun _ => freshType u) (List.range 0 count)
    let label := TType.con iri ps
    match List.get? ops index with
    | some (Sexp.list [Sexp.sym "op", Sexp.int arity, t]) =>
      let rec build s k :=
        match s with
        | Sexp.list (Sexp.sym "tfun" :: a :: b :: _) =>
          let row := if k == 1 then TRow.extend label (freshRow u) else freshRow u
          TType.fn (fromSexp u a (Ref.new Map.empty) (Ref.new Map.empty) ps true) row (if k == 1 then fromSexp u b (Ref.new Map.empty) (Ref.new Map.empty) ps true else build b (k - 1))
        | _ => fromSexp u s (Ref.new Map.empty) (Ref.new Map.empty) ps true
      (build t arity, label)
    | _ => (freshType u, label)
  | _ => (freshType u, TType.con abilityHash [])

--
-- Inference over Core.
--

def infer (u : Unifier) (env : TypeEnv {r}) (t : Sexp) (locals : List TType) (row : TRow) : {Throw Text | r} TType :=
  match t with
  | Sexp.list [Sexp.sym "var", Sexp.int i] => Option.getOr (List.get? locals i) (freshType u)
  | Sexp.list [Sexp.sym "ref", Sexp.str h] => globalType u env h
  | Sexp.list [Sexp.sym "int", _] => int
  | Sexp.list [Sexp.sym "text", _] => text
  | Sexp.list [Sexp.sym "prim", Sexp.str name] =>
    match env.prims name with
    | some scheme => instantiate u scheme
    | none => freshType u
  | Sexp.list [Sexp.sym "con", Sexp.str ty, Sexp.int tag, _] => ctorType u env ty tag
  | Sexp.list [Sexp.sym "op", Sexp.str a, Sexp.int index, _] => fst (opType u env a index [])
  | Sexp.list [Sexp.sym "lam", b] =>
    let a := freshType u
    let inner := freshRow u
    let result := infer u env b (a :: locals) inner
    TType.fn a inner result
  | Sexp.list (Sexp.sym "app" :: f :: args) =>
    let callee := match f with
      | Sexp.list [Sexp.sym "ref", Sexp.str h] => if Text.startsWith "@" h then Text.drop 1 h else "#" ++ Text.take 10 h
      | Sexp.list [Sexp.sym "op", _, Sexp.int i, _] => "an ability operation"
      | Sexp.list [Sexp.sym "var", Sexp.int i] => "a local function"
      | _ => ""
    catch (fun _ => application u env f args locals row) (fun e =>
      if callee == "" || Text.contains " (calling " e then throw e else throw (e ++ " (calling " ++ callee ++ ")"))
  | Sexp.list [Sexp.sym "let", v, b] => infer u env b (infer u env v locals row :: locals) row
  | Sexp.list [Sexp.sym "seq", a, b] =>
    let _ := infer u env a locals row
    infer u env b locals row
  | Sexp.list [Sexp.sym "letrec", Sexp.list fns, b] =>
    let vars := List.map (fun _ => freshType u) fns
    let inner := List.reverse vars ++ locals
    List.forEach (List.zip fns vars) (fun pair => unify u (snd pair) (infer u env (fst pair) inner row))
    infer u env b inner row
  | Sexp.list [Sexp.sym "ann", ty, e] =>
    -- An ascription (D95): its variables are its own and flexible, and `e` is checked against it.
    let declared := signatureType u ty (Ref.new Map.empty) (Ref.new Map.empty)
    checkAgainst u env e declared locals row
    declared
  | Sexp.list [Sexp.sym "annlocal", ty, e] =>
    -- A lambda binder's ascription (D95): local 0 has the written type.
    unify u (Option.getOr (List.get? locals 0) (freshType u)) (signatureType u ty (Ref.new Map.empty) (Ref.new Map.empty))
    infer u env e locals row
  | Sexp.list [Sexp.sym "if", c, yes, no] =>
    unify u (infer u env c locals row) bool
    let ty := infer u env yes locals row
    unify u ty (infer u env no locals row)
    ty
  | Sexp.list (Sexp.sym "match" :: scrut :: cases) =>
    let ts := infer u env scrut locals row
    let result := freshType u
    List.forEach cases (fun c =>
      match c with
      | Sexp.list [Sexp.sym "case", pat, body] =>
        let binds := pattern u env pat ts []
        unify u result (infer u env body (binds ++ locals) row)
      | Sexp.list [Sexp.sym "gcase", pat, guard, body] =>
        let binds := pattern u env pat ts []
        unify u bool (infer u env guard (binds ++ locals) row)
        unify u result (infer u env body (binds ++ locals) row)
      | _ => ())
    result
  | Sexp.list (Sexp.sym "handle" :: body :: clauses) => handler u env body clauses locals row
  | _ => freshType u

/-- An application `f a₁ … aₙ`. -/
def application (u : Unifier) (env : TypeEnv {r}) (f : Sexp) (args : List Sexp) (locals : List TType) (row : TRow) : {Throw Text | r} TType :=
  let tf := infer u env f locals row
  -- Bidirectional: when the callee's arrows are known, check plain arguments (they may bind the
  -- callee's row variables), link the rows to the context, then check lambdas against the
  -- parameter types so a callback runs in its caller's row.
  let rec peel t n acc :=
    if n == 0 then some (List.reverse acc, t)
    else
      match resolve u t with
      | TType.fn a r b => peel b (n - 1) ((a, r) :: acc)
      | _ => none
  match peel tf (List.length args) [] with
  | some (params, result) =>
    let pairs := List.zip params args
    let isLambda := fun (pair : ((TType, TRow), Sexp)) => Sexp.head (snd pair) == "lam"
    List.forEach (List.filter (fun pair => not (isLambda pair)) pairs) (fun pair => checkAgainst u env (snd pair) (fst (fst pair)) locals row)
    List.forEach params (fun pair => subRow u (snd pair) row)
    List.forEach (List.filter isLambda pairs) (fun pair => checkAgainst u env (snd pair) (fst (fst pair)) locals row)
    result
  | none =>
    List.foldl (fun acc arg =>
      let ta := infer u env arg locals row
      call u acc ta row) tf args

/-- Checks a term against an expected type; a lambda takes its parameter and row from it. -/
def checkAgainst (u : Unifier) (env : TypeEnv {r}) (t : Sexp) (expected : TType) (locals : List TType) (row : TRow) : {Throw Text | r} Unit :=
  match (t, resolve u expected) with
  | (Sexp.list [Sexp.sym "lam", b], TType.fn a r result) => checkAgainst u env b result (a :: locals) r
  | _ => unify u expected (infer u env t locals row)

/-- Applies a function type to an argument: the callee's effects must be contained in the context's. -/
def call (u : Unifier) (callee : TType) (arg : TType) (row : TRow) : {Throw Text} TType :=
  match resolve u callee with
  | TType.fn a r b =>
    unify u a arg
    subRow u r row
    b
  | other =>
    let result := freshType u
    unify u other (TType.fn arg row result)
    result

/--
  Row containment: every ability of `small` is in `big`. A row variable that is already the tail
  of `big` is contained (the context may do more); an unbound one becomes `big`.
-/
def subRow (u : Unifier) (small : TRow) (big : TRow) : {Throw Text} Unit :=
  match resolveRow u small with
  | TRow.empty => ()
  | TRow.extend l rest =>
    if sharedTailMissing u l rest big then rowMismatch u small big
    else
      match rewriteRow u big l with
      | (found, big2) =>
        unify u l found
        subRow u rest big2
  | TRow.var t => if rowTailIs u t big then () else unifyRow u (TRow.var t) big

/-- Binds a pattern against a type; returns the bound variables' types, innermost first. -/
def pattern (u : Unifier) (env : TypeEnv {r}) (pat : Sexp) (t : TType) (binds : List TType) : {Throw Text | r} List TType :=
  match pat with
  | Sexp.list [Sexp.sym "pany"] => binds
  | Sexp.list [Sexp.sym "pvar"] => t :: binds
  | Sexp.list [Sexp.sym "ann", ty, p] =>
    unify u t (signatureType u ty (Ref.new Map.empty) (Ref.new Map.empty))
    pattern u env p t binds
  | Sexp.list [Sexp.sym "pas", p] => pattern u env p t (t :: binds)
  | Sexp.list [Sexp.sym "pint", _] =>
    unify u t int
    binds
  | Sexp.list [Sexp.sym "ptext", _] =>
    unify u t text
    binds
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str ty :: Sexp.int tag :: subs) =>
    match ctorFields u env ty tag with
    | (result, fields) =>
      unify u t result
      -- An unknown constructor still binds every subpattern, or later variables would take earlier slots' types.
      let padded := fields ++ List.map (fun _ => freshType u) (List.drop (List.length fields) subs)
      List.foldl (fun acc pair => pattern u env (fst pair) (snd pair) acc) binds (List.zip subs padded)
  | _ => binds

/--
  A deep handler: the body runs with the handled abilities added to the outer row; each clause
  gets the operation's arguments and a continuation that returns the handler's result.
-/
def handler (u : Unifier) (env : TypeEnv {r}) (body : Sexp) (clauses : List Sexp) (locals : List TType) (row : TRow) : {Throw Text | r} TType :=
  let abilities := List.dedup (List.sort (List.filterMap (fun c =>
    match c with
    | Sexp.list (Sexp.sym "on" :: Sexp.str a :: _) => some a
    | _ => none) clauses))
  -- One instantiation of each handled ability's parameters, shared by its clauses.
  let labels := List.map (fun a =>
    match env.object a with
    | some (Sexp.list (Sexp.sym "ability" :: Sexp.str iri :: Sexp.int count :: _)) => (a, TType.con iri (List.map (fun _ => freshType u) (List.range 0 count)))
    | _ => (a, TType.con a [])) abilities
  let bodyRow := List.foldr (fun pair acc => TRow.extend (snd pair) acc) row labels
  let tb := infer u env body locals bodyRow
  let result := freshType u
  let hasReturn := List.any (fun c => Sexp.head c == "ret") clauses
  if hasReturn then () else unify u result tb
  List.forEach clauses (fun c =>
    match c with
    | Sexp.list [Sexp.sym "ret", rb] => unify u result (infer u env rb (tb :: locals) row)
    | Sexp.list [Sexp.sym "on", Sexp.str a, Sexp.int index, Sexp.int arity, hb] =>
      let params := match List.lookup a labels with
        | some (TType.con _ ps) => ps
        | _ => []
      let rec args t k acc :=
        match (resolve u t, k) with
        | (_, 0) => (List.reverse acc, t)
        | (TType.fn x _ y, _) => args y (k - 1) (x :: acc)
        | _ => (List.reverse acc, freshType u)
      match args (fst (opType u env a index params)) arity [] with
      | (argTypes, opResult) =>
        let k := TType.fn opResult row result
        unify u result (infer u env hb (k :: List.reverse argTypes ++ locals) row)
    | _ => ())
  result

--
-- Generalization and checking one group.
--

/-- Generalizes by printing: every remaining variable is quantified (top level has no free env). -/
def scheme (u : Unifier) (t : TType) : Sexp := typeToSexp (zonk u t)

def display (u : Unifier) (t : TType) : Text := showType (zonk u t) (Ref.new Map.empty) 0

/-- A written signature: arrows without braces constrain nothing; written rows are closed. -/
def signatureType (u : Unifier) (s : Sexp) (vars : Ref (Map Text TType)) (rowVars : Ref (Map Text TRow)) : TType :=
  match s with
  | Sexp.list [Sexp.sym "tfun", a, b] => TType.fn (signatureType u a vars rowVars) (freshRow u) (signatureType u b vars rowVars)
  | Sexp.list [Sexp.sym "tfun", a, b, Sexp.list (Sexp.sym "eff" :: effs)] =>
    TType.fn (signatureType u a vars rowVars) (signatureRow u effs vars rowVars) (signatureType u b vars rowVars)
  | Sexp.list (Sexp.sym "trow" :: effs) => TType.row (rowFromSexp u effs vars rowVars [] false)
  | Sexp.list (Sexp.sym "tapp" :: Sexp.list [Sexp.sym "tref", Sexp.str iri] :: args) => TType.con iri (List.map (fun x => signatureType u x vars rowVars) args)
  | _ => fromSexp u s vars rowVars [] true

/-- A written row: closed, unless it ends in a named tail (`{IO | r}`), which the signature shares. -/
def signatureRow (u : Unifier) (effs : List Sexp) (vars : Ref (Map Text TType)) (rowVars : Ref (Map Text TRow)) : TRow :=
  match effs with
  | [] => TRow.empty
  | [Sexp.list [Sexp.sym "tvar", Sexp.str name]] =>
    match Map.lookup name (Ref.get rowVars) with
    | some r => r
    | none =>
      let r := freshRow u
      Ref.set rowVars (Map.insert name r (Ref.get rowVars))
      r
  | e :: rest => TRow.extend (signatureType u e vars rowVars) (signatureRow u rest vars rowVars)

/--
  The signature's type and row variables must still be distinct variables: the definition is as
  general as declared, and performs no ability its written rows leave out.
-/
def checkRigid (u : Unifier) (vars : Ref (Map Text TType)) (rows : Ref (Map Text TRow)) : {Throw Text} Unit :=
  checkRigidTypes u vars
  let bound := List.map (fun pair => (fst pair, resolveRow u (snd pair))) (Map.toList (Ref.get rows))
  let ids := List.filterMap (fun pair =>
    match snd pair with
    | TRow.var id => some id
    | _ => none) bound
  match List.find (fun pair =>
    match snd pair with
    | TRow.var _ => false
    | _ => true) bound with
  | some (name, r) => throw ("ability row " ++ name ++ " is declared as the caller's but the body performs " ++ showRow (zonkRow u r) (Ref.new Map.empty))
  | none => if List.length (List.dedup (List.sort ids)) != List.length ids then throw "two ability rows of the signature must be the same row" else ()

def checkRigidTypes (u : Unifier) (vars : Ref (Map Text TType)) : {Throw Text} Unit :=
  let bound := List.map (fun pair => (fst pair, resolve u (snd pair))) (List.filter (fun pair => fst pair != "?") (Map.toList (Ref.get vars)))
  let ids := List.filterMap (fun pair =>
    match snd pair with
    | TType.var id => some id
    | _ => none) bound
  match List.find (fun pair =>
    match snd pair with
    | TType.var _ => false
    | _ => true) bound with
  | some (name, t) => throw ("type variable " ++ name ++ " is declared general but must be " ++ showType (zonk u t) (Ref.new Map.empty) 0)
  | none => if List.length (List.dedup (List.sort ids)) != List.length ids then throw "two type variables of the signature must be the same type" else ()

/-- Checks an inferred type against a written signature (variables must stay distinct). -/
def checkSignature (u : Unifier) (inferred : TType) (sig : Sexp) : {Throw Text} Unit :=
  let vars := Ref.new Map.empty
  let declared := signatureType u sig vars (Ref.new Map.empty)
  unify u inferred declared
  let bound := List.map (fun pair => resolve u (snd pair)) (List.filter (fun pair => fst pair != "?") (Map.toList (Ref.get vars)))
  let ids := List.filterMap (fun t =>
    match t with
    | TType.var id => some id
    | _ => none) bound
  if List.length ids != List.length bound || List.length (List.dedup (List.sort ids)) != List.length ids then
    throw ("does not have its declared type " ++ display u declared)
  else ()

/-- A stored scheme as text, e.g. `(a -> b) -> List a -> List b`. -/
def displayScheme (scheme : Sexp) : Text := displaySchemeNamed Map.empty scheme

/-- Each type's and ability's IRI, mapped to the last segment of its name in `ns`. -/
def declaredNames (ns : Map Text Entry) : Map Text Text :=
  Map.foldr (fun name e acc =>
    match e with
    | Entry.type _ iri _ => Map.insert iri (Names.lastSegment name) acc
    | Entry.ability _ iri => Map.insert iri (Names.lastSegment name) acc
    | _ => acc) Map.empty ns

/-- `displayScheme`, naming each type in `names` (from `declaredNames`) as it is named, not by its IRI. -/
def displaySchemeNamed (names : Map Text Text) (scheme : Sexp) : Text :=
  let u := newUnifier ()
  let t := zonk u (fromSexp u scheme (Ref.new Map.empty) (Ref.new Map.empty) [] false)
  -- A row variable that occurs once constrains nothing and is not printed; a shared one is.
  let shared := List.filter (fun pair => snd pair > 1) (Map.toList (rowVarCounts t Map.empty))
  showTypeWith names t (Ref.new Map.empty) 0 (Set.fromList (List.map fst shared))

def rowVarCounts (t : TType) (acc : Map Int Int) : Map Int Int :=
  match t with
  | TType.con _ args => List.foldl (fun m a => rowVarCounts a m) acc args
  | TType.fn a r b => rowVarCounts b (rowCounts r (rowVarCounts a acc))
  | TType.var _ => acc
  | TType.row r => rowCounts r acc

def rowCounts (r : TRow) (acc : Map Int Int) : Map Int Int :=
  match r with
  | TRow.extend l rest => rowCounts rest (rowVarCounts l acc)
  | TRow.var id => Map.update id (fun old => Option.getOr old 0 + 1) acc
  | TRow.empty => acc

/-- A type's name: as `names` declares it, else from its IRI. -/
def nameOf (names : Map Text Text) (iri : Text) : Text :=
  match Map.lookup iri names with
  | some name => name
  | none => iriName iri

def showTypeWith (names : Map Text Text) (t : TType) (seen : Ref (Map Text Text)) (prec : Int) (shared : Map Int Unit) : Text :=
  match t with
  | TType.var id => varName seen ("t" ++ Int.toText id) false
  | TType.con "#Pair" [a, b] => "(" ++ showTypeWith names a seen 0 shared ++ ", " ++ showTypeWith names b seen 0 shared ++ ")"
  | TType.con iri [] => nameOf names iri
  | TType.con iri args => Print.paren 90 prec (nameOf names iri ++ Text.concat (List.map (fun a => " " ++ showTypeWith names a seen 100 shared) args))
  | TType.fn a r b =>
    let rowText := showRowWith names r seen shared
    Print.paren 10 prec (showTypeWith names a seen 11 shared ++ " -> " ++ (if rowText == "" then "" else rowText ++ " ") ++ showTypeWith names b seen 10 shared)
  | TType.row r => rowArgument (showRow r seen) (resolveTail r) seen

def showRowWith (names : Map Text Text) (r : TRow) (seen : Ref (Map Text Text)) (shared : Map Int Unit) : Text :=
  let rec labels row acc :=
    match row with
    | TRow.extend l rest => labels rest (showTypeWith names l seen 0 shared :: acc)
    | TRow.var id => (List.reverse acc, if Set.contains id shared then some (varName seen ("r" ++ Int.toText id) true) else none, true)
    | TRow.empty => (List.reverse acc, none, false)
  match labels r [] with
  | ([], none, true) => ""
  | ([], none, false) => "{}"
  | ([], some tail, _) => "{" ++ tail ++ "}"
  | (ls, none, _) => "{" ++ Text.join ", " ls ++ "}"
  | (ls, some tail, _) => "{" ++ Text.join ", " ls ++ " | " ++ tail ++ "}"

end Types
