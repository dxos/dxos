/-
  Parser: tokens to declarations, with Lean's offside rule.

  `stop` is the offside column: a token that starts a line at or left of it ends the current
  expression. A body that starts on a new line is a block whose statements share a column.
  `ruleTable` holds the codebase's notations by namespace and `activeRules` the ones in scope here
  (Syntax.Spec R-3); `frames` saves the namespace and opens at each `namespace`.
-/
structure Parser where
  toks : Ref (List Token)
  stop : Ref Int
  notes : Ref (List Token)
  ruleTable : Map Text (List Loaded)
  activeRules : Ref (List Loaded)
  declaredRules : Ref (List Loaded)
  nsPath : Ref (List Text)
  opened : Ref (List Text)
  frames : Ref (List (List Text, List Text))
  closer : Ref Text

namespace Parser

def eofToken : Token := Token.mk Kind.eof "" 0 0 true ""

def peek (p : Parser) : Token :=
  match Ref.get p.toks with
  | t :: _ => t
  | [] => eofToken

def peekAt (p : Parser) (k : Int) : Token :=
  let rec go ts j :=
    match ts with
    | [] => eofToken
    | t :: [] => t
    | t :: rest => if j == 0 then t else go rest (j - 1)
  go (Ref.get p.toks) k

def next (p : Parser) : Token :=
  match Ref.get p.toks with
  | [] => eofToken
  | t :: [] => t
  | t :: rest =>
      Ref.set p.toks rest
      t

def skip (p : Parser) : Unit :=
  Parser.next p
  ()

def kindName : Kind -> Text
  | Kind.ident => "ident"
  | Kind.dot => "dot"
  | Kind.proj => "proj"
  | Kind.int => "int"
  | Kind.text => "text"
  | Kind.sym => "sym"
  | Kind.kw => "kw"
  | Kind.doc => "doc"
  | Kind.eof => "eof"
  | Kind.comment => "comment"

def errorAt (t : Token) (message : Text) : {Throw Text} a :=
  match t with
  | Token.mk kind value line col _ _ =>
    throw (Int.toText line ++ ":" ++ Int.toText col ++ ": " ++ message ++ " (at " ++ kindName kind ++ " " ++ show value ++ ")")

/-- A parse error at the next token. A `.` there is most often a decimal, which DEUS's raw text reads but its code does not. -/
def error (p : Parser) (message : Text) : {Throw Text} a :=
  let t := peek p
  errorAt t (if isTok t "." then message ++ "; a `.` alone is no DEUS syntax, and an Int has no fraction" else message)

def isKind (t : Token) (k : Kind) : Bool := t.kind == k

/-- A comment's lines with the indentation of its first line removed from the later ones. -/
def dedent (t : Token) : Text :=
  match Text.lines t.value with
  | [] => ""
  | first :: rest =>
    Text.join "\n" (first :: List.map (fun l =>
      let rec lead i := if i < t.col && i < Text.length l && Text.code l i == ' ' then lead (i + 1) else i
      Text.drop (lead 0) l) rest)

/-- The comments written before `line`, one per line, removed from the queue; none if there are none. -/
def notesBefore (p : Parser) (line : Int) : Option Text :=
  let rec split ts acc :=
    match ts with
    | t :: rest => if t.line < line then split rest (t :: acc) else (reverse acc, ts)
    | [] => (reverse acc, [])
  -- A blank line between two comments is kept, so separate paragraphs stay separate.
  let rec join ts previousEnd acc :=
    match ts with
    | [] => Text.concat (reverse acc)
    | t :: rest =>
        let gap := if previousEnd < 0 then "" else if t.line > previousEnd + 1 then "\n\n" else "\n"
        join rest (t.line + List.length (Text.lines t.value) - 1) (dedent t :: gap :: acc)
  match split (Ref.get p.notes) [] with
  | ([], _) => Option.none
  | (taken, rest) =>
      Ref.set p.notes rest
      Option.some (join taken (-1) [])

def noted (note : Option Text) (e : Expr) : Expr :=
  match note with
  | Option.some text => Expr.note text e
  | Option.none => e

def isTok (t : Token) (value : Text) : Bool := (t.kind == Kind.sym || t.kind == Kind.kw) && t.value == value

def is (p : Parser) (value : Text) : Bool := isTok (peek p) value

def expect (p : Parser) (value : Text) : {Throw Text} Token := if is p value then Parser.next p else Parser.error p ("expected '" ++ value ++ "'")

def ident (p : Parser) : {Throw Text} Text :=
  let t := peek p
  if t.kind == Kind.ident then
    skip p
    t.value
  else Parser.error p "expected identifier"

def offsideTok (p : Parser) (t : Token) : Bool := t.kind == Kind.eof || t.bol && t.col <= Ref.get p.stop

def offside (p : Parser) : Bool := offsideTok p (peek p)

def posOf (t : Token) : Pos := Pos.mk t.line t.col

/-- `body` with layout ended at column `col`, and no literal ending a term, as inside brackets. -/
def withStop (p : Parser) (col : Int) (body : Unit -> a) : a :=
  let saved := Ref.get p.stop
  let closer := Ref.get p.closer
  Ref.set p.stop col
  Ref.set p.closer ""
  let result := body ()
  Ref.set p.stop saved
  Ref.set p.closer closer
  result

/-- Binary operators: (precedence, right-associative?), Lean's table. -/
def binop (op : Text) : Option (Int, Bool) :=
  if op == "|>" then some (10, false)
  else if op == "<|" then some (10, true)
  else if op == "||" then some (30, true)
  else if op == "&&" then some (35, true)
  else if op == "==" || op == "!=" || op == "=" || op == "<" || op == "<=" || op == ">" || op == ">=" then some (50, false)
  else if op == "++" || op == "+" || op == "-" then some (65, false)
  else if op == "::" then some (67, true)
  else if op == "*" || op == "/" || op == "%" then some (70, false)
  else none

--
-- Declarations.
--
def file (p : Parser) : {Throw Text} List Decl :=
  let rec go acc :=
    let t := peek p
    let lead :=
      match notesBefore p (if t.kind == Kind.eof then t.line + 1 else t.line) with
      | Option.some text => [Decl.comment text]
      | Option.none => []
    if t.kind == Kind.eof then reverse (lead ++ acc) else
      let d := Parser.decl p
      track p d
      go (d :: lead ++ acc)
  go []

def attrs (p : Parser) : {Throw Text} List Attr := if is p "@[" then
  skip p
  let rec go acc := if is p "]" then
    skip p
    reverse acc
  else if (peek p).kind == Kind.eof then Parser.error p "unterminated attribute list" else
    let name := Parser.ident p
    let rec values vs := if is p "," || is p "]" then reverse vs else if (peek p).kind == Kind.eof then Parser.error p "unterminated attribute list" else values ((Parser.next p).value :: vs)
    let vs := values []
    if is p "," then skip p else ()
    go (Attr.mk name vs :: acc)
  go []
else []

def decl (p : Parser) : {Throw Text} Decl :=
  let doc := if (peek p).kind == Kind.doc then Option.some (Parser.next p).value else Option.none
  let attributes := attrs p
  let t := peek p
  if not t.bol || t.col != 0 then Parser.error p "declarations start at column 0" else
    let pos := posOf t
    let word := if t.kind == Kind.kw then t.value else ""
    if word == "def" then
      skip p
      let name := Parser.ident p
      let bs := Parser.binders p
      let type := if is p ":" then
        skip p
        Option.some (withStop p 0 (fun _ => Parser.ty p))
      else Option.none
      let after := peek p
      if is p "|" then Decl.defn name bs type Option.none (Option.some (Parser.arms p)) doc attributes pos else if after.kind == Kind.eof || after.bol && after.col == 0 then
        -- A declaration (D93): the signature must be complete, since nothing else gives the type.
        if isNone type then errorAt t ("declaration " ++ name ++ " has no body, so it needs a result type") else if any (fun b => isNone b.annot) bs then errorAt t ("declaration " ++ name ++ " has no body, so every parameter needs a type") else Decl.defn name bs type Option.none Option.none doc attributes pos
      else
        expect p ":="
        Decl.defn name bs type (Option.some (Parser.body p)) Option.none doc attributes pos
    else if word == "theorem" then
      skip p
      let name := Parser.ident p
      let bs := Parser.binders p
      expect p ":"
      -- `P -> Q -> R`: hypotheses then the conclusion.
      let rec props acc := if is p "->" then
        skip p
        props (Parser.expr p :: acc)
      else acc
      let reversed := props [Parser.expr p]
      let prop :=
        match reversed with
        | conclusion :: hyps => foldl (fun acc h => Expr.binop "->" h acc pos) conclusion hyps
        | [] => Expr.unit
      expect p ":="
      if is p "sorry" then
        skip p
        Decl.thm name bs prop ["sorry"] doc attributes pos
      else
        expect p "by"
        let rec tactic acc := if offside p then reverse acc else tactic ((Parser.next p).value :: acc)
        Decl.thm name bs prop (tactic []) doc attributes pos
    else if word == "test" then
      skip p
      let name := Parser.ident p
      expect p ":="
      Decl.check name (Parser.body p) doc attributes pos
    else if word == "inductive" then
      skip p
      let name := Parser.ident p
      let params := Parser.typeParams p
      let iri := iriOf p
      expect p "where"
      let rec ctors acc := if is p "|" then
        skip p
        -- Constructor names may be keywords (`true`, `prim`); qualified uses lex as identifiers.
        let ctorName := if (peek p).kind == Kind.kw then (Parser.next p).value else Parser.ident p
        let fields := withStop p 0 (fun _ => Parser.ctorFields p)
        ctors ((ctorName, fields) :: acc)
      else reverse acc
      Decl.data name params iri (ctors []) doc attributes pos
    else if word == "structure" || word == "ability" then
      skip p
      let name := Parser.ident p
      let params := Parser.typeParams p
      let iri := iriOf p
      expect p "where"
      let rec fields acc :=
        let f := peek p
        if f.bol && f.col > 0 && f.kind == Kind.ident then
          let fieldName := Parser.ident p
          expect p ":"
          let type := withStop p f.col (fun _ => Parser.ty p)
          fields ((fieldName, type) :: acc)
        else reverse acc
      let fs := fields []
      if word == "structure" then Decl.record name params iri fs doc attributes pos else Decl.effect name params iri fs doc attributes pos
    else if word == "namespace" then
      skip p
      Decl.ns (Parser.ident p)
    else if word == "end" then
      skip p
      let n := peek p
      if n.kind == Kind.ident && not n.bol then Decl.endNs (Option.some (Parser.ident p)) else Decl.endNs Option.none
    else if word == "open" then
      skip p
      let rec names acc :=
        let n := peek p
        if n.kind == Kind.ident && not n.bol then names (Parser.ident p :: acc) else reverse acc
      let all := names []
      if last? all == Option.some "in" then
        -- `open N in` opens N for the next declaration only (Syntax.Spec R-3).
        let opened := List.take (List.length all - 1) all
        let saved := Ref.get p.opened
        openAll p opened
        let inner := Parser.decl p
        Ref.set p.opened saved
        Parser.activate p
        Decl.scoped opened inner
      else Decl.openNs all
    else if word == "notation" then Parser.notationDecl p doc attributes pos else Parser.error p "expected a declaration"

/-- Whether the tokens from `k` are identifiers followed by `:`, as in a `(x y : T)` binder. -/
def namesThenColon (p : Parser) (k : Int) : Bool :=
  let t := peekAt p k
  isTok t ":" || t.kind == Kind.ident && Parser.namesThenColon p (k + 1)

/-- Constructor fields as (name, type): `(x : T)` binders, bare type atoms or a `: A -> B -> T` signature, which are unnamed (`""`). -/
def ctorFields (p : Parser) : {Throw Text} List (Text, Ty) :=
  let rec go acc := if offside p || is p "|" || is p ":" then reverse acc else if is p "(" && (peekAt p 1).kind == Kind.ident && namesThenColon p 2 then go (reverse (List.map (fun b =>
    match b.annot with
    | Option.some t => (b.binder, t)
    | Option.none => Parser.error p "constructor field needs a type") (Parser.binder p)) ++ acc) else go (("", tyAtom p) :: acc)
  let fields := go []
  if is p ":" then
    skip p
    let rec args t acc :=
      match t with
      | Ty.arrow a b _ => args b (("", a) :: acc)
      | _ => reverse acc
    fields ++ args (Parser.ty p) []
  else fields

def iriOf (p : Parser) : {Throw Text} Option Text := if is p "@" then
  skip p
  let t := Parser.next p
  if t.kind == Kind.text then Option.some t.value else errorAt t "expected IRI string"
else Option.none

def typeParams (p : Parser) : {Throw Text} List Text :=
  let rec go acc := if (peek p).kind == Kind.ident then go (Parser.ident p :: acc) else if is p "(" || is p "{" then go (reverse (List.map (fun b => b.binder) (Parser.binder p)) ++ acc) else reverse acc
  go []

def binders (p : Parser) : {Throw Text} List Binder :=
  let rec go acc := if (peek p).kind == Kind.ident then go (Binder.mk (Parser.ident p) Option.none :: acc) else if is p "(" then go (reverse (Parser.binder p) ++ acc) else if is p "{" then
    -- Implicit binders name type variables; they are erased.
    Parser.binder p
    go acc
  else reverse acc
  go []

/-- `(a b : T)` or `{a : T}`. -/
def binder (p : Parser) : {Throw Text} List Binder :=
  let close := if (Parser.next p).value == "(" then ")" else "}"
  let rec names acc := if (peek p).kind == Kind.ident then names (Parser.ident p :: acc) else reverse acc
  let ns := names []
  let type := if is p ":" then
    skip p
    Option.some (withStop p (-1) (fun _ => Parser.ty p))
  else Option.none
  expect p close
  List.map (fun n => Binder.mk n type) ns

--
-- Types.
--
def ty (p : Parser) : {Throw Text} Ty :=
  let a := tyApp p
  if is p "->" && not (offside p) then
    skip p
    let effects := if is p "{" then Option.some (Parser.row p) else Option.none
    Ty.arrow a (Parser.ty p) effects
  else a

/-- `{E₁, E₂ | r}`: abilities, then an optional row variable (the rest is open). -/
def row (p : Parser) : {Throw Text} List Ty :=
  expect p "{"
  let rec go acc := if is p "}" then
    skip p
    reverse acc
  else if (peek p).kind == Kind.eof then Parser.error p "expected '}'" else if is p "|" then
    skip p
    let tail := Ty.named (Parser.ident p) []
    expect p "}"
    reverse (tail :: acc)
  else
    let e := tyApp p
    if is p "," then skip p else ()
    go (e :: acc)
  go []

def tyApp (p : Parser) : {Throw Text} Ty :=
  let head := tyAtom p
  match head with
  | Ty.named name [] =>
      let rec go acc := if not (offside p) && ((peek p).kind == Kind.ident || is p "(") then go (tyAtom p :: acc) else if not (offside p) && is p "{" then go (Ty.row (Parser.row p) :: acc) else reverse acc
      let args := go []
      if List.isEmpty args then head else Ty.named name args
  | _ => head

def tyAtom (p : Parser) : {Throw Text} Ty := if (peek p).kind == Kind.ident then Ty.named (Parser.ident p) [] else if is p "{" then
  -- A result that performs abilities: `{IO, Throw Text} a`.
  let effs := Parser.row p
  Ty.effects effs (tyApp p)
else
  expect p "("
  if is p ")" then
    skip p
    Ty.unit
  else withStop p (-1) (fun _ =>
    let first := Parser.ty p
    if is p "," then
      let rec go acc := if is p "," then
        skip p
        go (Parser.ty p :: acc)
      else reverse acc
      let items := go [first]
      expect p ")"
      Ty.tuple items
    else
      expect p ")"
      first)

--
-- Expressions.
--
/-- A body: a block when it starts on a new line, else one expression. -/
def body (p : Parser) : {Throw Text} Expr :=
  let t := peek p
  if t.bol then if t.col <= Ref.get p.stop || t.kind == Kind.eof then Parser.error p "expected an indented body" else Parser.block p t.col else Parser.expr p

def block (p : Parser) (col : Int) : {Throw Text} Expr := withStop p col (fun _ => Parser.stmts p col)

def continues (p : Parser) (col : Int) : Bool := if is p ";" then
  skip p
  true
else
  let t := peek p
  t.bol && t.col == col && t.kind != Kind.eof

/-- Statements at column `col`: `let` lines and expressions; the last one is the value. -/
def stmts (p : Parser) (col : Int) : {Throw Text} Expr :=
  let note := notesBefore p (peek p).line
  noted note (statement p col)

def statement (p : Parser) (col : Int) : {Throw Text} Expr := if is p "let" then
  let letTok := Parser.next p
  let isRec := if is p "rec" then
    skip p
    true
  else false
  if (peek p).kind == Kind.ident && not (isTok (peekAt p 1) "@") && not (isTok (peekAt p 1) ":=") then
    let name := Parser.ident p
    let rec params acc := if is p ":=" || is p ":" then reverse acc else params (patAtom p :: acc)
    let ps := params []
    let result := if is p ":" then
      skip p
      Option.some (Parser.ty p)
    else Option.none
    expect p ":="
    let value := ascribed (Parser.body p) result
    if not (continues p col) then errorAt letTok "a let needs a body on the next line" else Expr.letFun name ps value (Parser.stmts p col) isRec
  else if isRec then Parser.error p "let rec needs a function" else
    let pat := patt p
    let annotation := if is p ":" then
      skip p
      Option.some (Parser.ty p)
    else Option.none
    expect p ":="
    let value := ascribed (Parser.body p) annotation
    if not (continues p col) then errorAt letTok "a let needs a body on the next line" else Expr.letPat pat value (Parser.stmts p col)
else
  let first := Parser.expr p
  if continues p col then Expr.seq first (Parser.stmts p col) else first

def expr (p : Parser) : {Throw Text} Expr := if is p "let" then Parser.stmts p (peek p).col else Parser.op p 0

def op (p : Parser) (min : Int) : {Throw Text} Expr :=
  let rec go left :=
    let t := peek p
    if offsideTok p t || atCloser p then left else
      match trailing p left min with
      | Option.some e => go e
      | Option.none => if t.kind != Kind.sym then left else
          match Parser.binop t.value with
          | Option.none => left
          | Option.some (prec, right) => if prec < min then left else
              skip p
              let r := Parser.op p (if right then prec else prec + 1)
              go (Expr.binop t.value left r (posOf t))
  go (unary p)

def unary (p : Parser) : {Throw Text} Expr := if is p "-" then
  skip p
  if (peek p).kind == Kind.int then
    match fromText (Parser.next p).value with
    | Option.some n => Expr.int (Int.neg n)
    | Option.none => Parser.error p "bad number"
  else Expr.neg (Parser.unary p)
else if is p "!" then
  skip p
  Expr.not (Parser.unary p)
else Parser.app p

def startsArg (p : Parser) : Bool :=
  let t := peek p
  if offsideTok p t then false else (t.kind == Kind.ident || t.kind == Kind.dot || t.kind == Kind.int || t.kind == Kind.text) || (if t.kind == Kind.kw then t.value == "true" || t.value == "false" || t.value == "prim" || t.value == "fun" || t.value == "do" else t.kind == Kind.sym && (t.value == "(" || t.value == "[" || t.value == "{"))

def app (p : Parser) : {Throw Text} Expr :=
  let f := atom p
  let rec go acc := if startsArg p then go (atom p :: acc) else reverse acc
  let args := go []
  if List.isEmpty args then f else Expr.app f args

/-- `e`, checked against the type a `let` writes (D95). -/
def ascribed (e : Expr) (annotation : Option Ty) : Expr :=
  match annotation with
  | Option.some t => Expr.ann e t
  | Option.none => e

def intOf (t : Token) : Int := Option.getOr (Int.fromText t.value) 0

/-- An integer literal, keeping how the source wrote it for `view` (it never reaches Core). -/
def intExpr (t : Token) : Expr := if Text.isEmpty t.spelling then Expr.int (intOf t) else Expr.spelled t.spelling (Expr.int (intOf t))

def intPat (t : Token) : Pat :=
  if Text.isEmpty t.spelling then Pat.int (intOf t) else Pat.spelled t.spelling (Pat.int (intOf t))

/-- An atom followed by any `(e).field` projections. -/
def atom (p : Parser) : {Throw Text} Expr :=
  let rec projections e :=
    let t := peek p
    if t.kind == Kind.proj then
      skip p
      projections (Expr.proj e t.value (posOf t))
    else e
  projections (atomBase p)

/-- An atom: a notation in scope that starts here (Syntax.Spec), else the built-in syntax. -/
def atomBase (p : Parser) : {Throw Text} Expr :=
  let leading := List.filter (fun r => not (isTrailing r.ruleCategory r.ruleParts)) (candidates p "term")
  if List.isEmpty leading then plainAtom p else if (peek p).kind == Kind.ident then
    -- A word a notation starts with is still a name where no notation reads it.
    let start := mark p
    match try (fun _ => firstOf p leading) with
    | Result.ok e => e
    | Result.err _ =>
        reset p start
        plainAtom p
  else firstOf p leading

def funExpr (p : Parser) : {Throw Text} Expr :=
  expect p "fun"
  if is p "|" then Expr.lamMatch (Parser.arms p) else
    let rec params acc := if is p "=>" then
      skip p
      reverse acc
    else params (patAtom p :: acc)
    let ps := params []
    Expr.lam ps (Parser.body p)

def ifExpr (p : Parser) : {Throw Text} Expr :=
  expect p "if"
  let cond := Parser.expr p
  expect p "then"
  let yes := Parser.body p
  expect p "else"
  Expr.ite cond yes (Parser.body p)

def matchExpr (p : Parser) : {Throw Text} Expr :=
  expect p "match"
  let rec scruts acc := if is p "," then
    skip p
    scruts (Parser.expr p :: acc)
  else reverse acc
  let ss := scruts [Parser.expr p]
  expect p "with"
  Expr.matchOn ss (Parser.arms p)

/-- Whether another arm follows: a `|` that is inline, or line-initial at the arms' column. -/
def moreArms (p : Parser) (col : Option Int) : Bool :=
  let t := peek p
  isTok t "|" && (not t.bol || col == Option.some t.col)

def armBody (p : Parser) (col : Option Int) : {Throw Text} Expr :=
  match col with
  | Option.none => Parser.body p
  | Option.some c => withStop p c (fun _ => Parser.body p)

def arms (p : Parser) : {Throw Text} List Arm :=
  let first := peek p
  let col := if first.bol then Option.some first.col else Option.none
  let rec go acc := if moreArms p col then
    let note := notesBefore p (peek p).line
    skip p
    let rec pats ps := if is p "," then
      skip p
      pats (patt p :: ps)
    else reverse ps
    let ps := pats [patt p]
    expect p "=>"
    go (Arm.mk ps (noted note (armBody p col)) :: acc)
  else reverse acc
  let result := go []
  if List.isEmpty result then Parser.error p "expected '|'" else result

def handleExpr (p : Parser) : {Throw Text} Expr :=
  expect p "handle"
  let b := Parser.body p
  expect p "with"
  let first := peek p
  let col := if first.bol then Option.some first.col else Option.none
  let rec go ret ops := if moreArms p col then
    let note := notesBefore p (peek p).line
    skip p
    if is p "return" then
      skip p
      let pat := patt p
      expect p "=>"
      go (Option.some (pat, armBody p col)) ops
    else
      let pos := posOf (peek p)
      let name := if (peek p).kind == Kind.dot then (Parser.next p).value else Parser.ident p
      let rec args acc := if is p "->" then
        skip p
        reverse acc
      else args (patAtom p :: acc)
      let ps := args []
      let k := if is p "_" then
        skip p
        Option.none
      else Option.some (Parser.ident p)
      expect p "=>"
      go ret (OpArm.mk name ps k (armBody p col) pos :: ops)
  else Expr.handleWith b ret (reverse ops)
  go Option.none []

--
-- Patterns.
--
def patt (p : Parser) : {Throw Text} Pat :=
  let head := patApp p
  if is p "::" then
    skip p
    Pat.cons head (Parser.patt p)
  else head

def startsPatAtom (p : Parser) : Bool :=
  let t := peek p
  t.kind == Kind.ident || t.kind == Kind.dot || t.kind == Kind.int || t.kind == Kind.text || is p "_" || is p "(" || is p "[" || is p "true" || is p "false" || is p "-"

def patApp (p : Parser) : {Throw Text} Pat :=
  let t := peek p
  if t.kind == Kind.ident && not (isTok (peekAt p 1) "@") || t.kind == Kind.dot then
    skip p
    let rec go acc := if startsPatAtom p && not (offside p) then go (patAtom p :: acc) else reverse acc
    let args := go []
    if t.kind == Kind.dot then Pat.dot t.value args (posOf t) else Pat.id t.value args (posOf t)
  else patAtom p

def patAtom (p : Parser) : {Throw Text} Pat :=
  let t := Parser.next p
  let pos := posOf t
  if t.kind == Kind.ident then if is p "@" then
    skip p
    Pat.as t.value (Parser.patAtom p)
  else Pat.id t.value [] pos else if t.kind == Kind.dot then Pat.dot t.value [] pos else if t.kind == Kind.int then intPat t else if t.kind == Kind.text then Pat.text t.value else if isTok t "true" then Pat.bool true else if isTok t "false" then Pat.bool false else if isTok t "_" then Pat.wild else if isTok t "-" then
    let number := Parser.next p
    if number.kind == Kind.int then Pat.int (Int.neg (intOf number)) else errorAt number "expected a number"
  else if isTok t "(" then if is p ")" then
    skip p
    Pat.unit
  else withStop p (-1) (fun _ =>
    let first := patt p
    -- `(x : T)`: an ascribed binder, checked (D95).
    let first1 := if is p ":" then
      skip p
      Pat.ann first (Parser.ty p)
    else first
    if is p "," then
      let rec go acc := if is p "," then
        skip p
        go (patt p :: acc)
      else reverse acc
      let items := go [first1]
      expect p ")"
      Pat.tuple items
    else
      expect p ")"
      first1) else if isTok t "[" then withStop p (-1) (fun _ =>
    let rec go acc := if is p "]" then
      skip p
      reverse acc
    else
      let item := patt p
      if not (is p "]") then
        expect p ","
        ()
      else ()
      go (item :: acc)
    Pat.list (go [])) else errorAt t "expected a pattern"

/-- Parses a whole source file. -/
def parse (source : Text) : {Throw Text} List Decl := parseWith Map.empty source

/-- The notations a source file declares, found without parsing the rest of it, so the other files
  of its batch can use them (Syntax.Spec R-3). -/
def notationsIn (source : Text) : {Throw Text} List Loaded :=
  let tokens := List.filter (fun t => t.kind != Kind.comment && t.kind != Kind.doc) (lex source)
  let rec walk ts path frames acc :=
    match ts with
    | [] => acc
    | t :: rest => if not (t.bol && t.col == 0) then walk rest path frames acc else if isTok t "namespace" then
        match rest with
        | n :: more => walk more (path ++ Text.split n.value ".") (path :: frames) acc
        | [] => acc
      else if isTok t "end" then
        match frames with
        | outer :: above => walk rest outer above acc
        | [] => walk rest path frames acc
      else if isTok t "notation" then
        let p := over Map.empty ts
        Ref.set p.nsPath path
        match try (fun _ => Parser.notationDecl p Option.none [] (posOf t)) with
        | _ => walk rest path frames (Ref.get p.declaredRules ++ acc)
      else walk rest path frames acc
  reverse (walk tokens [] [] [])

/-- Parses a whole source file; `table` holds the codebase's notations by namespace, for the file to
  open (Syntax.Spec R-3). -/
def parseWith (table : Map Text (List Loaded)) (source : Text) : {Throw Text} List Decl := Parser.file (over table (lex source))

/-- Follows `namespace`, `end` and `open`, which decide the notations in scope (Syntax.Spec R-3). -/
def track (p : Parser) (d : Decl) : Unit :=
  match d with
  | Decl.ns name =>
      Ref.set p.frames ((Ref.get p.nsPath, Ref.get p.opened) :: Ref.get p.frames)
      Ref.set p.nsPath (Ref.get p.nsPath ++ Text.split name ".")
      Parser.activate p
  | Decl.endNs _ =>
      match Ref.get p.frames with
      | (path, opened) :: rest =>
          Ref.set p.frames rest
          Ref.set p.nsPath path
          Ref.set p.opened opened
          Parser.activate p
      | [] => ()
  | Decl.openNs names => openAll p names
  | _ => ()

/-- Opens namespaces for notations; inside `namespace A`, `open X` may also mean `A.X`. -/
def openAll (p : Parser) (names : List Text) : Unit :=
  let here := Ref.get p.nsPath
  let full := concatMap (fun n => if List.isEmpty here then [n] else [n, join "." (here ++ [n])]) names
  Ref.set p.opened (Ref.get p.opened ++ full)
  Parser.activate p

/-- The notations in scope: those of this file and of the table whose namespace is this one, encloses
  it, or is open. The file's own notation wins over the codebase's of the same name. -/
def activate (p : Parser) : Unit :=
  let here := join "." (Ref.get p.nsPath)
  let opened := Ref.get p.opened
  let visible := fun home => home == "" || home == here || startsWith (home ++ ".") here || List.contains home opened
  let mine := List.filter (fun r => visible (documentOf r.ruleName)) (Ref.get p.declaredRules)
  let names := List.map (fun r => r.ruleName) mine
  let theirs := concatMap
    (fun pair => if visible (fst pair) then List.filter (fun r => not (List.contains r.ruleName names)) (snd pair) else [])
    (Map.toList p.ruleTable)
  Ref.set p.activeRules (mine ++ theirs)

/-- `notation Name [: category [precedence]] := parts => expansion`: a term definition of
  `Syntax.Notation.mk`, active from here on (Syntax.Spec). -/
def notationDecl (p : Parser) (doc : Option Text) (attributes : List Attr) (pos : Pos) : {Throw Text} Decl :=
  let start := peek p
  expect p "notation"
  let name := Parser.ident p
  let category := if is p ":" then
    skip p
    Parser.ident p
  else "term"
  let prec := if (peek p).kind == Kind.int then intOf (Parser.next p) else 65
  expect p ":="
  let holes := Ref.new []
  let rec parts acc :=
    let t := peek p
    if isTok t "=>" then reverse acc else if t.kind == Kind.text then
      skip p
      if List.isEmpty (tokensOf t.value) then errorAt t "a notation's literal must be text the lexer reads" else parts (Part.lit t.value :: acc)
    else if t.kind == Kind.ident then
      skip p
      let known := findIndex (fun n => n == t.value) (Ref.get holes)
      if known >= 0 then if is p ":" then errorAt t ("hole " ++ t.value ++ " is named twice") else parts (Part.again known :: acc) else
        let index := List.length (Ref.get holes)
        Ref.set holes (Ref.get holes ++ [t.value])
        let kind := if is p ":" then
          skip p
          let c := peek p
          if c.kind == Kind.int then
            skip p
            ("term", intOf c)
          else (Parser.ident p, -1)
        else ("term", -1)
        let repeat := if is p "*" then
          skip p
          "*"
        else if is p "," && isTok (peekAt p 1) "*" then
          skip p
          skip p
          ",*"
        else ""
        parts (Part.hole index (fst kind) (snd kind) repeat :: acc)
    else errorAt t "expected a literal, a hole or '=>'"
  let written := withPrecedences category prec (parts [])
  match problemOf category written with
  | Option.some problem => errorAt start ("notation " ++ name ++ ": " ++ problem)
  | Option.none => ()
  expect p "=>"
  let fqn := join "." (Ref.get p.nsPath ++ [name])
  Ref.set
    p.declaredRules
    (Loaded.mk ("@" ++ fqn) fqn category prec written Option.none :: Ref.get p.declaredRules)
  Parser.activate p
  let body := Parser.body p
  let call := fun f args => Expr.app (Expr.var f pos) args
  let partExpr := fun part =>
    match part with
    | Part.lit text => call "Syntax.Part.lit" [Expr.text text]
    | Part.hole i c n repeat => call "Syntax.Part.hole" [Expr.int i, Expr.text c, Expr.int n, Expr.text repeat]
    | Part.again i => call "Syntax.Part.again" [Expr.int i]
  let expansion := if List.isEmpty (Ref.get holes) then body else Expr.lam (List.map (fun n => Pat.id n [] pos) (Ref.get holes)) body
  Decl.defn name [] Option.none (Option.some (call
    "Syntax.Notation.mk"
    [Expr.text category, Expr.int prec, Expr.list (List.map partExpr written), expansion])) Option.none doc (attributes ++ [Attr.mk "syntax" []]) pos

/-- Whether the next tokens are the literal that ends the term being read. -/
def atCloser (p : Parser) : Bool :=
  let text := Ref.get p.closer
  text != "" && looksAt p text

/-- A trailing notation after `left`: the first that reads, of those at precedence `min` or above whose
  literal comes next; none when none does, so the built-in operators get their turn. -/
def trailing (p : Parser) (left : Expr) (min : Int) : {Throw Text} Option Expr :=
  let active := Ref.get p.activeRules
  if List.isEmpty active then Option.none else
    let rules := List.filter
      (fun r => r.ruleCategory == "term" && r.rulePrec >= min && isTrailing r.ruleCategory r.ruleParts && looksAt p (trailingLiteral r.ruleParts))
      active
    let start := mark p
    let rec go rest :=
      match rest with
      | [] => Option.none
      | r :: more =>
          match try (fun _ => parseRule p r (Option.some left)) with
          | Result.ok e => Option.some e
          | Result.err _ =>
              reset p start
              go more
    go (Syntax.ordered rules)

/-- The notations of category `c` in scope that may start at the next token: those with the longest
  literal prefix first, then by name. -/
def candidates (p : Parser) (c : Text) : List Loaded :=
  let active := Ref.get p.activeRules
  if List.isEmpty active then [] else
    let t := peek p
    Syntax.ordered (List.filter (fun r => r.ruleCategory == c && mayStart active r.ruleParts t 4) active)

/-- An atom in the built-in syntax. -/
def plainAtom (p : Parser) : {Throw Text} Expr :=
  let t := peek p
  let pos := posOf t
  if t.kind == Kind.ident then
    skip p
    Expr.var t.value pos
  else if t.kind == Kind.dot then
    skip p
    Expr.dot t.value pos
  else if t.kind == Kind.int then
    skip p
    intExpr t
  else if t.kind == Kind.text then
    skip p
    Expr.text t.value
  else if t.kind == Kind.kw then if t.value == "true" || t.value == "false" then
    skip p
    Expr.bool (t.value == "true")
  else if t.value == "prim" then
    skip p
    let name := Parser.next p
    if name.kind == Kind.text then Expr.prim name.value else errorAt name "expected primitive name"
  else if t.value == "fun" then funExpr p else if t.value == "if" then ifExpr p else if t.value == "match" then matchExpr p else if t.value == "handle" then Parser.handleExpr p else if t.value == "do" then
    skip p
    Parser.body p
  else if t.value == "let" then Parser.stmts p t.col else Parser.error p "expected an expression" else if isTok t "(" then
    skip p
    if is p ")" then
      skip p
      Expr.unit
    else withStop p (-1) (fun _ =>
      let first := Parser.expr p
      if is p ":" then
        skip p
        let type := Parser.ty p
        expect p ")"
        Expr.ann first type
      else if is p "," then
        let rec go acc := if is p "," then
          skip p
          go (Parser.expr p :: acc)
        else reverse acc
        let items := go [first]
        expect p ")"
        Expr.tuple items
      else
        expect p ")"
        first)
  else if isTok t "[" then
    skip p
    withStop p (-1) (fun _ =>
      let rec go acc := if is p "]" then
        skip p
        reverse acc
      else
        let item := Parser.expr p
        if not (is p "]") then
          expect p ","
          ()
        else ()
        go (item :: acc)
      Expr.list (go []))
  else if isTok t "{" then
    skip p
    withStop p (-1) (fun _ =>
      let base := if (peek p).kind == Kind.ident && isTok (peekAt p 1) ":=" then Option.none else
        let b := Parser.expr p
        expect p "with"
        Option.some b
      let rec fields acc := if is p "}" then
        skip p
        reverse acc
      else
        let name := Parser.ident p
        expect p ":="
        let value := Parser.expr p
        if not (is p "}") then
          expect p ","
          ()
        else ()
        fields ((name, value) :: acc)
      Expr.record base (fields []) pos)
  else Parser.error p "expected an expression"

/-- Where the parser is, to undo a notation that did not read. -/
def mark (p : Parser) : (List Token, (Int, (List Token, Text))) := (Ref.get p.toks, Ref.get p.stop, Ref.get p.notes, Ref.get p.closer)

/-- The first of `rules` that reads the next tokens; when none does, the error of the one that read furthest. -/
def firstOf (p : Parser) (rules : List Loaded) : {Throw Text} Expr :=
  let start := mark p
  let rec go rest reached message :=
    match rest with
    | [] => Throw.throw message
    | r :: more =>
        match try (fun _ => parseRule p r Option.none) with
        | Result.ok e => e
        | Result.err problem =>
            let here := position p
            reset p start
            if here > reached then go more here problem else go more reached message
  go rules (-1) "expected a notation"

def reset (p : Parser) (at : (List Token, (Int, (List Token, Text)))) : Unit :=
  let (toks, stop, notes, closer) := at
  Ref.set p.toks toks
  Ref.set p.stop stop
  Ref.set p.notes notes
  Ref.set p.closer closer

/-- A parser over `tokens`, with the notations of `table` to open. -/
def over (table : Map Text (List Loaded)) (tokens : List Token) : Parser := Parser.mk
  (Ref.new (List.filter (fun t => t.kind != Kind.comment) tokens))
  (Ref.new 0)
  (Ref.new (List.filter (fun t => t.kind == Kind.comment) tokens))
  table
  (Ref.new [])
  (Ref.new [])
  (Ref.new [])
  (Ref.new [])
  (Ref.new [])
  (Ref.new "")

/-- Whether the next tokens are those of literal `text`. -/
def looksAt (p : Parser) (text : Text) : Bool :=
  let tokens := tokensOf text
  not (List.isEmpty tokens) && List.all
    (fun pair => sameToken (snd pair) (peekAt p (fst pair)))
    (mapIndexed (fun i t => (i, t)) tokens)

/-- One use of notation `r` (whose first hole is `left` for a trailing rule): the expansion's
  arguments, one per hole. -/
def parseRule (p : Parser) (r : Loaded) (left : Option Expr) : {Throw Text} Expr :=
  let bound := Ref.new Map.empty
  let parts :=
    match (left, r.ruleParts) with
    | (Option.some e, Part.hole i _ _ _ :: rest) =>
        Ref.set bound (Map.insert i e Map.empty)
        rest
    | _ => r.ruleParts
  readParts p r.ruleParts parts bound
  let args := List.map
    (fun i => getOr (Map.lookup i (Ref.get bound)) Expr.unit)
    (range 0 (holeCount r.ruleParts))
  Expr.notation r.ruleKey r.ruleTemplate args

/-- Whether a notation reading `parts` may start at token `t`, following categories `depth` deep. -/
def mayStart (active : List Loaded) (parts : List Part) (t : Token) (depth : Int) : Bool :=
  match parts with
  | Part.lit text :: _ =>
      match head? (tokensOf text) with
      | Option.some first => sameToken first t
      | Option.none => false
  | Part.hole _ c _ repeat :: rest =>
      let here := if c == "term" then t.kind != Kind.eof else if c == "name" || c == "ident" then t.kind == Kind.ident else if c == "str" then t.kind == Kind.text else if c == "num" then t.kind == Kind.int else if c == "raw" then startsRaw t else depth > 0 && any (fun r => r.ruleCategory == c && Parser.mayStart active r.ruleParts t (depth - 1)) active
      -- A repetition may read nothing, so what follows it may start the notation too.
      here || repeat != "" && Parser.mayStart active rest t depth
  | _ => false

/-- How far the parser has read, to report the alternative that read furthest. -/
def position (p : Parser) : Int :=
  let t := peek p
  t.line * 100000 + t.col

/-- Reads `parts` of a notation whose parts are `all`, binding its holes. -/
def readParts (p : Parser) (all : List Part) (parts : List Part) (bound : Ref (Map Int Expr)) : {Throw Text} Unit :=
  match parts with
  | [] => ()
  | part :: rest =>
      let closer :=
        match rest with
        | Part.lit text :: _ => Option.some text
        | _ => Option.none
      match part with
      | Part.lit text => Parser.literal p text
      | Part.hole i c prec repeat =>
          let one := fun _ => holeValue p c prec closer
          let value := if repeat == "" then one () else Expr.list (repeated p c closer (repeat == ",*") one)
          Ref.set bound (Map.insert i value (Ref.get bound))
      | Part.again i =>
          let t := peek p
          let first := getOr (Map.lookup i (Ref.get bound)) Expr.unit
          let value := holeValue p (holeCategory all i) 0 closer
          if Syntax.wordsOf value == Syntax.wordsOf first then () else errorAt t ("expected " ++ Syntax.wordsOf first ++ " to match the one before")
      Parser.readParts p all rest bound

/-- Reads literal text token by token (`"</"` is `<` then `/`), wherever layout puts the tokens. -/
def literal (p : Parser) (text : Text) : {Throw Text} Unit := forEach
  (tokensOf text)
  (fun want => if sameToken want (peek p) then skip p else Parser.error p ("expected '" ++ trim text ++ "'"))

/-- One value of a hole of category `c`. A hole a literal follows is delimited: layout does not end it. -/
def holeValue (p : Parser) (c : Text) (prec : Int) (closer : Option Text) : {Throw Text} Expr :=
  let t := peek p
  if c == "term" then
    let read := fun _ => if prec <= 0 then Parser.expr p else Parser.op p prec
    match closer with
    | Option.some text => withStop p (-1) (fun _ =>
        -- An operator that starts the literal after the hole ends the term (`<<a, b>>`).
        Ref.set p.closer text
        read ())
    | Option.none => read ()
  else if c == "name" || c == "ident" then if t.kind != Kind.ident then Parser.error p "expected a name" else
    skip p
    if c == "name" then Expr.text t.value else Expr.var t.value (posOf t) else if c == "str" then if t.kind != Kind.text then Parser.error p "expected a text literal" else
    skip p
    Expr.text t.value else if c == "num" then if t.kind != Kind.int then Parser.error p "expected a number" else
    skip p
    intExpr t else if c == "raw" then Parser.rawText p else
    let rules := candidates p c
    if List.isEmpty rules then Parser.error p ("expected " ++ c) else firstOf p rules

/-- Whether `t` ends markup text: `<`, `{`, `}` or the end of the file (`a <= b` stays text). -/
def endsRaw (t : Token) : Bool := t.kind == Kind.eof || t.kind == Kind.sym && (t.value == "<" || t.value == "{" || t.value == "}")

/-- Whether markup text may start at `t`: a text literal is the `str` hole's (Syntax.Spec R-11). -/
def startsRaw (t : Token) : Bool := not (endsRaw t) && t.kind != Kind.text

/-- How `t` was written, near enough to rebuild the text between tokens. -/
def written (t : Token) : Text := if t.kind == Kind.text then Print.quoteText t.value else if t.kind == Kind.dot || t.kind == Kind.proj then "." ++ t.value else if t.spelling != "" then t.spelling else t.value

/-- A `raw` hole: the markup text up to the next `<`, `{` or `}`, rebuilt from the tokens' places, with each run of
  whitespace read as one space (Syntax.Spec R-11). -/
def rawText (p : Parser) : {Throw Text} Expr := if not (startsRaw (peek p)) then Parser.error p "expected text" else
  let rec go acc (prev : Token) :=
    let t := peek p
    if endsRaw t then acc else
      skip p
      let gap := t.line != prev.line || t.col > prev.col + Text.length (written prev)
      go (acc ++ (if gap then " " else "") ++ written t) t
  let first := peek p
  skip p
  let text := go (written first) first
  let last := peek p
  -- The lexer took `--` or `/-` as a comment, which would drop the rest of the line from the text.
  let before := fun (a : Token) (b : Token) => a.line < b.line || a.line == b.line && a.col < b.col
  if any (fun c => before first c && (last.kind == Kind.eof || before c last)) (Ref.get p.notes) then errorAt first "text between tags cannot hold `--` or `/-`, which start a comment: write that text as a text literal" else
    Expr.text text

/-- Values of a repeated hole, until the literal after it (`closer`) comes or nothing of the category
  can start; with commas between them for `,*`. -/
def repeated (p : Parser) (c : Text) (closer : Option Text) (commas : Bool) (one : Unit -> {Throw Text} Expr) : {Throw Text} List Expr :=
  let rec go acc :=
    let t := peek p
    let ends :=
      match closer with
      | Option.some text => looksAt p text
      | Option.none => offsideTok p t
    if ends || not (mayStart (Ref.get p.activeRules) [Part.hole 0 c 0 ""] t 4) then reverse acc else
      let before := position p
      let value := one ()
      if position p == before then reverse (value :: acc) else if not commas then go (value :: acc) else if is p "," then
        skip p
        go (value :: acc)
      else reverse (value :: acc)
  go []

end Parser
