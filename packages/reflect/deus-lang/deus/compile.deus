/-
  Batch compilation: parsed files plus a base namespace to hashed objects and new names.
-/

/-- A declaration together with where it was written. -/
structure Item where
  decl : Decl
  fqn : Text
  declScope : Scope
  path : Text

namespace Compile

def s (t : Text) : Sexp := Sexp.str t

def n (k : Int) : Sexp := Sexp.int k

def node (head : Text) (items : List Sexp) : Sexp := Sexp.node head items

def declName : Decl -> Text
  | Decl.defn name _ _ _ _ _ _ _ => name
  | Decl.thm name _ _ _ _ _ _ => name
  | Decl.check name _ _ _ _ => name
  | Decl.data name _ _ _ _ _ => name
  | Decl.record name _ _ _ _ _ => name
  | Decl.effect name _ _ _ _ _ => name
  | _ => ""

/-- Flattens files into items, tracking `namespace`/`end`/`open`. `Option` is always open (D16). -/
def collect (files : List (Text, List Decl)) : List Item :=
  let rec walk path decls ns opens acc :=
    match decls with
    | [] => acc
    | d :: rest =>
      match d with
      | Decl.ns name => walk path rest (ns ++ Text.split name ".") ([] :: opens) acc
      | Decl.endNs name =>
        let count := match name with
          | some x => List.length (Text.split x ".")
          | none => 1
        walk path rest (List.take (List.length ns - count) ns) (List.drop 1 opens) acc
      | Decl.openNs names =>
        match opens with
        | top :: above => walk path rest ns ((top ++ names) :: above) acc
        | [] => walk path rest ns [names] acc
      | _ =>
        let fqn := Names.joinName ns (declName d)
        walk path rest ns opens (Item.mk d fqn (Scope.mk ns (List.concat (List.reverse opens))) path :: acc)
  List.reverse (List.foldl (fun acc file =>
    match file with
    | (path, decls) => walk path decls [] [["Option"]] acc) [] files)

/-- The namespace a definition's body resolves in: its own name's prefix (Lean's rule). -/
def bodyScope (item : Item) : Scope :=
  let segments := Text.split item.fqn "."
  Scope.mk (List.take (List.length segments - 1) segments) item.declScope.opens

/-- The type form that is hashed: IRI, arity, and constructor shapes with field types by IRI. -/
def typeForm (names : Names) (item : Item) (iri : Text) (params : List Text) (ctors : List (List Ty)) : {Throw Text} Sexp :=
  let scope := bodyScope item
  node "type" ([s iri, n (List.length params)] ++ List.map (fun fields => node "ctor" (n (List.length fields) :: List.map (fun t => Resolve.tyCore names scope params t) fields)) ctors)

def accessorCore (hash : Text) (count : Int) (index : Int) : Sexp :=
  node "lam" [node "match" [node "var" [n 0], node "case" [node "pcon" ([s hash, n 0] ++ List.replicate count (node "pvar" [])), node "var" [n (count - 1 - index)]]]]

/-- Signature of a definition: binder types then the result type. -/
def signature (names : Names) (scope : Scope) (binders : List Binder) (result : Option Ty) : {Throw Text} Sexp :=
  let unknown := node "tvar" [s "?"]
  let resultCore := match result with
    | some t => Resolve.tyCore names scope [] t
    | none => unknown
  -- `(x : A) : {E} B` puts the row on the last arrow.
  let attach := fun (inner : Sexp) =>
    match inner with
    | Sexp.list [Sexp.sym "teff", effs, t] => (t, [effs])
    | _ => (inner, [])
  match attach resultCore with
  | (resultPlain, row) =>
    let count := List.length binders
    List.foldr (fun pair acc =>
      match pair with
      | (i, b) =>
        let a := match b.annot with
          | some t => Resolve.tyCore names scope [] t
          | none => unknown
        node "tfun" ([a, acc] ++ (if i == count - 1 then row else []))) (if count == 0 then resultCore else resultPlain) (List.mapIndexed (fun i b => (i, b)) binders)

def metaForm (doc : Option Text) (sig : Option Sexp) (locals : List Text) (attrs : List Attr) : Sexp :=
  let docPart := match doc with
    | some d => [node "doc" [s d]]
    | none => []
  let sigPart := match sig with
    | some t => [node "sig" [t]]
    | none => []
  let localsPart := if List.isEmpty locals then [] else [node "locals" (List.map s locals)]
  let attrsPart := if List.isEmpty attrs then [] else [node "attrs" (List.map (fun a => Sexp.list (s a.attr :: List.map s a.values)) attrs)]
  node "meta" (sigPart ++ docPart ++ localsPart ++ attrsPart)

/-- Proof tokens; lemma names inside `[…]` become references, so a proof's hash covers its lemmas. -/
def proofTokens (names : Names) (scope : Scope) (tokens : List Text) : {Throw Text} List Sexp :=
  let isLemma := fun (e : Entry) =>
    match e with
    | Entry.theorem _ => true
    | _ => false
  let rec go rest inside acc :=
    match rest with
    | [] => List.reverse acc
    | t :: more =>
      if t == "[" then go more true (s t :: acc)
      else if t == "]" then go more false (s t :: acc)
      else if inside && t != "," then
        match Names.lookup names t scope isLemma true with
        | some (_, e) => go more inside (node "ref" [s (Entry.hash e)] :: acc)
        | none => throw ("unknown lemma " ++ t)
      else go more inside (s t :: acc)
  go tokens false []

/-- Placeholder references `(ref "@Name")` in a form. -/
def placeholders (form : Sexp) (acc : List Text) : List Text :=
  match form with
  | Sexp.list [Sexp.sym "ref", Sexp.str h] => if Text.startsWith "@" h then Text.drop 1 h :: acc else acc
  | Sexp.list items => List.foldl (fun a x => placeholders x a) acc items
  | _ => acc

/-- Replaces placeholders: members of the current cycle by `self` (or `(self i)`), others by hash. -/
def substitute (form : Sexp) (hashes : Map Text Text) (cycle : Map Text Int) (anonymous : Bool) : Sexp :=
  match form with
  | Sexp.list [Sexp.sym "ref", Sexp.str h] =>
    if Text.startsWith "@" h then
      let name := Text.drop 1 h
      match Map.lookup name cycle with
      | some i => if anonymous then node "self" [] else node "self" [n i]
      | none =>
        match Map.lookup name hashes with
        | some hash => node "ref" [s hash]
        | none => defect ("unhashed dependency " ++ name)
    else form
  | Sexp.list items => Sexp.list (List.map (fun x => substitute x hashes cycle anonymous) items)
  | _ => form

/-- Replaces `(self i)` by references to the cycle's member hashes. -/
def unself (form : Sexp) (members : List Text) : Sexp :=
  match form with
  | Sexp.list [Sexp.sym "self", Sexp.int i] => node "ref" [s (Option.getOr (List.get? members i) "")]
  | Sexp.list items => Sexp.list (List.map (fun x => unself x members) items)
  | _ => form

/-- Tarjan's strongly connected components, emitted dependencies first. -/
def components (nodes : List Text) (deps : Text -> List Text) : List (List Text) :=
  let index := Ref.new Map.empty
  let low := Ref.new Map.empty
  let onStack := Ref.new Map.empty
  let stack := Ref.new []
  let counter := Ref.new 0
  let out := Ref.new []
  let rec visit v :=
    let i := Ref.get counter
    Ref.set counter (i + 1)
    Ref.set index (Map.insert v i (Ref.get index))
    Ref.set low (Map.insert v i (Ref.get low))
    Ref.set stack (v :: Ref.get stack)
    Ref.set onStack (Map.insert v () (Ref.get onStack))
    List.forEach (deps v) (fun w =>
      match Map.lookup w (Ref.get index) with
      | none =>
        visit w
        Ref.set low (Map.insert v (min (Option.getOr (Map.lookup v (Ref.get low)) 0) (Option.getOr (Map.lookup w (Ref.get low)) 0)) (Ref.get low))
      | some wi =>
        if Map.contains w (Ref.get onStack) then Ref.set low (Map.insert v (min (Option.getOr (Map.lookup v (Ref.get low)) 0) wi) (Ref.get low))
        else ())
    if Map.lookup v (Ref.get low) == Map.lookup v (Ref.get index) then
      let rec pop acc :=
        match Ref.get stack with
        | w :: rest =>
          Ref.set stack rest
          Ref.set onStack (Map.remove w (Ref.get onStack))
          if w == v then w :: acc else pop (w :: acc)
        | [] => acc
      Ref.set out (pop [] :: Ref.get out)
    else ()
  List.forEach nodes (fun v => if Map.contains v (Ref.get index) then () else visit v)
  List.reverse (Ref.get out)

/-- A term-like definition awaiting its hash. -/
structure Pending where
  name : Text
  wrap : Text
  core : Sexp

/-- Wraps Core in its object form: `(term c)`, `(test c)`, or a theorem's full form. -/
def objectOf (p : Pending) (core : Sexp) : Sexp := if p.wrap == "theorem" then core else node p.wrap [core]

/-- The form whose references are hashed: a theorem's whole form, so its proof's lemmas count. -/
def coreOf (p : Pending) : Sexp := p.core

/-- Each pending definition's references to others in the batch, sorted; computed once per batch. -/
def dependencies (byName : Map Text Pending) : Map Text (List Text) :=
  Map.fromList (List.map (fun pair =>
    (fst pair, List.dedup (List.sort (List.filter (fun d => Map.contains d byName) (placeholders (coreOf (snd pair)) []))))) (Map.toList byName))

/-- Hashes term-like definitions in dependency order; returns name to hash and the objects. -/
def hashTerms (pending : List Pending) (known : Map Text Text) : (Map Text Text, List (Text, Sexp)) :=
  let byName := Map.fromList (List.map (fun p => (p.name, p)) pending)
  let depMap := dependencies byName
  let deps := fun name => Option.getOr (Map.lookup name depMap) []
  let groups := components (List.sort (Map.keys byName)) deps
  List.foldl (fun state group =>
    match state with
    | (hashes, objects) =>
      let members := List.filterMap (fun name => Map.lookup name byName) group
      let selfRef := fun p => List.any (fun d => List.contains d group) (deps p.name)
      match members with
      | [p] =>
        if not (selfRef p) then
          let core := substitute (coreOf p) hashes Map.empty false
          let obj := objectOf p core
          let h := Text.sha256 (Sexp.print obj)
          (Map.insert p.name h hashes, (h, obj) :: objects)
        else hashCycle members hashes objects
      | _ => hashCycle members hashes objects) (known, []) groups

/-- A recursive group: members are ordered by the hash of their shape with in-cycle references anonymized. -/
def hashCycle (members : List Pending) (hashes : Map Text Text) (objects : List (Text, Sexp)) : (Map Text Text, List (Text, Sexp)) :=
  let anonymousCycle := Map.fromList (List.map (fun p => (p.name, 0)) members)
  let keyed := List.map (fun p => (Text.sha256 (Sexp.print (objectOf p (substitute (coreOf p) hashes anonymousCycle true))), p)) members
  let ordered := List.map snd (List.sortBy (fun a b => compare (fst a) (fst b)) keyed)
  let cycle := Map.fromList (List.mapIndexed (fun i p => (p.name, i)) ordered)
  let forms := List.map (fun p => objectOf p (substitute (coreOf p) hashes cycle false)) ordered
  let cycleHash := Text.sha256 (Sexp.print (node "cycle" forms))
  let count := List.length ordered
  let memberHashes := List.mapIndexed (fun i _ => if count == 1 then cycleHash else cycleHash ++ "." ++ Int.toText i) ordered
  let named := List.foldl (fun m pair =>
    match pair with
    | (p, h) => Map.insert p.name h m) hashes (List.zip ordered memberHashes)
  let objs := List.map (fun pair =>
    match pair with
    | (form, h) => (h, unself form memberHashes)) (List.zip forms memberHashes)
  (named, List.reverse objs ++ objects)

/-- Compiles parsed files against a base namespace. Batch names shadow base names. -/
def batch (base : Map Text Entry) (store : Text -> {Throw Text | r} Option Sexp) (storeMeta : Text -> {Throw Text | r} Option Sexp) (typeMode : Text) (files : List (Text, List Decl)) : {Throw Text | r} Batch :=
  let items := collect files
  -- Duplicate names within the batch are an error; shadowing the base is an update.
  let seen := Ref.new Map.empty
  let claim := fun (fqn : Text) =>
    if Map.contains fqn (Ref.get seen) then throw ("duplicate definition " ++ fqn)
    else Ref.set seen (Map.insert fqn () (Ref.get seen))
  -- Pass 1: provisional type entries so field types can resolve names to IRIs.
  let provisional := List.foldl (fun table item =>
    match item.decl with
    | Decl.data _ _ iri _ _ _ => Map.insert item.fqn (Entry.type "" (Resolve.iriFor item.fqn iri) []) table
    | Decl.record _ _ iri fields _ _ => Map.insert item.fqn (Entry.type "" (Resolve.iriFor item.fqn iri) (List.map fst fields)) table
    | Decl.effect _ _ iri _ _ _ => Map.insert item.fqn (Entry.ability "" (Resolve.iriFor item.fqn iri)) table
    | _ => table) base items
  let typeNames := Names.build provisional
  let typeObjects := Ref.new []
  let metas := Ref.new []
  let pending := Ref.new []
  let addMetaWith := fun (h : Text) (doc : Option Text) (sig : Option Sexp) (locals : List Text) (attrs : List Attr) =>
    match (doc, sig, locals, attrs) with
    | (none, none, [], []) => ()
    | _ => Ref.set metas ((h, metaForm doc sig locals attrs) :: Ref.get metas)
  let addMeta := fun (h : Text) (doc : Option Text) (sig : Option Sexp) (locals : List Text) => addMetaWith h doc sig locals []
  -- A type's parameter and constructor field names are the author's, kept out of its hash for `view`.
  let addTypeMeta := fun (h : Text) (doc : Option Text) (params : List Text) (fieldNames : List (List Text)) =>
    let docPart := match doc with
      | some d => [node "doc" [s d]]
      | none => []
    let paramsPart := if List.isEmpty params then [] else [node "params" (List.map s params)]
    let fieldsPart := if List.all (fun names => List.all Text.isEmpty names) fieldNames then [] else [node "fields" (List.map (fun names => node "c" (List.map s names)) fieldNames)]
    match docPart ++ paramsPart ++ fieldsPart with
    | [] => ()
    | parts => Ref.set metas ((h, node "meta" parts) :: Ref.get metas)
  let entries := List.concatMap (fun item =>
    let fqn := item.fqn
    match item.decl with
    | Decl.data _ params iri ctors doc _ =>
      claim fqn
      let i := Resolve.iriFor fqn iri
      let form := typeForm typeNames item i params (List.map (fun c => List.map snd (snd c)) ctors)
      let h := Resolve.hashFor i form
      Ref.set typeObjects ((h, form) :: Ref.get typeObjects)
      addTypeMeta h doc params (List.map (fun c => List.map fst (snd c)) ctors)
      (fqn, Entry.type h i []) :: List.mapIndexed (fun tag ctor =>
        match ctor with
        | (name, fields) =>
          claim (fqn ++ "." ++ name)
          (fqn ++ "." ++ name, Entry.ctor h tag (List.length fields))) ctors
    | Decl.record _ params iri fields doc _ =>
      claim fqn
      let i := Resolve.iriFor fqn iri
      let form := typeForm typeNames item i params [List.map snd fields]
      let h := Resolve.hashFor i form
      Ref.set typeObjects ((h, form) :: Ref.get typeObjects)
      addTypeMeta h doc params []
      let count := List.length fields
      claim (fqn ++ ".mk")
      let accessors := List.mapIndexed (fun index field =>
        let name := fqn ++ "." ++ fst field
        claim name
        Ref.set pending (Pending.mk name "term" (accessorCore h count index) :: Ref.get pending)
        (name, Entry.term ("@" ++ name))) fields
      (fqn, Entry.type h i (List.map fst fields)) :: (fqn ++ ".mk", Entry.ctor h 0 count) :: accessors
    | Decl.effect _ params iri ops doc _ =>
      claim fqn
      let i := Resolve.iriFor fqn iri
      let scope := bodyScope item
      let form := node "ability" ([s i, n (List.length params)] ++ List.map (fun op => node "op" [n (Resolve.arrowCount (snd op)), Resolve.tyCore typeNames scope params (snd op)]) ops)
      let h := Resolve.hashFor i form
      Ref.set typeObjects ((h, form) :: Ref.get typeObjects)
      addTypeMeta h doc params []
      (fqn, Entry.ability h i) :: List.mapIndexed (fun index op =>
        match op with
        | (name, type) =>
          let arity := Resolve.arrowCount type
          if arity == 0 then throw (item.path ++ ": ability operation " ++ fqn ++ "." ++ name ++ " needs an argument (use Unit)")
          else
            claim (fqn ++ "." ++ name)
            (fqn ++ "." ++ name, Entry.op h index arity)) ops
    | Decl.defn _ _ _ _ _ _ _ _ =>
      claim fqn
      [(fqn, Entry.term ("@" ++ fqn))]
    | Decl.check _ _ _ _ _ =>
      claim fqn
      [(fqn, Entry.test ("@" ++ fqn))]
    | Decl.thm _ _ _ _ _ _ _ =>
      claim fqn
      [(fqn, Entry.theorem ("@" ++ fqn))]
    | _ => []) items
  let table := List.foldl (fun t pair => Map.insert (fst pair) (snd pair) t) base entries
  let names := Names.build table
  -- Pass 2: bodies to Core with placeholders.
  List.forEach items (fun item =>
    let ctx := Ctx.mk names (bodyScope item) (item.path ++ ": " ++ item.fqn)
    let fqn := item.fqn
    match item.decl with
    | Decl.defn _ binders type body arms doc attributes pos =>
      let params := List.map (fun b => Pat.id b.binder [] pos) binders
      let named := Resolve.lambda ctx params (fun locals =>
        match (body, arms) with
        | (some e, _) => Resolve.expr ctx e locals
        | (_, some list) => Resolve.equations ctx list locals
        | _ => Resolve.fail ctx "definition has no body") []
      match Resolve.strip named with
      | (core, locals) =>
        Ref.set pending (Pending.mk fqn "term" core :: Ref.get pending)
        addMetaWith ("@" ++ fqn) doc (some (signature names (bodyScope item) binders type)) locals attributes
    | Decl.check _ body doc attributes _ =>
      match Resolve.strip (Resolve.expr ctx body []) with
      | (core, locals) =>
        Ref.set pending (Pending.mk fqn "test" core :: Ref.get pending)
        addMetaWith ("@" ++ fqn) doc none locals attributes
    | Decl.thm _ binders prop proof doc _ pos =>
      let params := List.map (fun b => Pat.id b.binder [] pos) binders
      let types := List.map (fun b =>
        match b.annot with
        | some t => Resolve.tyCore names (bodyScope item) [] t
        | none => node "tvar" [s "?"]) binders
      match Resolve.strip (Resolve.lambda ctx params (fun locals => Resolve.expr ctx prop locals) []) with
      | (core, locals) =>
        let form := node "theorem" [Sexp.list (Sexp.sym "binders" :: types), core, node "proof" (proofTokens names (bodyScope item) proof)]
        Ref.set pending (Pending.mk fqn "theorem" form :: Ref.get pending)
        addMeta ("@" ++ fqn) doc none locals
    | _ => ())
  -- Pass 2½: infer types, group by group, and check signatures; schemes join the metadata.
  let typeObjectMap := Map.fromList (Ref.get typeObjects)
  let metaMap := Map.fromList (Ref.get metas)
  let objectOf := fun (h : Text) => Option.orElse (Map.lookup h typeObjectMap) (fun _ => store h)
  let metaOf := fun (h : Text) => if Text.startsWith "@" h then Map.lookup h metaMap else storeMeta h
  let prims := primTypes (Ref.get pending) metaMap base storeMeta
  let warnings := Ref.new []
  let schemes := if typeMode == "off" then Map.empty else typecheck objectOf metaOf prims (Ref.get pending) (typeMode == "warn") warnings
  Ref.set metas (List.map (fun pair =>
    match Map.lookup (fst pair) schemes with
    | some scheme => (fst pair, Sexp.list (Sexp.asList (snd pair) ++ [node "scheme" [scheme]]))
    | none => pair) (Ref.get metas) ++ List.filterMap (fun pair =>
      if Map.contains (fst pair) metaMap then none else some (fst pair, node "meta" [node "scheme" [snd pair]])) (Map.toList schemes))
  -- Pass 3: hash terms, then rewrite placeholder entries and metadata keys.
  let baseHashes := Map.empty
  match hashTerms (Ref.get pending) baseHashes with
  | (hashes, termObjects) =>
    let resolveHash := fun (h : Text) => if Text.startsWith "@" h then Option.getOr (Map.lookup (Text.drop 1 h) hashes) h else h
    let finalEntries := List.map (fun pair =>
      match pair with
      | (name, Entry.term h) => (name, Entry.term (resolveHash h))
      | (name, Entry.test h) => (name, Entry.test (resolveHash h))
      | (name, Entry.theorem h) => (name, Entry.theorem (resolveHash h))
      | other => other) entries
    let finalMetas := List.map (fun pair => (resolveHash (fst pair), snd pair)) (Ref.get metas)
    Batch.mk (List.reverse (Ref.get typeObjects) ++ termObjects) finalEntries finalMetas (List.reverse (Ref.get warnings))

/--
  The type of a primitive: builtins name each primitive's definition after it (`Int.add` is
  `prim "Int.add"`), so the definition's signature is found by name, in the batch or the base.
-/
def primTypes (pending : List Pending) (metaMap : Map Text Sexp) (base : Map Text Entry) (storeMeta : Text -> {Throw Text | r} Option Sexp) : Text -> {Throw Text | r} Option Sexp :=
  let inBatch := Map.fromList (List.filterMap (fun p =>
    match p.core with
    | Sexp.list [Sexp.sym "prim", Sexp.str name] => Option.map (fun sig => (name, sig)) (Codebase.metaField (Map.lookup ("@" ++ p.name) metaMap) "sig")
    | _ => none) pending)
  fun name =>
    match Map.lookup name inBatch with
    | some sig => some sig
    | none =>
      match Map.lookup name base with
      | some (Entry.term h) => Codebase.metaField (storeMeta h) "sig"
      | _ => none

/-- Infers every pending definition's type, dependencies first; returns "@name" to scheme. -/
def typecheck (objectOf : Text -> {Throw Text | r} Option Sexp) (metaOf : Text -> {Throw Text | r} Option Sexp) (prims : Text -> {Throw Text | r} Option Sexp) (pending : List Pending) (warnOnly : Bool) (warnings : Ref (List Text)) : {Throw Text | r} Map Text Sexp :=
  let byName := Map.fromList (List.map (fun p => (p.name, p)) pending)
  let depMap := dependencies byName
  let deps := fun name => Option.getOr (Map.lookup name depMap) []
  let schemes := Ref.new Map.empty
  List.forEach (components (List.sort (Map.keys byName)) deps) (fun group =>
    let u := Types.newUnifier ()
    let members := List.filterMap (fun name => Map.lookup name byName) group
    let vars := Map.fromList (List.map (fun p => ("@" ++ p.name, Types.freshType u)) members)
    -- A member with a signature is used at its signature inside the group (polymorphic
    -- recursion, as in Haskell); only unannotated members are monomorphic while inferred.
    let signed := List.filterMap (fun p =>
      Option.map (fun sig => ("@" ++ p.name, sig)) (Codebase.metaField (metaOf ("@" ++ p.name)) "sig")) members
    let groupSchemes := Ref.new (List.foldl (fun m pair => Map.insert (fst pair) (snd pair) m) (Ref.get schemes) signed)
    let unsigned := Map.filter (fun key _ => not (Option.isSome (List.lookup key signed))) vars
    let env := TypeEnv.mk objectOf metaOf (Ref.new unsigned) groupSchemes prims
    List.forEach members (fun p =>
      let key := "@" ++ p.name
      catch (fun _ =>
        let core := match p.core with
          | Sexp.list (Sexp.sym "theorem" :: _ :: prop :: _) => prop
          | c => c
        let t := Option.getOr (Map.lookup key vars) (Types.freshType u)
        match Codebase.metaField (metaOf key) "sig" with
        | some sig =>
          -- Checked against its signature, so parameters have their declared types and rows.
          let sigVars := Ref.new Map.empty
          let sigRows := Ref.new Map.empty
          let declared := Types.signatureType u sig sigVars sigRows
          Types.unify u t declared
          Types.checkAgainst u env core declared [] (Types.freshRow u)
          Types.checkRigid u sigVars sigRows
        | none =>
          Types.unify u t (Types.infer u env core [] (Types.freshRow u))
          if p.wrap == "test" then Types.unify u t Types.bool else ()) (fun e =>
          if warnOnly then Ref.set warnings ((p.name ++ ": " ++ e) :: Ref.get warnings) else throw (p.name ++ ": " ++ e)))
    List.forEach members (fun p =>
      let key := "@" ++ p.name
      match Map.lookup key vars with
      | some t => Ref.set schemes (Map.insert key (Types.scheme u t) (Ref.get schemes))
      | none => ()))
  Ref.get schemes

/-- Parses sources (`.deus`, or the ```deus fences of an `.mdl` document). -/
def parseFile (path : Text) (source : Text) : {Throw Text} (Text, List Decl) :=
  let text := if Text.endsWith ".mdl" path then Mdl.deusSource source else source
  match try (fun _ => Parser.parse text) with
  | Result.ok decls => (path, decls)
  | Result.err e => throw (path ++ ":" ++ e)

end Compile
