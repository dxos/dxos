/-
  Replication through an object store (P3, D50).

  A remote holds immutable bundles under `bundles/<level>-<sha256>`. A bundle is one canonical
  S-expression: branch claims, then objects and metadata, each sorted by hash:

    (bundle (branch "main" "<causal>")… (base "main" "<causal>")… (obj "<hash>" <form>)… (meta "<hash>" <form>)…)

  A `base` names a head of the branch on the remote that the claim builds on (D167); readers that
  do not know it skip it.

  - `push` uploads one level-0 bundle with the objects the remote lacks and a claim for the
    branch head. Names are content hashes, so writes never conflict and nothing is overwritten.
  - `pull` imports bundles not seen before and sets the tracking branch `<remote>.<branch>` to the
    claimed heads that no other claim descends from. Two concurrent pushes leave two heads,
    `<remote>.<branch>` and `<remote>.<branch>.2`, to merge as local branches are.
  - `compact` collects history into strata (sedimentree): a causal node whose hash starts with `k`
    zeros closes a level-k stratum, which holds what that node reaches and no earlier boundary
    does. Boundaries come from hashes and bundles are canonical, so clients compacting the same
    history write byte-identical bundles. A smaller bundle is deleted once compacted bundles hold
    all its objects; claims that are still heads move to a claims-only bundle first.
  - Nothing else is ever deleted: the whole history stays on the remote, as git keeps it (D73).

  Locally, `remotes/<name>/url` names the remote, and `remotes/<name>/seen/<bundle>` lists a seen
  bundle's claims and hashes, so a pull reads each bundle once.
-/

/--
  An object store holding bundles by name; `put` never overwrites. `writeAll` stores files beside
  the bundles (the explorer's site) as (path, content) pairs, replacing what was there. The file
  operations (D82) move files byte for byte under a folder beside the bundles: `keys folder` lists
  the names in it, `download key file` copies one to a local file and says whether it existed,
  `upload key file mediaType` stores one, and `drop key` deletes one. Assets and the explorer's
  inbox use them.
-/
ability Remote @"urn:deus:replicate:Remote" where
  list : Unit -> List Text
  get : Text -> Option Text
  put : Text -> Text -> Unit
  delete : Text -> Unit
  writeAll : List (Text, Text) -> Unit
  keys : Text -> List Text
  download : Text -> Text -> Bool
  upload : Text -> Text -> Text -> Unit
  drop : Text -> Unit

/-- A seen bundle: its claims (branch, causal) and the hashes of its objects. -/
structure Seen @"urn:deus:replicate:Seen" where
  bundleName : Text
  claims : List (Text, Text)
  hashes : List Text

namespace Replicate

def union (a : Map Text Unit) (b : Map Text Unit) : Map Text Unit := List.foldl (fun m key => Map.insert key () m) a (Map.keys b)

def levelOf (name : Text) : Int := Option.getOr (Int.fromText (Text.take (Text.indexOf name "-" 0) name)) 0

def nameOf (level : Int) (text : Text) : Text := Int.toText level ++ "-" ++ Text.sha256 text

/-- Whether `name` is `<level>-<sha256>`; anything else under `bundles/` is not a bundle (D91). -/
def isBundleName (name : Text) : Bool :=
  let dash := Text.indexOf name "-" 0
  dash > 0 && Option.isSome (Int.fromText (Text.take dash name)) && External.isSha256 (Text.drop (dash + 1) name)

/-- The canonical bundle text for branch claims and objects (with their metadata), in columns (D60). -/
def bundle (dir : Text) (claims : List (Text, Text)) (hashes : List Text) : {IO} Text := basedBundle dir claims [] hashes

/-- A bundle whose claims name the remote heads they build on (`bases`, as (branch, causal)). -/
def basedBundle (dir : Text) (claims : List (Text, Text)) (bases : List (Text, Text)) (hashes : List Text) : {IO} Text :=
  let sorted := List.dedup (List.sort hashes)
  let pairs := fun (head : Text) (xs : List (Text, Text)) => List.map (fun c => Sexp.node head [Sexp.str (fst c), Sexp.str (snd c)]) (List.dedup (List.sort xs))
  let objects := List.filterMap (fun h => Option.map (fun form => Sexp.node "obj" [Sexp.str h, form]) (Codebase.readObject dir h)) sorted
  let metas := List.filterMap (fun h => Option.map (fun form => Sexp.node "meta" [Sexp.str h, form]) (Codebase.readMeta dir h)) sorted
  Columnar.encode [Sexp.node "bundle" (pairs "branch" claims ++ pairs "base" bases ++ objects ++ metas)]

/-- The `x-deus-claim` header a bundle's claim sends a Worker: `<branch> <head> <base>,…`, or none without exactly one claim. -/
def claimHeader (text : Text) : Option Text :=
  let items := match Columnar.read text with
    | [form] => Sexp.args form
    | _ => []
  let pairsOf := fun (head : Text) => List.filterMap (fun item =>
    match item with
    | Sexp.list [Sexp.sym h, Sexp.str branch, Sexp.str causal] => if h == head then some (branch, causal) else none
    | _ => none) items
  match pairsOf "branch" with
  | [(branch, causal)] =>
    let bases := List.filterMap (fun b => if fst b == branch then some (snd b) else none) (pairsOf "base")
    some (branch ++ " " ++ causal ++ " " ++ (if List.isEmpty bases then "-" else Text.join "," bases))
  | _ => none

/-- A member reference of recursive group `g` back to `(self i)`, as the group was hashed (CORE.md). -/
def unself (g : Text) (form : Sexp) : Sexp :=
  match form with
  | Sexp.list [Sexp.sym "ref", Sexp.str r] =>
    if r == g then Sexp.node "self" [Sexp.int 0]
    else if Text.startsWith (g ++ ".") r then
      match Int.fromText (Text.drop (Text.length g + 1) r) with
      | some i => Sexp.node "self" [Sexp.int i]
      | none => form
    else form
  | Sexp.list items => Sexp.list (List.map (fun x => unself g x) items)
  | _ => form

/--
  Whether `form` is the object named `h` (D91): its text hashes to `h`, or `h` names a member of a
  recursive group whose `cycle` form, rebuilt from the members `lookup` finds, hashes to the group.
-/
def verified (h : Text) (form : Sexp) (lookup : Text -> {IO} Option Sexp) : {IO} Bool :=
  if Text.sha256 (Sexp.print form) == h then true
  else
    let dot := Text.indexOf h "." 0
    let g := if dot < 0 then h else Text.take dot h
    let member := fun (name : Text) => if name == h then some form else lookup name
    let rec gather i acc :=
      match member (g ++ "." ++ Int.toText i) with
      | some m => gather (i + 1) (m :: acc)
      | none => List.reverse acc
    let members := if dot < 0 then [form] else gather 0 []
    not (List.isEmpty members) && Text.sha256 (Sexp.print (Sexp.node "cycle" (List.map (fun m => unself g m) members))) == g

/--
  Whether a builtin object (`#List`) may enter the store: builtins are named by identity, not by
  hash, so one is accepted only as a declaration of that identity and only where none is held.
-/
def acceptsBuiltin (dir : Text) (h : Text) (form : Sexp) : {IO} Bool :=
  match form with
  | Sexp.list (Sexp.sym head :: Sexp.str iri :: _) => (head == "type" || head == "ability") && iri == h && Option.isNone (Codebase.readObject dir h)
  | _ => false

/-- The builtin objects the store holds; the checker reads constructor and operation types from them. -/
def builtinsOf (dir : Text) : {IO} Map Text Unit :=
  Set.fromList (List.filter (fun h => Text.startsWith "#" h) (Codebase.allObjects dir))

/-- Writes a bundle's objects and metadata into the store; returns what it holds. -/
def import (dir : Text) (name : Text) (text : Text) : {IO} Seen :=
  let items := match Columnar.read text with
    | [form] => Sexp.args form
    | _ => defect ("bundle " ++ name ++ " is not one form")
  let claims := List.filterMap (fun item =>
    match item with
    | Sexp.list [Sexp.sym "branch", Sexp.str branch, Sexp.str causal] => some (branch, causal)
    | _ => none) items
  let carried := Map.fromList (List.filterMap (fun item =>
    match item with
    | Sexp.list [Sexp.sym "obj", Sexp.str h, form] => some (h, form)
    | _ => none) items)
  let lookup := fun (h : Text) => match Map.lookup h carried with
    | some form => some form
    | none => Codebase.readObject dir h
  let hashes := List.filterMap (fun item =>
    match item with
    | Sexp.list [Sexp.sym "obj", Sexp.str h, form] =>
      -- An object that is not what its name says would corrupt the store (D91).
      if Text.startsWith "#" h then
        if acceptsBuiltin dir h form then
          Codebase.writeObject dir h form
          some h
        else none
      else if verified h form lookup then
        Codebase.writeObject dir h form
        some h
      else
        IO.eprint ("deus: skipped object #" ++ Text.take 10 h ++ " in bundle " ++ name ++ ": its text does not hash to its name\n")
        none
    | Sexp.list [Sexp.sym "meta", Sexp.str h, form] =>
      if IO.exists (dir ++ "/meta/" ++ h) then () else Codebase.writeMeta dir h form
      none
    | _ => none) items
  Seen.mk name claims hashes

def seenDir (dir : Text) (remote : Text) : Text := dir ++ "/remotes/" ++ remote ++ "/seen"

def seenToText (s : Seen) : Text :=
  Sexp.print (Sexp.node "seen" (List.map (fun c => Sexp.node "branch" [Sexp.str (fst c), Sexp.str (snd c)]) s.claims ++ [Sexp.node "hashes" (List.map Sexp.str s.hashes)]))

def seenFromText (name : Text) (text : Text) : Seen :=
  let items := Sexp.args (Sexp.read text)
  let claims := List.filterMap (fun item =>
    match item with
    | Sexp.list [Sexp.sym "branch", Sexp.str branch, Sexp.str causal] => some (branch, causal)
    | _ => none) items
  let hashes := Option.getOr (Option.map (fun x => List.map Sexp.asText (Sexp.args x)) (List.find (fun x => Sexp.head x == "hashes") items)) []
  Seen.mk name claims hashes

/-- Every bundle on the remote, importing the ones not seen before. -/
def sync (dir : Text) (remote : Text) : {Remote, IO} List Seen :=
  let listed := List.filter (fun n => not (Text.isEmpty n)) (Remote.list ())
  let names := List.filter isBundleName listed
  List.forEach (List.filter (fun n => not (isBundleName n)) listed) (fun n => IO.eprint ("deus: ignored bundles/" ++ n ++ " on " ++ remote ++ ": not a bundle name\n"))
  List.filterMap (fun name =>
    let path := seenDir dir remote ++ "/" ++ name
    match IO.readFile path with
    | some text => some (seenFromText name text)
    | none =>
      match Remote.get name with
      | none => none
      | some text =>
        -- A bundle whose text does not hash to its name is not read, and stays unseen so a repaired copy is (D91).
        if Text.sha256 text != Text.drop (Text.indexOf name "-" 0 + 1) name then
          IO.eprint ("deus: skipped bundle " ++ name ++ " on " ++ remote ++ ": its text does not hash to its name\n")
          none
        else
          let s := import dir name text
          IO.writeFile path (seenToText s)
          some s) names

/-- Causal nodes, snapshots, and everything their entries reach, from the given heads. -/
def closureOf (dir : Text) (heads : List Text) : {IO, Throw Text} Map Text Unit :=
  let nodes := List.foldl (fun acc h => union acc (Codebase.ancestors dir h)) Map.empty heads
  let causals := List.map (fun c => Codebase.readCausal dir c) (Map.keys nodes)
  let entryRoots := List.concatMap (fun c => Project.rootsOf (Map.toList (Codebase.readNamespace dir c.snapshot))) causals
  -- Builtins travel too: a store pulled without them types every constructor pattern as unknown.
  union (union nodes (Project.reachable dir (List.concatMap Codebase.snapshotsOf causals ++ entryRoots))) (builtinsOf dir)

/-- The claimed causal nodes for `branch` that no other claim descends from, sorted. -/
def headsOf (dir : Text) (seen : List Seen) (branch : Text) : {IO, Throw Text} List Text :=
  let claimed := List.dedup (List.sort (List.filterMap (fun c => if fst c == branch then some (snd c) else none) (List.concatMap (fun s => s.claims) seen)))
  List.filter (fun c => not (List.any (fun other => other != c && Map.contains c (Codebase.ancestors dir other)) claimed)) claimed

def branchesOf (seen : List Seen) : List Text := List.dedup (List.sort (List.map fst (List.concatMap (fun s => s.claims) seen)))

/-- Imports the remote and points `<remote>.<branch>` (and `.2`, `.3`… for concurrent heads) at its heads. -/
def pull (dir : Text) (remote : Text) : {Remote, IO, Throw Text} List (Text, List Text) :=
  let seen := sync dir remote
  List.map (fun branch =>
    let heads := headsOf dir seen branch
    List.forEach (List.mapIndexed (fun i h => (i, h)) heads) (fun pair =>
      Codebase.setBranch dir (remote ++ "." ++ branch ++ (if fst pair == 0 then "" else "." ++ Int.toText (fst pair + 1))) (snd pair))
    (branch, heads)) (branchesOf seen)

/-- Uploads what `branch` reaches and the remote lacks, with a claim for its head; none if up to date. -/
def push (dir : Text) (remote : Text) (branch : Text) : {Remote, IO, Throw Text} Option Text :=
  let seen := Replicate.sync dir remote
  let head := headOf dir branch
  let claimed := any (fun s => any (fun c => c == (branch, head)) s.claims) seen
  -- Pushing a head that leaves out a remote head would fork the branch (D167); checked before the
  -- walk, so a push that lost a race says so at once.
  let bases := headsOf dir seen branch
  let ancestry := ancestors dir head
  let behind := List.filter (fun b => not (Map.contains b ancestry)) bases
  -- A claimed head is on the remote with everything it reaches, so there is nothing to send.
  if claimed then Option.none else if not (List.isEmpty behind) then Throw.throw (remote ++ " has " ++ branch ++ " changes this store lacks (#" ++
    Text.take 10 (getOr (head? behind) "") ++ "); run `deus pull " ++ remote ++ "` and `deus merge " ++ remote ++ "." ++ branch ++ "`, then push again") else
    let known := Set.fromList (concatMap (fun s => s.hashes) seen)
    let missing := missingFrom dir [head] known
    let text := basedBundle dir [(branch, head)] (List.map (fun b => (branch, b)) bases) missing
    let name := Replicate.nameOf 0 text
    Remote.put name text
    IO.writeFile
      (seenDir dir remote ++ "/" ++ name)
      (seenToText (Seen.mk name [(branch, head)] missing))
    Option.some name

/-- Uploads the store's assets the remote lacks; returns how many. -/
def pushAssets (dir : Text) : {Remote, IO, Throw Text} Int :=
  let there := Set.fromList (Remote.keys "assets")
  let missing := List.filter (fun h => not (Set.contains h there)) (Assets.all dir)
  List.forEach missing (fun h => Remote.upload ("assets/" ++ h) (Assets.path dir h) "application/octet-stream")
  List.length missing

/-- Downloads the remote's assets the store lacks; returns how many. -/
def pullAssets (dir : Text) : {Remote, IO, Throw Text} Int :=
  let missing := List.filter (fun h => Assets.isHash h && not (Assets.has dir h)) (Remote.keys "assets")
  IO.mkdirp (dir ++ "/assets")
  List.length (List.filter (fun h =>
    let staged := Assets.path dir h ++ ".tmp"
    if Remote.download ("assets/" ++ h) staged && Assets.sha256File staged == h then
      IO.exec "mv" [staged, Assets.path dir h]
      true
    else
      IO.exec "rm" ["-f", staged]
      false) missing)

def isBoundary (level : Int) (h : Text) : Bool := Text.startsWith (Text.repeat level "0") h

/--
  Compacts the remote's history at `level`: writes one bundle per stratum, then deletes the
  bundles of lower levels that compacted bundles cover. Returns (written, deleted).
-/
def compact (dir : Text) (remote : Text) (level : Int) : {Remote, IO, Throw Text} (List Text, List Text) :=
  let seen := sync dir remote
  let heads := List.concatMap (fun b => headsOf dir seen b) (branchesOf seen)
  let history := List.foldl (fun acc h => union acc (Codebase.ancestors dir h)) Map.empty heads
  let boundaries := List.filter (fun c => isBoundary level c) (Map.keys history)
  let strata := List.map (fun b =>
    let earlier := List.filter (fun other => other != b && Map.contains other (Codebase.ancestors dir b)) boundaries
    let before := if List.isEmpty earlier then Map.empty else closureOf dir earlier
    List.filter (fun h => not (Map.contains h before)) (Map.keys (closureOf dir [b]))) boundaries
  let existing := Set.fromList (List.map (fun s => s.bundleName) seen)
  let written := List.filterMap (fun hashes =>
    let text := bundle dir [] hashes
    let name := nameOf level text
    if Set.contains name existing then none
    else
      Remote.put name text
      IO.writeFile (seenDir dir remote ++ "/" ++ name) (seenToText (Seen.mk name [] hashes))
      some name) strata
  let covered := Set.fromList (List.concat strata)
  let headClaims := List.concatMap (fun b => List.map (fun h => (b, h)) (headsOf dir seen b)) (branchesOf seen)
  let removable := List.filter (fun s => levelOf s.bundleName < level && not (List.isEmpty s.hashes) && List.all (fun h => Set.contains h covered) s.hashes) seen
  -- Claims that are still heads survive their bundle in a claims-only bundle.
  let kept := List.filter (fun c => List.any (fun hc => hc == c) headClaims) (List.concatMap (fun s => s.claims) removable)
  if List.isEmpty kept then ()
  else
    let text := bundle dir kept []
    let name := nameOf 0 text
    if Set.contains name existing then ()
    else
      Remote.put name text
      IO.writeFile (seenDir dir remote ++ "/" ++ name) (seenToText (Seen.mk name kept []))
  List.forEach removable (fun s =>
    Remote.delete s.bundleName
    IO.remove (seenDir dir remote ++ "/" ++ s.bundleName))
  (written, List.map (fun s => s.bundleName) removable)

--
-- Remotes.
--

/-- Compresses `text` into the file `out` with gzip; `-n` leaves out the name and time, so equal texts give equal files. -/
def gzipTo (text : Text) (out : Text) : {IO} Unit :=
  let staged := out ++ ".tmp"
  IO.writeFile staged text
  match IO.exec "gzip" ["-n", "-9", "-f", staged] with
  | (0, _, _) =>
    IO.exec "mv" [staged ++ ".gz", out]
    ()
  | (_, _, err) => defect ("gzip failed: " ++ Text.trim err)

/-- A file's text, decompressed if gzip compressed it (`-f` passes other files through unchanged). -/
def gunzip (path : Text) : {IO} Option Text :=
  if not (IO.exists path) then none
  else
    match IO.exec "gzip" ["-dcf", path] with
    | (0, text, _) => some text
    | _ => none

/-- A remote in a local directory (another disk, a mounted share, or tests). Bundles are stored gzipped. -/
def directory (root : Text) (body : Unit -> {Remote, IO | r} a) : {IO | r} a :=
  handle body () with
  | Remote.list _ -> k => k (if IO.isDir (root ++ "/bundles") then List.filter (fun n => not (Text.endsWith ".tmp" n)) (IO.listDir (root ++ "/bundles")) else [])
  | Remote.get name -> k => k (gunzip (root ++ "/bundles/" ++ name))
  | Remote.put name text -> k =>
    let path := root ++ "/bundles/" ++ name
    if IO.exists path then () else
      IO.mkdirp (root ++ "/bundles")
      gzipTo text path
    k ()
  | Remote.delete name -> k =>
    IO.remove (root ++ "/bundles/" ++ name)
    k ()
  | Remote.writeAll files -> k =>
    List.forEach files (fun pair => IO.writeFile (root ++ "/" ++ fst pair) (snd pair))
    k ()
  | Remote.keys folder -> k => k (if IO.isDir (root ++ "/" ++ folder) then List.filter (fun n => not (Text.endsWith ".tmp" n)) (IO.listDir (root ++ "/" ++ folder)) else [])
  | Remote.download key file -> k =>
    let source := root ++ "/" ++ key
    if not (IO.exists source) then k false
    else
      match IO.exec "cp" [source, file] with
      | (0, _, _) => k true
      | _ => k false
  | Remote.upload key file _ -> k =>
    let target := root ++ "/" ++ key
    IO.mkdirp (Text.take (Text.length target - Text.length (Assets.baseName target) - 1) target)
    match IO.exec "cp" [file, target ++ ".tmp"] with
    | (0, _, _) =>
      IO.exec "mv" [target ++ ".tmp", target]
      k ()
    | (_, _, err) => defect ("copying " ++ key ++ " failed: " ++ Text.trim err)
  | Remote.drop key -> k =>
    IO.remove (root ++ "/" ++ key)
    k ()

/-- The `<Key>` values of an S3 ListObjectsV2 response. -/
def xmlValues (tag : Text) (xml : Text) : List Text :=
  List.filterMap (fun part =>
    let close := Text.indexOf part ("</" ++ tag ++ ">") 0
    if close < 0 then none else some (Text.take close part)) (List.drop 1 (Text.split xml ("<" ++ tag ++ ">")))

/--
  A remote in an S3-compatible bucket (Cloudflare R2): `endpoint` is the account's S3 endpoint,
  `prefix` the project's folder. Requests are signed by curl (`--aws-sigv4`); the credentials go
  in a private curl config file, never on a command line.
-/
def bucket (endpoint : Text) (name : Text) (prefix : Text) (config : Text) (body : Unit -> {Remote, IO | r} a) : {IO | r} a :=
  let base := endpoint ++ "/" ++ name
  let folder := prefix ++ "/bundles/"
  let curl := fun (arguments : List Text) => IO.exec "curl" (["-sS", "--fail-with-body", "-K", config, "--aws-sigv4", "aws:amz:auto:s3"] ++ arguments)
  -- The names under a folder, one ListObjectsV2 page at a time.
  let listUnder := fun (under : Text) =>
    let rec page token acc :=
      let query := "?list-type=2&prefix=" ++ under ++ (if Text.isEmpty token then "" else "&continuation-token=" ++ token)
      match curl [base ++ query] with
      | (0, xml, _) =>
        let keys := List.map (fun key => Text.drop (Text.length under) key) (xmlValues "Key" xml)
        match xmlValues "NextContinuationToken" xml with
        | next :: _ => page next (acc ++ keys)
        | [] => acc ++ keys
      | (_, out, err) => defect ("listing " ++ base ++ " failed: " ++ Text.trim err ++ " " ++ Text.trim out)
    page "" []
  handle body () with
  | Remote.list _ -> k => k (listUnder folder)
  | Remote.keys under -> k => k (listUnder (prefix ++ "/" ++ under ++ "/"))
  | Remote.download key file -> k =>
    match curl ["-o", file, base ++ "/" ++ prefix ++ "/" ++ key] with
    | (0, _, _) => k true
    | _ =>
      IO.exec "rm" ["-f", file]
      k false
  | Remote.upload key file mediaType -> k =>
    match curl ["-X", "PUT", "-H", "content-type: " ++ mediaType, "--data-binary", "@" ++ file, base ++ "/" ++ prefix ++ "/" ++ key] with
    | (0, _, _) => k ()
    | (_, out, err) => defect ("uploading " ++ key ++ " failed: " ++ Text.trim err ++ " " ++ Text.trim out)
  | Remote.drop key -> k =>
    curl ["-X", "DELETE", base ++ "/" ++ prefix ++ "/" ++ key]
    k ()
  | Remote.get key -> k =>
    let staged := config ++ "." ++ key
    let text := match curl ["-o", staged, base ++ "/" ++ folder ++ key] with
      | (0, _, _) => gunzip staged
      | _ => none
    IO.exec "rm" ["-f", staged]
    k text
  | Remote.put key text -> k =>
    let staged := config ++ "." ++ key
    gzipTo text staged
    -- `If-None-Match: *` makes the write conditional: an existing bundle is never replaced.
    let result := curl ["-X", "PUT", "-H", "If-None-Match: *", "--data-binary", "@" ++ staged, base ++ "/" ++ folder ++ key]
    IO.remove staged
    match result with
    | (0, _, _) => k ()
    | (_, out, err) => if Text.contains "PreconditionFailed" out then k () else defect ("uploading " ++ key ++ " failed: " ++ Text.trim err ++ " " ++ Text.trim out)
  | Remote.delete key -> k =>
    curl ["-X", "DELETE", base ++ "/" ++ folder ++ key]
    k ()
  | Remote.writeAll files -> k =>
    -- One curl run uploads every file, 16 at a time; each transfer is its own config group, so
    -- each repeats the credentials, and the batch config is as private as the remote's.
    let staged := config ++ ".d"
    let batch := config ++ ".batch"
    IO.mkdirp staged
    IO.exec "install" ["-m", "600", "/dev/null", batch]
    let user := Option.getOr (IO.readFile config) ""
    let groups := List.mapIndexed (fun i pair =>
      let path := fst pair
      let file := staged ++ "/" ++ Int.toText i
      IO.writeFile file (snd pair)
      let kind := siteType path
      user ++ "aws-sigv4 = \"aws:amz:auto:s3\"\nfail-with-body\noutput = \"/dev/null\"\nheader = \"content-type: " ++ kind ++ "\"\nupload-file = \"" ++ file ++ "\"\nurl = \"" ++ base ++ "/" ++ prefix ++ "/" ++ path ++ "\"\n") files
    IO.writeFile batch (Text.join "next\n" groups)
    let result := if List.isEmpty files then (0, "", "") else IO.exec "curl" ["-sS", "--parallel", "--parallel-max", "16", "-K", batch]
    IO.remove batch
    IO.exec "rm" ["-rf", staged]
    match result with
    | (0, _, _) => k ()
    | (_, out, err) => defect ("writing the site failed: " ++ Text.trim err ++ " " ++ Text.trim out)


/--
  A remote served by the DEUS Worker (D164): `base` is `https://<host>/v1/<project>`. Reads are
  open; writes send the API key that `config`, a private curl config file, holds as a header. A
  listing is one name per line. Bundles travel gzipped, as in a bucket, and the Worker checks that
  each one hashes to its name.
-/
def http (base : Text) (config : Text) (body : Unit -> {Remote, IO | r} a) : {IO | r} a :=
  let curl := fun (arguments : List Text) => IO.exec "curl" (["-sS", "--fail-with-body", "-K", config] ++ arguments)
  let listing := fun (url : Text) =>
    match curl [url] with
    | (0, out, _) => List.filter (fun n => not (Text.isEmpty n)) (Text.lines out)
    | (_, out, err) => defect ("listing " ++ url ++ " failed: " ++ Text.trim err ++ " " ++ Text.trim out)
  let send := fun (what : Text) (arguments : List Text) =>
    match curl arguments with
    | (0, _, _) => ()
    | (_, out, err) => defect (what ++ " failed: " ++ Text.trim err ++ " " ++ Text.trim out)
  handle body () with
  | Remote.list _ -> k => k (listing (base ++ "/bundles"))
  | Remote.keys under -> k => k (listing (base ++ "/files/" ++ under ++ "/"))
  | Remote.download key file -> k =>
    match curl ["-o", file, base ++ "/files/" ++ key] with
    | (0, _, _) => k true
    | _ =>
      IO.exec "rm" ["-f", file]
      k false
  | Remote.upload key file mediaType -> k =>
    send ("uploading " ++ key) ["-X", "PUT", "-H", "content-type: " ++ mediaType, "--data-binary", "@" ++ file, base ++ "/files/" ++ key]
    k ()
  | Remote.drop key -> k =>
    send ("deleting " ++ key) ["-X", "DELETE", base ++ "/files/" ++ key]
    k ()
  | Remote.get key -> k =>
    let staged := config ++ "." ++ key
    let text := match curl ["-o", staged, base ++ "/bundles/" ++ key] with
      | (0, _, _) => gunzip staged
      | _ => none
    IO.exec "rm" ["-f", staged]
    k text
  | Remote.put key text -> k =>
    let staged := config ++ "." ++ key
    gzipTo text staged
    -- The Worker answers 200 for a bundle it already has, so a repeated push is not an error.
    let claim := match claimHeader text with
      | some header => ["-H", "x-deus-claim: " ++ header]
      | none => []
    let result := curl (["-X", "PUT", "-H", "content-type: application/gzip"] ++ claim ++ ["--data-binary", "@" ++ staged, base ++ "/bundles/" ++ key])
    IO.remove staged
    match result with
    | (0, _, _) => k ()
    | (_, out, err) => defect ("uploading " ++ key ++ " failed: " ++ Text.trim err ++ " " ++ Text.trim out)
  | Remote.delete key -> k =>
    send ("deleting " ++ key) ["-X", "DELETE", base ++ "/bundles/" ++ key]
    k ()
  | Remote.writeAll files -> k =>
    -- One curl run uploads every file, 16 at a time; each transfer is its own config group, so
    -- each repeats the key, and the batch config is as private as the remote's.
    let staged := config ++ ".d"
    let batch := config ++ ".batch"
    IO.mkdirp staged
    IO.exec "install" ["-m", "600", "/dev/null", batch]
    let user := Option.getOr (IO.readFile config) ""
    let groups := List.mapIndexed (fun i pair =>
      let path := fst pair
      let file := staged ++ "/" ++ Int.toText i
      IO.writeFile file (snd pair)
      user ++ "fail-with-body\noutput = \"/dev/null\"\nrequest = \"PUT\"\nheader = \"content-type: " ++ siteType path ++ "\"\ndata-binary = \"@" ++ file ++ "\"\nurl = \"" ++ base ++ "/files/" ++ path ++ "\"\n") files
    IO.writeFile batch (Text.join "next\n" groups)
    let result := if List.isEmpty files then (0, "", "") else IO.exec "curl" ["-sS", "--parallel", "--parallel-max", "16", "-K", batch]
    IO.remove batch
    IO.exec "rm" ["-rf", staged]
    match result with
    | (0, _, _) => k ()
    | (_, out, err) => defect ("writing the site failed: " ++ Text.trim err ++ " " ++ Text.trim out)

/--
  The content type a site file is served with, by the bundled server (`Site.contentType`) and by a
  bucket the explorer is uploaded to: a browser refuses a module script or a stylesheet sent as
  `text/plain`.
-/
def siteType (path : Text) : Text :=
  if Text.endsWith ".html" path then "text/html; charset=utf-8"
  else if Text.endsWith ".json" path then "application/json"
  else if Text.endsWith ".css" path then "text/css"
  else if Text.endsWith ".js" path || Text.endsWith ".mjs" path then "text/javascript"
  else if Text.endsWith ".svg" path then "image/svg+xml"
  else "text/plain; charset=utf-8"

/-- What `heads` reach that `known` lacks. A remote holds the closure of every hash it holds (each
  push sends a closed set), so the walk stops at known hashes and costs what changed rather than the
  whole history. -/
def missingFrom (dir : Text) (heads : List Text) (known : Map Text Unit) : {IO, Throw Text} List Text :=
  let rec nodesOf work seen :=
    match work with
    | [] => seen
    | x :: rest => if Map.contains x seen || Map.contains x known then nodesOf rest seen else nodesOf (parentsOf dir x ++ rest) (Map.insert x () seen)
  let nodes := nodesOf heads Map.empty
  let causals := List.map (fun c => readCausal dir c) (Map.keys nodes)
  let entryRoots := concatMap (fun c => rootsOf (Map.toList (readNamespace dir c.snapshot))) causals
  let rec go pending seen :=
    match pending with
    | [] => seen
    | h :: rest => if Map.contains h seen || Map.contains h known then go rest seen else
        let deps :=
          match readObject dir h with
          | Option.some form => Codebase.dependencies form
          | Option.none => []
        go (deps ++ rest) (Map.insert h () seen)
  let objects := go (concatMap snapshotsOf causals ++ entryRoots) nodes
  -- Builtins travel too: a store pulled without them types every constructor pattern as unknown.
  Map.keys (union
    objects
    (Set.fromList (List.filter (fun h => not (Map.contains h known)) (Map.keys (builtinsOf dir)))))

end Replicate
