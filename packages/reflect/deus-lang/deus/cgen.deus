/-
  A C back end (D80): compiles a definition and the definitions it calls to C, which a C compiler
  (clang, so LLVM) turns into native code.

  It accepts the same first-order subset as the wasm back end (D51) and reuses that back end's
  gathering and type tracking, so a program compiles to both or to neither. Each definition is a
  C function of `V`s, a machine word. `Int` and `Bool` are themselves, sign-extended from 32 bits,
  and arithmetic wraps at 32 bits as in the interpreter. Any other constructed value points at a
  block `[tag, field…]` with a header word before it; a nullary constructor is a static block.

  Blocks are reference counted (D86), as in Perceus (Koka, Lean 4). The header holds the count
  and the block's kind. The code owns each local it binds and consumes it exactly once, so a block
  is freed the moment its last reference goes, and a `match` that takes apart a unique block it
  does not use again builds the case's new block in the old one's memory. Parameters that a
  function only reads through are borrowed, so passing them costs nothing. Every block lives in
  one reserved region, which tells blocks apart from integers without types. Cycles, which only
  `Ref` can make, are never freed.

  A call to itself in tail position is a jump back to the top of the function; a tail call of a
  function of the same arity is `musttail` where the C compiler has it (clang; gcc from 15), so
  mutual recursion in tail position runs in constant stack too.

  `Int.div` and `Int.mod` by zero trap, as in wasm.

  `Text` is a block of UTF-16 units with a C runtime ported from the Rust kernel (D115); a unique
  text that is appended to grows in place.
-/

namespace CGen

/-- The C every unit starts with; `nullary` static blocks serve the nullary constructors' tags. -/
def prelude (nullary : Int) : Text :=
  Text.join "\n" [
    "#include <stdint.h>",
    "#if defined(__has_attribute) && __has_attribute(musttail)",
    "#define MUSTTAIL __attribute__((musttail))",
    "#else",
    "#define MUSTTAIL",
    "#endif",
    "#ifdef __wasm__",
    "/* wasm32: a value is 64 bits; a block is its address with bit 32 set, so integers need no tag (D86). */",
    "typedef int64_t V;",
    "#define BOX(p) ((V)(uintptr_t)(p) | ((V)1 << 32))",
    "#define UNBOX(v) ((V *)(uintptr_t)(uint32_t)(v))",
    "#define IS_PTR(v) ((uint64_t)(v) >> 32 == 1)",
    "#define EXPORT(name) __attribute__((export_name(name)))",
    "extern unsigned char __heap_base;",
    "/* With -nostdlib, clang still lowers fill and copy loops to these calls. */",
    "void *memset(void *d, int c, unsigned long n) { unsigned char *p = d; while (n--) *p++ = (unsigned char)c; return d; }",
    "void *memcpy(void *d, const void *s, unsigned long n) { unsigned char *p = d; const unsigned char *q = s; while (n--) *p++ = *q++; return d; }",
    "static V *deus_base, *deus_hp, *deus_hl;",
    "static void deus_init(void) { deus_base = deus_hp = (V *)(((uintptr_t)&__heap_base + 7) & ~(uintptr_t)7); deus_hl = (V *)(__builtin_wasm_memory_size(0) * 65536); }",
    "static V *deus_raw(V words) { V *p = deus_hp; deus_hp += words; while (deus_hp > deus_hl) { uintptr_t pages = __builtin_wasm_memory_size(0); if (__builtin_wasm_memory_grow(0, pages) == (uintptr_t)-1) __builtin_trap(); deus_hl = (V *)((pages * 2) * 65536); } return p; }",
    "#else",
    "#include <stdlib.h>",
    "#include <sys/mman.h>",
    "/* The heap is one reserved region, so a word is a block exactly when it points into it (D86). */",
    "typedef intptr_t V;",
    "#define BOX(p) ((V)(p))",
    "#define UNBOX(v) ((V *)(v))",
    "#define DEUS_HEAP ((V)1 << 36)",
    "#define EXPORT(name)",
    "static V *deus_base, *deus_hp, *deus_hl;",
    "#define IS_PTR(v) ((uintptr_t)(v) - (uintptr_t)deus_base < (uintptr_t)DEUS_HEAP)",
    "static void deus_init(void) { void *m = mmap(0, DEUS_HEAP, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0); if (m == MAP_FAILED) __builtin_trap(); deus_base = deus_hp = m; deus_hl = deus_base + DEUS_HEAP / (V)sizeof(V); }",
    "static V *deus_raw(V words) { V *p = deus_hp; deus_hp += words; if (deus_hp > deus_hl) __builtin_trap(); return p; }",
    "#endif",
    "/* Nullary constructors and () are static blocks, never counted. */",
    "#define STATIC(p) ((V)(uintptr_t)(p))",
    "#define W(x) ((V)(int32_t)(uint32_t)(x))",
    "#define ADD(a, b) W((uint32_t)(a) + (uint32_t)(b))",
    "#define SUB(a, b) W((uint32_t)(a) - (uint32_t)(b))",
    "#define MUL(a, b) W((uint32_t)(a) * (uint32_t)(b))",
    "#define SHL(a, b) W((uint32_t)(a) << ((b) & 31))",
    "#define SHR(a, b) ((V)((int32_t)(a) >> ((b) & 31)))",
    "#define USHR(a, b) W((uint32_t)(a) >> ((b) & 31))",
    "static inline V DIV(V a, V b) { if (b == 0) __builtin_trap(); return b == -1 ? SUB(0, a) : (V)((int32_t)a / (int32_t)b); }",
    "static inline V MOD(V a, V b) { if (b == 0) __builtin_trap(); return b == -1 ? 0 : (V)((int32_t)a % (int32_t)b); }",
    "static V deus_live, deus_peak;",
    "static V *deus_free_lists[257];",
    "/* Freed blocks over 256 words, as [next, words, …]: reused by an exact fit among the first 16. */",
    "static V *deus_big;",
    "static V *deus_big_take(V words) { V **link = &deus_big; for (int i = 0; *link && i < 16; i++, link = (V **)(uintptr_t)*link) { V *h = *link; if (h[1] == words) { *link = (V *)(uintptr_t)h[0]; return h; } } return 0; }",
    "/* A block's header, the word before it: its count times 256, plus its kind. */",
    "#define PHDR(p) ((p)[-1])",
    "#define HDR(v) PHDR(UNBOX(v))",
    "#define K_TABLE 252",
    "#define K_TEXT 253",
    "#define K_REF 254",
    "#define K_ARRAY 255",
    "#define UNIQUE(v) (HDR(v) < 512)",
    "static inline V *deus_block(V kind, V body) { V words = body + 1; V *h; deus_live += words; if (deus_live > deus_peak) deus_peak = deus_live; if (words <= 256 && (h = deus_free_lists[words])) deus_free_lists[words] = (V *)(uintptr_t)h[0]; else if (words <= 256 || !(h = deus_big_take(words))) h = deus_raw(words); h[0] = 256 | kind; return h + 1; }",
    "static inline V deus_body(V *p) { V k = PHDR(p) & 255; return k == K_ARRAY ? p[0] + 1 : k == K_REF ? 1 : k == K_TEXT ? 2 + (p[1] + 3) / 4 : k == K_TABLE ? 4 : k + 1; }",
    "static inline void deus_release(V *p) { V words = deus_body(p) + 1; deus_live -= words; if (words <= 256) { p[-1] = (V)(uintptr_t)deus_free_lists[words]; deus_free_lists[words] = p - 1; } else { p[-1] = (V)(uintptr_t)deus_big; p[0] = words; deus_big = p - 1; } }",
    "static V *deus_stack, deus_sp, deus_cap;",
    "static void deus_push(V v) { if (deus_sp == deus_cap) { V cap = deus_cap ? 2 * deus_cap : 1024; V *bigger = deus_raw(cap); for (V i = 0; i < deus_sp; i++) bigger[i] = deus_stack[i]; deus_stack = bigger; deus_cap = cap; } deus_stack[deus_sp++] = v; }",
    "static void deus_free(V *p) {",
    "  for (;;) {",
    "    V k = PHDR(p) & 255; V *from = k == K_REF ? p : k == K_TABLE ? p + 2 : p + 1; V n = k == K_ARRAY ? p[0] : k == K_REF ? 1 : k == K_TEXT ? 0 : k == K_TABLE ? 2 : k;",
    "    for (V i = 0; i < n; i++) { V c = from[i]; if (IS_PTR(c)) { if (!UNIQUE(c)) HDR(c) -= 256; else deus_push(c); } }",
    "    deus_release(p);",
    "    if (deus_sp == 0) return;",
    "    p = UNBOX(deus_stack[--deus_sp]);",
    "  }",
    "}",
    "static inline V deus_dup(V v) { if (IS_PTR(v)) HDR(v) += 256; return v; }",
    "static inline void deus_drop(V v) { if (IS_PTR(v)) { if (!UNIQUE(v)) HDR(v) -= 256; else deus_free(UNBOX(v)); } }",
    "/* A constructor block, in the memory of a dead block of the same size when there is one. */",
    "static inline V *deus_con(V *token, V fields) { if (token) { token[-1] = 256 | fields; return token; } return deus_block(fields, fields + 1); }",
    "/* A closure is a block [code, captured…]; the code borrows it and owns its argument. */",
    "typedef V (*deus_code)(V, V);",
    "static inline V deus_apply(V c, V x) { return ((deus_code)(uintptr_t)UNBOX(c)[0])(c, x); }",
    "static inline V deus_apply_drop(V c, V x) { V r = deus_apply(c, x); deus_drop(c); return r; }",
    "static inline void deus_unused(V *token) { if (token) deus_release(token); }",
    "static V deus_array(V n, V x) { if (n < 0) __builtin_trap(); V *p = deus_block(K_ARRAY, n + 1); p[0] = n; if (n == 0) deus_drop(x); else if (IS_PTR(x)) HDR(x) += 256 * (n - 1); for (V i = 1; i <= n; i++) p[i] = x; return BOX(p); }",
    "/* A pure `Array.set` (D96) writes into a unique array and copies a shared one, counting each item again. */",
    "static V deus_array_copy(V a) { V *q = UNBOX(a); V n = q[0]; V *p = deus_block(K_ARRAY, n + 1); p[0] = n; for (V i = 1; i <= n; i++) p[i] = deus_dup(q[i]); return BOX(p); }",
    "static inline V deus_array_unique(V a) { if (UNIQUE(a)) return a; V r = deus_array_copy(a); HDR(a) -= 256; return r; }",
    "#define AT(a, i) ({ V *a_ = UNBOX(a); V i_ = (i); if ((uint32_t)i_ >= (uint32_t)a_[0]) __builtin_trap(); &a_[i_ + 1]; })",
    "static V deus_nullary[" ++ Int.toText (larger nullary 1) ++ "] = {"
      ++ Text.join ", " (List.map Int.toText (List.range 0 (larger nullary 1))) ++ "};",
    "/* Text is a block [length, capacity, UTF-16 units…] (D115). These borrow their arguments. */",
    "#define TLEN(v) (UNBOX(v)[0])",
    "#define TCAP(v) (UNBOX(v)[1])",
    "#define TU(v) ((uint16_t *)(UNBOX(v) + 2))",
    "static V deus_text_cap(V n, V cap) { cap = (cap + 3) & ~(V)3; V *p = deus_block(K_TEXT, 2 + cap / 4); p[0] = n; p[1] = cap; return BOX(p); }",
    "static V deus_text(V n) { return deus_text_cap(n, n); }",
    "static void deus_units(uint16_t *d, const uint16_t *s, V n) { for (V i = 0; i < n; i++) d[i] = s[i]; }",
    "static V deus_text_of(const uint16_t *s, V n) { V r = deus_text(n); deus_units(TU(r), s, n); return r; }",
    "static V deus_text_append(V a, V b) { V m = TLEN(a), n = TLEN(b); if (n == 0) return deus_dup(a); if (m == 0) return deus_dup(b); V r = deus_text(m + n); deus_units(TU(r), TU(a), m); deus_units(TU(r) + m, TU(b), n); return r; }",
    "/* `a ++ b` that consumes `a`: a unique `a` grows in place, doubling its capacity when it is full, so a loop that appends to its text is linear. */",
    "static V deus_text_extend(V a, V b) { V m = TLEN(a), n = TLEN(b); if (n == 0) return a; if (IS_PTR(a) && UNIQUE(a)) { if (m + n <= TCAP(a)) { deus_units(TU(a) + m, TU(b), n); TLEN(a) = m + n; return a; } V r = deus_text_cap(m + n, 2 * (m + n)); deus_units(TU(r), TU(a), m); deus_units(TU(r) + m, TU(b), n); deus_release(UNBOX(a)); return r; } V r = deus_text_append(a, b); deus_drop(a); return r; }",
    "static V deus_text_cmp(V a, V b) { V m = TLEN(a), n = TLEN(b); uint16_t *x = TU(a), *y = TU(b); for (V i = 0; i < m && i < n; i++) if (x[i] != y[i]) return x[i] < y[i] ? -1 : 1; return m < n ? -1 : m > n ? 1 : 0; }",
    "static V deus_text_eq(V a, V b) { if (a == b) return 1; V n = TLEN(a); if (n != TLEN(b)) return 0; uint16_t *x = TU(a), *y = TU(b); for (V i = 0; i < n; i++) if (x[i] != y[i]) return 0; return 1; }",
    "static V deus_text_code(V t, V i) { return (uint32_t)i < (uint32_t)TLEN(t) ? (V)TU(t)[i] : -1; }",
    "static V deus_clamp(V i, V n) { return i < 0 ? (n + i < 0 ? 0 : n + i) : i > n ? n : i; }",
    "static V deus_text_slice(V t, V s, V e) { V n = TLEN(t), from = deus_clamp(s, n), to = deus_clamp(e, n); if (from == 0 && to == n) return deus_dup(t); return deus_text_of(TU(t) + from, from < to ? to - from : 0); }",
    "static V deus_text_from_code(V c) { uint16_t u = (uint16_t)c; return deus_text_of(&u, 1); }",
    "static V deus_text_index(V t, V needle, V from) { V n = TLEN(t), m = TLEN(needle), i = from < 0 ? 0 : from > n ? n : from; uint16_t *x = TU(t), *y = TU(needle); for (; i + m <= n; i++) { V j = 0; while (j < m && x[i + j] == y[j]) j++; if (j == m) return i; } return -1; }",
    "static int deus_space(uint16_t u) { return (u >= 9 && u <= 13) || u == 32 || u == 0xa0 || u == 0x1680 || (u >= 0x2000 && u <= 0x200a) || u == 0x2028 || u == 0x2029 || u == 0x202f || u == 0x205f || u == 0x3000 || u == 0xfeff; }",
    "static V deus_text_trim(V t) { V n = TLEN(t), s = 0, e = n; uint16_t *x = TU(t); while (s < n && deus_space(x[s])) s++; while (e > s && deus_space(x[e - 1])) e--; return deus_text_slice(t, s, e); }",
    "/* A list is nil, the static block [0], or a block [1, head, tail]. */",
    "static V deus_text_join(V sep, V xs) { V n = 0, k = 0; for (V c = xs; UNBOX(c)[0]; c = UNBOX(c)[2], k++) n += TLEN(UNBOX(c)[1]); if (k == 1) return deus_dup(UNBOX(xs)[1]); if (k > 1) n += (k - 1) * TLEN(sep); V r = deus_text(n); uint16_t *d = TU(r); for (V c = xs; UNBOX(c)[0]; c = UNBOX(c)[2]) { if (c != xs) { deus_units(d, TU(sep), TLEN(sep)); d += TLEN(sep); } V h = UNBOX(c)[1]; deus_units(d, TU(h), TLEN(h)); d += TLEN(h); } return r; }",
    "static V deus_cons(V h, V t) { V *p = deus_block(2, 3); p[0] = 1; p[1] = h; p[2] = t; return BOX(p); }",
    "static V deus_text_split(V t, V sep) { V n = TLEN(t), m = TLEN(sep), r, *slot = &r; uint16_t *x = TU(t), *y = TU(sep); if (m == 0) { for (V i = 0; i < n; i++) { V c = deus_cons(deus_text_of(x + i, 1), 0); *slot = c; slot = &UNBOX(c)[2]; } } else { V start = 0, i = 0; while (i + m <= n) { V j = 0; while (j < m && x[i + j] == y[j]) j++; if (j == m) { V c = deus_cons(deus_text_of(x + start, i - start), 0); *slot = c; slot = &UNBOX(c)[2]; i += m; start = i; } else i++; } V c = deus_cons(deus_text_of(x + start, n - start), 0); *slot = c; slot = &UNBOX(c)[2]; } *slot = STATIC(&deus_nullary[0]); return r; }",
    "static V deus_int_text(V v) { uint16_t u[12]; int k = 12; uint32_t m = (int32_t)v < 0 ? 0u - (uint32_t)v : (uint32_t)v; do { u[--k] = (uint16_t)('0' + m % 10); m /= 10; } while (m); if ((int32_t)v < 0) u[--k] = '-'; return deus_text_of(u + k, 12 - k); }",
    "/* `/^-?[0-9]+$/`, then wrapped to 32 bits as `Number(t) | 0` is (exactly, below 2^53). */",
    "static V deus_text_int(V t) { V n = TLEN(t), i = 0; uint16_t *x = TU(t); int neg = n > 0 && x[0] == '-'; if (neg) i = 1; if (i == n) return STATIC(&deus_nullary[0]); uint32_t m = 0; for (; i < n; i++) { if (x[i] < '0' || x[i] > '9') return STATIC(&deus_nullary[0]); m = m * 10 + (x[i] - '0'); } V *p = deus_block(1, 2); p[0] = 1; p[1] = W(neg ? 0u - m : m); return BOX(p); }",
    "/* A literal is made once, on first use, with a count no program brings to one, and is not counted as live. */",
    "static V deus_literal(const uint16_t *u, V n) { V r = deus_text_of(u, n); HDR(r) = ((V)1 << 48) | K_TEXT; deus_live -= deus_body(UNBOX(r)) + 1; return r; }",
    "/* Values whose type the compiler does not know: a text is a heap block of kind K_TEXT, an Int is not a block. */",
    "#define IS_TEXT(v) (IS_PTR(v) && (HDR(v) & 255) == K_TEXT)",
    "static V deus_cmp_any(V a, V b) { if (IS_TEXT(a) && IS_TEXT(b)) return deus_text_cmp(a, b); if (IS_PTR(a) || IS_PTR(b)) __builtin_trap(); return (a > b) - (a < b); }",
    "static V deus_eq_any(V a, V b) { if (IS_TEXT(a) && IS_TEXT(b)) return deus_text_eq(a, b); if (IS_PTR(a) || IS_PTR(b)) __builtin_trap(); return a == b; }",
    "static V deus_text_concat(V xs) { static struct { V h, n, cap; } empty = {0, 0, 0}; return deus_text_join(STATIC(&empty.n), xs); }",
    "static inline V deus_int_cmp(V x, V y) { return (x > y) - (x < y); }",
    "/* `++` on lists: the unique prefix of the first list is relinked in place, the rest copied (D115). Consumes both. */",
    "static V deus_list_append(V a, V b) { V r, *slot = &r, c = a; int mine = 1; while (UNBOX(c)[0]) { V *p = UNBOX(c); if (mine && UNIQUE(c)) { *slot = c; slot = &p[2]; } else { if (mine) HDR(c) -= 256; mine = 0; V n = deus_cons(deus_dup(p[1]), 0); *slot = n; slot = &UNBOX(n)[2]; } c = p[2]; } *slot = b; return r; }",
    "static V deus_append_any(V a, V b) { if (IS_TEXT(a)) { V r = deus_text_extend(a, b); deus_drop(b); return r; } return deus_list_append(a, b); }",
    "/* Dict and MutMap (D119): a block [size, used, entries, index] of kind K_TABLE. `entries` is an array of",
    "   key-value pairs in insertion order, a deleted key being DEUS_NOKEY; `index` an open-addressed array of",
    "   entry numbers, -1 where empty, at most half full. Keys are Int or Text, as in the kernels. All borrow. */",
    "#define DEUS_NOKEY ((V)1 << 62)",
    "static uint32_t deus_hash(V k) { if (IS_TEXT(k)) { uint32_t h = 2166136261u; V n = TLEN(k); uint16_t *x = TU(k); for (V i = 0; i < n; i++) h = (h ^ x[i]) * 16777619u; return h; } if (IS_PTR(k)) __builtin_trap(); uint32_t h = (uint32_t)k * 2654435761u; return h ^ (h >> 16); }",
    "static inline V deus_key_eq(V a, V b) { return a == b || (IS_TEXT(a) && IS_TEXT(b) && deus_text_eq(a, b)); }",
    "static V deus_table_new(V unit) { (void)unit; V *t = deus_block(K_TABLE, 4); t[0] = 0; t[1] = 0; t[2] = deus_array(16, DEUS_NOKEY); t[3] = deus_array(16, -1); return BOX(t); }",
    "static V deus_table_find(V *t, V k) { V *ix = UNBOX(t[3]) + 1, *es = UNBOX(t[2]) + 1; V mask = UNBOX(t[3])[0] - 1; for (V i = deus_hash(k) & mask;; i = (i + 1) & mask) { V e = ix[i]; if (e < 0) return -1; if (deus_key_eq(es[2 * e], k)) return e; } }",
    "static void deus_table_index(V *t, V k, V e) { V *ix = UNBOX(t[3]) + 1; V mask = UNBOX(t[3])[0] - 1; V i = deus_hash(k) & mask; while (ix[i] >= 0) i = (i + 1) & mask; ix[i] = e; }",
    "/* Room for twice the live entries: the live ones move, in order, to new arrays, and the index is rebuilt. */",
    "static void deus_table_grow(V *t) { V cap = 2 * t[0] + 8, icap = 16; while (icap < 2 * cap) icap *= 2; V *old = UNBOX(t[2]) + 1, used = t[1]; V es = deus_array(2 * cap, DEUS_NOKEY); V *to = UNBOX(es) + 1; V n = 0; for (V e = 0; e < used; e++) if (old[2 * e] != DEUS_NOKEY) { to[2 * n] = old[2 * e]; to[2 * n + 1] = old[2 * e + 1]; old[2 * e] = DEUS_NOKEY; old[2 * e + 1] = 0; n++; } deus_drop(t[2]); deus_drop(t[3]); t[2] = es; t[3] = deus_array(icap, -1); t[1] = n; for (V e = 0; e < n; e++) deus_table_index(t, to[2 * e], e); }",
    "static V deus_table_set(V m, V k, V v) { V *t = UNBOX(m); V e = deus_table_find(t, k); if (e >= 0) { V *s = UNBOX(t[2]) + 2 + 2 * e; V old = *s; *s = deus_dup(v); deus_drop(old); } else { if (2 * (t[1] + 1) > UNBOX(t[2])[0]) deus_table_grow(t); e = t[1]++; t[0]++; V *s = UNBOX(t[2]) + 1 + 2 * e; s[0] = deus_dup(k); s[1] = deus_dup(v); deus_table_index(t, k, e); } return STATIC(&deus_nullary[0]); }",
    "static V deus_table_get(V m, V k) { V *t = UNBOX(m); V e = deus_table_find(t, k); if (e < 0) return STATIC(&deus_nullary[0]); V *p = deus_block(1, 2); p[0] = 1; p[1] = deus_dup(UNBOX(t[2])[2 + 2 * e]); return BOX(p); }",
    "static V deus_table_has(V m, V k) { return deus_table_find(UNBOX(m), k) >= 0; }",
    "static V deus_table_delete(V m, V k) { V *t = UNBOX(m); V e = deus_table_find(t, k); if (e >= 0) { V *s = UNBOX(t[2]) + 1 + 2 * e; deus_drop(s[0]); deus_drop(s[1]); s[0] = DEUS_NOKEY; s[1] = 0; t[0]--; } return STATIC(&deus_nullary[0]); }",
    "static V deus_table_size(V m) { return UNBOX(m)[0]; }",
    "static V deus_table_keys(V m) { V *t = UNBOX(m), *es = UNBOX(t[2]) + 1, r, *slot = &r; for (V e = 0; e < t[1]; e++) if (es[2 * e] != DEUS_NOKEY) { V c = deus_cons(deus_dup(es[2 * e]), 0); *slot = c; slot = &UNBOX(c)[2]; } *slot = STATIC(&deus_nullary[0]); return r; }",
    "/* A list of pairs [0, key, value]; a later key replaces an earlier one's value, as in the kernels. */",
    "static V deus_dict_from_list(V xs) { V d = deus_table_new(0); for (V c = xs; UNBOX(c)[0]; c = UNBOX(c)[2]) { V *pair = UNBOX(UNBOX(c)[1]); deus_table_set(d, pair[1], pair[2]); } return d; }",
    "static V deus_dict_lookup(V k, V d) { return deus_table_get(d, k); }",
    "static V deus_dict_contains(V k, V d) { return deus_table_has(d, k); }",
    "/* Handlers (D124). The abort marker is no value a program makes: not an Int, not a block. */",
    "#ifdef __wasm__",
    "#define DEUS_ABORT ((V)1 << 40)",
    "#else",
    "#define DEUS_ABORT ((V)(uintptr_t)deus_base - 8)",
    "#endif",
    "/* An installed clause is a record [parent, frame, ability, op, clause]; a handler's first record is its frame, with no clause.",
    "   `deus_hctx` is the innermost visible record. A running clause hides its handler and the ones inside it. */",
    "static V *deus_hrec, deus_hn, deus_hcap, deus_hctx = -1, *deus_cst, deus_cn, deus_ccap, deus_abort_frame = -1, deus_abort_value;",
    "static V *deus_grow(V *p, V used, V *cap, V need) { if (used + need <= *cap) return p; V c = *cap ? 2 * *cap : 64; while (used + need > c) c *= 2; V *q = deus_raw(c); for (V i = 0; i < used; i++) q[i] = p[i]; *cap = c; return q; }",
    "#define HREC(r, f) deus_hrec[5 * (r) + (f)]",
    "static V deus_hpush(V parent, V frame, V a, V i, V c) { deus_hrec = deus_grow(deus_hrec, 5 * deus_hn, &deus_hcap, 5); V r = deus_hn++; HREC(r, 0) = parent; HREC(r, 1) = frame; HREC(r, 2) = a; HREC(r, 3) = i; HREC(r, 4) = c; return r; }",
    "static V deus_handle_enter(V unused) { (void)unused; V f = deus_hpush(deus_hctx, deus_hn, -1, -1, 0); deus_hctx = f; return f; }",
    "static V deus_handle_add(V f, V a, V i, V c) { deus_hctx = deus_hpush(deus_hctx, f, a, i, deus_dup(c)); return STATIC(&deus_nullary[0]); }",
    "static V deus_handle_exit(V f) { deus_hctx = HREC(f, 0); for (V r = f; r < deus_hn; r++) deus_drop(HREC(r, 4)); deus_hn = f; return STATIC(&deus_nullary[0]); }",
    "/* The clause for operation `i` of ability `a`, run with its handler hidden until `deus_clause_done`; none is a defect. */",
    "static V deus_clause(V a, V i) { for (V r = deus_hctx; r >= 0; r = HREC(r, 0)) if (HREC(r, 2) == a && HREC(r, 3) == i) { V f = HREC(r, 1); deus_cst = deus_grow(deus_cst, 2 * deus_cn, &deus_ccap, 2); deus_cst[2 * deus_cn] = deus_hctx; deus_cst[2 * deus_cn + 1] = f; deus_cn++; deus_hctx = HREC(f, 0); return deus_dup(HREC(r, 4)); } __builtin_trap(); }",
    "static V deus_clause_done(V v) { deus_cn--; deus_hctx = deus_cst[2 * deus_cn]; return deus_dup(v); }",
    "static V deus_abort_to(V v) { if (v == DEUS_ABORT) return v; deus_abort_frame = deus_cst[2 * deus_cn - 1]; deus_abort_value = deus_dup(v); return DEUS_ABORT; }",
    "static V deus_caught(V f, V r) { return r == DEUS_ABORT && deus_abort_frame == f; }",
    "static V deus_caught_value(V unused) { (void)unused; deus_abort_frame = -1; return deus_abort_value; }",
    "static V deus_aborted(V r) { return r == DEUS_ABORT; }",
    "static V deus_abort_marker(V unused) { (void)unused; return DEUS_ABORT; }",
    "/* UTF-8, as the kernels encode a text: a lone surrogate becomes U+FFFD. `o` needs 3 bytes a unit. */",
    "static V deus_utf8(const uint16_t *x, V n, uint8_t *o) { V k = 0; for (V i = 0; i < n; i++) { uint32_t c = x[i]; if (c >= 0xd800 && c < 0xdc00 && i + 1 < n && x[i + 1] >= 0xdc00 && x[i + 1] < 0xe000) c = 0x10000 + ((c - 0xd800) << 10) + (x[++i] - 0xdc00); else if (c >= 0xd800 && c < 0xe000) c = 0xfffd; if (c < 0x80) o[k++] = (uint8_t)c; else if (c < 0x800) { o[k++] = (uint8_t)(0xc0 | c >> 6); o[k++] = (uint8_t)(0x80 | (c & 63)); } else if (c < 0x10000) { o[k++] = (uint8_t)(0xe0 | c >> 12); o[k++] = (uint8_t)(0x80 | (c >> 6 & 63)); o[k++] = (uint8_t)(0x80 | (c & 63)); } else { o[k++] = (uint8_t)(0xf0 | c >> 18); o[k++] = (uint8_t)(0x80 | (c >> 12 & 63)); o[k++] = (uint8_t)(0x80 | (c >> 6 & 63)); o[k++] = (uint8_t)(0x80 | (c & 63)); } } return k; }",
    "/* A scratch buffer of `bytes` bytes is a text block, so it comes from and returns to the heap. */",
    "static V deus_scratch(V bytes) { return deus_text(bytes / 2 + 1); }",
    "static V deus_text_utf8(V t) { V b = deus_scratch(3 * TLEN(t)); uint8_t *o = (uint8_t *)TU(b); V k = deus_utf8(TU(t), TLEN(t), o), r, *slot = &r; for (V i = 0; i < k; i++) { V c = deus_cons(o[i], 0); *slot = c; slot = &UNBOX(c)[2]; } *slot = STATIC(&deus_nullary[0]); deus_drop(b); return r; }",
    "/* Code points to units, a code above U+FFFF as its surrogate pair (D76); a code out of range is a defect. */",
    "static V deus_text_from_codes(V xs) { V n = 0; for (V c = xs; UNBOX(c)[0]; c = UNBOX(c)[2]) { V v = UNBOX(c)[1]; if (v < 0 || v > 0x10ffff) __builtin_trap(); n += v > 0xffff ? 2 : 1; } V r = deus_text(n); uint16_t *o = TU(r); V k = 0; for (V c = xs; UNBOX(c)[0]; c = UNBOX(c)[2]) { V v = UNBOX(c)[1]; if (v > 0xffff) { o[k++] = (uint16_t)(0xd800 + ((v - 0x10000) >> 10)); o[k++] = (uint16_t)(0xdc00 + ((v - 0x10000) & 0x3ff)); } else o[k++] = (uint16_t)v; } return r; }",
    "static const uint32_t deus_k256[64] = { 0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2 };",
    "#define ROR(x, n) ((x) >> (n) | (x) << (32 - (n)))",
    "static void deus_sha_block(uint32_t *h, const uint8_t *p) { uint32_t w[64], v[8]; for (int i = 0; i < 16; i++) w[i] = (uint32_t)p[4 * i] << 24 | (uint32_t)p[4 * i + 1] << 16 | (uint32_t)p[4 * i + 2] << 8 | p[4 * i + 3]; for (int i = 16; i < 64; i++) w[i] = w[i - 16] + (ROR(w[i - 15], 7) ^ ROR(w[i - 15], 18) ^ w[i - 15] >> 3) + w[i - 7] + (ROR(w[i - 2], 17) ^ ROR(w[i - 2], 19) ^ w[i - 2] >> 10); for (int i = 0; i < 8; i++) v[i] = h[i]; for (int i = 0; i < 64; i++) { uint32_t t1 = v[7] + (ROR(v[4], 6) ^ ROR(v[4], 11) ^ ROR(v[4], 25)) + ((v[4] & v[5]) ^ (~v[4] & v[6])) + deus_k256[i] + w[i]; uint32_t t2 = (ROR(v[0], 2) ^ ROR(v[0], 13) ^ ROR(v[0], 22)) + ((v[0] & v[1]) ^ (v[0] & v[2]) ^ (v[1] & v[2])); for (int j = 7; j > 0; j--) v[j] = v[j - 1]; v[4] += t1; v[0] = t1 + t2; } for (int i = 0; i < 8; i++) h[i] += v[i]; }",
    "/* SHA-256 of the UTF-8 of a text, as 64 lower-case hex digits. */",
    "static V deus_text_sha256(V t) { static const char hex[] = \"0123456789abcdef\"; uint32_t h[8] = { 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 }; V b = deus_scratch(3 * TLEN(t)); uint8_t *o = (uint8_t *)TU(b); V n = deus_utf8(TU(t), TLEN(t), o), i = 0; for (; i + 64 <= n; i += 64) deus_sha_block(h, o + i); uint8_t last[128] = {0}; V m = n - i; for (V j = 0; j < m; j++) last[j] = o[i + j]; last[m] = 0x80; V end = m < 56 ? 64 : 128; uint64_t bits = (uint64_t)n * 8; for (int j = 0; j < 8; j++) last[end - 1 - j] = (uint8_t)(bits >> (8 * j)); deus_sha_block(h, last); if (end == 128) deus_sha_block(h, last + 64); deus_drop(b); V r = deus_text(64); for (int j = 0; j < 32; j++) { uint8_t x = (uint8_t)(h[j / 4] >> (24 - 8 * (j % 4))); TU(r)[2 * j] = (uint16_t)hex[x >> 4]; TU(r)[2 * j + 1] = (uint16_t)hex[x & 15]; } return r; }",
    "/* `show` (D120) appends to a unique text, as the kernels render values: JSON for texts. */",
    "static V deus_put(V s, const char *c) { V n = 0; while (c[n]) n++; V t = deus_text(n); for (V i = 0; i < n; i++) TU(t)[i] = (uint16_t)(unsigned char)c[i]; V r = deus_text_extend(s, t); deus_drop(t); return r; }",
    "static V deus_show_int(V s, V x) { V t = deus_int_text(x); V r = deus_text_extend(s, t); deus_drop(t); return r; }",
    "static V deus_show_text(V s, V t) { static const char hex[] = \"0123456789abcdef\"; V n = TLEN(t), k = 0; V j = deus_text(6 * n + 2); uint16_t *x = TU(t), *o = TU(j); o[k++] = 34; for (V i = 0; i < n; i++) { uint32_t u = x[i], e = u == 34 || u == 92 ? u : u == 10 ? 110 : u == 13 ? 114 : u == 9 ? 116 : u == 8 ? 98 : u == 12 ? 102 : 0; int pair = u >= 0xd800 && u < 0xdc00 && i + 1 < n && x[i + 1] >= 0xdc00 && x[i + 1] < 0xe000; if (e) { o[k++] = 92; o[k++] = (uint16_t)e; } else if (pair) { o[k++] = (uint16_t)u; o[k++] = x[++i]; } else if (u < 32 || (u >= 0xd800 && u < 0xe000)) { o[k++] = 92; o[k++] = 117; o[k++] = hex[u >> 12]; o[k++] = hex[u >> 8 & 15]; o[k++] = hex[u >> 4 & 15]; o[k++] = hex[u & 15]; } else o[k++] = (uint16_t)u; } o[k++] = 34; TLEN(j) = k; V r = deus_text_extend(s, j); deus_drop(j); return r; }",
    ""]

/-- A C integer literal; the most negative `Int` has no literal of its own. -/
def lit (n : Int) : Text := if n == -2147483648 then "(-2147483647 - 1)" else "(V)" ++ Int.toText n

def macro (p : Text) : Option Text :=
  if p == "Int.add" then some "ADD"
  else if p == "Int.sub" then some "SUB"
  else if p == "Int.mul" then some "MUL"
  else if p == "Int.div" then some "DIV"
  else if p == "Int.mod" then some "MOD"
  else if p == "Int.shl" then some "SHL"
  else if p == "Int.shr" then some "SHR"
  else if p == "Int.ushr" then some "USHR"
  else none

def infix (p : Text) : Option Text :=
  if p == "Int.and" then some "&"
  else if p == "Int.or" then some "|"
  else if p == "Int.xor" then some "^"
  else if p == "eq" then some "=="
  else if p == "neq" then some "!="
  else if p == "lt" then some "<"
  else if p == "gt" then some ">"
  else if p == "le" then some "<="
  else if p == "ge" then some ">="
  else none

def larger (a : Int) (b : Int) : Int := if a > b then a else b

/-- One more than the largest tag of a nullary constructor (other than `Bool`'s) in `form`. -/
def nullaryCount (form : Sexp) : Int :=
  match form with
  | Sexp.list [Sexp.sym "con", Sexp.str t, Sexp.int tag, Sexp.int 0] => if t == "#Bool" then 0 else tag + 1
  | Sexp.list items => List.foldl (fun acc x => larger acc (nullaryCount x)) 0 items
  | _ => 0

def local (l : Int) : Text := "l" ++ Int.toText l

def fnName (i : Int) : Text := "f" ++ Int.toText i

def args (xs : List Text) : Text := "(" ++ Text.join ", " xs ++ ")"

/-- What the compiler knows while compiling one function: its index, its arity and its label counter. -/
structure FnCtx @"urn:deus:cgen:FnCtx" where
  cScope : Wasm.Scope
  cSelf : Int
  cArity : Int
  cNext : Ref Int
  cBorrow : List (Int, List Bool)
  cLifted : Ref (List Text)

/-- Which parameters of function `index` are borrowed: the caller keeps ownership (D86). -/
def borrowsOf (ctx : FnCtx) (index : Int) : List Bool := Option.getOr (List.lookup index ctx.cBorrow) []

def borrowsAt (flags : List Bool) (k : Int) : Bool := Option.getOr (List.get? flags k) false

def fresh (ctx : FnCtx) : Int := Wasm.fresh ctx.cNext

/-- The index and definition of the function `h`. -/
def arityOf (ctx : FnCtx) (h : Text) : {Throw Text} Int :=
  let found := List.find (fun f => f.fnHash == h) ctx.cScope.fns
  if Option.isNone found then throw ("unknown function #" ++ Text.take 10 h)
  else Option.getOr (Option.map (fun f => f.fnArity) found) 0

def callee (ctx : FnCtx) (h : Text) (argc : Int) : {Throw Text} (Int, Wasm.Fn) :=
  match List.find (fun f => f.fnHash == h) ctx.cScope.fns with
  | some f =>
    if f.fnArity != argc then throw ("#" ++ Text.take 10 h ++ " takes " ++ Int.toText f.fnArity ++ " arguments but is applied to " ++ Int.toText argc ++ "; partial application is outside the C subset")
    else (List.findIndex (fun g => g.fnHash == h) ctx.cScope.fns, f)
  | none => throw ("unknown function #" ++ Text.take 10 h)

--
-- Reference counting (D86). Every local the code owns is consumed exactly once: its last use
-- moves it, earlier uses `deus_dup` it, and a path that never uses it drops it first.
--

/-- How many variables a pattern binds. -/
def binders (pat : Sexp) : Int :=
  match pat with
  | Sexp.list [Sexp.sym "pvar"] => 1
  | Sexp.list [Sexp.sym "pas", p] => 1 + binders p
  | Sexp.list (Sexp.sym "pcon" :: _ :: _ :: subs) => List.sum (List.map binders subs)
  | _ => 0

/-- The locals `e` reads, with `env` mapping its de Bruijn indices to locals (-1 for none). -/
def freeLocals (env : List Int) (e : Sexp) : List Int :=
  match e with
  | Sexp.list [Sexp.sym "var", Sexp.int i] =>
    match List.get? env i with
    | some l => if l >= 0 then [l] else []
    | none => []
  | Sexp.list [Sexp.sym "let", v, b] => freeLocals env v ++ freeLocals (-1 :: env) b
  | Sexp.list [Sexp.sym "lam", b] => freeLocals (-1 :: env) b
  | Sexp.list (Sexp.sym "match" :: scrutinee :: cases) =>
    freeLocals env scrutinee ++ List.concatMap (fun c =>
      match c with
      | Sexp.list [Sexp.sym "case", pat, b] => freeLocals (List.replicate (binders pat) (-1) ++ env) b
      | _ => []) cases
  | Sexp.list items => List.concatMap (freeLocals env) items
  | _ => []

def isIn (xs : List Int) (x : Int) : Bool := List.contains x xs

/-- Whether `e` builds a block of `n` fields, which a dead block of that size can become. -/
def wants (n : Int) (e : Sexp) : Bool :=
  match e with
  | Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "con", Sexp.str t, Sexp.int _, Sexp.int k] :: rest) =>
    (k == n && t != "#Bool") || List.any (wants n) rest
  | Sexp.list [Sexp.sym "lam", _] => false
  | Sexp.list items => List.any (wants n) items
  | _ => false

/-- Whether values of type `t` are never counted: `Int` and `Bool` are not blocks, and `()` is static. -/
def uncounted (t : Sexp) : Bool := Wasm.isScalar t || t == Wasm.tref "#Unit"

def scalarLocal (ctx : FnCtx) (l : Int) : Bool := uncounted (Wasm.typeOfLocal ctx.cScope l)

def dropLocal (ctx : FnCtx) (l : Int) : Text := if scalarLocal ctx l then "" else "deus_drop(" ++ local l ++ "); "

def dupLocal (ctx : FnCtx) (l : Int) : Text := if scalarLocal ctx l then "" else "deus_dup(" ++ local l ++ "); "

/-- Whether `e` maps de Bruijn index `i` of `env` to local `l`. -/
def isLocal (env : List Int) (l : Int) (e : Sexp) : Bool :=
  match e with
  | Sexp.list [Sexp.sym "var", Sexp.int i] => List.get? env i == some l
  | _ => false

/--
  Whether `e` consumes local `l` of function `self`, given which parameters are borrowed so far:
  any use but as the container of an `Array` or `Ref` access, or as an argument a callee borrows
  (a call to `self` only in the same position, so a jump to the top keeps it borrowed).
-/
def consumes (borrow : List (Int, List Bool)) (fns : List Wasm.Fn) (self : Int) (param : Int) (env : List Int) (l : Int) (e : Sexp) : Bool :=
  let again := fun (x : Sexp) => consumes borrow fns self param env l x
  match e with
  | Sexp.list [Sexp.sym "var", Sexp.int i] => List.get? env i == some l
  | Sexp.list [Sexp.sym "let", v, b] => again v || consumes borrow fns self param (-1 :: env) l b
  | Sexp.list [Sexp.sym "lam", b] => isIn (freeLocals (-1 :: env) b) l
  | Sexp.list (Sexp.sym "match" :: scrutinee :: cases) =>
    again scrutinee || List.any (fun c =>
      match c with
      | Sexp.list [Sexp.sym "case", pat, b] => consumes borrow fns self param (List.replicate (binders pat) (-1) ++ env) l b
      | _ => false) cases
  | Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "prim", Sexp.str p] :: x :: rest) =>
    let container := (Text.startsWith "Array." p || Text.startsWith "Ref." p) && p != "Array.make" && p != "Array.set" && p != "Ref.new" && isLocal env l x
    (not container && again x) || List.any again rest
  | Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "ref", Sexp.str h] :: xs) =>
    let index := List.findIndex (fun f => f.fnHash == h) fns
    let flags := Option.getOr (List.lookup index borrow) []
    List.any (fun pair =>
      match pair with
      | (k, x) => if isLocal env l x then not (borrowsAt flags k && (index != self || k == param)) else again x) (List.mapIndexed (fun k x => (k, x)) xs)
  | Sexp.list items => List.any again items
  | _ => false

/-- The borrowed parameters of every function: the largest set no body consumes. -/
def inferBorrow (fns : List Wasm.Fn) : List (Int, List Bool) :=
  let initial := List.mapIndexed (fun i f => (i, List.map (fun t => not (Wasm.isScalar t)) (fst (Wasm.peel f.fnArity f.fnType)))) fns
  let rec step borrow :=
    let next := List.mapIndexed (fun i f =>
      let flags := Option.getOr (List.lookup i borrow) []
      let env := List.reverse (List.range 0 f.fnArity)
      (i, List.mapIndexed (fun k b => b && not (consumes borrow fns i k env k f.fnBody)) flags)) fns
    if next == borrow then borrow else step next
  step initial

/-- A reuse token: the C local holding a dead block's memory, and its field count. -/
structure Token @"urn:deus:cgen:Token" where
  tokLocal : Int
  tokFields : Int

def tokenName (t : Token) : Text := "t" ++ Int.toText t.tokLocal

/-- For expressions evaluated in order, the owned locals each one consumes: its last uses. -/
def split (owned : List Int) (frees : List (List Int)) : List (List Int) :=
  match frees with
  | [] => []
  | here :: later => List.filter (fun l => isIn here l && not (List.any (fun f => isIn f l) later)) owned :: split owned later

/-- The token for each of `xs`: the first that builds a block of the token's size gets it. -/
def hand (token : Option Token) (xs : List Sexp) : List (Option Token) :=
  match (token, xs) with
  | (_, []) => []
  | (none, _ :: rest) => none :: hand none rest
  | (some t, x :: rest) => if wants t.tokFields x then token :: hand none rest else none :: hand token rest

/--
  A pattern test against the value in local `v`: statements that `break` out of the enclosing
  `do … while (0)` when it does not match, the environment with what it binds, and each local it
  loads as (local, the local it was loaded from, field index).
-/
def pattern (ctx : FnCtx) (v : Int) (env : List Int) (pat : Sexp) : {Throw Text} (Text, List Int, List (Int, Int, Int)) :=
  match pat with
  | Sexp.list [Sexp.sym "pany"] => ("", env, [])
  | Sexp.list [Sexp.sym "pvar"] => ("", v :: env, [])
  | Sexp.list [Sexp.sym "pas", p] => pattern ctx v (v :: env) p
  | Sexp.list [Sexp.sym "pint", Sexp.int n] => ("if (" ++ local v ++ " != " ++ lit n ++ ") break; ", env, [])
  | Sexp.list [Sexp.sym "ptext", Sexp.str t] => ("if (!deus_text_eq(" ++ local v ++ ", " ++ textLiteral t ++ ")) break; ", env, [])
  | Sexp.list [Sexp.sym "pcon", Sexp.str "#Bool", Sexp.int tag] => ("if (" ++ local v ++ " != " ++ Int.toText tag ++ ") break; ", env, [])
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str t :: Sexp.int tag :: subs) =>
    let tagTest := "if (UNBOX(" ++ local v ++ ")[0] != " ++ Int.toText tag ++ ") break; "
    List.foldl (fun acc pair =>
      match (acc, pair) with
      | ((code, bound, loads), (i, Sexp.list [Sexp.sym "pany"])) => (code, bound, loads)
      | ((code, bound, loads), (i, sub)) =>
        let f := fresh ctx
        let _ := Wasm.setType ctx.cScope f (Wasm.fieldType ctx.cScope t tag i (Wasm.typeOfLocal ctx.cScope v))
        match pattern ctx f bound sub with
        | (subCode, bound2, subLoads) => (code ++ "V " ++ local f ++ " = UNBOX(" ++ local v ++ ")[" ++ Int.toText (i + 1) ++ "]; " ++ subCode, bound2, loads ++ ((f, v, i) :: subLoads))) (tagTest, env, []) (List.mapIndexed (fun i x => (i, x)) subs)
  | other => throw ("the pattern " ++ Sexp.print other ++ " is outside the C subset")

/-- The field count of a pattern that takes apart a heap block, or 0. -/
def blockFields (pat : Sexp) : Int :=
  match pat with
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str t :: Sexp.int _ :: subs) => if t == "#Bool" then 0 else List.length subs
  | _ => 0

/-- `pre` (statements) runs before `body`: in tail position both are statements. -/
def before (tail : Bool) (pre : Text) (body : Text) : Text :=
  if pre == "" then body else if tail then pre ++ body else "({ " ++ pre ++ body ++ "; })"

/--
  `e` compiled to C, consuming each local in `owned` exactly once and the reuse token, if any.
  In tail position the result is statements that return `e` (a call to itself becomes a jump);
  otherwise it is an expression, using GNU statement expressions.
-/
def expr (ctx : FnCtx) (env : List Int) (tail : Bool) (owned : List Int) (token : Option Token) (e : Sexp) : {Throw Text} Text :=
  let used := freeLocals env e
  let live := List.filter (isIn used) owned
  let dead := Text.concat (List.map (dropLocal ctx) (List.filter (fun l => not (isIn used l)) owned))
  match token with
  | some t =>
    if wants t.tokFields e then before tail dead (form ctx env tail live token e)
    else before tail (dead ++ "deus_unused(" ++ tokenName t ++ "); ") (form ctx env tail live none e)
  | none => before tail dead (form ctx env tail live none e)

/--
  The argument that passes `l` itself and after which no argument consumes it: moving `l` there
  keeps it alive until the call, so later arguments read it without counting.
-/
def mover (ctx : FnCtx) (env : List Int) (xs : List Sexp) (l : Int) : Option Int :=
  List.foldl (fun acc pair =>
    match pair with
    | (k, x) =>
      if isLocal env l x && not (List.any (consumes ctx.cBorrow ctx.cScope.fns ctx.cSelf (-1) env l) (List.drop (k + 1) xs)) then some k else acc) none (List.mapIndexed (fun k x => (k, x)) xs)

/--
  Each of `xs`, evaluated in order into a fresh local: the declarations, the C for each value,
  and the drops to run after the values are used. An argument in a position `borrows` marks is
  not counted: a local is passed as it is, and anything else is dropped afterwards.
-/
def sequence (ctx : FnCtx) (env : List Int) (owned : List Int) (token : Option Token) (borrows : List Bool) (xs : List Sexp) : {Throw Text} (Text, List Text, Text) :=
  let last := split owned (List.map (freeLocals env) xs)
  let movers := List.map (fun l => (l, mover ctx env xs l)) owned
  let shares := List.mapIndexed (fun k here => List.filter (fun l =>
    match Option.bind (List.lookup l movers) (fun m => m) with
    | some m => m == k
    | none => isIn here l) owned) last
  let tokens := hand token xs
  let parts := List.mapIndexed (fun k triple =>
    match triple with
    | ((x, mine), tok) =>
      -- A borrowed local is passed as it is, unless a later argument consumes it first.
      let consumedLater := List.concat (List.drop (k + 1) shares)
      let direct := match x with
        | Sexp.list [Sexp.sym "var", Sexp.int i] =>
          if borrowsAt borrows k then Option.bind (List.get? env i) (fun l => if isIn consumedLater l then none else some l) else none
        | _ => none
      match direct with
      | some l => ("", local l, if isIn mine l then dropLocal ctx l else "")
      | none =>
        let l := fresh ctx
        let _ := Wasm.setType ctx.cScope l (Wasm.typeOf ctx.cScope env x)
        ("V " ++ local l ++ " = " ++ expr ctx env false mine tok x ++ "; ", local l, if borrowsAt borrows k then dropLocal ctx l else "")) (List.zip (List.zip xs shares) tokens)
  (Text.concat (List.map (fun t => match t with
    | (d, _, _) => d) parts), List.map (fun t => match t with
    | (_, v, _) => v) parts, Text.concat (List.map (fun t => match t with
    | (_, _, a) => a) parts))

/-- `e` with its variables from index `cut` up moved `amount` further out, as under `amount` more binders. -/
def shift (amount : Int) (cut : Int) (e : Sexp) : Sexp :=
  match e with
  | Sexp.list [Sexp.sym "var", Sexp.int i] => if i >= cut then Sexp.list [Sexp.sym "var", Sexp.int (i + amount)] else e
  | Sexp.list [Sexp.sym "lam", b] => Sexp.list [Sexp.sym "lam", shift amount (cut + 1) b]
  | Sexp.list [Sexp.sym "let", v, b] => Sexp.list [Sexp.sym "let", shift amount cut v, shift amount (cut + 1) b]
  | Sexp.list [Sexp.sym "letrec", Sexp.list fs, b] =>
    let n := List.length fs
    Sexp.list [Sexp.sym "letrec", Sexp.list (List.map (shift amount (cut + n)) fs), shift amount (cut + n) b]
  | Sexp.list (Sexp.sym "match" :: scrutinee :: cases) =>
    Sexp.list (Sexp.sym "match" :: shift amount cut scrutinee :: List.map (fun c =>
      match c with
      | Sexp.list [Sexp.sym "case", pat, b] => Sexp.list [Sexp.sym "case", pat, shift amount (cut + binders pat) b]
      | other => other) cases)
  | Sexp.list [Sexp.sym "ret", b] => Sexp.list [Sexp.sym "ret", shift amount (cut + 1) b]
  | Sexp.list [Sexp.sym "on", a, i, Sexp.int k, b] => Sexp.list [Sexp.sym "on", a, i, Sexp.int k, shift amount (cut + k + 1) b]
  | Sexp.list items => Sexp.list (List.map (shift amount cut) items)
  | _ => e

/--
  `h`, of arity `arity`, applied to fewer arguments: the arguments bound in order, then a lambda
  for each missing parameter around the saturated call.
-/
def partial (h : Text) (arity : Int) (xs : List Sexp) : Sexp :=
  let given := List.length xs
  let call := Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "ref", Sexp.str h] :: List.map (fun i => Sexp.list [Sexp.sym "var", Sexp.int (arity - 1 - i)]) (List.range 0 arity))
  let lams := List.foldl (fun body _ => Sexp.list [Sexp.sym "lam", body]) call (List.range given arity)
  List.foldr (fun pair body =>
    match pair with
    | (i, x) => Sexp.list [Sexp.sym "let", shift i 0 x, body]) lams (List.mapIndexed (fun i x => (i, x)) xs)

/--
  A lambda as a closure: its code is lifted to `static V c<k>(V self, V arg)`, which reads the
  captured locals from `self` without counting them, and the block holds the code and captures.
-/
def lambdaClosure (ctx : FnCtx) (env : List Int) (owned : List Int) (b : Sexp) : {Throw Text} Text :=
  let free := List.dedup (freeLocals (-1 :: env) b)
  if List.length free > 253 then throw "a lambda that captures more than 253 locals is outside the C subset"
  else
    let k := List.length (Ref.get ctx.cLifted)
    let captures := List.mapIndexed (fun i l => (l, i + 2)) free
    let typed := List.map (fun pair => (snd pair, Wasm.typeOfLocal ctx.cScope (fst pair))) captures
    let scope := Wasm.Scope.mk ctx.cScope.fns ctx.cScope.datatypes (Ref.new typed) ctx.cScope.eqs
    let inner := FnCtx.mk scope (-1) 2 (Ref.new (2 + List.length free)) ctx.cBorrow ctx.cLifted
    -- Reserve the slot first, so closures nested in `b` take the next numbers.
    let _ := Ref.set ctx.cLifted (Ref.get ctx.cLifted ++ [""])
    let innerEnv := 1 :: List.map (fun l => Option.getOr (List.lookup l captures) (-1)) env
    let loads := Text.concat (List.map (fun pair => "V " ++ local (snd pair) ++ " = UNBOX(l0)[" ++ Int.toText (snd pair - 1) ++ "]; ") captures)
    let code := "static V c" ++ Int.toText k ++ "(V l0, V l1) {\n  " ++ loads ++ expr inner innerEnv true [1] none b ++ "\n}"
    let _ := Ref.set ctx.cLifted (List.mapIndexed (fun i t => if i == k then code else t) (Ref.get ctx.cLifted))
    let vars := List.map (fun l => Sexp.list [Sexp.sym "var", Sexp.int (List.findIndex (fun x => x == l) env)]) free
    match sequence ctx env owned none [] vars with
    | (decls, values, _) =>
      let p := fresh ctx
      let stores := List.mapIndexed (fun i v => local p ++ "[" ++ Int.toText (i + 1) ++ "] = " ++ v ++ "; ") values
      "({ " ++ decls ++ "V *" ++ local p ++ " = deus_con(0, " ++ Int.toText (List.length free) ++ "); " ++ local p ++ "[0] = (V)(uintptr_t)&c" ++ Int.toText k ++ "; " ++ Text.concat stores ++ "BOX(" ++ local p ++ "); })"

/-- `e` once `expr` has dropped what it does not use: `owned` are exactly the locals it consumes. -/
def form (ctx : FnCtx) (env : List Int) (tail : Bool) (owned : List Int) (token : Option Token) (e : Sexp) : {Throw Text} Text :=
  let ret := fun (x : Text) => if tail then "return " ++ x ++ ";" else x
  match e with
  | Sexp.list [Sexp.sym "int", Sexp.int n] => ret (lit n)
  | Sexp.list [Sexp.sym "text", Sexp.str t] => ret (textLiteral t)
  | Sexp.list [Sexp.sym "prim", Sexp.str p] =>
    -- A primitive used as a value is its eta-expansion: one lambda per parameter.
    let arity := primArity p
    if arity <= 0 then throw ("the primitive " ++ p ++ " as a value is outside the C subset")
    else form ctx env tail owned token (List.foldl (fun body _ => Sexp.node "lam" [body]) (Sexp.node "app" (Sexp.node "prim" [Sexp.str p] :: List.map (fun i => Sexp.node "var" [Sexp.int i]) (List.reverse (List.range 0 arity)))) (List.range 0 arity))
  | Sexp.list [Sexp.sym "con", Sexp.str "#Bool", Sexp.int tag, Sexp.int 0] => ret ("(V)" ++ Int.toText tag)
  | Sexp.list [Sexp.sym "con", Sexp.str _, Sexp.int tag, Sexp.int 0] => ret ("STATIC(&deus_nullary[" ++ Int.toText tag ++ "])")
  | Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "con", Sexp.str t, Sexp.int tag, Sexp.int n] :: xs) =>
    if n != List.length xs || t == "#Bool" then throw ("partial application of a constructor of " ++ t ++ " is outside the C subset")
    else
      let mine := match token with
        | some tok => tok.tokFields == n
        | none => false
      match sequence ctx env owned (if mine then none else token) [] xs with
      | (decls, values, _) =>
        let p := fresh ctx
        let memory := match token with
          | some tok => if mine then tokenName tok else "0"
          | none => "0"
        let stores := List.mapIndexed (fun i v => local p ++ "[" ++ Int.toText (i + 1) ++ "] = " ++ v ++ "; ") values
        ret ("({ " ++ decls ++ "V *" ++ local p ++ " = deus_con(" ++ memory ++ ", " ++ Int.toText n ++ "); " ++ local p ++ "[0] = " ++ Int.toText tag ++ "; " ++ Text.concat stores ++ "BOX(" ++ local p ++ "); })")
  | Sexp.list (Sexp.sym "match" :: scrutinee :: cases) => matchForm ctx env tail owned token scrutinee cases
  | Sexp.list [Sexp.sym "var", Sexp.int i] =>
    match List.get? env i with
    | some l => if isIn owned l || scalarLocal ctx l then ret (local l) else ret ("deus_dup(" ++ local l ++ ")")
    | none => throw ("unbound variable " ++ Int.toText i)
  | Sexp.list [Sexp.sym "if", c, t, f] =>
    let branches := freeLocals env t ++ freeLocals env f
    let mine := List.filter (fun l => not (isIn branches l)) owned
    let rest := List.filter (isIn branches) owned
    let cond := expr ctx env false mine none c
    if tail then "if (" ++ cond ++ ") { " ++ expr ctx env true rest token t ++ " } else { " ++ expr ctx env true rest token f ++ " }"
    else "(" ++ cond ++ " ? " ++ expr ctx env false rest token t ++ " : " ++ expr ctx env false rest token f ++ ")"
  | Sexp.list [Sexp.sym "seq", a, b] =>
    let later := freeLocals env b
    let mine := List.filter (fun l => not (isIn later l)) owned
    let rest := List.filter (isIn later) owned
    let first := if wants (Option.getOr (Option.map (fun t => t.tokFields) token) 0) a then token else none
    let second := match first with
      | some _ => none
      | none => token
    let value := expr ctx env false mine first a
    let consumed := if uncounted (Wasm.typeOf ctx.cScope env a) then "(void)" ++ value ++ "; " else "deus_drop(" ++ value ++ "); "
    before tail consumed (expr ctx env tail rest second b)
  | Sexp.list [Sexp.sym "let", v, b] =>
    let later := freeLocals (-1 :: env) b
    let mine := List.filter (fun l => not (isIn later l)) owned
    let rest := List.filter (isIn later) owned
    let first := if wants (Option.getOr (Option.map (fun t => t.tokFields) token) 0) v then token else none
    let second := match first with
      | some _ => none
      | none => token
    let l := fresh ctx
    let _ := Wasm.setType ctx.cScope l (Wasm.typeOf ctx.cScope env v)
    before tail ("V " ++ local l ++ " = " ++ expr ctx env false mine first v ++ "; ") (expr ctx (l :: env) tail (l :: rest) second b)
  | Sexp.list [Sexp.sym "app", Sexp.list [Sexp.sym "prim", Sexp.str "Int.neg"], a] => ret ("SUB(0, " ++ expr ctx env false owned none a ++ ")")
  | Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "prim", Sexp.str p] :: xs) =>
    match runtime ctx env owned token p xs with
    | some code => ret code
    | none => ret (primitive ctx env owned token e p xs)
  | Sexp.list [Sexp.sym "lam", b] => ret (lambdaClosure ctx env owned b)
  | Sexp.list [Sexp.sym "ref", Sexp.str h] => form ctx env tail owned token (partial h (arityOf ctx h) [])
  | Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "ref", Sexp.str h] :: xs) =>
    let arity := arityOf ctx h
    if List.length xs < arity then form ctx env tail owned token (partial h arity xs)
    else if List.length xs > arity then form ctx env tail owned token (Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "ref", Sexp.str h] :: List.take arity xs) :: List.drop arity xs))
    else
      match callee ctx h (List.length xs) with
      | (index, f) =>
        match sequence ctx env owned token (borrowsOf ctx index) xs with
        | (decls, values, after) =>
          if tail && index == ctx.cSelf && after == "" then
            "{ " ++ decls ++ Text.concat (List.mapIndexed (fun i v => local i ++ " = " ++ v ++ "; ") values) ++ "goto top; }"
          else
            let call := fnName index ++ args values
            if after != "" then ret ("({ " ++ decls ++ "V r = " ++ call ++ "; " ++ after ++ "r; })")
            else if tail && f.fnArity == ctx.cArity then "{ " ++ decls ++ "MUSTTAIL return " ++ call ++ "; }"
            else ret (if decls == "" then call else "({ " ++ decls ++ call ++ "; })")
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "ref", Sexp.str h] :: ys) :: xs) =>
    form ctx env tail owned token (Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "ref", Sexp.str h] :: ys ++ xs))
  | Sexp.list (Sexp.sym "app" :: f :: x :: rest) =>
    -- An unknown function: the closure is borrowed by the first call; each later one consumes the closure before it.
    match sequence ctx env owned token [true] (f :: x :: rest) with
    | (decls, values, after) =>
      match values with
      | fv :: xv :: more =>
        let call := List.foldl (fun c v => "deus_apply_drop(" ++ c ++ ", " ++ v ++ ")") ("deus_apply(" ++ fv ++ ", " ++ xv ++ ")") more
        ret ("({ " ++ decls ++ "V r = " ++ call ++ "; " ++ after ++ "r; })")
      | _ => throw "an application without arguments"
  | other => throw ("outside the C subset: " ++ Text.take 120 (Sexp.print other))

/-- A Text literal (D115): made on first use and kept, so it is a heap block like any other text. -/
def textLiteral (t : Text) : Text :=
  let n := Text.length t
  let units := if n == 0 then "0" else Text.join ", " (List.map (fun i => Int.toText (Text.code t i)) (List.range 0 n))
  "({ static V s_; static const uint16_t u_[" ++ Int.toText (larger n 1) ++ "] = {" ++ units ++ "}; s_ ? s_ : (s_ = deus_literal(u_, " ++ Int.toText n ++ ")); })"

/-- A call of a runtime function that borrows the arguments `borrows` marks: each is passed as it is, and dropped after if owned. -/
def lending (ctx : FnCtx) (env : List Int) (owned : List Int) (token : Option Token) (borrows : List Bool) (call : List Text -> Text) (xs : List Sexp) : {Throw Text} Text :=
  match sequence ctx env owned token borrows xs with
  | (decls, values, after) => "({ " ++ decls ++ "V r = " ++ call values ++ "; " ++ after ++ "r; })"

/-- The runtime function of a primitive on `Text` (D115). -/
def textFunction (p : Text) : Option Text :=
  List.lookup p [
    ("Text.length", "TLEN"), ("Text.code", "deus_text_code"), ("Text.slice", "deus_text_slice"),
    ("Text.fromCode", "deus_text_from_code"), ("Text.concat", "deus_text_concat"), ("Text.join", "deus_text_join"),
    ("Text.split", "deus_text_split"), ("Text.indexOf", "deus_text_index"), ("Text.trim", "deus_text_trim"),
    ("Int.toText", "deus_int_text"), ("Int.fromText", "deus_text_int"),
    ("Dict.fromList", "deus_dict_from_list"), ("Dict.lookup", "deus_dict_lookup"), ("Dict.contains", "deus_dict_contains"),
    ("Dict.size", "deus_table_size"), ("Dict.keys", "deus_table_keys"), ("MutMap.new", "deus_table_new"),
    ("MutMap.get", "deus_table_get"), ("MutMap.has", "deus_table_has"), ("MutMap.set", "deus_table_set"),
    ("MutMap.delete", "deus_table_delete"), ("MutMap.size", "deus_table_size"), ("MutMap.keys", "deus_table_keys"),
    ("Text.utf8", "deus_text_utf8"), ("Text.fromCodes", "deus_text_from_codes"), ("Text.sha256", "deus_text_sha256"),
    ("deus.abortValue", "deus_abort_marker"), ("deus.aborted", "deus_aborted"), ("deus.abortTo", "deus_abort_to"),
    ("deus.caught", "deus_caught"), ("deus.caughtValue", "deus_caught_value"), ("deus.handleEnter", "deus_handle_enter"),
    ("deus.handleAdd", "deus_handle_add"), ("deus.handleExit", "deus_handle_exit"), ("deus.clause", "deus_clause"),
    ("deus.clauseDone", "deus_clause_done")]

/-- The index of the equality and order functions of data type `t`, registering them on first use. -/
def structIndex (scope : Wasm.Scope) (t : Sexp) : Int :=
  let known := Ref.get scope.eqs
  let i := List.findIndex (fun x => x == t) known
  if i >= 0 then i else registerStruct scope t

def registerStruct (scope : Wasm.Scope) (t : Sexp) : Int :=
  let known := Ref.get scope.eqs
  let _ := Ref.set scope.eqs (known ++ [t])
  List.length known

/-- `x` and `y`, of type `field`, compared for equality (a C truth value) or, with `order`, as -1, 0 or 1. -/
def fieldTest (scope : Wasm.Scope) (order : Bool) (field : Sexp) (x : Text) (y : Text) : {Throw Text} Text :=
  let both := "(" ++ x ++ ", " ++ y ++ ")"
  if Wasm.isScalar field then (if order then "deus_int_cmp" ++ both else "(" ++ x ++ " == " ++ y ++ ")")
  else if field == Wasm.tref "#Text" then (if order then "deus_text_cmp" else "deus_text_eq") ++ both
  else if Wasm.isData scope field then (if order then "deus_cmp" else "deus_eq") ++ Int.toText (structIndex scope field) ++ both
  else if field == Wasm.unknown || Sexp.head field == "tvar" then (if order then "deus_cmp_any" else "deus_eq_any") ++ both
  else throw ("comparing values of type " ++ Sexp.print field ++ " is outside the C subset")

/--
  The structural equality (or, with `order`, the order) of data type `t`, as both kernels define
  it: the tags first, then the fields in order. The last field, when it is `t` again (a list's
  tail), is a loop rather than a call, so a long list takes no stack.
-/
def structFunction (scope : Wasm.Scope) (order : Bool) (k : Int) (t : Sexp) : {Throw Text} Text :=
  let form := Option.getOr (Option.bind (Wasm.headName t) (Wasm.typeObject scope)) Wasm.unknown
  let typeArgs := Wasm.typeArgs t
  let same := if order then "0" else "1"
  let cases := List.mapIndexed (fun tag fields =>
    let typed := List.map (Wasm.instantiate typeArgs) fields
    let n := List.length typed
    let field := fun (i : Int) (f : Sexp) =>
      let x := "UNBOX(a)[" ++ Int.toText (i + 1) ++ "]"
      let y := "UNBOX(b)[" ++ Int.toText (i + 1) ++ "]"
      if i == n - 1 && f == t then "a = " ++ x ++ "; b = " ++ y ++ "; continue; "
      else if i == n - 1 then "return " ++ fieldTest scope order f x y ++ "; "
      else if order then "{ V c = " ++ fieldTest scope order f x y ++ "; if (c) return c; } "
      else "if (!" ++ fieldTest scope order f x y ++ ") return 0; "
    if n == 0 then "" else "case " ++ Int.toText tag ++ ": " ++ Text.concat (List.mapIndexed field typed)) (Wasm.ctorFields form)
  let differ := if order then "ta < tb ? -1 : 1" else "0"
  "static V " ++ (if order then "deus_cmp" else "deus_eq") ++ Int.toText k ++ "(V a, V b) { for (;;) { if (a == b) return " ++ same ++ "; V ta = UNBOX(a)[0], tb = UNBOX(b)[0]; if (ta != tb) return " ++ differ ++ "; switch (ta) { " ++ Text.concat cases ++ "default: return " ++ same ++ "; } } }"

/-- The index of the `show` function of type `t`, kept beside the comparisons as `(show t)`. -/
def showIndex (scope : Wasm.Scope) (t : Sexp) : Int := structIndex scope (Sexp.list [Sexp.sym "show", t])

/-- C that appends the rendering of `x`, of type `t`, to the text `s`, as the kernels' `show` renders it. -/
def showCall (scope : Wasm.Scope) (t : Sexp) (s : Text) (x : Text) : {Throw Text} Text :=
  let both := "(" ++ s ++ ", " ++ x ++ ")"
  let put := fun (literal : Text) => "deus_put(" ++ s ++ ", \"" ++ literal ++ "\")"
  let head := Wasm.headName t
  if t == Wasm.tref "#Int" then "deus_show_int" ++ both
  else if t == Wasm.tref "#Bool" then "deus_put(" ++ s ++ ", " ++ x ++ " ? \"true\" : \"false\")"
  else if t == Wasm.tref "#Text" then "deus_show_text" ++ both
  else if t == Wasm.tref "#Unit" then put "()"
  else if Sexp.head t == "tfun" || List.any (fun n => head == some n) ["#Ref", "#Dict", "#MutMap"] then put "<function>"
  else if showable t && (head == some "#Array" || Option.isSome (Option.bind head (Wasm.typeObject scope))) then "deus_show" ++ Int.toText (showIndex scope t) ++ both
  else throw ("show on a value of type " ++ Sexp.print t ++ " is outside the C subset")

/-- Whether `t` is known to the last part, but for function types, which show as `<function>` whatever they take. -/
def showable (t : Sexp) : Bool :=
  match t with
  | Sexp.list [] => false
  | Sexp.list (Sexp.sym "tvar" :: _) => false
  | Sexp.list (Sexp.sym "tfun" :: _) => true
  | Sexp.list items => List.all showable items
  | _ => true

/-- The name the kernels show for constructor `tag` of the data type `n`: its type's first 8 characters and the tag. -/
def shownName (scope : Wasm.Scope) (n : Text) (tag : Int) : Text :=
  let key := if Option.isSome (List.lookup n scope.datatypes) then n
    else
      match List.find (fun entry => Wasm.typeObject scope n == some (snd entry)) scope.datatypes with
      | some entry => fst entry
      | none => n
  Text.take 8 key ++ "#" ++ Int.toText tag

/-- The `show` of type `t`: lists, pairs, options and arrays as the kernels write them, other data as `(name field…)`. -/
def showFunction (scope : Wasm.Scope) (k : Int) (t : Sexp) : {Throw Text} Text :=
  let typeArgs := Wasm.typeArgs t
  let arg := fun (i : Int) => Option.getOr (List.get? typeArgs i) Wasm.unknown
  let field := fun (i : Int) => "UNBOX(x)[" ++ Int.toText i ++ "]"
  let put := fun (literal : Text) => "s = deus_put(s, \"" ++ literal ++ "\"); "
  let body := match Wasm.headName t with
    | some "#List" => put "[" ++ "for (V c = x; UNBOX(c)[0]; c = UNBOX(c)[2]) { if (c != x) " ++ put ", " ++ "s = " ++ showCall scope (arg 0) "s" "UNBOX(c)[1]" ++ "; } " ++ put "]" ++ "return s;"
    | some "#Array" => put "#[" ++ "for (V i = 1; i <= UNBOX(x)[0]; i++) { if (i > 1) " ++ put ", " ++ "s = " ++ showCall scope (arg 0) "s" "UNBOX(x)[i]" ++ "; } " ++ put "]" ++ "return s;"
    | some "#Pair" => put "(" ++ "s = " ++ showCall scope (arg 0) "s" (field 1) ++ "; " ++ put ", " ++ "s = " ++ showCall scope (arg 1) "s" (field 2) ++ "; " ++ put ")" ++ "return s;"
    | some "#Option" => "if (UNBOX(x)[0] == 0) return deus_put(s, \"none\"); " ++ put "(some " ++ "s = " ++ showCall scope (arg 0) "s" (field 1) ++ "; " ++ put ")" ++ "return s;"
    | some n =>
      let form := Option.getOr (Wasm.typeObject scope n) Wasm.unknown
      let cases := List.mapIndexed (fun tag fields =>
        let typed := List.map (Wasm.instantiate typeArgs) fields
        let name := shownName scope n tag
        if List.isEmpty typed then "case " ++ Int.toText tag ++ ": return deus_put(s, \"" ++ name ++ "\"); "
        else "case " ++ Int.toText tag ++ ": " ++ put ("(" ++ name) ++ Text.concat (List.mapIndexed (fun i f => put " " ++ "s = " ++ showCall scope f "s" (field (i + 1)) ++ "; ") typed) ++ "return deus_put(s, \")\"); ") (Wasm.ctorFields form)
      "switch (UNBOX(x)[0]) { " ++ Text.concat cases ++ "} return s;"
    | none => throw ("show on a value of type " ++ Sexp.print t ++ " is outside the C subset")
  "static V deus_show" ++ Int.toText k ++ "(V s, V x) { " ++ body ++ " }"

/-- The comparison and `show` functions of every type registered from index `k`, registering what they use in turn. -/
def structFunctions (scope : Wasm.Scope) (k : Int) (acc : List Text) : {Throw Text} List Text :=
  match List.get? (Ref.get scope.eqs) k with
  | some (Sexp.list [Sexp.sym "show", t]) => structFunctions scope (k + 1) (acc ++ [showFunction scope k t])
  | some t => structFunctions scope (k + 1) (acc ++ [structFunction scope false k t, structFunction scope true k t])
  | none => acc

/-- How many arguments a primitive the C back end compiles takes, or 0. -/
def primArity (p : Text) : Int :=
  if List.any (fun x => x == p) ["Text.length", "Text.fromCode", "Text.concat", "Text.trim", "Int.toText", "Int.fromText", "Dict.fromList", "Dict.size", "Dict.keys", "MutMap.new", "MutMap.size", "MutMap.keys", "show", "Text.utf8", "Text.fromCodes", "Text.sha256"] then 1
  else if List.any (fun x => x == p) ["Text.slice", "Text.indexOf", "MutMap.set"] then 3
  else if Option.isSome (macro p) || Option.isSome (infix p) || List.any (fun x => x == p) ["Text.code", "Text.join", "Text.split", "append", "compare", "Dict.lookup", "Dict.contains", "MutMap.get", "MutMap.has", "MutMap.delete"] then 2
  else 0

/--
  A primitive the C runtime implements (D115): those on `Text`, `++` on texts and on lists, and
  comparisons of texts by their UTF-16 units, as JavaScript orders strings. None for the others.
-/
def runtime (ctx : FnCtx) (env : List Int) (owned : List Int) (token : Option Token) (p : Text) (xs : List Sexp) : {Throw Text} Option Text :=
  let types := List.map (Wasm.typeOf ctx.cScope env) xs
  let isText := List.any (fun t => t == Wasm.tref "#Text") types
  let isList := List.any (fun t => Wasm.headName t == some "#List") types
  -- Unknown (a lifted function's parameter) or a type variable (a hash whose names differ in type, D116).
  let isDynamic := not (List.isEmpty types) && List.all (fun t => t == Wasm.unknown || Sexp.head t == "tvar") types
  let data := List.find (fun t => Wasm.isData ctx.cScope t) types
  let lend := fun (call : List Text -> Text) => some (lending ctx env owned token (List.map (fun _ => true) xs) call xs)
  match textFunction p with
  | some f => lend (fun vs => f ++ args vs)
  | none =>
    if p == "show" then
      let t := Option.getOr (List.head? types) Wasm.unknown
      lend (fun vs => showCall ctx.cScope t "deus_text_cap(0, 16)" (Option.getOr (List.head? vs) "0"))
    else if p == "append" && isText then some (lending ctx env owned token [false, true] (fun vs => "deus_text_extend" ++ args vs) xs)
    else if p == "append" && isList then
      match sequence ctx env owned token [] xs with
      | (decls, values, _) => some ("({ " ++ decls ++ "deus_list_append" ++ args values ++ "; })")
    else if p == "append" && isDynamic then
      match sequence ctx env owned token [] xs with
      | (decls, values, _) => some ("({ " ++ decls ++ "deus_append_any" ++ args values ++ "; })")
    else if p == "append" then throw "++ on values not known to be Text or a List is outside the C subset"
    else if p == "compare" && isText then lend (fun vs => "deus_text_cmp" ++ args vs)
    else if p == "compare" && List.all Wasm.isScalar types then lend (fun vs => "deus_int_cmp" ++ args vs)
    else if p == "eq" && isText then lend (fun vs => "deus_text_eq" ++ args vs)
    else if p == "neq" && isText then lend (fun vs => "!deus_text_eq" ++ args vs)
    else if Option.isSome data && (Wasm.isComparison p || p == "compare") then
      let k := Int.toText (structIndex ctx.cScope (Option.getOr data Wasm.unknown))
      if p == "eq" then lend (fun vs => "deus_eq" ++ k ++ args vs)
      else if p == "neq" then lend (fun vs => "!deus_eq" ++ k ++ args vs)
      else if p == "compare" then lend (fun vs => "deus_cmp" ++ k ++ args vs)
      else
        match infix p with
        | some op => lend (fun vs => "(V)(deus_cmp" ++ k ++ args vs ++ " " ++ op ++ " 0)")
        | none => none
    else if p == "compare" && isDynamic then lend (fun vs => "deus_cmp_any" ++ args vs)
    else if p == "eq" && isDynamic then lend (fun vs => "deus_eq_any" ++ args vs)
    else if p == "neq" && isDynamic then lend (fun vs => "!deus_eq_any" ++ args vs)
    else if isDynamic && Wasm.isComparison p then
      match infix p with
      | some op => lend (fun vs => "(V)(deus_cmp_any" ++ args vs ++ " " ++ op ++ " 0)")
      | none => none
    else if isText && Wasm.isComparison p then
      match infix p with
      | some op => lend (fun vs => "(V)(deus_text_cmp" ++ args vs ++ " " ++ op ++ " 0)")
      | none => none
    else none

/--
  A primitive. `Array` is a block `[length, item…]` and `Ref` a block `[value]` (D83). Their
  first argument is borrowed when it is a local used again later, so a read does not touch its
  count; otherwise it is dropped after the access. Reads `deus_dup` what they return; the writes
  drop what they overwrite. `Ref.set` returns `()`; `Array.set` is pure (D96) and returns the
  array, written in place when the code holds its only reference, else a copy.
-/
def primitive (ctx : FnCtx) (env : List Int) (owned : List Int) (token : Option Token) (e : Sexp) (p : Text) (xs : List Sexp) : {Throw Text} Text :=
  -- The container is a local the code still needs afterwards: borrow it rather than count it.
  let borrowed := if Text.startsWith "Array." p || Text.startsWith "Ref." p then
      match List.head? xs with
      | some (Sexp.list [Sexp.sym "var", Sexp.int i]) =>
        match List.get? env i with
        | some l => if isIn owned l then -1 else l
        | none => -1
      | _ => -1
    else -1
  let evaluated := if borrowed >= 0 && p != "Ref.new" && p != "Array.make" then
      match sequence ctx env owned token [] (List.drop 1 xs) with
      | (decls, values, _) => (decls, local borrowed :: values, true)
    else
      match sequence ctx env owned token [] xs with
      | (decls, values, _) => (decls, values, false)
  -- What a read returns is counted again, unless it is an `Int` or a `Bool`.
  let share := if uncounted (Wasm.typeOf ctx.cScope env e) then "" else "deus_dup"
  let item := match xs with
    | a :: _ => Wasm.typeArgs (Wasm.typeOf ctx.cScope env a)
    | [] => []
  let dropOld := if List.all uncounted item && not (List.isEmpty item) then "" else "deus_drop(old); "
  match evaluated with
  | (decls, vs, isBorrowed) =>
    let release := match List.head? vs with
      | some c => if isBorrowed then "" else "deus_drop(" ++ c ++ "); "
      | none => ""
    let unit := "STATIC(&deus_nullary[0])"
    let block := fun (code : Text) => "({ " ++ decls ++ code ++ "; })"
    match (p, vs, xs) with
    | ("Array.make", [n, x], _) => block ("deus_array(" ++ n ++ ", " ++ x ++ ")")
    | ("Array.length", [a], _) => block ("V r = UNBOX(" ++ a ++ ")[0]; " ++ release ++ "r")
    | ("Array.get", [a, i], _) => block ("V r = " ++ share ++ "(*AT(" ++ a ++ ", " ++ i ++ ")); " ++ release ++ "r")
    | ("Array.set", [a, i, x], _) =>
      -- An array the code owns passes its reference to the result; a borrowed one is copied.
      let target := if isBorrowed then "deus_array_copy(" ++ a ++ ")" else "deus_array_unique(" ++ a ++ ")"
      block ("V r = " ++ target ++ "; V *s = AT(r, " ++ i ++ "); V old = *s; *s = " ++ x ++ "; " ++ dropOld ++ "r")
    | ("Ref.new", [x], _) => block ("V *r = deus_block(K_REF, 1); r[0] = " ++ x ++ "; BOX(r)")
    | ("Ref.get", [r], _) => block ("V v = " ++ share ++ "(UNBOX(" ++ r ++ ")[0]); " ++ release ++ "v")
    | ("Ref.set", [r, x], _) => block ("V old = UNBOX(" ++ r ++ ")[0]; UNBOX(" ++ r ++ ")[0] = " ++ x ++ "; " ++ dropOld ++ release ++ unit)
    | (_, [ca, cb], [a, b]) =>
      let ta := Wasm.typeOf ctx.cScope env a
      let tb := Wasm.typeOf ctx.cScope env b
      if Wasm.isComparison p && not (Wasm.isScalar ta || Wasm.isScalar tb) then
        throw (p ++ " on values that are not known to be Int or Bool is outside the C subset, since it would compare addresses: " ++ Text.take 120 (Sexp.print e))
      else
        match (macro p, infix p) with
        | (some m, _) => block (m ++ "(" ++ ca ++ ", " ++ cb ++ ")")
        | (_, some op) => block ("(V)(" ++ ca ++ " " ++ op ++ " " ++ cb ++ ")")
        | _ => throw ("the primitive " ++ p ++ " is outside the C subset")
    | _ => throw ("the primitive " ++ p ++ " is outside the C subset")

/--
  A `match`. Each case that takes apart a block the code owns and does not use again reads its
  fields, then: if the block is unique, its fields' references pass to the case and its memory
  becomes the case's reuse token; if it is shared, the case `deus_dup`s the fields it uses and
  decrements the block.
-/
def matchForm (ctx : FnCtx) (env : List Int) (tail : Bool) (owned : List Int) (token : Option Token) (scrutinee : Sexp) (cases : List Sexp) : {Throw Text} Text :=
  let inCases := freeLocals env (Sexp.list (Sexp.sym "match" :: Sexp.list [Sexp.sym "int", Sexp.int 0] :: cases))
  -- A local is matched where it is: the cases own it if the code does, else they borrow it.
  let named := match scrutinee with
    | Sexp.list [Sexp.sym "var", Sexp.int i] => List.get? env i
    | _ => none
  let mine := List.filter (fun l => not (isIn inCases l) && some l != named) owned
  let rest := List.filter (fun l => isIn inCases l || some l == named) owned
  let v := Option.getOr named (fresh ctx)
  let vOwned := match named with
    | some l => isIn owned l
    | none => true
  let _ := match named with
    | some _ => ()
    | none => Wasm.setType ctx.cScope v (Wasm.typeOf ctx.cScope env scrutinee)
  let r := fresh ctx
  let done := "m" ++ Int.toText r
  let arms := List.map (fun c =>
    match c with
    | Sexp.list [Sexp.sym "case", pat, body] =>
      match pattern ctx v env pat with
      | (guard, bound, loads) =>
        let usedInBody := freeLocals bound body
        let vUsed := isIn usedInBody v
        let loaded := List.map (fun triple =>
          match triple with
          | (l, _, _) => l) loads
        let usedLoads := List.filter (isIn usedInBody) loaded
        let n := blockFields pat
        let ownedInBody := List.filter (fun l => l != v) rest ++ usedLoads ++ (if vUsed && vOwned then [v] else [])
        let shareFields := Text.concat (List.map (dupLocal ctx) usedLoads)
        let ownership := if n > 0 && not vUsed && vOwned then
            let direct := List.filter (fun triple =>
              match triple with
              | (_, parent, _) => parent == v) loads
            let nested := List.filter (fun triple =>
              match triple with
              | (_, parent, _) => parent != v) loads
            let directAt := fun (i : Int) => List.find (fun triple =>
              match triple with
              | (_, _, k) => k == i) direct
            -- Unique: the fields' references pass to the case; drop those it does not use.
            let keepNested := Text.concat (List.map (fun triple =>
              match triple with
              | (l, _, _) => if isIn usedInBody l then dupLocal ctx l else "") nested)
            let dropUnused := Text.concat (List.map (fun i =>
              match directAt i with
              | some (l, _, _) => if isIn usedInBody l then "" else dropLocal ctx l
              | none => "deus_drop(UNBOX(" ++ local v ++ ")[" ++ Int.toText (i + 1) ++ "]); ") (List.range 0 n))
            match token with
            | none =>
              if wants n body then
                let t := Token.mk (fresh ctx) n
                ("V *" ++ tokenName t ++ "; if (UNIQUE(" ++ local v ++ ")) { " ++ keepNested ++ dropUnused ++ tokenName t ++ " = UNBOX(" ++ local v ++ "); } else { " ++ shareFields ++ "HDR(" ++ local v ++ ") -= 256; " ++ tokenName t ++ " = 0; } ", some t)
              else ("if (UNIQUE(" ++ local v ++ ")) { " ++ keepNested ++ dropUnused ++ "deus_release(UNBOX(" ++ local v ++ ")); } else { " ++ shareFields ++ "HDR(" ++ local v ++ ") -= 256; } ", none)
            | some _ => ("if (UNIQUE(" ++ local v ++ ")) { " ++ keepNested ++ dropUnused ++ "deus_release(UNBOX(" ++ local v ++ ")); } else { " ++ shareFields ++ "HDR(" ++ local v ++ ") -= 256; } ", token)
          else (shareFields ++ (if vUsed || not vOwned then "" else dropLocal ctx v), token)
        match ownership with
        | (rc, caseToken) =>
          if tail then "do { " ++ guard ++ rc ++ expr ctx bound true ownedInBody caseToken body ++ " } while (0); "
          else "do { " ++ guard ++ rc ++ local r ++ " = " ++ expr ctx bound false ownedInBody caseToken body ++ "; goto " ++ done ++ "; } while (0); "
    | other => throw ("outside the C subset: " ++ Sexp.print other)) cases
  let head := match named with
    | some _ => Text.concat (List.map (dropLocal ctx) mine)
    | none => "V " ++ local v ++ " = " ++ expr ctx env false mine none scrutinee ++ "; "
  if tail then "{ " ++ head ++ Text.concat arms ++ "__builtin_trap(); }"
  else "({ " ++ head ++ "V " ++ local r ++ "; " ++ Text.concat arms ++ "__builtin_trap(); " ++ done ++ ": " ++ local r ++ "; })"

def params (n : Int) : Text := args (List.map (fun i => "V " ++ local i) (List.range 0 n))

/-- The C translation unit: every function, and `export` as an `int32_t` entry point. -/
def unit (fns : List Wasm.Fn) (datatypes : List (Text, Sexp)) (export : Text) : {Throw Text} Text :=
  let borrow := inferBorrow fns
  let lifted := Ref.new []
  let structs := Ref.new []
  let decls := List.mapIndexed (fun i f => "static V " ++ fnName i ++ params f.fnArity ++ ";") fns
  let bodies := List.mapIndexed (fun i f =>
    let scope := Wasm.Scope.mk fns datatypes (Ref.new (List.mapIndexed (fun j t => (j, t)) (fst (Wasm.peel f.fnArity f.fnType)))) structs
    let ctx := FnCtx.mk scope i f.fnArity (Ref.new f.fnArity) borrow lifted
    let env := List.reverse (List.range 0 f.fnArity)
    "/* #" ++ Text.take 10 f.fnHash ++ " */\nstatic V " ++ fnName i ++ params f.fnArity ++ " {\ntop:;\n  " ++ expr ctx env true (List.filter (fun k => not (borrowsAt (borrowsOf ctx i) k)) (List.range 0 f.fnArity)) none f.fnBody ++ "\n}") fns
  let arity := Option.getOr (Option.map (fun f => f.fnArity) (List.head? fns)) 0
  let inputs := List.range 0 arity
  let entry := "EXPORT(\"" ++ export ++ "\") int32_t " ++ export ++ args (List.map (fun i => "int32_t a" ++ Int.toText i) inputs) ++ " { if (!deus_base) deus_init(); return (int32_t)f0" ++ args (List.map (fun i => "(V)a" ++ Int.toText i) inputs) ++ "; }"
  let result := match List.head? fns with
    | some f => snd (Wasm.peel f.fnArity f.fnType)
    | none => Wasm.unknown
  let argv := List.map (fun i => "(int32_t)atol(argv[" ++ Int.toText (i + 1) ++ "])") inputs
  -- A Text result prints as the interpreter shows it: JSON, in UTF-8.
  let run := if result == Wasm.tref "#Text" then
      "  deus_init(); V r = f0" ++ args (List.map (fun a => "(V)" ++ a) argv) ++ "; deus_print_text(r); deus_drop(r);"
    else "  printf(\"%d\\n\", " ++ export ++ args argv ++ ");"
  let main := Text.join "\n" [
    "#ifdef __wasm__",
    "EXPORT(\"deus_live\") int32_t deus_live_words(void) { return (int32_t)deus_live; }",
    "#elif defined(DEUS_MAIN)",
    "#include <stdio.h>",
    "static void deus_print_text(V t) { V n = TLEN(t); uint16_t *x = TU(t); putchar('\"'); for (V i = 0; i < n; i++) { uint32_t u = x[i]; if (u == '\"' || u == '\\\\') { putchar('\\\\'); putchar(u); } else if (u == '\\n') fputs(\"\\\\n\", stdout); else if (u == '\\r') fputs(\"\\\\r\", stdout); else if (u == '\\t') fputs(\"\\\\t\", stdout); else if (u == 8) fputs(\"\\\\b\", stdout); else if (u == 12) fputs(\"\\\\f\", stdout); else if (u < 32) printf(\"\\\\u%04x\", u); else if (u >= 0xd800 && u < 0xdc00 && i + 1 < n && x[i + 1] >= 0xdc00 && x[i + 1] < 0xe000) { uint32_t c = 0x10000 + ((u - 0xd800) << 10) + (x[++i] - 0xdc00); putchar(0xf0 | c >> 18); putchar(0x80 | (c >> 12 & 63)); putchar(0x80 | (c >> 6 & 63)); putchar(0x80 | (c & 63)); } else if (u >= 0xd800 && u < 0xe000) printf(\"\\\\u%04x\", u); else if (u < 0x80) putchar(u); else if (u < 0x800) { putchar(0xc0 | u >> 6); putchar(0x80 | (u & 63)); } else { putchar(0xe0 | u >> 12); putchar(0x80 | (u >> 6 & 63)); putchar(0x80 | (u & 63)); } } puts(\"\\\"\"); }",
    "int main(int argc, char **argv) {",
    "  if (argc != " ++ Int.toText (arity + 1) ++ ") { fprintf(stderr, \"usage: %s" ++ Text.concat (List.map (fun _ => " <int>") inputs) ++ "\\n\", argv[0]); return 2; }",
    run,
    "  if (getenv(\"DEUS_HEAP_STATS\")) fprintf(stderr, \"heap: %ld words bumped, %ld live, %ld peak\\n\", (long)(deus_hp - deus_base), (long)deus_live, (long)deus_peak);",
    "  return 0;",
    "}",
    "#endif"]
  let nullary := List.foldl (fun acc f => larger acc (nullaryCount f.fnBody)) 0 fns
  let codes := Ref.get lifted
  let codeDecls := List.mapIndexed (fun k _ => "static V c" ++ Int.toText k ++ "(V, V);") codes
  let comparisons := structFunctions (Wasm.Scope.mk fns datatypes (Ref.new []) structs) 0 []
  let comparisonDecls := List.mapIndexed (fun k t =>
    if Sexp.head t == "show" then "static V deus_show" ++ Int.toText k ++ "(V, V);"
    else "static V deus_eq" ++ Int.toText k ++ "(V, V); static V deus_cmp" ++ Int.toText k ++ "(V, V);") (Ref.get structs)
  Text.join "\n" ([prelude nullary] ++ decls ++ codeDecls ++ comparisonDecls ++ [""] ++ bodies ++ codes ++ comparisons ++ ["", entry, main, ""])

--
-- Lambda lifting. A `letrec` function becomes a top-level function that takes the locals it
-- captures as extra leading parameters, so recursion is a direct call and never a closure
-- that holds itself (a cycle reference counting could not free).
--

/-- The variables of `e` bound outside it, below `depth` binders, as indices outside them. -/
def freeVars (depth : Int) (e : Sexp) : List Int :=
  match e with
  | Sexp.list [Sexp.sym "var", Sexp.int i] => if i >= depth then [i - depth] else []
  | Sexp.list [Sexp.sym "lam", b] => freeVars (depth + 1) b
  | Sexp.list [Sexp.sym "let", v, b] => freeVars depth v ++ freeVars (depth + 1) b
  | Sexp.list [Sexp.sym "letrec", Sexp.list fs, b] =>
    let n := List.length fs
    List.concatMap (freeVars (depth + n)) fs ++ freeVars (depth + n) b
  | Sexp.list (Sexp.sym "match" :: scrutinee :: cases) =>
    freeVars depth scrutinee ++ List.concatMap (fun c =>
      match c with
      | Sexp.list [Sexp.sym "case", pat, b] => freeVars (depth + binders pat) b
      | _ => []) cases
  | Sexp.list items => List.concatMap (freeVars depth) items
  | _ => []

/-- `e` with each variable `i` bound outside it replaced by `sub i`, a term outside `e`'s binders. -/
def subst (depth : Int) (sub : Int -> Sexp) (e : Sexp) : Sexp :=
  let again := fun (d : Int) (x : Sexp) => subst d sub x
  match e with
  | Sexp.list [Sexp.sym "var", Sexp.int i] => if i < depth then e else shift depth 0 (sub (i - depth))
  | Sexp.list [Sexp.sym "lam", b] => Sexp.list [Sexp.sym "lam", again (depth + 1) b]
  | Sexp.list [Sexp.sym "let", v, b] => Sexp.list [Sexp.sym "let", again depth v, again (depth + 1) b]
  | Sexp.list [Sexp.sym "letrec", Sexp.list fs, b] =>
    let n := List.length fs
    Sexp.list [Sexp.sym "letrec", Sexp.list (List.map (again (depth + n)) fs), again (depth + n) b]
  | Sexp.list (Sexp.sym "match" :: scrutinee :: cases) =>
    Sexp.list (Sexp.sym "match" :: again depth scrutinee :: List.map (fun c =>
      match c with
      | Sexp.list [Sexp.sym "case", pat, b] => Sexp.list [Sexp.sym "case", pat, again (depth + binders pat) b]
      | other => other) cases)
  | Sexp.list items => Sexp.list (List.map (again depth) items)
  | _ => e

def var (i : Int) : Sexp := Sexp.list [Sexp.sym "var", Sexp.int i]

/-- `h` applied to the captures, where capture `t` is the term `at t`. -/
def lifted (h : Text) (count : Int) (at : Int -> Sexp) : Sexp :=
  if count == 0 then Sexp.list [Sexp.sym "ref", Sexp.str h]
  else Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "ref", Sexp.str h] :: List.map at (List.range 0 count))

/-- `e` with every `letrec` lifted out; the lifted functions are added to `out`. -/
def liftExpr (parent : Text) (next : Ref Int) (out : Ref (List Wasm.Fn)) (e : Sexp) : {Throw Text} Sexp :=
  let again := fun (x : Sexp) => liftExpr parent next out x
  match e with
  | Sexp.list [Sexp.sym "letrec", Sexp.list fs, b] =>
    let n := List.length fs
    let caps := List.dedup (List.concatMap (freeVars n) fs)
    let count := List.length caps
    let names := List.map (fun _ =>
      let k := Ref.get next
      let _ := Ref.set next (k + 1)
      parent ++ "/rec" ++ Int.toText k) fs
    let capAt := fun (o : Int) => count - 1 - List.findIndex (fun c => c == o) caps
    -- Inside a lifted function, outside its own parameters, capture t is (var count-1-t).
    let inside := fun (o : Int) =>
      if o < n then lifted (Option.getOr (List.get? names (n - 1 - o)) "") count (fun t => var (count - 1 - t))
      else var (capAt (o - n))
    let _ := List.map (fun pair =>
      match pair with
      | (name, f) =>
        match Wasm.unlam f with
        | (0, _) => throw "a letrec binding that is not a lambda is outside the C subset"
        | (arity, body) =>
          let lifted := liftExpr parent next out (subst arity inside body)
          Ref.set out (Ref.get out ++ [Wasm.Fn.mk name (count + arity) lifted Wasm.unknown])) (List.zip names fs)
    let outside := fun (o : Int) =>
      if o < n then lifted (Option.getOr (List.get? names (n - 1 - o)) "") count (fun t => var (Option.getOr (List.get? caps t) 0))
      else var (o - n)
    again (subst 0 outside b)
  | Sexp.list items => Sexp.list (List.map again items)
  | _ => e

/-- Every function with its `letrec`s lifted into new functions after the originals. -/
def liftAll (fns : List Wasm.Fn) : {Throw Text} List Wasm.Fn :=
  let out := Ref.new []
  let next := Ref.new 0
  let done := List.map (fun f => Wasm.Fn.mk f.fnHash f.fnArity (liftExpr f.fnHash next out f.fnBody) f.fnType) fns
  done ++ Ref.get out

--
-- Effects (D124). A clause that resumes only in tail position needs no captured continuation:
-- performing calls it, and its tail `k x` returns `x` to the performer. A clause tail that does
-- not resume aborts: it stores its value and returns the abort marker, which every caller that
-- may see it checks and passes on, dropping what it owns, up to the handler. Both are rewritten
-- into Core over the `deus.*` runtime functions before lambda lifting, so reference counting
-- covers the new paths as it covers any other code.
--

def eVar (i : Int) : Sexp := Sexp.list [Sexp.sym "var", Sexp.int i]

def eInt (n : Int) : Sexp := Sexp.list [Sexp.sym "int", Sexp.int n]

def eLet (v : Sexp) (b : Sexp) : Sexp := Sexp.list [Sexp.sym "let", v, b]

def eIf (c : Sexp) (t : Sexp) (f : Sexp) : Sexp := Sexp.list [Sexp.sym "if", c, t, f]

def eSeq (a : Sexp) (b : Sexp) : Sexp := Sexp.list [Sexp.sym "seq", a, b]

/-- `b` under `n` lambdas. -/
def eLams (n : Int) (b : Sexp) : Sexp := if n == 0 then b else Sexp.list [Sexp.sym "lam", eLams (n - 1) b]

/-- The abort marker, as a value. -/
def effAbort : Sexp := Unique.applyPrim "deus.abortValue" [eInt 0]

/-- Whether variable `d` occurs free in `e`. -/
def effOccurs (d : Int) (e : Sexp) : Bool :=
  match e with
  | Sexp.list [Sexp.sym "var", Sexp.int i] => i == d
  | Sexp.list [Sexp.sym "lam", b] => effOccurs (d + 1) b
  | Sexp.list [Sexp.sym "let", v, b] => effOccurs d v || effOccurs (d + 1) b
  | Sexp.list [Sexp.sym "letrec", Sexp.list fs, b] =>
    let n := List.length fs
    List.any (effOccurs (d + n)) fs || effOccurs (d + n) b
  | Sexp.list (Sexp.sym "match" :: scrutinee :: cases) =>
    effOccurs d scrutinee || List.any (fun c =>
      match c with
      | Sexp.list [Sexp.sym "case", pat, b] => effOccurs (d + binders pat) b
      | _ => false) cases
  | Sexp.list [Sexp.sym "ret", b] => effOccurs (d + 1) b
  | Sexp.list [Sexp.sym "on", _, _, Sexp.int k, b] => effOccurs (d + k + 1) b
  | Sexp.list items => List.any (effOccurs d) items
  | _ => false

def effResumeError : Text := "a handler that resumes other than in tail position is outside the C subset"

/--
  A clause body whose continuation is variable `d`: a tail `k x` becomes `x`, and any other tail
  aborts to the handler with its value. `k` anywhere else is refused.
-/
def effClauseTails (d : Int) (e : Sexp) : {Throw Text} Sexp :=
  let plain := fun (x : Sexp) => if effOccurs d x then throw effResumeError else x
  match e with
  | Sexp.list [Sexp.sym "app", Sexp.list [Sexp.sym "var", Sexp.int i], x] => if i == d then plain x else Unique.applyPrim "deus.abortTo" [plain e]
  | Sexp.list [Sexp.sym "let", v, b] => eLet (plain v) (effClauseTails (d + 1) b)
  | Sexp.list [Sexp.sym "seq", a, b] => eSeq (plain a) (effClauseTails d b)
  | Sexp.list [Sexp.sym "if", c, t, f] => eIf (plain c) (effClauseTails d t) (effClauseTails d f)
  | Sexp.list (Sexp.sym "match" :: scrutinee :: cases) =>
    Sexp.list (Sexp.sym "match" :: plain scrutinee :: List.map (fun c =>
      match c with
      | Sexp.list [Sexp.sym "case", pat, b] => Sexp.list [Sexp.sym "case", pat, effClauseTails (d + binders pat) b]
      | other => plain other) cases)
  | Sexp.list [Sexp.sym "letrec", Sexp.list fs, b] =>
    let n := List.length fs
    if List.any (effOccurs (d + n)) fs then throw effResumeError
    else Sexp.list [Sexp.sym "letrec", Sexp.list fs, effClauseTails (d + n) b]
  | _ => if e == effAbort then e else Unique.applyPrim "deus.abortTo" [plain e]

/-- Whether `e` has a handler clause with a tail that does not resume. -/
def effAborting (e : Sexp) : {Throw Text} Bool :=
  match e with
  | Sexp.list [Sexp.sym "on", _, _, _, b] => Text.indexOf (Sexp.print (effClauseTails 0 b)) "deus.abortTo" 0 >= 0 || effAborting b
  | Sexp.list items => List.any effAborting items
  | _ => false

/-- Whether calling `h` may return the abort marker: a primitive or constructor never does, a definition only when `aborts` names it. -/
def effCallAborts (aborts : List Text) (h : Sexp) : Bool :=
  match h with
  | Sexp.list [Sexp.sym "prim", _] => false
  | Sexp.list (Sexp.sym "con" :: _) => false
  | Sexp.list [Sexp.sym "ref", Sexp.str r] => List.contains r aborts
  | _ => true

/-- Whether evaluating `e` may return the abort marker; making a closure never does. -/
def effMayAbort (aborts : List Text) (e : Sexp) : Bool :=
  match e with
  | Sexp.list [Sexp.sym "lam", _] => false
  | Sexp.list (Sexp.sym "handle" :: _) => true
  | Sexp.list (Sexp.sym "app" :: h :: xs) => effCallAborts aborts h || List.any (effMayAbort aborts) (h :: xs)
  | Sexp.list [Sexp.sym "letrec", _, b] => effMayAbort aborts b
  | Sexp.list items => List.any (effMayAbort aborts) items
  | _ => false

/-- The definitions that may return the abort marker: those that perform, handle or call an unknown function, and their callers. -/
def effAbortingFns (fns : List Wasm.Fn) (known : List Text) : List Text :=
  let more := List.filter (fun f => not (List.contains f.fnHash known) && effMayAbort known f.fnBody) fns
  if List.isEmpty more then known else effAbortingFns fns (known ++ List.map (fun f => f.fnHash) more)

/-- Whether evaluating `e` can neither abort nor observe the order it runs in. -/
def effAtomic (e : Sexp) : Bool :=
  match e with
  | Sexp.list (Sexp.sym "var" :: _) => true
  | Sexp.list (Sexp.sym "ref" :: _) => true
  | Sexp.list (Sexp.sym "int" :: _) => true
  | Sexp.list (Sexp.sym "text" :: _) => true
  | Sexp.list (Sexp.sym "con" :: _) => true
  | Sexp.list (Sexp.sym "prim" :: _) => true
  | Sexp.list (Sexp.sym "op" :: _) => true
  | Sexp.list (Sexp.sym "lam" :: _) => true
  | _ => false

/-- `v` bound, then the abort marker if it is one, else `b`, which sees `v` as variable 0. -/
def effChecked (v : Sexp) (b : Sexp) : Sexp := eLet v (eIf (Unique.applyPrim "deus.aborted" [eVar 0]) effAbort b)

/--
  `build` of `xs`, evaluated in order. An operand that may abort is bound and checked first, and
  so is every operand before it that is not atomic, so the order of evaluation stays.
-/
def effHoist (aborts : List Text) (xs : List Sexp) (done : List Sexp) (build : List Sexp -> Sexp) : Sexp :=
  match xs with
  | [] => build done
  | x :: rest =>
    let next := fun (u : Unit) => effHoist aborts (List.map (shift 1 0) rest) (List.map (shift 1 0) done ++ [eVar 0]) build
    if effMayAbort aborts x then effChecked (effNorm aborts x) (next ())
    else if not (effAtomic x) && List.any (effMayAbort aborts) rest then eLet (effNorm aborts x) (next ())
    else effHoist aborts rest (done ++ [effNorm aborts x]) build

/-- `e` with every value that may be the abort marker checked before it is used; in tail position it is returned as it is. -/
def effNorm (aborts : List Text) (e : Sexp) : Sexp :=
  let may := effMayAbort aborts
  -- `e`'s first part bound and checked, the rest (a form whose first part is a placeholder) shifted under it.
  let first := fun (x : Sexp) (form : Sexp) =>
    match shift 1 0 form with
    | Sexp.list (h :: _ :: rest) => effChecked (effNorm aborts x) (Sexp.list (h :: eVar 0 :: rest))
    | other => other
  match e with
  | Sexp.list [Sexp.sym "lam", b] => Sexp.list [Sexp.sym "lam", effNorm aborts b]
  | Sexp.list (Sexp.sym "app" :: parts) => effHoist aborts parts [] (fun ps => Sexp.list (Sexp.sym "app" :: ps))
  | Sexp.list [Sexp.sym "let", v, b] => if may v then effChecked (effNorm aborts v) (effNorm aborts b) else eLet (effNorm aborts v) (effNorm aborts b)
  | Sexp.list [Sexp.sym "seq", a, b] => if may a then effChecked (effNorm aborts a) (shift 1 0 (effNorm aborts b)) else eSeq (effNorm aborts a) (effNorm aborts b)
  | Sexp.list [Sexp.sym "if", c, t, f] =>
    let branches := eIf (eInt 0) (effNorm aborts t) (effNorm aborts f)
    if may c then first c branches else eIf (effNorm aborts c) (effNorm aborts t) (effNorm aborts f)
  | Sexp.list (Sexp.sym "match" :: scrutinee :: cases) =>
    let normed := List.map (fun c =>
      match c with
      | Sexp.list [Sexp.sym "case", pat, b] => Sexp.list [Sexp.sym "case", pat, effNorm aborts b]
      | other => other) cases
    if may scrutinee then first scrutinee (Sexp.list (Sexp.sym "match" :: eInt 0 :: normed))
    else Sexp.list (Sexp.sym "match" :: effNorm aborts scrutinee :: normed)
  | Sexp.list [Sexp.sym "letrec", Sexp.list fs, b] => Sexp.list [Sexp.sym "letrec", Sexp.list (List.map (effNorm aborts) fs), effNorm aborts b]
  | Sexp.list (Sexp.sym "handle" :: b :: clauses) =>
    Sexp.list (Sexp.sym "handle" :: effNorm aborts b :: List.map (fun c =>
      match c with
      | Sexp.list [Sexp.sym "ret", rb] => Sexp.list [Sexp.sym "ret", effNorm aborts rb]
      | Sexp.list [Sexp.sym "on", a, i, k, body] => Sexp.list [Sexp.sym "on", a, i, k, effNorm aborts body]
      | other => other) clauses)
  | _ => e

/-- `xs` bound in order around `body`, which sees the last of them as variable 0. -/
def effBind (xs : List Sexp) (body : Sexp) : Sexp :=
  match xs with
  | [] => body
  | x :: rest => eLet x (effBind (List.map (shift 1 0) rest) body)

/-- Performing operation `i` of ability `a` with `k` arguments: the arguments, then the clause, called with the handler hidden. -/
def effPerform (a : Int) (i : Int) (args : List Sexp) : Sexp :=
  let k := List.length args
  let call := Sexp.list (Sexp.sym "app" :: eVar 0 :: List.map (fun j => eVar (k - j)) (List.range 0 k))
  effBind args (eLet (Unique.applyPrim "deus.clause" [eInt a, eInt i]) (eLet call (Unique.applyPrim "deus.clauseDone" [eVar 0])))

/--
  A handler: its clauses installed as closures, the body run, the handler removed, then the value
  an aborting clause left for it, the abort marker passed on, or the `ret` clause.
-/
def effHandler (abilities : List Text) (b : Sexp) (clauses : List Sexp) : {Throw Text} Sexp :=
  let added := List.filterMap (fun c =>
    match c with
    | Sexp.list [Sexp.sym "on", Sexp.str a, Sexp.int i, Sexp.int k, body] =>
      let clause := eLams k (shift (-1) 1 (effLower abilities (effClauseTails 0 body)))
      some (Unique.applyPrim "deus.handleAdd" [eVar 0, eInt (List.findIndex (fun x => x == a) abilities), eInt i, shift 1 0 clause])
    | _ => none) clauses
  let returned := match List.find (fun c => Sexp.head c == "ret") clauses with
    | some (Sexp.list [Sexp.sym "ret", rb]) => shift 1 1 (effLower abilities rb)
    | _ => eVar 0
  let after := eSeq (Unique.applyPrim "deus.handleExit" [eVar 1]) (eIf (Unique.applyPrim "deus.caught" [eVar 1, eVar 0]) (Unique.applyPrim "deus.caughtValue" [eInt 0]) (eIf (Unique.applyPrim "deus.aborted" [eVar 0]) effAbort returned))
  eLet (Unique.applyPrim "deus.handleEnter" [eInt 0]) (List.foldr (fun x acc => eSeq x acc) (eLet (shift 1 0 b) after) added)

/-- `e` with its operations performed and its handlers installed through the runtime. -/
def effLower (abilities : List Text) (e : Sexp) : {Throw Text} Sexp :=
  match e with
  | Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "op", Sexp.str a, Sexp.int i, Sexp.int k] :: xs) =>
    let n := List.length xs
    if n < k then throw "an operation applied to fewer arguments than it takes is outside the C subset"
    else
      let performed := effPerform (List.findIndex (fun x => x == a) abilities) i (List.map (effLower abilities) (List.take k xs))
      if n == k then performed else Sexp.list (Sexp.sym "app" :: performed :: List.map (effLower abilities) (List.drop k xs))
  | Sexp.list [Sexp.sym "op", _, _, _] => throw "an operation used as a value is outside the C subset"
  | Sexp.list (Sexp.sym "handle" :: b :: clauses) => effHandler abilities (effLower abilities b) clauses
  | Sexp.list items => Sexp.list (List.map (effLower abilities) items)
  | _ => e

/-- `fns` with handlers and operations rewritten into Core over the runtime (D124); unchanged when none performs or handles. -/
def effects (fns : List Wasm.Fn) : {Throw Text} List Wasm.Fn :=
  let abilities := List.dedup (List.concatMap (fun f => JsGen.abilitiesOf f.fnBody) fns)
  if List.isEmpty abilities then fns
  else
    let rebuild := fun (f : Wasm.Fn) (body : Sexp) => Wasm.Fn.mk f.fnHash f.fnArity body f.fnType
    let normed := if List.any (fun f => effAborting f.fnBody) fns then
        let aborts := effAbortingFns fns []
        List.map (fun f => rebuild f (effNorm aborts f.fnBody)) fns
      else fns
    List.map (fun f => rebuild f (effLower abilities f.fnBody)) normed

/-- The data types whose constructors `form` applies. -/
def builtTypes (form : Sexp) : List Text :=
  match form with
  | Sexp.list (Sexp.sym "con" :: Sexp.str t :: _) => if t == "#Bool" then [] else [t]
  | Sexp.list items => List.concatMap builtTypes items
  | _ => []

/-- Compiles `main` and what it calls to C exporting it as `export`. -/
def compile (fetch : Text -> {Throw Text | r} Option Sexp) (meta : Text -> {Throw Text | r} Option Sexp) (main : Text) (export : Text) : {Throw Text | r} Text :=
  let fns := liftAll (effects (Wasm.gather fetch meta main))
  -- The types the code builds as well as the ones it matches, so comparisons know their constructors.
  let names := List.dedup (List.concatMap (fun f => Wasm.patternTypes f.fnBody ++ builtTypes f.fnBody) fns)
  -- A definition that is only a primitive is inlined at its calls and gathers to nothing.
  if List.isEmpty fns then throw (export ++ " is a primitive, not a definition the C back end compiles")
  else unit fns (List.filterMap (fun t => Option.map (fun form => (t, form)) (fetch t)) names) export

end CGen
