/-
  A WebAssembly back end (D51): compiles a definition and the definitions it calls to a binary
  wasm module, written byte by byte in DEUS.

  The subset is first-order code over integers and algebraic data: every definition is a
  function of values to a value, built from literals, locals, `let`, `seq`, `if`, `match`,
  constructors, integer and comparison primitives, and saturated calls of other such
  definitions. A call in tail position is a `return_call`, so recursion that loops runs in
  constant stack. Anything else (closures, text, effects) is refused with the form that is out
  of the subset; such programs run on the wasm kernel instead (D41).

  Values are `i32`s. `Int` and `Bool` (0, 1) are themselves; any other constructed value
  (D56) points at a block `[tag, field…]` in linear memory, allocated by bumping a heap pointer
  that grows memory as needed and never frees. The module exports `memory` and `alloc`, so a host
  can build arguments and read results.

  `Int.div` and `Int.mod` by zero trap rather than raise a defect.

  `==`, `!=` and the order primitives compare `i32`s, which is right only for `Int` and `Bool`; on
  a constructed value it would compare addresses. The compiler follows each definition's stored
  type through its locals (D69) and refuses a comparison unless one side is an `Int` or `Bool`.
-/

namespace Wasm

--
-- Encoding.
--

def uleb (n : Int) : List Int :=
  let byte := Int.and n 127
  let rest := Int.ushr n 7
  if rest == 0 then [byte] else Int.or byte 128 :: uleb rest

def sleb (n : Int) : List Int :=
  let byte := Int.and n 127
  let rest := Int.shr n 7
  if (rest == 0 && Int.and byte 64 == 0) || (rest == -1 && Int.and byte 64 != 0) then [byte]
  else Int.or byte 128 :: sleb rest

def vec (items : List (List Int)) : List Int := uleb (List.length items) ++ List.concat items

def name (t : Text) : List Int :=
  let bytes := Text.utf8 t
  uleb (List.length bytes) ++ bytes

def section (id : Int) (body : List Int) : List Int := id :: uleb (List.length body) ++ body

def i32 : Int := 127

--
-- The subset.
--

/-- A definition in the module: its hash, parameter count, body and stored type (`()` if none). -/
structure Fn @"urn:deus:wasm:Fn" where
  fnHash : Text
  fnArity : Int
  fnBody : Sexp
  fnType : Sexp

/--
  What compiling one definition sees: the module's functions, the data types its patterns name
  (`(type …)` objects by hash), and the type known for each local so far.
-/
structure Scope @"urn:deus:wasm:Scope" where
  fns : List Fn
  datatypes : List (Text, Sexp)
  typed : Ref (List (Int, Sexp))

/-- `(lam (lam … b))` as (parameter count, b). -/
def unlam (core : Sexp) : (Int, Sexp) :=
  match core with
  | Sexp.list [Sexp.sym "lam", b] =>
    match unlam b with
    | (n, inner) => (n + 1, inner)
  | _ => (0, core)

def binary (name : Text) : Option Int :=
  if name == "Int.add" then some 106
  else if name == "Int.sub" then some 107
  else if name == "Int.mul" then some 108
  else if name == "Int.div" then some 109
  else if name == "Int.mod" then some 111
  else if name == "Int.and" then some 113
  else if name == "Int.or" then some 114
  else if name == "Int.xor" then some 115
  else if name == "Int.shl" then some 116
  else if name == "Int.shr" then some 117
  else if name == "Int.ushr" then some 118
  else if name == "eq" then some 70
  else if name == "neq" then some 71
  else if name == "lt" then some 72
  else if name == "gt" then some 74
  else if name == "le" then some 76
  else if name == "ge" then some 78
  else none

def unknown : Sexp := Sexp.list []

def tref (t : Text) : Sexp := Sexp.list [Sexp.sym "tref", Sexp.str t]

/-- Whether `p` is a comparison, whose result is a `Bool`. -/
def isComparison (p : Text) : Bool := List.any (fun x => x == p) ["eq", "neq", "lt", "gt", "le", "ge"]

/-- Whether a value of type `t` is an `i32` that is the value itself, not an address. -/
def isScalar (t : Sexp) : Bool := t == tref "#Int" || t == tref "#Bool"

/-- `t` with each type variable replaced as `binding` says. -/
def substitute (binding : Sexp -> Option Sexp) (t : Sexp) : Sexp :=
  match t with
  | Sexp.list [Sexp.sym "tvar", _] => Option.getOr (binding t) t
  | Sexp.list items => Sexp.list (List.map (substitute binding) items)
  | _ => t

/-- The variables of `pattern` that `actual` fixes, as (variable, type). -/
def matchType (pattern : Sexp) (actual : Sexp) : List (Sexp, Sexp) :=
  match (pattern, actual) with
  | (Sexp.list [Sexp.sym "tvar", _], _) => if actual == unknown then [] else [(pattern, actual)]
  | (Sexp.list xs, Sexp.list ys) => if List.length xs == List.length ys then List.concatMap (fun pair => matchType (fst pair) (snd pair)) (List.zip xs ys) else []
  | _ => []

/-- A function type's first `n` parameter types and what remains. -/
def peel (n : Int) (t : Sexp) : (List Sexp, Sexp) :=
  if n == 0 then ([], t)
  else
    match t with
    | Sexp.list (Sexp.sym "tfun" :: a :: b :: _) =>
      match peel (n - 1) b with
      | (params, result) => (a :: params, result)
    | _ => (List.replicate n unknown, unknown)

/-- The arguments of a type `(tapp (tref "T") a …)`; none for `(tref "T")`. -/
def typeArgs (t : Sexp) : List Sexp :=
  match t with
  | Sexp.list (Sexp.sym "tapp" :: _ :: args) => args
  | _ => []

/-- The type of field `i` of constructor `tag` of data type `typeHash`, at the scrutinee's type. -/
def fieldType (scope : Scope) (typeHash : Text) (tag : Int) (i : Int) (scrutinee : Sexp) : Sexp :=
  match List.lookup typeHash scope.datatypes with
  | some (Sexp.list (Sexp.sym "type" :: _ :: _ :: ctors)) =>
    match List.get? ctors tag with
    | some (Sexp.list (Sexp.sym "ctor" :: _ :: fields)) =>
      let args := typeArgs scrutinee
      match List.get? fields i with
      | some field => substitute (fun v =>
          match v with
          | Sexp.list [Sexp.sym "tvar", Sexp.int k] => List.get? args k
          | _ => none) field
      | none => unknown
    | _ => unknown
  | _ => unknown

def typeOfLocal (scope : Scope) (local : Int) : Sexp := Option.getOr (List.lookup local (Ref.get scope.typed)) unknown

def setType (scope : Scope) (local : Int) (t : Sexp) : Unit :=
  if t == unknown then () else Ref.set scope.typed ((local, t) :: Ref.get scope.typed)

/-- The type of `e` as far as the compiler can see it: `()` when it cannot. -/
def typeOf (scope : Scope) (env : List Int) (e : Sexp) : Sexp :=
  match e with
  | Sexp.list [Sexp.sym "int", _] => tref "#Int"
  | Sexp.list [Sexp.sym "con", Sexp.str t, _, _] => tref t
  | Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "con", Sexp.str t, _, _] :: _) => tref t
  | Sexp.list [Sexp.sym "var", Sexp.int i] =>
    match List.get? env i with
    | some local => typeOfLocal scope local
    | none => unknown
  | Sexp.list [Sexp.sym "app", Sexp.list [Sexp.sym "prim", Sexp.str "Int.neg"], _] => tref "#Int"
  | Sexp.list [Sexp.sym "app", Sexp.list [Sexp.sym "prim", Sexp.str p], _, _] => if isComparison p then tref "#Bool" else tref "#Int"
  | Sexp.list [Sexp.sym "if", _, t, f] =>
    let left := typeOf scope env t
    if left == unknown then typeOf scope env f else left
  | Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "ref", Sexp.str h] :: args) =>
    match List.find (fun f => f.fnHash == h) scope.fns with
    | some f =>
      match peel (List.length args) f.fnType with
      | (params, result) =>
        let bound := List.concatMap (fun pair => matchType (fst pair) (typeOf scope env (snd pair))) (List.zip params args)
        substitute (fun v => List.lookup v bound) result
    | none => unknown
  | _ => unknown

def refsOf (form : Sexp) : List Text :=
  match form with
  | Sexp.list [Sexp.sym "ref", Sexp.str h] => [h]
  | Sexp.list items => List.concatMap refsOf items
  | _ => []

/-- The data types a body's patterns take apart. -/
def patternTypes (form : Sexp) : List Text :=
  match form with
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str t :: rest) => t :: List.concatMap patternTypes rest
  | Sexp.list items => List.concatMap patternTypes items
  | _ => []

/-- A definition's stored type: its inferred scheme, else its signature, else `()`. -/
def storedType (meta : Option Sexp) : Sexp :=
  match Codebase.metaField meta "scheme" with
  | some t => t
  | none => Option.getOr (Codebase.metaField meta "sig") unknown

/-- The functions `main` reaches, `main` first; a definition that is not a function is refused. -/
def gather (fetch : Text -> {Throw Text | r} Option Sexp) (meta : Text -> {Throw Text | r} Option Sexp) (main : Text) : {Throw Text | r} List Fn :=
  let rec go pending seen acc :=
    match pending with
    | [] => List.reverse acc
    | h :: rest =>
      if List.any (fun x => x == h) seen then go rest seen acc
      else
        match fetch h with
        | some (Sexp.list [Sexp.sym "term", core]) =>
          match unlam core with
          | (0, _) => throw ("#" ++ Text.take 10 h ++ " is not a function, so it is outside the wasm subset")
          | (n, b) => go (rest ++ refsOf b) (h :: seen) (Fn.mk h n b (storedType (meta h)) :: acc)
        | _ => throw ("#" ++ Text.take 10 h ++ " is not a term the wasm back end can compile")
  go [main] [] []

def fresh (next : Ref Int) : Int :=
  let local := Ref.get next
  Ref.set next (local + 1)
  local

def localGet (l : Int) : List Int := 32 :: uleb l

def localSet (l : Int) : List Int := 33 :: uleb l

/-- `i32.load` / `i32.store` at a constant offset, 4-byte aligned. -/
def load (offset : Int) : List Int := [40, 2] ++ uleb offset

def store (offset : Int) : List Int := [54, 2] ++ uleb offset

/--
  A pattern test against the value in local `v`: code that leaves the current block (`br_if 0`)
  when it does not match, and the environment with what it binds (left to right, so the last
  binding is `var 0`).
-/
def pattern (scope : Scope) (next : Ref Int) (v : Int) (env : List Int) (pat : Sexp) : {Throw Text} (List Int, List Int) :=
  match pat with
  | Sexp.list [Sexp.sym "pany"] => ([], env)
  | Sexp.list [Sexp.sym "pvar"] => ([], v :: env)
  | Sexp.list [Sexp.sym "pas", p] => pattern scope next v (v :: env) p
  | Sexp.list [Sexp.sym "pint", Sexp.int n] => (localGet v ++ (65 :: sleb n) ++ [71, 13, 0], env)
  | Sexp.list [Sexp.sym "pcon", Sexp.str "#Bool", Sexp.int tag] => (localGet v ++ [65, tag, 71, 13, 0], env)
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str t :: Sexp.int tag :: subs) =>
    let tagTest := localGet v ++ load 0 ++ (65 :: sleb tag) ++ [71, 13, 0]
    List.foldl (fun acc pair =>
      match (acc, pair) with
      | ((code, bound), (i, Sexp.list [Sexp.sym "pany"])) => (code, bound)
      | ((code, bound), (i, sub)) =>
        let f := fresh next
        let _ := setType scope f (fieldType scope t tag i (typeOfLocal scope v))
        match pattern scope next f bound sub with
        | (subCode, bound2) => (code ++ localGet v ++ load (4 + 4 * i) ++ localSet f ++ subCode, bound2)) (tagTest, env) (List.mapIndexed (fun i x => (i, x)) subs)
  | other => throw ("the pattern " ++ Sexp.print other ++ " is outside the wasm subset")

/-- Code for `e`; `env` maps de Bruijn indices to locals, `next` is the next free local. -/
def expr (scope : Scope) (env : List Int) (next : Ref Int) (tail : Bool) (e : Sexp) : {Throw Text} List Int :=
  let sub := fun (x : Sexp) => expr scope env next false x
  let fns := scope.fns
  let indexOf := fun (h : Text) => List.findIndex (fun f => f.fnHash == h) fns
  match e with
  | Sexp.list [Sexp.sym "int", Sexp.int n] => 65 :: sleb n
  | Sexp.list [Sexp.sym "con", Sexp.str "#Bool", Sexp.int tag, Sexp.int 0] => [65, tag]
  | Sexp.list [Sexp.sym "con", Sexp.str _, Sexp.int tag, Sexp.int 0] => construct scope env next tag []
  | Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "con", Sexp.str t, Sexp.int tag, Sexp.int n] :: args) =>
    if n != List.length args || t == "#Bool" then throw ("partial application of a constructor of " ++ t ++ " is outside the wasm subset")
    else construct scope env next tag args
  | Sexp.list (Sexp.sym "match" :: scrutinee :: cases) =>
    let v := fresh next
    let _ := setType scope v (typeOf scope env scrutinee)
    -- One block per case: a failed test leaves it for the next; a match leaves the outer block.
    let arms := List.concatMap (fun c =>
      match c with
      | Sexp.list [Sexp.sym "case", pat, body] =>
        match pattern scope next v env pat with
        | (guard, bound) => [2, 64] ++ guard ++ expr scope bound next tail body ++ [12, 1, 11]
      | other => throw ("outside the wasm subset: " ++ Sexp.print other)) cases
    sub scrutinee ++ localSet v ++ [2, i32] ++ arms ++ [0, 11]
  | Sexp.list [Sexp.sym "var", Sexp.int i] =>
    match List.get? env i with
    | some local => 32 :: uleb local
    | none => throw ("unbound variable " ++ Int.toText i)
  | Sexp.list [Sexp.sym "if", c, t, f] =>
    sub c ++ [4, i32] ++ expr scope env next tail t ++ [5] ++ expr scope env next tail f ++ [11]
  | Sexp.list [Sexp.sym "seq", a, b] => sub a ++ [26] ++ expr scope env next tail b
  | Sexp.list [Sexp.sym "let", v, b] =>
    let local := Ref.get next
    Ref.set next (local + 1)
    let _ := setType scope local (typeOf scope env v)
    sub v ++ (33 :: uleb local) ++ expr scope (local :: env) next tail b
  | Sexp.list [Sexp.sym "app", Sexp.list [Sexp.sym "prim", Sexp.str "Int.neg"], a] => [65, 0] ++ sub a ++ [107]
  | Sexp.list [Sexp.sym "app", Sexp.list [Sexp.sym "prim", Sexp.str p], a, b] =>
    match binary p with
    | some op =>
      if isComparison p && not (isScalar (typeOf scope env a) || isScalar (typeOf scope env b)) then
        throw (p ++ " on values that are not known to be Int or Bool is outside the wasm subset, since it would compare addresses: " ++ Text.take 120 (Sexp.print e))
      else sub a ++ sub b ++ [op]
    | none => throw ("the primitive " ++ p ++ " is outside the wasm subset")
  | Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "ref", Sexp.str h] :: args) =>
    let index := indexOf h
    match List.find (fun f => f.fnHash == h) fns with
    | some f =>
      if f.fnArity != List.length args then throw ("#" ++ Text.take 10 h ++ " takes " ++ Int.toText f.fnArity ++ " arguments but is applied to " ++ Int.toText (List.length args) ++ "; partial application is outside the wasm subset")
      else List.concatMap sub args ++ ((if tail then 18 else 16) :: uleb index)
    | none => throw ("unknown function #" ++ Text.take 10 h)
  | other => throw ("outside the wasm subset: " ++ Text.take 120 (Sexp.print other))

/-- A constructed value: `alloc` a block, store the tag and each field, and leave its address. -/
def construct (scope : Scope) (env : List Int) (next : Ref Int) (tag : Int) (args : List Sexp) : {Throw Text} List Int :=
  let p := fresh next
  let fields := List.concat (List.mapIndexed (fun i a => localGet p ++ expr scope env next false a ++ store (4 + 4 * i)) args)
  (65 :: sleb (4 + 4 * List.length args)) ++ (16 :: uleb (List.length scope.fns)) ++ localSet p ++ localGet p ++ (65 :: sleb tag) ++ store 0 ++ fields ++ localGet p

/--
  `alloc n`: bumps the heap pointer (global 0) by `n` bytes. Past the end of memory it grows by
  at least the current size, so a program that allocates a lot grows memory a logarithmic number
  of times. Locals: 1 the block, 2 the pages missing.
-/
def allocBody : List Int :=
  List.concat [
    [35, 0, 33, 1],
    [35, 0, 32, 0, 106, 36, 0],
    [35, 0, 63, 0, 65, 16, 116, 75, 4, 64],
    [35, 0, 65, 16, 118, 65, 1, 106, 63, 0, 107, 33, 2],
    [32, 2, 63, 0, 32, 2, 63, 0, 74, 27, 64, 0, 26, 11],
    [32, 1, 11]]

/-- The module: one type and one function per definition; `main` is exported as `export`. -/
def module (fns : List Fn) (datatypes : List (Text, Sexp)) (export : Text) : {Throw Text} List Int :=
  let types := List.map (fun f => [96] ++ vec (List.replicate f.fnArity [i32]) ++ vec [[i32]]) fns ++ [[96] ++ vec [[i32]] ++ vec [[i32]]]
  let codes := List.map (fun f =>
    let next := Ref.new f.fnArity
    let env := List.reverse (List.range 0 f.fnArity)
    let scope := Scope.mk fns datatypes (Ref.new (List.mapIndexed (fun i t => (i, t)) (fst (peel f.fnArity f.fnType))))
    let code := expr scope env next true f.fnBody ++ [11]
    let extra := Ref.get next - f.fnArity
    let locals := if extra == 0 then vec [] else vec [uleb extra ++ [i32]]
    let entry := locals ++ code
    uleb (List.length entry) ++ entry) fns
  let alloc := List.length fns
  let allocEntry := vec [[2, i32]] ++ allocBody
  List.concat [
    [0, 97, 115, 109, 1, 0, 0, 0],
    section 1 (vec types),
    section 3 (vec (List.mapIndexed (fun i _ => uleb i) (fns ++ [Fn.mk "" 1 unknown unknown]))),
    section 5 (vec [[0, 1]]),
    section 6 (vec [[i32, 1, 65, 8, 11]]),
    section 7 (vec [name export ++ [0, 0], name "memory" ++ [2, 0], name "alloc" ++ (0 :: uleb alloc)]),
    section 10 (uleb (List.length codes + 1) ++ List.concat codes ++ uleb (List.length allocEntry) ++ allocEntry)]

/-- Compiles `main` and what it calls to a wasm module exporting it as `export`. -/
def compile (fetch : Text -> {Throw Text | r} Option Sexp) (meta : Text -> {Throw Text | r} Option Sexp) (main : Text) (export : Text) : {Throw Text | r} List Int :=
  let fns := gather fetch meta main
  let names := List.dedup (List.concatMap (fun f => patternTypes f.fnBody) fns)
  module fns (List.filterMap (fun t => Option.map (fun form => (t, form)) (fetch t)) names) export

end Wasm
