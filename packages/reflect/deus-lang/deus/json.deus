/-
  JSON output, for agents driving the CLI with `--json`.
-/

inductive Json where
  | null
  | bool (value : Bool)
  | num (value : Int)
  | str (value : Text)
  | arr (items : List Json)
  | obj (fields : List (Text, Json))

namespace Json

def escape (t : Text) : Text :=
  let n := Text.length t
  let rec go i acc :=
    if i >= n then Text.concat (List.reverse acc)
    else
      let c := Text.code t i
      let piece := if c == '"' then "\\\""
        else if c == '\\' then "\\\\"
        else if c == 10 then "\\n"
        else if c == 9 then "\\t"
        else if c == 13 then "\\r"
        else if c < 32 then "\\u" ++ Sexp.hex4 c
        else Text.fromCode c
      go (i + 1) (piece :: acc)
  "\"" ++ go 0 [] ++ "\""

def render (j : Json) : Text :=
  match j with
  | Json.null => "null"
  | Json.bool b => if b then "true" else "false"
  | Json.num v => Int.toText v
  | Json.str v => escape v
  | Json.arr items => "[" ++ Text.join "," (List.map render items) ++ "]"
  | Json.obj fields => "{" ++ Text.join "," (List.map (fun pair => escape (fst pair) ++ ":" ++ render (snd pair)) fields) ++ "}"

end Json
