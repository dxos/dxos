/-
  The TypeScript-like dialect (D70): Core printed as JS/TS-shaped text, one more view of the same
  codebase. DEUS stays the primary syntax; this one is for reading. Locals are named by the
  printer's supply in the order `Print` draws them, so both dialects show the author's names.
-/

namespace Ts

/-- Whether a term is an `if` that `&&` and `||` do not cover. -/
def isPlainIf (t : Sexp) : Bool :=
  match t with
  | Sexp.list [Sexp.sym "if", _, _, Sexp.list [Sexp.sym "con", Sexp.str "#Bool", Sexp.int 0, _]] => false
  | Sexp.list [Sexp.sym "if", _, Sexp.list [Sexp.sym "con", Sexp.str "#Bool", Sexp.int 1, _], _] => false
  | Sexp.list (Sexp.sym "if" :: _) => true
  | _ => false

/-- Whether a term prints as statements: a block, or an `if` whose branch is one. -/
def isStatement (t : Sexp) : Bool :=
  Print.isBlock t || (isPlainIf t && List.any isStatement (List.drop 1 (Sexp.args t)))

def conName (p : Printer) (t : Text) (tag : Int) : Text :=
  if t == "#Unit" then "undefined" else Print.conName p t tag

/-- An infix operator: DEUS's, except that text and list append read as `+`. -/
def infixOf (name : Text) : Option (Text, Int) :=
  if name == "append" then some ("+", 65) else Print.infixOf name

/-- Statements at indentation `ind`; the last returns its value when `ret`, else ends with `;`. -/
def stmts (p : Printer) (t : Sexp) (env : List Text) (ind : Int) (ret : Bool) : Text :=
  let nl := "\n" ++ Print.spaces ind
  match t with
  | Sexp.list [Sexp.sym "let", v, b] =>
    let name := Print.bind p env
    let value := expr p v env ind 0
    "const " ++ name ++ " = " ++ value ++ ";" ++ nl ++ stmts p b (name :: env) ind ret
  | Sexp.list [Sexp.sym "seq", a, b] =>
    -- A `let` before `;` scopes over that statement only, so it keeps a block of its own.
    let first := if Sexp.head a == "match" || Sexp.head a == "handle" || isPlainIf a then stmts p a env ind false else expr p a env ind 0 ++ ";"
    first ++ nl ++ stmts p b env ind ret
  | Sexp.list [Sexp.sym "letrec", Sexp.list fns, b] =>
    let names := List.map (fun _ => Print.bind p env) fns
    let inner := List.reverse names ++ env
    let defs := List.map (fun pair =>
      match pair with
      | (name, fn) => localFunction p name fn inner ind) (List.zip names fns)
    Text.join nl defs ++ nl ++ stmts p b inner ind ret
  | Sexp.list (Sexp.sym "match" :: scrut :: cases) =>
    -- A one-arm match on a tuple is a destructuring `const` (D176).
    let single := match cases with
      | [Sexp.list [Sexp.sym "case", pat, b]] => if Print.destructures pat then Option.some (pat, b) else Option.none
      | _ => Option.none
    match single with
    | Option.some (pat, b) =>
      let value := expr p scrut env ind 0
      match pattern p pat env with
      | (text, env2) => "const " ++ text ++ " = " ++ value ++ ";" ++ nl ++ stmts p b env2 ind ret
    | Option.none =>
        let scrutText := expr p scrut env ind 0
        let arms := List.map (fun c =>
          match c with
          | Sexp.list [Sexp.sym "case", pat, b] =>
            match pattern p pat env with
            | (text, env2) => nl ++ "  " ++ (if text == "_" then "default" else "case " ++ text) ++ ":\n" ++ Print.spaces (ind + 4) ++ stmts p b env2 (ind + 4) ret
          | _ => "") cases
        "switch (" ++ scrutText ++ ") {" ++ Text.concat arms ++ nl ++ "}"
  | Sexp.list (Sexp.sym "handle" :: b :: clauses) =>
    let bodyText := stmts p b env (ind + 2) ret
    let rendered := List.map (fun c =>
      match c with
      | Sexp.list [Sexp.sym "ret", rb] =>
        let name := Print.bind p env
        nl ++ "  return(" ++ name ++ ") {\n" ++ Print.spaces (ind + 4) ++ stmts p rb (name :: env) (ind + 4) ret ++ nl ++ "  }"
      | Sexp.list [Sexp.sym "on", Sexp.str a, Sexp.int index, Sexp.int arity, hb] =>
        let rec args k env2 acc :=
          if k == 0 then (List.reverse acc, env2)
          else
            let name := Print.bind p env2
            args (k - 1) (name :: env2) (name :: acc)
        match args arity env [] with
        | (names, env2) =>
          let k := Print.bind p env2
          nl ++ "  " ++ Print.nameFor p (a ++ "!" ++ Int.toText index) ++ "(" ++ Text.join ", " (names ++ [k]) ++ ") {\n" ++
            Print.spaces (ind + 4) ++ stmts p hb (k :: env2) (ind + 4) ret ++ nl ++ "  }"
      | _ => "") clauses
    "try {\n" ++ Print.spaces (ind + 2) ++ bodyText ++ nl ++ "} handle {" ++ Text.concat rendered ++ nl ++ "}"
  | Sexp.list [Sexp.sym "if", c, yes, no] =>
    if isPlainIf t && (isStatement yes || isStatement no || isPlainIf no) then ifStatement p c yes no env ind ret
    else final p t env ind ret
  | _ => final p t env ind ret

def final (p : Printer) (t : Sexp) (env : List Text) (ind : Int) (ret : Bool) : Text :=
  (if ret then "return " else "") ++ expr p t env ind 0 ++ ";"

/-- `if (c) { … } else if (d) { … } else { … }`. -/
def ifStatement (p : Printer) (c : Sexp) (yes : Sexp) (no : Sexp) (env : List Text) (ind : Int) (ret : Bool) : Text :=
  let nl := "\n" ++ Print.spaces ind
  let cond := expr p c env ind 0
  let yesText := stmts p yes env (ind + 2) ret
  let rest := match no with
    | Sexp.list [Sexp.sym "if", c2, yes2, no2] =>
      if isPlainIf no then " else " ++ ifStatement p c2 yes2 no2 env ind ret
      else " else {\n" ++ Print.spaces (ind + 2) ++ stmts p no env (ind + 2) ret ++ nl ++ "}"
    | _ => " else {\n" ++ Print.spaces (ind + 2) ++ stmts p no env (ind + 2) ret ++ nl ++ "}"
  "if (" ++ cond ++ ") {\n" ++ Print.spaces (ind + 2) ++ yesText ++ nl ++ "}" ++ rest

/-- Parameters of a run of lambdas, named in order, with the body and its environment. -/
def params (p : Printer) (t : Sexp) (env : List Text) : (List Text, Sexp, List Text) :=
  let rec go x env2 acc :=
    match x with
    | Sexp.list [Sexp.sym "lam", b] =>
      let name := Print.bind p env2
      go b (name :: env2) (name :: acc)
    | _ => (List.reverse acc, x, env2)
  go t env []

/-- `function go(x, y) { … }` for a local recursive function. -/
def localFunction (p : Printer) (name : Text) (fn : Sexp) (env : List Text) (ind : Int) : Text :=
  match params p fn env with
  | (names, b, env2) => "function " ++ name ++ "(" ++ Text.join ", " names ++ ") " ++ functionBody p b env2 ind

/-- `{` statements returning the value `}`. -/
def functionBody (p : Printer) (b : Sexp) (env : List Text) (ind : Int) : Text :=
  "{\n" ++ Print.spaces (ind + 2) ++ stmts p b env (ind + 2) true ++ "\n" ++ Print.spaces ind ++ "}"

def expr (p : Printer) (t : Sexp) (env : List Text) (ind : Int) (prec : Int) : Text :=
  match t with
  | Sexp.list [Sexp.sym "var", Sexp.int i] => Option.getOr (List.get? env i) ("$" ++ Int.toText i)
  | Sexp.list [Sexp.sym "ref", Sexp.str h] => Print.refName p h env
  | Sexp.list [Sexp.sym "int", Sexp.int v] => if v < 0 then Print.paren 95 prec (Int.toText v) else Int.toText v
  | Sexp.list [Sexp.sym "text", Sexp.str v] => Print.quoteText v
  | Sexp.list [Sexp.sym "prim", Sexp.str name] => "prim(" ++ Print.quoteText name ++ ")"
  | Sexp.list [Sexp.sym "con", Sexp.str ty, Sexp.int tag, _] => conName p ty tag
  | Sexp.list [Sexp.sym "op", Sexp.str a, Sexp.int index, _] => Print.nameFor p (a ++ "!" ++ Int.toText index)
  | Sexp.list [Sexp.sym "if", a, b, Sexp.list [Sexp.sym "con", Sexp.str "#Bool", Sexp.int 0, _]] =>
    Print.paren 35 prec (expr p a env ind 36 ++ " && " ++ expr p b env ind 35)
  | Sexp.list [Sexp.sym "if", a, Sexp.list [Sexp.sym "con", Sexp.str "#Bool", Sexp.int 1, _], b] =>
    Print.paren 30 prec (expr p a env ind 31 ++ " || " ++ expr p b env ind 30)
  | Sexp.list [Sexp.sym "if", c, yes, no] =>
    if isStatement t then doBlock p t env ind
    else Print.paren 5 prec (expr p c env ind 6 ++ " ? " ++ expr p yes env ind 5 ++ " : " ++ expr p no env ind 5)
  | Sexp.list (Sexp.sym "lam" :: _) =>
    match params p t env with
    | (names, b, env2) =>
      let rendered := if isStatement b then functionBody p b env2 ind else expr p b env2 ind 1
      -- A generated name (`x0`) the body never mentions was `_` in the source.
      let shown := List.map (fun x => if Print.isGenerated x && not (Print.mentions x rendered) then "_" else x) names
      -- A lone ignored parameter reads as none: JavaScript drops extra arguments.
      let paramText := if shown == ["_"] then "" else Text.join ", " shown
      Print.paren 1 prec ("(" ++ paramText ++ ") => " ++ rendered)
  | Sexp.list (Sexp.sym "app" :: f :: args) =>
    match (f, args) with
    | (Sexp.list [Sexp.sym "ref", Sexp.str h], [a]) =>
      match Map.lookup h p.fieldNames with
      | some field => expr p a env ind 100 ++ "." ++ field
      | none => application p f args env ind prec
    | (Sexp.list [Sexp.sym "prim", Sexp.str name], [a, b]) =>
      match infixOf name with
      | some (op, level) =>
        let supply := Ref.get p.supply
        let fresh := Ref.get p.fresh
        let flat := expr p a env ind level ++ " " ++ op ++ " " ++ expr p b env ind (level + 1)
        if Print.fits ind flat then Print.paren level prec flat
        else
          Ref.set p.supply supply
          Ref.set p.fresh fresh
          let left := expr p a env ind level
          Print.paren level prec (left ++ " " ++ op ++ "\n" ++ Print.spaces (ind + 2) ++ expr p b env (ind + 2) (level + 1))
      | none => application p f args env ind prec
    | (Sexp.list [Sexp.sym "prim", Sexp.str "Int.neg"], [a]) => Print.paren 95 prec ("-" ++ expr p a env ind 100)
    | (Sexp.list [Sexp.sym "con", Sexp.str "#Pair", Sexp.int 0, Sexp.int 2], [_, _]) =>
      sequence p "#[" (Print.tupleItems t) env ind
    | (Sexp.list [Sexp.sym "con", Sexp.str "#List", Sexp.int 1, Sexp.int 2], [h, rest]) =>
      match Print.listItems t with
      | some items => sequence p "[" items env ind
      | none => "[" ++ expr p h env ind 0 ++ ", ..." ++ expr p rest env ind 100 ++ "]"
    | _ => application p f args env ind prec
  | _ => if Print.isBlock t then doBlock p t env ind else Print.paren 100 prec (Sexp.print t)

/-- A block in expression position: `do { … }`, whose last statement is its value. -/
def doBlock (p : Printer) (t : Sexp) (env : List Text) (ind : Int) : Text :=
  "do {\n" ++ Print.spaces (ind + 2) ++ stmts p t env (ind + 2) false ++ "\n" ++ Print.spaces ind ++ "}"

/-- `[a, b]` or `#[a, b]` on one line when it fits, else one item per line. -/
def sequence (p : Printer) (opener : Text) (items : List Sexp) (env : List Text) (ind : Int) : Text :=
  let supply := Ref.get p.supply
  let fresh := Ref.get p.fresh
  let flat := opener ++ Text.join ", " (List.map (fun x => expr p x env ind 0) items) ++ "]"
  if Print.fits ind flat || List.length items < 2 then flat
  else
    Ref.set p.supply supply
    Ref.set p.fresh fresh
    opener ++ Text.concat (List.map (fun x => "\n" ++ Print.spaces (ind + 2) ++ expr p x env (ind + 2) 0 ++ ",") items) ++ "\n" ++ Print.spaces ind ++ "]"

/-- Whether the only argument is unit: `f(())` reads as `f()`. -/
def unitOnly (args : List Sexp) : Bool :=
  match args with
  | [Sexp.list [Sexp.sym "con", Sexp.str "#Unit", _, _]] => true
  | _ => false

/-- `f(a, b)` on one line when it fits, else one argument per line; binder names drawn by the first attempt are given back. -/
def application (p : Printer) (f : Sexp) (args : List Sexp) (env : List Text) (ind : Int) (prec : Int) : Text :=
  let supply := Ref.get p.supply
  let fresh := Ref.get p.fresh
  let names := Print.hintNames p f args
  let flat := expr p f env ind 100 ++ "(" ++ Text.join ", " (List.mapIndexed (fun i a => Print.hinted names i (expr p a env ind 0)) args) ++ ")"
  if unitOnly args then expr p f env ind 100 ++ "()"
  else if Print.fits ind flat || List.length args < 2 then flat
  else
    Ref.set p.supply supply
    Ref.set p.fresh fresh
    let head := expr p f env ind 100
    head ++ "(" ++ Text.concat (List.mapIndexed (fun i a => "\n" ++ Print.spaces (ind + 2) ++ Print.hinted names i (expr p a env (ind + 2) 0) ++ ",") args) ++ "\n" ++ Print.spaces ind ++ ")"

--
-- Patterns.
--

def pattern (p : Printer) (pat : Sexp) (env : List Text) : (Text, List Text) :=
  match pat with
  | Sexp.list [Sexp.sym "pany"] => ("_", env)
  | Sexp.list [Sexp.sym "pvar"] =>
    let name := Print.bind p env
    (name, name :: env)
  | Sexp.list [Sexp.sym "pas", inner] =>
    let name := Print.bind p env
    match pattern p inner (name :: env) with
    | (text, env2) => (name ++ " @ " ++ text, env2)
  | Sexp.list [Sexp.sym "pint", Sexp.int v] => (Int.toText v, env)
  | Sexp.list [Sexp.sym "ptext", Sexp.str v] => (Print.quoteText v, env)
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str ty :: Sexp.int tag :: subs) =>
    if (ty == "#List" && tag == 1) || ty == "#Pair" then
      match subs with
      | [a, b] =>
        match pattern p a env with
        | (at, env2) =>
          match pattern p b env2 with
          | (bt, env3) =>
            -- `[h, ...[x, ...t]]` reads as `[h, x, ...t]`, and nested pairs as one tuple.
            let opener := if ty == "#Pair" then "#[" else "["
            let sameKind := match b with
              | Sexp.list (Sexp.sym "pcon" :: Sexp.str ty2 :: _) => ty2 == ty
              | _ => false
            if ty == "#List" && bt == "[]" then ("[" ++ at ++ "]", env3)
            else if sameKind then (opener ++ at ++ ", " ++ Text.drop (Text.length opener) bt, env3)
            else if ty == "#Pair" then ("#[" ++ at ++ ", " ++ bt ++ "]", env3)
            else ("[" ++ at ++ ", ..." ++ bt ++ "]", env3)
      | _ => ("?", env)
    else
      let rec go rest env2 acc :=
        match rest with
        | [] => (List.reverse acc, env2)
        | x :: more =>
          match pattern p x env2 with
          | (text, env3) => go more env3 (text :: acc)
      match go subs env [] with
      | (texts, env2) =>
        let name := conName p ty tag
        if List.isEmpty texts then (name, env2) else (name ++ "(" ++ Text.join ", " texts ++ ")", env2)
  | _ => (Sexp.print pat, env)

--
-- Types.
--

/-- The argument types of a run of pure arrows and what follows them; an arrow with a row ends the run. -/
def arrows (t : Sexp) : (List Sexp, Sexp) :=
  match t with
  | Sexp.list [Sexp.sym "tfun", a, b] =>
    match arrows b with
    | (args, result) => (a :: args, result)
  | Sexp.list [Sexp.sym "tfun", a, b, row] => ([a], Sexp.node "teff" [row, b])
  | _ => ([], t)

/-- Whether a function type's result carries effects: `uses` lists them with commas, so in a list the type needs parentheses. -/
def hasUses (result : Sexp) : Bool :=
  match result with
  | Sexp.list [Sexp.sym "teff", Sexp.list (Sexp.sym "eff" :: effs), _] => not (List.isEmpty effs)
  | _ => false

/-- A type; `prec` 3 is a comma-separated position, where an effectful function type is parenthesized. -/
def ty (p : Printer) (t : Sexp) (prec : Int) : Text :=
  match t with
  | Sexp.list (Sexp.sym "tapp" :: Sexp.list [Sexp.sym "tref", Sexp.str "#Pair"] :: args) =>
    "#[" ++ Text.join ", " (List.map (fun x => ty p x 3) args) ++ "]"
  | Sexp.list (Sexp.sym "tapp" :: f :: args) => ty p f 100 ++ "<" ++ Text.join ", " (List.map (fun x => ty p x 3) args) ++ ">"
  | Sexp.list (Sexp.sym "tfun" :: _) =>
    match arrows t with
    | (args, result) =>
      -- `Unit -> a` reads as `() => a`, as `f(())` reads as `f()`.
      let argText := if args == [Sexp.node "tref" [Sexp.str "#Unit"]] then "" else Text.join ", " (List.map (fun x => ty p x 3) args)
      Print.paren (if hasUses result then 2 else 10) prec ("(" ++ argText ++ ") => " ++ ty p result 0)
  | Sexp.list (Sexp.sym "trow" :: effs) => uses p effs
  | Sexp.list [Sexp.sym "teff", Sexp.list (Sexp.sym "eff" :: effs), b] =>
    if List.isEmpty effs then ty p b prec else ty p b 11 ++ " uses " ++ uses p effs
  | _ => Print.ty p t prec

/-- An effect row: `IO, Throw<Text>`, with a row variable as a spread (`...r`). -/
def uses (p : Printer) (effs : List Sexp) : Text :=
  let tails := List.filter (fun x => Sexp.head x == "tvar") effs
  let named := List.filter (fun x => Sexp.head x != "tvar") effs
  Text.join ", " (List.map (fun x => ty p x 3) named ++ List.map (fun x => "..." ++ ty p x 3) tails)

/-- Type variables in order of first occurrence, under the names `ty` prints. -/
def typeVars (t : Sexp) : List Text :=
  let rec go x acc :=
    match x with
    | Sexp.list [Sexp.sym "tvar", Sexp.str "?"] => acc
    | Sexp.list [Sexp.sym "tvar", Sexp.str n] => if List.contains n acc then acc else acc ++ [n]
    | Sexp.list [Sexp.sym "tvar", Sexp.int i] =>
      let n := Text.fromCode ('a' + i)
      if List.contains n acc then acc else acc ++ [n]
    | Sexp.list items => List.foldl (fun a2 item => go item a2) acc items
    | _ => acc
  go t []

def generics (names : List Text) : Text := if List.isEmpty names then "" else "<" ++ Text.join ", " names ++ ">"

def isUnknown (t : Sexp) : Bool := Sexp.head t == "tvar" && Sexp.args t == [Sexp.str "?"]

--
-- Declarations.
--

def docComment (doc : Option Text) : Text :=
  match doc with
  | some d => "/** " ++ d ++ " */\n"
  | none => ""

/-- `function name<a>(x: A): B { … }`, or `const name: T = …;` for a value. -/
def definition (p : Printer) (name : Text) (core : Sexp) (sig : Option Sexp) (doc : Option Text) : Text :=
  match params p core [] with
  | (names, b, env) =>
    let count := List.length names
    let split := Option.map (fun s => Print.splitSig s count) sig
    let typed := match split with
      | some (types, some result) => if List.length types == count then some (types, result) else none
      | _ => none
    let gen := generics (Option.getOr (Option.map typeVars sig) [])
    let annotate := fun (t : Sexp) => if isUnknown t then "" else ": " ++ ty p t 3
    if count == 0 then
      let typeText := match typed with
        | some (_, result) => annotate result
        | none => ""
      docComment doc ++ "const " ++ name ++ typeText ++ " = " ++ expr p b env 0 0 ++ ";"
    else
      let paramText := match typed with
        | some (types, _) => List.map (fun pair => fst pair ++ annotate (snd pair)) (List.zip names types)
        | none => names
      let resultText := match typed with
        | some (_, result) =>
          match result with
          | Sexp.list [Sexp.sym "teff", Sexp.list (Sexp.sym "eff" :: effs), r] =>
            annotate r ++ (if List.isEmpty effs then "" else " uses " ++ uses p effs)
          | _ => annotate result
        | none => ""
      let flat := "function " ++ name ++ gen ++ "(" ++ Text.join ", " paramText ++ ")" ++ resultText
      let header := if Print.fits 0 flat then flat
        else "function " ++ name ++ gen ++ "(" ++ Text.concat (List.map (fun x => "\n  " ++ x ++ ",") paramText) ++ "\n)" ++ resultText
      docComment doc ++ header ++ " " ++ functionBody p b env 0

/-- `test("name", () => …);`. -/
def testDecl (p : Printer) (name : Text) (body : Sexp) : Text :=
  let rendered := if isStatement body then functionBody p body [] 0 else expr p body [] 0 1
  "test(" ++ Print.quoteText name ++ ", () => " ++ rendered ++ ");"

/-- `theorem name(x: T): prop by tactic;`. -/
def theoremDecl (p : Printer) (name : Text) (types : List Sexp) (prop : Sexp) (proof : Sexp) : Text :=
  match params p prop [] with
  | (names, b, env) =>
    let binders := List.map (fun pair => fst pair ++ ": " ++ ty p (snd pair) 3) (List.zip names types)
    let tactic := List.map (fun x =>
      match x with
      | Sexp.list [Sexp.sym "ref", Sexp.str l] => Print.nameFor p l
      | _ => Sexp.asText x) (Sexp.args proof)
    let proofText := if tactic == ["sorry"] then "sorry" else "by " ++ Text.replace " ," "," (Text.replace "[ " "[" (Text.replace " ]" "]" (Text.join " " tactic)))
    "theorem " ++ name ++ "(" ++ Text.join ", " binders ++ "): " ++ expr p b env 2 0 ++ " " ++ proofText ++ ";"

def decorator (iri : Text) (name : Text) : Text := if iri == "urn:deus:" ++ name then "" else "@iri(" ++ Print.quoteText iri ++ ")\n"

/-- `interface T<a> { f: F; }` for a structure, `type T<a> = | c(F) …` for an inductive type. -/
def typeDecl (p : Printer) (ns : Map Text Entry) (name : Text) (e : Entry) (obj : Sexp) (meta : Option Sexp) : Text :=
  match (e, Sexp.args obj) with
  | (Entry.type h iri fields, _ :: Sexp.int count :: _) =>
    let names := View.paramsFor meta count obj
    let fieldNames := View.fieldNamesFor meta
    let ctors := List.map (View.nameParams names) (View.typeArgs obj)
    if not (List.isEmpty fields) then
      let types := Option.getOr (Option.map Sexp.args (List.head? ctors)) []
      let lines := List.map (fun pair =>
        match pair with
        | (f, t) => "  " ++ f ++ ": " ++ ty p t 0 ++ ";") (List.zip fields (List.drop 1 types))
      decorator iri name ++ "interface " ++ name ++ generics names ++ " {\n" ++ Text.join "\n" lines ++ "\n}"
    else
      let ctorNames := List.filterMap (fun pair =>
        match pair with
        | (n, Entry.ctor t tag _) => if t == h then some (tag, Names.lastSegment n) else none
        | _ => none) (Map.toList ns)
      let lines := List.mapIndexed (fun tag c =>
        let cname := Option.getOr (List.lookup tag ctorNames) ("ctor" ++ Int.toText tag)
        let fieldTypes := List.drop 1 (Sexp.args c)
        let named := Option.getOr (List.get? fieldNames tag) []
        let field := fun (pair : (Int, Sexp)) =>
          match Option.getOr (List.get? named (fst pair)) "" with
          | "" => ty p (snd pair) 3
          | fieldName => fieldName ++ ": " ++ ty p (snd pair) 3
        let args := List.map field (List.mapIndexed (fun i t => (i, t)) fieldTypes)
        "  | " ++ cname ++ (if List.isEmpty args then "" else "(" ++ Text.join ", " args ++ ")")) ctors
      decorator iri name ++ "type " ++ name ++ generics names ++ " =" ++ (if List.isEmpty lines then " never;" else "\n" ++ Text.join "\n" lines ++ ";")
  | _ => Sexp.print obj

/-- `ability A<e> { op(E): R; }`: an ability reads as an interface of operations. -/
def abilityDecl (p : Printer) (ns : Map Text Entry) (name : Text) (e : Entry) (obj : Sexp) (meta : Option Sexp) : Text :=
  match (e, Sexp.args obj) with
  | (Entry.ability h iri, _ :: Sexp.int count :: rawOps) =>
    let names := View.paramsFor meta count obj
    let ops := List.map (View.nameParams names) rawOps
    let opNames := List.filterMap (fun pair =>
      match pair with
      | (n, Entry.op a index _) => if a == h then some (index, Names.lastSegment n) else none
      | _ => none) (Map.toList ns)
    let lines := List.mapIndexed (fun index op =>
      let oname := Option.getOr (List.lookup index opNames) ("op" ++ Int.toText index)
      match Sexp.args op with
      | [_, t] =>
        match arrows t with
        | ([], result) => "  " ++ oname ++ ": " ++ ty p result 0 ++ ";"
        | (args, result) => "  " ++ oname ++ "(" ++ Text.join ", " (List.map (fun x => ty p x 3) args) ++ "): " ++ ty p result 0 ++ ";"
      | _ => "  " ++ oname ++ ";") ops
    decorator iri name ++ "ability " ++ name ++ generics names ++ " {\n" ++ Text.join "\n" lines ++ "\n}"
  | _ => Sexp.print obj

test functionWithReturn :=
  let p := Print.printer Map.empty ["n"]
  definition p "f" (Sexp.read "(lam (app (prim \"Int.add\") (var 0) (int 1)))") (some (Sexp.read "(tfun (tref \"#Int\") (tref \"#Int\"))")) none ==
    "function f(n: Int): Int {\n  return n + 1;\n}"

test letBecomesConst :=
  let p := Print.printer Map.empty ["x", "y"]
  stmts p (Sexp.read "(let (int 1) (let (var 0) (var 1)))") [] 0 true == "const x = 1;\nconst y = x;\nreturn x;"

test tuplePattern :=
  let p := Print.printer Map.empty ["a", "b"]
  fst (pattern p (Sexp.read "(pcon \"#Pair\" 0 (pvar) (pvar))") []) == "#[a, b]"

end Ts
