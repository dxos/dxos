/-
  `.mdl` documents (D46).

  - DEUS code lives in ```deus fences. `deusSource` blanks the lines outside fences rather than
    removing them, so positions in errors point into the document.
  - Typed blocks live in ```mdl fences: a header `<type> [<id>][: <title>]`, then `key: value`
    lines. `parse` reads them, the frontmatter and the Extensions table (term → URI) into data.
  - An extension is a DEUS function `Block -> {MdlHost} List Text` published with
    `@[ext "<uri>"]`; `deus mdl` runs every block through the extension its term names. The empty
    list means the block holds; otherwise each text is one problem.
-/

/-- One ```mdl block; `props` keeps the document's order, and `lineNo` is its header's line. -/
structure Block @"urn:deus:mdl:Block" where
  blockType : Text
  blockId : Text
  blockTitle : Text
  props : List (Text, Text)
  lineNo : Int

/-- A parsed document: frontmatter, the Extensions table, and the blocks in order. -/
structure Doc @"urn:deus:mdl:Doc" where
  front : List (Text, Text)
  terms : List (Text, Text)
  blocks : List Block

/--
  What an extension may ask of the toolchain about the codebase the document is checked against.
  All take DEUS source: `cost` is the machine steps an expression takes to evaluate, `holds`
  whether a `Bool` expression is true, and `run` the value of a `Text` expression. A compile error
  or a defect is an `err`.
-/
ability MdlHost @"urn:deus:mdl:Host" where
  cost : Text -> Result Text Int
  holds : Text -> Result Text Bool
  run : Text -> Result Text Text

namespace Mdl

def deusSource (doc : Text) : Text :=
  let rec go lines inFence acc :=
    match lines with
    | [] => Text.join "\n" (List.reverse acc)
    | line :: rest =>
      let trimmed := Text.trim line
      if not inFence && trimmed == "```deus" then go rest true ("" :: acc)
      else if inFence && trimmed == "```" then go rest false ("" :: acc)
      else if inFence then go rest true (line :: acc)
      else go rest false ("" :: acc)
  go (Text.lines doc) false []

def isKeyChar (c : Int) : Bool := Text.isAlpha c || Text.isDigit c || c == '-' || c == '_' || c == '?'

/-- Drops a trailing ` # comment`. -/
def uncomment (t : Text) : Text :=
  let i := Text.indexOf t " # " 0
  if i < 0 then t else Text.trim (Text.take i t)

/-- `key: value` when the key is an identifier; a bare `key:` has the empty value. -/
def keyValue (line : Text) : Option (Text, Text) :=
  let i := Text.indexOf line ":" 0
  if i <= 0 then none
  else
    let key := Text.trim (Text.take i line)
    if List.all (fun j => isKeyChar (Text.code key j)) (List.range 0 (Text.length key)) then
      some (key, uncomment (Text.trim (Text.drop (i + 1) line)))
    else none

/-- `<type> [<id>][: <title>]`. -/
def header (line : Text) (at : Int) : Block :=
  let colon := Text.indexOf line ":" 0
  let head := if colon < 0 then line else Text.take colon line
  let title := if colon < 0 then "" else Text.trim (Text.drop (colon + 1) line)
  match List.filter (fun w => not (Text.isEmpty w)) (Text.split (Text.trim head) " ") with
  | [] => Block.mk "" "" title [] at
  | [kind] => Block.mk kind "" title [] at
  | kind :: ident :: _ => Block.mk kind ident title [] at

/-- Adds a continuation line (a `- item` or prose) to the last key, or to `prose` before any key. -/
def continueWith (acc : List (Text, Text)) (t : Text) : List (Text, Text) :=
  match acc with
  | [] => [("prose", t)]
  | (key, value) :: rest => (key, if Text.isEmpty value then t else value ++ "\n" ++ t) :: rest

def indentOf (line : Text) : Int :=
  let rec go i := if i < Text.length line && Text.code line i == ' ' then go (i + 1) else i
  go 0

/--
  A `key: value` line indented deeper than the block's first key continues the last value with
  two leading spaces, so a list item can carry fields of its own (a `qa` step's `send:`).
-/
def body (lines : List Text) : List (Text, Text) :=
  let base := match List.filter (fun l => not (Text.isEmpty (Text.trim l))) lines with
    | [] => 0
    | first :: _ => indentOf first
  List.reverse (List.foldl (fun acc line =>
    let t := Text.trim line
    if Text.isEmpty t || Text.startsWith "#" t then acc
    else if Text.startsWith "- " t then continueWith acc (Text.drop 2 t)
    else
      match keyValue t with
      | some kv => if indentOf line > base && not (List.isEmpty acc) then continueWith acc ("  " ++ t) else kv :: acc
      | none => continueWith acc t) [] lines)

def block (start : Int) (lines : List Text) : Block :=
  match List.filter (fun l => not (Text.isEmpty (Text.trim l))) lines with
  | [] => Block.mk "" "" "" [] start
  | first :: rest => { header (Text.trim first) start with props := body rest }

def unquote (t : Text) : Text :=
  if Text.length t >= 2 && Text.startsWith "`" t && Text.endsWith "`" t then Text.slice t 1 (Text.length t - 1) else t

/-- A `| term | uri |` row of the Extensions table; none for its header and separator. -/
def termRow (line : Text) : Option (Text, Text) :=
  match List.map Text.trim (Text.split line "|") with
  | "" :: term :: uri :: _ =>
    if Text.startsWith "`" term then some (unquote term, unquote uri) else none
  | _ => none

def frontmatter (lines : List (Int, Text)) : (List (Text, Text), List (Int, Text)) :=
  match lines with
  | [] => ([], [])
  | (_, first) :: rest =>
    if Text.trim first == "---" then
      let n := List.findIndex (fun p => Text.trim (snd p) == "---") rest
      if n < 0 then ([], lines)
      else (List.filterMap (fun p => keyValue (snd p)) (List.take n rest), List.drop (n + 1) rest)
    else ([], lines)

def headingOf (t : Text) : Text :=
  let rec go i := if i < Text.length t && Text.code t i == '#' then go (i + 1) else i
  Text.trim (Text.drop (go 0) t)

/-- Parses a document; fences other than ```mdl (```deus among them) are skipped. -/
def parse (doc : Text) : Doc :=
  match frontmatter (List.mapIndexed (fun i l => (i + 1, l)) (Text.lines doc)) with
  | (front, lines) =>
    -- fence: none outside; some (start, isMdl, lines reversed) inside.
    let rec go rest section fence terms blocks :=
      match rest with
      | [] => Doc.mk front (List.reverse terms) (List.reverse blocks)
      | (n, line) :: more =>
        let t := Text.trim line
        match fence with
        | some (start, isMdl, acc) =>
          if t == "```" then go more section none terms (if isMdl then block start (List.reverse acc) :: blocks else blocks)
          else go more section (some (start, isMdl, line :: acc)) terms blocks
        | none =>
          if Text.startsWith "```" t then go more section (some (n + 1, t == "```mdl", [])) terms blocks
          else if Text.startsWith "#" t then go more (headingOf t) none terms blocks
          else if section == "Extensions" && Text.startsWith "|" t then
            go more section none (Option.getOr (Option.map (fun row => row :: terms) (termRow t)) terms) blocks
          else go more section none terms blocks
    go lines "" none [] []

/-- Terms a document may use: its Extensions table and its inline `ext <term>` blocks with a `uri:`. -/
def declared (doc : Doc) : List (Text, Text) :=
  doc.terms ++ List.filterMap (fun b =>
    if b.blockType == "ext" then Option.map (fun uri => (b.blockId, unquote uri)) (List.lookup "uri" b.props) else none) doc.blocks

def describe (b : Block) : Text := if Text.isEmpty b.blockId then b.blockType else b.blockType ++ " " ++ b.blockId

/-- The core language's own rules: every block type is declared, and block ids are unique. -/
def validate (doc : Doc) : List Text :=
  let terms := List.map fst (declared doc)
  let undeclared := List.filterMap (fun b =>
    if b.blockType == "ext" || List.any (fun term => term == b.blockType) terms then none
    else some ("line " ++ Int.toText b.lineNo ++ ": block type `" ++ b.blockType ++ "` is not in the Extensions table")) doc.blocks
  let ids := List.filter (fun i => not (Text.isEmpty i)) (List.map (fun b => b.blockId) doc.blocks)
  let duplicates := List.filterMap (fun pair =>
    match pair with
    | (i, ident) =>
      if List.any (fun earlier => earlier == ident) (List.take i ids) then some ("block id " ++ ident ++ " is declared twice") else none)
    (List.mapIndexed (fun i ident => (i, ident)) ids)
  undeclared ++ duplicates

/--
  A block as a spec object, with the URI of the extension its type names (stored specs have no
  Extensions table). The line is left out, so moving a block does not change its hash.
-/
def toSexp (uri : Text) (b : Block) : Sexp :=
  Sexp.node "spec" ([Sexp.str b.blockType, Sexp.str uri, Sexp.str b.blockId, Sexp.str b.blockTitle] ++
    List.map (fun kv => Sexp.list [Sexp.str (fst kv), Sexp.str (snd kv)]) b.props)

/-- A spec object as its extension's URI and the block. -/
def fromSexp (form : Sexp) : (Text, Block) :=
  match Sexp.args form with
  | kind :: uri :: ident :: title :: props =>
    (Sexp.asText uri, Block.mk (Sexp.asText kind) (Sexp.asText ident) (Sexp.asText title) (List.filterMap (fun p =>
      match p with
      | Sexp.list [key, value] => some (Sexp.asText key, Sexp.asText value)
      | _ => none) props) 0)
  | _ => ("", Block.mk "" "" "" [] 0)

/-- A block printed back as MDL. -/
def render (b : Block) : Text :=
  let head := b.blockType ++ (if Text.isEmpty b.blockId then "" else " " ++ b.blockId) ++ (if Text.isEmpty b.blockTitle then "" else ": " ++ b.blockTitle)
  "```mdl\n" ++ head ++ Text.concat (List.map (fun kv =>
    "\n  " ++ fst kv ++ ":" ++ (if Text.contains "\n" (snd kv) then Text.concat (List.map (fun l => if Text.startsWith "  " l then "\n    " ++ Text.trim l else "\n  - " ++ l) (Text.lines (snd kv))) else " " ++ snd kv)) b.props) ++ "\n```"

end Mdl
