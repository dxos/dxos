/-
  Resolver: declarations to Core, then to content-addressed objects.

  1. Types and abilities are hashed first. They refer to other types by IRI, never by hash,
     so their hashes need no ordering (docs/DECISIONS.md D6).
  2. Bodies are desugared to Core. A reference to a definition in the same batch is a
     placeholder `(ref "@Fully.Qualified")`; one to the codebase is `(ref "<hash>")`.
  3. Terms are grouped into strongly connected components and hashed dependencies-first;
     a recursive group is hashed as one cycle (Unison's scheme, D5).
-/

/-- What a name denotes in a namespace. -/
inductive Entry where
  | term (hash : Text)
  | ctor (type : Text) (tag : Int) (arity : Int)
  | type (hash : Text) (iri : Text) (fields : List Text)
  | ability (hash : Text) (iri : Text)
  | op (owner : Text) (index : Int) (arity : Int)
  | test (hash : Text)
  | theorem (hash : Text)
  | spec (hash : Text)

namespace Entry

def toSexp : Entry -> Sexp
  | term h => Sexp.node "term" [Sexp.s h]
  | ctor t tag n => Sexp.node "ctor" [Sexp.s t, Sexp.i tag, Sexp.i n]
  | type h iri fields => Sexp.node "type" [Sexp.s h, Sexp.s iri, Sexp.list (List.map Sexp.s fields)]
  | Entry.ability h iri => Sexp.node "ability" [Sexp.s h, Sexp.s iri]
  | op a index n => Sexp.node "op" [Sexp.s a, Sexp.i index, Sexp.i n]
  | Entry.test h => Sexp.node "test" [Sexp.s h]
  | Entry.theorem h => Sexp.node "theorem" [Sexp.s h]
  | Entry.spec h => Sexp.node "spec" [Sexp.s h]

def fromSexp (s : Sexp) : Entry :=
  let a := Sexp.args s
  let txt := fun k => asText (getOr (get? a k) (Sexp.str ""))
  let num := fun k => Sexp.asInt (getOr (get? a k) (Sexp.int 0))
  let h := head s
  if h == "term" then Entry.term (txt 0) else if h == "ctor" then Entry.ctor (txt 0) (num 1) (num 2) else if h == "type" then Entry.type (txt 0) (txt 1) (List.map asText (Sexp.asList (getOr (get? a 2) (Sexp.list [])))) else if h == "ability" then Entry.ability (txt 0) (txt 1) else if h == "op" then Entry.op (txt 0) (num 1) (num 2) else if h == "test" then Entry.test (txt 0) else if h == "theorem" then Entry.theorem (txt 0) else if h == "spec" then Entry.spec (txt 0) else defect ("unknown entry " ++ Sexp.print s)

def kind : Entry -> Text
  | term _ => "term"
  | ctor _ _ _ => "ctor"
  | type _ _ _ => "type"
  | Entry.ability _ _ => "ability"
  | op _ _ _ => "op"
  | Entry.test _ => "test"
  | Entry.theorem _ => "theorem"
  | Entry.spec _ => "spec"

/-- The hash an entry names (a constructor or operation names its type's or ability's). -/
def hash : Entry -> Text
  | term h => h
  | ctor t _ _ => t
  | type h _ _ => h
  | Entry.ability h _ => h
  | op a _ _ => a
  | Entry.test h => h
  | Entry.theorem h => h
  | Entry.spec h => h

def isValue (e : Entry) : Bool :=
  match e with
  | term _ => true
  | ctor _ _ _ => true
  | op _ _ _ => true
  | _ => false

def isCtor (e : Entry) : Bool :=
  match e with
  | ctor _ _ _ => true
  | _ => false

def isOp (e : Entry) : Bool :=
  match e with
  | op _ _ _ => true
  | _ => false

def isTypeName (e : Entry) : Bool :=
  match e with
  | type _ _ _ => true
  | Entry.ability _ _ => true
  | _ => false

end Entry

structure Scope where
  ns : List Text
  opens : List Text

/-- A name table with the indexes resolution needs. -/
structure Names where
  table : Map Text Entry
  index : Dict Text Entry
  bySegment : Dict Text (List Text)
  fieldOwners : Dict Text (List Text)

namespace Names

def lastSegment (name : Text) : Text :=
  let rec go i := if i < 0 then name else if Text.code name i == '.' then Text.drop (i + 1) name else go (i - 1)
  go (Text.length name - 1)

/-- Pairs grouped by key, each group's values in descending order; sorting once is cheaper than a map insert per pair. -/
def groups (pairs : List (Text, Text)) : List (Text, List Text) :=
  let rec go xs key acc out :=
    match xs with
    | [] => if List.isEmpty acc then out else (key, acc) :: out
    | pair :: rest =>
      if fst pair == key then go rest key (snd pair :: acc) out
      else go rest (fst pair) [snd pair] (if List.isEmpty acc then out else (key, acc) :: out)
  go (List.sort pairs) "" [] []

def build (table : Map Text Entry) : Names :=
  let entries := Map.toList table
  let bySegment := groups (List.map (fun pair => (lastSegment (fst pair), fst pair)) entries)
  -- A mounted structure the project also has under its own name is the project's to name (D206).
  let shadowed := fun fqn =>
    let rest := Text.drop 4 fqn
    startsWith "lib." fqn && (match Map.lookup (Text.drop (indexOf rest "." 0 + 1) rest) table with
      | Option.some (Entry.type _ _ _) => true
      | _ => false)
  let fieldOwners := groups (concatMap (fun pair =>
    match pair with
    | (fqn, Entry.type _ _ fields) => if shadowed fqn then [] else List.map (fun f => (f, fqn)) fields
    | _ => []) entries)
  Names.mk table (Dict.fromList entries) (Dict.fromList bySegment) (Dict.fromList fieldOwners)

def joinName (prefix : List Text) (name : Text) : Text := Text.join "." (prefix ++ [name])

/-- Resolves a name: the namespace chain innermost first, then `open`s, then (if `suffix`) a
  unique fully qualified name ending in `.name`, as Unison's suffix-based names; among several, the one
  at a library's root (`lib.<library>.name`) wins. -/
def lookup (names : Names) (name : Text) (scope : Scope) (want : Entry -> Bool) (suffix : Bool) : {Throw Text} Option (Text, Entry) :=
  let index := Names.index names
  let probe := fun fqn =>
    match Dict.lookup fqn index with
    | Option.some e => if want e then Option.some (fqn, e) else Option.none
    | Option.none => Option.none
  let rec chain prefix :=
    match probe (joinName (reverse prefix) name) with
    | Option.some hit => Option.some hit
    | Option.none =>
        match prefix with
        | [] => Option.none
        | _ :: rest => chain rest
  let rec viaOpens os :=
    match os with
    | [] => Option.none
    | o :: rest =>
        match probe (o ++ "." ++ name) with
        | Option.some hit => Option.some hit
        | Option.none => viaOpens rest
  match chain (reverse (Scope.ns scope)) with
  | Option.some hit => Option.some hit
  | Option.none =>
      match viaOpens scope.opens with
      | Option.some hit => Option.some hit
      | Option.none => if not suffix then Option.none else
          let candidates := getOr (Dict.lookup (lastSegment name) names.bySegment) []
          let matches := List.filter
            (fun fqn => (fqn == name || endsWith ("." ++ name) fqn) && isSome (probe fqn))
            candidates
          -- A library's root namespace counts like the project's (D189): `fst` is `fst`, not `Pair.fst`.
          let rooted := List.filter (fun fqn => atLibraryRoot fqn name) matches
          -- A library's root name, then the project's own names, before the rest of its libraries' (D206).
          let own := List.filter (fun fqn => not (startsWith "lib." fqn)) matches
          match matches with
          | [] => Option.none
          | fqn :: [] => probe fqn
          | _ =>
              match (rooted, own) with
              | (fqn :: [], _) => probe fqn
              | ([], fqn :: []) => probe fqn
              | _ => Throw.throw ("ambiguous name " ++ name ++ ": " ++ join ", " (sort matches))

/-- Whether `fqn` is `lib.<library>.<name>`: `name` at the root of a mounted library (D49, D189). -/
def atLibraryRoot (fqn : Text) (name : Text) : Bool :=
  let rest := Text.drop 4 fqn
  let dot := indexOf rest "." 0
  startsWith "lib." fqn && dot > 0 && Text.drop (dot + 1) rest == name

/-- `name` in the project, or else in the one mounted library that has it: what a name written in a document means (D206). -/
def lookupMounted (ns : Map Text Entry) (name : Text) : Option Entry :=
  match Map.lookup name ns with
  | Option.some e => Option.some e
  | Option.none => if startsWith "lib." name then Option.none else Map.lookup name (unmounted ns)

/-- The mounted libraries' names without their mount, those exactly one library has (D206). -/
def unmounted (ns : Map Text Entry) : Map Text Entry :=
  let pairs := filterMap
    (fun pair => if startsWith "lib." (fst pair) then Option.some (unmount (fst pair), snd pair) else Option.none)
    (Map.toList ns)
  let counts := foldl
    (fun m pair => Map.insert (fst pair) (getOr (Map.lookup (fst pair) m) 0 + 1) m)
    Map.empty
    pairs
  Map.fromList (List.filter (fun pair => Map.lookup (fst pair) counts == Option.some 1) pairs)

/-- `fqn` without its library mount: `List.map` for `List.map`; a project name unchanged. -/
def unmount (fqn : Text) : Text :=
  let rest := Text.drop 4 fqn
  if startsWith "lib." fqn then Text.drop (indexOf rest "." 0 + 1) rest else fqn

end Names

/-- The result of compiling a batch of declarations. -/
structure Batch where
  objects : List (Text, Sexp)
  entries : List (Text, Entry)
  metas : List (Text, Sexp)
  warnings : List Text

namespace Resolve

def s (t : Text) : Sexp := Sexp.str t

def n (k : Int) : Sexp := Sexp.int k

def node (head : Text) (items : List Sexp) : Sexp := Sexp.node head items

def unitCore : Sexp := node "con" [s "#Unit", n 0, n 0]

def trueCore : Sexp := node "con" [s "#Bool", n 1, n 0]

def falseCore : Sexp := node "con" [s "#Bool", n 0, n 0]

def pairCon : Sexp := node "con" [s "#Pair", n 0, n 2]

def consCon : Sexp := node "con" [s "#List", n 1, n 2]

def nilCon : Sexp := node "con" [s "#List", n 0, n 0]

def app (f : Sexp) (args : List Sexp) : Sexp := node "app" (f :: args)

/-- The body of a declaration without one (D93): the defect `not implemented: <name>`, under a lambda
  applied to the printed signature, so the hash covers the name and the type. -/
def stub (fqn : Text) (signature : Sexp) : Sexp := Resolve.app (Compile.node "lam" [Sexp.s "", Resolve.app
  (Compile.node "prim" [Sexp.s "defect"])
  [Compile.node "text" [Sexp.s ("not implemented: " ++ fqn)]]]) [Compile.node "text" [Sexp.s (Sexp.print signature)]]

/-- The name and printed signature of a stripped `stub` body, after its parameters' lambdas. -/
def stubOf (body : Sexp) : Option (Text, Text) :=
  match body with
  | Sexp.list [Sexp.sym "app", Sexp.list [Sexp.sym "lam", Sexp.list [Sexp.sym "app", Sexp.list [Sexp.sym "prim", Sexp.str "defect"], Sexp.list [Sexp.sym "text", Sexp.str message]]], Sexp.list [Sexp.sym "text", Sexp.str signature]] =>
    if Text.startsWith "not implemented: " message then some (Text.drop 17 message, signature) else none
  | _ => none

/-- Whether stripped Core is a declaration without a body. -/
def isStub (core : Sexp) : Bool :=
  match core with
  | Sexp.list [Sexp.sym "lam", b] => isStub b
  | _ => Option.isSome (stubOf core)

def binopPrim (op : Text) : Text :=
  if op == "+" then "Int.add"
  else if op == "-" then "Int.sub"
  else if op == "*" then "Int.mul"
  else if op == "/" then "Int.div"
  else if op == "%" then "Int.mod"
  else if op == "==" || op == "=" then "eq"
  else if op == "!=" then "neq"
  else if op == "<" then "lt"
  else if op == "<=" then "le"
  else if op == ">" then "gt"
  else if op == ">=" then "ge"
  else if op == "++" then "append"
  else if op == "->" then "implies"
  else defect ("unknown operator " ++ op)

/-- Right-nested pairs: `(a, b, c)` is `(a, (b, c))`, as in Unison. -/
def tuple (items : List Sexp) : Sexp :=
  match List.reverse items with
  | [] => unitCore
  | last :: rest => List.foldl (fun acc x => app pairCon [x, acc]) last rest

def patTuple (items : List Sexp) : Sexp :=
  match List.reverse items with
  | [] => node "pcon" [s "#Unit", n 0]
  | last :: rest => List.foldl (fun acc x => node "pcon" [s "#Pair", n 0, x, acc]) last rest

/-- A type IRI: explicit, or derived from the fully qualified name. -/
def iriFor (fqn : Text) (iri : Option Text) : Text := Option.getOr iri ("urn:deus:" ++ fqn)

/-- Builtin types (IRI `#…`) are their own hash; the kernel knows them by it. -/
def hashFor (iri : Text) (form : Sexp) : Text := if startsWith "#" iri then iri else Text.sha256 (Sexp.print form)

def arrowCount : Ty -> Int
  | Ty.arrow _ b _ => 1 + arrowCount b
  | _ => 0

/-- Resolves a type to its Core form; params become `(tvar i)`, other lower-case names `(tvar "a")`. -/
def tyCore (names : Names) (scope : Scope) (params : List Text) (t : Ty) : {Throw Text} Sexp :=
  let go := fun x => Resolve.tyCore names scope params x
  match t with
  | Ty.unit => Compile.node "tref" [Compile.s "#Unit"]
  | Ty.effects row result => Compile.node "teff" [Compile.node "eff" (List.map go row), go result]
  | Ty.row items => Compile.node "trow" (List.map go items)
  | Ty.tuple items => foldl
      (fun acc x => Compile.node "tapp" [Compile.node "tref" [Compile.s "#Pair"], x, acc])
      (go (getOr (last? items) Ty.unit))
      (List.drop 1 (reverse (List.map go items)))
  | Ty.arrow a b effects =>
      let effs :=
        match effects with
        | Option.none => []
        | Option.some es => [Compile.node "eff" (List.map go es)]
      Compile.node "tfun" ([go a, go b] ++ effs)
  | Ty.named name args =>
      let index := findIndex (fun p => p == name) params
      let head := if index >= 0 then Compile.node "tvar" [Compile.n index] else
        match Names.lookup names name scope isTypeName true with
        | Option.some (_, Entry.type _ iri _) => Compile.node "tref" [Compile.s iri]
        | Option.some (_, Entry.ability _ iri) => Compile.node "tref" [Compile.s iri]
        | _ =>
            let c := code name 0
            if c >= 'a' && c <= 'z' then Compile.node "tvar" [Compile.s name] else Throw.throw ("unknown type " ++ name)
      if List.isEmpty args then head else Compile.node "tapp" (head :: List.map go args)

--
-- Expressions.
--

/-- Per-definition context for desugaring; `templates` are the expansions of the notations the batch declares. -/
structure Ctx where
  names : Names
  scope : Scope
  origin : Text
  templates : Map Text Sexp

def failAt (ctx : Ctx) (pos : Pos) (message : Text) : {Throw Text} a := Throw.throw (ctx.origin ++ ":" ++ Int.toText pos.atLine ++ ":" ++ Int.toText pos.atCol ++ ": " ++ message)

def fail (ctx : Ctx) (message : Text) : {Throw Text} a := Throw.throw (ctx.origin ++ ": " ++ message)

/-- De Bruijn index of a local (locals are innermost first), or -1. -/
def localIndex (locals : List (Option Text)) (name : Text) : Int := List.findIndex (fun l => l == some name) locals

def coreOfEntry (ctx : Ctx) (pos : Pos) (fqn : Text) (e : Entry) : {Throw Text} Sexp :=
  match e with
  | Entry.term h => Compile.node "ref" [Sexp.s h]
  | Entry.ctor t tag arity => Compile.node "con" [Sexp.s t, i tag, i arity]
  | Entry.op a index arity => Compile.node "op" [Sexp.s a, i index, i arity]
  | _ => failAt ctx pos (fqn ++ " is not a value")

/-- The accessor for `.field`, the `nth` access at `pos`. A field several structures share becomes
  `(pick field key owners accessors…)`, which the checker resolves by the receiver's type (R-8). -/
def fieldAccessor (ctx : Ctx) (pos : Pos) (field : Text) (nth : Int) : {Throw Text} Sexp :=
  let accessor := fun owner =>
    match Dict.lookup (owner ++ "." ++ field) (ctx.names).index with
    | Option.some e => coreOfEntry ctx pos (owner ++ "." ++ field) e
    | Option.none => failAt ctx pos ("missing accessor " ++ owner ++ "." ++ field)
  match getOr (Dict.lookup field (ctx.names).fieldOwners) [] with
  | owner :: [] => accessor owner
  | [] => failAt ctx pos ("unknown field " ++ field)
  | owners =>
      let sorted := sort owners
      let key := ctx.origin ++ ":" ++ Int.toText pos.atLine ++ ":" ++ Int.toText pos.atCol ++
        (if nth == 0 then "" else "." ++ Int.toText nth)
      Compile.node
        "pick"
        ([Sexp.s field, Sexp.s key, Sexp.s (join ", " sorted)] ++ List.map accessor sorted)

def valueOf (ctx : Ctx) (name : Text) (pos : Pos) (locals : List (Option Text)) : {Throw Text} Sexp :=
  let index := localIndex locals name
  if index >= 0 then Compile.node "var" [Compile.n index] else
    let dot := indexOf name "." 0
    let headIndex := if dot > 0 then localIndex locals (Text.slice name 0 dot) else -1
    if headIndex >= 0 then
      -- `p.x.y`: field access on a local.
      let fields := Text.split (Text.drop (dot + 1) name) "."
      foldl
        (fun acc pair => Resolve.app (fieldAccessor ctx pos (snd pair) (fst pair)) [acc])
        (Compile.node "var" [Compile.n headIndex])
        (mapIndexed (fun i f => (i, f)) fields)
    else
      match Names.lookup ctx.names name ctx.scope isValue true with
      | Option.some (fqn, e) => coreOfEntry ctx pos fqn e
      | Option.none => failAt ctx pos ("unknown name " ++ name)

def ctorOf (ctx : Ctx) (name : Text) (suffix : Bool) : {Throw Text} Option Entry :=
  match Names.lookup ctx.names name ctx.scope isCtor suffix with
  | Option.some (_, e) => Option.some e
  | Option.none => Option.none

/-- A pattern that only binds a name (or nothing): returns the bound name. -/
def simpleBinder (ctx : Ctx) (p : Pat) : {Throw Text} Option (Option Text) :=
  match p with
  | Pat.wild => Option.some Option.none
  | Pat.unit => Option.some Option.none
  | Pat.ann q _ => Resolve.simpleBinder ctx q
  | Pat.id name [] _ => if Text.contains "." name then Option.none else if isSome (ctorOf ctx name false) then Option.none else Option.some (Option.some name)
  | _ => Option.none

/-- Core pattern; `binds` collects bound names innermost first (the locals order). -/
def pat (ctx : Ctx) (p : Pat) (binds : List (Option Text)) : {Throw Text} (Sexp, List (Option Text)) :=
  match p with
  | Pat.wild => (Compile.node "pany" [], binds)
  | Pat.int v => (Compile.node "pint" [Compile.n v], binds)
  | Pat.ann q t =>
      let (core, binds2) := Resolve.pat ctx q binds
      (Compile.node "ann" [tyCore ctx.names ctx.scope [] t, core], binds2)
  | Pat.spelled text q =>
      let (core, binds2) := Resolve.pat ctx q binds
      (Compile.node "spelled" [Compile.s text, core], binds2)
  | Pat.text v => (Compile.node "ptext" [Compile.s v], binds)
  | Pat.bool v => (Compile.node "pcon" [Compile.s "#Bool", Compile.n (if v then 1 else 0)], binds)
  | Pat.unit => (Compile.node "pcon" [Compile.s "#Unit", Compile.n 0], binds)
  | Pat.as name inner =>
      let (core, b2) := Resolve.pat ctx inner (Option.some name :: binds)
      (Compile.node "pas" [Compile.s name, core], b2)
  | Pat.cons h t =>
      let (hc, b1) := Resolve.pat ctx h binds
      let (tc, b2) := Resolve.pat ctx t b1
      (Compile.node "pcon" [Compile.s "#List", Compile.n 1, hc, tc], b2)
  | Pat.list items =>
      let (cores, b2) := Resolve.pats ctx items binds
      (List.foldr
        (fun x acc => Compile.node "pcon" [Compile.s "#List", Compile.n 1, x, acc])
        (Compile.node "pcon" [Compile.s "#List", Compile.n 0])
        cores, b2)
  | Pat.tuple items =>
      let (cores, b2) := Resolve.pats ctx items binds
      (patTuple cores, b2)
  | Pat.id name args pos => ctorPat ctx name args pos (Text.contains "." name || not (List.isEmpty args)) binds
  | Pat.dot name args pos => ctorPat ctx name args pos true binds

def pats (ctx : Ctx) (ps : List Pat) (binds : List (Option Text)) : {Throw Text} (List Sexp, List (Option Text)) :=
  let rec go rest acc b :=
    match rest with
    | [] => (reverse acc, b)
    | p :: more =>
        let (core, b2) := pat ctx p b
        go more (core :: acc) b2
  go ps [] binds

def ctorPat (ctx : Ctx) (name : Text) (args : List Pat) (pos : Pos) (qualified : Bool) (binds : List (Option Text)) : {Throw Text} (Sexp, List (Option Text)) :=
  match ctorOf ctx name qualified with
  | Option.none => if qualified then failAt ctx pos ("unknown constructor " ++ name) else (Compile.node "pvar" [Compile.s name], Option.some name :: binds)
  | Option.some (Entry.ctor t tag arity) => if arity != List.length args then failAt ctx pos ("constructor " ++ name ++ " takes " ++ Int.toText arity ++ " arguments") else
      let (cores, b2) := Resolve.pats ctx args binds
      (Compile.node "pcon" ([Compile.s t, Compile.n tag] ++ cores), b2)
  | Option.some _ => failAt ctx pos ("not a constructor: " ++ name)

/-- `fun p1 p2 => body`: plain names bind directly; other patterns match on the argument. -/
def lambda (ctx : Ctx) (params : List Pat) (body : List (Option Text) -> {Throw Text} Sexp) (locals : List (Option Text)) : {Throw Text} Sexp :=
  match params with
  | [] => body locals
  | first :: rest =>
      match simpleBinder ctx first with
      | Option.some name =>
          let inner := Resolve.lambda ctx rest body (name :: locals)
          -- A binder's ascription types local 0 for the checker (D95); `unnote` removes it.
          let checked :=
            match first with
            | Pat.ann _ t => Compile.node "annlocal" [tyCore ctx.names ctx.scope [] t, inner]
            | _ => inner
          Compile.node "lam" [Compile.s (getOr name ""), checked]
      | Option.none =>
          let (core, binds) := pat ctx first []
          Compile.node "lam" [Compile.node
            "match"
            [Compile.node "var" [Compile.n 0], Compile.node
              "case"
              [core, Resolve.lambda ctx rest body (binds ++ Option.none :: locals)]]]

def arms (ctx : Ctx) (scrut : Sexp) (list : List Arm) (locals : List (Option Text)) : {Throw Text} Sexp := Compile.node "match" (scrut :: List.map (fun arm =>
  let result :=
    match arm.pats with
    | single :: [] => pat ctx single []
    | ps =>
        let (cores, b) := Resolve.pats ctx ps []
        (patTuple cores, b)
  let (core, binds) := result
  Compile.node "case" [core, Resolve.expr ctx arm.body (binds ++ locals)]) list)

/-- Equations `| p, q => …`: one lambda per pattern column, then a match on their tuple. -/
def equations (ctx : Ctx) (list : List Arm) (locals : List (Option Text)) : {Throw Text} Sexp :=
  let count :=
    match list with
    | arm :: _ => List.length arm.pats
    | [] => 0
  let inner := replicate count Option.none ++ locals
  let scrut := if count == 1 then Compile.node "var" [Compile.n 0] else Resolve.tuple (List.map (fun i => Compile.node "var" [Compile.n (count - 1 - i)]) (range 0 count))
  let rec wrap k body := if k == 0 then body else wrap (k - 1) (Compile.node "lam" [body])
  wrap count (Resolve.arms ctx scrut list inner)

def structFields (ctx : Ctx) (fqn : Text) : List Text :=
  match Dict.lookup fqn (ctx.names).index with
  | Option.some (Entry.type _ _ fields) => fields
  | _ => []

def structHash (ctx : Ctx) (fqn : Text) : Text :=
  match Dict.lookup fqn (ctx.names).index with
  | Option.some (Entry.type h _ _) => h
  | _ => ""

/-- `{ x := 1, y := 2 }` and `{ p with y := 3 }`: the structure is the unique one with these fields. -/
def record (ctx : Ctx) (base : Option Expr) (fields : List (Text, Expr)) (pos : Pos) (locals : List (Option Text)) : {Throw Text} Sexp :=
  let given := List.map fst fields
  let owners :=
    match given with
    | [] => []
    | f :: _ => getOr (Dict.lookup f (ctx.names).fieldOwners) []
  let fits := fun owner =>
    let have := structFields ctx owner
    List.all (fun g => List.contains g have) given && (isSome base || List.length have == List.length given)
  let fitting := List.filter fits owners
  -- The project's structure before a library's, and one structure under two names is one (D206).
  let chosen :=
    match List.filter (fun o => not (startsWith "lib." o)) fitting with
    | o :: [] => [o]
    | _ => if List.all (fun o => structHash ctx o == structHash ctx (getOr (head? fitting) "")) fitting then List.take 1 fitting else fitting
  match chosen with
  | owner :: [] =>
      let have := structFields ctx owner
      let count := List.length have
      let mk := Compile.node "con" [Compile.s (structHash ctx owner), Compile.n 0, Compile.n count]
      match base with
      | Option.none => Resolve.app
          mk
          (List.map (fun f => Resolve.expr ctx (getOr (List.lookup f fields) Expr.unit) locals) have)
      | Option.some b =>
          let inner := replicate count Option.none ++ locals
          let values := mapIndexed (fun i f =>
            match List.lookup f fields with
            | Option.some e => Resolve.expr ctx e inner
            | Option.none => Compile.node "var" [Compile.n (count - 1 - i)]) have
          Compile.node "match" [Resolve.expr ctx b locals, Compile.node
            "case"
            [Compile.node "pcon" ([Compile.s (structHash ctx owner), Compile.n 0] ++
              replicate count (Compile.node "pvar" [])), Resolve.app mk values]]
  | [] => failAt ctx pos ("no structure has fields " ++ join ", " given)
  | _ => failAt ctx pos ("ambiguous record " ++ join ", " given)

def flattenApp (f : Sexp) (args : List Sexp) : Sexp :=
  match f with
  | Sexp.list (Sexp.sym "app" :: inner) => Sexp.list (Sexp.sym "app" :: inner ++ args)
  | _ => app f args

def expr (ctx : Ctx) (e : Expr) (locals : List (Option Text)) : {Throw Text} Sexp :=
  let go := fun x => Resolve.expr ctx x locals
  match e with
  | Expr.var name pos => valueOf ctx name pos locals
  | Expr.dot name pos =>
      match ctorOf ctx name true with
      | Option.some (Entry.ctor t tag arity) => Compile.node "con" [Compile.s t, Compile.n tag, Compile.n arity]
      | _ => failAt ctx pos ("unknown constructor ." ++ name)
  | Expr.int v => Compile.node "int" [Compile.n v]
  | Expr.text v => Compile.node "text" [Compile.s v]
  | Expr.bool v => if v then trueCore else falseCore
  | Expr.unit => unitCore
  | Expr.prim name => Compile.node "prim" [Compile.s name]
  | Expr.app f args => flattenApp (go f) (List.map go args)
  | Expr.lam params body => lambda ctx params (fun inner => Resolve.expr ctx body inner) locals
  | Expr.lamMatch list => equations ctx list locals
  | Expr.letPat p value body =>
      let v := go value
      match p with
      | Pat.wild => Compile.node "seq" [v, go body]
      | _ =>
          match simpleBinder ctx p with
          | Option.some name => Compile.node
              "let"
              [Compile.s (getOr name ""), v, Resolve.expr ctx body (name :: locals)]
          | Option.none =>
              let (core, binds) := pat ctx p []
              Compile.node
                "match"
                [v, Compile.node "case" [core, Resolve.expr ctx body (binds ++ locals)]]
  | Expr.letFun name params value body isRec => if isRec then
      let inner := Option.some name :: locals
      Compile.node
        "letrec"
        [Compile.node "names" [Compile.s name], Sexp.list [lambda ctx params (fun l => Resolve.expr ctx value l) inner], Resolve.expr ctx body inner]
    else Compile.node
      "let"
      [Compile.s name, lambda ctx params (fun l => Resolve.expr ctx value l) locals, Resolve.expr ctx body (Option.some name :: locals)]
  | Expr.seq first rest => Compile.node "seq" [go first, go rest]
  | Expr.ite c yes no => Compile.node "if" [go c, go yes, go no]
  | Expr.matchOn scruts list =>
      let count := List.length scruts
      if any (fun arm => List.length arm.pats != count) list then Resolve.fail ctx "match arm has the wrong number of patterns" else
        let scrut := if count == 1 then go (getOr (head? scruts) Expr.unit) else Resolve.tuple (List.map go scruts)
        Resolve.arms ctx scrut list locals
  | Expr.handleWith body ret ops =>
      let retClause :=
        match ret with
        | Option.none => []
        | Option.some (p, rbody) =>
            match simpleBinder ctx p with
            | Option.some name => [Compile.node
                "ret"
                [Compile.s (getOr name ""), Resolve.expr ctx rbody (name :: locals)]]
            | Option.none =>
                let (core, binds) := pat ctx p []
                [Compile.node "ret" [Compile.node
                  "match"
                  [Compile.node "var" [Compile.n 0], Compile.node
                    "case"
                    [core, Resolve.expr ctx rbody (binds ++ Option.none :: locals)]]]]
      Compile.node
        "handle"
        ([go body] ++ retClause ++ List.map (fun o => opClause ctx o locals) ops)
  | Expr.binop op l r _ =>
      let lc := go l
      let rc := go r
      if op == "&&" then Compile.node "if" [lc, rc, falseCore] else if op == "||" then Compile.node "if" [lc, trueCore, rc] else if op == "|>" then flattenApp rc [lc] else if op == "<|" then flattenApp lc [rc] else if op == "::" then Resolve.app consCon [lc, rc] else Resolve.app (Compile.node "prim" [Compile.s (binopPrim op)]) [lc, rc]
  | Expr.neg x => Resolve.app (Compile.node "prim" [Compile.s "Int.neg"]) [go x]
  | Expr.not x => Compile.node "if" [go x, falseCore, trueCore]
  | Expr.tuple items => Resolve.tuple (List.map go items)
  | Expr.list items => List.foldr (fun x acc => Resolve.app consCon [go x, acc]) nilCon items
  | Expr.record base fields pos => Resolve.record ctx base fields pos locals
  | Expr.ann x t =>
      -- Checked (D95), then removed before hashing by `unnote`.
      Compile.node "ann" [tyCore ctx.names ctx.scope [] t, go x]
  | Expr.proj x field pos => Resolve.app (fieldAccessor ctx pos field 0) [go x]
  | Expr.note text x => Compile.node "note" [Compile.s text, go x]
  | Expr.spelled text x => Compile.node "spelled" [Compile.s text, go x]
  | Expr.notation key template args =>
      -- The stored term is the expansion; the notation stays as a mark `unnote` keeps as metadata (Syntax.Spec R-2).
      let holes := List.map go args
      match Option.orElse template (fun _ => Map.lookup key ctx.templates) with
      | Option.some t => Compile.node "notation" [Compile.s key, expandWith t holes]
      | Option.none => Resolve.fail ctx ("notation " ++ Text.drop 1 key ++ " has no expansion")

/-- A handler clause: arguments in order, then the continuation, as Core's `on` expects. -/
def opClause (ctx : Ctx) (o : OpArm) (locals : List (Option Text)) : {Throw Text} Sexp :=
  match Names.lookup ctx.names o.op ctx.scope isOp true with
  | Option.some (_, Entry.op a index arity) => if arity != List.length o.args then failAt ctx (OpArm.at o) (o.op ++ " takes " ++ Int.toText arity ++ " arguments") else
      -- Simple arguments bind names; others bind nothing and are matched inside the clause.
      let argNames := List.map (fun p => getOr (simpleBinder ctx p) Option.none) o.args
      let inner := o.resume :: reverse argNames ++ locals
      let complex := List.filter
        (fun pair => isNone (simpleBinder ctx (snd pair)))
        (mapIndexed (fun i p => (i, p)) o.args)
      let rec build rest l :=
        match rest with
        | [] => Resolve.expr ctx o.clause l
        | (index1, p) :: more =>
            let (core, binds) := pat ctx p []
            -- The argument sits below the continuation and the later arguments.
            let depth := List.length l - (List.length locals + index1) - 1
            Compile.node
              "match"
              [Compile.node "var" [Compile.n depth], Compile.node "case" [core, build more (binds ++ l)]]
      let binderNames := List.map (fun o2 => Compile.s (getOr o2 "")) (argNames ++ [o.resume])
      Compile.node
        "on"
        [Compile.s a, Compile.n index, Compile.n arity, Sexp.list binderNames, build complex inner]
  | _ => failAt ctx (OpArm.at o) ("unknown ability operation " ++ o.op)

/-
  Named Core: the resolver writes binder names into Core (`(lam "x" body)`, `(pvar "x")`…).
  `strip` removes them before hashing and returns them in pre-order, so renaming a local never
  changes a hash, and `view` can still print the author's names (stored as metadata).
-/

def strip (form : Sexp) : (Sexp, List Text) :=
  let (core, names, _, _, _, _) := stripNoted form
  (core, names)

/-- `strip`, also returning the comments (D66), number spellings (D88) and notations (Syntax.Spec) it
  removed, and the Core the checker reads: the same, with its ascriptions still in place as `(ann T e)` (D95). -/
def stripNoted (form : Sexp) : (Sexp, (List Text, (List (Int, Text), (List (Int, Text), (List (Int, Text), Sexp))))) :=
  let (named, names) := stripAcc form []
  let (core, notes, spellings, notations) := unnote named
  (core, reverse names, notes, spellings, notations, unmark named)

/--
  Replaces each `(pick …)` by the accessor the checker chose for its key; one it did not choose
  (types off, or a receiver of unknown type) is the ambiguity it was.
-/
def unpick (chosen : Map Text Sexp) (form : Sexp) : {Throw Text} Sexp :=
  match form with
  | Sexp.list (Sexp.sym "pick" :: Sexp.str field :: Sexp.str key :: Sexp.str owners :: _) =>
    match Map.lookup key chosen with
    | some accessor => accessor
    | none => throw (key ++ ": ambiguous field " ++ field ++ ": " ++ owners ++ " (annotate the receiver's type)")
  | Sexp.list items => Sexp.list (List.map (fun x => unpick chosen x) items)
  | _ => form

/-- Removes comments and number spellings, keeping ascriptions: the Core the checker reads (D95). -/
def unmark (form : Sexp) : Sexp :=
  match form with
  | Sexp.list (Sexp.sym "note" :: Sexp.str _ :: inner :: []) => Resolve.unmark inner
  | Sexp.list (Sexp.sym "spelled" :: Sexp.str _ :: inner :: []) => Resolve.unmark inner
  | Sexp.list (Sexp.sym "notation" :: Sexp.str _ :: inner :: []) => Resolve.unmark inner
  | Sexp.list items => Sexp.list (List.map (fun x => Resolve.unmark x) items)
  | _ => form

/-- Removes `(note "text" e)`, `(spelled "text" e)` and `(notation "key" e)` nodes. Each is returned
  with the pre-order index of `e` among the list nodes of the result, the position `Print.restore` puts
  it back at (D66, D88, Syntax.Spec): comments, then spellings, then notations, outermost first.
  Ascriptions `(ann T e)` go without a trace (D95). -/
def unnote (form : Sexp) : (Sexp, (List (Int, Text), (List (Int, Text), List (Int, Text)))) :=
  let notations := Ref.new []
  let rec go x count acc spellings :=
    match x with
    | Sexp.list (Sexp.sym "note" :: Sexp.str text :: inner :: []) =>
        match acc with
        | (at, earlier) :: rest => if at == count then go inner count ((at, earlier ++ "\n" ++ text) :: rest) spellings else go inner count ((count, text) :: acc) spellings
        | [] => go inner count [(count, text)] spellings
    | Sexp.list (Sexp.sym "spelled" :: Sexp.str text :: inner :: []) => go inner count acc ((count, text) :: spellings)
    | Sexp.list (Sexp.sym "notation" :: Sexp.str key :: inner :: []) =>
        Ref.set notations ((count, key) :: Ref.get notations)
        go inner count acc spellings
    | Sexp.list (Sexp.sym "ann" :: _ :: inner :: []) => go inner count acc spellings
    | Sexp.list (Sexp.sym "annlocal" :: _ :: inner :: []) => go inner count acc spellings
    | Sexp.list (Sexp.sym "pick" :: _) =>
        -- A pick becomes one accessor reference, one list node, before the Core is stored.
        (x, count + 1, acc, spellings)
    | Sexp.list items =>
        let rec each rest out c a sp :=
          match rest with
          | [] => (Sexp.list (reverse out), c, a, sp)
          | y :: more =>
              let (y2, c2, a2, sp2) := go y c a sp
              each more (y2 :: out) c2 a2 sp2
        each items [] (count + 1) acc spellings
    | _ => (x, count, acc, spellings)
  let (core, _, notes, spellings) := go form 0 [] []
  (core, reverse notes, reverse spellings, reverse (Ref.get notations))

def nameOf (x : Sexp) : Text :=
  match x with
  | Sexp.str t => t
  | _ => ""

def stripList (items : List Sexp) (acc : List Text) : (List Sexp, List Text) :=
  let rec go rest out a :=
    match rest with
    | [] => (List.reverse out, a)
    | x :: more =>
      match stripAcc x a with
      | (y, a2) => go more (y :: out) a2
  go items [] acc

def stripAcc (form : Sexp) (acc : List Text) : (Sexp, List Text) :=
  let rebuild := fun (head : Text) (prefix : List Sexp) (children : List Sexp) (names : List Text) =>
    match stripList children (List.reverse names ++ acc) with
    | (ys, a2) => (Sexp.list (Sexp.sym head :: prefix ++ ys), a2)
  match form with
  | Sexp.list [Sexp.sym "lam", Sexp.str x, body] => rebuild "lam" [] [body] [x]
  | Sexp.list [Sexp.sym "lam", body] => rebuild "lam" [] [body] [""]
  | Sexp.list [Sexp.sym "let", Sexp.str x, v, body] => rebuild "let" [] [v, body] [x]
  | Sexp.list [Sexp.sym "let", v, body] => rebuild "let" [] [v, body] [""]
  | Sexp.list [Sexp.sym "letrec", Sexp.list (Sexp.sym "names" :: xs), vs, body] =>
    match stripAcc vs (List.reverse (List.map nameOf xs) ++ acc) with
    | (vs2, a1) =>
      match stripAcc body a1 with
      | (body2, a2) => (Sexp.list [Sexp.sym "letrec", vs2, body2], a2)
  | Sexp.list [Sexp.sym "letrec", vs, body] =>
    match stripAcc vs (List.replicate (List.length (Sexp.asList vs)) "" ++ acc) with
    | (vs2, a1) =>
      match stripAcc body a1 with
      | (body2, a2) => (Sexp.list [Sexp.sym "letrec", vs2, body2], a2)
  | Sexp.list [Sexp.sym "pvar", Sexp.str x] => (Sexp.list [Sexp.sym "pvar"], x :: acc)
  | Sexp.list [Sexp.sym "pvar"] => (form, "" :: acc)
  | Sexp.list [Sexp.sym "pas", Sexp.str x, p] => rebuild "pas" [] [p] [x]
  | Sexp.list [Sexp.sym "pas", p] => rebuild "pas" [] [p] [""]
  | Sexp.list [Sexp.sym "ret", Sexp.str x, body] => rebuild "ret" [] [body] [x]
  | Sexp.list [Sexp.sym "ret", body] => rebuild "ret" [] [body] [""]
  | Sexp.list [Sexp.sym "on", a, i, k, Sexp.list xs, body] => rebuild "on" [a, i, k] [body] (List.map nameOf xs)
  | Sexp.list [Sexp.sym "on", a, i, Sexp.int k, body] => rebuild "on" [a, i, Sexp.int k] [body] (List.replicate (k + 1) "")
  | Sexp.list items =>
    match stripList items acc with
    | (ys, a2) => (Sexp.list ys, a2)
  | _ => (form, acc)

end Resolve
