/-
  Resolver: declarations to Core, then to content-addressed objects.

  1. Types and abilities are hashed first. They refer to other types by IRI, never by hash,
     so their hashes need no ordering (docs/DECISIONS.md D6).
  2. Bodies are desugared to Core. A reference to a definition in the same batch is a
     placeholder `(ref "@Fully.Qualified")`; one to the codebase is `(ref "<hash>")`.
  3. Terms are grouped into strongly connected components and hashed dependencies-first;
     a recursive group is hashed as one cycle (Unison's scheme, D5).
-/

/-- What a name denotes in a namespace. -/
inductive Entry where
  | term (hash : Text)
  | ctor (type : Text) (tag : Int) (arity : Int)
  | type (hash : Text) (iri : Text) (fields : List Text)
  | ability (hash : Text) (iri : Text)
  | op (owner : Text) (index : Int) (arity : Int)
  | test (hash : Text)
  | theorem (hash : Text)

namespace Entry

def toSexp : Entry -> Sexp
  | term h => Sexp.node "term" [Sexp.s h]
  | ctor t tag n => Sexp.node "ctor" [Sexp.s t, Sexp.i tag, Sexp.i n]
  | type h iri fields => Sexp.node "type" [Sexp.s h, Sexp.s iri, Sexp.list (List.map Sexp.s fields)]
  | Entry.ability h iri => Sexp.node "ability" [Sexp.s h, Sexp.s iri]
  | op a index n => Sexp.node "op" [Sexp.s a, Sexp.i index, Sexp.i n]
  | Entry.test h => Sexp.node "test" [Sexp.s h]
  | Entry.theorem h => Sexp.node "theorem" [Sexp.s h]

def fromSexp (s : Sexp) : Entry :=
  let a := Sexp.args s
  let txt := fun k => Sexp.asText (Option.getOr (List.get? a k) (Sexp.str ""))
  let num := fun k => Sexp.asInt (Option.getOr (List.get? a k) (Sexp.int 0))
  let h := Sexp.head s
  if h == "term" then Entry.term (txt 0)
  else if h == "ctor" then Entry.ctor (txt 0) (num 1) (num 2)
  else if h == "type" then Entry.type (txt 0) (txt 1) (List.map Sexp.asText (Sexp.asList (Option.getOr (List.get? a 2) (Sexp.list []))))
  else if h == "ability" then Entry.ability (txt 0) (txt 1)
  else if h == "op" then Entry.op (txt 0) (num 1) (num 2)
  else if h == "test" then Entry.test (txt 0)
  else if h == "theorem" then Entry.theorem (txt 0)
  else defect ("unknown entry " ++ Sexp.print s)

def kind : Entry -> Text
  | term _ => "term"
  | ctor _ _ _ => "ctor"
  | type _ _ _ => "type"
  | Entry.ability _ _ => "ability"
  | op _ _ _ => "op"
  | Entry.test _ => "test"
  | Entry.theorem _ => "theorem"

/-- The hash an entry names (a constructor or operation names its type's or ability's). -/
def hash : Entry -> Text
  | term h => h
  | ctor t _ _ => t
  | type h _ _ => h
  | Entry.ability h _ => h
  | op a _ _ => a
  | Entry.test h => h
  | Entry.theorem h => h

def isValue (e : Entry) : Bool :=
  match e with
  | term _ => true
  | ctor _ _ _ => true
  | op _ _ _ => true
  | _ => false

def isCtor (e : Entry) : Bool :=
  match e with
  | ctor _ _ _ => true
  | _ => false

def isOp (e : Entry) : Bool :=
  match e with
  | op _ _ _ => true
  | _ => false

def isTypeName (e : Entry) : Bool :=
  match e with
  | type _ _ _ => true
  | Entry.ability _ _ => true
  | _ => false

end Entry

structure Scope where
  ns : List Text
  opens : List Text

/-- A name table with the indexes resolution needs. -/
structure Names where
  table : Map Text Entry
  bySegment : Map Text (List Text)
  fieldOwners : Map Text (List Text)

namespace Names

def lastSegment (name : Text) : Text :=
  let rec go i := if i < 0 then name else if Text.code name i == '.' then Text.drop (i + 1) name else go (i - 1)
  go (Text.length name - 1)

def build (table : Map Text Entry) : Names :=
  let entries := Map.toList table
  let bySegment := List.foldl (fun m pair =>
    match pair with
    | (fqn, _) => Map.update (lastSegment fqn) (fun old => fqn :: Option.getOr old []) m) Map.empty entries
  let fieldOwners := List.foldl (fun m pair =>
    match pair with
    | (fqn, Entry.type _ _ fields) => List.foldl (fun m2 f => Map.update f (fun old => fqn :: Option.getOr old []) m2) m fields
    | _ => m) Map.empty entries
  Names.mk table bySegment fieldOwners

def joinName (prefix : List Text) (name : Text) : Text := Text.join "." (prefix ++ [name])

/--
  Resolves a name: the namespace chain innermost first, then `open`s, then (if `suffix`) a
  unique fully qualified name ending in `.name`, as Unison's suffix-based names.
-/
def lookup (names : Names) (name : Text) (scope : Scope) (want : Entry -> Bool) (suffix : Bool) : {Throw Text} Option (Text, Entry) :=
  let table := names.table
  let probe := fun fqn =>
    match Map.lookup fqn table with
    | some e => if want e then some (fqn, e) else none
    | none => none
  let rec chain prefix :=
    match probe (joinName (List.reverse prefix) name) with
    | some hit => some hit
    | none =>
      match prefix with
      | [] => none
      | _ :: rest => chain rest
  let rec viaOpens os :=
    match os with
    | [] => none
    | o :: rest =>
      match probe (o ++ "." ++ name) with
      | some hit => some hit
      | none => viaOpens rest
  match chain (List.reverse scope.ns) with
  | some hit => some hit
  | none =>
    match viaOpens scope.opens with
    | some hit => some hit
    | none =>
      if not suffix then none
      else
        let candidates := Option.getOr (Map.lookup (lastSegment name) names.bySegment) []
        let matches := List.filter (fun fqn => (fqn == name || Text.endsWith ("." ++ name) fqn) && Option.isSome (probe fqn)) candidates
        match matches with
        | [] => none
        | [fqn] => probe fqn
        | _ => throw ("ambiguous name " ++ name ++ ": " ++ Text.join ", " (List.sort matches))

end Names

/-- The result of compiling a batch of declarations. -/
structure Batch where
  objects : List (Text, Sexp)
  entries : List (Text, Entry)
  metas : List (Text, Sexp)

namespace Resolve

def s (t : Text) : Sexp := Sexp.str t

def n (k : Int) : Sexp := Sexp.int k

def node (head : Text) (items : List Sexp) : Sexp := Sexp.node head items

def unitCore : Sexp := node "con" [s "#Unit", n 0, n 0]

def trueCore : Sexp := node "con" [s "#Bool", n 1, n 0]

def falseCore : Sexp := node "con" [s "#Bool", n 0, n 0]

def pairCon : Sexp := node "con" [s "#Pair", n 0, n 2]

def consCon : Sexp := node "con" [s "#List", n 1, n 2]

def nilCon : Sexp := node "con" [s "#List", n 0, n 0]

def app (f : Sexp) (args : List Sexp) : Sexp := node "app" (f :: args)

def binopPrim (op : Text) : Text :=
  if op == "+" then "Int.add"
  else if op == "-" then "Int.sub"
  else if op == "*" then "Int.mul"
  else if op == "/" then "Int.div"
  else if op == "%" then "Int.mod"
  else if op == "==" || op == "=" then "eq"
  else if op == "!=" then "neq"
  else if op == "<" then "lt"
  else if op == "<=" then "le"
  else if op == ">" then "gt"
  else if op == ">=" then "ge"
  else if op == "++" then "append"
  else if op == "->" then "implies"
  else defect ("unknown operator " ++ op)

/-- Right-nested pairs: `(a, b, c)` is `(a, (b, c))`, as in Unison. -/
def tuple (items : List Sexp) : Sexp :=
  match List.reverse items with
  | [] => unitCore
  | last :: rest => List.foldl (fun acc x => app pairCon [x, acc]) last rest

def patTuple (items : List Sexp) : Sexp :=
  match List.reverse items with
  | [] => node "pcon" [s "#Unit", n 0]
  | last :: rest => List.foldl (fun acc x => node "pcon" [s "#Pair", n 0, x, acc]) last rest

/-- A type IRI: explicit, or derived from the fully qualified name. -/
def iriFor (fqn : Text) (iri : Option Text) : Text := Option.getOr iri ("urn:deus:" ++ fqn)

/-- Builtin types (IRI `#…`) are their own hash; the kernel knows them by it. -/
def hashFor (iri : Text) (form : Sexp) : Text :=
  if Text.startsWith "#" iri then iri else Text.sha256 (Sexp.print form)

def arrowCount : Ty -> Int
  | Ty.arrow _ b _ => 1 + arrowCount b
  | _ => 0

/-- Resolves a type to its Core form; params become `(tvar i)`, other lower-case names `(tvar "a")`. -/
def tyCore (names : Names) (scope : Scope) (params : List Text) (t : Ty) : {Throw Text} Sexp :=
  let go := fun x => tyCore names scope params x
  match t with
  | Ty.unit => node "tref" [s "#Unit"]
  | Ty.tuple items => List.foldl (fun acc x => node "tapp" [node "tref" [s "#Pair"], x, acc]) (go (Option.getOr (List.last? items) Ty.unit)) (List.drop 1 (List.reverse (List.map go items)))
  | Ty.arrow a b effects =>
    let effs := match effects with
      | none => []
      | some es => [node "eff" (List.map go es)]
    node "tfun" ([go a, go b] ++ effs)
  | Ty.named name args =>
    let index := List.findIndex (fun p => p == name) params
    let head := if index >= 0 then node "tvar" [n index]
      else
        match Names.lookup names name scope Entry.isTypeName true with
        | some (_, Entry.type _ iri _) => node "tref" [s iri]
        | some (_, Entry.ability _ iri) => node "tref" [s iri]
        | _ =>
          let c := Text.code name 0
          if c >= 'a' && c <= 'z' then node "tvar" [s name] else throw ("unknown type " ++ name)
    if List.isEmpty args then head else node "tapp" (head :: List.map go args)

--
-- Expressions.
--

/-- Per-definition context for desugaring. -/
structure Ctx where
  names : Names
  scope : Scope
  origin : Text

def failAt (ctx : Ctx) (pos : Pos) (message : Text) : {Throw Text} a :=
  throw (ctx.origin ++ ":" ++ Int.toText pos.atLine ++ ":" ++ Int.toText pos.atCol ++ ": " ++ message)

def fail (ctx : Ctx) (message : Text) : {Throw Text} a := throw (ctx.origin ++ ": " ++ message)

/-- De Bruijn index of a local (locals are innermost first), or -1. -/
def localIndex (locals : List (Option Text)) (name : Text) : Int := List.findIndex (fun l => l == some name) locals

def coreOfEntry (ctx : Ctx) (pos : Pos) (fqn : Text) (e : Entry) : {Throw Text} Sexp :=
  match e with
  | Entry.term h => node "ref" [s h]
  | Entry.ctor t tag arity => node "con" [s t, n tag, n arity]
  | Entry.op a index arity => node "op" [s a, n index, n arity]
  | _ => failAt ctx pos (fqn ++ " is not a value")

def fieldAccessor (ctx : Ctx) (pos : Pos) (field : Text) : {Throw Text} Sexp :=
  match Option.getOr (Map.lookup field ctx.names.fieldOwners) [] with
  | [owner] =>
    match Map.lookup (owner ++ "." ++ field) ctx.names.table with
    | some e => coreOfEntry ctx pos (owner ++ "." ++ field) e
    | none => failAt ctx pos ("missing accessor " ++ owner ++ "." ++ field)
  | [] => failAt ctx pos ("unknown field " ++ field)
  | owners => failAt ctx pos ("ambiguous field " ++ field ++ ": " ++ Text.join ", " (List.sort owners))

def valueOf (ctx : Ctx) (name : Text) (pos : Pos) (locals : List (Option Text)) : {Throw Text} Sexp :=
  let index := localIndex locals name
  if index >= 0 then node "var" [n index]
  else
    let dot := Text.indexOf name "." 0
    let headIndex := if dot > 0 then localIndex locals (Text.slice name 0 dot) else -1
    if headIndex >= 0 then
      -- `p.x.y`: field access on a local.
      let fields := Text.split (Text.drop (dot + 1) name) "."
      List.foldl (fun acc field => app (fieldAccessor ctx pos field) [acc]) (node "var" [n headIndex]) fields
    else
      match Names.lookup ctx.names name ctx.scope Entry.isValue true with
      | some (fqn, e) => coreOfEntry ctx pos fqn e
      | none => failAt ctx pos ("unknown name " ++ name)

def ctorOf (ctx : Ctx) (name : Text) (suffix : Bool) : {Throw Text} Option Entry :=
  match Names.lookup ctx.names name ctx.scope Entry.isCtor suffix with
  | some (_, e) => some e
  | none => none

/-- A pattern that only binds a name (or nothing): returns the bound name. -/
def simpleBinder (ctx : Ctx) (p : Pat) : {Throw Text} Option (Option Text) :=
  match p with
  | Pat.wild => some none
  | Pat.unit => some none
  | Pat.id name [] _ =>
    if Text.contains "." name then none
    else if Option.isSome (ctorOf ctx name false) then none
    else some (some name)
  | _ => none

/-- Core pattern; `binds` collects bound names innermost first (the locals order). -/
def pat (ctx : Ctx) (p : Pat) (binds : List (Option Text)) : {Throw Text} (Sexp, List (Option Text)) :=
  match p with
  | Pat.wild => (node "pany" [], binds)
  | Pat.int v => (node "pint" [n v], binds)
  | Pat.text v => (node "ptext" [s v], binds)
  | Pat.bool v => (node "pcon" [s "#Bool", n (if v then 1 else 0)], binds)
  | Pat.unit => (node "pcon" [s "#Unit", n 0], binds)
  | Pat.as name inner =>
    match pat ctx inner (some name :: binds) with
    | (core, b2) => (node "pas" [s name, core], b2)
  | Pat.cons h t =>
    match pat ctx h binds with
    | (hc, b1) =>
      match pat ctx t b1 with
      | (tc, b2) => (node "pcon" [s "#List", n 1, hc, tc], b2)
  | Pat.list items =>
    match pats ctx items binds with
    | (cores, b2) => (List.foldr (fun x acc => node "pcon" [s "#List", n 1, x, acc]) (node "pcon" [s "#List", n 0]) cores, b2)
  | Pat.tuple items =>
    match pats ctx items binds with
    | (cores, b2) => (patTuple cores, b2)
  | Pat.id name args pos => ctorPat ctx name args pos (Text.contains "." name || not (List.isEmpty args)) binds
  | Pat.dot name args pos => ctorPat ctx name args pos true binds

def pats (ctx : Ctx) (ps : List Pat) (binds : List (Option Text)) : {Throw Text} (List Sexp, List (Option Text)) :=
  let rec go rest acc b :=
    match rest with
    | [] => (List.reverse acc, b)
    | p :: more =>
      match pat ctx p b with
      | (core, b2) => go more (core :: acc) b2
  go ps [] binds

def ctorPat (ctx : Ctx) (name : Text) (args : List Pat) (pos : Pos) (qualified : Bool) (binds : List (Option Text)) : {Throw Text} (Sexp, List (Option Text)) :=
  match ctorOf ctx name qualified with
  | none =>
    if qualified then failAt ctx pos ("unknown constructor " ++ name)
    else (node "pvar" [s name], some name :: binds)
  | some (Entry.ctor t tag arity) =>
    if arity != List.length args then failAt ctx pos ("constructor " ++ name ++ " takes " ++ Int.toText arity ++ " arguments")
    else
      match pats ctx args binds with
      | (cores, b2) => (node "pcon" ([s t, n tag] ++ cores), b2)
  | some _ => failAt ctx pos ("not a constructor: " ++ name)

/-- `fun p1 p2 => body`: plain names bind directly; other patterns match on the argument. -/
def lambda (ctx : Ctx) (params : List Pat) (body : List (Option Text) -> {Throw Text} Sexp) (locals : List (Option Text)) : {Throw Text} Sexp :=
  match params with
  | [] => body locals
  | first :: rest =>
    match simpleBinder ctx first with
    | some name => node "lam" [s (Option.getOr name ""), lambda ctx rest body (name :: locals)]
    | none =>
      match pat ctx first [] with
      | (core, binds) => node "lam" [node "match" [node "var" [n 0], node "case" [core, lambda ctx rest body (binds ++ (none :: locals))]]]

def arms (ctx : Ctx) (scrut : Sexp) (list : List Arm) (locals : List (Option Text)) : {Throw Text} Sexp :=
  node "match" (scrut :: List.map (fun arm =>
    let result := match arm.pats with
      | [single] => pat ctx single []
      | ps =>
        match pats ctx ps [] with
        | (cores, b) => (patTuple cores, b)
    match result with
    | (core, binds) => node "case" [core, expr ctx arm.body (binds ++ locals)]) list)

/-- Equations `| p, q => …`: one lambda per pattern column, then a match on their tuple. -/
def equations (ctx : Ctx) (list : List Arm) (locals : List (Option Text)) : {Throw Text} Sexp :=
  let count := match list with
    | arm :: _ => List.length arm.pats
    | [] => 0
  let inner := List.replicate count none ++ locals
  let scrut := if count == 1 then node "var" [n 0] else tuple (List.map (fun i => node "var" [n (count - 1 - i)]) (List.range 0 count))
  let rec wrap k body := if k == 0 then body else wrap (k - 1) (node "lam" [body])
  wrap count (arms ctx scrut list inner)

def structFields (ctx : Ctx) (fqn : Text) : List Text :=
  match Map.lookup fqn ctx.names.table with
  | some (Entry.type _ _ fields) => fields
  | _ => []

def structHash (ctx : Ctx) (fqn : Text) : Text :=
  match Map.lookup fqn ctx.names.table with
  | some (Entry.type h _ _) => h
  | _ => ""

/-- `{ x := 1, y := 2 }` and `{ p with y := 3 }`: the structure is the unique one with these fields. -/
def record (ctx : Ctx) (base : Option Expr) (fields : List (Text, Expr)) (pos : Pos) (locals : List (Option Text)) : {Throw Text} Sexp :=
  let given := List.map fst fields
  let owners := match given with
    | [] => []
    | f :: _ => Option.getOr (Map.lookup f ctx.names.fieldOwners) []
  let fits := fun owner =>
    let have := structFields ctx owner
    List.all (fun g => List.contains g have) given && (Option.isSome base || List.length have == List.length given)
  match List.filter fits owners with
  | [owner] =>
    let have := structFields ctx owner
    let count := List.length have
    let mk := node "con" [s (structHash ctx owner), n 0, n count]
    match base with
    | none => app mk (List.map (fun f => expr ctx (Option.getOr (List.lookup f fields) Expr.unit) locals) have)
    | some b =>
      let inner := List.replicate count none ++ locals
      let values := List.mapIndexed (fun i f =>
        match List.lookup f fields with
        | some e => expr ctx e inner
        | none => node "var" [n (count - 1 - i)]) have
      node "match" [expr ctx b locals, node "case" [node "pcon" ([s (structHash ctx owner), n 0] ++ List.replicate count (node "pvar" [])), app mk values]]
  | [] => failAt ctx pos ("no structure has fields " ++ Text.join ", " given)
  | _ => failAt ctx pos ("ambiguous record " ++ Text.join ", " given)

def flattenApp (f : Sexp) (args : List Sexp) : Sexp :=
  match f with
  | Sexp.list (Sexp.sym "app" :: inner) => Sexp.list (Sexp.sym "app" :: inner ++ args)
  | _ => app f args

def expr (ctx : Ctx) (e : Expr) (locals : List (Option Text)) : {Throw Text} Sexp :=
  let go := fun x => expr ctx x locals
  match e with
  | Expr.var name pos => valueOf ctx name pos locals
  | Expr.dot name pos =>
    match ctorOf ctx name true with
    | some (Entry.ctor t tag arity) => node "con" [s t, n tag, n arity]
    | _ => failAt ctx pos ("unknown constructor ." ++ name)
  | Expr.int v => node "int" [n v]
  | Expr.text v => node "text" [s v]
  | Expr.bool v => if v then trueCore else falseCore
  | Expr.unit => unitCore
  | Expr.prim name => node "prim" [s name]
  | Expr.app f args => flattenApp (go f) (List.map go args)
  | Expr.lam params body => lambda ctx params (fun inner => expr ctx body inner) locals
  | Expr.lamMatch list => equations ctx list locals
  | Expr.letPat p value body =>
    let v := go value
    match p with
    | Pat.wild => node "seq" [v, go body]
    | _ =>
      match simpleBinder ctx p with
      | some name => node "let" [s (Option.getOr name ""), v, expr ctx body (name :: locals)]
      | none =>
        match pat ctx p [] with
        | (core, binds) => node "match" [v, node "case" [core, expr ctx body (binds ++ locals)]]
  | Expr.letFun name params value body isRec =>
    if isRec then
      let inner := some name :: locals
      node "letrec" [node "names" [s name], Sexp.list [lambda ctx params (fun l => expr ctx value l) inner], expr ctx body inner]
    else node "let" [s name, lambda ctx params (fun l => expr ctx value l) locals, expr ctx body (some name :: locals)]
  | Expr.seq first rest => node "seq" [go first, go rest]
  | Expr.ite c yes no => node "if" [go c, go yes, go no]
  | Expr.matchOn scruts list =>
    let count := List.length scruts
    if List.any (fun arm => List.length arm.pats != count) list then fail ctx "match arm has the wrong number of patterns"
    else
      let scrut := if count == 1 then go (Option.getOr (List.head? scruts) Expr.unit) else tuple (List.map go scruts)
      arms ctx scrut list locals
  | Expr.handleWith body ret ops =>
    let retClause := match ret with
      | none => []
      | some (p, rbody) =>
        match simpleBinder ctx p with
        | some name => [node "ret" [s (Option.getOr name ""), expr ctx rbody (name :: locals)]]
        | none =>
          match pat ctx p [] with
          | (core, binds) => [node "ret" [node "match" [node "var" [n 0], node "case" [core, expr ctx rbody (binds ++ (none :: locals))]]]]
    node "handle" ([go body] ++ retClause ++ List.map (fun o => opClause ctx o locals) ops)
  | Expr.binop op l r _ =>
    let lc := go l
    let rc := go r
    if op == "&&" then node "if" [lc, rc, falseCore]
    else if op == "||" then node "if" [lc, trueCore, rc]
    else if op == "|>" then flattenApp rc [lc]
    else if op == "<|" then flattenApp lc [rc]
    else if op == "::" then app consCon [lc, rc]
    else app (node "prim" [s (binopPrim op)]) [lc, rc]
  | Expr.neg x => app (node "prim" [s "Int.neg"]) [go x]
  | Expr.not x => node "if" [go x, falseCore, trueCore]
  | Expr.tuple items => tuple (List.map go items)
  | Expr.list items => List.foldr (fun x acc => app consCon [go x, acc]) nilCon items
  | Expr.record base fields pos => record ctx base fields pos locals
  | Expr.ann x _ => go x
  | Expr.proj x field pos => app (fieldAccessor ctx pos field) [go x]

/-- A handler clause: arguments in order, then the continuation, as Core's `on` expects. -/
def opClause (ctx : Ctx) (o : OpArm) (locals : List (Option Text)) : {Throw Text} Sexp :=
  match Names.lookup ctx.names o.op ctx.scope Entry.isOp true with
  | some (_, Entry.op a index arity) =>
    if arity != List.length o.args then failAt ctx o.at (o.op ++ " takes " ++ Int.toText arity ++ " arguments")
    else
      -- Simple arguments bind names; others bind nothing and are matched inside the clause.
      let argNames := List.map (fun p => Option.getOr (simpleBinder ctx p) none) o.args
      let inner := o.resume :: List.reverse argNames ++ locals
      let complex := List.filter (fun pair => Option.isNone (simpleBinder ctx (snd pair))) (List.mapIndexed (fun i p => (i, p)) o.args)
      let rec build rest l :=
        match rest with
        | [] => expr ctx o.clause l
        | (index, p) :: more =>
          match pat ctx p [] with
          | (core, binds) =>
            -- The argument sits below the continuation and the later arguments.
            let depth := List.length l - (List.length locals + index) - 1
            node "match" [node "var" [n depth], node "case" [core, build more (binds ++ l)]]
      let binderNames := List.map (fun o2 => s (Option.getOr o2 "")) (argNames ++ [o.resume])
      node "on" [s a, n index, n arity, Sexp.list binderNames, build complex inner]
  | _ => failAt ctx o.at ("unknown ability operation " ++ o.op)

/-
  Named Core: the resolver writes binder names into Core (`(lam "x" body)`, `(pvar "x")`…).
  `strip` removes them before hashing and returns them in pre-order, so renaming a local never
  changes a hash, and `view` can still print the author's names (stored as metadata).
-/

/-- Canonical Core and the binder names in pre-order; every binder contributes exactly one name. -/
def strip (form : Sexp) : (Sexp, List Text) :=
  match stripAcc form [] with
  | (core, names) => (core, List.reverse names)

def nameOf (x : Sexp) : Text :=
  match x with
  | Sexp.str t => t
  | _ => ""

def stripList (items : List Sexp) (acc : List Text) : (List Sexp, List Text) :=
  let rec go rest out a :=
    match rest with
    | [] => (List.reverse out, a)
    | x :: more =>
      match stripAcc x a with
      | (y, a2) => go more (y :: out) a2
  go items [] acc

def stripAcc (form : Sexp) (acc : List Text) : (Sexp, List Text) :=
  let rebuild := fun (head : Text) (prefix : List Sexp) (children : List Sexp) (names : List Text) =>
    match stripList children (List.reverse names ++ acc) with
    | (ys, a2) => (Sexp.list (Sexp.sym head :: prefix ++ ys), a2)
  match form with
  | Sexp.list [Sexp.sym "lam", Sexp.str x, body] => rebuild "lam" [] [body] [x]
  | Sexp.list [Sexp.sym "lam", body] => rebuild "lam" [] [body] [""]
  | Sexp.list [Sexp.sym "let", Sexp.str x, v, body] => rebuild "let" [] [v, body] [x]
  | Sexp.list [Sexp.sym "let", v, body] => rebuild "let" [] [v, body] [""]
  | Sexp.list [Sexp.sym "letrec", Sexp.list (Sexp.sym "names" :: xs), vs, body] =>
    match stripAcc vs (List.reverse (List.map nameOf xs) ++ acc) with
    | (vs2, a1) =>
      match stripAcc body a1 with
      | (body2, a2) => (Sexp.list [Sexp.sym "letrec", vs2, body2], a2)
  | Sexp.list [Sexp.sym "letrec", vs, body] =>
    match stripAcc vs (List.replicate (List.length (Sexp.asList vs)) "" ++ acc) with
    | (vs2, a1) =>
      match stripAcc body a1 with
      | (body2, a2) => (Sexp.list [Sexp.sym "letrec", vs2, body2], a2)
  | Sexp.list [Sexp.sym "pvar", Sexp.str x] => (Sexp.list [Sexp.sym "pvar"], x :: acc)
  | Sexp.list [Sexp.sym "pvar"] => (form, "" :: acc)
  | Sexp.list [Sexp.sym "pas", Sexp.str x, p] => rebuild "pas" [] [p] [x]
  | Sexp.list [Sexp.sym "pas", p] => rebuild "pas" [] [p] [""]
  | Sexp.list [Sexp.sym "ret", Sexp.str x, body] => rebuild "ret" [] [body] [x]
  | Sexp.list [Sexp.sym "ret", body] => rebuild "ret" [] [body] [""]
  | Sexp.list [Sexp.sym "on", a, i, k, Sexp.list xs, body] => rebuild "on" [a, i, k] [body] (List.map nameOf xs)
  | Sexp.list [Sexp.sym "on", a, i, Sexp.int k, body] => rebuild "on" [a, i, Sexp.int k] [body] (List.replicate (k + 1) "")
  | Sexp.list items =>
    match stripList items acc with
    | (ys, a2) => (Sexp.list ys, a2)
  | _ => (form, acc)

end Resolve
