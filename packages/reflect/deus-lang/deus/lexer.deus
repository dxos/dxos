/-
  Lexer: source text to tokens. Each token records its column and whether it starts a line,
  which is all the parser's offside rule needs.
-/

inductive Kind where
  | ident
  | dot
  | proj
  | int
  | text
  | sym
  | kw
  | doc
  | eof
  -- An ordinary comment, `-- …` or `/- … -/`; the parser keeps it beside the tokens (D66).
  | comment

structure Token where
  kind : Kind
  value : Text
  line : Int
  col : Int
  bol : Bool
  -- How the source wrote a number whose decimal `value` reads differently (`'a'`, `0xFF`, `1_000`); `""` otherwise.
  spelling : Text

namespace Lexer

def keywords : Dict Text Unit := dict ["def", "theorem", "test", "inductive", "structure", "ability", "namespace", "end", "open", "match", "with", "fun", "let", "rec", "if", "then", "else", "handle", "return", "by", "sorry", "where", "do", "prim", "true", "false", "notation"]

def twoCharSymbols : Dict Text Unit :=
  Set.dict [":=", "=>", "->", "<-", "::", "++", "==", "!=", "<=", ">=", "&&", "||", "|>", "<|", "@["]

-- `.` alone (no name after it) is a symbol, so prose a notation reads can end a sentence (Syntax.Spec R-11).
def oneCharSymbols : Dict Text Unit := dict ["(", ")", "[", "]", "{", "}", ",", ":", "|", "@", "+", "-", "*", "/", "%", "<", ">", "=", "!", "_", ";", "?", "."]

/-- Unicode spellings of ASCII symbols. -/
def unicode (c : Int) : Text :=
  if c == 8594 then "->"
  else if c == 8658 then "=>"
  else if c == 8800 then "!="
  else if c == 8804 then "<="
  else if c == 8805 then ">="
  else if c == 215 then "*"
  else if c == 8592 then "<-"
  else ""

def isIdentStart (c : Int) : Bool := Text.isAlpha c || c == '_' || (c >= 880 && c <= 1023)

def isIdentPart (c : Int) : Bool := isIdentStart c || Text.isDigit c || c == '\'' || c == '?' || c == '!'

def isHex (c : Int) : Bool := Text.isDigit c || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')

def hexValue (c : Int) : Int :=
  if Text.isDigit c then c - '0' else if c >= 'a' && c <= 'f' then c - 'a' + 10 else c - 'A' + 10

def escape (e : Int) : Int :=
  if e == 'n' then 10 else if e == 't' then 9 else if e == 'r' then 13 else if e == '0' then 0 else e

/-- Lexer failures are checked errors: callers handle `Throw Text`. -/
def fail (line : Int) (col : Int) (message : Text) : {Throw Text} a :=
  throw (Int.toText line ++ ":" ++ Int.toText col ++ ": " ++ message)

def lex (source : Text) : {Throw Text} List Token :=
  let n := Text.length source
  let at := fun i => code source i
  -- End of an identifier: letters, digits and dots that are followed by a letter.
  let rec identEnd i :=
    let c := at i
    if isIdentPart c then identEnd (i + 1) else if c == '.' && isIdentStart (at (i + 1)) then identEnd (i + 1) else i
  let rec digitsEnd i := if isDigit (at i) || at i == '_' then digitsEnd (i + 1) else i
  let rec hexEnd i := if Lexer.isHex (at i) || at i == '_' then hexEnd (i + 1) else i
  let rec lineEnd i := if i >= n || at i == '\n' then i else lineEnd (i + 1)
  -- Block comment `/- … -/`, nested; returns (end index, line, lineStart).
  let rec commentEnd i depth line lineStart := if i >= n then (i, line, lineStart) else if at i == '/' && at (i + 1) == '-' then commentEnd (i + 2) (depth + 1) line lineStart else if at i == '-' && at (i + 1) == '/' then if depth == 1 then (i + 2, line, lineStart) else commentEnd (i + 2) (depth - 1) line lineStart else if at i == '\n' then commentEnd (i + 1) depth (line + 1) (i + 1) else commentEnd (i + 1) depth line lineStart
  -- String body after the opening quote; returns (value, end index, line, lineStart).
  let rec stringEnd i acc line lineStart :=
    let c := at i
    if i >= n then ("", -1, line, lineStart) else if c == '"' then (fromCodes (reverse acc), i + 1, line, lineStart) else if c == '\\' then
      let e := at (i + 1)
      if e == 'u' && at (i + 2) == '{' then
        let rec digitsEnd1 j := if Lexer.isHex (at j) then digitsEnd1 (j + 1) else j
        let close := digitsEnd1 (i + 3)
        if close == i + 3 || at close != '}' then Lexer.fail line (i - lineStart) "malformed \\u{} escape" else
          let code := foldl (fun v d => v * 16 + Lexer.hexValue d) 0 (List.map at (range (i + 3) close))
          stringEnd (close + 1) (code :: acc) line lineStart
      else stringEnd (i + 2) (Lexer.escape e :: acc) line lineStart
    else if c == '\n' then stringEnd (i + 1) (c :: acc) (line + 1) (i + 1) else stringEnd (i + 1) (c :: acc) line lineStart
  let rec go i line lineStart bol acc :=
    let spelled := fun kind value spelling start => Token.mk kind value line (start - lineStart) bol spelling :: acc
    let tok := fun kind value start => spelled kind value "" start
    if i >= n then reverse (Token.mk Kind.eof "" line 0 true "" :: acc) else
      let c := at i
      let col := i - lineStart
      if c == '\n' then go (i + 1) (line + 1) (i + 1) true acc else if c == ' ' || c == '\t' || c == '\r' then go (i + 1) line lineStart bol acc else if c == '-' && at (i + 1) == '-' then
        let j := lineEnd i
        go
          j
          line
          lineStart
          bol
          (Token.mk Kind.comment (Text.slice source i j) line col bol "" :: acc)
      else if c == '/' && at (i + 1) == '-' then
        let isDoc := at (i + 2) == '-' && at (i + 3) != '/'
        let (j, line2, lineStart2) := commentEnd i 0 line lineStart
        if isDoc then
          let body := trim (Text.slice source (i + 3) (j - 2))
          go j line2 lineStart2 bol (Token.mk Kind.doc body line col bol "" :: acc)
        else go
          j
          line2
          lineStart2
          bol
          (Token.mk Kind.comment (Text.slice source i j) line col bol "" :: acc)
      else if c == '"' then
        match stringEnd (i + 1) [] line lineStart with
        | (_, -1, _, _) =>
            -- A string that never closes is reported where it opens, not where the file ends (R-6).
            Lexer.fail line col "unterminated string"
        | (value, j, line2, lineStart2) => go j line2 lineStart2 false (tok Kind.text value i)
      else if c == '\'' then
        let isEscape := at (i + 1) == '\\'
        let code := if isEscape then Lexer.escape (at (i + 2)) else at (i + 1)
        let close := if isEscape then i + 3 else i + 2
        if at close != '\'' then Lexer.fail line col "bad character literal" else go
          (close + 1)
          line
          lineStart
          false
          (spelled Kind.int (Int.toText code) (Text.slice source i (close + 1)) i)
      else if isDigit c then if c == '0' && at (i + 1) == 'x' then
        let j := hexEnd (i + 2)
        let digits := List.filter (fun d => d != '_') (List.map at (range (i + 2) j))
        let value := foldl (fun v d => v * 16 + Lexer.hexValue d) 0 digits
        go j line lineStart false (spelled Kind.int (Int.toText value) (Text.slice source i j) i)
      else
        let j := digitsEnd i
        let written := Text.slice source i j
        let value := replace "_" "" written
        go
          j
          line
          lineStart
          false
          (spelled Kind.int value (if value == written then "" else written) i) else if c == '.' && isIdentStart (at (i + 1)) then
        let j := identEnd (i + 1)
        -- `(e).field` and `xs[i].field`: a dot right after a closing bracket projects.
        let kind := if at (i - 1) == ')' || at (i - 1) == ']' then Kind.proj else Kind.dot
        go j line lineStart false (tok kind (Text.slice source (i + 1) j) i)
      else if isIdentStart c && not (c == '_' && not (isIdentPart (at (i + 1)))) then
        let j := identEnd i
        let word := Text.slice source i j
        if word == "λ" then go j line lineStart false (tok Kind.kw "fun" i) else if Dict.contains word Lexer.keywords then go j line lineStart false (tok Kind.kw word i) else go j line lineStart false (tok Kind.ident word i)
      else
        let mapped := unicode c
        if mapped != "" then go (i + 1) line lineStart false (tok Kind.sym mapped i) else
          let two := Text.slice source i (i + 2)
          if Dict.contains two twoCharSymbols then go (i + 2) line lineStart false (tok Kind.sym two i) else
            let one := Text.slice source i (i + 1)
            if one == "." && Text.isDigit (at (i + 1)) then Lexer.fail line col "a number has no fraction: Int is a whole number" else if Dict.contains one oneCharSymbols then go (i + 1) line lineStart false (tok Kind.sym one i) else Lexer.fail line col ("unexpected character " ++ one)
  go 0 1 0 true []

end Lexer
