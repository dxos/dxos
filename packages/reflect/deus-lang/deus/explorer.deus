/-
  The codebase explorer (D58): a single-page app over JSON written from a codebase, in the spirit
  of Unison Share. Definitions and tasks open as cards in one workspace, so several can be read
  at once, and a task board shows every task by state. The app is static files, so the same
  output is served locally (`deus explore`, by the native web runtime and `platform/site.deus`)
  and hosted from the bucket that holds the codebase's bundles (`deus explore --publish <remote>`).

    index.html, app.js, app.css   the app (`platform/explorer/`), copied as they are
    meta.json                     the project, branches, counts and recent history
    names.json                    every visible name: name, kind, hash
    def/<hash>.json               a definition: names, signature, highlighted source with its
                                  references linked, dependencies, dependents, verdict, tasks
    tasks.json                    every task, with its links resolved and its history
-/

namespace Explorer

def signature (dir : Text) (h : Text) : {IO} Text :=
  Option.getOr (Option.map (fun s => Types.displayScheme s) (Codebase.metaField (Codebase.readMeta dir h) "scheme")) ""

def docOf (dir : Text) (h : Text) : {IO} Option Text := Option.map Sexp.asText (Codebase.metaField (Codebase.readMeta dir h) "doc")

/-- Names that are not hidden: not constructors' and operations' own pages. -/
def visible (pair : (Text, Entry)) : Bool :=
  match snd pair with
  | Entry.ctor _ _ _ => false
  | Entry.op _ _ _ => false
  | _ => true

def lastOf (name : Text) : Text := Option.getOr (List.last? (Text.split name ".")) name

def verdictOf (dir : Text) (h : Text) : {IO} Text := Text.trim (Option.getOr (IO.readFile (dir ++ "/results/" ++ h)) "")

def changeJson (dir : Text) (pair : (Text, Causal)) : {IO} Json :=
  Json.obj ([("causal", Json.str (fst pair)), ("message", Json.str (snd pair).message)] ++
    Option.getOr (Option.map (fun agent => [("by", Json.str agent)]) (Cli.producedBy dir (fst pair))) [])

def refJson (name : Text) (h : Text) : Json := Json.obj [("name", Json.str name), ("hash", Json.str h)]

def taskJson (dir : Text) (ns : Map Text Entry) (t : Task) : {IO, Throw Text} Json :=
  let link := fun (a : Attachment) =>
    match a with
    | Attachment.definition name linked =>
      Json.obj [("definition", Json.str name), ("hash", Json.str linked), ("current", Option.getOr (Option.map (fun e => Json.str (Entry.hash e)) (Map.lookup name ns)) Json.null)]
    | Attachment.change h =>
      let message := match Codebase.readObject dir h with
        | some form => (Codebase.causalFromSexp form).message
        | none => ""
      Json.obj [("change", Json.str h), ("message", Json.str message)]
  Json.obj [("id", Json.str t.id), ("title", Json.str t.title), ("state", Json.str (Tasks.stateText t.state)), ("priority", Json.num t.priority),
    ("assignee", Json.str t.assignee), ("labels", Json.arr (List.map Json.str t.labels)), ("parent", Json.str t.parent), ("details", Json.str t.details),
    ("links", Json.arr (List.map link t.links)), ("comments", Json.arr (List.map (fun c => Json.obj [("author", Json.str c.author), ("note", Json.str c.note)]) t.comments)),
    ("history", Json.arr (List.map (changeJson dir) (Tasks.historyOf dir t.id 200)))]

/-- The app's files, from the toolchain's sources. -/
def appFiles : List Text := ["index.html", "app.js", "app.css"]

/-- Writes the explorer for the current branch to `out`; returns the number of definitions. -/
def generate (dir : Text) (out : Text) : {IO, Throw Text} Int :=
  let home := match IO.getEnv "DEUS_HOME" with
    | some h => h
    | none => throw "$DEUS_HOME is not set; run deus through bin/deus.mjs"
  let ns := Codebase.current dir
  let entries := List.filter visible (Map.toList ns)
  let index := Codebase.nameIndex ns
  let printer := Print.printer ns []
  let project := match Project.read dir with
    | some p => p.projectIri
    | none => "codebase"
  -- Dependents, inverted once from every definition's dependencies.
  let dependents := List.foldl (fun m pair =>
    let h := Entry.hash (snd pair)
    match Codebase.readObject dir h with
    | some obj => List.foldl (fun m2 d => Map.insert d (h :: Option.getOr (Map.lookup d m2) []) m2) m (Codebase.dependencies obj)
    | none => m) Map.empty entries
  let tasks := List.sortBy Tasks.order (Map.values (Tasks.current dir))
  let taskMap := Map.fromList (List.map (fun t => (t.id, t)) tasks)
  IO.mkdirp (out ++ "/def")
  List.forEach appFiles (fun f =>
    match IO.readFile (home ++ "/platform/explorer/" ++ f) with
    | some text => IO.writeFile (out ++ "/" ++ f) text
    | none => throw ("missing " ++ home ++ "/platform/explorer/" ++ f))
  let branch := Codebase.currentBranch dir
  IO.writeFile (out ++ "/meta.json") (Json.render (Json.obj [("project", Json.str project), ("branch", Json.str branch),
    ("branches", Json.arr (List.map Json.str (Codebase.branches dir))), ("definitions", Json.num (List.length entries)),
    ("tasks", Json.num (List.length tasks)), ("open", Json.num (List.length (List.filter Tasks.isOpen tasks))),
    ("history", Json.arr (List.map (changeJson dir) (Codebase.history dir branch 30)))]))
  IO.writeFile (out ++ "/names.json") (Json.render (Json.arr (List.map (fun pair =>
    Json.obj [("name", Json.str (fst pair)), ("kind", Json.str (Entry.kind (snd pair))), ("hash", Json.str (Entry.hash (snd pair)))]) entries)))
  IO.writeFile (out ++ "/tasks.json") (Json.render (Json.arr (List.map (taskJson dir ns) tasks)))
  List.forEach entries (fun pair =>
    match pair with
    | (name, e) =>
      let h := Entry.hash e
      let source := match try (fun _ => Cli.viewEntryWith printer dir ns name e false) with
        | Result.ok text => Text.join "\n" (List.filter (fun l => not (Text.startsWith "-- " l)) (Text.lines text))
        | Result.err message => "-- " ++ message
      let deps := match Codebase.readObject dir h with
        | some obj => List.filter (fun d => Map.contains d index && d != h) (Codebase.dependencies obj)
        | none => []
      -- References in the source print under their display names; those names link to the definitions.
      let links := Map.fromList (List.map (fun d => (Print.nameFor printer d, d)) deps)
      let users := List.dedup (List.sort (Option.getOr (Map.lookup h dependents) []))
      let named := fun (hs : List Text) => Json.arr (List.map (fun x => refJson (Option.getOr (Map.lookup x index) (Cli.short x)) x) hs)
      let sig := signature dir h
      IO.writeFile (out ++ "/def/" ++ h ++ ".json") (Json.render (Json.obj [("name", Json.str name), ("kind", Json.str (Entry.kind e)), ("hash", Json.str h),
        ("aliases", Json.arr (List.map Json.str (List.filter (fun other => other != name) (Codebase.namesOf ns h)))),
        ("signature", Json.str (if Text.isEmpty sig then "" else lastOf name ++ " : " ++ sig)),
        ("doc", Option.getOr (Option.map Json.str (docOf dir h)) Json.null),
        ("html", Json.str (Highlight.htmlLinked links source)), ("deps", named deps), ("users", named users),
        ("verdict", Json.str (verdictOf dir h)),
        ("tasks", Json.arr (List.map (fun t => Json.obj [("id", Json.str t.id), ("title", Json.str t.title), ("state", Json.str (Tasks.stateText t.state))]) (Tasks.about taskMap name h)))])))
  List.length entries

end Explorer
