/-
  The codebase explorer (D58): a single-page app over JSON written from a codebase, in the spirit
  of Unison Share. Definitions and tasks open as cards in one workspace, so several can be read
  at once, and a task board shows every task by state. The app is static files, so the same
  output is served locally (`deus explore`, by the native web runtime and `platform/site.deus`)
  and hosted from the bucket that holds the codebase's bundles (`deus explore --publish <remote>`).

    index.html, app.js, app.css   the app (`platform/explorer/`), copied as they are
    meta.json                     the project, branches, counts and recent history
    names.json                    every visible name: name, kind, hash
    def/<hash>.json               a definition: names, signature, highlighted source with its
                                  references linked, dependencies, dependents, verdict, tasks
    tasks.json                    every task, with its links resolved and its history
    comments.json                 comments on definitions and changes, by subject (D82)
    assets/<sha256>               the files comments and tasks attach
    console/                      with `--console` (D84): the wasm kernel (as base64), its
                                  drivers, the toolchain image and `codebase.json`, so the page
                                  runs `deus` against this codebase with no server
-/

namespace Explorer

def signature (meta : Option Sexp) : Text := Option.getOr (Option.map (fun s => Types.displayScheme s) (Codebase.metaField meta "scheme")) ""

def docOf (meta : Option Sexp) : Option Text := Option.map Sexp.asText (Codebase.metaField meta "doc")

/-- Names that are not hidden: not constructors' and operations' own pages. -/
def visible (pair : (Text, Entry)) : Bool :=
  match snd pair with
  | Entry.ctor _ _ _ => false
  | Entry.op _ _ _ => false
  | _ => true

/-- Heads of the forms that name another definition: terms, constructors, operations and types. -/
def refHeads : Map Text Unit := Set.fromList ["ref", "tref", "con", "pcon", "op", "on"]

/--
  Every hash a form names, builtins included. Unlike `Codebase.dependencies`, which lists what an
  update must propagate to, this also counts types named only in a signature, so `Bool` has users.
-/
def namedHashes (form : Sexp) : List Text :=
  let rec go x acc :=
    match x with
    | Sexp.list (Sexp.sym head :: Sexp.str h :: rest) =>
      List.foldl (fun a y => go y a) (if Map.contains head refHeads then h :: acc else acc) rest
    | Sexp.list items => List.foldl (fun a y => go y a) acc items
    | _ => acc
  go form []

/-- A definition's page file: builtin hashes are IRIs such as `#Bool`, and `#` cannot appear in a URL path. -/
def pageOf (h : Text) : Text := if Text.startsWith "#" h then "_" ++ Text.drop 1 h else h

/-- The first line of a doc comment, for listings. -/
def summaryOf (doc : Option Text) : Text := Text.trim (Option.getOr (Option.bind doc (fun d => List.head? (Text.lines (Text.trim d)))) "")

/-- Whether a definition has a verdict: tests and theorems are checked, other kinds never are. -/
def checked (e : Entry) : Bool := Entry.kind e == "test" || Entry.kind e == "theorem"

/-- `pass` or `fail` from a cached verdict, or `""` when there is none. -/
def statusOf (verdict : Text) : Text :=
  if Text.startsWith "(pass" verdict then "pass" else if Text.startsWith "(fail" verdict then "fail" else ""

def lastOf (name : Text) : Text := Option.getOr (List.last? (Text.split name ".")) name

def verdictOf (dir : Text) (h : Text) : {IO} Text := Text.trim (Option.getOr (IO.readFile (dir ++ "/results/" ++ h)) "")

def changeJson (dir : Text) (pair : (Text, Causal)) : {IO} Json :=
  Json.obj ([("causal", Json.str (fst pair)), ("message", Json.str (snd pair).message)] ++
    Option.getOr (Option.map (fun agent => [("by", Json.str agent)]) (Cli.producedBy dir (fst pair))) [])

/-- How many changes the History view lists, imported ones (D67) included. -/
def historyLimit : Int := 1000

/--
  A row of the full log. A change imported from an export has no causal node in this store, so it
  is marked `imported` and gets no page.
-/
def logJson (dir : Text) (entry : (Text, Text, Text)) : {IO} Json :=
  match entry with
  | (h, message, agent) =>
    Json.obj ([("causal", Json.str h), ("message", Json.str message)] ++
      (if Text.isEmpty agent then [] else [("by", Json.str agent)]) ++
      (if Option.isSome (Codebase.readObject dir h) then [] else [("imported", Json.bool true)]))

def refJson (name : Text) (h : Text) : Json := Json.obj [("name", Json.str name), ("hash", Json.str h)]

def taskJson (dir : Text) (ns : Map Text Entry) (history : List (Text, Causal)) (t : Task) : {IO, Throw Text} Json :=
  let link := fun (a : Attachment) =>
    match a with
    | Attachment.definition name linked =>
      Json.obj [("definition", Json.str name), ("hash", Json.str linked), ("current", Option.getOr (Option.map (fun e => Json.str (Entry.hash e)) (Map.lookup name ns)) Json.null)]
    | Attachment.change h =>
      let message := match Codebase.readObject dir h with
        | some form => (Codebase.causalFromSexp form).message
        | none => ""
      Json.obj [("change", Json.str h), ("message", Json.str message)]
  Json.obj [("id", Json.str t.id), ("title", Json.str t.title), ("state", Json.str (Tasks.stateText t.state)), ("priority", Json.num t.priority),
    ("assignee", Json.str t.assignee), ("labels", Json.arr (List.map Json.str t.labels)), ("parent", Json.str t.parent), ("details", Json.str t.details),
    ("links", Json.arr (List.map link t.links)), ("comments", Json.arr (List.map Cli.commentJson t.comments)),
    ("history", Json.arr (List.map (changeJson dir) history))]

/-- A definition's source as `deus view` prints it, without its `-- ` header lines. -/
def sourceOf (printer : Printer) (dir : Text) (ns : Map Text Entry) (name : Text) (e : Entry) : {IO} Text :=
  match try (fun _ => Cli.viewEntryWith printer dir ns name e false) with
  | Result.ok text => Text.join "\n" (List.filter (fun l => not (Text.startsWith "-- " l)) (Text.lines text))
  | Result.err message => "-- " ++ message

/--
  What a change did, against its first parent: names added, rebound or removed, and tasks it
  touched. A root change compares with an empty namespace.
-/
def changePage (dir : Text) (causal : Text) : {IO, Throw Text} Json :=
  let node := Codebase.readCausal dir causal
  let before := match Codebase.parentsOf dir causal with
    | p :: _ => Codebase.readCausal dir p
    | [] => Causal.mk "" [] "" "" "" ""
  let diff := Codebase.diffNamespaces dir before.snapshot node.snapshot
  let added := List.filterMap (fun change =>
    match change with
    | (name, none, some e) => if visible (name, e) then some (name, e) else none
    | _ => none) diff
  let changed := List.filterMap (fun change =>
    match change with
    | (name, some old, some new) => if Entry.hash old == Entry.hash new || not (visible (name, new)) then none else some (name, old, new)
    | _ => none) diff
  let removed := List.filterMap (fun change =>
    match change with
    | (name, some e, none) => if visible (name, e) then some (name, e) else none
    | _ => none) diff
  -- A rebound name carries both sources, so the app can show the change as a diff; a printer
  -- indexes a whole namespace, so both are read only for changes that rebind something.
  let nsBefore := if List.isEmpty changed || Text.isEmpty before.snapshot then Map.empty else Codebase.readNamespace dir before.snapshot
  let nsAfter := if List.isEmpty changed then Map.empty else Codebase.readNamespace dir node.snapshot
  let printers := if List.isEmpty changed then none else some (Print.printer nsBefore [], Print.printer nsAfter [])
  let tasksAfter := Tasks.snapshotOf dir node
  let tasksBefore := Tasks.snapshotOf dir before
  let touched := List.filter (fun id => Map.lookup id tasksAfter != Map.lookup id tasksBefore) (Set.toList (Set.fromList (Map.keys tasksAfter ++ Map.keys tasksBefore)))
  Json.obj ([("causal", Json.str causal), ("message", Json.str node.message), ("parents", Json.arr (List.map Json.str node.parents)),
    ("added", Json.arr (List.map (fun pair => refJson (fst pair) (Entry.hash (snd pair))) added)),
    ("changed", Json.arr (List.map (fun c =>
      match (c, printers) with
      | ((name, old, new), some (pBefore, pAfter)) =>
        Json.obj [("name", Json.str name), ("from", Json.str (Entry.hash old)), ("hash", Json.str (Entry.hash new)),
          ("before", Json.str (sourceOf pBefore dir nsBefore name old)), ("after", Json.str (sourceOf pAfter dir nsAfter name new))]
      | _ => Json.null) changed)),
    ("removed", Json.arr (List.map (fun pair => Json.str (fst pair)) removed)),
    ("tasks", Json.arr (List.map Json.str touched))] ++
    Option.getOr (Option.map (fun agent => [("by", Json.str agent)]) (Cli.producedBy dir causal)) [])

/-- The app's files, from the toolchain's sources. -/
def appFiles : List Text := ["index.html", "app.js", "app.css"]

/-- Writes the explorer for the current branch to `out`; returns the number of definitions. -/
def generate (dir : Text) (out : Text) : {IO, Throw Text} Int :=
  let home := match IO.getEnv "DEUS_HOME" with
    | some h => h
    | none => throw "$DEUS_HOME is not set; run deus through bin/deus.mjs"
  let ns := Codebase.current dir
  let entries := List.filter visible (Map.toList ns)
  let index := Codebase.nameIndex ns
  let namesByHash := Codebase.namesByHash ns
  let printer := Print.printer ns []
  let project := match Project.read dir with
    | some p => p.projectIri
    | none => "codebase"
  -- Each definition's object and metadata are read once: its dependencies, and dependents inverted from them.
  let metaOf := Map.fromList (List.map (fun pair => (Entry.hash (snd pair), Codebase.readMeta dir (Entry.hash (snd pair)))) entries)
  let metaFor := fun (h : Text) => Option.getOr (Map.lookup h metaOf) none
  let depsOf := Map.fromList (List.map (fun pair =>
    let h := Entry.hash (snd pair)
    let fromObject := Option.getOr (Option.map namedHashes (Codebase.readObject dir h)) []
    let fromScheme := Option.getOr (Option.map namedHashes (Codebase.metaField (metaFor h) "scheme")) []
    (h, List.dedup (List.sort (fromObject ++ fromScheme)))) entries)
  let dependents := Map.foldr (fun h ds m => List.foldl (fun m2 d => Map.insert d (h :: Option.getOr (Map.lookup d m2) []) m2) m ds) Map.empty depsOf
  let tasks := List.sortBy Tasks.order (Map.values (Tasks.current dir))
  let taskMap := Map.fromList (List.map (fun t => (t.id, t)) tasks)
  let histories := Tasks.histories dir 200
  let historyOf := fun (t : Task) => Option.getOr (Map.lookup t.id histories) []
  IO.mkdirp (out ++ "/def")
  List.forEach appFiles (fun f =>
    match IO.readFile (home ++ "/platform/explorer/" ++ f) with
    | some text => IO.writeFile (out ++ "/" ++ f) text
    | none => throw ("missing " ++ home ++ "/platform/explorer/" ++ f))
  let branch := Codebase.currentBranch dir
  -- Events about the codebase (D104), for the Events card and per-definition counts; a codebase
  -- whose event types cannot be read still gets a site, with no events.
  let events := match try (fun _ =>
      let ts := Analytics.types dir ns
      (Analytics.siteJson dir project ns 20, List.sum (List.map (fun c => match c with | (_, pending, pushed) => pending + pushed) (Analytics.counts dir ts)))) with
    | Result.ok pair => pair
    | Result.err _ => (Json.obj [("project", Json.str project), ("types", Json.arr []), ("byDefinition", Json.obj [])], 0)
  IO.writeFile (out ++ "/events.json") (Json.render (fst events))
  IO.writeFile (out ++ "/meta.json") (Json.render (Json.obj [("project", Json.str project), ("branch", Json.str branch),
    ("branches", Json.arr (List.map Json.str (Codebase.branches dir))), ("definitions", Json.num (List.length entries)),
    ("tasks", Json.num (List.length tasks)), ("open", Json.num (List.length (List.filter Tasks.isOpen tasks))),
    ("console", Json.bool (IO.exists (out ++ "/console/info.json"))), ("events", Json.num (snd events)),
    ("history", Json.arr (List.map (logJson dir) (Cli.fullLog dir historyLimit)))]))
  -- The signature and doc summary let the app list, search and preview names without opening their pages.
  IO.writeFile (out ++ "/names.json") (Json.render (Json.arr (List.map (fun pair =>
    let h := Entry.hash (snd pair)
    Json.obj [("name", Json.str (fst pair)), ("kind", Json.str (Entry.kind (snd pair))), ("hash", Json.str h),
      ("sig", Json.str (signature (metaFor h))), ("summary", Json.str (summaryOf (docOf (metaFor h)))),
      ("status", Json.str (if checked (snd pair) then statusOf (verdictOf dir h) else ""))]) entries)))
  IO.writeFile (out ++ "/tasks.json") (Json.render (Json.arr (List.map (fun t => taskJson dir ns (historyOf t) t) tasks)))
  -- Comments on definitions and changes (D82), by subject, and the assets they and tasks attach.
  IO.writeFile (out ++ "/comments.json") (Json.render (Json.obj (List.map (fun pair => (fst pair, Json.arr (List.map Cli.commentJson (snd pair)))) (Map.toList (Comments.current dir)))))
  IO.mkdirp (out ++ "/assets")
  List.forEach (Assets.named dir) (fun h =>
    if IO.exists (out ++ "/assets/" ++ h) || not (Assets.has dir h) then () else
      IO.exec "cp" [Assets.path dir h, out ++ "/assets/" ++ h]
      ())
  -- A page per change the app links to: recent history, and every change in a task's history.
  IO.mkdirp (out ++ "/change")
  let linked := List.concatMap (fun t => List.map fst (historyOf t)) tasks
  let shown := Set.toList (Set.fromList (List.map fst (Codebase.history dir branch 30) ++ linked))
  List.forEach shown (fun c =>
    let path := out ++ "/change/" ++ c ++ ".json"
    -- A change never changes, so a page written once stays right.
    if IO.exists path then () else IO.writeFile path (Json.render (changePage dir c)))
  List.forEach entries (fun pair =>
    match pair with
    | (name, e) =>
      let h := Entry.hash e
      let source := match try (fun _ => Cli.viewEntryWith printer dir ns name e false) with
        | Result.ok text => Text.join "\n" (List.filter (fun l => not (Text.startsWith "-- " l)) (Text.lines text))
        | Result.err message => "-- " ++ message
      -- The same definition in the TypeScript-like dialect (D70), shown when the viewer picks it.
      let tsSource := match try (fun _ => Cli.viewEntryIn printer dir ns name e "ts") with
        | Result.ok text => Text.join "\n" (List.filter (fun l => not (Text.startsWith "// " l)) (Text.lines text))
        | Result.err message => "// " ++ message
      let deps := List.filter (fun d => Map.contains d index && d != h) (Option.getOr (Map.lookup h depsOf) [])
      -- References in the source print under their display names; those names link to the definitions.
      let links := Map.fromList (List.map (fun d => (Print.nameFor printer d, d)) deps)
      -- A recursive definition depends on itself; listing it as its own user would make the graph view loop.
      let users := List.filter (fun u => u != h) (List.dedup (List.sort (Option.getOr (Map.lookup h dependents) [])))
      let named := fun (hs : List Text) => Json.arr (List.map (fun x => refJson (Option.getOr (Map.lookup x index) (Cli.short x)) x) hs)
      let meta := metaFor h
      let sig := signature meta
      IO.writeFile (out ++ "/def/" ++ pageOf h ++ ".json") (Json.render (Json.obj [("name", Json.str name), ("kind", Json.str (Entry.kind e)), ("hash", Json.str h),
        ("aliases", Json.arr (List.map Json.str (List.filter (fun other => other != name) (Option.getOr (Map.lookup h namesByHash) [])))),
        ("signature", Json.str (if Text.isEmpty sig then "" else lastOf name ++ " : " ++ sig)),
        ("doc", Option.getOr (Option.map Json.str (docOf meta)) Json.null),
        ("html", Json.str (Highlight.htmlLinked links source)), ("ts", Json.str (Highlight.htmlLinkedIn "ts" links tsSource)),
        ("deps", named deps), ("users", named users),
        ("verdict", Json.str (verdictOf dir h)),
        ("tasks", Json.arr (List.map (fun t => Json.obj [("id", Json.str t.id), ("title", Json.str t.title), ("state", Json.str (Tasks.stateText t.state))]) (Tasks.about taskMap name h)))])))
  List.length entries

/-- Directories a console snapshot leaves out: local state, binary files and remote bookkeeping. -/
def consoleSkips : List Text := ["cache", "artifacts", "assets", "remotes", "exports"]

/-- The codebase files a console snapshot holds: all of them but those under `consoleSkips`. -/
def snapshotFiles (dir : Text) : {IO} List Text :=
  List.filter (fun f => not (List.any (fun skip => Text.startsWith (skip ++ "/") f) consoleSkips)) (Cli.filesUnder dir "")

/--
  Writes `out/console/` (D84): the wasm kernel (base64) and its drivers, the toolchain image, and the
  codebase directory as `codebase.json` (path to text), so the explorer can run `deus` against
  the codebase it shows. The page loads it only when the console opens. Returns the files in the
  snapshot.
-/
def console (dir : Text) (out : Text) : {IO, Throw Text} Int :=
  let copied := try (fun _ =>
    let home := Build.require "DEUS_HOME"
    let crate := home ++ "/../deus-kernel"
    IO.mkdirp (out ++ "/console")
    -- The site is text end to end (the bundled server and `Remote.writeAll`), so the kernel ships as base64.
    IO.writeFile (out ++ "/console/deus_kernel.wasm.b64") (Build.tool "openssl" ["base64", "-in", Build.wasmKernel ()])
    let _ := Build.tool "cp" [crate ++ "/embed/kernel.mjs", crate ++ "/embed/host.mjs", out ++ "/console/"]
    Build.tool "cp" [home ++ "/seed/deus.image", out ++ "/console/deus.image"])
  match copied with
  | Result.err f => throw (Failure.render f)
  | Result.ok _ =>
    let files := snapshotFiles dir
    IO.writeFile (out ++ "/console/codebase.json") (Json.render (Json.obj (List.map (fun f => (f, Json.str (Option.getOr (IO.readFile (dir ++ "/" ++ f)) ""))) files)))
    -- The app offers the console when this small file is there, before loading anything large.
    IO.writeFile (out ++ "/console/info.json") (Json.render (Json.obj [("files", Json.num (List.length files)), ("branch", Json.str (Codebase.currentBranch dir))]))
    List.length files

end Explorer
