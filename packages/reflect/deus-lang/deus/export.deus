/-
  Exporting a codebase as text (D64), so a git repository can back it up and review its changes.
  The export holds the layers that cannot be recomputed, and leaves out the cache and artifacts:

    code/<Namespace>.deus   source of every definition, test, theorem, type and ability, one file
                            per top-level namespace (`_root.deus` for names without one). It is
                            what `deus view` prints, which compiles back to the same hashes.
    tasks.sexp              every task object, one per line, for `deus task import`
    TASKS.md                the tasks to read: open first, with their links and comments
    history.sexp            the branch's changes, newest first, for `deus history import`
    HISTORY.md              the same changes to read, with who made them
    README.md               what the export is and how to restore it

  `deus add <dir>/code`, `deus task import <dir>/tasks.sexp` and `deus history import
  <dir>/history.sexp` restore it in a fresh codebase. The history comes back as a record that
  `deus log` shows after the restore's own changes (D67); it is not replayed.
-/

namespace Export

/-- Kinds written as source; constructors, operations and accessors come with their declarations. -/
def exported (e : Entry) : Bool :=
  match e with
  | Entry.term _ => true
  | Entry.test _ => true
  | Entry.theorem _ => true
  | Entry.type _ _ _ => true
  | Entry.ability _ _ => true
  | _ => false

def topOf (name : Text) : Text :=
  match Text.split name "." with
  | [_] => "_root"
  | top :: _ => top
  | [] => "_root"

/-- The task as Markdown: a heading, its fields, links, comments. -/
def taskMarkdown (t : Task) : Text :=
  let field := fun (label : Text) (value : Text) => if Text.isEmpty value then "" else "- " ++ label ++ ": " ++ value ++ "\n"
  let link := fun (a : Attachment) =>
    match a with
    | Attachment.definition name h => "- links `" ++ name ++ "` (#" ++ Text.take 10 h ++ ")\n"
    | Attachment.change h => "- links change #" ++ Text.take 10 h ++ "\n"
  "## " ++ t.title ++ " (`" ++ t.id ++ "`)\n\n" ++
    field "state" (Tasks.stateText t.state) ++ field "priority" (Tasks.priorityText t.priority) ++ field "assignee" t.assignee ++
    field "labels" (Text.join ", " t.labels) ++ field "parent" t.parent ++ Text.concat (List.map link t.links) ++
    (if Text.isEmpty t.details then "" else "\n" ++ t.details ++ "\n") ++
    Text.concat (List.map (fun c => "\n> " ++ c.author ++ ": " ++ c.note ++ "\n") t.comments) ++ "\n"

/--
  The namespace plus a name `Unnamed.h<hash>` for each term a definition still calls but no name
  binds (D77), since the printer writes such a reference as `#<hash>`, which the parser rejects.
-/
def withUnnamed (dir : Text) (ns : Map Text Entry) : {IO} Map Text Entry :=
  let named := Set.fromList (List.map Entry.hash (Map.values ns))
  let dependenciesOf := fun (h : Text) => Option.getOr (Option.map Codebase.dependencies (Codebase.readObject dir h)) []
  let rec go pending seen acc :=
    match pending with
    | [] => acc
    | h :: rest =>
      if Set.contains h seen || Set.contains h named || Text.startsWith "#" h || Text.contains "." h then go rest seen acc
      else
        match Codebase.readObject dir h with
        | some (Sexp.list [Sexp.sym "term", _]) => go (dependenciesOf h ++ rest) (Set.insert h seen) (Map.insert ("Unnamed.h" ++ Text.take 10 h) (Entry.term h) acc)
        | _ => go rest (Set.insert h seen) acc
  go (List.concatMap (fun e => if exported e then dependenciesOf (Entry.hash e) else []) (Map.values ns)) Set.empty ns

/-- Writes the export of the current branch to `out`; returns (source files, definitions, tasks). -/
def write (dir : Text) (out : Text) : {IO, Throw Text} (Int, Int, Int) :=
  let _ := mergeExisting dir out
  let ns := withUnnamed dir (Codebase.current dir)
  let printer := Print.printer ns []
  let entries := List.filter (fun pair => exported (snd pair)) (Map.toList ns)
  let sources := List.filterMap (fun pair =>
    match pair with
    | (name, e) =>
      let body := snd (Cli.viewParts printer dir ns name e "deus")
      if Text.isEmpty (Text.trim body) then none else some (topOf name, body)) entries
  -- Spec blocks go back into `.mdl` documents, one per document name, so `deus add` restores them.
  let specs := List.filterMap (fun pair =>
    match pair with
    | (name, Entry.spec h) =>
      match Codebase.readObject dir h with
      | some obj =>
        match Mdl.fromSexp obj with
        | (uri, b) => some (Text.take (Text.length name - Text.length b.blockId - 1) name, (b.blockType, uri, Mdl.render b))
      | none => none
    | _ => none) (Map.toList ns)
  let documents := List.dedup (List.sort (List.map fst specs))
  if List.isEmpty documents then () else IO.mkdirp (out ++ "/specs")
  List.forEach documents (fun d =>
    let mine := List.filterMap (fun pair => if fst pair == d then some (snd pair) else none) specs
    let terms := List.dedup (List.sort (List.map (fun x =>
      match x with
      | (term, uri, _) => "| `" ++ term ++ "` | `" ++ uri ++ "` |") mine))
    IO.writeFile (out ++ "/specs/" ++ d ++ ".mdl") (Text.join "\n" (["---", "name: " ++ d, "---", "", "## Extensions", "", "| Term | URI |", "| --- | --- |"] ++ terms ++ ["", "## Blocks", ""] ++
      List.map (fun x =>
        match x with
        | (_, _, text) => text ++ "\n") mine)))
  let files := List.dedup (List.sort (List.map fst sources))
  IO.mkdirp (out ++ "/code")
  List.forEach files (fun f =>
    IO.writeFile (out ++ "/code/" ++ f ++ ".deus") (Text.join "\n\n" (List.filterMap (fun pair => if fst pair == f then some (snd pair) else none) sources) ++ "\n"))
  let tasks := List.sortBy Tasks.order (Map.values (Tasks.current dir))
  IO.writeFile (out ++ "/tasks.sexp") (Text.concat (List.map (fun t => Sexp.print (Tasks.toSexp t) ++ "\n") (List.sortBy (fun a b => compare a.id b.id) tasks)))
  IO.writeFile (out ++ "/TASKS.md") ("# Tasks\n\n" ++ Text.concat (List.map taskMarkdown tasks))
  -- Comments (D80) are written only when there are some, so an export without them is unchanged.
  let threads := Map.toList (Comments.current dir)
  if List.isEmpty threads then () else
    IO.writeFile (out ++ "/comments.sexp") (Text.concat (List.map (fun pair => Sexp.print (Sexp.node "subject" [Sexp.str (fst pair), Comments.threadToSexp (snd pair)]) ++ "\n") threads))
  let project := match Project.read dir with
    | some p => p.projectIri
    | none => "a DEUS codebase"
  let projectStep := match Project.read dir with
    | some p => ["deus project init " ++ p.projectIri]
    | none => []
  IO.writeFile (out ++ "/README.md") (Text.join "\n" (["# " ++ project, "",
    "A text export of a DEUS codebase (`deus export`, D64), kept in git as its backup. It is",
    "generated: change the codebase, then export again.", "",
    "- `code/` holds the source of every definition, one file per top-level namespace.",
    "- `tasks.sexp` holds the tasks, and `TASKS.md` lists them to read.",
    "- `history.sexp` holds the branch's changes, and `HISTORY.md` lists them to read.",
    "- `specs/` holds the `.mdl` spec blocks, one document per name."] ++
    (if List.isEmpty threads then [] else ["- `comments.sexp` holds comments on definitions and changes; the files they attach stay in the codebase's asset store."]) ++ ["",
    "To restore it into a fresh codebase:", "", "```bash", "deus init --empty"] ++ projectStep ++
    ["deus add code" ++ (if List.isEmpty documents then "" else " specs"), "deus task import tasks.sexp"] ++ (if List.isEmpty threads then [] else ["deus comments import comments.sexp"]) ++ ["deus history import history.sexp", "```", ""]))
  let history := Cli.fullLog dir 100000
  IO.writeFile (out ++ "/history.sexp") (Text.concat (List.map (fun entry =>
    match entry with
    | (h, message, agent) => Sexp.print (Sexp.node "entry" [Sexp.s h, Sexp.s message, Sexp.s agent]) ++ "\n") history))
  IO.writeFile (out ++ "/HISTORY.md") ("# History of " ++ Codebase.currentBranch dir ++ "\n\n" ++ Text.concat (List.map (fun entry =>
    match entry with
    | (h, message, agent) => "- `" ++ Text.take 10 h ++ "` " ++ message ++ (if Text.isEmpty agent then "" else " (by " ++ agent ++ ")") ++ "\n") history))
  recordBase dir out (Tasks.snapshotOf dir (Codebase.readCausal dir (Codebase.headOf dir (Codebase.currentBranch dir))))
  (List.length files, List.length sources, List.length tasks)

/-- Records an export's `history.sexp` on the current branch (D67); returns how many changes. -/
def importHistory (dir : Text) (path : Text) : {IO, Throw Text} Int :=
  match IO.readFile path with
  | none => throw ("cannot read " ++ path)
  | some text =>
    let entries := List.filter (fun form => Sexp.head form == "entry") (Sexp.readAll text)
    let _ := Codebase.commitPrior dir (Sexp.node "record" entries) ("history: import " ++ Int.toText (List.length entries) ++ " changes")
    List.length entries

--
-- Merging an export that other codebases also write (D79).
--

/-- `path` with `.` and `..` segments resolved. -/
def normalize (path : Text) : Text :=
  let segments := List.foldl (fun acc segment =>
    if segment == "" || segment == "." then acc
    else if segment == ".." then List.drop 1 acc
    else segment :: acc) [] (Text.split path "/")
  "/" ++ Text.join "/" (List.reverse segments)

/-- The directory part of a path: `.` for a bare file name. -/
def directoryOf (path : Text) : Text :=
  match List.reverse (Text.split path "/") with
  | _ :: [] => "."
  | _ :: rest => Text.join "/" (List.reverse rest)
  | [] => "."

/-- Where the codebase keeps the tasks it last exchanged with the export at `out`, keyed by its absolute path. -/
def basePath (dir : Text) (out : Text) : {IO} Text :=
  let absolute := if Text.startsWith "/" out then out else Option.getOr (IO.getEnv "PWD") "" ++ "/" ++ out
  dir ++ "/exports/" ++ Text.take 16 (Text.sha256 (normalize absolute))

/-- Remembers `snapshot` as what this codebase and the export at `out` last agreed on. -/
def recordBase (dir : Text) (out : Text) (snapshot : Map Text Text) : {IO} Unit :=
  IO.mkdirp (dir ++ "/exports")
  IO.writeFile (basePath dir out) (Tasks.putSnapshot dir snapshot ++ "\n")

def readBase (dir : Text) (out : Text) : {IO, Throw Text} Map Text Text :=
  match IO.readFile (basePath dir out) with
  | some h => Tasks.snapshotAt dir (Text.trim h)
  | none => Map.empty

/-- The tasks of a `tasks.sexp`, stored, as id -> task object hash. -/
def fileSnapshot (dir : Text) (text : Text) : {IO} Map Text Text :=
  Map.fromList (List.map (fun form =>
    let t := Tasks.fromSexp form
    (t.id, Codebase.put dir (Tasks.toSexp t))) (Sexp.readAll text))

/--
  Merges a `tasks.sexp` into the branch's tasks, three-way against what this codebase last
  exchanged with that export, so a task another codebase changed is not reverted. A task the file
  lacks, or holds at a version this branch has had, counts as unchanged there. A field both sides
  changed keeps this codebase's value and is returned as a conflict. Returns (tasks in the file,
  conflicts).
-/
def mergeTasksFile (dir : Text) (out : Text) (text : Text) (message : Text) : {IO, Throw Text} (Int, List Text) :=
  let file := fileSnapshot dir text
  let ours := Tasks.snapshotOf dir (Codebase.readCausal dir (Codebase.headOf dir (Codebase.currentBranch dir)))
  -- A writer that never saw a task, or saw an older version of it, wrote no change to it: tasks are never deleted.
  let past := Tasks.pastVersions dir
  let theirs := List.foldl (fun m pair =>
    match pair with
    | (id, h) =>
      match Map.lookup id file with
      | none => Map.insert id h m
      | some th => if th != h && Set.contains th past then Map.insert id h m else m) file (Map.toList ours)
  match Tasks.merge dir (readBase dir out) ours theirs with
  | (merged, conflicts) =>
    let _ := if Map.toList merged == Map.toList ours then "" else Codebase.commitTasks dir (Tasks.putSnapshot dir merged) message
    recordBase dir out file
    (Map.size file, conflicts)

/-- Before an export overwrites `out`, takes in the tasks and history another codebase wrote there. -/
def mergeExisting (dir : Text) (out : Text) : {IO, Throw Text} Unit :=
  let _ := match IO.readFile (out ++ "/tasks.sexp") with
    | some text =>
      match mergeTasksFile dir out text ("export: merge tasks from " ++ out) with
      | (_, conflicts) => List.forEach conflicts (fun c => IO.eprint ("conflict: " ++ c ++ " (this codebase's value kept)\n"))
    | none => ()
  match IO.readFile (out ++ "/history.sexp") with
  | some text =>
    let known := Set.fromList (List.map (fun entry =>
      match entry with
      | (h, _, _) => h) (Cli.fullLog dir 1000000))
    let fresh := List.filter (fun form =>
      match form with
      | Sexp.list [Sexp.sym "entry", Sexp.str h, _, _] => not (Set.contains h known)
      | _ => false) (Sexp.readAll text)
    if List.isEmpty fresh then ()
    else
      let _ := Codebase.commitPrior dir (Sexp.node "record" fresh) ("export: merge " ++ Int.toText (List.length fresh) ++ " changes from " ++ out)
      ()
  | none => ()

/-- Merges tasks from an export's `tasks.sexp` as one change (D79); returns how many the file has. -/
def importTasks (dir : Text) (path : Text) : {IO, Throw Text} Int :=
  match IO.readFile path with
  | none => throw ("cannot read " ++ path)
  | some text =>
    match mergeTasksFile dir (directoryOf path) text ("task: import from " ++ path) with
    | (n, conflicts) =>
      List.forEach conflicts (fun c => IO.eprint ("conflict: " ++ c ++ " (this codebase's value kept)\n"))
      n

/-- Restores comments from an export's `comments.sexp` as one change; returns how many. -/
def importComments (dir : Text) (path : Text) : {IO, Throw Text} Int :=
  match IO.readFile path with
  | none => throw ("cannot read " ++ path)
  | some text =>
    let added := List.concatMap (fun form =>
      match Sexp.args form with
      | [subject, thread] => List.map (fun c => (Sexp.asText subject, Tasks.commentFromSexp c)) (Sexp.args thread)
      | _ => defect ("bad comments entry " ++ Sexp.print form)) (Sexp.readAll text)
    let _ := Comments.add dir added ("comments: import " ++ Int.toText (List.length added) ++ " comments")
    List.length added

end Export
