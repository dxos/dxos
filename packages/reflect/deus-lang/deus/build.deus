/-
  `deus build`: a standalone executable for a term (D38), with `--native` a small one made from
  the Rust kernel (D42), or with `--worker` a Cloudflare Worker serving an actor (D45).

  The executable is a Node single-executable application: the kernel, bundled into one script,
  plus the term's image as an asset. The tools are pinned by version and run through `npx`, so
  a build needs only Node and the registry.
-/

namespace Build

def esbuild : Text := "esbuild@0.28.2"

def postject : Text := "postject@1.0.0-alpha.6"

/--
  The sentinel Node looks for to know it carries an application. Split, so an image of this code
  (the CLI building itself) does not contain the sentinel postject must find exactly once.
-/
def fuse : Text := "NODE_SEA_FUSE_" ++ "fce680ab2cc467b6e072b8b5df1996b2"

/-- Runs a tool and returns its stdout; a non-zero exit is a failure carrying its output. -/
def tool (program : Text) (arguments : List Text) : {IO, Throw Failure} Text :=
  match IO.exec program arguments with
  | (0, out, _) => out
  | (code, out, err) =>
    throw (Failure.of (program ++ " exited with " ++ Int.toText code) [("args", Text.join " " arguments), ("stderr", Text.trim err), ("stdout", Text.trim out)])

def require (name : Text) : {IO, Throw Failure} Text :=
  match IO.getEnv name with
  | some value => value
  | none => throw (Failure.of ("$" ++ name ++ " is not set; run deus through bin/deus.mjs") [])

/--
  What an executable's bytes depend on besides its image: the Node binary and the kernel sources
  bundled into it.
-/
def executableInputs (home : Text) (node : Text) : {IO, Throw Failure} Text :=
  let kernel := List.map (fun f => home ++ "/src/kernel/" ++ f) (List.filter (fun f => Text.endsWith ".ts" f && not (Text.endsWith ".test.ts" f)) (IO.listDir (home ++ "/src/kernel")))
  tool node ["--version"] ++ tool "sha256sum" ((home ++ "/src/bin/standalone.ts") :: kernel)

/--
  Writes `out`, an executable that runs the image's main with its command-line arguments. The
  result is kept in the artifacts layer under the hash of its inputs, so rebuilding unchanged code
  is a copy.
-/
def executable (image : Text) (out : Text) (artifacts : Text) : {IO, Throw Failure} Unit :=
  let home := require "DEUS_HOME"
  let node := require "DEUS_NODE"
  let key := Text.sha256 (image ++ "\n" ++ executableInputs home node)
  let cached := artifacts ++ "/" ++ key
  if IO.exists cached then
    let _ := tool "cp" [cached, out]
    ()
  else
    buildExecutable image out home node
    IO.mkdirp artifacts
    let _ := tool "cp" [out, cached]
    ()

def buildExecutable (image : Text) (out : Text) (home : Text) (node : Text) : {IO, Throw Failure} Unit :=
  let work := out ++ ".build"
  IO.mkdirp work
  IO.writeFile (work ++ "/deus.image") image
  let _ := Failure.context "bundling the kernel" [] (fun _ =>
    tool "npx" ["--yes", esbuild, home ++ "/src/bin/standalone.ts", "--bundle", "--platform=node", "--format=cjs", "--log-level=warning", "--outfile=" ++ work ++ "/main.cjs"])
  let config := Json.obj [("main", Json.str (work ++ "/main.cjs")), ("output", Json.str (work ++ "/sea.blob")), ("disableExperimentalSEAWarning", Json.bool true), ("assets", Json.obj [("image", Json.str (work ++ "/deus.image"))])]
  IO.writeFile (work ++ "/sea.json") (Json.render config)
  let _ := Failure.context "preparing the application blob" [] (fun _ => tool node ["--experimental-sea-config", work ++ "/sea.json"])
  let _ := tool "cp" [node, out]
  let mac := Text.trim (tool "uname" []) == "Darwin"
  let _ := if mac then tool "codesign" ["--remove-signature", out] else ""
  let macho := if mac then ["--macho-segment-name", "NODE_SEA"] else []
  let _ := Failure.context "injecting the application blob" [] (fun _ =>
    tool "npx" (["--yes", postject, out, "NODE_SEA_BLOB", work ++ "/sea.blob", "--sentinel-fuse", fuse] ++ macho))
  let _ := if mac then tool "codesign" ["--sign", "-", out] else ""
  IO.remove work

/--
  Writes `out`: a copy of the Rust kernel with the image appended (D42), about 1 MB plus the
  image. The kernel is built with cargo when it is missing; `$DEUS_KERNEL` names another one.
-/
def native (image : Text) (out : Text) : {IO, Throw Failure} Unit :=
  let crate := require "DEUS_HOME" ++ "/../deus-kernel"
  let kernel := Option.getOr (IO.getEnv "DEUS_KERNEL") (crate ++ "/target/release/deus-kernel")
  let _ := if IO.exists kernel then ""
    else Failure.context "building the Rust kernel" [] (fun _ => tool "cargo" ["build", "--release", "--quiet", "--manifest-path", crate ++ "/Cargo.toml"])
  let _ := tool "cp" [kernel, out]
  let digits := Int.toText (List.length (Text.utf8 image))
  IO.appendFile out (image ++ Text.repeat (20 - Text.length digits) "0" ++ digits ++ "DEUSIMG1")

/--
  Writes a Cloudflare Worker to the directory `out` (D45): the wasm kernel, the actor's image,
  the Durable Object that serves it (`deus-kernel/embed/worker.mjs`) and `wrangler.toml`.
  `wrangler dev` in `out` serves it locally on workerd; `wrangler deploy` publishes it.
-/
def worker (image : Text) (name : Text) (out : Text) : {IO, Throw Failure} Unit :=
  let crate := require "DEUS_HOME" ++ "/../deus-kernel"
  let wasm := crate ++ "/target/wasm32-unknown-unknown/release/deus_kernel.wasm"
  let _ := if IO.exists wasm then ""
    else Failure.context "building the wasm kernel" [] (fun _ =>
      tool "cargo" ["build", "--release", "--quiet", "--lib", "--target", "wasm32-unknown-unknown", "--manifest-path", crate ++ "/Cargo.toml"])
  IO.mkdirp out
  IO.writeFile (out ++ "/app.image") image
  let _ := tool "cp" [wasm, out ++ "/deus_kernel.wasm"]
  let _ := tool "cp" [crate ++ "/embed/kernel.mjs", out ++ "/kernel.mjs"]
  let _ := tool "cp" [crate ++ "/embed/worker.mjs", out ++ "/worker.mjs"]
  IO.writeFile (out ++ "/wrangler.toml") (Text.join "\n" [
    "name = " ++ Json.render (Json.str name),
    "main = \"worker.mjs\"",
    "compatibility_date = \"2025-01-01\"",
    "",
    "[[rules]]",
    "type = \"Text\"",
    "globs = [\"**/*.image\"]",
    "fallthrough = true",
    "",
    "[[durable_objects.bindings]]",
    "name = \"ACTOR\"",
    "class_name = \"DeusActor\"",
    "",
    "[[migrations]]",
    "tag = \"v1\"",
    "new_sqlite_classes = [\"DeusActor\"]",
    ""])

end Build
