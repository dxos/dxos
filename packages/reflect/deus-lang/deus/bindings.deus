/-
  `deus bindings` (D81, D87): a JavaScript module and its `.d.ts` for a namespace, so TypeScript
  code calls DEUS functions as ordinary async functions and answers the abilities they perform.
  The module embeds an image of the exported functions and converts every value that crosses to
  and from the embedding's JSON encoding (docs/spec/EMBEDDING.md) with generated codecs; it runs
  on the wasm kernel through `deus-runtime.js`, a copy of src/bindings/deus-runtime.js. The
  declarations read like a hand-written library: types, constructors, one function per export.
  The spec is the document Bindings.Spec in the codebase (`deus view Bindings.Spec`); its theorems are the definitions under Bindings.Spec.
-/

namespace Bindings

/-- An exported function, with the TypeScript shape of everything that crosses for it. -/
structure Export where
  exName : Text
  exIdent : Text
  exGroup : Text
  exHash : Text
  exParams : List (Text, Sexp)
  exResult : Sexp
  exEffects : List (Text, List Sexp)
  exDoc : Text
  exShown : Text

/-- What the generator knows about the codebase: named types and abilities by IRI, TS names by hash. -/
structure Cx where
  cxEntries : Map Text Entry
  cxTypes : Map Text (Text, Text)
  cxAbilities : Map Text (Text, Text)
  cxNames : Map Text Text

def reserved : List Text :=
  ["arguments", "await", "break", "case", "catch", "class", "const", "continue", "debugger", "default", "delete", "do",
    "else", "enum", "eval", "export", "extends", "false", "finally", "for", "function", "if", "implements", "import",
    "in", "instanceof", "interface", "let", "new", "null", "package", "private", "protected", "public", "return",
    "static", "super", "switch", "this", "throw", "true", "try", "typeof", "var", "void", "while", "with", "yield"]

/-- A TypeScript identifier for a DEUS name: other characters become `_`, and keywords take a `_`. -/
def ident (t : Text) : Text :=
  let safe := Text.fromCodes (List.map (fun i =>
    let c := Text.code t i
    if Text.isAlpha c || Text.isDigit c || c == '_' || c == '$' then c else '_') (List.range 0 (Text.length t)))
  let lead := if Text.isEmpty safe || Text.isDigit (Text.code safe 0) then "_" ++ safe else safe
  if List.contains lead reserved then lead ++ "_" else lead

def capitalize (t : Text) : Text :=
  if Text.isEmpty t then t
  else
    let c := Text.code t 0
    if c >= 'a' && c <= 'z' then Text.fromCode (c - 32) ++ Text.drop 1 t else t

/-- TypeScript names of a declaration's type parameters: `a` is `A`. -/
def typeParams (names : List Text) : List Text := List.map (fun n => ident (capitalize n)) names

def quote (t : Text) : Text := "'" ++ Text.replace "'" "\\'" (Text.replace "\\" "\\\\" t) ++ "'"

def isBuiltin (iri : Text) : Bool := Text.startsWith "#" iri

def isTref (iri : Text) (t : Sexp) : Bool :=
  match t with
  | Sexp.list [Sexp.sym "tref", Sexp.str i] => i == iri
  | _ => false

/-- The head IRI and arguments of a type application, or of a plain reference. -/
def applied (t : Sexp) : Option (Text, List Sexp) :=
  match t with
  | Sexp.list [Sexp.sym "tref", Sexp.str iri] => some (iri, [])
  | Sexp.list (Sexp.sym "tapp" :: Sexp.list [Sexp.sym "tref", Sexp.str iri] :: args) => some (iri, args)
  | _ => none

/-- Parameter types, the result type and the effect items of a curried function type. -/
def arrows (t : Sexp) : (List Sexp, Sexp, List Sexp) :=
  match t with
  | Sexp.list [Sexp.sym "tfun", a, b] => withParam a [] (arrows b)
  | Sexp.list [Sexp.sym "tfun", a, b, Sexp.list (Sexp.sym "eff" :: effs)] => withParam a effs (arrows b)
  | Sexp.list [Sexp.sym "teff", Sexp.list (Sexp.sym "eff" :: effs), r] =>
    match arrows r with
    | (ps, result, more) => (ps, result, effs ++ more)
  | _ => ([], t, [])

def withParam (a : Sexp) (effs : List Sexp) (rest : (List Sexp, Sexp, List Sexp)) : (List Sexp, Sexp, List Sexp) :=
  match rest with
  | (ps, result, more) => (a :: ps, result, effs ++ more)

/-- `t` with the declaration's parameters `(tvar i)` replaced by `args`. -/
def instantiate (args : List Sexp) (t : Sexp) : Sexp :=
  match t with
  | Sexp.list [Sexp.sym "tvar", Sexp.int i] => Option.getOr (List.get? args i) t
  | Sexp.list items => Sexp.list (List.map (instantiate args) items)
  | _ => t

/-- Whether a value of `t` can be `undefined` in TypeScript, which `Option` would make ambiguous. -/
def undefinable (t : Sexp) : Bool :=
  match applied t with
  | some (iri, _) => iri == "#Unit" || iri == "#Option"
  | none => false

def userName (cx : Cx) (iri : Text) : {Throw Text} Text :=
  match Map.lookup iri cx.cxTypes with
  | some (h, _) => Option.getOr (Map.lookup h cx.cxNames) (ident iri)
  | none => throw ("type " ++ iri ++ " has no name in the codebase")

/-- The TypeScript type of a DEUS type; `vars` names the enclosing declaration's parameters. -/
def tsType (cx : Bindings.Cx) (vars : List Text) (t : Sexp) : {Throw Text} Text :=
  match t with
  | Sexp.list (Sexp.sym "tvar" :: Sexp.int i :: []) =>
      match get? vars i with
      | Option.some v => v
      | Option.none => Throw.throw ("unknown type parameter " ++ Int.toText i)
  | Sexp.list (Sexp.sym "tvar" :: Sexp.str v :: []) => if List.contains (generic v) vars then generic v else Throw.throw ("polymorphic in " ++ v ++ " where no codec for it is passed")
  | Sexp.list (Sexp.sym "tfun" :: _) =>
      match Bindings.arrows t with
      -- Parenthesized, so `Option (a -> b)` reads as an optional function and not as one that may return undefined.
      | (a :: [], b, _) => "((value: " ++ Bindings.tsType cx vars a ++ ") => " ++ Bindings.tsType cx vars b ++ " | Promise<" ++ Bindings.tsType cx vars b ++ ">)"
      | _ => Throw.throw "takes a function of more than one parameter"
  | _ =>
      match applied t with
      | Option.some ("#Int", []) => "number"
      | Option.some ("#Text", []) => "string"
      | Option.some ("#Bool", []) => "boolean"
      | Option.some ("#Unit", []) => "void"
      | Option.some ("#List", x :: []) => "ReadonlyArray<" ++ Bindings.tsType cx vars x ++ ">"
      | Option.some ("#Option", x :: []) => if undefinable x then Throw.throw "an Option of Unit or Option has no unambiguous TypeScript form" else Bindings.tsType cx vars x ++ " | undefined"
      | Option.some ("#Pair", a :: b :: []) => "readonly [" ++ join ", " (List.map (Bindings.tsType cx vars) (Bindings.tupleItems a b)) ++
          "]"
      | Option.some (iri, args) => if isBuiltin iri then Throw.throw ("no TypeScript form for " ++ iri) else userName cx iri ++ Ts.generics (List.map (Bindings.tsType cx vars) args)
      | Option.none => Throw.throw ("no TypeScript form for " ++ Sexp.print t)

/-- `(a, (b, c))` flattens to three items, as DEUS writes `(a, b, c)`; longer tuples nest in the last. -/
def tupleItems (a : Sexp) (b : Sexp) : List Sexp :=
  match applied b with
  | some ("#Pair", [c, d]) => [a, c, d]
  | _ => [a, b]

def generics (args : List Text) : Text := if List.isEmpty args then "" else "<" ++ Text.join ", " args ++ ">"

def codecVar (v : Text) : Text := "codec" ++ v

/-- The TypeScript name of a function's type variable: `a` is `A`, as a generic type's parameters are. -/
def generic (v : Text) : Text := capitalize v

/-- The type variables of `types`, in first-seen order: a polymorphic function's generics, each passed its codec (task b6907aeb). -/
def typeVarsOf (types : List Sexp) : List Text :=
  let rec go t acc :=
    match t with
    | Sexp.list (Sexp.sym "tvar" :: Sexp.str v :: []) => if List.contains v acc then acc else acc ++ [v]
    | Sexp.list (Sexp.sym "eff" :: _) => acc
    | Sexp.list items => List.foldl (fun a x => go x a) acc items
    | _ => acc
  List.map generic (List.foldl (fun a t => go t a) [] types)

/-- An export's generics: its type variables, from its parameters and result. -/
def exVars (e : Export) : List Text := typeVarsOf (e.exResult :: List.map snd e.exParams)

/-- An export's leading codec parameters, one per generic. -/
def codecParams (vars : List Text) : List (Text, Text) := List.map (fun v => (codecVar v, "Codec<" ++ v ++ ">")) vars

/-- An expression for the codec of `t`; codecs of user types are hoisted functions. -/
def codec (cx : Bindings.Cx) (vars : List Text) (t : Sexp) : {Throw Text} Text :=
  match t with
  | Sexp.list (Sexp.sym "tvar" :: Sexp.int i :: []) =>
      match get? vars i with
      | Option.some v => codecVar v
      | Option.none => Throw.throw ("unknown type parameter " ++ Int.toText i)
  | Sexp.list (Sexp.sym "tvar" :: Sexp.str v :: []) => if List.contains (generic v) vars then codecVar (generic v) else Throw.throw ("no codec for " ++ v)
  | Sexp.list (Sexp.sym "tfun" :: _) =>
      match Bindings.arrows t with
      | (a :: [], b, _) => "$rt.fn(" ++ Bindings.codec cx vars a ++ ", " ++ Bindings.codec cx vars b ++ ")"
      | _ => Throw.throw "takes a function of more than one parameter"
  | _ =>
      match applied t with
      | Option.some ("#Int", []) => "$rt.int"
      | Option.some ("#Text", []) => "$rt.text"
      | Option.some ("#Bool", []) => "$rt.bool"
      | Option.some ("#Unit", []) => "$rt.unit"
      | Option.some ("#List", x :: []) => "$rt.list(" ++ Bindings.codec cx vars x ++ ")"
      | Option.some ("#Option", x :: []) => "$rt.option(" ++ Bindings.codec cx vars x ++ ")"
      | Option.some ("#Pair", a :: b :: []) =>
          let items := List.map (Bindings.codec cx vars) (Bindings.tupleItems a b)
          (if List.length items == 3 then "$rt.triple(" else "$rt.pair(") ++ join ", " items ++ ")"
      | Option.some (iri, args) => userName cx iri ++ "$(" ++ join ", " (List.map (Bindings.codec cx vars) args) ++ ")"
      | Option.none => Throw.throw ("no codec for " ++ Sexp.print t)

/-- User type IRIs mentioned in a type. -/
def iris (t : Sexp) (acc : List Text) : List Text :=
  match t with
  | Sexp.list [Sexp.sym "tref", Sexp.str iri] => if isBuiltin iri || List.contains iri acc then acc else iri :: acc
  | Sexp.list items => List.foldl (fun a x => iris x a) acc items
  | _ => acc

/-- Constructor field types of a type object. -/
def ctors (obj : Sexp) : List (List Sexp) :=
  List.map (fun c => List.drop 1 (Sexp.args c)) (View.typeArgs obj)

/-- Every user type reachable from `roots` through constructor fields, in first-seen order. -/
def typeClosure (cx : Cx) (fetch : Text -> {IO} Option Sexp) (roots : List Text) : {IO, Throw Text} List Text :=
  let rec go work seen :=
    match work with
    | [] => List.reverse seen
    | iri :: rest =>
      if List.contains iri seen then go rest seen
      else
        match Map.lookup iri cx.cxTypes with
        | none => throw ("type " ++ iri ++ " has no name in the codebase")
        | some (h, _) =>
          match fetch h with
          | none => throw ("missing type object " ++ h)
          | some obj => go (rest ++ List.reverse (List.foldl (fun a t => iris t a) [] (List.concat (ctors obj)))) (iri :: seen)
  go roots []

/-- Constructor names of type `h`, by tag. -/
def ctorNames (ns : Map Text Entry) (h : Text) : List (Int, Text) :=
  List.filterMap (fun pair =>
    match pair with
    | (n, Entry.ctor t tag _) => if t == h then some (tag, Names.lastSegment n) else none
    | _ => none) (Map.toList ns)

/-- Field names per constructor: a structure's from its entry, others from metadata; `_i` when unnamed. -/
def fieldNames (cx : Bindings.Cx) (name : Text) (meta : Option Sexp) (tag : Int) (count : Int) : List Text :=
  let fromEntry :=
    match Map.lookup name cx.cxEntries with
    | Option.some (Entry.type _ _ fields) => if tag == 0 then fields else []
    | _ => []
  let named := if List.length fromEntry == count then fromEntry else getOr (get? (fieldNamesFor meta) tag) []
  List.map (fun i =>
    match get? named i with
    | Option.some n => if Text.isEmpty n then "_" ++ Int.toText i else n
    | Option.none => "_" ++ Int.toText i) (range 0 count)

def docComment (indent : Text) (lines : List Text) : Text :=
  match List.filter (fun l => not (Text.isEmpty l)) lines with
  | [] => ""
  | [one] => indent ++ "/** " ++ one ++ " */\n"
  | many => indent ++ "/**\n" ++ Text.concat (List.map (fun l => indent ++ " * " ++ l ++ "\n") many) ++ indent ++ " */\n"

def docOf (meta : Option Sexp) : Text := getOr (Option.map asText (metaField meta "doc")) ""

/-- A property name: reserved words are allowed there, so only other characters are replaced. -/
def propKey (t : Text) : Text := if List.contains t reserved then t else ident t

def decapitalize (t : Text) : Text :=
  if Text.isEmpty t then t
  else
    let c := Text.code t 0
    if c >= 'A' && c <= 'Z' then Text.fromCode (c + 32) ++ Text.drop 1 t else t

/-- A parameter name suggested by a type, for operations, whose parameters have no names. -/
def opParamName (cx : Cx) (t : Sexp) : Text :=
  match applied t with
  | some ("#Text", _) => "text"
  | some ("#Int", _) => "n"
  | some ("#Bool", _) => "flag"
  | some ("#List", _) => "items"
  | some ("#Option", _) => "maybe"
  | some ("#Pair", _) => "pair"
  | some (iri, _) =>
    match Map.lookup iri cx.cxTypes with
    | some (h, _) => ident (decapitalize (Option.getOr (Map.lookup h cx.cxNames) "arg"))
    | none => "arg"
  | none => "arg"

/--
  Numbers the names that repeat: `(text, text)` is `(text1, text2)`. A number is skipped when the
  numbered name is taken, so `(text, text, text1)` is `(text2, text3, text1)`.
-/
def distinct (names : List Text) : List Text :=
  let rec fresh n k used :=
    let candidate := n ++ Int.toText k
    if List.contains candidate names || List.contains candidate used then fresh n (k + 1) used else candidate
  List.reverse (List.foldl (fun used n =>
    if List.length (List.filter (fun m => m == n) names) > 1 then fresh n 1 used :: used else n :: used) [] names)

/-- One user type: its declaration, its codec, and, for a variant with fields, a constructor per
  variant as a `.d.ts` member and a `.js` member. -/
def typeParts (cx : Bindings.Cx) (fetch : Text -> {IO} Option Sexp) (meta : Text -> {IO} Option Sexp) (iri : Text) : {IO, Throw Text} (Text, (Text, List (Text, Text))) :=
  match Map.lookup iri cx.cxTypes with
  | Option.none => Throw.throw ("type " ++ iri ++ " has no name in the codebase")
  | Option.some (h, name) =>
      let obj := getOr (fetch h) (Sexp.list [])
      let m := meta h
      let count :=
        match Sexp.args obj with
        | _ :: Sexp.int n :: _ => n
        | _ => 0
      let vars := Bindings.typeParams (paramsFor m count obj)
      let tsName := userName cx iri
      let full := tsName ++ Ts.generics vars
      let shapes := ctors obj
      let names := ctorNames cx.cxEntries h
      let ctorName := fun tag => getOr (List.lookup tag names) ("ctor" ++ Int.toText tag)
      let label := Bindings.quote name
      let header := Bindings.docComment "" [Bindings.docOf m, "`" ++ name ++ "` (" ++ iri ++ ")"]
      let codecHead := "function " ++ tsName ++ "$(" ++ join ", " (List.map codecVar vars) ++ ") {\n  return {\n"
      let decodeHead := "    decode: (json) => {\n      const value = $rt.con(json, " ++ label ++ ");\n"
      let make := fun tag fields => "$rt.make(" ++ Bindings.quote h ++ ", " ++ Int.toText tag ++ ", [" ++ join ", " fields ++ "])"
      let encodeFields := fun tag types => List.map
        (fun pair => Bindings.codec cx vars (snd pair) ++ ".encode(value." ++ fst pair ++ ")")
        (zip (Bindings.fieldNames cx name m tag (List.length types)) types)
      let decodeFields := fun tag types => mapIndexed
        (fun i pair => fst pair ++ ": " ++ Bindings.codec cx vars (snd pair) ++ ".decode($rt.field(value, " ++
          Int.toText i ++ "))")
        (zip (Bindings.fieldNames cx name m tag (List.length types)) types)
      let badTag := "        default:\n          throw $rt.badTag(" ++ label ++ ", value);\n"
      if List.isEmpty shapes then Throw.throw ("type " ++ name ++ " has no constructors") else if List.all List.isEmpty shapes then
        let literals := mapIndexed (fun tag _ => Bindings.quote (ctorName tag)) shapes
        (header ++ "export type " ++ full ++ " = " ++ join " | " literals ++ ";\n", codecHead ++ "    encode: (value) => {\n      switch (value) {\n" ++ Text.concat (mapIndexed
          (fun tag lit => "        case " ++ lit ++ ":\n          return " ++ make tag [] ++ ";\n")
          literals) ++ "        default:\n          throw new $rt.DeusDecodeError(" ++ label ++ ", value);\n" ++ "      }\n    },\n" ++ decodeHead ++ "      switch (value.tag) {\n" ++ Text.concat (mapIndexed
          (fun tag lit => "        case " ++ Int.toText tag ++ ":\n          return " ++ lit ++ ";\n")
          literals) ++ badTag ++ "      }\n    },\n  };\n}\n", [])
      else if List.length shapes == 1 then
        let types := getOr (head? shapes) []
        let fields := List.map
          (fun pair => "readonly " ++ fst pair ++ ": " ++ tsType cx vars (snd pair))
          (zip (Bindings.fieldNames cx name m 0 (List.length types)) types)
        (header ++ "export type " ++ full ++ " = { " ++ join "; " fields ++ " };\n", codecHead ++ "    encode: (value) => " ++ make 0 (encodeFields 0 types) ++ ",\n" ++
          decodeHead ++ "      return { " ++ join ", " (decodeFields 0 types) ++ " };\n    },\n  };\n}\n", [])
      else
        let variants := mapIndexed (fun tag types =>
          let fields := List.map
            (fun pair => "; readonly " ++ fst pair ++ ": " ++ tsType cx vars (snd pair))
            (zip (Bindings.fieldNames cx name m tag (List.length types)) types)
          "  | { readonly $tag: " ++ Bindings.quote (ctorName tag) ++ Text.concat fields ++ " }") shapes
        let builders := mapIndexed (fun tag types =>
          let cname := ctorName tag
          let key := propKey cname
          let fields := Bindings.fieldNames cx name m tag (List.length types)
          let params := List.map Bindings.ident fields
          if List.isEmpty types then ("  readonly " ++ key ++ ": " ++ tsName ++ Ts.generics (List.map (fun _ => "never") vars) ++
            ";", "  " ++ key ++ ": { $tag: " ++ Bindings.quote cname ++ " },") else
            let typed := List.map (fun pair => fst pair ++ ": " ++ tsType cx vars (snd pair)) (zip params types)
            let props := List.map
              (fun pair => if fst pair == snd pair then fst pair else fst pair ++ ": " ++ snd pair)
              (zip fields params)
            ("  readonly " ++ key ++ ": " ++ Ts.generics vars ++ "(" ++ join ", " typed ++ ") => " ++
              full ++ ";", "  " ++ key ++ ": (" ++ join ", " params ++ ") => ({ $tag: " ++ Bindings.quote cname ++
              Text.concat (List.map (fun p => ", " ++ p) props) ++ " }),")) shapes
        (header ++ "export type " ++ full ++ " =\n" ++ join "\n" variants ++ ";\n", codecHead ++ "    encode: (value) => {\n      switch (value.$tag) {\n" ++
          Text.concat (mapIndexed
            (fun tag types => "        case " ++ Bindings.quote (ctorName tag) ++ ":\n          return " ++
              make tag (encodeFields tag types) ++ ";\n")
            shapes) ++ "        default:\n          throw new $rt.DeusDecodeError(" ++ label ++ ", value);\n" ++ "      }\n    },\n" ++ decodeHead ++ "      switch (value.tag) {\n" ++ Text.concat (mapIndexed
          (fun tag types => "        case " ++ Int.toText tag ++ ":\n          return { $tag: " ++
            Bindings.quote (ctorName tag) ++ Text.concat (List.map (fun f => ", " ++ f) (decodeFields tag types)) ++ " };\n")
          shapes) ++ badTag ++ "      }\n    },\n  };\n}\n", builders)

/-- An ability the exported functions perform, with the type arguments they perform it at. -/
def effectOf (t : Sexp) : Option (Text, List Sexp) :=
  match applied t with
  | some (iri, args) => if isBuiltin iri then none else some (iri, args)
  | none => none

/-- Operations of ability `h`, by index, with their names. -/
def opNames (ns : Map Text Entry) (h : Text) : List (Int, Text) :=
  List.filterMap (fun pair =>
    match pair with
    | (n, Entry.op a index _) => if a == h then some (index, Names.lastSegment n) else none
    | _ => none) (Map.toList ns)

def abilityName (cx : Cx) (iri : Text) : {Throw Text} (Text, Text) :=
  match Map.lookup iri cx.cxAbilities with
  | some (h, name) => (h, name)
  | none => throw ("ability " ++ iri ++ " has no name in the codebase")

/-- The prelude's `Throw`, which a module answers by default with `DeusThrow`. -/
def throwIri : Text := "urn:deus:Throw"

/-- The key of an ability in `Handlers`: its last segment. -/
def handlerKey (cx : Cx) (iri : Text) : {Throw Text} Text :=
  match abilityName cx iri with
  | (_, name) => ident (Names.lastSegment name)

/-- A handler interface, and the function that answers the kernel's requests with a handler. -/
def handlerParts (cx : Bindings.Cx) (fetch : Text -> {IO} Option Sexp) (effect : (Text, List Sexp)) : {IO, Throw Text} (Text, Text) :=
  let (iri, args) := effect
  let (h, name) := abilityName cx iri
  let short := handlerKey cx iri
  let ops := List.filter (fun x => head x == "op") (Sexp.args (getOr (fetch h) (Sexp.list [])))
  let names := opNames cx.cxEntries h
  let rendered := mapIndexed (fun index op =>
    let oname := propKey (getOr (List.lookup index names) ("op" ++ Int.toText index))
    let t := JsGen.substitute args (getOr (last? (Sexp.args op)) (Sexp.list []))
    let (params, result, _) := Bindings.arrows t
    let shown := List.filter (fun p => not (isTref "#Unit" p)) params
    let paramText := join ", " (List.map
      (fun pair => fst pair ++ ": " ++ tsType cx [] (snd pair))
      (zip (distinct (List.map (opParamName cx) shown)) shown))
    let never :=
      match result with
      | Sexp.list (Sexp.sym "tvar" :: Sexp.str _ :: []) => true
      | _ => false
    let resultText := if never then "never" else tsType cx [] result
    let decoded := mapIndexed
      (fun i p => Bindings.codec cx [] p ++ ".decode($rt.arg(args, " ++ Int.toText i ++ "))")
      params
    let passed := filterMap
      (fun pair => if isTref "#Unit" (snd pair) then Option.none else Option.some (fst pair))
      (zip decoded params)
    let callText := "handler." ++ oname ++ "(" ++ join ", " passed ++ ")"
    let answer := if never then callText else Bindings.codec cx [] result ++ ".encode(await " ++ callText ++ ")"
    ("  " ++ oname ++ "(" ++ paramText ++ "): Awaitable<" ++ resultText ++ ">;", "    case " ++ Int.toText index ++ ":\n      return " ++ answer ++ ";\n")) ops
  let missing := "no handler for " ++ name ++ ": pass handlers." ++ short ++ " to configure() or load()"
  (Bindings.docComment "" ["Answers `" ++ name ++ "` (" ++ iri ++ ") for the DEUS code."] ++
    "export interface " ++ short ++ "Handler {\n" ++ join "\n" (List.map fst rendered) ++ "\n}\n", "const $answer" ++ short ++ " = (handler) => async (op, args) => {\n" ++
    "  if (handler === undefined) {\n    throw new Error(" ++ Bindings.quote missing ++ ");\n  }\n  switch (op) {\n" ++ Text.concat (List.map snd rendered) ++ "    default:\n      throw new Error(`" ++ name ++ " has no operation ${op}`);\n  }\n};\n")

/-- Checks that everything an exported function exchanges has a TypeScript form, and records it. -/
def analyze (cx : Bindings.Cx) (meta : Text -> {IO} Option Sexp) (fetch : Text -> {IO} Option Sexp) (name : Text) (relative : Text) (h : Text) : {IO, Throw Text} Export :=
  let m := meta h
  let scheme :=
    match metaField m "scheme" with
    | Option.some s => s
    | Option.none =>
        match metaField m "sig" with
        | Option.some s => s
        | Option.none => Throw.throw "has no type"
  let (arrowTypes, arrowResult, effs) := Bindings.arrows scheme
  let lams :=
    match fetch h with
    | Option.some (Sexp.list (Sexp.sym "term" :: core :: [])) => arity core
    | _ => 0
  -- Its leading lambdas are its parameters; a type with more arrows returns a function (`scaler k := times k`).
  let (types, result) := if lams > 0 && lams < List.length arrowTypes then
    (List.take lams arrowTypes, List.foldr (fun a r => Sexp.list [Sexp.sym "tfun", a, r]) arrowResult (List.drop lams arrowTypes))
  else (arrowTypes, arrowResult)
  List.map (tsType cx (typeVarsOf (result :: types))) (result :: types)
  let effects := filterMap effectOf effs
  List.map (fun e => abilityName cx (fst e)) effects
  List.map (tsType cx []) (concatMap snd effects)
  let locals := List.map asText (metaList m "locals")
  let paramName := fun i =>
    match get? locals i with
    | Option.some n => if i < lams && not (Text.isEmpty n) && not (n == "_") then Bindings.ident n else "arg" ++ Int.toText i
    | Option.none => "arg" ++ Int.toText i
  let segments := Text.split relative "."
  let group := Bindings.ident (join "_" (List.take (List.length segments - 1) segments))
  Export.mk
    name
    (Bindings.ident (lastSegment relative))
    (if List.length segments > 1 then group else "")
    h
    (mapIndexed (fun i t => (paramName i, t)) types)
    result
    effects
    (Bindings.docOf m)
    (displayScheme scheme)

def leadingLams (core : Sexp) : Int :=
  match core with
  | Sexp.list [Sexp.sym "lam", b] => 1 + leadingLams b
  | _ => 0

/-- The entry an exported function is called through. A function of one parameter is its own
  entry; a constant, or a function of several, gets an adapter that takes the parameters as a
  right-nested pair, because the kernel applies an entry to exactly one value. -/
def adapter (e : Export) : Option (Text, Sexp) :=
  let n := List.length e.exParams
  let target := Sexp.node "ref" [Sexp.str e.exHash]
  let core := if n == 0 then Option.some (Sexp.node "lam" [target]) else if n == 1 then Option.none else
    let rec pat k := if k == 1 then Sexp.node "pvar" [] else Sexp.node "pcon" [Sexp.str "#Pair", Sexp.int 0, Sexp.node "pvar" [], pat (k - 1)]
    let vars := List.map (fun i => Sexp.node "var" [Sexp.int (n - 1 - i)]) (range 0 n)
    Option.some (Sexp.node "lam" [Sexp.node
      "match"
      [Sexp.node "var" [Sexp.int 0], Sexp.node "case" [pat n, Sexp.node "app" (target :: vars)]]])
  Option.map (fun c => (Text.sha256 (Sexp.print (Sexp.node "term" [c])), c)) core

def entryOf (e : Export) : Text := getOr (Option.map fst (adapter e)) e.exHash

/-- The image: every exported definition with its closure, plus the adapters, sorted by hash. -/
def image (fetch : Text -> {IO} Option Sexp) (exports : List Export) : {IO, Throw Text} Text :=
  let defs := closure (fun h => fetch h) (List.map (fun e => e.exHash) exports)
  let adapters := filterMap adapter exports
  let all := sortBy (fun a b => compare (fst a) (fst b)) (defs ++ adapters)
  let main := getOr (Option.map Bindings.entryOf (head? exports)) ""
  join "\n" (List.map defForm all ++ nominalForms (fun h => fetch h) defs ++
    [Sexp.print (Sexp.node "main" [Sexp.str main])]) ++ "\n"

def shownParams (e : Export) : List (Text, Sexp) := List.filter (fun p => not (isTref "#Unit" (snd p))) e.exParams

def argNames (e : Export) : Text := Text.join ", " (List.map fst (shownParams e))

/-- What a function of the module takes and passes on: the codecs of its generics, then its arguments. -/
def callArgs (e : Export) : Text := Text.join ", " (List.map fst (codecParams (exVars e)) ++ List.map fst (shownParams e))

/-- An export's declared type, as a function type in an object type. -/
def propertyDts (cx : Bindings.Cx) (indent : Text) (e : Export) : {Throw Text} Text :=
  let vars := exVars e
  let params := join ", " (List.map (fun p => fst p ++ ": " ++ snd p) (codecParams vars) ++ List.map (fun p => fst p ++ ": " ++ tsType cx vars (snd p)) (shownParams e))
  Bindings.docComment indent (Text.lines e.exDoc ++ ["`" ++ e.exName ++ " : " ++ e.exShown ++ "`"]) ++
    indent ++
    "readonly " ++
    e.exIdent ++
    ": " ++
    Ts.generics vars ++
    "(" ++
    params ++
    ") => Promise<" ++
    tsType cx vars e.exResult ++
    ">;"

/-- An export's top-level declaration. -/
def functionDts (cx : Bindings.Cx) (e : Export) : {Throw Text} Text :=
  let vars := exVars e
  let params := join ", " (List.map (fun p => fst p ++ ": " ++ snd p) (codecParams vars) ++ List.map (fun p => fst p ++ ": " ++ tsType cx vars (snd p)) (shownParams e))
  Bindings.docComment "" (Text.lines e.exDoc ++ ["`" ++ e.exName ++ " : " ++ e.exShown ++ "`"]) ++
    "export declare function " ++ e.exIdent ++ Ts.generics vars ++ "(" ++ params ++ "): Promise<" ++ tsType cx vars e.exResult ++ ">;\n"

/-- How a loaded instance calls an export on the kernel. -/
def boundJs (cx : Bindings.Cx) (indent : Text) (e : Export) : {Throw Text} Text :=
  let vars := exVars e
  let encoded := List.map
    (fun p => if isTref "#Unit" (snd p) then "null" else Bindings.codec cx vars (snd p) ++ ".encode(" ++ fst p ++ ")")
    e.exParams
  let argument :=
    match encoded with
    | [] => "null"
    | one :: [] => one
    | many => "$rt.args([" ++ join ", " many ++ "])"
  indent ++ e.exIdent ++ ": async (" ++ callArgs e ++ ") => " ++ Bindings.codec cx vars e.exResult ++
    ".decode(await module.call(" ++ Bindings.quote (Bindings.entryOf e) ++ ", " ++ argument ++ ")),"

/-- Whether `name` is selected by one of the requested prefixes, and its name relative to it. -/
def relativeName (prefixes : List Text) (name : Text) : Option Text :=
  List.foldl (fun acc p =>
    match acc with
    | some _ => acc
    | none =>
      if name == p then some (Names.lastSegment name)
      else if Text.startsWith (p ++ ".") name then some (Text.drop (Text.length p + 1) name)
      else none) none prefixes

def isField (ns : Map Text Entry) (name : Text) : Bool :=
  let segments := Text.split name "."
  let owner := Text.join "." (List.take (List.length segments - 1) segments)
  match Map.lookup owner ns with
  | some (Entry.type _ _ fields) => List.contains (Names.lastSegment name) fields
  | _ => false

/-- TypeScript names for user types: the last segment, or the whole name where two would clash. -/
def typeNames (ns : Map Text Entry) : Map Text Text :=
  let types := List.filterMap (fun pair =>
    match pair with
    | (n, Entry.type h _ _) => some (h, n)
    | _ => none) (Map.toList ns)
  let short := fun (n : Text) => ident (Names.lastSegment n)
  let clashes := fun (n : Text) => List.length (List.filter (fun p => short (snd p) == short n) types) > 1
  List.foldl (fun m pair =>
    match pair with
    | (h, n) => if Map.contains h m then m else Map.insert h (if clashes n then ident (Text.replace "." "_" n) else short n) m) Map.empty types

def context (ns : Map Text Entry) : Cx :=
  let types := List.foldl (fun m pair =>
    match pair with
    | (n, Entry.type h iri _) => if Map.contains iri m then m else Map.insert iri (h, n) m
    | _ => m) Map.empty (Map.toList ns)
  let abilities := List.foldl (fun m pair =>
    match pair with
    | (n, Entry.ability h iri) => if Map.contains iri m then m else Map.insert iri (h, n) m
    | _ => m) Map.empty (Map.toList ns)
  Cx.mk ns types abilities (typeNames ns)

/-- Names the module defines itself; an export cannot take them. -/
def ownNames : List Text := ["load", "configure", "DeusDefect", "DeusThrow", "DeusDecodeError"]

/-- Exports and skipped names with reasons; an ability performed at two different types skips the later function. -/
def select (cx : Bindings.Cx) (meta : Text -> {IO} Option Sexp) (fetch : Text -> {IO} Option Sexp) (prefixes : List Text) : {IO} (List Export, List (Text, Text)) :=
  let candidates := filterMap (fun pair =>
    match pair with
    | (n, Entry.term h) => if isField cx.cxEntries n then Option.none else Option.map (fun rel => (n, rel, h)) (relativeName prefixes n)
    | _ => Option.none) (Map.toList cx.cxEntries)
  let step := fun acc c =>
    let ((kept, skipped, used), n, rel, h) := (acc, c)
    match try (fun _ => analyze cx meta fetch n rel h) with
    | Result.err reason => (kept, (n, reason) :: skipped, used)
    | Result.ok e =>
        let path := fun x => if Text.isEmpty x.exGroup then x.exIdent else x.exGroup ++ "." ++ x.exIdent
        let clash := List.find
          (fun x => path x == path e || Text.isEmpty e.exGroup && x.exGroup == e.exIdent || Text.isEmpty x.exGroup && e.exGroup == x.exIdent)
          kept
        let own := List.contains (if Text.isEmpty e.exGroup then e.exIdent else e.exGroup) ownNames
        let conflict := List.find (fun eff =>
          match Map.lookup (fst eff) used with
          | Option.some args => not (args == snd eff)
          | Option.none => false) e.exEffects
        match (clash, conflict) with
        | (Option.some other, _) => (kept, (n, "its TypeScript name " ++ path e ++ " clashes with " ++ other.exName) :: skipped, used)
        | (_, Option.some eff) => (kept, (n, "performs " ++ fst eff ++ " at a different type than an earlier function") :: skipped, used)
        | (Option.none, Option.none) => if own then (kept, (n, "its TypeScript name " ++ path e ++ " is the module's own") :: skipped, used) else (e :: kept, skipped, foldl (fun m eff => Map.insert (fst eff) (snd eff) m) used e.exEffects)
  let (kept, skipped, _) := foldl step ([], [], Map.empty) candidates
  (reverse kept, reverse skipped)

def declOf (p : (Text, (Text, Text, List (Text, Text)))) : Text :=
  match p with
  | (_, (decl, _, _)) => decl

def codecOf (p : (Text, (Text, Text, List (Text, Text)))) : Text :=
  match p with
  | (_, (_, made, _)) => made

/-- The module (`.js`) and its declarations (`.d.ts`) for the selected exports, with the exports
  that stay after a top-level name turned out to be a constructor object's, and the skipped ones. -/
def module (cx : Bindings.Cx) (fetch : Text -> {IO} Option Sexp) (meta : Text -> {IO} Option Sexp) (command : Text) (base : Text) (selected : List Export) (skipped0 : List (Text, Text)) : {IO, Throw Text} (Text, (Text, (List Export, List (Text, Text)))) :=
  let effects := foldl
    (fun acc e => foldl (fun a eff => if any (fun x => fst x == fst eff) a then a else a ++ [eff]) acc e.exEffects)
    []
    selected
  let roots := foldl
    (fun acc t => iris t acc)
    []
    (concatMap (fun e => e.exResult :: List.map snd e.exParams) selected ++ concatMap (fun eff =>
      let (h, _) := abilityName cx (fst eff)
      List.map (JsGen.substitute (snd eff)) (List.map
        (fun op => getOr (last? (Sexp.args op)) (Sexp.list []))
        (List.filter (fun x => head x == "op") (Sexp.args (getOr (fetch h) (Sexp.list []))))) ++ snd eff) effects)
  let types := typeClosure cx fetch (reverse roots)
  let parts := List.map (fun iri => (userName cx iri, typeParts cx fetch meta iri)) types
  let builders := filterMap (fun p =>
    let (n, _, _, made) := p
    if List.isEmpty made then Option.none else Option.some (n, made)) parts
  let builderNames := List.map fst builders
  let exports := List.filter
    (fun e => not (Text.isEmpty e.exGroup && List.contains e.exIdent builderNames))
    selected
  let skipped := skipped0 ++ filterMap
    (fun e => if Text.isEmpty e.exGroup && List.contains e.exIdent builderNames then Option.some (e.exName, "its TypeScript name " ++ e.exIdent ++ " is the constructors of type " ++ e.exIdent) else Option.none)
    selected
  let top := List.filter (fun e => Text.isEmpty e.exGroup) exports
  let inGroup := fun g => List.filter (fun e => e.exGroup == g) exports
  let groups := foldl
    (fun acc e => if Text.isEmpty e.exGroup || List.contains e.exGroup acc then acc else acc ++ [e.exGroup])
    builderNames
    exports
  let fnGroups := List.filter (fun g => not (List.isEmpty (inGroup g))) groups
  let handlers := List.map (handlerParts cx fetch) effects
  let keys := List.map (fun eff => (handlerKey cx (fst eff), fst eff == throwIri)) effects
  let required := any (fun k => not (snd k)) keys
  let takenTypes := ["Options", "Handlers"] ++ List.map fst parts ++ List.map (fun k => fst k ++ "Handler") keys
  let api := if List.contains base takenTypes then base ++ "Api" else base
  let skippedText := if List.isEmpty skipped then "" else "//\n// Not exported:\n" ++
    Text.concat (List.map (fun s => "//   " ++ fst s ++ ": " ++ snd s ++ "\n") skipped)
  let banner := "// Generated by `" ++ command ++
    "`; regenerate rather than edit. `deus view Bindings.Spec` in deus-lang has the mapping.\n" ++ skippedText
  let groupDts := fun g =>
    let made := getOr (List.lookup g builders) []
    "export declare const " ++ g ++ ": {\n" ++
      join "\n" (List.map fst made ++ List.map (propertyDts cx "  ") (inGroup g)) ++ "\n};\n"
  let groupJs := fun g =>
    let made := getOr (List.lookup g builders) []
    let calls := List.map
      (fun e => "  " ++ e.exIdent ++ ": async (" ++ callArgs e ++ ") => (await $current())." ++ g ++ "." ++
        e.exIdent ++ "(" ++ callArgs e ++ "),")
      (inGroup g)
    "export const " ++ g ++ " = {\n" ++ join "\n" (List.map snd made ++ calls) ++ "\n};\n"
  let dts := join
    "\n"
    [banner, "import type { " ++ join ", " ((if List.isEmpty effects then [] else ["Awaitable"]) ++ (if List.any (fun e => not (List.isEmpty (exVars e))) exports then ["Codec"] else []) ++ ["IoHost"]) ++ " } from './deus-runtime.js';", "", "export { DeusDecodeError, DeusDefect, DeusThrow, type Awaitable, type IoHost } from './deus-runtime.js';", "", join "\n" (List.map declOf parts), join "\n" (List.map fst handlers), "/** Answers for the abilities the functions perform and do not handle themselves. */", if List.isEmpty effects then "export type Handlers = Record<string, never>;\n" else "export interface Handlers {\n" ++ join "\n" (List.map
      (fun k => if snd k then "  /** By default a `throw` rejects the call with `DeusThrow`. */\n  readonly " ++ fst k ++
        "?: " ++ fst k ++ "Handler;" else "  readonly " ++ fst k ++ ": " ++ fst k ++ "Handler;")
      keys) ++ "\n}\n", "/** How to load the kernel, and the host side of the abilities the functions perform. */", "export interface Options {", "  /** `deus_kernel.wasm` as bytes or a compiled module; by default the file next to this module. */", "  readonly wasm?: BufferSource | WebAssembly.Module;", "  /** Answers for the built-in `IO` ability; by default it prints to the console. */", "  readonly io?: IoHost;", "  readonly handlers" ++ (if required then "" else "?") ++ ": Handlers;", "}", "", "/** The functions of one loaded instance. */", "export interface " ++ api ++ " {", join "\n" (List.map (propertyDts cx "  ") top ++ List.map
      (fun g => "  readonly " ++ g ++ ": {\n" ++ join "\n" (List.map (propertyDts cx "    ") (inGroup g)) ++
        "\n  };")
      fnGroups), "}", "", "/** Sets the options the module-level functions run with; the next call loads the kernel with them. */", "export declare function configure(options: Options): void;", "", "/** Loads an instance of its own, apart from the module-level functions. */", "export declare function load(options" ++ (if required then "" else "?") ++
      ": Options): Promise<" ++ api ++ ">;", "", join "\n" (List.map (functionDts cx) top), join "\n" (List.map groupDts groups)]
  let abilityEntries := concatMap (fun eff =>
    let ((h, _), key) := (abilityName cx (fst eff), handlerKey cx (fst eff))
    let given := "handlers." ++ key
    let handler := if fst eff == throwIri then given ++ " ?? $throwing" else given
    let answer := "$answer" ++ key ++ "(" ++ handler ++ ")"
    ["    [" ++ Bindings.quote (fst eff) ++ ", " ++ answer ++ "],", "    [" ++ Bindings.quote h ++ ", " ++ answer ++ "],"]) effects
  let js := join
    "\n"
    [banner, "import * as $rt from './deus-runtime.js';", "", "export { DeusDecodeError, DeusDefect, DeusThrow } from './deus-runtime.js';", "", "const $IMAGE = " ++ Json.escape (Bindings.image fetch exports) ++ ";", "", join "\n" (List.map codecOf parts), join "\n" (List.map snd handlers), "const $throwing = {", "  throw: (value) => {", "    throw new $rt.DeusThrow(value);", "  },", "};", "", "const $abilities = (handlers) =>", "  new Map([", join "\n" abilityEntries, "  ]);", "", "const $bind = (module) => ({", join "\n" (List.map (boundJs cx "  ") top ++ List.map
      (fun g => "  " ++ g ++ ": {\n" ++ join "\n" (List.map (boundJs cx "    ") (inGroup g)) ++ "\n  },")
      fnGroups), "});", "", "export const load = async ({ wasm, io, handlers = {} } = {}) =>", "  $bind(", "    await $rt.loadModule({", "      wasm: wasm ?? (await $rt.kernelNextTo(import.meta.url)),", "      image: $IMAGE,", "      io,", "      abilities: $abilities(handlers),", "    }),", "  );", "", "let $options = {};", "let $instance;", "", "const $current = () =>", "  ($instance ??= load($options).catch((error) => {", "    $instance = undefined;", "    throw error;", "  }));", "", "export const configure = (options) => {", "  $options = options;", "  $instance = undefined;", "};", "", join "" (List.map
      (fun e => "export const " ++ e.exIdent ++ " = async (" ++ callArgs e ++ ") => (await $current())." ++
        e.exIdent ++ "(" ++ callArgs e ++ ");\n")
      top), join "\n" (List.map groupJs groups)]
  (js, dts, exports, skipped)

/-- Generates the module for `prefixes`: the `.js` text, the `.d.ts` text, the exported names and
  the skipped ones with reasons. -/
def generate (dir : Text) (prefixes : List Text) (command : Text) : {IO, Throw Text} (Text, (Text, (List Text, List (Text, Text)))) :=
  let ns := Codebase.current dir
  let cx := Bindings.context ns
  let fetch := fun h => readObject dir h
  let meta := fun h => readMeta dir h
  let base := Bindings.ident (capitalize (lastSegment (getOr (head? prefixes) "Module")))
  let (selected, skipped0) := select cx meta fetch prefixes
  if List.isEmpty selected then Throw.throw ("nothing to export under " ++ join ", " prefixes ++
    Text.concat (List.map (fun s => "\n  " ++ fst s ++ ": " ++ snd s) skipped0)) else
    let (js, dts, exports, skipped) := Bindings.module cx fetch meta command base selected skipped0
    (js, dts, List.map (fun e => e.exName) exports, skipped)

test distinctSkipsTakenNumbers := distinct ["text", "text", "text1"] == ["text2", "text3", "text1"]

test identKeepsNames := ident "area" == "area" && ident "head?" == "head_" && ident "default" == "default_" && ident "2d" == "_2d"

test arrowsSplitsCurriedTypes :=
  match arrows (Sexp.read "(tfun (tref \"#Int\") (tfun (tref \"#Text\") (tref \"#Bool\") (eff (tref \"urn:x:Log\"))) (eff (tvar \"r\")))") with
  | (params, result, effs) => List.length params == 2 && isTref "#Bool" result && List.length effs == 2

test adapterTakesNestedPairs :=
  let e := Export.mk
    "f"
    "f"
    ""
    "h"
    [("a", Sexp.read "(tref \"#Int\")"), ("b", Sexp.read "(tref \"#Int\")"), ("c", Sexp.read "(tref \"#Int\")")]
    (Sexp.read "(tref \"#Int\")")
    []
    ""
    ""
  match adapter e with
  | Option.some (_, core) => Sexp.print core ==
      "(lam (match (var 0) (case (pcon \"#Pair\" 0 (pvar) (pcon \"#Pair\" 0 (pvar) (pvar))) (app (ref \"h\") (var 2) (var 1) (var 0)))))"
  | Option.none => false

end Bindings
