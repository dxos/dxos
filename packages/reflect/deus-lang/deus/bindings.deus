/-
  `deus bindings` (D80): a TypeScript module for a namespace, so TypeScript code can call DEUS
  functions with TypeScript values and answer the abilities they perform. The module embeds an
  image of the exported functions, types every value that crosses, and converts it to and from
  the embedding's JSON encoding (docs/spec/EMBEDDING.md) with generated codecs; it runs on the
  wasm kernel through `deus-runtime.ts`, a copy of src/bindings/runtime.ts. The mapping is in
  docs/spec/BINDINGS.md.
-/

namespace Bindings

/-- An exported function, with the TypeScript shape of everything that crosses for it. -/
structure Export where
  exName : Text
  exIdent : Text
  exHash : Text
  exParams : List (Text, Sexp)
  exResult : Sexp
  exEffects : List (Text, List Sexp)
  exDoc : Text
  exShown : Text

/-- What the generator knows about the codebase: named types and abilities by IRI, TS names by hash. -/
structure Cx where
  cxEntries : Map Text Entry
  cxTypes : Map Text (Text, Text)
  cxAbilities : Map Text (Text, Text)
  cxNames : Map Text Text

def reserved : List Text :=
  ["arguments", "await", "break", "case", "catch", "class", "const", "continue", "debugger", "default", "delete", "do",
    "else", "enum", "eval", "export", "extends", "false", "finally", "for", "function", "if", "implements", "import",
    "in", "instanceof", "interface", "let", "new", "null", "package", "private", "protected", "public", "return",
    "static", "super", "switch", "this", "throw", "true", "try", "typeof", "var", "void", "while", "with", "yield"]

/-- A TypeScript identifier for a DEUS name: other characters become `_`, and keywords take a `_`. -/
def ident (t : Text) : Text :=
  let safe := Text.fromCodes (List.map (fun i =>
    let c := Text.code t i
    if Text.isAlpha c || Text.isDigit c || c == '_' || c == '$' then c else '_') (List.range 0 (Text.length t)))
  let lead := if Text.isEmpty safe || Text.isDigit (Text.code safe 0) then "_" ++ safe else safe
  if List.contains lead reserved then lead ++ "_" else lead

def capitalize (t : Text) : Text :=
  if Text.isEmpty t then t
  else
    let c := Text.code t 0
    if c >= 'a' && c <= 'z' then Text.fromCode (c - 32) ++ Text.drop 1 t else t

/-- TypeScript names of a declaration's type parameters: `a` is `A`. -/
def typeParams (names : List Text) : List Text := List.map (fun n => ident (capitalize n)) names

def quote (t : Text) : Text := "'" ++ Text.replace "'" "\\'" (Text.replace "\\" "\\\\" t) ++ "'"

def isBuiltin (iri : Text) : Bool := Text.startsWith "#" iri

def isTref (iri : Text) (t : Sexp) : Bool :=
  match t with
  | Sexp.list [Sexp.sym "tref", Sexp.str i] => i == iri
  | _ => false

/-- The head IRI and arguments of a type application, or of a plain reference. -/
def applied (t : Sexp) : Option (Text, List Sexp) :=
  match t with
  | Sexp.list [Sexp.sym "tref", Sexp.str iri] => some (iri, [])
  | Sexp.list (Sexp.sym "tapp" :: Sexp.list [Sexp.sym "tref", Sexp.str iri] :: args) => some (iri, args)
  | _ => none

/-- Parameter types, the result type and the effect items of a curried function type. -/
def arrows (t : Sexp) : (List Sexp, Sexp, List Sexp) :=
  match t with
  | Sexp.list [Sexp.sym "tfun", a, b] => withParam a [] (arrows b)
  | Sexp.list [Sexp.sym "tfun", a, b, Sexp.list (Sexp.sym "eff" :: effs)] => withParam a effs (arrows b)
  | Sexp.list [Sexp.sym "teff", Sexp.list (Sexp.sym "eff" :: effs), r] =>
    match arrows r with
    | (ps, result, more) => (ps, result, effs ++ more)
  | _ => ([], t, [])

def withParam (a : Sexp) (effs : List Sexp) (rest : (List Sexp, Sexp, List Sexp)) : (List Sexp, Sexp, List Sexp) :=
  match rest with
  | (ps, result, more) => (a :: ps, result, effs ++ more)

/-- `t` with the declaration's parameters `(tvar i)` replaced by `args`. -/
def instantiate (args : List Sexp) (t : Sexp) : Sexp :=
  match t with
  | Sexp.list [Sexp.sym "tvar", Sexp.int i] => Option.getOr (List.get? args i) t
  | Sexp.list items => Sexp.list (List.map (instantiate args) items)
  | _ => t

/-- Whether a value of `t` can be `undefined` in TypeScript, which `Option` would make ambiguous. -/
def undefinable (t : Sexp) : Bool :=
  match applied t with
  | some (iri, _) => iri == "#Unit" || iri == "#Option"
  | none => false

def userName (cx : Cx) (iri : Text) : {Throw Text} Text :=
  match Map.lookup iri cx.cxTypes with
  | some (h, _) => Option.getOr (Map.lookup h cx.cxNames) (ident iri)
  | none => throw ("type " ++ iri ++ " has no name in the codebase")

/-- The TypeScript type of a DEUS type; `vars` names the enclosing declaration's parameters. -/
def tsType (cx : Cx) (vars : List Text) (t : Sexp) : {Throw Text} Text :=
  match t with
  | Sexp.list [Sexp.sym "tvar", Sexp.int i] =>
    match List.get? vars i with
    | some v => v
    | none => throw ("unknown type parameter " ++ Int.toText i)
  | Sexp.list [Sexp.sym "tvar", Sexp.str v] => throw ("polymorphic in " ++ v ++ "; only monomorphic functions are exported")
  | Sexp.list (Sexp.sym "tfun" :: _) => throw "takes or returns a function"
  | _ =>
    match applied t with
    | some ("#Int", []) => "number"
    | some ("#Text", []) => "string"
    | some ("#Bool", []) => "boolean"
    | some ("#Unit", []) => "void"
    | some ("#List", [x]) => "ReadonlyArray<" ++ tsType cx vars x ++ ">"
    | some ("#Option", [x]) =>
      if undefinable x then throw "an Option of Unit or Option has no unambiguous TypeScript form"
      else tsType cx vars x ++ " | undefined"
    | some ("#Pair", [a, b]) => "readonly [" ++ Text.join ", " (List.map (tsType cx vars) (tupleItems a b)) ++ "]"
    | some (iri, args) =>
      if isBuiltin iri then throw ("no TypeScript form for " ++ iri)
      else userName cx iri ++ generics (List.map (tsType cx vars) args)
    | none => throw ("no TypeScript form for " ++ Sexp.print t)

/-- `(a, (b, c))` flattens to three items, as DEUS writes `(a, b, c)`; longer tuples nest in the last. -/
def tupleItems (a : Sexp) (b : Sexp) : List Sexp :=
  match applied b with
  | some ("#Pair", [c, d]) => [a, c, d]
  | _ => [a, b]

def generics (args : List Text) : Text := if List.isEmpty args then "" else "<" ++ Text.join ", " args ++ ">"

def codecVar (v : Text) : Text := "codec" ++ v

/-- An expression for the codec of `t`; codecs of user types are hoisted functions. -/
def codec (cx : Cx) (vars : List Text) (t : Sexp) : {Throw Text} Text :=
  match t with
  | Sexp.list [Sexp.sym "tvar", Sexp.int i] =>
    match List.get? vars i with
    | some v => codecVar v
    | none => throw ("unknown type parameter " ++ Int.toText i)
  | _ =>
    match applied t with
    | some ("#Int", []) => "rt.int"
    | some ("#Text", []) => "rt.text"
    | some ("#Bool", []) => "rt.bool"
    | some ("#Unit", []) => "rt.unit"
    | some ("#List", [x]) => "rt.list(" ++ codec cx vars x ++ ")"
    | some ("#Option", [x]) => "rt.option(" ++ codec cx vars x ++ ")"
    | some ("#Pair", [a, b]) =>
      let items := List.map (codec cx vars) (tupleItems a b)
      (if List.length items == 3 then "rt.triple(" else "rt.pair(") ++ Text.join ", " items ++ ")"
    | some (iri, args) => userName cx iri ++ "$(" ++ Text.join ", " (List.map (codec cx vars) args) ++ ")"
    | none => throw ("no codec for " ++ Sexp.print t)

/-- User type IRIs mentioned in a type. -/
def iris (t : Sexp) (acc : List Text) : List Text :=
  match t with
  | Sexp.list [Sexp.sym "tref", Sexp.str iri] => if isBuiltin iri || List.contains iri acc then acc else iri :: acc
  | Sexp.list items => List.foldl (fun a x => iris x a) acc items
  | _ => acc

/-- Constructor field types of a type object. -/
def ctors (obj : Sexp) : List (List Sexp) :=
  List.map (fun c => List.drop 1 (Sexp.args c)) (View.typeArgs obj)

/-- Every user type reachable from `roots` through constructor fields, in first-seen order. -/
def typeClosure (cx : Cx) (fetch : Text -> {IO} Option Sexp) (roots : List Text) : {IO, Throw Text} List Text :=
  let rec go work seen :=
    match work with
    | [] => List.reverse seen
    | iri :: rest =>
      if List.contains iri seen then go rest seen
      else
        match Map.lookup iri cx.cxTypes with
        | none => throw ("type " ++ iri ++ " has no name in the codebase")
        | some (h, _) =>
          match fetch h with
          | none => throw ("missing type object " ++ h)
          | some obj => go (rest ++ List.reverse (List.foldl (fun a t => iris t a) [] (List.concat (ctors obj)))) (iri :: seen)
  go roots []

/-- Constructor names of type `h`, by tag. -/
def ctorNames (ns : Map Text Entry) (h : Text) : List (Int, Text) :=
  List.filterMap (fun pair =>
    match pair with
    | (n, Entry.ctor t tag _) => if t == h then some (tag, Names.lastSegment n) else none
    | _ => none) (Map.toList ns)

/-- Field names per constructor: a structure's from its entry, others from metadata; `_i` when unnamed. -/
def fieldNames (cx : Cx) (name : Text) (meta : Option Sexp) (tag : Int) (count : Int) : List Text :=
  let fromEntry := match Map.lookup name cx.cxEntries with
    | some (Entry.type _ _ fields) => if tag == 0 then fields else []
    | _ => []
  let named := if List.length fromEntry == count then fromEntry else Option.getOr (List.get? (View.fieldNamesFor meta) tag) []
  List.map (fun i =>
    match List.get? named i with
    | some n => if Text.isEmpty n then "_" ++ Int.toText i else n
    | none => "_" ++ Int.toText i) (List.range 0 count)

def docComment (indent : Text) (lines : List Text) : Text :=
  match List.filter (fun l => not (Text.isEmpty l)) lines with
  | [] => ""
  | [one] => indent ++ "/** " ++ one ++ " */\n"
  | many => indent ++ "/**\n" ++ Text.concat (List.map (fun l => indent ++ " * " ++ l ++ "\n") many) ++ indent ++ " */\n"

def docOf (meta : Option Sexp) : Text := Option.getOr (Option.map Sexp.asText (Codebase.metaField meta "doc")) ""

/-- The type declaration and the codec function of one user type. -/
def typeDecl (cx : Cx) (fetch : Text -> {IO} Option Sexp) (meta : Text -> {IO} Option Sexp) (iri : Text) : {IO, Throw Text} Text :=
  match Map.lookup iri cx.cxTypes with
  | none => throw ("type " ++ iri ++ " has no name in the codebase")
  | some (h, name) =>
    let obj := Option.getOr (fetch h) (Sexp.list [])
    let m := meta h
    let count := match Sexp.args obj with
      | _ :: Sexp.int n :: _ => n
      | _ => 0
    let vars := typeParams (View.paramsFor m count obj)
    let tsName := userName cx iri
    let full := tsName ++ generics vars
    let shapes := ctors obj
    let names := ctorNames cx.cxEntries h
    let ctorName := fun (tag : Int) => Option.getOr (List.lookup tag names) ("ctor" ++ Int.toText tag)
    let label := quote name
    let header := docComment "" [docOf m, "`" ++ name ++ "` (" ++ iri ++ ")"]
    let codecParams := Text.join ", " (List.map (fun v => codecVar v ++ ": rt.Codec<" ++ v ++ ">") vars)
    let codecHead := "function " ++ tsName ++ "$" ++ generics vars ++ "(" ++ codecParams ++ "): rt.Codec<" ++ full ++ "> {\n  return {\n"
    let decodeHead := "    decode: (json) => {\n      const value = rt.con(json, " ++ label ++ ");\n"
    let make := fun (tag : Int) (fields : List Text) => "rt.make(" ++ quote h ++ ", " ++ Int.toText tag ++ ", [" ++ Text.join ", " fields ++ "])"
    let encodeFields := fun (tag : Int) (types : List Sexp) =>
      List.map (fun pair => codec cx vars (snd pair) ++ ".encode(value." ++ fst pair ++ ")") (List.zip (fieldNames cx name m tag (List.length types)) types)
    let decodeFields := fun (tag : Int) (types : List Sexp) =>
      List.mapIndexed (fun i pair => fst pair ++ ": " ++ codec cx vars (snd pair) ++ ".decode(rt.field(value, " ++ Int.toText i ++ "))") (List.zip (fieldNames cx name m tag (List.length types)) types)
    let badTag := "        default:\n          throw rt.badTag(" ++ label ++ ", value);\n"
    if List.isEmpty shapes then throw ("type " ++ name ++ " has no constructors")
    else if List.all List.isEmpty shapes then
      let literals := List.mapIndexed (fun tag _ => quote (ctorName tag)) shapes
      header ++ "export type " ++ full ++ " = " ++ Text.join " | " literals ++ ";\n\n" ++ codecHead ++
        "    encode: (value) => {\n      switch (value) {\n" ++
        Text.concat (List.mapIndexed (fun tag lit => "        case " ++ lit ++ ":\n          return " ++ make tag [] ++ ";\n") literals) ++
        "      }\n    },\n" ++ decodeHead ++ "      switch (value.tag) {\n" ++
        Text.concat (List.mapIndexed (fun tag lit => "        case " ++ Int.toText tag ++ ":\n          return " ++ lit ++ ";\n") literals) ++
        badTag ++ "      }\n    },\n  };\n}\n"
    else if List.length shapes == 1 then
      let types := Option.getOr (List.head? shapes) []
      let fields := List.map (fun pair => "readonly " ++ fst pair ++ ": " ++ tsType cx vars (snd pair)) (List.zip (fieldNames cx name m 0 (List.length types)) types)
      header ++ "export type " ++ full ++ " = { " ++ Text.join "; " fields ++ " };\n\n" ++ codecHead ++
        "    encode: (value) => " ++ make 0 (encodeFields 0 types) ++ ",\n" ++ decodeHead ++
        "      return { " ++ Text.join ", " (decodeFields 0 types) ++ " };\n    },\n  };\n}\n"
    else
      let variants := List.mapIndexed (fun tag types =>
        let fields := List.map (fun pair => "; readonly " ++ fst pair ++ ": " ++ tsType cx vars (snd pair)) (List.zip (fieldNames cx name m tag (List.length types)) types)
        "  | { readonly $tag: " ++ quote (ctorName tag) ++ Text.concat fields ++ " }") shapes
      header ++ "export type " ++ full ++ " =\n" ++ Text.join "\n" variants ++ ";\n\n" ++ codecHead ++
        "    encode: (value) => {\n      switch (value.$tag) {\n" ++
        Text.concat (List.mapIndexed (fun tag types =>
          "        case " ++ quote (ctorName tag) ++ ":\n          return " ++ make tag (encodeFields tag types) ++ ";\n") shapes) ++
        "      }\n    },\n" ++ decodeHead ++ "      switch (value.tag) {\n" ++
        Text.concat (List.mapIndexed (fun tag types =>
          "        case " ++ Int.toText tag ++ ":\n          return { $tag: " ++ quote (ctorName tag) ++
            Text.concat (List.map (fun f => ", " ++ f) (decodeFields tag types)) ++ " };\n") shapes) ++
        badTag ++ "      }\n    },\n  };\n}\n"

/-- An ability the exported functions perform, with the type arguments they perform it at. -/
def effectOf (t : Sexp) : Option (Text, List Sexp) :=
  match applied t with
  | some (iri, args) => if isBuiltin iri then none else some (iri, args)
  | none => none

/-- Operations of ability `h`, by index, with their names. -/
def opNames (ns : Map Text Entry) (h : Text) : List (Int, Text) :=
  List.filterMap (fun pair =>
    match pair with
    | (n, Entry.op a index _) => if a == h then some (index, Names.lastSegment n) else none
    | _ => none) (Map.toList ns)

def abilityName (cx : Cx) (iri : Text) : {Throw Text} (Text, Text) :=
  match Map.lookup iri cx.cxAbilities with
  | some (h, name) => (h, name)
  | none => throw ("ability " ++ iri ++ " has no name in the codebase")

/-- A handler type and the function that answers the kernel's requests with it. -/
def handlerDecl (cx : Cx) (fetch : Text -> {IO} Option Sexp) (effect : (Text, List Sexp)) : {IO, Throw Text} Text :=
  match effect with
  | (iri, args) =>
    match abilityName cx iri with
    | (h, name) =>
      let short := ident (Names.lastSegment name)
      let ops := List.filter (fun x => Sexp.head x == "op") (Sexp.args (Option.getOr (fetch h) (Sexp.list [])))
      let names := opNames cx.cxEntries h
      let rendered := List.mapIndexed (fun index op =>
        let oname := ident (Option.getOr (List.lookup index names) ("op" ++ Int.toText index))
        let t := instantiate args (Option.getOr (List.last? (Sexp.args op)) (Sexp.list []))
        match arrows t with
        | (params, result, _) =>
          let shown := List.filter (fun p => not (isTref "#Unit" p)) params
          let paramText := Text.join ", " (List.mapIndexed (fun i p => "arg" ++ Int.toText i ++ ": " ++ tsType cx [] p) shown)
          let never := match result with
            | Sexp.list [Sexp.sym "tvar", Sexp.str _] => true
            | _ => false
          let resultText := if never then "never" else tsType cx [] result
          let decoded := List.mapIndexed (fun i p => codec cx [] p ++ ".decode(rt.arg(args, " ++ Int.toText i ++ "))") params
          let passed := List.filterMap (fun pair => if isTref "#Unit" (snd pair) then none else some (fst pair)) (List.zip decoded params)
          let callText := "handler." ++ oname ++ "(" ++ Text.join ", " passed ++ ")"
          let answer := if never then callText else codec cx [] result ++ ".encode(await " ++ callText ++ ")"
          ("  readonly " ++ oname ++ ": (" ++ paramText ++ ") => rt.Awaitable<" ++ resultText ++ ">;",
            "      case " ++ Int.toText index ++ ":\n        return " ++ answer ++ ";\n")) ops
      docComment "" ["Answers `" ++ name ++ "` (" ++ iri ++ ") for the DEUS code."] ++
        "export type " ++ short ++ "Handler = {\n" ++ Text.join "\n" (List.map fst rendered) ++ "\n};\n\n" ++
        "const answer" ++ short ++ " =\n  (handler: " ++ short ++ "Handler): rt.Answer =>\n  async (op, args) => {\n    switch (op) {\n" ++
        Text.concat (List.map snd rendered) ++
        "      default:\n        throw new Error(`" ++ name ++ " has no operation ${op}`);\n    }\n  };\n"

/-- Checks that everything an exported function exchanges has a TypeScript form, and records it. -/
def analyze (cx : Cx) (meta : Text -> {IO} Option Sexp) (fetch : Text -> {IO} Option Sexp) (name : Text) (relative : Text) (h : Text) : {IO, Throw Text} Export :=
  let m := meta h
  let scheme := match Codebase.metaField m "scheme" with
    | some s => s
    | none =>
      match Codebase.metaField m "sig" with
      | some s => s
      | none => throw "has no type"
  match arrows scheme with
  | (types, result, effs) =>
    let _ := List.map (tsType cx []) (result :: types)
    let effects := List.filterMap effectOf effs
    let _ := List.map (fun e => abilityName cx (fst e)) effects
    let _ := List.map (tsType cx []) (List.concatMap snd effects)
    let locals := List.map Sexp.asText (Codebase.metaList m "locals")
    let lams := match fetch h with
      | some (Sexp.list [Sexp.sym "term", core]) => leadingLams core
      | _ => 0
    let paramName := fun (i : Int) =>
      match List.get? locals i with
      | some n => if i < lams && not (Text.isEmpty n) && not (n == "_") then ident n else "arg" ++ Int.toText i
      | none => "arg" ++ Int.toText i
    Export.mk name (ident (Text.replace "." "_" relative)) h (List.mapIndexed (fun i t => (paramName i, t)) types) result effects (docOf m) (Types.displayScheme scheme)

def leadingLams (core : Sexp) : Int :=
  match core with
  | Sexp.list [Sexp.sym "lam", b] => 1 + leadingLams b
  | _ => 0

/--
  The entry an exported function is called through. A function of one parameter is its own
  entry; a constant, or a function of several, gets an adapter that takes the parameters as a
  right-nested pair, because the kernel applies an entry to exactly one value.
-/
def adapter (e : Export) : Option (Text, Sexp) :=
  let n := List.length e.exParams
  let target := Sexp.node "ref" [Sexp.str e.exHash]
  let core := if n == 0 then some (Sexp.node "lam" [target])
    else if n == 1 then none
    else
      let rec pat k := if k == 1 then Sexp.node "pvar" [] else Sexp.node "pcon" [Sexp.str "#Pair", Sexp.int 0, Sexp.node "pvar" [], pat (k - 1)]
      let vars := List.map (fun i => Sexp.node "var" [Sexp.int (n - 1 - i)]) (List.range 0 n)
      some (Sexp.node "lam" [Sexp.node "match" [Sexp.node "var" [Sexp.int 0], Sexp.node "case" [pat n, Sexp.node "app" (target :: vars)]]])
  Option.map (fun c => (Text.sha256 (Sexp.print (Sexp.node "term" [c])), c)) core

def entryOf (e : Export) : Text := Option.getOr (Option.map fst (adapter e)) e.exHash

/-- The image: every exported definition with its closure, plus the adapters, sorted by hash. -/
def image (fetch : Text -> {IO} Option Sexp) (exports : List Export) : {IO, Throw Text} Text :=
  let defs := Image.closure (fun h => fetch h) (List.map (fun e => e.exHash) exports)
  let adapters := List.filterMap adapter exports
  let all := List.sortBy (fun a b => compare (fst a) (fst b)) (defs ++ adapters)
  let main := Option.getOr (Option.map entryOf (List.head? exports)) ""
  Text.join "\n" (List.map Image.defForm all ++ Image.nominalForms (fun h => fetch h) defs ++ [Sexp.print (Sexp.node "main" [Sexp.str main])]) ++ "\n"

/-- The member of the `Bindings` type and of the object `load` returns, for one export. -/
def member (cx : Cx) (e : Export) : {Throw Text} (Text, Text) :=
  let shown := List.filter (fun p => not (isTref "#Unit" (snd p))) e.exParams
  let signature := "(" ++ Text.join ", " (List.map (fun p => fst p ++ ": " ++ tsType cx [] (snd p)) shown) ++ ") => Promise<" ++ tsType cx [] e.exResult ++ ">"
  let encoded := List.map (fun p => if isTref "#Unit" (snd p) then "null" else codec cx [] (snd p) ++ ".encode(" ++ fst p ++ ")") e.exParams
  let argument := match encoded with
    | [] => "null"
    | [one] => one
    | many => "rt.args([" ++ Text.join ", " many ++ "])"
  let call := "await module.call(" ++ quote (entryOf e) ++ ", " ++ argument ++ ")"
  (docComment "  " (Text.lines e.exDoc ++ ["", "`" ++ e.exName ++ " : " ++ e.exShown ++ "`"]) ++ "  readonly " ++ e.exIdent ++ ": " ++ signature ++ ";",
    "    " ++ e.exIdent ++ ": async (" ++ Text.join ", " (List.map fst shown) ++ ") => " ++ codec cx [] e.exResult ++ ".decode(" ++ call ++ "),")

/-- Whether `name` is selected by one of the requested prefixes, and its name relative to it. -/
def relativeName (prefixes : List Text) (name : Text) : Option Text :=
  List.foldl (fun acc p =>
    match acc with
    | some _ => acc
    | none =>
      if name == p then some (Names.lastSegment name)
      else if Text.startsWith (p ++ ".") name then some (Text.drop (Text.length p + 1) name)
      else none) none prefixes

def isField (ns : Map Text Entry) (name : Text) : Bool :=
  let segments := Text.split name "."
  let owner := Text.join "." (List.take (List.length segments - 1) segments)
  match Map.lookup owner ns with
  | some (Entry.type _ _ fields) => List.contains (Names.lastSegment name) fields
  | _ => false

/-- TypeScript names for user types: the last segment, or the whole name where two would clash. -/
def typeNames (ns : Map Text Entry) : Map Text Text :=
  let types := List.filterMap (fun pair =>
    match pair with
    | (n, Entry.type h _ _) => some (h, n)
    | _ => none) (Map.toList ns)
  let short := fun (n : Text) => ident (Names.lastSegment n)
  let clashes := fun (n : Text) => List.length (List.filter (fun p => short (snd p) == short n) types) > 1
  List.foldl (fun m pair =>
    match pair with
    | (h, n) => if Map.contains h m then m else Map.insert h (if clashes n then ident (Text.replace "." "_" n) else short n) m) Map.empty types

def context (ns : Map Text Entry) : Cx :=
  let types := List.foldl (fun m pair =>
    match pair with
    | (n, Entry.type h iri _) => if Map.contains iri m then m else Map.insert iri (h, n) m
    | _ => m) Map.empty (Map.toList ns)
  let abilities := List.foldl (fun m pair =>
    match pair with
    | (n, Entry.ability h iri) => if Map.contains iri m then m else Map.insert iri (h, n) m
    | _ => m) Map.empty (Map.toList ns)
  Cx.mk ns types abilities (typeNames ns)

/-- Exports and skipped names with reasons; an ability performed at two different types skips the later function. -/
def select (cx : Cx) (meta : Text -> {IO} Option Sexp) (fetch : Text -> {IO} Option Sexp) (prefixes : List Text) : {IO} (List Export, List (Text, Text)) :=
  let candidates := List.filterMap (fun pair =>
    match pair with
    | (n, Entry.term h) =>
      if isField cx.cxEntries n then none else Option.map (fun rel => (n, rel, h)) (relativeName prefixes n)
    | _ => none) (Map.toList cx.cxEntries)
  let step := fun (acc : (List Export, List (Text, Text), Map Text (List Sexp))) (c : (Text, Text, Text)) =>
    match (acc, c) with
    | ((kept, skipped, used), (n, rel, h)) =>
      match try (fun _ => analyze cx meta fetch n rel h) with
      | Result.err reason => (kept, (n, reason) :: skipped, used)
      | Result.ok e =>
        let clash := List.find (fun x => x.exIdent == e.exIdent) kept
        let conflict := List.find (fun eff =>
          match Map.lookup (fst eff) used with
          | some args => not (args == snd eff)
          | none => false) e.exEffects
        match (clash, conflict) with
        | (some other, _) => (kept, (n, "its TypeScript name " ++ e.exIdent ++ " is taken by " ++ other.exName) :: skipped, used)
        | (_, some eff) => (kept, (n, "performs " ++ fst eff ++ " at a different type than an earlier function") :: skipped, used)
        | (none, none) => (e :: kept, skipped, List.foldl (fun m eff => Map.insert (fst eff) (snd eff) m) used e.exEffects)
  match List.foldl step ([], [], Map.empty) candidates with
  | (kept, skipped, _) => (List.reverse kept, List.reverse skipped)

/-- The module text for the selected exports. -/
def module (cx : Cx) (fetch : Text -> {IO} Option Sexp) (meta : Text -> {IO} Option Sexp) (command : Text) (exports : List Export) (skipped : List (Text, Text)) : {IO, Throw Text} Text :=
  let effects := List.foldl (fun acc e => List.foldl (fun a eff => if List.any (fun x => fst x == fst eff) a then a else a ++ [eff]) acc e.exEffects) [] exports
  let roots := List.foldl (fun acc t => iris t acc) [] (List.concatMap (fun e => e.exResult :: List.map snd e.exParams) exports ++
    List.concatMap (fun eff =>
      match abilityName cx (fst eff) with
      | (h, _) => List.map (instantiate (snd eff)) (List.map (fun op => Option.getOr (List.last? (Sexp.args op)) (Sexp.list [])) (List.filter (fun x => Sexp.head x == "op") (Sexp.args (Option.getOr (fetch h) (Sexp.list []))))) ++ snd eff) effects)
  let types := typeClosure cx fetch (List.reverse roots)
  let typeText := List.map (typeDecl cx fetch meta) types
  let handlerText := List.map (handlerDecl cx fetch) effects
  let handlerFields := List.map (fun eff =>
    match abilityName cx (fst eff) with
    | (_, name) => "  readonly " ++ ident (Names.lastSegment name) ++ ": " ++ ident (Names.lastSegment name) ++ "Handler;") effects
  let members := List.map (member cx) exports
  let abilityEntries := List.concatMap (fun eff =>
    match abilityName cx (fst eff) with
    | (h, name) =>
      let answer := "answer" ++ ident (Names.lastSegment name) ++ "(handlers." ++ ident (Names.lastSegment name) ++ ")"
      ["      [" ++ quote (fst eff) ++ ", " ++ answer ++ "],", "      [" ++ quote h ++ ", " ++ answer ++ "],"]) effects
  let handlersParam := if List.isEmpty effects then "_handlers: Handlers = {}" else "handlers: Handlers"
  let skippedText := if List.isEmpty skipped then ""
    else "//\n// Not exported:\n" ++ Text.concat (List.map (fun s => "//   " ++ fst s ++ ": " ++ snd s ++ "\n") skipped)
  Text.join "\n" [
    "// Generated by `" ++ command ++ "`; regenerate rather than edit.",
    "// The functions run on the embeddable DEUS kernel (docs/spec/EMBEDDING.md) through ./deus-runtime.ts;",
    "// values cross as the embedding's JSON and are converted by the codecs below (docs/spec/BINDINGS.md).",
    skippedText,
    "import * as rt from './deus-runtime.ts';",
    "",
    "export { DeusDecodeError, DeusDefect, type IoHost } from './deus-runtime.ts';",
    "",
    Text.join "\n" typeText,
    Text.join "\n" handlerText,
    "/** Answers for the abilities the exported functions perform and do not handle themselves. */",
    if List.isEmpty effects then "export type Handlers = Record<string, never>;\n" else "export type Handlers = {\n" ++ Text.join "\n" handlerFields ++ "\n};\n",
    "export type Bindings = {",
    Text.join "\n" (List.map fst members),
    "};",
    "",
    "const IMAGE = " ++ Json.escape (image fetch exports) ++ ";",
    "",
    "/** Loads the kernel (`deus_kernel.wasm`'s bytes or a compiled module) with the exported functions. */",
    "export const load = async (",
    "  wasm: BufferSource | WebAssembly.Module,",
    "  " ++ handlersParam ++ ",",
    "  io: rt.IoHost = {},",
    "): Promise<Bindings> => {",
    "  const module = await rt.loadModule({",
    "    wasm,",
    "    image: IMAGE,",
    "    io,",
    "    abilities: new Map<string, rt.Answer>([",
    Text.join "\n" abilityEntries,
    "    ]),",
    "  });",
    "  return {",
    Text.join "\n" (List.map snd members),
    "  };",
    "};",
    ""]

/-- Generates the module for `prefixes`; returns its text, the exported names and the skipped ones. -/
def generate (dir : Text) (prefixes : List Text) (command : Text) : {IO, Throw Text} (Text, List Text, List (Text, Text)) :=
  let ns := Codebase.current dir
  let cx := context ns
  let fetch := fun (h : Text) => Codebase.readObject dir h
  let meta := fun (h : Text) => Codebase.readMeta dir h
  match select cx meta fetch prefixes with
  | (exports, skipped) =>
    if List.isEmpty exports then throw ("nothing to export under " ++ Text.join ", " prefixes ++ Text.concat (List.map (fun s => "\n  " ++ fst s ++ ": " ++ snd s) skipped))
    else (module cx fetch meta command exports skipped, List.map (fun e => e.exName) exports, skipped)

test identKeepsNames := ident "area" == "area" && ident "head?" == "head_" && ident "default" == "default_" && ident "2d" == "_2d"

test arrowsSplitsCurriedTypes :=
  match arrows (Sexp.read "(tfun (tref \"#Int\") (tfun (tref \"#Text\") (tref \"#Bool\") (eff (tref \"urn:x:Log\"))) (eff (tvar \"r\")))") with
  | (params, result, effs) => List.length params == 2 && isTref "#Bool" result && List.length effs == 2

test adapterTakesNestedPairs :=
  let e := Export.mk "f" "f" "h" [("a", Sexp.read "(tref \"#Int\")"), ("b", Sexp.read "(tref \"#Int\")"), ("c", Sexp.read "(tref \"#Int\")")] (Sexp.read "(tref \"#Int\")") [] "" ""
  match adapter e with
  | some (_, core) => Sexp.print core == "(lam (match (var 0) (case (pcon \"#Pair\" 0 (pvar) (pcon \"#Pair\" 0 (pvar) (pvar))) (app (ref \"h\") (var 2) (var 1) (var 0)))))"
  | none => false

end Bindings
