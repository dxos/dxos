/-
  Surface syntax tree produced by the parser and consumed by the resolver.
  Constructor names avoid keywords (`let`, `if`, `match`…), hence `letPat`, `ite`, `matchOn`.
-/

structure Pos where
  atLine : Int
  atCol : Int

inductive Ty where
  | named (name : Text) (args : List Ty)
  | arrow (from : Ty) (to : Ty) (effects : Option (List Ty))
  | tuple (items : List Ty)
  | unit
  | effects (row : List Ty) (result : Ty)
  -- A row as a type argument, for a type with a row parameter: `Box {IO | r}`.
  | row (items : List Ty)

inductive Pat where
  | wild
  | id (name : Text) (args : List Pat) (pos : Pos)
  | dot (name : Text) (args : List Pat) (pos : Pos)
  | int (value : Int)
  | text (value : Text)
  | bool (value : Bool)
  | cons (head : Pat) (tail : Pat)
  | tuple (items : List Pat)
  | list (items : List Pat)
  | unit
  | as (name : Text) (pat : Pat)
  -- A number literal as the source wrote it (`'a'`, `0xFF`); metadata, never Core (D86).
  | spelled (text : Text) (pat : Pat)

inductive Expr where
  | var (name : Text) (pos : Pos)
  | dot (name : Text) (pos : Pos)
  | int (value : Int)
  | text (value : Text)
  | bool (value : Bool)
  | unit
  | app (f : Expr) (args : List Expr)
  | lam (params : List Pat) (body : Expr)
  | lamMatch (arms : List Arm)
  | letPat (pat : Pat) (value : Expr) (body : Expr)
  | letFun (name : Text) (params : List Pat) (value : Expr) (body : Expr) (isRec : Bool)
  | seq (first : Expr) (rest : Expr)
  | ite (cond : Expr) (yes : Expr) (no : Expr)
  | matchOn (scruts : List Expr) (arms : List Arm)
  | handleWith (body : Expr) (ret : Option (Pat, Expr)) (ops : List OpArm)
  | binop (op : Text) (left : Expr) (right : Expr) (pos : Pos)
  | neg (e : Expr)
  | not (e : Expr)
  | tuple (items : List Expr)
  | list (items : List Expr)
  | prim (name : Text)
  | record (base : Option Expr) (fields : List (Text, Expr)) (pos : Pos)
  | ann (e : Expr) (type : Ty)
  | proj (e : Expr) (field : Text) (pos : Pos)
  -- Comments written before a statement or an arm; they become metadata, never Core (D66).
  | note (text : Text) (e : Expr)
  -- A number literal as the source wrote it (`'a'`, `0xFF`); metadata, never Core (D86).
  | spelled (text : Text) (e : Expr)

/-- One `| p, q => body` arm. -/
structure Arm where
  pats : List Pat
  body : Expr

/-- One `| op args -> k => body` handler clause. -/
structure OpArm where
  op : Text
  args : List Pat
  resume : Option Text
  clause : Expr
  at : Pos

structure Binder where
  binder : Text
  annot : Option Ty

structure Attr where
  attr : Text
  values : List Text

inductive Decl where
  | defn (name : Text) (binders : List Binder) (type : Option Ty) (body : Option Expr) (arms : Option (List Arm)) (doc : Option Text) (attrs : List Attr) (pos : Pos)
  | thm (name : Text) (binders : List Binder) (prop : Expr) (proof : List Text) (doc : Option Text) (attrs : List Attr) (pos : Pos)
  | check (name : Text) (body : Expr) (doc : Option Text) (attrs : List Attr) (pos : Pos)
  | data (name : Text) (params : List Text) (iri : Option Text) (ctors : List (Text, List (Text, Ty))) (doc : Option Text) (pos : Pos)
  | record (name : Text) (params : List Text) (iri : Option Text) (fields : List (Text, Ty)) (doc : Option Text) (pos : Pos)
  | effect (name : Text) (params : List Text) (iri : Option Text) (ops : List (Text, Ty)) (doc : Option Text) (pos : Pos)
  | ns (name : Text)
  | endNs (name : Option Text)
  | openNs (names : List Text)
  -- Comments before a declaration, kept as the next declaration's `lead` metadata (D66).
  | comment (text : Text)
