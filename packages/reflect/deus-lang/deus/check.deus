/-
  Tests and theorems.

  A test is a `Bool` expression. A theorem is a proposition over typed binders plus the
  evidence its author claims (docs/DECISIONS.md D13):

    sorry       stated, not checked
    by rfl      no binders; the proposition evaluates to `true`
    by decide   every value of finite binder types is checked
    by test n   n generated cases pass (seeded by the theorem's hash, so reruns are identical)

  Results are cached under the hash of what was checked: unchanged code is never rechecked.
  A defect inside a test or a theorem is caught at this boundary and reported as a failure.
-/

/-- The outcome of checking one test or theorem. -/
inductive Verdict where
  | pass (evidence : Text) (cases : Int)
  | fail (reason : Text)
  | unchecked

namespace Check

def toSexp : Verdict -> Sexp
  | Verdict.pass evidence cases => Sexp.node "pass" [Sexp.str evidence, Sexp.int cases]
  | Verdict.fail reason => Sexp.node "fail" [Sexp.str reason]
  | Verdict.unchecked => Sexp.node "unchecked" []

def fromSexp (s : Sexp) : Verdict :=
  match s with
  | Sexp.list (Sexp.sym "pass" :: Sexp.str evidence :: Sexp.int cases :: _) => Verdict.pass evidence cases
  | Sexp.list (Sexp.sym "fail" :: Sexp.str reason :: _) => Verdict.fail reason
  | _ => Verdict.unchecked

/--
  The checker that produces verdicts now: the first 16 hex digits of the toolchain image's hash, which the
  launcher sets (`bin/deus.mjs`), or "" when unknown. A theorem's verdict depends on the prover, which its own
  hash does not cover, so a verdict kept by another checker is checked again (task 79f72c44, Prove.Spec R-8).
-/
def checkerId (u : Unit) : {IO} Text := Text.take 16 (Option.getOr (IO.getEnv "DEUS_IMAGE_HASH") "")

/-- The checker a kept verdict names, or "" for one kept before verdicts named it. -/
def checkerOf (s : Sexp) : Text :=
  Option.getOr (List.head? (List.filterMap (fun item =>
    match item with
    | Sexp.list [Sexp.sym "checker", Sexp.str id] => Option.some id
    | _ => Option.none) (Sexp.args s))) ""

/-- A theorem's kept verdict, when the checker that kept it is the one running, or either is unknown. -/
def cachedTheorem (dir : Text) (h : Text) : {IO} Option Verdict :=
  match IO.readFile (dir ++ "/results/" ++ h) with
  | Option.none => Option.none
  | Option.some text =>
      let s := Sexp.read text
      let now := checkerId ()
      let kept := checkerOf s
      -- A verdict kept before verdicts named their checker counts as another checker's.
      if Text.isEmpty now || kept == now then Option.some (fromSexp s) else Option.none

/-- Keeps a theorem's verdict with the checker that reached it. -/
def rememberTheorem (dir : Text) (h : Text) (v : Verdict) : {IO} Unit :=
  match v with
  | Verdict.unchecked => ()
  | _ =>
      let checker := checkerId ()
      let form := if Text.isEmpty checker then Check.toSexp v else Sexp.list (Sexp.asList (Check.toSexp v) ++ [Sexp.node "checker" [Sexp.str checker]])
      IO.writeFile (dir ++ "/results/" ++ h) (Sexp.print form ++ "\n")

def cached (dir : Text) (h : Text) : {IO} Option Verdict :=
  Option.map (fun t => fromSexp (Sexp.read t)) (IO.readFile (dir ++ "/results/" ++ h))

def remember (dir : Text) (h : Text) (v : Verdict) : {IO} Unit :=
  match v with
  | Verdict.unchecked => ()
  | _ => IO.writeFile (dir ++ "/results/" ++ h) (Sexp.print (Check.toSexp v) ++ "\n")

/-- Runs a loaded definition; a defect becomes `Result.err`. -/
def guarded (h : Text) : Result Text a :=
  handle Result.ok (Code.run h) with
  | Defect.raise message -> _ => Result.err (message ++ Cli.defectTrace ())
  -- A test that throws fails with its message; uncaught, it ended the whole run.
  | Throw.throw message -> _ => Result.err ("threw " ++ message)

/-- Evaluates a Core term (built by the checker) in the running machine. -/
def evalCore (core : Sexp) : Result Text a :=
  let h := "check:" ++ Text.sha256 (Sexp.print core)
  if Code.has h then guarded h else
    Code.load (Sexp.print (Sexp.node "def" [Sexp.str h, core]))
    guarded h

--
-- Generators: values of a binder type, as Core terms.
--

/-- A deterministic generator: xorshift over a 32-bit state. -/
def nextRandom (state : Ref Int) : Int :=
  let x1 := Ref.get state
  let x2 := Int.xor x1 (Int.shl x1 13)
  let x3 := Int.xor x2 (Int.ushr x2 17)
  let x4 := Int.xor x3 (Int.shl x3 5)
  Ref.set state x4
  x4

def below (state : Ref Int) (n : Int) : Int :=
  let r := Int.and (nextRandom state) 2147483647
  if n <= 0 then 0 else r % n

def seedOf (h : Text) : Int :=
  match Int.fromText (Text.join "" (List.map (fun c => Int.toText (Int.and c 7)) (List.take 9 (Text.utf8 h)))) with
  | some v => if v == 0 then 1 else v
  | none => 1

/-- Type declarations by IRI, for generating values of user types. -/
def typesByIri (dir : Text) (ns : Map Text Entry) : {IO} Map Text Sexp :=
  List.foldl (fun m pair =>
    match snd pair with
    | Entry.type h iri _ =>
      match Codebase.readObject dir h with
      | some obj => Map.insert iri obj m
      | none => m
    | _ => m) Map.empty (Map.toList ns)

def substVars (t : Sexp) (args : List Sexp) : Sexp :=
  match t with
  | Sexp.list [Sexp.sym "tvar", Sexp.int i] => Option.getOr (List.get? args i) t
  | Sexp.list items => Sexp.list (List.map (fun x => substVars x args) items)
  | _ => t

def headAndArgs (t : Sexp) : (Sexp, List Sexp) :=
  match t with
  | Sexp.list (Sexp.sym "tapp" :: f :: args) => (f, args)
  | _ => (t, [])

def con (hash : Text) (tag : Int) (fields : List Sexp) : Sexp :=
  let c := Sexp.node "con" [Sexp.str hash, Sexp.int tag, Sexp.int (List.length fields)]
  if List.isEmpty fields then c else Sexp.list (Sexp.sym "app" :: c :: fields)

def alphabet : List Text := ["a", "b", "z", " ", "0", "\n", "é", "-", "\""]

def interestingInts : List Int := [0, 1, -1, 2, 7, -100, 2147483647, -2147483648]

/-- One random value of a type, as Core; `depth` bounds recursive types. -/
def generate (types : Map Text Sexp) (state : Ref Int) (t : Sexp) (depth : Int) : Sexp :=
  match headAndArgs t with
  | (Sexp.list (Sexp.sym "tref" :: Sexp.str iri :: []), args) => if iri == "#Int" then
      let k := below state 4
      let v := if k == 0 then getOr (get? interestingInts (below state 8)) 0 else if k == 1 then nextRandom state else below state 41 - 20
      Sexp.node "int" [Sexp.int v]
    else if iri == "#Text" then Sexp.node
      "text"
      [Sexp.str (Text.concat (List.map (fun _ => getOr (get? alphabet (below state 9)) "a") (range 0 (below state 6))))] else if iri == "#Bool" then Check.con "#Bool" (below state 2) [] else if iri == "#Unit" then Check.con "#Unit" 0 [] else if iri == "#List" then
      let elem := getOr (head? args) (Sexp.node "tref" [Sexp.str "#Int"])
      let count := if depth <= 0 then 0 else below state 6
      foldl
        (fun acc _ => Check.con "#List" 1 [Check.generate types state elem (depth - 1), acc])
        (Check.con "#List" 0 [])
        (range 0 count)
    else if iri == "#Option" then if below state 3 == 0 || depth <= 0 then Check.con "#Option" 0 [] else Check.con
      "#Option"
      1
      [Check.generate
        types
        state
        (getOr (head? args) (Sexp.node "tref" [Sexp.str "#Int"]))
        (depth - 1)] else if iri == "#Array" then
      -- `Array.make` then one `Array.set` per index, so each item is drawn on its own.
      let elem := getOr (head? args) (Sexp.node "tref" [Sexp.str "#Int"])
      let count := if depth <= 0 then 0 else below state 6
      let applyPrim := fun p xs => Sexp.list (Sexp.sym "app" :: Sexp.node "prim" [Sexp.str p] :: xs)
      let made := applyPrim
        "Array.make"
        [Sexp.node "int" [Sexp.int count], Check.generate types state elem (depth - 1)]
      foldl (fun acc i => applyPrim
        "Array.set"
        [acc, Sexp.node "int" [Sexp.int i], Check.generate types state elem (depth - 1)]) made (range 0 count)
    else if iri == "#Pair" then
      match args with
      | a :: b :: [] => Check.con "#Pair" 0 [Check.generate types state a depth, Check.generate types state b depth]
      | _ => Check.con "#Unit" 0 []
    else
      match Map.lookup iri types with
      | Option.some decl =>
          let hash := hashFor iri decl
          let ctors := View.typeArgs decl
          let nullary := List.filter
            (fun pair => List.length (Sexp.args (snd pair)) == 1)
            (mapIndexed (fun i c => (i, c)) ctors)
          let pool := if depth <= 0 && not (List.isEmpty nullary) then nullary else mapIndexed (fun i c => (i, c)) ctors
          match get? pool (below state (List.length pool)) with
          | Option.some (tag, c) => Check.con hash tag (List.map
              (fun ft => Check.generate types state (substVars ft args) (depth - 1))
              (List.drop 1 (Sexp.args c)))
          | Option.none => defect ("cannot generate a value of " ++ iri)
      | Option.none => defect ("cannot generate a value of " ++ iri)
  | _ => defect ("cannot generate a value of type " ++ Sexp.print t)

/-- Every value of a finite type, or `none` if the type is infinite or too large. -/
def enumerate (types : Map Text Sexp) (t : Sexp) : Option (List Sexp) :=
  match headAndArgs t with
  | (Sexp.list (Sexp.sym "tref" :: Sexp.str iri :: []), args) => if iri == "#Bool" then Option.some [Check.con "#Bool" 0 [], Check.con "#Bool" 1 []] else if iri == "#Unit" then Option.some [Check.con "#Unit" 0 []] else if iri == "#Option" then Option.map
      (fun vs => Check.con "#Option" 0 [] :: List.map (fun v => Check.con "#Option" 1 [v]) vs)
      (Option.bind (head? args) (fun a => Check.enumerate types a)) else if iri == "#Pair" then
      match args with
      | a :: b :: [] => Option.bind (Check.enumerate types a) (fun xs => Option.map
          (fun ys => concatMap (fun x => List.map (fun y => Check.con "#Pair" 0 [x, y]) ys) xs)
          (Check.enumerate types b))
      | _ => Option.none
    else
      match Map.lookup iri types with
      | Option.some decl =>
          let ctors := View.typeArgs decl
          if List.all (fun c => List.length (Sexp.args c) == 1) ctors then
            let hash := hashFor iri decl
            Option.some (mapIndexed (fun i _ => Check.con hash i []) ctors)
          else Option.none
      | Option.none => Option.none
  | _ => Option.none

/-- Every combination of the binders' values. -/
def product (domains : List (List Sexp)) : List (List Sexp) :=
  match domains with
  | [] => [[]]
  | d :: rest => List.concatMap (fun v => List.map (fun vs => v :: vs) (product rest)) d

def caseCore (prop : Sexp) (args : List Sexp) : Sexp :=
  if List.isEmpty args then prop else Sexp.list (Sexp.sym "app" :: prop :: args)

/-- The proof tokens after `using`, or none. -/
def afterUsing (tokens : List Sexp) : List Sexp :=
  match tokens with
  | [] => []
  | t :: rest => if t == Sexp.str "using" then rest else afterUsing rest

/-- Checks cases in order; the first failing one is the counterexample. -/
def runCases (prop : Sexp) (cases : List (List Sexp)) (describe : List Sexp -> Text) : Option Text :=
  match cases with
  | [] => Option.none
  | args :: rest =>
      match Check.evalCore (caseCore prop args) with
      | Result.ok true => Check.runCases prop rest describe
      | Result.ok _ => Option.some (if List.isEmpty args then "false" else "counterexample: " ++ describe args)
      | Result.err message => Option.some ("defect " ++ show message ++ (if List.isEmpty args then "" else " at " ++ describe args))

def checkTheorem (dir : Text) (ns : Map Text Entry) (h : Text) (obj : Sexp) : {IO} Verdict :=
  match obj with
  | Sexp.list (Sexp.sym "theorem" :: Sexp.list (Sexp.sym "binders" :: types) :: prop :: proof :: _) =>
      let tactic := List.map (fun x =>
        match x with
        | Sexp.list (Sexp.sym "ref" :: Sexp.str l :: []) => "#" ++ l
        | _ => asText x) (Sexp.args proof)
      -- Only a failure is described, so the printer's name tables are not built for a theorem that passes.
      let describe := fun args =>
        let printer := Print.printer ns []
        join ", " (List.map (fun a => Print.expr printer a [] 0 100) args)
      let typeDecls := typesByIri dir ns
      match tactic with
      | "sorry" :: [] => Verdict.unchecked
      | "rfl" :: [] => if not (List.isEmpty types) then Verdict.fail "rfl needs a closed proposition (no binders); use decide or test" else
          match runCases prop [[]] describe with
          | Option.none => Verdict.pass "rfl" 1
          | Option.some reason => Verdict.fail reason
      | "decide" :: [] =>
          let domains := List.map (fun t => enumerate typeDecls t) types
          if any isNone domains then Verdict.fail "decide needs finite binder types; use test" else
            let cases := product (List.map (fun d => getOr d []) domains)
            match runCases prop cases describe with
            | Option.none => Verdict.pass "decide" (List.length cases)
            | Option.some reason => Verdict.fail reason
      | "test" :: rest =>
          let count := getOr (Option.bind (head? rest) fromText) 100
          let state := Ref.new (seedOf h)
          -- `using g …` draws each binder's case as `g` applied to a random Int (D135).
          let generators := filterMap (fun x =>
            match x with
            | Sexp.list (Sexp.sym "ref" :: Sexp.str g :: []) => Option.some g
            | _ => Option.none) (afterUsing (Sexp.args proof))
          if not (List.isEmpty generators) && List.length generators != List.length types then Verdict.fail ("using names " ++ Int.toText (List.length generators) ++ " generators for " ++
            Int.toText (List.length types) ++ " binders") else
            -- The image of a theorem is its proposition, so the generators it names load here.
            match try (fun _ => Image.load (fun x => readObject dir x) generators) with
            | Result.err message => Verdict.fail message
            | Result.ok _ => testCases prop types generators count state typeDecls describe
      | _ =>
          -- A tactic proof. Binder names come from metadata (the author's names, in order).
          let locals := List.map asText (metaList (readMeta dir h) "locals")
          let names := mapIndexed (fun i _ => getOr (get? locals i) ("x" ++ Int.toText i)) types
          let pr := Prover.mk
            dir
            ns
            (Ref.new Map.empty)
            (Ref.new 20000)
            (Ref.new [])
            (Ref.new 0)
            (Ref.new [])
            (Ref.new [])
          -- Lemmas must be checked first; one that is only tested weakens this verdict.
          let lemmas := filterMap (fun x =>
            match x with
            | Sexp.list (Sexp.sym "ref" :: Sexp.str l :: []) => Option.some l
            | _ => Option.none) (Sexp.args proof)
          let weak := List.filter (fun l =>
            match lemmaVerdict dir ns l with
            | Verdict.pass evidence _ => evidence == "test"
            | _ => true) lemmas
          if any (fun l =>
            match lemmaVerdict dir ns l with
            | Verdict.fail _ => true
            | _ => false) lemmas then Verdict.fail "a lemma it uses does not hold" else
            match proveTheorem pr names types prop (Sexp.args proof) with
            | Result.ok used => Verdict.pass (if List.isEmpty weak then "proof" else "proof assuming tested lemmas") 1
            | Result.err reason => Verdict.fail reason
  | _ => Verdict.fail "not a theorem"

/-- Runs `count` cases, each binder drawn from its generator, or by its type when `generators` is empty. -/
def testCases (prop : Sexp) (types : List Sexp) (generators : List Text) (count : Int) (state : Ref Int) (typeDecls : Map Text Sexp) (describe : List Sexp -> Text) : Verdict :=
  let draw := fun t g =>
    match g with
    | Option.some ref => Sexp.list [Sexp.sym "app", Sexp.node "ref" [Sexp.str ref], Sexp.node "int" [Sexp.int (nextRandom state)]]
    | Option.none => Check.generate typeDecls state t 4
  let drawn := List.map (fun _ => mapIndexed (fun i t => draw t (get? generators i)) types) (range 0 count)
  -- `implies` is strict, so a case that fails a hypothesis is skipped; one whose hypothesis defects still runs, and reports it.
  let hypotheses := List.map (fun hyp => withBody prop hyp) (hypothesesOf (bodyOf prop))
  let cases := List.filter
    (fun args => not (any (fun hyp => Check.evalCore (caseCore hyp args) == Result.ok false) hypotheses))
    drawn
  if List.isEmpty cases && count > 0 then Verdict.fail ("no case of " ++ Int.toText count ++ " met the hypotheses") else
    match runCases prop cases describe with
    | Option.none => Verdict.pass "test" (List.length cases)
    | Option.some reason => Verdict.fail reason

/-- A proposition's body under its binders. -/
def bodyOf (prop : Sexp) : Sexp :=
  match prop with
  | Sexp.list [Sexp.sym "lam", body] => bodyOf body
  | _ => prop

/-- `prop` with its body under the binders replaced by `body`. -/
def withBody (prop : Sexp) (body : Sexp) : Sexp :=
  match prop with
  | Sexp.list [Sexp.sym "lam", inner] => Sexp.list [Sexp.sym "lam", withBody inner body]
  | _ => body

/-- The hypotheses of `H1 -> H2 -> C`, in order. -/
def hypothesesOf (body : Sexp) : List Sexp :=
  match body with
  | Sexp.list [Sexp.sym "app", Sexp.list [Sexp.sym "prim", Sexp.str "implies"], hyp, rest] => hyp :: hypothesesOf rest
  | _ => []

/-- A `@[refuted]` theorem's verdict from the prover's: it passes when the prover refuses it, as a probe of
  the prover's soundness, and fails when the prover accepts it. -/
def refutedVerdict (v : Verdict) : Verdict :=
  match v with
  | Verdict.fail _ => Verdict.pass "refused" 0
  | Verdict.pass evidence _ => Verdict.fail ("proved (" ++ evidence ++ "), but it is @[refuted]: the prover accepts a claim it must refuse")
  | Verdict.unchecked => Verdict.unchecked

/-- A lemma's verdict, checking (and caching) it first if needed; a `@[refuted]` claim is never one. -/
def lemmaVerdict (dir : Text) (ns : Map Text Entry) (h : Text) : {IO} Verdict := if hasAttr dir h "refuted" then Verdict.fail "it is @[refuted], a claim the prover must refuse" else
  match cachedTheorem dir h with
  | Option.some v => v
  | Option.none =>
      match readObject dir h with
      | Option.some obj =>
          match try (fun _ => Image.load (fun x => readObject dir x) [h]) with
          | Result.err message => Verdict.fail message
          | Result.ok _ =>
              let v := checkTheorem dir ns h obj
              rememberTheorem dir h v
              v
      | Option.none => Verdict.fail "missing lemma"

/-- A test, by default in a deterministic simulation seeded from its hash; integration tests run for real. -/
def checkTest (h : Text) (integration : Bool) : {IO} Verdict :=
  let outcome := if integration then fst (Observe.collect (fun _ => guarded h))
    else
      match Sim.run (seedOf h) (fun _ => fst (Observe.collect (fun _ => guarded h))) with
      | (r, _) => r
  match outcome with
  | Result.ok true => Verdict.pass (if integration then "integration" else "test") 1
  | Result.ok _ => Verdict.fail "returned false"
  | Result.err message => Verdict.fail (if Text.startsWith "threw " message then message else "defect: " ++ message)

/-- Whether a definition carries an attribute, e.g. `@[integration]`. -/
def hasAttr (dir : Text) (h : Text) (name : Text) : {IO} Bool :=
  List.any (fun a => Sexp.head a == name || (match a with
    | Sexp.list (Sexp.str n :: _) => n == name
    | _ => false)) (Codebase.metaList (Codebase.readMeta dir h) "attrs")

/-- A test's or a theorem's verdict, from the cache or checked now and cached; `none` for other entries. -/
def verdictOf (dir : Text) (ns : Map Text Entry) (e : Entry) : {IO} Option Verdict :=
  match e with
  | Entry.theorem h => Option.some (lemmaVerdict dir ns h)
  | Entry.test h =>
      let integration := hasAttr dir h "integration"
      match if integration then Option.none else Check.cached dir h with
      | Option.some v => Option.some v
      | Option.none =>
          let v :=
            match try (fun _ => Image.load (fetcher dir) [h]) with
            | Result.err message => Verdict.fail message
            | Result.ok _ => checkTest h integration
          if integration then () else remember dir h v
          Option.some v
  | _ => Option.none

/-- A test's verdict, with a failure the native interpreter reached run again on the reference kernel (node) first:
  natively a value is shown by how it is stored, not by its type, so a test of `show` can fail there and pass on node
  (D146, task d0d2915a). The node run keeps its own verdict too. -/
def confirmed (dir : Text) (name : Text) (integration : Bool) (v : Verdict) : {IO} Verdict :=
  match (v, IO.getEnv "DEUS_KERNEL", IO.getEnv "DEUS_HOME") with
  | (Verdict.fail _, Option.some "native", Option.some home) =>
      if integration then v else
        let (_, out, _) := IO.exec "env" ["DEUS_NATIVE=0", "DEUS_KERNEL=node", "node", home ++ "/bin/deus.mjs", "test", name, "--fresh", "--json", "--codebase", dir]
        match Json.parse out with
        | Result.ok rows =>
            match List.find (fun r => Json.text (Json.get r "name") == name) (Json.items rows) with
            | Option.some r => if Json.text (Json.get r "status") == "pass" then Verdict.pass (Json.text (Json.get r "evidence")) (Json.int (Json.get r "cases")) else v
            | Option.none => v
        | Result.err _ => v
  | _ => v

/-- Runs every test or theorem under a prefix; prints a report; exits 1 on failure. -/
def run (args : Args) (wantTheorems : Bool) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let ns := Codebase.current dir
  let prefix := getOr (head? args.positional) ""
  let runIntegration := Cli.flag args "integration"
  -- A kept verdict is keyed by the theorem alone, so after a checker change it may be stale (Prove.Spec R-8).
  let fresh := Cli.flag args "fresh"
  let selected := List.filter
    (fun pair => startsWith prefix (fst pair) && (if wantTheorems || runIntegration || not (hasAttr dir (Entry.hash (snd pair)) "integration") then
      match snd pair with
      | Entry.test _ => not wantTheorems
      | Entry.theorem _ => wantTheorems
      | _ => false
    else false))
    (Map.toList ns)
  let eventTypes := typesNow dir
  let results := List.map (fun pair =>
    let (name, e) := pair
    let h := Entry.hash e
    let integration := not wantTheorems && hasAttr dir h "integration"
    -- A kept verdict may predate the attribute, which leaves the hash as it was; these few are checked every time.
    let refuted := wantTheorems && hasAttr dir h "refuted"
    let started := IO.time ()
    -- An integration test talks to the real world, so its result is never reused.
    let outcome :=
      match if integration || fresh || refuted then Option.none else if wantTheorems then cachedTheorem dir h else Check.cached dir h with
      | Option.some v => (name, v, true)
      | Option.none =>
          Image.load (fetcher dir) [h]
          let v := if wantTheorems then
            match readObject dir h with
            | Option.some obj => if refuted then refutedVerdict (checkTheorem dir ns h obj) else checkTheorem dir ns h obj
            | Option.none => Verdict.fail "missing object"
          else confirmed dir name integration (checkTest h integration)
          if integration then () else if wantTheorems then rememberTheorem dir h v else remember dir h v
          (name, v, false)
    match outcome with
    | (_, v, wasCached) =>
        let fields :=
          match v with
          | Verdict.pass evidence cases => (true, evidence, cases, "")
          | Verdict.fail reason => (false, "", 0, reason)
          | Verdict.unchecked => (false, "sorry", 0, "unchecked")
        let (passed, evidence, cases, failure) := fields
        recordRun
          dir
          eventTypes
          ns
          name
          (if wantTheorems then "theorem" else "test")
          passed
          wasCached
          (not integration)
          evidence
          cases
          failure
          (IO.time () - started)
    outcome) selected
  let failed := List.filter (fun r =>
    match r with
    | (_, Verdict.fail _, _) => true
    | _ => false) results
  let index := nameIndex ns
  let line := fun r =>
    let (name, v, wasCached) := r
    let suffix := if wasCached then "  (cached)" else ""
    match v with
    | Verdict.pass evidence cases => if wantTheorems then "  ✓ " ++ name ++ "  " ++
        (if evidence == "refused" then "refused, as it must be" else if evidence == "test" then "tested, " ++ Int.toText cases ++ " cases" else if startsWith "proof" evidence then "proved (" ++ evidence ++ ")" else "proved by " ++ evidence ++ (if cases > 1 then ", " ++ Int.toText cases ++ " cases" else "")) ++ suffix else "  ✓ " ++ name ++ suffix
    | Verdict.fail reason => "  ✗ " ++ name ++ "  " ++ nameTrace index reason ++ suffix
    | Verdict.unchecked => "  ? " ++ name ++ "  sorry (unchecked)"
  Cli.output args (fun _ => Json.arr (List.map (fun r =>
    let (name, v, wasCached) := r
    let status :=
      match v with
      | Verdict.pass evidence cases => [("status", Json.str "pass"), ("evidence", Json.str evidence), ("cases", Json.num cases)]
      | Verdict.fail reason => [("status", Json.str "fail"), ("reason", Json.str (nameTrace index reason))]
      | Verdict.unchecked => [("status", Json.str "unchecked")]
    Json.obj ([("name", Json.str name), ("cached", Json.bool wasCached)] ++ status)) results)) (fun _ =>
    let summary := Int.toText (List.length results - List.length failed) ++ " passed, " ++
      Int.toText (List.length failed) ++ " failed"
    join "\n" (List.map line results ++ [summary]))
  if List.isEmpty failed then () else IO.exit 1

def tests (args : Args) : {IO, Throw Text} Unit := Check.run args false

def theorems (args : Args) : {IO, Throw Text} Unit := Check.run args true

end Check
