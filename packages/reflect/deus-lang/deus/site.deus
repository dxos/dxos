namespace Site
/-- The content type a site file is served with, by the bundled server (`Site.contentType`) and by a
  bucket the explorer is uploaded to: a browser refuses a module script or a stylesheet sent as
  `text/plain`. -/
def contentType (path : Text) : Text := if endsWith ".html" path then "text/html; charset=utf-8" else if endsWith ".json" path then "application/json" else if endsWith ".css" path then "text/css" else if endsWith ".js" path || endsWith ".mjs" path then "text/javascript" else if endsWith ".svg" path then "image/svg+xml" else "text/plain; charset=utf-8"

end Site
