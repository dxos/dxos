/-
  Claims the prover must refuse, each marked `@[expectFail]` so it passes when refused and fails if the prover
  ever accepts it (src/cli.test.ts checks every `Unsound.wrong*` is refused and every `Unsound.right*` proved).
-/

namespace Unsound

def loop (n : Int) : Int := loop n + 1

def len : List Int -> Int
  | [] => 0
  | _ :: rest => 1 + len rest

/-- False: `Int` wraps at 2³¹ - 1. -/
@[expectFail]
theorem wrongSuccGreater (x : Int) : x < x + 1 = true := by auto

/-- `loop` is not structurally recursive, so it is never unfolded (it would "prove" 0 = 1). -/
@[expectFail]
theorem wrongLoop (n : Int) : loop n = loop n + 1 := by auto

@[expectFail]
theorem wrongAllEmpty (xs : List Int) : xs = [] := by induction xs; auto

@[expectFail]
theorem wrongLenPositive (xs : List Int) : len xs > 0 = true := by induction xs; auto

/-- True, but a misspelled tactic must fail the proof rather than be skipped. -/
@[expectFail]
theorem wrongTacticName (a : Int) (b : Int) : a + b = b + a := by simp; smip

theorem rightAddComm (a : Int) (b : Int) (c : Int) : a + (b + c) = (c + a) + b := by simp

theorem rightLenAppend (xs : List Int) (ys : List Int) : len (xs ++ ys) = len xs + len ys := by induction xs; simp

end Unsound
