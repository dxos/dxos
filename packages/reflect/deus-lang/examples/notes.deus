/-
  An HTTP service written once against `platform/web.deus` (D57) and run three ways:

    deus test Notes                                  # in memory, deterministically
    deus serve Notes.serve --port 8080               # a standalone native server
    deus build Notes.serve -o out --worker           # a Cloudflare Worker (wrangler deploy)

  Each object (`?actor=` names it) is a notebook: `PUT /notes/<key>` stores a note,
  `GET /notes/<key>` reads it, `DELETE /notes/<key>` removes it and `GET /notes` lists the keys.
-/

namespace Notes

def prefix : Text := "/notes/"

/-- The keys of the notebook, kept as one newline-separated entry. -/
def keys (u : Unit) : {Storage} List Text :=
  List.filter (fun k => not (Text.isEmpty k)) (Text.lines (Option.getOr (Storage.get "keys") ""))

def setKeys (ks : List Text) : {Storage} Unit := Storage.put "keys" (Text.join "\n" ks)

def page (u : Unit) : {Storage} Response :=
  let items := Text.concat (List.map (fun k => "<li><a href=\"/notes/" ++ k ++ "\">" ++ k ++ "</a></li>") (keys ()))
  Web.html ("<!doctype html><title>Notes</title><h1>Notes</h1><ul>" ++ items ++ "</ul>")

def serve (request : Request) : {Storage} Response :=
  let path := request.url
  if path == "/" then page ()
  else if path == "/notes" then Web.ok (Text.join "\n" (keys ()))
  else if Text.startsWith prefix path then
    let key := Text.drop (Text.length prefix) path
    if request.verb == "PUT" || request.verb == "POST" then
      Storage.put ("note:" ++ key) request.payload
      if List.any (fun k => k == key) (keys ()) then () else setKeys (List.sort (key :: keys ()))
      Web.reply 201 ("stored " ++ key)
    else if request.verb == "DELETE" then
      if Storage.delete ("note:" ++ key) then
        setKeys (List.filter (fun k => k != key) (keys ()))
        Web.ok ("deleted " ++ key)
      else Web.notFound path
    else
      match Storage.get ("note:" ++ key) with
      | some note => Web.ok note
      | none => Web.notFound path
  else Web.notFound path

test notebooksAreSeparate :=
  let put := fun (key : Text) (body : Text) => Request.mk "PUT" (prefix ++ key) body
  let get := fun (path : Text) => Request.mk "GET" path ""
  match Web.simulateMany serve [("a", put "x" "one"), ("a", put "b" "two"), ("b", put "x" "other"), ("a", get "/notes"), ("a", get "/notes/x"), ("b", get "/notes/x"), ("a", Request.mk "DELETE" "/notes/x" ""), ("a", get "/notes/x")] with
  | (responses, _, _) =>
    List.map (fun r => (r.status, r.content)) responses ==
      [(201, "stored x"), (201, "stored b"), (201, "stored x"), (200, "b\nx"), (200, "one"), (200, "other"), (200, "deleted x"), (404, "no route /notes/x")]

test indexIsHtml :=
  match Web.simulate serve [Request.mk "PUT" "/notes/hello" "hi", Request.mk "GET" "/" ""] with
  | ([_, index], _) => List.lookup "content-type" index.headers == some "text/html; charset=utf-8" && Text.contains "<a href=\"/notes/hello\">hello</a>" index.content
  | _ => false

end Notes
