/-
  Dict and MutMap in the C back end (D119): hash tables with Int or Text keys that keep insertion
  order, as both kernels do, and `Map`, the AVL tree the prelude defines. The same definitions run
  on the interpreter and compile to C and to wasm.

    deus add examples/tables.deus && deus build Tables.wordCounts -o counts --c
-/

namespace Tables

/-- A linear congruential generator, so every back end sees the same words. -/
def churn (s : Int) : Int := Int.and (s * 22695477 + 1) 0x7FFFFFFF

def countWords (counts : MutMap Text Int) (k : Int) (s : Int) : Int :=
  if k == 0 then MutMap.size counts
  else
    let word := "w" ++ Int.toText (Int.ushr s 8 % 500)
    MutMap.set counts word (Option.getOr (MutMap.get counts word) 0 + 1)
    countWords counts (k - 1) (churn s)

def tally (counts : MutMap Text Int) (keys : List Text) (acc : Int) : Int :=
  match keys with
  | [] => acc
  | key :: rest => tally counts rest (acc + Option.getOr (MutMap.get counts key) 0)

/-- Counts `n` words drawn from 500: the distinct words times 1000003 plus the total count. -/
def wordCounts (n : Int) : Int :=
  let counts := MutMap.new ()
  let distinct := countWords counts n (churn 1)
  distinct * 1000003 + tally counts (MutMap.keys counts) 0

def dropOdd (m : MutMap Int Int) (k : Int) : Unit :=
  if k < 0 then () else
    if k % 2 == 1 then MutMap.delete m k else ()
    dropOdd m (k - 1)

def weighted (xs : List Int) (i : Int) (acc : Int) : Int :=
  match xs with
  | [] => acc
  | x :: rest => weighted rest (i + 1) (acc + i * x)

/-- Inserts, deletes and inserts again: a key set again after its delete moves to the end, as in the kernels. -/
def churned (n : Int) : Int :=
  let m := MutMap.new ()
  forEach (List.range 0 n) (fun i => MutMap.set m i (i * i))
  dropOdd m (n - 1)
  forEach (List.range 0 5) (fun i => MutMap.set m (2 * i + 1) i)
  let present := if MutMap.has m 3 && not (MutMap.has m 7 && MutMap.has m 13) then 1 else 0
  weighted (MutMap.keys m) 1 0 + 7 * MutMap.size m + present

/-- `Dict.fromList` keeps the first position of a key and its last value. -/
def dictionary (n : Int) : Int :=
  let pairs := List.map (fun i => (Int.toText (i % 37), i)) (List.range 0 n)
  let d := Dict.fromList pairs
  let found := List.foldl (fun acc i => acc + Option.getOr (Dict.lookup (Int.toText i) d) 0) 0 (List.range 0 40)
  found + 100 * Dict.size d + (if Dict.contains "36" d && not (Dict.contains "37" d) then 1 else 0) + Text.length (Text.join "" (Dict.keys d))

def mapFill (k : Int) (m : Map Text Int) : Map Text Int := if k == 0 then m else mapFill (k - 1) (Map.insert ("k" ++ Int.toText (k % 300)) k m)

/-- `Map` is ordinary DEUS code on Text keys: an AVL tree. -/
def mapped (n : Int) : Int :=
  let m := mapFill n Map.empty
  Map.size m * 1000 + Option.getOr (Map.lookup "k7" m) 0

/-- Every program here, as one number the tests compare across back ends. -/
def all (n : Int) : Int := wordCounts n + churned n + dictionary n + mapped n

test tablesSmall := all 1000 == 522691517
