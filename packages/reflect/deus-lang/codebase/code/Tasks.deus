/-- Three tasks: c's parent is b, b's parent is a. -/
def Tasks.Spec.family : Map Text Task :=
  let child := fun id parent => Task.mk id id TaskState.todo 0 "" [] parent "" [] []
  Map.fromList [("aaaa1111", child "aaaa1111" ""), ("bbbb2222", child "bbbb2222" "aaaa1111"), ("cccc3333", child "cccc3333" "bbbb2222")]

/-- R-5: "ab" finds abc12345 while it is the only id starting so; "a" is ambiguous and "z" unknown. -/
test Tasks.Spec.findsByPrefix :=
  let tasks := Map.fromList [("abc12345", blank "abc12345" "one"), ("acd00000", blank "acd00000" "two")]
  let found := fun id =>
    match try (fun _ => Tasks.find tasks id) with
    | Result.ok t => Option.some t.title
    | Result.err _ => Option.none
  found "ab" == Option.some "one" && found "acd00000" == Option.some "two" && found "a" == Option.none && found "z" == Option.none

/-- R-3: ` a, b ,,c ` sets the labels a, b and c. -/
test Tasks.Spec.labelsFromAList :=
  match try (fun _ => setField (blank "a" "A") "labels" " a, b ,,c ") with
  | Result.ok t => t.labels == ["a", "b", "c"]
  | Result.err _ => false

/-- R-4: two links to one definition are one link. -/
test Tasks.Spec.linkIsIdempotent :=
  let a := Attachment.definition "List.map" "abc"
  (link (link (blank "a" "A") a) a).links == [a]

/-- R-6: open before closed, urgent before low before none, and titles break ties. -/
test Tasks.Spec.orderOpenPriorityTitle :=
  let make := fun title state priority => Task.mk title title state priority "" [] "" "" [] []
  let sorted := List.map (fun t => t.title) (sortBy
    order
    [make "e" TaskState.done 1, make "d" TaskState.todo 0, make "c" TaskState.todo 4, make "b" TaskState.doing 1, make "a" TaskState.todo 1])
  sorted == ["a", "b", "c", "d", "e"]

/-- The parent `resolveParent` stores when `id`'s parent is set to `parent`; empty when refused. -/
def Tasks.Spec.parentAfter (id : Text) (parent : Text) : Text :=
  let t := getOr (Map.lookup id Tasks.Spec.family) (blank id id)
  match try (fun _ => resolveParent
    Tasks.Spec.family
    (Task.mk t.id t.title t.state t.priority t.assignee t.labels parent t.details t.links t.comments)) with
  | Result.ok resolved => resolved.parent
  | Result.err _ => ""

/-- R-8: a prefix is stored as the full id, no parent stays none, and an unknown one is refused. -/
test Tasks.Spec.parentIsResolved := parentAfter "cccc3333" "aaaa" == "aaaa1111" && parentAfter "new00000" "bbbb2222" == "bbbb2222" && parentAfter "cccc3333" "zzzz" == "" && parentAfter "bbbb2222" "" == ""

/-- R-8: a task cannot be its own parent or a child of its descendant. -/
test Tasks.Spec.parentRefusesCycles := parentAfter "aaaa1111" "aaaa1111" == "" && parentAfter "aaaa1111" "cccc3333" == "" && parentAfter "bbbb2222" "cccc" == ""

/-- Whether `body` throws. -/
def Tasks.Spec.refused (body : Unit -> {Throw Text} a) : Bool :=
  match try body with
  | Result.err _ => true
  | Result.ok _ => false

/-- A task whose text fields hold `t` and whose priority and state come from `k`. -/
def Tasks.Spec.sample (t : Text) (k : Int) : Task := Task.mk ("id" ++ toText (k % 97)) t (getOr
  (get? [TaskState.todo, TaskState.doing, TaskState.done, TaskState.canceled] (k % 4))
  TaskState.todo) (k % 5) t [t, "x"] "" (t ++ "\n" ++ t) [Attachment.definition t "abc", Attachment.change "def"] [Comment.mk t t "" [Asset.mk "h" "image/png" t]]

/-- R-7: after save, the task is current with its new title. -/
test Tasks.Spec.savedTaskIsCurrent := inStore (fun dir =>
  save dir [blank "t1" "first"] "add"
  save dir [blank "t1" "renamed"] "rename"
  Option.map (fun t => t.title) (Map.lookup "t1" (Tasks.current dir)) == Option.some "renamed")

/-- R-2: the four states and the priority names and numbers are taken; others are refused. -/
test Tasks.Spec.statesAndPriorities :=
  let t := blank "a" "A"
  let get := fun field value => try (fun _ => setField t field value)
  List.all
    (fun s => not (Tasks.Spec.refused (fun _ => setField t "state" s)))
    ["todo", "doing", "done", "canceled"] && Tasks.Spec.refused (fun _ => setField t "state" "open") && get "priority" "high" == get "priority" "2" && get "priority" "none" == get "priority" "0" && Tasks.Spec.refused (fun _ => setField t "priority" "5") && Tasks.Spec.refused (fun _ => setField t "priority" "-1") && Tasks.Spec.refused (fun _ => setField t "priority" "soon")

/-- R-1: printed and read back, the task is the same. -/
theorem Tasks.Spec.storedTextReadsBack (t : Text) (k : Int) : Tasks.fromSexp (Sexp.read (Sexp.print (Tasks.toSexp (Tasks.Spec.sample t k)))) ==
    Tasks.Spec.sample t k := by test 40

/-- R-7: saving the same task again leaves the branch head where it was. -/
test Tasks.Spec.unchangedSaveWritesNothing := inStore (fun dir =>
  let first := save dir [blank "t1" "first"] "add"
  let again := save dir [blank "t1" "first"] "again"
  first == again)

/-- Tasks linking a definition, by name or by any hash it was linked at. -/
def Tasks.about (tasks : Map Text Task) (name : Text) (h : Text) : List Task := List.filter (fun t => any (fun a =>
  match a with
  | Attachment.definition n linked => n == name || linked == h
  | Attachment.change _ => false) t.links) (Map.values tasks)

def Tasks.assetFromSexp (form : Sexp) : Asset :=
  match Sexp.args form with
  | h :: kind :: name :: [] => Asset.mk (asText h) (asText kind) (asText name)
  | _ => defect ("bad asset " ++ Sexp.print form)

--
-- Objects.
--
def Tasks.assetToSexp (a : Asset) : Sexp := Sexp.node "asset" [Sexp.str a.hash, Sexp.str a.mediaType, Sexp.str a.fileName]

def Tasks.attachmentFromSexp (form : Sexp) : Attachment :=
  match (head form, Sexp.args form) with
  | ("def", name :: ref :: []) => Attachment.definition (asText name) (asText (getOr (head? (Sexp.args ref)) (Sexp.str "")))
  | ("change", h :: []) => Attachment.change (asText h)
  | _ => defect ("bad task link " ++ Sexp.print form)

def Tasks.attachmentToSexp (a : Attachment) : Sexp :=
  match a with
  | Attachment.definition name h => Sexp.node "def" [Sexp.str name, Sexp.node "ref" [Sexp.str h]]
  | Attachment.change h => Sexp.node "change" [Sexp.str h]

/-- A new task with only an id and a title. -/
def Tasks.blank (id : Text) (title : Text) : Task := Task.mk id title TaskState.todo 0 "" [] "" "" [] []

--
-- History.
--
/-- The changes on the current branch (first parents, newest first) where `changedAt parent node` holds. -/
def Tasks.changesWhere (dir : Text) (limit : Int) (changedAt : Causal -> Causal -> {IO, Throw Text} Bool) : {IO, Throw Text} List (Text, Causal) :=
  let rec walk h n acc := if n <= 0 then reverse acc else
    let node := readCausal dir h
    match parentsOf dir h with
    | [] => reverse acc
    | p :: _ =>
        let parent := readCausal dir p
        walk p (n - 1) (if changedAt parent node then (h, node) :: acc else acc)
  walk (headOf dir (currentBranch dir)) limit []

def Tasks.comment (t : Task) (c : Comment) : Task := Task.mk
  t.id
  t.title
  t.state
  t.priority
  t.assignee
  t.labels
  t.parent
  t.details
  t.links
  (t.comments ++ [c])

def Tasks.commentFromSexp (c : Sexp) : Comment :=
  match Sexp.args c with
  | author :: note :: rest =>
      let at := getOr (Option.map asText (metaField (Option.some c) "at")) ""
      Comment.mk
        (asText author)
        (asText note)
        at
        (List.map assetFromSexp (metaList (Option.some c) "assets"))
  | _ => defect ("bad comment " ++ Sexp.print c)

/-- A comment without a time or assets prints as `(comment author note)`, so older objects keep their hashes. -/
def Tasks.commentToSexp (c : Comment) : Sexp :=
  let at := if Text.isEmpty c.written then [] else [Sexp.node "at" [Sexp.str c.written]]
  let assets := if List.isEmpty c.assets then [] else [Sexp.node "assets" (List.map assetToSexp c.assets)]
  Sexp.node "comment" ([Sexp.str c.author, Sexp.str c.note] ++ at ++ assets)

/-- The current branch's tasks, by id. -/
def Tasks.current (dir : Text) : {IO, Throw Text} Map Text Task :=
  let snapshot := Tasks.snapshotOf dir (readCausal dir (headOf dir (currentBranch dir)))
  Map.fromList (List.map (fun pair => (fst pair, Tasks.read dir (snd pair))) (Map.toList snapshot))

/-- Fields `deus task new` and `deus task set` take as options. -/
def Tasks.fields : List Text := ["title", "state", "priority", "assignee", "labels", "parent", "details"]

/-- A task by id or unique id prefix. -/
def Tasks.find (tasks : Map Text Task) (id : Text) : {Throw Text} Task :=
  match Map.lookup id tasks with
  | Option.some t => t
  | Option.none =>
      match List.filter (fun key => startsWith id key) (Map.keys tasks) with
      | key :: [] => getOr (Map.lookup key tasks) (blank key "")
      | [] => Throw.throw ("no task " ++ id)
      | _ => Throw.throw ("task id " ++ id ++ " is ambiguous")

/-- A fresh id: the first 8 hex digits of what makes the task unique (title, author, time, branch head). -/
def Tasks.freshId (dir : Text) (title : Text) (author : Text) : {IO, Throw Text} Text := Text.take
  8
  (Text.sha256 (title ++ "\n" ++ author ++ "\n" ++ IO.wallClock () ++ "\n" ++ headOf dir (currentBranch dir)))

def Tasks.fromSexp (form : Sexp) : Task :=
  let text := fun key => getOr (Option.map asText (metaField (Option.some form) key)) ""
  Task.mk
    (text "id")
    (text "title")
    (getOr (List.lookup (text "state") states) TaskState.todo)
    (getOr (Option.map Sexp.asInt (metaField (Option.some form) "priority")) 0)
    (text "assignee")
    (List.map asText (metaList (Option.some form) "labels"))
    (text "parent")
    (text "details")
    (List.map attachmentFromSexp (metaList (Option.some form) "links"))
    (List.map commentFromSexp (metaList (Option.some form) "comments"))

/-- `historyOf` for every task in one walk of the branch: id → changes that touched it, newest first. -/
def Tasks.histories (dir : Text) (limit : Int) : {IO, Throw Text} Map Text (List (Text, Causal)) :=
  let touched := fun parent node => if parent.tasks == node.tasks then [] else
    let before := Tasks.snapshotOf dir parent
    let after := Tasks.snapshotOf dir node
    List.filter
      (fun id => Map.lookup id before != Map.lookup id after)
      (dedup (sort (Map.keys before ++ Map.keys after)))
  let rec walk h n acc := if n <= 0 then acc else
    let node := readCausal dir h
    match parentsOf dir h with
    | [] => acc
    | p :: _ =>
        let parent := readCausal dir p
        walk p (n - 1) (((h, node), touched parent node) :: acc)
  -- `walk` leaves the oldest change first, so prepending each one leaves every list newest first.
  foldl
    (fun m change => foldl (fun m2 id => Map.insert id (fst change :: getOr (Map.lookup id m2) []) m2) m (snd change))
    Map.empty
    (walk (headOf dir (currentBranch dir)) limit [])

/-- Changes that touched a task. -/
def Tasks.historyOf (dir : Text) (id : Text) (limit : Int) : {IO, Throw Text} List (Text, Causal) := changesWhere
  dir
  limit
  (fun parent node => parent.tasks != node.tasks && Map.lookup id (Tasks.snapshotOf dir parent) != Map.lookup id (Tasks.snapshotOf dir node))

/-- Changes that rebound a name. -/
def Tasks.historyOfName (dir : Text) (name : Text) (limit : Int) : {IO, Throw Text} List (Text, Causal) := changesWhere
  dir
  limit
  (fun parent node => parent.snapshot != node.snapshot && Codebase.lookupName dir parent.snapshot name != Codebase.lookupName dir node.snapshot name)

def Tasks.isOpen (t : Task) : Bool := t.state == TaskState.todo || t.state == TaskState.doing

def Tasks.link (t : Task) (a : Attachment) : Task := if any (fun b => b == a) t.links then t else Task.mk
  t.id
  t.title
  t.state
  t.priority
  t.assignee
  t.labels
  t.parent
  t.details
  (t.links ++ [a])
  t.comments

/-- Three-way merge of tasks snapshots. Returns the merged snapshot and conflicts as `task:<id>.<field>`. -/
def Tasks.merge (dir : Text) (base : Map Text Text) (ours : Map Text Text) (theirs : Map Text Text) : {IO, Throw Text} (Map Text Text, List Text) :=
  let ids := Set.toList (Set.fromList (Map.keys base ++ Map.keys ours ++ Map.keys theirs))
  foldl (fun state id =>
    match state with
    | (merged, conflicts) =>
        let b := Map.lookup id base
        let o := Map.lookup id ours
        let t := Map.lookup id theirs
        if o == t then state else if b == o then
          match t with
          | Option.some h => (Map.insert id h merged, conflicts)
          | Option.none => (Map.remove id merged, conflicts)
        else if b == t then state else
          match (o, t) with
          | (Option.some oh, Option.some th) =>
              let baseTask :=
                match b with
                | Option.some bh => Tasks.read dir bh
                | Option.none => blank id ""
              match mergeTask baseTask (Tasks.read dir oh) (Tasks.read dir th) with
              | Result.ok task => (Map.insert id (Codebase.put dir (Tasks.toSexp task)) merged, conflicts)
              | Result.err fields => (merged, conflicts ++ List.map (fun f => "task:" ++ id ++ "." ++ f) fields)
          | _ => (merged, conflicts ++ ["task:" ++ id])) (ours, []) ids

/-- Merges one task changed on both sides, field by field. Returns the task or the conflicting fields. -/
def Tasks.mergeTask (b : Task) (o : Task) (t : Task) : Result (List Text) Task :=
  let title := three b.title o.title t.title
  let state := three b.state o.state t.state
  let priority := three b.priority o.priority t.priority
  let assignee := three b.assignee o.assignee t.assignee
  let parent := three b.parent o.parent t.parent
  let details := three b.details o.details t.details
  let conflicts := filterMap
    (fun pair => if snd pair then Option.some (fst pair) else Option.none)
    [("title", isNone title), ("state", isNone state), ("priority", isNone priority), ("assignee", isNone assignee), ("parent", isNone parent), ("details", isNone details)]
  match (title, state, priority, assignee, parent, details) with
  | (Option.some title2, Option.some state2, Option.some priority2, Option.some assignee2, Option.some parent2, Option.some details2) =>
      let comments := o.comments ++ List.filter (fun c => not (any (fun d => d == c) o.comments)) t.comments
      Result.ok (Task.mk
        o.id
        title2
        state2
        priority2
        assignee2
        (threeSet b.labels o.labels t.labels)
        parent2
        details2
        (threeSet b.links o.links t.links)
        comments)
  | _ => Result.err conflicts

/-- Open tasks first, then by priority (none last), then by title. -/
def Tasks.order (a : Task) (b : Task) : Int :=
  let rank := fun t => (if isOpen t then 0 else 1, if t.priority == 0 then 5 else t.priority)
  let ra := rank a
  let rb := rank b
  if ra == rb then compare a.title b.title else compare ra rb

def Tasks.parsePriority (t : Text) : {Throw Text} Int :=
  match (fromText t, findIndex (fun p => p == t) priorities) with
  | (Option.some n, _) => if n >= 0 && n <= 4 then n else Throw.throw ("priority " ++ t ++ " is not 0..4")
  | (Option.none, i) => if i >= 0 then i else Throw.throw ("unknown priority " ++ t ++ " (none, urgent, high, medium, low or 0..4)")

def Tasks.parseState (t : Text) : {Throw Text} TaskState :=
  match List.lookup t states with
  | Option.some s => s
  | Option.none => Throw.throw ("unknown task state " ++ t ++ " (todo, doing, done, canceled)")

/-- Every task object the branch's first-parent history has held, the current ones included. -/
def Tasks.pastVersions (dir : Text) : {IO, Throw Text} Map Text Unit :=
  let rec walk h seen acc :=
    let node := readCausal dir h
    let acc2 := if Set.contains node.tasks seen then acc else foldl (fun a pair => Set.insert (snd pair) a) acc (Map.toList (Tasks.snapshotOf dir node))
    match parentsOf dir h with
    | [] => acc2
    | p :: _ => walk p (Set.insert node.tasks seen) acc2
  walk (headOf dir (currentBranch dir)) Map.empty Map.empty

def Tasks.priorities : List Text := ["none", "urgent", "high", "medium", "low"]

def Tasks.priorityText (n : Int) : Text := getOr (head? (List.drop n priorities)) (toText n)

/-- Stores a tasks snapshot; no tasks is `""`, so a history node without tasks keeps its old hash. -/
def Tasks.putSnapshot (dir : Text) (tasks : Map Text Text) : {IO} Text := if Map.size tasks == 0 then "" else Codebase.put dir (Sexp.node "tasks" (List.map
  (fun pair => Sexp.node "t" [Sexp.str (fst pair), Sexp.node "ref" [Sexp.str (snd pair)]])
  (Map.toList tasks)))

def Tasks.read (dir : Text) (h : Text) : {IO, Throw Text} Task :=
  match readObject dir h with
  | Option.some form => Tasks.fromSexp form
  | Option.none => Throw.throw ("missing task #" ++ h)

/-- `t` with its parent resolved to a full id: another task, found by id or prefix, that is not `t` or below it. -/
def Tasks.resolveParent (tasks : Map Text Task) (t : Task) : {Throw Text} Task := if Text.isEmpty t.parent then t else
  let parent := (Tasks.find tasks t.parent).id
  -- Walking up from the new parent must not reach `t`; the bound stops a cycle already stored.
  let rec above id steps := if id == t.id then Throw.throw ("task " ++ parent ++ " is " ++ t.id ++ " or below it, so it cannot be its parent") else if Text.isEmpty id || steps > Map.size tasks then () else above (getOr (Option.map (fun p => p.parent) (Map.lookup id tasks)) "") (steps + 1)
  above parent 0
  Task.mk t.id t.title t.state t.priority t.assignee t.labels parent t.details t.links t.comments

/-- Writes tasks on the current branch as one change. Returns the new causal hash. -/
def Tasks.save (dir : Text) (changed : List Task) (message : Text) : {IO, Throw Text} Text :=
  let head := readCausal dir (headOf dir (currentBranch dir))
  let tasks := foldl
    (fun m t => Map.insert t.id (Codebase.put dir (Tasks.toSexp t)) m)
    (Tasks.snapshotOf dir head)
    changed
  commitTasks dir (Tasks.putSnapshot dir tasks) message

/-- Sets one field from its text form, as `deus task set --<field> <value>` does. -/
def Tasks.setField (t : Task) (field : Text) (value : Text) : {Throw Text} Task := if field == "title" then Task.mk t.id value t.state t.priority t.assignee t.labels t.parent t.details t.links t.comments else if field == "state" then Task.mk
  t.id
  t.title
  (parseState value)
  t.priority
  t.assignee
  t.labels
  t.parent
  t.details
  t.links
  t.comments else if field == "priority" then Task.mk
  t.id
  t.title
  t.state
  (parsePriority value)
  t.assignee
  t.labels
  t.parent
  t.details
  t.links
  t.comments else if field == "assignee" then Task.mk t.id t.title t.state t.priority value t.labels t.parent t.details t.links t.comments else if field == "labels" then Task.mk
  t.id
  t.title
  t.state
  t.priority
  t.assignee
  (List.filter (fun l => not (Text.isEmpty l)) (List.map trim (Text.split value ",")))
  t.parent
  t.details
  t.links
  t.comments else if field == "parent" then Task.mk t.id t.title t.state t.priority t.assignee t.labels value t.details t.links t.comments else if field == "details" then Task.mk t.id t.title t.state t.priority t.assignee t.labels t.parent value t.links t.comments else Throw.throw ("unknown task field " ++ field)

/-- A tasks snapshot by its hash, as id -> task object hash; `""` is no tasks. -/
def Tasks.snapshotAt (dir : Text) (h : Text) : {IO, Throw Text} Map Text Text := if Text.isEmpty h then Map.empty else
  match readObject dir h with
  | Option.none => Throw.throw ("missing tasks snapshot #" ++ h)
  | Option.some form => Map.fromList (List.map (fun item =>
      match Sexp.args item with
      | id :: ref :: [] => (asText id, asText (getOr (head? (Sexp.args ref)) (Sexp.str "")))
      | _ => defect ("bad tasks entry " ++ Sexp.print item)) (Sexp.args form))

--
-- Snapshots.
--
/-- The tasks snapshot of a history node: task id -> task hash. -/
def Tasks.snapshotOf (dir : Text) (c : Causal) : {IO, Throw Text} Map Text Text := snapshotAt dir c.tasks

def Tasks.stateText (s : TaskState) : Text :=
  match s with
  | TaskState.todo => "todo"
  | TaskState.doing => "doing"
  | TaskState.done => "done"
  | TaskState.canceled => "canceled"

def Tasks.states : List (Text, TaskState) := [("todo", TaskState.todo), ("doing", TaskState.doing), ("done", TaskState.done), ("canceled", TaskState.canceled)]

--
-- Merging.
--
/-- A three-way choice: one side's change wins, and changes on both sides must agree. -/
def Tasks.three (b : a) (o : a) (t : a) : Option a := if o == t then Option.some o else if b == o then Option.some t else if b == t then Option.some o else Option.none

/-- A three-way set merge: what either side added stays, and what either side removed goes. -/
def Tasks.threeSet (b : List a) (o : List a) (t : List a) : List a :=
  let has := fun xs x => any (fun y => y == x) xs
  let keep := fun x => has o x && has t x || not (has b x)
  List.filter keep o ++ List.filter (fun x => keep x && not (has o x)) t

/-- A task as an object. A linked definition is a `(ref …)`, so replication keeps the version a task was about. -/
def Tasks.toSexp (t : Task) : Sexp :=
  let text := fun key value => Sexp.node key [Sexp.str value]
  let comments := List.map commentToSexp t.comments
  Sexp.node
    "task"
    [text "id" t.id, text "title" t.title, text "state" (stateText t.state), Sexp.node "priority" [Sexp.int t.priority], text "assignee" t.assignee, Sexp.node "labels" (List.map Sexp.str t.labels), text "parent" t.parent, text "details" t.details, Sexp.node "links" (List.map attachmentToSexp t.links), Sexp.node "comments" comments]

def Tasks.unlink (t : Task) (name : Text) : Task :=
  let keep := fun a =>
    match a with
    | Attachment.definition n _ => n != name
    | Attachment.change h => not (startsWith name h)
  Task.mk
    t.id
    t.title
    t.state
    t.priority
    t.assignee
    t.labels
    t.parent
    t.details
    (List.filter keep t.links)
    t.comments
