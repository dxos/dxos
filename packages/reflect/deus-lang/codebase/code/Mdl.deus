def Mdl.block (start : Int) (lines : List Text) : Block :=
  match List.filter (fun l => not (Text.isEmpty (trim l))) lines with
  | [] => Block.mk "" "" "" [] start
  | first :: rest =>
      match Mdl.header (trim first) start with
      | Block.mk x0 x1 x2 x3 x4 => Block.mk x0 x1 x2 (Mdl.body rest) x4

/-- A `key: value` line indented deeper than the block's first key continues the last value with
  two leading spaces, so a list item can carry fields of its own (a `qa` step's `send:`). -/
def Mdl.body (lines : List Text) : List (Text, Text) :=
  let base :=
    match List.filter (fun l => not (Text.isEmpty (trim l))) lines with
    | [] => 0
    | first :: _ => indentOf first
  reverse (foldl (fun acc line =>
    let t := trim line
    if Text.isEmpty t || startsWith "#" t then acc else if startsWith "- " t then continueWith acc (Text.drop 2 t) else
      match keyValue t with
      | Option.some kv => if indentOf line > base && not (List.isEmpty acc) then continueWith acc ("  " ++ t) else kv :: acc
      | Option.none => continueWith acc t) [] lines)

/-- Adds a continuation line (a `- item` or prose) to the last key, or to `prose` before any key. -/
def Mdl.continueWith (acc : List (Text, Text)) (t : Text) : List (Text, Text) :=
  match acc with
  | [] => [("prose", t)]
  | (key, value) :: rest => (key, if Text.isEmpty value then t else value ++ "\n" ++ t) :: rest

/-- Terms a document may use: its Extensions table and its inline `ext <term>` blocks with a `uri:`. -/
def Mdl.declared (doc : Doc) : List (Text, Text) := doc.terms ++ filterMap
  (fun b => if b.blockType == "ext" then Option.map (fun uri => (b.blockId, unquote uri)) (List.lookup "uri" b.props) else Option.none)
  doc.blocks

def Mdl.describe (b : Block) : Text := if Text.isEmpty b.blockId then b.blockType else b.blockType ++ " " ++ b.blockId

def Mdl.deusSource (doc : Text) : Text :=
  let rec go lines inFence acc :=
    match lines with
    | [] => join "\n" (reverse acc)
    | line :: rest =>
        let trimmed := trim line
        if not inFence && trimmed == "```deus" then go rest true ("" :: acc) else if inFence && trimmed == "```" then go rest false ("" :: acc) else if inFence then go rest true (line :: acc) else go rest false ("" :: acc)
  go (lines doc) false []

/-- A spec object as its extension's URI and the block. -/
def Mdl.fromSexp (form : Sexp) : (Text, Block) :=
  match Sexp.args form with
  | kind :: uri :: ident :: title :: props => (asText uri, Block.mk (asText kind) (asText ident) (asText title) (filterMap (fun p =>
      match p with
      | Sexp.list (key :: value :: []) => Option.some (asText key, asText value)
      | _ => Option.none) props) 0)
  | _ => ("", Block.mk "" "" "" [] 0)

def Mdl.frontmatter (lines : List (Int, Text)) : (List (Text, Text), List (Int, Text)) :=
  match lines with
  | [] => ([], [])
  | (_, first) :: rest => if trim first == "---" then
      let n := findIndex (fun p => trim (snd p) == "---") rest
      if n < 0 then ([], lines) else (filterMap (fun p => keyValue (snd p)) (List.take n rest), List.drop (n + 1) rest)
    else ([], lines)

/-- `<type> [<id>][: <title>]`. -/
def Mdl.header (line : Text) (at : Int) : Block :=
  let colon := indexOf line ":" 0
  let head := if colon < 0 then line else Text.take colon line
  let title := if colon < 0 then "" else trim (Text.drop (colon + 1) line)
  match List.filter (fun w => not (Text.isEmpty w)) (Text.split (trim head) " ") with
  | [] => Block.mk "" "" title [] at
  | kind :: [] => Block.mk kind "" title [] at
  | kind :: ident :: _ => Block.mk kind ident title [] at

def Mdl.headingOf (t : Text) : Text :=
  let rec go i := if i < Text.length t && code t i == '#' then go (i + 1) else i
  trim (Text.drop (go 0) t)

def Mdl.indentOf (line : Text) : Int :=
  let rec go i := if i < Text.length line && code line i == ' ' then go (i + 1) else i
  go 0

def Mdl.isKeyChar (c : Int) : Bool := isAlpha c || isDigit c || c == '-' || c == '_' || c == '?'

/-- `key: value` when the key is an identifier; a bare `key:` has the empty value. -/
def Mdl.keyValue (line : Text) : Option (Text, Text) :=
  let i := indexOf line ":" 0
  if i <= 0 then Option.none else
    let key := trim (Text.take i line)
    if List.all (fun j => isKeyChar (code key j)) (range 0 (Text.length key)) then Option.some (key, uncomment (trim (Text.drop (i + 1) line))) else Option.none

/-- Parses a document; fences other than ```mdl (```deus among them) are skipped. -/
def Mdl.parse (doc : Text) : Doc :=
  match frontmatter (mapIndexed (fun i l => (i + 1, l)) (lines doc)) with
  | (front, lines) =>
      -- fence: none outside; some (start, isMdl, lines reversed) inside.
      let rec go rest section fence terms blocks :=
        match rest with
        | [] => Doc.mk front (reverse terms) (reverse blocks)
        | (n, line) :: more =>
            let t := trim line
            match fence with
            | Option.some (start, isMdl, acc) => if t == "```" then go
                more
                section
                Option.none
                terms
                (if isMdl then Mdl.block start (reverse acc) :: blocks else blocks) else go more section (Option.some (start, isMdl, line :: acc)) terms blocks
            | Option.none => if startsWith "```" t then go more section (Option.some (n + 1, t == "```mdl", [])) terms blocks else if startsWith "#" t then go more (headingOf t) Option.none terms blocks else if section == "Extensions" && startsWith "|" t then go
                more
                section
                Option.none
                (getOr (Option.map (fun row => row :: terms) (termRow t)) terms)
                blocks else go more section Option.none terms blocks
      go lines "" Option.none [] []

/-- A document's prose as the codebase keeps it with the blocks (D99): the text before each stored
  block, in order, and the text after the last. A ```deus fence is left out, since its code is
  stored as definitions; one opening with `namespace N` leaves a line naming `N`. The Extensions
  table's rows are left out too, since the export writes them from the blocks' URIs. Everything
  else is kept as written, `ext` blocks and other fences included, except that runs of blank lines
  outside fences become one, so the text survives a round trip unchanged. -/
def Mdl.prose (doc : Text) : (List Text, Text) :=
  match frontmatter (mapIndexed (fun i l => (i + 1, l)) (lines doc)) with
  | (_, lines) =>
      -- fence: none outside; some (kind, its lines reversed, the opening line last).
      let rec go rest section fence acc leads :=
        match rest with
        | [] => (reverse leads, trimLines (reverse acc))
        | (_, line) :: more =>
            let t := trim line
            match fence with
            | Option.some (kind, held) => if t != "```" then go more section (Option.some (kind, line :: held)) acc leads else if kind == "deus" then
                -- The code is stored as definitions; a line says where, so the document still points at its laws.
                let code := List.filter (fun l => not (Text.isEmpty (trim l))) (List.drop 1 (reverse held))
                match code with
                | first :: _ => if startsWith "namespace " (trim first) then
                    let ns := trim (Text.drop 10 (trim first))
                    go
                      more
                      section
                      Option.none
                      (("The laws are the definitions under `" ++ ns ++ "`: `deus ls " ++ ns ++
                        ".` lists them and `deus view` prints them.") :: acc)
                      leads
                  else go more section Option.none acc leads
                | [] => go more section Option.none acc leads
              else if kind == "mdl" && stored (Mdl.block 0 (List.drop 1 (reverse held))) then go more section Option.none [] (trimLines (reverse acc) :: leads) else go more section Option.none (line :: held ++ acc) leads
            | Option.none =>
                let afterBlank :=
                  match acc with
                  | prev :: _ => Text.isEmpty (trim prev)
                  | [] => true
                if startsWith "```" t then go
                  more
                  section
                  (Option.some (if t == "```mdl" then "mdl" else if t == "```deus" then "deus" else "other", [line]))
                  acc
                  leads else if startsWith "#" t then go more (headingOf t) Option.none (line :: acc) leads else if section == "Extensions" && startsWith "|" t then go more section Option.none acc leads else if Text.isEmpty t && afterBlank then go more section Option.none acc leads else go more section Option.none (line :: acc) leads
      go lines "" Option.none [] []

/-- A block printed back as MDL. -/
def Mdl.render (b : Block) : Text :=
  let head := b.blockType ++ (if Text.isEmpty b.blockId then "" else " " ++ b.blockId) ++
    (if Text.isEmpty b.blockTitle then "" else ": " ++ b.blockTitle)
  "```mdl\n" ++ head ++ Text.concat (List.map
    (fun kv => "\n  " ++ fst kv ++ ":" ++ (if Text.contains "\n" (snd kv) then Text.concat (List.map
      (fun l => if startsWith "  " l then "\n    " ++ trim l else "\n  - " ++ l)
      (lines (snd kv))) else " " ++ snd kv))
    b.props) ++ "\n```"

/-- Whether a block is stored as a spec object: it has an id and is not an `ext` declaration. -/
def Mdl.stored (b : Block) : Bool := not (Text.isEmpty b.blockId) && b.blockType != "ext"

/-- A `| term | uri |` row of the Extensions table; none for its header and separator. -/
def Mdl.termRow (line : Text) : Option (Text, Text) :=
  match List.map trim (Text.split line "|") with
  | "" :: term :: uri :: _ => if startsWith "`" term then Option.some (unquote term, unquote uri) else Option.none
  | _ => Option.none

/-- A block as a spec object, with the URI of the extension its type names (stored specs have no
  Extensions table). The line is left out, so moving a block does not change its hash. -/
def Mdl.toSexp (uri : Text) (b : Block) : Sexp := Sexp.node "spec" ([Sexp.str b.blockType, Sexp.str uri, Sexp.str b.blockId, Sexp.str b.blockTitle] ++
  List.map (fun kv => Sexp.list [Sexp.str (fst kv), Sexp.str (snd kv)]) b.props)

/-- Lines joined, without the blank lines at either end. -/
def Mdl.trimLines (lines : List Text) : Text :=
  let rec leading xs :=
    match xs with
    | l :: more => if Text.isEmpty (trim l) then leading more else xs
    | [] => []
  join "\n" (reverse (leading (reverse (leading lines))))

/-- Drops a trailing ` # comment`. -/
def Mdl.uncomment (t : Text) : Text :=
  let i := indexOf t " # " 0
  if i < 0 then t else trim (Text.take i t)

def Mdl.unquote (t : Text) : Text := if Text.length t >= 2 && startsWith "`" t && endsWith "`" t then slice t 1 (Text.length t - 1) else t

/-- The core language's own rules: every block type is declared, and block ids are unique. -/
def Mdl.validate (doc : Doc) : List Text :=
  let terms := List.map fst (declared doc)
  let undeclared := filterMap
    (fun b => if b.blockType == "ext" || any (fun term => term == b.blockType) terms then Option.none else Option.some ("line " ++ toText b.lineNo ++ ": block type `" ++ b.blockType ++
      "` is not in the Extensions table"))
    doc.blocks
  let ids := List.filter (fun i => not (Text.isEmpty i)) (List.map (fun b => b.blockId) doc.blocks)
  let duplicates := filterMap (fun pair =>
    match pair with
    | (i, ident) => if any (fun earlier => earlier == ident) (List.take i ids) then Option.some ("block id " ++ ident ++ " is declared twice") else Option.none) (mapIndexed (fun i ident => (i, ident)) ids)
  undeclared ++ duplicates
