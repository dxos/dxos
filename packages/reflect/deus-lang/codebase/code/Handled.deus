ability Handled.Journal where
  record : Text -> Unit

/-
  Effect handlers in the C back end (D123). A clause that resumes in tail position becomes a call,
  and one that does not aborts to its handler, passing the value up through checked returns. Both
  `try` and handlers written here compile; a clause that resumes anywhere else is refused.

    deus add examples/handled.deus && deus build Handled.handledAll -o handled --c
-/
ability Handled.Meter where
  advance : Int -> Int

/-- A clause that throws to an outer handler instead of resuming, and a handler that throws again with context. -/
def Handled.capped (limit : Int) (n : Int) : Int :=
  let counted := fun _ =>
    handle metered n 0 with
    | Meter.advance x -> resume => if x > limit then Throw.throw ("over " ++ toText x) else resume (x + 1)
  let rethrown := fun _ =>
    handle counted () with
    | Throw.throw e -> x2 => Throw.throw ("capped: " ++ e)
  match try rethrown with
  | Result.ok v => v
  | Result.err e => 0 - Text.length e

def Handled.countTo (n : Int) : Int :=
  handle metered n 0 with
  | Meter.advance x -> resume => resume (x * 2)

/-- Every program here, as one number the tests compare across back ends. -/
def Handled.handledAll (n : Int) : Int := countTo n + unwound n + journaled n + capped (n / 2) n + 100000 * capped (n + 1) n

test Handled.handledSmall := handledAll 20 == 23007393

/-- A handler that keeps state in a `Ref`, under one that a `throw` passes through. -/
def Handled.journaled (n : Int) : Int :=
  let lines := Ref.new 0
  let result := try (fun _ =>
    handle forEach (range 0 n) (fun i => if i == 7 then Throw.throw "seven" else Journal.record (toText i)) with
    | Journal.record t -> resume => resume (Ref.set lines (Ref.get lines + Text.length t)))
  match result with
  | Result.ok _ => Ref.get lines
  | Result.err e => 1000 * Ref.get lines + Text.length e

/-- Each `advance` returns its argument doubled, by a clause that resumes in tail position. -/
def Handled.metered (n : Int) (acc : Int) : {Meter} Int := if n == 0 then acc else Handled.metered (n - 1) (acc + Meter.advance n)

def Handled.parseAll (xs : List Text) (acc : Int) : {Throw Text} Int :=
  match xs with
  | [] => acc
  | x :: rest =>
      match fromText x with
      | Option.some v => Handled.parseAll rest (acc + v)
      | Option.none => Throw.throw ("not a number: " ++ x)

/-- A `throw` deep in a recursion unwinds through every frame to `try`. -/
def Handled.unwound (n : Int) : Int :=
  let xs := List.map (fun i => if i == n - 3 then "x" ++ toText i else toText i) (range 0 n)
  match try (fun _ => parseAll xs 0) with
  | Result.ok v => v
  | Result.err e => 0 - Text.length e
