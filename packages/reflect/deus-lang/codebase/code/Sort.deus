theorem Sort.agreesWithMergeSort (xs : List Int) : isort xs == sort xs := by test 200

/-- Specification: how often `x` occurs. Equal counts for every `x` mean a permutation. -/
def Sort.count (x : Int) (x0 : List Int) : Int :=
  match x0 with
  | [] => 0
  | y :: rest => (if x == y then 1 else 0) + Sort.count x rest

/-- Implementation: insert into a sorted list. -/
def Sort.insert (x : Int) (x0 : List Int) : List Int :=
  match x0 with
  | [] => [x]
  | y :: rest => if x <= y then x :: y :: rest else y :: Sort.insert x rest

theorem Sort.insertCount (y : Int) (x : Int) (xs : List Int) : Sort.count y (Sort.insert x xs) == (if y == x then 1 else 0) + Sort.count y xs := by induction xs ; auto

theorem Sort.insertLength (x : Int) (xs : List Int) : Sort.len (Sort.insert x xs) == 1 + Sort.len xs := by induction xs ; auto

theorem Sort.insertSorted (x : Int) (xs : List Int) : prim "implies" (sorted xs == true) (sorted (Sort.insert x xs) == true) := by induction xs ; auto

/-- Implementation: insertion sort. -/
def Sort.isort : List Int -> List Int
| [] => []
| x :: rest => Sort.insert x (Sort.isort rest)

theorem Sort.isortCount (y : Int) (xs : List Int) : Sort.count y (isort xs) == Sort.count y xs := by induction xs ; simp [insertCount]

theorem Sort.isortLength (xs : List Int) : Sort.len (isort xs) == Sort.len xs := by induction xs ; simp [insertLength]

theorem Sort.isortSorted (xs : List Int) : sorted (isort xs) == true := by induction xs ; simp [insertSorted]

def Sort.len : List Int -> Int
| [] => 0
| _ :: rest => 1 + Sort.len rest

/-- Specification: each element is at most the next. -/
def Sort.sorted : List Int -> Bool
| [] => true
| a :: rest =>
  match rest with
  | [] => true
  | b :: _ => a <= b && Sort.sorted rest

theorem Sort.wrongClaim (x : Int) (xs : List Int) : Sort.insert x xs == x :: xs := by induction xs ; auto
