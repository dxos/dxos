/-- `ability A<e> { op(E): R; }`: an ability reads as an interface of operations. -/
def Ts.abilityDecl (p : Printer) (ns : Map Text Entry) (name : Text) (e : Entry) (obj : Sexp) (meta : Option Sexp) : Text :=
  match (e, Sexp.args obj) with
  | (Entry.ability h iri, _ :: Sexp.int count :: rawOps) =>
      let names := paramsFor meta count obj
      let ops := List.map (nameParams names) rawOps
      let opNames := filterMap (fun pair =>
        match pair with
        | (n, Entry.op a index _) => if a == h then Option.some (index, lastSegment n) else Option.none
        | _ => Option.none) (Map.toList ns)
      let lines := mapIndexed (fun index op =>
        let oname := getOr (List.lookup index opNames) ("op" ++ toText index)
        match Sexp.args op with
        | _ :: t :: [] =>
            match Ts.arrows t with
            | ([], result) => "  " ++ oname ++ ": " ++ Ts.ty p result 0 ++ ";"
            | (args, result) => "  " ++ oname ++ "(" ++ join ", " (List.map (fun x => Ts.ty p x 3) args) ++ "): " ++
                Ts.ty p result 0 ++ ";"
        | _ => "  " ++ oname ++ ";") ops
      decorator iri name ++ "ability " ++ name ++ Ts.generics names ++ " {\n" ++ join "\n" lines ++
        "\n}"
  | _ => Sexp.print obj

/-- `f(a, b)` on one line when it fits, else one argument per line; binder names drawn by the first attempt are given back. -/
def Ts.application (p : Printer) (f : Sexp) (args : List Sexp) (env : List Text) (ind : Int) (prec : Int) : Text :=
  let supply := Ref.get p.supply
  let fresh := Ref.get p.fresh
  let flat := Ts.expr p f env ind 100 ++ "(" ++ join ", " (List.map (fun a => Ts.expr p a env ind 0) args) ++
    ")"
  if unitOnly args then Ts.expr p f env ind 100 ++ "()" else if fits ind flat || List.length args < 2 then flat else
    Ref.set p.supply supply
    Ref.set p.fresh fresh
    let head := Ts.expr p f env ind 100
    head ++ "(" ++
      Text.concat (List.map (fun a => "\n" ++ spaces (ind + 2) ++ Ts.expr p a env (ind + 2) 0 ++ ",") args) ++ "\n" ++ spaces ind ++ ")"

--
-- Types.
--
/-- The argument types of a run of pure arrows and what follows them; an arrow with a row ends the run. -/
def Ts.arrows (t : Sexp) : (List Sexp, Sexp) :=
  match t with
  | Sexp.list (Sexp.sym "tfun" :: a :: b :: []) =>
      match Ts.arrows b with
      | (args, result) => (a :: args, result)
  | Sexp.list (Sexp.sym "tfun" :: a :: b :: row :: []) => ([a], Sexp.node "teff" [row, b])
  | _ => ([], t)

def Ts.conName (p : Printer) (t : Text) (tag : Int) : Text := if t == "#Unit" then "undefined" else Print.conName p t tag

def Ts.decorator (iri : Text) (name : Text) : Text := if iri == "urn:deus:" ++ name then "" else "@iri(" ++ quoteText iri ++ ")\n"

/-- `function name<a>(x: A): B { … }`, or `const name: T = …;` for a value. -/
def Ts.definition (p : Printer) (name : Text) (core : Sexp) (sig : Option Sexp) (doc : Option Text) : Text :=
  match Ts.params p core [] with
  | (names, b, env) =>
      let count := List.length names
      let split := Option.map (fun s => splitSig s count) sig
      let typed :=
        match split with
        | Option.some (types, Option.some result) => if List.length types == count then Option.some (types, result) else Option.none
        | _ => Option.none
      let gen := Ts.generics (getOr (Option.map typeVars sig) [])
      let annotate := fun t => if isUnknown t then "" else ": " ++ Ts.ty p t 3
      if count == 0 then
        let typeText :=
          match typed with
          | Option.some (_, result) => annotate result
          | Option.none => ""
        Ts.docComment doc ++ "const " ++ name ++ typeText ++ " = " ++ Ts.expr p b env 0 0 ++ ";"
      else
        let paramText :=
          match typed with
          | Option.some (types, _) => List.map (fun pair => fst pair ++ annotate (snd pair)) (zip names types)
          | Option.none => names
        let resultText :=
          match typed with
          | Option.some (_, result) =>
              match result with
              | Sexp.list (Sexp.sym "teff" :: Sexp.list (Sexp.sym "eff" :: effs) :: r :: []) => annotate r ++ (if List.isEmpty effs then "" else " uses " ++ uses p effs)
              | _ => annotate result
          | Option.none => ""
        let flat := "function " ++ name ++ gen ++ "(" ++ join ", " paramText ++ ")" ++ resultText
        let header := if fits 0 flat then flat else "function " ++ name ++ gen ++ "(" ++
          Text.concat (List.map (fun x => "\n  " ++ x ++ ",") paramText) ++ "\n)" ++ resultText
        Ts.docComment doc ++ header ++ " " ++ functionBody p b env 0

/-- A block in expression position: `do { … }`, whose last statement is its value. -/
def Ts.doBlock (p : Printer) (t : Sexp) (env : List Text) (ind : Int) : Text := "do {\n" ++ spaces (ind + 2) ++ Ts.stmts p t env (ind + 2) false ++ "\n" ++ spaces ind ++ "}"

--
-- Declarations.
--
def Ts.docComment (doc : Option Text) : Text :=
  match doc with
  | Option.some d => "/** " ++ d ++ " */\n"
  | Option.none => ""

def Ts.expr (p : Printer) (t : Sexp) (env : List Text) (ind : Int) (prec : Int) : Text :=
  match t with
  | Sexp.list (Sexp.sym "var" :: Sexp.int i :: []) => getOr (get? env i) ("$" ++ toText i)
  | Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) => refName p h env
  | Sexp.list (Sexp.sym "int" :: Sexp.int v :: []) => if v < 0 then paren 95 prec (toText v) else toText v
  | Sexp.list (Sexp.sym "text" :: Sexp.str v :: []) => quoteText v
  | Sexp.list (Sexp.sym "prim" :: Sexp.str name :: []) => "prim(" ++ quoteText name ++ ")"
  | Sexp.list (Sexp.sym "con" :: Sexp.str ty :: Sexp.int tag :: _ :: []) => Ts.conName p ty tag
  | Sexp.list (Sexp.sym "op" :: Sexp.str a :: Sexp.int index :: _ :: []) => nameFor p (a ++ "!" ++ toText index)
  | Sexp.list (Sexp.sym "if" :: a :: b :: Sexp.list (Sexp.sym "con" :: Sexp.str "#Bool" :: Sexp.int 0 :: _ :: []) :: []) => paren 35 prec (Ts.expr p a env ind 36 ++ " && " ++ Ts.expr p b env ind 35)
  | Sexp.list (Sexp.sym "if" :: a :: Sexp.list (Sexp.sym "con" :: Sexp.str "#Bool" :: Sexp.int 1 :: _ :: []) :: b :: []) => paren 30 prec (Ts.expr p a env ind 31 ++ " || " ++ Ts.expr p b env ind 30)
  | Sexp.list (Sexp.sym "if" :: c :: yes :: no :: []) => if isStatement t then doBlock p t env ind else paren
      5
      prec
      (Ts.expr p c env ind 6 ++ " ? " ++ Ts.expr p yes env ind 5 ++ " : " ++ Ts.expr p no env ind 5)
  | Sexp.list (Sexp.sym "lam" :: _) =>
      match Ts.params p t env with
      | (names, b, env2) =>
          let rendered := if isStatement b then functionBody p b env2 ind else Ts.expr p b env2 ind 1
          -- A generated name (`x0`) the body never mentions was `_` in the source.
          let shown := List.map
            (fun x => if isGenerated x && not (Print.mentions x rendered) then "_" else x)
            names
          -- A lone ignored parameter reads as none: JavaScript drops extra arguments.
          let paramText := if shown == ["_"] then "" else join ", " shown
          paren 1 prec ("(" ++ paramText ++ ") => " ++ rendered)
  | Sexp.list (Sexp.sym "app" :: f :: args) =>
      match (f, args) with
      | (Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []), a :: []) =>
          match Map.lookup h p.fieldNames with
          | Option.some field => Ts.expr p a env ind 100 ++ "." ++ field
          | Option.none => Ts.application p f args env ind prec
      | (Sexp.list (Sexp.sym "prim" :: Sexp.str name :: []), a :: b :: []) =>
          match Ts.infixOf name with
          | Option.some (op, level) =>
              let supply := Ref.get p.supply
              let fresh := Ref.get p.fresh
              let flat := Ts.expr p a env ind level ++ " " ++ op ++ " " ++ Ts.expr p b env ind (level + 1)
              if fits ind flat then paren level prec flat else
                Ref.set p.supply supply
                Ref.set p.fresh fresh
                let left := Ts.expr p a env ind level
                paren level prec (left ++ " " ++ op ++ "\n" ++ spaces (ind + 2) ++
                  Ts.expr p b env (ind + 2) (level + 1))
          | Option.none => Ts.application p f args env ind prec
      | (Sexp.list (Sexp.sym "prim" :: Sexp.str "Int.neg" :: []), a :: []) => paren 95 prec ("-" ++ Ts.expr p a env ind 100)
      | (Sexp.list (Sexp.sym "con" :: Sexp.str "#Pair" :: Sexp.int 0 :: Sexp.int 2 :: []), _ :: _ :: []) => Ts.sequence p "#[" (Print.tupleItems t) env ind
      | (Sexp.list (Sexp.sym "con" :: Sexp.str "#List" :: Sexp.int 1 :: Sexp.int 2 :: []), h :: rest :: []) =>
          match listItems t with
          | Option.some items => Ts.sequence p "[" items env ind
          | Option.none => "[" ++ Ts.expr p h env ind 0 ++ ", ..." ++ Ts.expr p rest env ind 100 ++ "]"
      | _ => Ts.application p f args env ind prec
  | _ => if isBlock t then doBlock p t env ind else paren 100 prec (Sexp.print t)

def Ts.final (p : Printer) (t : Sexp) (env : List Text) (ind : Int) (ret : Bool) : Text := (if ret then "return " else "") ++ Ts.expr p t env ind 0 ++ ";"

/-- `{` statements returning the value `}`. -/
def Ts.functionBody (p : Printer) (b : Sexp) (env : List Text) (ind : Int) : Text := "{\n" ++ spaces (ind + 2) ++ Ts.stmts p b env (ind + 2) true ++ "\n" ++ spaces ind ++ "}"

test Ts.functionWithReturn :=
  let p := printer Map.empty ["n"]
  Ts.definition
    p
    "f"
    (Sexp.read "(lam (app (prim \"Int.add\") (var 0) (int 1)))")
    (Option.some (Sexp.read "(tfun (tref \"#Int\") (tref \"#Int\"))"))
    Option.none == "function f(n: Int): Int {\n  return n + 1;\n}"

def Ts.generics (args : List Text) : Text := if List.isEmpty args then "" else "<" ++ join ", " args ++ ">"

/-- Whether a function type's result carries effects: `uses` lists them with commas, so in a list the type needs parentheses. -/
def Ts.hasUses (result : Sexp) : Bool :=
  match result with
  | Sexp.list (Sexp.sym "teff" :: Sexp.list (Sexp.sym "eff" :: effs) :: _ :: []) => not (List.isEmpty effs)
  | _ => false

/-- `if (c) { … } else if (d) { … } else { … }`. -/
def Ts.ifStatement (p : Printer) (c : Sexp) (yes : Sexp) (no : Sexp) (env : List Text) (ind : Int) (ret : Bool) : Text :=
  let nl := "\n" ++ spaces ind
  let cond := Ts.expr p c env ind 0
  let yesText := Ts.stmts p yes env (ind + 2) ret
  let rest :=
    match no with
    | Sexp.list (Sexp.sym "if" :: c2 :: yes2 :: no2 :: []) => if isPlainIf no then " else " ++ Ts.ifStatement p c2 yes2 no2 env ind ret else " else {\n" ++ spaces (ind + 2) ++ Ts.stmts p no env (ind + 2) ret ++ nl ++ "}"
    | _ => " else {\n" ++ spaces (ind + 2) ++ Ts.stmts p no env (ind + 2) ret ++ nl ++ "}"
  "if (" ++ cond ++ ") {\n" ++ spaces (ind + 2) ++ yesText ++ nl ++ "}" ++ rest

/-- An infix operator: DEUS's, except that text and list append read as `+`. -/
def Ts.infixOf (name : Text) : Option (Text, Int) := if name == "append" then Option.some ("+", 65) else Print.infixOf name

/-
  The TypeScript-like dialect (D70): Core printed as JS/TS-shaped text, one more view of the same
  codebase. DEUS stays the primary syntax; this one is for reading. Locals are named by the
  printer's supply in the order `Print` draws them, so both dialects show the author's names.
-/
/-- Whether a term is an `if` that `&&` and `||` do not cover. -/
def Ts.isPlainIf (t : Sexp) : Bool :=
  match t with
  | Sexp.list (Sexp.sym "if" :: _ :: _ :: Sexp.list (Sexp.sym "con" :: Sexp.str "#Bool" :: Sexp.int 0 :: _ :: []) :: []) => false
  | Sexp.list (Sexp.sym "if" :: _ :: Sexp.list (Sexp.sym "con" :: Sexp.str "#Bool" :: Sexp.int 1 :: _ :: []) :: _ :: []) => false
  | Sexp.list (Sexp.sym "if" :: _) => true
  | _ => false

/-- Whether a term prints as statements: a block, or an `if` whose branch is one. -/
def Ts.isStatement (t : Sexp) : Bool := isBlock t || isPlainIf t && any Ts.isStatement (List.drop 1 (Sexp.args t))

def Ts.isUnknown (t : Sexp) : Bool := head t == "tvar" && Sexp.args t == [Sexp.str "?"]

test Ts.letBecomesConst :=
  let p := printer Map.empty ["x", "y"]
  Ts.stmts p (Sexp.read "(let (int 1) (let (var 0) (var 1)))") [] 0 true ==
    "const x = 1;\nconst y = x;\nreturn x;"

/-- `function go(x, y) { … }` for a local recursive function. -/
def Ts.localFunction (p : Printer) (name : Text) (fn : Sexp) (env : List Text) (ind : Int) : Text :=
  match Ts.params p fn env with
  | (names, b, env2) => "function " ++ name ++ "(" ++ join ", " names ++ ") " ++ functionBody p b env2 ind

/-- Parameters of a run of lambdas, named in order, with the body and its environment. -/
def Ts.params (p : Printer) (t : Sexp) (env : List Text) : (List Text, (Sexp, List Text)) :=
  let rec go x env2 acc :=
    match x with
    | Sexp.list (Sexp.sym "lam" :: b :: []) =>
        let name := Print.bind p env2
        go b (name :: env2) (name :: acc)
    | _ => (reverse acc, x, env2)
  go t env []

--
-- Patterns.
--
def Ts.pattern (p : Printer) (pat : Sexp) (env : List Text) : (Text, List Text) :=
  match pat with
  | Sexp.list (Sexp.sym "pany" :: []) => ("_", env)
  | Sexp.list (Sexp.sym "pvar" :: []) =>
      let name := Print.bind p env
      (name, name :: env)
  | Sexp.list (Sexp.sym "pas" :: inner :: []) =>
      let name := Print.bind p env
      match Ts.pattern p inner (name :: env) with
      | (text, env2) => (name ++ " @ " ++ text, env2)
  | Sexp.list (Sexp.sym "pint" :: Sexp.int v :: []) => (toText v, env)
  | Sexp.list (Sexp.sym "ptext" :: Sexp.str v :: []) => (quoteText v, env)
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str ty :: Sexp.int tag :: subs) => if ty == "#List" && tag == 1 || ty == "#Pair" then
      match subs with
      | a :: b :: [] =>
          match Ts.pattern p a env with
          | (at, env2) =>
              match Ts.pattern p b env2 with
              | (bt, env3) =>
                  -- `[h, ...[x, ...t]]` reads as `[h, x, ...t]`, and nested pairs as one tuple.
                  let opener := if ty == "#Pair" then "#[" else "["
                  let sameKind :=
                    match b with
                    | Sexp.list (Sexp.sym "pcon" :: Sexp.str ty2 :: _) => ty2 == ty
                    | _ => false
                  if ty == "#List" && bt == "[]" then ("[" ++ at ++ "]", env3) else if sameKind then (opener ++ at ++ ", " ++ Text.drop (Text.length opener) bt, env3) else if ty == "#Pair" then ("#[" ++ at ++ ", " ++ bt ++ "]", env3) else ("[" ++ at ++ ", ..." ++ bt ++ "]", env3)
      | _ => ("?", env)
    else
      let rec go rest env2 acc :=
        match rest with
        | [] => (reverse acc, env2)
        | x :: more =>
            match Ts.pattern p x env2 with
            | (text, env3) => go more env3 (text :: acc)
      match go subs env [] with
      | (texts, env2) =>
          let name := Ts.conName p ty tag
          if List.isEmpty texts then (name, env2) else (name ++ "(" ++ join ", " texts ++ ")", env2)
  | _ => (Sexp.print pat, env)

/-- `[a, b]` or `#[a, b]` on one line when it fits, else one item per line. -/
def Ts.sequence (p : Printer) (opener : Text) (items : List Sexp) (env : List Text) (ind : Int) : Text :=
  let supply := Ref.get p.supply
  let fresh := Ref.get p.fresh
  let flat := opener ++ join ", " (List.map (fun x => Ts.expr p x env ind 0) items) ++ "]"
  if fits ind flat || List.length items < 2 then flat else
    Ref.set p.supply supply
    Ref.set p.fresh fresh
    opener ++
      Text.concat (List.map (fun x => "\n" ++ spaces (ind + 2) ++ Ts.expr p x env (ind + 2) 0 ++ ",") items) ++ "\n" ++ spaces ind ++ "]"

/-- Statements at indentation `ind`; the last returns its value when `ret`, else ends with `;`. -/
def Ts.stmts (p : Printer) (t : Sexp) (env : List Text) (ind : Int) (ret : Bool) : Text :=
  let nl := "\n" ++ spaces ind
  match t with
  | Sexp.list (Sexp.sym "let" :: v :: b :: []) =>
      let name := Print.bind p env
      let value := Ts.expr p v env ind 0
      "const " ++ name ++ " = " ++ value ++ ";" ++ nl ++ Ts.stmts p b (name :: env) ind ret
  | Sexp.list (Sexp.sym "seq" :: a :: b :: []) =>
      -- A `let` before `;` scopes over that statement only, so it keeps a block of its own.
      let first := if head a == "match" || head a == "handle" || isPlainIf a then Ts.stmts p a env ind false else Ts.expr p a env ind 0 ++ ";"
      first ++ nl ++ Ts.stmts p b env ind ret
  | Sexp.list (Sexp.sym "letrec" :: Sexp.list fns :: b :: []) =>
      let names := List.map (fun _ => Print.bind p env) fns
      let inner := reverse names ++ env
      let defs := List.map (fun pair =>
        match pair with
        | (name, fn) => localFunction p name fn inner ind) (zip names fns)
      join nl defs ++ nl ++ Ts.stmts p b inner ind ret
  | Sexp.list (Sexp.sym "match" :: scrut :: cases) =>
      let scrutText := Ts.expr p scrut env ind 0
      let arms := List.map (fun c =>
        match c with
        | Sexp.list (Sexp.sym "case" :: pat :: b :: []) =>
            match Ts.pattern p pat env with
            | (text, env2) => nl ++ "  " ++ (if text == "_" then "default" else "case " ++ text) ++ ":\n" ++
                spaces (ind + 4) ++ Ts.stmts p b env2 (ind + 4) ret
        | _ => "") cases
      "switch (" ++ scrutText ++ ") {" ++ Text.concat arms ++ nl ++ "}"
  | Sexp.list (Sexp.sym "handle" :: b :: clauses) =>
      let bodyText := Ts.stmts p b env (ind + 2) ret
      let rendered := List.map (fun c =>
        match c with
        | Sexp.list (Sexp.sym "ret" :: rb :: []) =>
            let name := Print.bind p env
            nl ++ "  return(" ++ name ++ ") {\n" ++ spaces (ind + 4) ++
              Ts.stmts p rb (name :: env) (ind + 4) ret ++ nl ++ "  }"
        | Sexp.list (Sexp.sym "on" :: Sexp.str a :: Sexp.int index :: Sexp.int arity :: hb :: []) =>
            let rec args k env2 acc := if k == 0 then (reverse acc, env2) else
              let name := Print.bind p env2
              args (k - 1) (name :: env2) (name :: acc)
            match args arity env [] with
            | (names, env2) =>
                let k := Print.bind p env2
                nl ++ "  " ++ nameFor p (a ++ "!" ++ toText index) ++ "(" ++
                  join ", " (names ++ [k]) ++ ") {\n" ++ spaces (ind + 4) ++ Ts.stmts p hb (k :: env2) (ind + 4) ret ++ nl ++ "  }"
        | _ => "") clauses
      "try {\n" ++ spaces (ind + 2) ++ bodyText ++ nl ++ "} handle {" ++ Text.concat rendered ++ nl ++
        "}"
  | Sexp.list (Sexp.sym "if" :: c :: yes :: no :: []) => if isPlainIf t && (isStatement yes || isStatement no || isPlainIf no) then ifStatement p c yes no env ind ret else final p t env ind ret
  | _ => final p t env ind ret

/-- `test("name", () => …);`. -/
def Ts.testDecl (p : Printer) (name : Text) (body : Sexp) : Text :=
  let rendered := if isStatement body then functionBody p body [] 0 else Ts.expr p body [] 0 1
  "test(" ++ quoteText name ++ ", () => " ++ rendered ++ ");"

/-- `theorem name(x: T): prop by tactic;`. -/
def Ts.theoremDecl (p : Printer) (name : Text) (types : List Sexp) (prop : Sexp) (proof : Sexp) : Text :=
  match Ts.params p prop [] with
  | (names, b, env) =>
      let binders := List.map (fun pair => fst pair ++ ": " ++ Ts.ty p (snd pair) 3) (zip names types)
      let tactic := List.map (fun x =>
        match x with
        | Sexp.list (Sexp.sym "ref" :: Sexp.str l :: []) => nameFor p l
        | _ => asText x) (Sexp.args proof)
      let proofText := if tactic == ["sorry"] then "sorry" else "by " ++ replace " ," "," (replace "[ " "[" (replace " ]" "]" (join " " tactic)))
      "theorem " ++ name ++ "(" ++ join ", " binders ++ "): " ++ Ts.expr p b env 2 0 ++ " " ++
        proofText ++ ";"

test Ts.tuplePattern :=
  let p := printer Map.empty ["a", "b"]
  fst (Ts.pattern p (Sexp.read "(pcon \"#Pair\" 0 (pvar) (pvar))") []) == "#[a, b]"

/-- A type; `prec` 3 is a comma-separated position, where an effectful function type is parenthesized. -/
def Ts.ty (p : Printer) (t : Sexp) (prec : Int) : Text :=
  match t with
  | Sexp.list (Sexp.sym "tapp" :: Sexp.list (Sexp.sym "tref" :: Sexp.str "#Pair" :: []) :: args) => "#[" ++ join ", " (List.map (fun x => Ts.ty p x 3) args) ++ "]"
  | Sexp.list (Sexp.sym "tapp" :: f :: args) => Ts.ty p f 100 ++ "<" ++ join ", " (List.map (fun x => Ts.ty p x 3) args) ++ ">"
  | Sexp.list (Sexp.sym "tfun" :: _) =>
      match Ts.arrows t with
      | (args, result) =>
          -- `Unit -> a` reads as `() => a`, as `f(())` reads as `f()`.
          let argText := if args == [Sexp.node "tref" [Sexp.str "#Unit"]] then "" else join ", " (List.map (fun x => Ts.ty p x 3) args)
          paren
            (if hasUses result then 2 else 10)
            prec
            ("(" ++ argText ++ ") => " ++ Ts.ty p result 0)
  | Sexp.list (Sexp.sym "trow" :: effs) => uses p effs
  | Sexp.list (Sexp.sym "teff" :: Sexp.list (Sexp.sym "eff" :: effs) :: b :: []) => if List.isEmpty effs then Ts.ty p b prec else Ts.ty p b 11 ++ " uses " ++ uses p effs
  | _ => Print.ty p t prec

/-- `interface T<a> { f: F; }` for a structure, `type T<a> = | c(F) …` for an inductive type. -/
def Ts.typeDecl (p : Printer) (ns : Map Text Entry) (name : Text) (e : Entry) (obj : Sexp) (meta : Option Sexp) : Text :=
  match (e, Sexp.args obj) with
  | (Entry.type h iri fields, _ :: Sexp.int count :: _) =>
      let names := paramsFor meta count obj
      let fieldNames := fieldNamesFor meta
      let ctors := List.map (nameParams names) (View.typeArgs obj)
      if not (List.isEmpty fields) then
        let types := getOr (Option.map Sexp.args (head? ctors)) []
        let lines := List.map (fun pair =>
          match pair with
          | (f, t) => "  " ++ f ++ ": " ++ Ts.ty p t 0 ++ ";") (zip fields (List.drop 1 types))
        decorator iri name ++ "interface " ++ name ++ Ts.generics names ++ " {\n" ++ join "\n" lines ++
          "\n}"
      else
        let ctorNames := filterMap (fun pair =>
          match pair with
          | (n, Entry.ctor t tag _) => if t == h then Option.some (tag, lastSegment n) else Option.none
          | _ => Option.none) (Map.toList ns)
        let lines := mapIndexed (fun tag c =>
          let cname := getOr (List.lookup tag ctorNames) ("ctor" ++ toText tag)
          let fieldTypes := List.drop 1 (Sexp.args c)
          let named := getOr (get? fieldNames tag) []
          let field := fun pair =>
            match getOr (get? named (fst pair)) "" with
            | "" => Ts.ty p (snd pair) 3
            | fieldName => fieldName ++ ": " ++ Ts.ty p (snd pair) 3
          let args := List.map field (mapIndexed (fun i t => (i, t)) fieldTypes)
          "  | " ++ cname ++ (if List.isEmpty args then "" else "(" ++ join ", " args ++ ")")) ctors
        decorator iri name ++ "type " ++ name ++ Ts.generics names ++ " =" ++
          (if List.isEmpty lines then " never;" else "\n" ++ join "\n" lines ++ ";")
  | _ => Sexp.print obj

/-- Type variables in order of first occurrence, under the names `ty` prints. -/
def Ts.typeVars (t : Sexp) : List Text :=
  let rec go x acc :=
    match x with
    | Sexp.list (Sexp.sym "tvar" :: Sexp.str "?" :: []) => acc
    | Sexp.list (Sexp.sym "tvar" :: Sexp.str n :: []) => if List.contains n acc then acc else acc ++ [n]
    | Sexp.list (Sexp.sym "tvar" :: Sexp.int i :: []) =>
        let n := fromCode (97 + i)
        if List.contains n acc then acc else acc ++ [n]
    | Sexp.list items => foldl (fun a2 item => go item a2) acc items
    | _ => acc
  go t []

/-- Whether the only argument is unit: `f(())` reads as `f()`. -/
def Ts.unitOnly (args : List Sexp) : Bool :=
  match args with
  | Sexp.list (Sexp.sym "con" :: Sexp.str "#Unit" :: _ :: _ :: []) :: [] => true
  | _ => false

/-- An effect row: `IO, Throw<Text>`, with a row variable as a spread (`...r`). -/
def Ts.uses (p : Printer) (effs : List Sexp) : Text :=
  let tails := List.filter (fun x => head x == "tvar") effs
  let named := List.filter (fun x => head x != "tvar") effs
  join
    ", "
    (List.map (fun x => Ts.ty p x 3) named ++ List.map (fun x => "..." ++ Ts.ty p x 3) tails)
