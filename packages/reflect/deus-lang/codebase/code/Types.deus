--
-- The environment: what the checker knows about hashes.
--
/-- Lookups the checker needs: objects and metadata by hash, schemes of definitions in this batch.
  Reading the store may fail or perform the caller's abilities, `r`. -/
structure Types.TypeEnv r where
  object : Text -> {Throw Text | r} Option Sexp
  meta : Text -> {Throw Text | r} Option Sexp
  group : Ref (Map Text TType)
  schemes : Ref (Map Text Sexp)
  prims : Text -> {Throw Text | r} Option Sexp

/-- An application `f a₁ … aₙ`. -/
def Types.application (u : Unifier) (env : TypeEnv {r}) (f : Sexp) (args : List Sexp) (locals : List TType) (row : TRow) : {Throw Text | r} TType :=
  let tf := Types.infer u env f locals row
  -- Bidirectional: when the callee's arrows are known, check plain arguments (they may bind the
  -- callee's row variables), link the rows to the context, then check lambdas against the
  -- parameter types so a callback runs in its caller's row.
  let rec peel t n acc := if n == 0 then Option.some (reverse acc, t) else
    match Types.resolve u t with
    | TType.fn a r b => peel b (n - 1) ((a, r) :: acc)
    | _ => Option.none
  match peel tf (List.length args) [] with
  | Option.some (params, result) =>
      let pairs := zip params args
      let isLambda := fun pair => head (snd pair) == "lam"
      forEach
        (List.filter (fun pair => not (isLambda pair)) pairs)
        (fun pair => checkAgainst u env (snd pair) (fst (fst pair)) locals row)
      forEach params (fun pair => subRow u (snd pair) row)
      forEach
        (List.filter isLambda pairs)
        (fun pair => checkAgainst u env (snd pair) (fst (fst pair)) locals row)
      result
  | Option.none => foldl (fun acc arg =>
      let ta := Types.infer u env arg locals row
      Types.call u acc ta row) tf args

def Types.bool : TType := TType.con "#Bool" []

/-- Applies a function type to an argument: the callee's effects must be contained in the context's. -/
def Types.call (u : Unifier) (callee : TType) (arg : TType) (row : TRow) : {Throw Text} TType :=
  match Types.resolve u callee with
  | TType.fn a r b =>
      Types.unify u a arg
      subRow u r row
      b
  | other =>
      let result := freshType u
      Types.unify u other (TType.fn arg row result)
      result

/-- Checks a term against an expected type; a lambda takes its parameter and row from it. -/
def Types.checkAgainst (u : Unifier) (env : TypeEnv {r}) (t : Sexp) (expected : TType) (locals : List TType) (row : TRow) : {Throw Text | r} Unit :=
  match (t, Types.resolve u expected) with
  | (Sexp.list (Sexp.sym "lam" :: b :: []), TType.fn a r result) => Types.checkAgainst u env b result (a :: locals) r
  | _ => Types.unify u expected (Types.infer u env t locals row)

/-- The signature's type and row variables must still be distinct variables: the definition is as
  general as declared, and performs no ability its written rows leave out. -/
def Types.checkRigid (u : Unifier) (vars : Ref (Map Text TType)) (rows : Ref (Map Text TRow)) : {Throw Text} Unit :=
  checkRigidTypes u vars
  let bound := List.map (fun pair => (fst pair, resolveRow u (snd pair))) (Map.toList (Ref.get rows))
  let ids := filterMap (fun pair =>
    match snd pair with
    | TRow.var id => Option.some id
    | _ => Option.none) bound
  match List.find (fun pair =>
    match snd pair with
    | TRow.var _ => false
    | _ => true) bound with
  | Option.some (name, r) => Throw.throw ("ability row " ++ name ++ " is declared as the caller's but the body performs " ++
      showRow (zonkRow u r) (Ref.new Map.empty))
  | Option.none => if List.length (dedup (sort ids)) != List.length ids then Throw.throw "two ability rows of the signature must be the same row" else ()

def Types.checkRigidTypes (u : Unifier) (vars : Ref (Map Text TType)) : {Throw Text} Unit :=
  let bound := List.map
    (fun pair => (fst pair, Types.resolve u (snd pair)))
    (List.filter (fun pair => fst pair != "?") (Map.toList (Ref.get vars)))
  let ids := filterMap (fun pair =>
    match snd pair with
    | TType.var id => Option.some id
    | _ => Option.none) bound
  match List.find (fun pair =>
    match snd pair with
    | TType.var _ => false
    | _ => true) bound with
  | Option.some (name, t) => Throw.throw ("type variable " ++ name ++ " is declared general but must be " ++
      showType (zonk u t) (Ref.new Map.empty) 0)
  | Option.none => if List.length (dedup (sort ids)) != List.length ids then Throw.throw "two type variables of the signature must be the same type" else ()

/-- Checks an inferred type against a written signature (variables must stay distinct). -/
def Types.checkSignature (u : Unifier) (inferred : TType) (sig : Sexp) : {Throw Text} Unit :=
  let vars := Ref.new Map.empty
  let declared := signatureType u sig vars (Ref.new Map.empty)
  Types.unify u inferred declared
  let bound := List.map
    (fun pair => Types.resolve u (snd pair))
    (List.filter (fun pair => fst pair != "?") (Map.toList (Ref.get vars)))
  let ids := filterMap (fun t =>
    match t with
    | TType.var id => Option.some id
    | _ => Option.none) bound
  if List.length ids != List.length bound || List.length (dedup (sort ids)) != List.length ids then Throw.throw ("does not have its declared type " ++ Types.display u declared) else ()

/-- A field's type with every arrow closed: one written without braces is pure (D55). -/
def Types.closeArrows (s : Sexp) : Sexp :=
  match s with
  | Sexp.list (Sexp.sym "tfun" :: a :: b :: []) => Sexp.list [Sexp.sym "tfun", Types.closeArrows a, Types.closeArrows b, Sexp.list [Sexp.sym "eff"]]
  | Sexp.list (Sexp.sym "tfun" :: a :: b :: effs :: []) => Sexp.list [Sexp.sym "tfun", Types.closeArrows a, Types.closeArrows b, effs]
  | Sexp.list items => Sexp.list (List.map Types.closeArrows items)
  | other => other

/-- The result type of a constructor pattern and its field types. -/
def Types.ctorFields (u : Unifier) (env : TypeEnv {r}) (typeHash : Text) (tag : Int) : (TType, List TType) :=
  let rec split t acc :=
    match t with
    | TType.fn a _ b => split b (a :: acc)
    | other => (other, reverse acc)
  split (ctorType u env typeHash tag) []

/-- A constructor's type: fields to the type, with the type's parameters fresh. -/
def Types.ctorType (u : Unifier) (env : TypeEnv {r}) (typeHash : Text) (tag : Int) : TType :=
  match object env typeHash with
  | Option.some (Sexp.list (Sexp.sym "type" :: Sexp.str iri :: Sexp.int count :: ctors)) =>
      let params := List.map (fun _ => freshType u) (range 0 count)
      let result := TType.con iri params
      match get? ctors tag with
      | Option.some (Sexp.list (Sexp.sym "ctor" :: _ :: fields)) =>
          -- Fields are closed: what a stored function may perform is what its field says (D55).
          List.foldr (fun f acc => TType.fn
            (Types.fromSexp u (closeArrows f) (Ref.new Map.empty) (Ref.new Map.empty) params false)
            (freshRow u)
            acc) result fields
      | _ => freshType u
  | _ => freshType u

def Types.display (u : Unifier) (t : TType) : Text := showType (zonk u t) (Ref.new Map.empty) 0

/-- A stored scheme as text, e.g. `(a -> b) -> List a -> List b`. -/
def Types.displayScheme (scheme : Sexp) : Text :=
  let u := newUnifier ()
  let t := zonk u (Types.fromSexp u scheme (Ref.new Map.empty) (Ref.new Map.empty) [] false)
  -- A row variable that occurs once constrains nothing and is not printed; a shared one is.
  let shared := List.filter (fun pair => snd pair > 1) (Map.toList (rowVarCounts t Map.empty))
  showTypeWith t (Ref.new Map.empty) 0 (Set.fromList (List.map fst shared))

def Types.fresh (u : Unifier) : Int :=
  let k := Ref.get u.next
  Ref.set u.next (k + 1)
  k

def Types.freshRow (u : Unifier) : TRow := TRow.var (Types.fresh u)

def Types.freshType (u : Unifier) : TType := TType.var (Types.fresh u)

/-- Instantiates a type written as Core (a signature, a field, an operation, a stored scheme). -/
def Types.fromSexp (u : Unifier) (s : Sexp) (vars : Ref (Map Text TType)) (rowVars : Ref (Map Text TRow)) (params : List TType) (openArrows : Bool) : TType :=
  let named := fun key =>
    match Map.lookup key (Ref.get vars) with
    | Option.some t => t
    | Option.none =>
        let t := freshType u
        Ref.set vars (Map.insert key t (Ref.get vars))
        t
  match s with
  | Sexp.list (Sexp.sym "tref" :: Sexp.str iri :: []) => TType.con iri []
  | Sexp.list (Sexp.sym "tvar" :: Sexp.int i :: []) => getOr (get? params i) (named ("#" ++ toText i))
  | Sexp.list (Sexp.sym "tvar" :: Sexp.str "?" :: []) => freshType u
  | Sexp.list (Sexp.sym "tvar" :: Sexp.str name :: []) => named name
  | Sexp.list (Sexp.sym "teff" :: _ :: t :: []) => Types.fromSexp u t vars rowVars params openArrows
  | Sexp.list (Sexp.sym "trow" :: effs) => TType.row (rowFromSexp u effs vars rowVars params false)
  | Sexp.list (Sexp.sym "tapp" :: Sexp.list (Sexp.sym "tref" :: Sexp.str iri :: []) :: args) => TType.con iri (List.map (fun a => Types.fromSexp u a vars rowVars params false) args)
  | Sexp.list (Sexp.sym "tapp" :: head :: args) =>
      -- Applying a type variable is beyond this checker; treat it as unknown.
      freshType u
  | Sexp.list (Sexp.sym "tfun" :: a :: b :: []) =>
      -- Only the spine is opened: an argument's row is a contract on what may be passed in.
      -- An arrow written without braces constrains nothing: its row is fresh wherever it appears.
      TType.fn
        (Types.fromSexp u a vars rowVars params false)
        (freshRow u)
        (Types.fromSexp u b vars rowVars params openArrows)
  | Sexp.list (Sexp.sym "tfun" :: a :: b :: Sexp.list (Sexp.sym "eff" :: effs) :: []) => TType.fn
      (Types.fromSexp u a vars rowVars params false)
      (rowFromSexp u effs vars rowVars params openArrows)
      (Types.fromSexp u b vars rowVars params openArrows)
  | _ => freshType u

/-- A definition's type: in this batch (monomorphic while its group is inferred), stored, or unknown. -/
def Types.globalType (u : Unifier) (env : TypeEnv {r}) (h : Text) : TType :=
  match Map.lookup h (Ref.get env.group) with
  | Option.some t => t
  | Option.none =>
      match Map.lookup h (Ref.get env.schemes) with
      | Option.some scheme => Types.instantiate u scheme
      | Option.none => Types.storedType u env h

/-- A deep handler: the body runs with the handled abilities added to the outer row; each clause
  gets the operation's arguments and a continuation that returns the handler's result. -/
def Types.handler (u : Unifier) (env : TypeEnv {r}) (body : Sexp) (clauses : List Sexp) (locals : List TType) (row : TRow) : {Throw Text | r} TType :=
  let abilities := dedup (sort (filterMap (fun c =>
    match c with
    | Sexp.list (Sexp.sym "on" :: Sexp.str a :: _) => Option.some a
    | _ => Option.none) clauses))
  -- One instantiation of each handled ability's parameters, shared by its clauses.
  let labels := List.map (fun a =>
    match object env a with
    | Option.some (Sexp.list (Sexp.sym "ability" :: Sexp.str iri :: Sexp.int count :: _)) => (a, TType.con iri (List.map (fun _ => freshType u) (range 0 count)))
    | _ => (a, TType.con a [])) abilities
  let bodyRow := List.foldr (fun pair acc => TRow.extend (snd pair) acc) row labels
  let tb := Types.infer u env body locals bodyRow
  let result := freshType u
  let hasReturn := any (fun c => head c == "ret") clauses
  if hasReturn then () else Types.unify u result tb
  forEach clauses (fun c =>
    match c with
    | Sexp.list (Sexp.sym "ret" :: rb :: []) => Types.unify u result (Types.infer u env rb (tb :: locals) row)
    | Sexp.list (Sexp.sym "on" :: Sexp.str a :: Sexp.int index :: Sexp.int arity :: hb :: []) =>
        let params :=
          match List.lookup a labels with
          | Option.some (TType.con _ ps) => ps
          | _ => []
        let rec args t k acc :=
          match (Types.resolve u t, k) with
          | (_, 0) => (reverse acc, t)
          | (TType.fn x _ y, _) => args y (k - 1) (x :: acc)
          | _ => (reverse acc, freshType u)
        match args (fst (opType u env a index params)) arity [] with
        | (argTypes, opResult) =>
            let k := TType.fn opResult row result
            Types.unify u result (Types.infer u env hb (k :: reverse argTypes ++ locals) row)
    | _ => ())
  result

def Types.hasLabel (u : Unifier) (r : TRow) (label : TType) : Bool :=
  match resolveRow u r with
  | TRow.extend l rest => labelIri (Types.resolve u l) == labelIri (Types.resolve u label) || Types.hasLabel u rest label
  | _ => false

--
-- Inference over Core.
--
def Types.infer (u : Unifier) (env : TypeEnv {r}) (t : Sexp) (locals : List TType) (row : TRow) : {Throw Text | r} TType :=
  match t with
  | Sexp.list (Sexp.sym "var" :: Sexp.int i :: []) => getOr (get? locals i) (freshType u)
  | Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) => globalType u env h
  | Sexp.list (Sexp.sym "int" :: _ :: []) => Types.int
  | Sexp.list (Sexp.sym "text" :: _ :: []) => Types.text
  | Sexp.list (Sexp.sym "prim" :: Sexp.str name :: []) =>
      match prims env name with
      | Option.some scheme => Types.instantiate u scheme
      | Option.none => freshType u
  | Sexp.list (Sexp.sym "con" :: Sexp.str ty :: Sexp.int tag :: _ :: []) => ctorType u env ty tag
  | Sexp.list (Sexp.sym "op" :: Sexp.str a :: Sexp.int index :: _ :: []) => fst (opType u env a index [])
  | Sexp.list (Sexp.sym "lam" :: b :: []) =>
      let a := freshType u
      let inner := freshRow u
      let result := Types.infer u env b (a :: locals) inner
      TType.fn a inner result
  | Sexp.list (Sexp.sym "app" :: f :: args) =>
      let callee :=
        match f with
        | Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) => if startsWith "@" h then Text.drop 1 h else "#" ++ Text.take 10 h
        | Sexp.list (Sexp.sym "op" :: _ :: Sexp.int i :: _ :: []) => "an ability operation"
        | Sexp.list (Sexp.sym "var" :: Sexp.int i :: []) => "a local function"
        | _ => ""
      catch
        (fun _ => Types.application u env f args locals row)
        (fun e => if callee == "" || Text.contains " (calling " e then Throw.throw e else Throw.throw (e ++ " (calling " ++ callee ++ ")"))
  | Sexp.list (Sexp.sym "let" :: v :: b :: []) => Types.infer u env b (Types.infer u env v locals row :: locals) row
  | Sexp.list (Sexp.sym "seq" :: a :: b :: []) =>
      Types.infer u env a locals row
      Types.infer u env b locals row
  | Sexp.list (Sexp.sym "letrec" :: Sexp.list fns :: b :: []) =>
      let vars := List.map (fun _ => freshType u) fns
      let inner := reverse vars ++ locals
      forEach
        (zip fns vars)
        (fun pair => Types.unify u (snd pair) (Types.infer u env (fst pair) inner row))
      Types.infer u env b inner row
  | Sexp.list (Sexp.sym "ann" :: ty :: e :: []) =>
      -- An ascription (D95): its variables are its own and flexible, and `e` is checked against it.
      let declared := signatureType u ty (Ref.new Map.empty) (Ref.new Map.empty)
      checkAgainst u env e declared locals row
      declared
  | Sexp.list (Sexp.sym "annlocal" :: ty :: e :: []) =>
      -- A lambda binder's ascription (D95): local 0 has the written type.
      Types.unify
        u
        (getOr (get? locals 0) (freshType u))
        (signatureType u ty (Ref.new Map.empty) (Ref.new Map.empty))
      Types.infer u env e locals row
  | Sexp.list (Sexp.sym "if" :: c :: yes :: no :: []) =>
      Types.unify u (Types.infer u env c locals row) Types.bool
      let ty := Types.infer u env yes locals row
      Types.unify u ty (Types.infer u env no locals row)
      ty
  | Sexp.list (Sexp.sym "match" :: scrut :: cases) =>
      let ts := Types.infer u env scrut locals row
      let result := freshType u
      forEach cases (fun c =>
        match c with
        | Sexp.list (Sexp.sym "case" :: pat :: body :: []) =>
            let binds := Types.pattern u env pat ts []
            Types.unify u result (Types.infer u env body (binds ++ locals) row)
        | Sexp.list (Sexp.sym "gcase" :: pat :: guard :: body :: []) =>
            let binds := Types.pattern u env pat ts []
            Types.unify u Types.bool (Types.infer u env guard (binds ++ locals) row)
            Types.unify u result (Types.infer u env body (binds ++ locals) row)
        | _ => ())
      result
  | Sexp.list (Sexp.sym "handle" :: body :: clauses) => handler u env body clauses locals row
  | _ => freshType u

def Types.instantiate (u : Unifier) (scheme : Sexp) : TType := Types.fromSexp u scheme (Ref.new Map.empty) (Ref.new Map.empty) [] true

def Types.int : TType := TType.con "#Int" []

/-- A type's display name from its IRI: the last segment after `/`, `:` and `.`, or a builtin without its `#`. -/
def Types.iriName (iri : Text) : Text := if startsWith "#" iri then Text.drop 1 iri else
  let afterSlash := getOr (last? (Text.split iri "/")) iri
  lastSegment (getOr (last? (Text.split afterSlash ":")) afterSlash)

def Types.labelIri (t : TType) : Text :=
  match t with
  | TType.con iri _ => iri
  | _ => ""

--
-- Unification.
--
def Types.mismatch (u : Unifier) (a : TType) (b : TType) : {Throw Text} x :=
  let seen := Ref.new Map.empty
  Throw.throw ("type mismatch: " ++ showType (zonk u a) seen 0 ++ " vs " ++ showType (zonk u b) seen 0)

def Types.newUnifier (u : Unit) : Unifier := Unifier.mk (MutMap.new ()) (MutMap.new ()) (Ref.new 0)

def Types.occurs (u : Unifier) (id : Int) (t : TType) : Bool :=
  match Types.resolve u t with
  | TType.var other => other == id
  | TType.con _ args => any (fun a => Types.occurs u id a) args
  | TType.fn a r b => Types.occurs u id a || occursInRow u id r || Types.occurs u id b
  | TType.row r => occursInRow u id r

def Types.occursInRow (u : Unifier) (id : Int) (r : TRow) : Bool :=
  match resolveRow u r with
  | TRow.extend l rest => Types.occurs u id l || Types.occursInRow u id rest
  | TRow.var other => other == id
  | TRow.empty => false

/-- An operation's type; its last arrow performs the ability (with the given parameters). -/
def Types.opType (u : Unifier) (env : TypeEnv {r}) (abilityHash : Text) (index : Int) (params : List TType) : (TType, TType) :=
  match object env abilityHash with
  | Option.some (Sexp.list (Sexp.sym "ability" :: Sexp.str iri :: Sexp.int count :: ops)) =>
      let ps := if List.length params == count then params else List.map (fun _ => freshType u) (range 0 count)
      let label := TType.con iri ps
      match get? ops index with
      | Option.some (Sexp.list (Sexp.sym "op" :: Sexp.int arity :: t :: [])) =>
          let rec build s k :=
            match s with
            | Sexp.list (Sexp.sym "tfun" :: a :: b :: _) =>
                let row := if k == 1 then TRow.extend label (freshRow u) else freshRow u
                TType.fn
                  (Types.fromSexp u a (Ref.new Map.empty) (Ref.new Map.empty) ps true)
                  row
                  (if k == 1 then Types.fromSexp u b (Ref.new Map.empty) (Ref.new Map.empty) ps true else build b (k - 1))
            | _ => Types.fromSexp u s (Ref.new Map.empty) (Ref.new Map.empty) ps true
          (build t arity, label)
      | _ => (freshType u, label)
  | _ => (freshType u, TType.con abilityHash [])

/-- The row a type's parameter `i` stands for; a parameter first used as a row becomes one. -/
def Types.paramRow (u : Unifier) (params : List TType) (i : Int) : TRow :=
  match Option.map (fun t => Types.resolve u t) (get? params i) with
  | Option.some (TType.row r) => r
  | Option.some (TType.var id) =>
      let r := freshRow u
      MutMap.set u.types id (TType.row r)
      r
  | _ => freshRow u

/-- Binds a pattern against a type; returns the bound variables' types, innermost first. -/
def Types.pattern (u : Unifier) (env : TypeEnv {r}) (pat : Sexp) (t : TType) (binds : List TType) : {Throw Text | r} List TType :=
  match pat with
  | Sexp.list (Sexp.sym "pany" :: []) => binds
  | Sexp.list (Sexp.sym "pvar" :: []) => t :: binds
  | Sexp.list (Sexp.sym "ann" :: ty :: p :: []) =>
      Types.unify u t (signatureType u ty (Ref.new Map.empty) (Ref.new Map.empty))
      Types.pattern u env p t binds
  | Sexp.list (Sexp.sym "pas" :: p :: []) => Types.pattern u env p t (t :: binds)
  | Sexp.list (Sexp.sym "pint" :: _ :: []) =>
      Types.unify u t Types.int
      binds
  | Sexp.list (Sexp.sym "ptext" :: _ :: []) =>
      Types.unify u t Types.text
      binds
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str ty :: Sexp.int tag :: subs) =>
      match Types.ctorFields u env ty tag with
      | (result, fields) =>
          Types.unify u t result
          -- An unknown constructor still binds every subpattern, or later variables would take earlier slots' types.
          let padded := fields ++ List.map (fun _ => freshType u) (List.drop (List.length fields) subs)
          foldl
            (fun acc pair => Types.pattern u env (fst pair) (snd pair) acc)
            binds
            (zip subs padded)
  | _ => binds

/-- Follows bound variables at the top of a type. -/
def Types.resolve (u : Unifier) (t : TType) : TType :=
  match t with
  | TType.var id =>
      match MutMap.get u.types id with
      | Option.some bound =>
          let r := Types.resolve u bound
          MutMap.set u.types id r
          r
      | Option.none => t
  | _ => t

def Types.resolveRow (u : Unifier) (r : TRow) : TRow :=
  match r with
  | TRow.var id =>
      match MutMap.get u.rows id with
      | Option.some bound => Types.resolveRow u bound
      | Option.none => r
  | _ => r

/-- The open tail of a row as written, if any. -/
def Types.resolveTail (r : TRow) : Option Int :=
  match r with
  | TRow.extend _ rest => Types.resolveTail rest
  | TRow.var id => Option.some id
  | TRow.empty => Option.none

/-- Finds `label`'s ability in a row: (its occurrence, the row without it). Extends an open tail. -/
def Types.rewriteRow (u : Unifier) (r : TRow) (label : TType) : {Throw Text} (TType, TRow) :=
  match resolveRow u r with
  | TRow.extend l rest => if labelIri (Types.resolve u l) == labelIri (Types.resolve u label) then (l, rest) else
      match Types.rewriteRow u rest label with
      | (found, rest2) => (found, TRow.extend l rest2)
  | TRow.var id =>
      let tail := freshRow u
      let l := label
      MutMap.set u.rows id (TRow.extend l tail)
      (l, tail)
  | TRow.empty => Throw.throw ("unhandled ability " ++ showType (zonk u label) (Ref.new Map.empty) 0)

/-- A row argument is always printed in braces, even when it is only a variable. -/
def Types.rowArgument (text : Text) (tail : Option Int) (seen : Ref (Map Text Text)) : Text := if text != "" then text else
  match tail with
  | Option.some id => "{" ++ varName seen ("r" ++ toText id) true ++ "}"
  | Option.none => "{}"

def Types.rowCounts (r : TRow) (acc : Map Int Int) : Map Int Int :=
  match r with
  | TRow.extend l rest => Types.rowCounts rest (rowVarCounts l acc)
  | TRow.var id => update id (fun old => getOr old 0 + 1) acc
  | TRow.empty => acc

def Types.rowFromSexp (u : Unifier) (effs : List Sexp) (vars : Ref (Map Text TType)) (rowVars : Ref (Map Text TRow)) (params : List TType) (openArrows : Bool) : TRow :=
  match effs with
  | [] =>
      -- Instantiating for a use opens every row (Koka's `open`): a function that performs E can be
      -- called wherever E and more may happen. A signature being checked keeps its rows closed.
      if openArrows then freshRow u else TRow.empty
  | Sexp.list (Sexp.sym "tvar" :: Sexp.str name :: []) :: [] =>
      match Map.lookup name (Ref.get rowVars) with
      | Option.some r => r
      | Option.none =>
          let r := freshRow u
          Ref.set rowVars (Map.insert name r (Ref.get rowVars))
          r
  | Sexp.list (Sexp.sym "tvar" :: Sexp.int i :: []) :: [] => paramRow u params i
  | e :: rest => TRow.extend
      (Types.fromSexp u e vars rowVars params false)
      (Types.rowFromSexp u rest vars rowVars params openArrows)

def Types.rowMismatch (u : Unifier) (a : TRow) (b : TRow) : {Throw Text} x :=
  let seen := Ref.new Map.empty
  Throw.throw ("ability mismatch: " ++ showRow (zonkRow u a) seen ++ " vs " ++ showRow (zonkRow u b) seen)

def Types.rowTailIs (u : Unifier) (id : Int) (r : TRow) : Bool :=
  match resolveRow u r with
  | TRow.extend _ rest => Types.rowTailIs u id rest
  | TRow.var other => other == id
  | TRow.empty => false

def Types.rowTailVar (u : Unifier) (r : TRow) : Option Int :=
  match resolveRow u r with
  | TRow.extend _ rest => Types.rowTailVar u rest
  | TRow.var id => Option.some id
  | TRow.empty => Option.none

def Types.rowToSexp (r : TRow) : Sexp :=
  let rec items row acc :=
    match row with
    | TRow.extend l rest => items rest (typeToSexp l :: acc)
    | TRow.var id => reverse (Sexp.node "tvar" [Sexp.str ("r" ++ toText id)] :: acc)
    | TRow.empty => reverse acc
  Sexp.node "eff" (items r [])

def Types.rowVarCounts (t : TType) (acc : Map Int Int) : Map Int Int :=
  match t with
  | TType.con _ args => foldl (fun m a => Types.rowVarCounts a m) acc args
  | TType.fn a r b => Types.rowVarCounts b (rowCounts r (Types.rowVarCounts a acc))
  | TType.var _ => acc
  | TType.row r => rowCounts r acc

--
-- Generalization and checking one group.
--
/-- Generalizes by printing: every remaining variable is quantified (top level has no free env). -/
def Types.scheme (u : Unifier) (t : TType) : Sexp := typeToSexp (zonk u t)

/-- Leijen's side condition: moving `label` out of `other` would extend a tail that `rest` shares,
  which can never terminate, so the rows differ. -/
def Types.sharedTailMissing (u : Unifier) (label : TType) (rest : TRow) (other : TRow) : Bool := not (hasLabel u other label) && isSome (rowTailVar u rest) && rowTailVar u rest == rowTailVar u other

/-- `{IO, Throw Text | e}`; an unconstrained row prints as nothing. -/
def Types.showRow (r : TRow) (seen : Ref (Map Text Text)) : Text :=
  let rec labels row acc :=
    match row with
    | TRow.extend l rest => labels rest (showType l seen 0 :: acc)
    | TRow.var id => (reverse acc, Option.some (varName seen ("r" ++ toText id) true))
    | TRow.empty => (reverse acc, Option.none)
  match labels r [] with
  | ([], Option.some _) => ""
  | ([], Option.none) => "{}"
  | (ls, Option.none) => "{" ++ join ", " ls ++ "}"
  | (ls, Option.some tail) => "{" ++ join ", " ls ++ " | " ++ tail ++ "}"

def Types.showRowWith (r : TRow) (seen : Ref (Map Text Text)) (shared : Map Int Unit) : Text :=
  let rec labels row acc :=
    match row with
    | TRow.extend l rest => labels rest (showTypeWith l seen 0 shared :: acc)
    | TRow.var id => (reverse acc, if Set.contains id shared then Option.some (varName seen ("r" ++ toText id) true) else Option.none, true)
    | TRow.empty => (reverse acc, Option.none, false)
  match labels r [] with
  | ([], Option.none, true) => ""
  | ([], Option.none, false) => "{}"
  | ([], Option.some tail, _) => "{" ++ tail ++ "}"
  | (ls, Option.none, _) => "{" ++ join ", " ls ++ "}"
  | (ls, Option.some tail, _) => "{" ++ join ", " ls ++ " | " ++ tail ++ "}"

def Types.showType (t : TType) (seen : Ref (Map Text Text)) (prec : Int) : Text :=
  match t with
  | TType.var id => varName seen ("t" ++ toText id) false
  | TType.con "#Pair" (a :: b :: []) => "(" ++ Types.showType a seen 0 ++ ", " ++ Types.showType b seen 0 ++ ")"
  | TType.con iri [] => iriName iri
  | TType.con iri args => paren
      90
      prec
      (iriName iri ++ Text.concat (List.map (fun a => " " ++ Types.showType a seen 100) args))
  | TType.fn a r b =>
      let rowText := showRow r seen
      paren
        10
        prec
        (Types.showType a seen 11 ++ " -> " ++ (if rowText == "" then "" else rowText ++ " ") ++
          Types.showType b seen 10)
  | TType.row r => rowArgument (showRow r seen) (resolveTail r) seen

def Types.showTypeWith (t : TType) (seen : Ref (Map Text Text)) (prec : Int) (shared : Map Int Unit) : Text :=
  match t with
  | TType.var id => varName seen ("t" ++ toText id) false
  | TType.con "#Pair" (a :: b :: []) => "(" ++ Types.showTypeWith a seen 0 shared ++ ", " ++ Types.showTypeWith b seen 0 shared ++ ")"
  | TType.con iri [] => iriName iri
  | TType.con iri args => paren 90 prec (iriName iri ++
      Text.concat (List.map (fun a => " " ++ Types.showTypeWith a seen 100 shared) args))
  | TType.fn a r b =>
      let rowText := showRowWith r seen shared
      paren 10 prec (Types.showTypeWith a seen 11 shared ++ " -> " ++
        (if rowText == "" then "" else rowText ++ " ") ++ Types.showTypeWith b seen 10 shared)
  | TType.row r => rowArgument (showRow r seen) (resolveTail r) seen

/-- A written row: closed, unless it ends in a named tail (`{IO | r}`), which the signature shares. -/
def Types.signatureRow (u : Unifier) (effs : List Sexp) (vars : Ref (Map Text TType)) (rowVars : Ref (Map Text TRow)) : TRow :=
  match effs with
  | [] => TRow.empty
  | Sexp.list (Sexp.sym "tvar" :: Sexp.str name :: []) :: [] =>
      match Map.lookup name (Ref.get rowVars) with
      | Option.some r => r
      | Option.none =>
          let r := freshRow u
          Ref.set rowVars (Map.insert name r (Ref.get rowVars))
          r
  | e :: rest => TRow.extend (signatureType u e vars rowVars) (Types.signatureRow u rest vars rowVars)

/-- A written signature: arrows without braces constrain nothing; written rows are closed. -/
def Types.signatureType (u : Unifier) (s : Sexp) (vars : Ref (Map Text TType)) (rowVars : Ref (Map Text TRow)) : TType :=
  match s with
  | Sexp.list (Sexp.sym "tfun" :: a :: b :: []) => TType.fn
      (Types.signatureType u a vars rowVars)
      (freshRow u)
      (Types.signatureType u b vars rowVars)
  | Sexp.list (Sexp.sym "tfun" :: a :: b :: Sexp.list (Sexp.sym "eff" :: effs) :: []) => TType.fn
      (Types.signatureType u a vars rowVars)
      (signatureRow u effs vars rowVars)
      (Types.signatureType u b vars rowVars)
  | Sexp.list (Sexp.sym "trow" :: effs) => TType.row (rowFromSexp u effs vars rowVars [] false)
  | Sexp.list (Sexp.sym "tapp" :: Sexp.list (Sexp.sym "tref" :: Sexp.str iri :: []) :: args) => TType.con iri (List.map (fun x => Types.signatureType u x vars rowVars) args)
  | _ => Types.fromSexp u s vars rowVars [] true

/-- A codebase definition's type: its inferred scheme, else its signature, else unknown. -/
def Types.storedType (u : Unifier) (env : TypeEnv {r}) (h : Text) : TType :=
  match metaField (meta env h) "scheme" with
  | Option.some scheme => Types.instantiate u scheme
  | Option.none =>
      match metaField (meta env h) "sig" with
      | Option.some sig => Types.fromSexp u sig (Ref.new Map.empty) (Ref.new Map.empty) [] true
      | Option.none => freshType u

/-- Row containment: every ability of `small` is in `big`. A row variable that is already the tail
  of `big` is contained (the context may do more); an unbound one becomes `big`. -/
def Types.subRow (u : Unifier) (small : TRow) (big : TRow) : {Throw Text} Unit :=
  match resolveRow u small with
  | TRow.empty => ()
  | TRow.extend l rest => if sharedTailMissing u l rest big then rowMismatch u small big else
      match rewriteRow u big l with
      | (found, big2) =>
          Types.unify u l found
          Types.subRow u rest big2
  | TRow.var t => if rowTailIs u t big then () else unifyRow u (TRow.var t) big

def Types.text : TType := TType.con "#Text" []

--
-- Schemes: types with quantified variables, stored as S-expressions in metadata.
--
def Types.typeToSexp (t : TType) : Sexp :=
  match t with
  | TType.con iri args => if List.isEmpty args then Sexp.node "tref" [Sexp.str iri] else Sexp.node "tapp" (Sexp.node "tref" [Sexp.str iri] :: List.map Types.typeToSexp args)
  | TType.fn a r b => Sexp.node "tfun" [Types.typeToSexp a, Types.typeToSexp b, rowToSexp r]
  | TType.var id => Sexp.node "tvar" [Sexp.str ("t" ++ toText id)]
  | TType.row r => Sexp.node "trow" (Sexp.args (rowToSexp r))

def Types.unify (u : Unifier) (a : TType) (b : TType) : {Throw Text} Unit :=
  match (Types.resolve u a, Types.resolve u b) with
  | (TType.var x, TType.var y) => if x == y then () else MutMap.set u.types x (TType.var y)
  | (TType.var x, t) => if Types.occurs u x t then Throw.throw "infinite type" else MutMap.set u.types x t
  | (t, TType.var y) => if Types.occurs u y t then Throw.throw "infinite type" else MutMap.set u.types y t
  | (TType.con i1 a1, TType.con i2 a2) => if i1 != i2 || List.length a1 != List.length a2 then mismatch u a b else forEach (zip a1 a2) (fun pair => Types.unify u (fst pair) (snd pair))
  | (TType.fn a1 r1 b1, TType.fn a2 r2 b2) =>
      Types.unify u a1 a2
      unifyRow u r1 r2
      Types.unify u b1 b2
  | (TType.row r1, TType.row r2) => unifyRow u r1 r2
  | (x, y) => mismatch u x y

def Types.unifyRow (u : Unifier) (a : TRow) (b : TRow) : {Throw Text} Unit :=
  match (resolveRow u a, resolveRow u b) with
  | (TRow.empty, TRow.empty) => ()
  | (TRow.var x, TRow.var y) => if x == y then () else MutMap.set u.rows x (TRow.var y)
  | (TRow.var x, r) => if rowTailIs u x r then rowMismatch u a b else MutMap.set u.rows x r
  | (r, TRow.var y) => if rowTailIs u y r then rowMismatch u a b else MutMap.set u.rows y r
  | (TRow.extend l rest, other) => if sharedTailMissing u l rest other then rowMismatch u a b else
      match rewriteRow u other l with
      | (found, other2) =>
          Types.unify u l found
          Types.unifyRow u rest other2
  | (TRow.empty, TRow.extend l _) => Throw.throw ("unexpected ability " ++ showType (zonk u l) (Ref.new Map.empty) 0)

def Types.unitT : TType := TType.con "#Unit" []

--
-- Printing (for errors and `view`).
--
/-- Names for type variables in order of appearance: a, b, …; rows: e, e1, …. -/
def Types.varName (seen : Ref (Map Text Text)) (key : Text) (row : Bool) : Text :=
  match Map.lookup key (Ref.get seen) with
  | Option.some name => name
  | Option.none =>
      let count := List.length (List.filter
        (fun pair => startsWith (if row then "r" else "t") (fst pair))
        (Map.toList (Ref.get seen)))
      let name := if row then if count == 0 then "e" else "e" ++ toText count else if count < 4 then fromCode ('a' + count) else "t" ++ toText count
      Ref.set seen (Map.insert key name (Ref.get seen))
      name

/-- Fully substituted type (for printing and generalizing). -/
def Types.zonk (u : Unifier) (t : TType) : TType :=
  match Types.resolve u t with
  | TType.con iri args => TType.con iri (List.map (fun a => Types.zonk u a) args)
  | TType.fn a r b => TType.fn (Types.zonk u a) (zonkRow u r) (Types.zonk u b)
  | TType.row r => TType.row (zonkRow u r)
  | v => v

def Types.zonkRow (u : Unifier) (r : TRow) : TRow :=
  match resolveRow u r with
  | TRow.extend l rest => TRow.extend (zonk u l) (Types.zonkRow u rest)
  | other => other
