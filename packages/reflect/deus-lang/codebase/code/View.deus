/-- R-3: an ability prints by its declared name. -/
theorem View.Spec.abilityByName : Map.lookup "urn:deus:mdl:Host" (declaredNames Spec.declared) == Option.some "MdlHost" := by rfl

/-- R-2: a builtin drops its `#`. -/
theorem View.Spec.builtinIri : iriName "#Int" == "Int" := by rfl

/-- A codebase declaring the ability `Mdl.MdlHost` as `urn:deus:mdl:Host` and the type `Tasks.Task` as `urn:deus:task:Task`. -/
def View.Spec.declared : Map Text Entry := Map.fromList [("Mdl.MdlHost", Entry.ability "h1" "urn:deus:mdl:Host"), ("Tasks.Task", Entry.type "h2" "urn:deus:task:Task" [])]

/-- L-1: the printed text compiles to the hash it was printed from. -/
theorem View.Spec.hypothesesRoundTrip : (match printed twoSource "u" with
  | Option.some (h, text) => Option.map fst (printed (text ++ "\n") "u") == Option.some h
  | Option.none => false) == true := by rfl

/-- R-1: one hypothesis. The printer is given no local names, so binders print as `x0`, `x1`. -/
theorem View.Spec.oneHypothesis : Spec.view oneSource "t" == "theorem t (x0 : Int) : x0 == 1 -> x0 + 1 == 2 := sorry" := by rfl

def View.Spec.oneSource : Text := "theorem t (x : Int) : x == 1 -> x + 1 == 2 := by sorry\n"

/-- R-2: an IRI with a path prints its last segment. -/
theorem View.Spec.pathIri : iriName "urn:deus:task:Task" == "Task" := by rfl

/-- R-2: a plain `urn:deus:` IRI is its name. -/
theorem View.Spec.plainIri : iriName "urn:deus:Tree" == "Tree" := by rfl

/-- The builtin types the sources use, declared by IRI as `deus/builtins.deus` does. -/
def View.Spec.prelude : Text := "inductive Int @\"#Int\" where\ninductive Bool @\"#Bool\" where\n  | false\n  | true\n"

/-- The theorem `name` in `source`, compiled alone: its hash and its printed declaration. -/
def View.Spec.printed (source : Text) (name : Text) : Option (Text, Text) :=
  match try (fun _ => batch
    Map.empty
    (fun _ => Option.none)
    (fun _ => Option.none)
    "strict"
    [parseFile "t.deus" (View.Spec.prelude ++ source)]) with
  | Result.ok b =>
      match List.lookup name b.entries with
      | Option.some (Entry.theorem h) =>
          match List.lookup h b.objects with
          | Option.some (Sexp.list (Sexp.sym "theorem" :: Sexp.list (Sexp.sym "binders" :: types) :: prop :: proof :: _)) => Option.some (h, View.theoremDecl (printer (Map.fromList b.entries) []) name types prop proof)
          | _ => Option.none
      | _ => Option.none
  | Result.err _ => Option.none

/-- `Task -> {Host} Int`, as a scheme stores it. -/
def View.Spec.scheme : Sexp := Sexp.list [Sexp.sym "tfun", Sexp.list [Sexp.sym "tref", Sexp.str "urn:deus:task:Task"], Sexp.list [Sexp.sym "tref", Sexp.str "#Int"], Sexp.list [Sexp.sym "eff", Sexp.list [Sexp.sym "tref", Sexp.str "urn:deus:mdl:Host"]]]

/-- R-1: hypotheses keep their order. -/
theorem View.Spec.twoHypotheses : Spec.view twoSource "u" ==
    "theorem u (x0 : Int) (x1 : Int) : x0 == 1 -> x1 == x0 -> x1 == 1 := sorry" := by rfl

def View.Spec.twoSource : Text := "theorem u (x : Int) (y : Int) : x == 1 -> y == x -> y == 1 := by sorry\n"

/-- R-3: a scheme naming the ability and the type prints both by name. -/
theorem View.Spec.typeByName : displaySchemeNamed (declaredNames Spec.declared) Spec.scheme == "Task -> {MdlHost} Int" := by rfl

/-- R-3: an IRI no name declares prints as its last segment. -/
theorem View.Spec.undeclaredByIri : displaySchemeNamed Map.empty Spec.scheme == "Task -> {Host} Int" := by rfl

def View.Spec.view (source : Text) (name : Text) : Text := getOr (Option.map snd (printed source name)) ""

/-- R-2: a web IRI prints its last path segment. -/
theorem View.Spec.webIri : iriName "https://dxos.org/deus/std/Shape" == "Shape" := by rfl

def View.abilityDecl (p : Printer) (ns : Map Text Entry) (name : Text) (e : Entry) (obj : Sexp) (meta : Option Sexp) : Text :=
  match (e, Sexp.args obj) with
  | (Entry.ability h iri, _ :: Sexp.int count :: rawOps) =>
      let names := paramsFor meta count obj
      let ops := List.map (nameParams names) rawOps
      let opNames := filterMap (fun pair =>
        match pair with
        | (n, Entry.op a index _) => if a == h then Option.some (index, lastSegment n) else Option.none
        | _ => Option.none) (Map.toList ns)
      let lines := mapIndexed (fun index op =>
        let oname := getOr (List.lookup index opNames) ("op" ++ toText index)
        match Sexp.args op with
        | _ :: t :: [] => "  " ++ oname ++ " : " ++ Print.ty p t 0
        | _ => "  " ++ oname) ops
      "ability " ++ name ++ View.params names ++ iriClause iri name ++ " where\n" ++ join "\n" lines
  | _ => Sexp.print obj

/-- Constructor field names from a type's metadata, one list per constructor (`""` for unnamed). -/
def View.fieldNamesFor (meta : Option Sexp) : List (List Text) := List.map (fun c => List.map asText (Sexp.args c)) (metaList meta "fields")

def View.iriClause (iri : Text) (name : Text) : Text := if iri == "urn:deus:" ++ name then "" else " @" ++ quoteText iri

/-- A type with its parameters (stored by index) under their chosen names. -/
def View.nameParams (names : List Text) (t : Sexp) : Sexp :=
  match t with
  | Sexp.list (Sexp.sym "tvar" :: Sexp.int i :: []) =>
      match get? names i with
      | Option.some n => Sexp.node "tvar" [Sexp.str n]
      | Option.none => t
  | Sexp.list items => Sexp.list (List.map (View.nameParams names) items)
  | _ => t

/-- Type variables a declaration names itself, such as an operation's own `a` in `throw : e -> a`. -/
def View.namedVars (t : Sexp) : List Text :=
  match t with
  | Sexp.list (Sexp.sym "tvar" :: Sexp.str n :: []) => [n]
  | Sexp.list items => concatMap View.namedVars items
  | _ => []

/-- Names for a declaration's `count` parameters: letters in order, skipping the names already used in it. -/
def View.paramNames (count : Int) (used : List Text) : List Text :=
  let rec pick k acc := if List.length acc >= count then reverse acc else
    let candidate := fromCode ('a' + k)
    if List.contains candidate used then pick (k + 1) acc else pick (k + 1) (candidate :: acc)
  pick 0 []

def View.params (names : List Text) : Text := Text.concat (List.map (fun n => " " ++ n) names)

/-- The author's parameter names from a type's metadata, or names chosen to avoid the ones in use. -/
def View.paramsFor (meta : Option Sexp) (count : Int) (obj : Sexp) : List Text :=
  let stored := List.map asText (metaList meta "params")
  if List.length stored == count then stored else paramNames count (namedVars obj)

/-- `theorem t (x : T) : prop := by tactic`. -/
def View.theoremDecl (p : Printer) (name : Text) (types : List Sexp) (prop : Sexp) (proof : Sexp) : Text :=
  let rec params t env acc :=
    match t with
    | Sexp.list (Sexp.sym "lam" :: b :: []) =>
        let x := Print.bind p env
        params b (x :: env) (x :: acc)
    | _ => (reverse acc, t, env)
  match params prop [] [] with
  | (names, b, env) =>
      let binders := Text.concat (List.map (fun pair =>
        match pair with
        | (x, t) => " (" ++ x ++ " : " ++ Print.ty p t 0 ++ ")") (zip names types))
      let tactic := List.map (fun x =>
        match x with
        | Sexp.list (Sexp.sym "ref" :: Sexp.str l :: []) => nameFor p l
        | _ => asText x) (Sexp.args proof)
      let proofText := if tactic == ["sorry"] then "sorry" else "by " ++ replace " ," "," (replace "[ " "[" (replace " ]" "]" (join " " tactic)))
      -- The parser reads `P -> Q` only at the top of a statement, as `implies`, so only there is it written back.
      let rec parts prop1 :=
        match prop1 with
        | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "prim" :: Sexp.str "implies" :: []) :: hyp :: rest :: []) => hyp :: parts rest
        | _ => [prop1]
      "theorem " ++ name ++ binders ++ " : " ++
        join " -> " (List.map (fun part => Print.expr p part env 2 0) (parts b)) ++ " := " ++ proofText

/-
  Printing declarations that are not plain definitions: types, abilities and theorems.
-/
def View.typeArgs (form : Sexp) : List Sexp := List.filter (fun x => head x == "ctor") (Sexp.args form)

/-- `inductive T where | c (F) …` or `structure T where f : F …`. -/
def View.typeDecl (p : Printer) (ns : Map Text Entry) (name : Text) (e : Entry) (obj : Sexp) (meta : Option Sexp) : Text :=
  match (e, Sexp.args obj) with
  | (Entry.type h iri fields, _ :: Sexp.int count :: _) =>
      let names := paramsFor meta count obj
      let fieldNames := fieldNamesFor meta
      let ctors := List.map (nameParams names) (View.typeArgs obj)
      let display := name
      if not (List.isEmpty fields) then
        let types := getOr (Option.map Sexp.args (head? ctors)) []
        let lines := List.map (fun pair =>
          match pair with
          | (f, t) => "  " ++ f ++ " : " ++ Print.ty p t 0) (zip fields (List.drop 1 types))
        "structure " ++ display ++ View.params names ++ iriClause iri name ++ " where\n" ++
          join "\n" lines
      else
        let ctorNames := filterMap (fun pair =>
          match pair with
          | (n, Entry.ctor t tag _) => if t == h then Option.some (tag, lastSegment n) else Option.none
          | _ => Option.none) (Map.toList ns)
        let lines := mapIndexed (fun tag c =>
          let cname := getOr (List.lookup tag ctorNames) ("ctor" ++ toText tag)
          let fieldTypes := List.drop 1 (Sexp.args c)
          let named := getOr (get? fieldNames tag) []
          let field := fun pair =>
            match getOr (get? named (fst pair)) "" with
            | "" => " " ++ Print.ty p (snd pair) 100
            | fieldName => " (" ++ fieldName ++ " : " ++ Print.ty p (snd pair) 0 ++ ")"
          "  | " ++ cname ++
            Text.concat (List.map field (mapIndexed (fun i t => (i, t)) fieldTypes))) ctors
        "inductive " ++ display ++ View.params names ++ iriClause iri name ++ " where" ++
          (if List.isEmpty lines then "" else "\n" ++ join "\n" lines)
  | _ => Sexp.print obj
