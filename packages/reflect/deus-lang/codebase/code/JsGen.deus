/-- The function being compiled: lines (newest first), indentation, fresh names, and the loop it may jump to. -/
structure JsGen.JsCtx @"urn:deus:jsgen:JsCtx" where
  jxMod : JsModule
  jxLines : Ref (List Text)
  jxDepth : Int
  jxUsed : MutMap Text Unit
  jxNext : Ref Int
  jxSelf : Option (Text, (Int, List Text))
  jxLooped : Ref Bool
  jxOwner : Text

/-- A definition in the module: hash, DEUS name for traces, JavaScript name, kind, dressed body, stored type. -/
structure JsGen.JsDef @"urn:deus:jsgen:JsDef" where
  jdHash : Text
  jdName : Text
  jdJs : Text
  jdKind : JsKind
  jdBody : Sexp
  jdType : Sexp

--
-- What the module holds.
--
/-- How a definition is compiled. -/
inductive JsGen.JsKind where
  | fn (arity : Int)
  | constant
  | importFn (module : Text) (path : Text) (arity : Int)
  | importValue (module : Text) (path : Text)
  | primitive (name : Text)

/-- The whole program: its definitions by hash, the namespace, and the JavaScript modules it imports. -/
structure JsGen.JsModule @"urn:deus:jsgen:JsModule" where
  jmDefs : Dict Text JsDef
  jmNs : Map Text Entry
  jmFetch : Text -> Option Sexp
  jmModules : List Text

--
-- Compiling one function.
--
/-- Where a statement's value goes. -/
inductive JsGen.JsTarget where
  | ret
  | assign (name : Text)
  | drop

ability JsGen.Spec.Ask where
  ask : Unit -> Int

inductive JsGen.Spec.Figure where
  | circle (r : Int)
  | rect (w : Int) (h : Int)

def JsGen.Spec.answer (body : Unit -> {Ask | r} a) : {r} a :=
  handle body () with
  | Ask.ask x0 -> k => k 21

def JsGen.Spec.counter (n : Int) : Int :=
  let cell := Ref.new 0
  forEach (range 0 n) (fun i => Ref.set cell (Ref.get cell + i))
  Ref.get cell

def JsGen.Spec.figureArea (s : Figure) : Int :=
  match s with
  | Figure.circle r => 3 * r * r
  | Figure.rect w h => w * h

theorem JsGen.Spec.mangleIsIdent (s : Text) : isIdent (mangle s) == true := by test 200

test JsGen.Spec.namesAreIdentifiers := mangle "App.main" == "App$main" && mangle "class" != "class" && isIdent (mangle "List.map'")

def JsGen.Spec.pickAbility : Text := "ability Pick where\n  pick : Unit -> Bool\n"

/-- The message the js target refuses `root` of `source` with, compiled over the spec prelude, or ""
  when it compiles. A definition named `Js.import` in `source` is the import binding. -/
def JsGen.Spec.refusal (source : Text) (root : Text) : Text :=
  match try (fun _ =>
    let built := batch
      Map.empty
      (fun _ => Option.none)
      (fun _ => Option.none)
      "strict"
      [parseFile "prelude.deus" Compile.Spec.prelude, parseFile "spec.deus" source]
    let objects := Map.fromList built.objects
    let metas := Map.fromList built.metas
    let ns := Map.fromList built.entries
    let jsImport :=
      match Map.lookup "Js.import" ns with
      | Option.some (Entry.term h) => h
      | _ => ""
    match Map.lookup root ns with
    | Option.some (Entry.term h) =>
        JsGen.compile
          (fun x => Map.lookup x objects)
          (fun x => Map.lookup x metas)
          (fun _ _ => "")
          ns
          jsImport
          [("main", h)]
          "./deus-runtime.mjs"
          "main.js.map"
        ""
    | _ => "no definition " ++ root) with
  | Result.ok message => message
  | Result.err message => message

test JsGen.Spec.refusesInlineImports :=
  let binding := "namespace Js\ndef import (module : Text) (path : Text) : a\nend Js\n"
  let inline := refusal (binding ++ "def pair (u : Unit) : (Int, Int) := (Js.import \"m\" \"p\", 1)\n") "pair"
  let bound := refusal (binding ++ "def value : Int := Js.import \"m\" \"p\"\n") "value"
  Text.contains "pair uses Js.import inside an expression" inline && bound == ""

test JsGen.Spec.refusesMultiShotHandlers :=
  let resumesTwice := refusal (pickAbility ++
    "def both (u : Unit) : Bool :=\n  handle Pick.pick () with\n  | Pick.pick x -> k => k (k Bool.true)\n") "both"
  let resumesOnce := refusal (pickAbility ++
    "def once (u : Unit) : Bool :=\n  handle Pick.pick () with\n  | Pick.pick x -> k => k Bool.true\n") "once"
  Text.contains "the handler for Pick.pick uses its continuation" resumesTwice && resumesOnce == ""

def JsGen.Spec.safeDiv (a : Int) (b : Int) : {Throw Text} Int := if b == 0 then Throw.throw "zero" else a / b

def JsGen.Spec.sumTo (n : Int) (acc : Int) : Int := if n == 0 then acc else JsGen.Spec.sumTo (n - 1) (acc + n)

def JsGen.Spec.twice (u : Unit) : {Ask} Int := Ask.ask () + Ask.ask ()

theorem JsGen.Spec.vlqRoundTrip (n : Int) : n > -100000000 -> n < 100000000 -> unvlq (vlq n) == n := by test 200

/-- The hashes of the abilities a body requests or handles. -/
def JsGen.abilitiesOf (form : Sexp) : List Text :=
  match form with
  | Sexp.list (Sexp.sym "op" :: Sexp.str a :: _ :: _ :: []) => [a]
  | Sexp.list (Sexp.sym "on" :: Sexp.str a :: rest) => a :: concatMap JsGen.abilitiesOf rest
  | Sexp.list items => concatMap JsGen.abilitiesOf items
  | _ => []

/-- The `rt.ability(…)` line for an ability: its IRI and operation names, for host handlers. -/
def JsGen.abilityLine (mod : JsModule) (a : Text) : Option Text := if startsWith "#" a then Option.none else
  match jmFetch mod a with
  | Option.some (Sexp.list (Sexp.sym "ability" :: Sexp.str iri :: _ :: ops)) =>
      let names := List.map
        (fun i => getOr (Option.map (fun pair => lastSegment (fst pair)) (List.find (fun pair =>
          match snd pair with
          | Entry.op owner index _ => owner == a && index == i
          | _ => false) (Map.toList mod.jmNs))) ("op" ++ toText i))
        (range 0 (List.length ops))
      Option.some ("rt.ability(" ++ JsGen.quote a ++ ", " ++ JsGen.quote iri ++ ", [" ++
        join ", " (List.map JsGen.quote names) ++ "]);")
  | _ => Option.none

def JsGen.app (ctx : JsCtx) (env : List Text) (f : Sexp) (args : List Sexp) : {Throw Text} Text :=
  let n := List.length args
  match f with
  | Sexp.list (Sexp.sym "prim" :: Sexp.str p :: []) =>
      let values := operands ctx env args
      match inlinePrim p values with
      | Option.some code => code
      | Option.none => "rt.ap(" ++ primValue p ++ ", " ++ join ", " values ++ ")"
  | Sexp.list (Sexp.sym "con" :: Sexp.str t :: Sexp.int tag :: Sexp.int k :: []) =>
      let values := operands ctx env args
      if k == n then if t == "#List" then "rt.cons(" ++ join ", " values ++ ")" else "new rt.Con(" ++ JsGen.quote t ++ ", " ++ toText tag ++ ", [" ++ join ", " values ++ "])" else "rt.ap(" ++ JsGen.expr ctx env f ++ ", " ++ join ", " values ++ ")"
  | Sexp.list (Sexp.sym "op" :: Sexp.str a :: Sexp.int i :: Sexp.int k :: []) =>
      let values := operands ctx env args
      if k == n then "rt.perform(" ++ JsGen.quote a ++ ", " ++ toText i ++ ", [" ++ join ", " values ++ "])" else "rt.ap(" ++ JsGen.expr ctx env f ++ ", " ++ join ", " values ++ ")"
  | Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) =>
      let d := lookupDef ctx h
      match d.jdKind with
      | JsKind.primitive p => JsGen.app ctx env (Sexp.list [Sexp.sym "prim", Sexp.str p]) args
      | _ =>
          let arity := refArity ctx h
          let values := operands ctx env args
          if arity == n then JsGen.call d.jdJs values else if arity > 0 && n > arity then "rt.ap(" ++ JsGen.call d.jdJs (List.take arity values) ++ ", " ++
            join ", " (List.drop arity values) ++ ")" else "rt.ap(" ++ refValue ctx h ++ ", " ++ join ", " values ++ ")"
  | _ =>
      match operands ctx env (f :: args) with
      | callee :: values => "rt.ap(" ++ callee ++ ", " ++ join ", " values ++ ")"
      | [] => Throw.throw "empty application"

/-- An arrow function of `names` whose body is `body`, compiled in its own scope (no self loop). -/
def JsGen.arrow (ctx : JsCtx) (env : List Text) (names : List Text) (body : Sexp) : {Throw Text} Text :=
  let inner := JsCtx.mk
    ctx.jxMod
    (Ref.new [])
    (ctx.jxDepth + 1)
    ctx.jxUsed
    ctx.jxNext
    Option.none
    (Ref.new false)
    ctx.jxOwner
  let head := "(" ++ join ", " names ++ ") =>"
  if needsStatements body then
    stmt inner (reverse names ++ env) body JsTarget.ret
    head ++ " {\n" ++ join "\n" (reverse (Ref.get inner.jxLines)) ++ "\n" ++ repeat ctx.jxDepth "  " ++
      "}"
  else
    let code := JsGen.expr inner (reverse names ++ env) body
    match Ref.get inner.jxLines with
    | [] => head ++ " " ++ (if startsWith "{" code then "(" ++ code ++ ")" else code)
    | lines => head ++ " {\n" ++ join "\n" (reverse lines) ++ "\n" ++ repeat (ctx.jxDepth + 1) "  " ++
        "return " ++ code ++ ";\n" ++ repeat ctx.jxDepth "  " ++ "}"

/-- A function type's parameters and result, through every arrow. -/
def JsGen.arrows (t : Sexp) : (List Sexp, Sexp) :=
  match t with
  | Sexp.list (Sexp.sym "tfun" :: a :: b :: _) =>
      match JsGen.arrows b with
      | (ps, r) => (a :: ps, r)
  | Sexp.list (Sexp.sym "teff" :: _ :: inner :: []) => JsGen.arrows inner
  | _ => ([], t)

--
-- Source maps: base64 VLQ.
--
def JsGen.base64 : Text := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

/-- Binds `v` to a new local named after `x`; returns the local. -/
def JsGen.bind (ctx : JsCtx) (env : List Text) (x : Text) (v : Sexp) : {Throw Text} Text := if needsStatements v then
  let name := JsGen.local ctx x
  JsGen.emit ctx ("let " ++ name ++ ";")
  stmt ctx env v (JsTarget.assign name)
  name
else
  let code := JsGen.expr ctx env v
  let name := JsGen.local ctx x
  JsGen.emit ctx ("const " ++ name ++ " = " ++ code ++ ";")
  name

def JsGen.call (callee : Text) (args : List Text) : Text := callee ++ "(" ++ join ", " args ++ ")"

/-- The callee of a self tail call: the function being compiled, by its JavaScript name. -/
def JsGen.calleeName (ctx : JsCtx) (env : List Text) (f : Sexp) : {Throw Text} Option Text :=
  match f with
  | Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) =>
      match Dict.lookup h (ctx.jxMod).jmDefs with
      | Option.some d => Option.some d.jdJs
      | Option.none => Option.none
  | Sexp.list (Sexp.sym "var" :: Sexp.int i :: []) => get? env i
  | _ => Option.none

--
-- The `js` MDL extension (the codebase's JsGen.Spec).
--
/-- A `js` block: `run:` must print the same on the JS target as on the kernel (and as `expect:`, when given). -/
@[ext "org.dxos.deus.js@1.0"]
def JsGen.check (b : Block) : {MdlHost} List Text :=
  match List.lookup "run" b.props with
  | Option.none => ["js needs run:"]
  | Option.some source =>
      match MdlHost.js source with
      | Result.err message => [message]
      | Result.ok (kernel, js) =>
          let expected :=
            match List.lookup "expect" b.props with
            | Option.some e => if e == kernel then [] else ["the kernel gives " ++ kernel ++ ", expected " ++ e]
            | Option.none => []
          expected ++
            (if kernel == js then [] else ["the js target gives " ++ js ++ ", the kernel " ++ kernel])

/-- The codec descriptor of a type (the codebase's JsGen.Spec#foreign-imports), as JavaScript. -/
def JsGen.codec (mod : JsModule) (seen : List Text) (t : Sexp) : Text :=
  match t with
  | Sexp.list (Sexp.sym "tref" :: Sexp.str "#Int" :: []) => "['int']"
  | Sexp.list (Sexp.sym "tref" :: Sexp.str "#Text" :: []) => "['text']"
  | Sexp.list (Sexp.sym "tref" :: Sexp.str "#Bool" :: []) => "['bool']"
  | Sexp.list (Sexp.sym "tref" :: Sexp.str "#Unit" :: []) => "['unit']"
  | Sexp.list (Sexp.sym "tapp" :: Sexp.list (Sexp.sym "tref" :: Sexp.str "#List" :: []) :: a :: []) => "['list', " ++ JsGen.codec mod seen a ++ "]"
  | Sexp.list (Sexp.sym "tapp" :: Sexp.list (Sexp.sym "tref" :: Sexp.str "#Option" :: []) :: a :: []) => "['option', " ++ JsGen.codec mod seen a ++ "]"
  | Sexp.list (Sexp.sym "tapp" :: Sexp.list (Sexp.sym "tref" :: Sexp.str "#Pair" :: []) :: _ :: _ :: []) => "['tuple', [" ++ join ", " (List.map (JsGen.codec mod seen) (JsGen.tupleItems t)) ++ "]]"
  | Sexp.list (Sexp.sym "tfun" :: _) => fnCodec mod seen t
  | Sexp.list (Sexp.sym "teff" :: _ :: inner :: []) => JsGen.codec mod seen inner
  | Sexp.list (Sexp.sym "tref" :: Sexp.str iri :: []) => structCodec mod seen iri []
  | Sexp.list (Sexp.sym "tapp" :: Sexp.list (Sexp.sym "tref" :: Sexp.str iri :: []) :: args) => structCodec mod seen iri args
  | _ => "['raw']"

/-- Compiles `roots` (export name, hash) to a module that imports its runtime from `runtime` and
  names its source map `mapName`. `view` gives a definition's source text (hash, name) for the map.
  Returns the module text and the source map JSON. -/
def JsGen.compile (fetch : Text -> {Throw Text | r} Option Sexp) (meta : Text -> {Throw Text | r} Option Sexp) (view : Text -> Text -> {Throw Text | r} Text) (ns : Map Text Entry) (jsImport : Text) (roots : List (Text, Text)) (runtime : Text) (mapName : Text) : {Throw Text | r} (Text, Text) :=
  let defs := JsGen.gather fetch meta ns jsImport (List.map snd roots)
  let modules := dedup (filterMap (fun d =>
    match d.jdKind with
    | JsKind.importFn m _ _ => if m == "" || m == "deus:runtime" then Option.none else Option.some m
    | JsKind.importValue m _ => if m == "" || m == "deus:runtime" then Option.none else Option.some m
    | _ => Option.none) defs)
  let types := dedup (concatMap (fun d => abilitiesOf d.jdBody) defs)
  let objects := Dict.fromList (List.map (fun h => (h, fetch h)) (types ++ filterMap (fun pair =>
    match snd pair with
    | Entry.type h _ _ => Option.some h
    | _ => Option.none) (Map.toList ns)))
  let mod := JsModule.mk
    (Dict.fromList (List.map (fun d => (d.jdHash, d)) defs))
    ns
    (fun h => Option.bind (Dict.lookup h objects) id)
    modules
  let header := ["// Generated by `deus build --js` (D97). Edit the DEUS definitions, not this file.", "import * as rt from " ++ JsGen.quote runtime ++ ";"] ++
    mapIndexed (fun i m => "import * as m" ++ toText i ++ " from " ++ JsGen.quote m ++ ";") modules ++
    filterMap (abilityLine mod) types
  let bodies := List.filter
    (fun d => not (List.isEmpty (snd d)))
    (mapIndexed (fun i d => (d, defCode mod d)) defs)
  let footer := ["", "export const raw = {"] ++ List.map (fun pair =>
    let d := getOr
      (Dict.lookup (snd pair) mod.jmDefs)
      (JsDef.mk "" "" "undefined" JsKind.constant (Sexp.list []) (Sexp.list []))
    match d.jdKind with
    | JsKind.fn _ => "  " ++ fst pair ++ ": " ++ d.jdJs ++ ","
    | JsKind.importFn _ _ _ => "  " ++ fst pair ++ ": " ++ d.jdJs ++ ","
    | _ => "  get " ++ fst pair ++ "() { return " ++ d.jdJs ++ "(); },") roots ++ ["};"] ++ filterMap
    (fun pair => Option.map (fun d => exportLine mod (fst pair) d) (Dict.lookup (snd pair) mod.jmDefs))
    roots ++ ["//# sourceMappingURL=" ++ mapName]
  let numbered := mapIndexed (fun i pair => (i, pair)) bodies
  let lines := List.map (fun l => (Option.none, l)) header ++ concatMap (fun item =>
    match item with
    | (i, _, code) => (Option.none, "") :: List.map (fun l => (Option.some i, l)) code) numbered ++ List.map (fun l => (Option.none, l)) footer
  let sources := List.map (fun item =>
    match item with
    | (_, d, _) => (d.jdName, view d.jdHash d.jdName)) numbered
  let map := Json.render (Json.obj [("version", Json.num 3), ("file", Json.str (replace ".map" "" mapName)), ("sources", Json.arr (List.map (fun s => Json.str ("deus:" ++ fst s)) sources)), ("sourcesContent", Json.arr (List.map (fun s => Json.str (snd s)) sources)), ("names", Json.arr []), ("mappings", Json.str (mappings (List.map fst lines)))])
  (join "\n" (List.map snd lines) ++ "\n", map)

def JsGen.deeper (ctx : JsCtx) : JsCtx :=
  match ctx with
  | JsCtx.mk x0 x1 x2 x3 x4 x5 x6 x7 => JsCtx.mk x0 x1 (ctx.jxDepth + 1) x3 x4 x5 x6 x7

/-- One definition's code: its lines, outermost indentation. -/
def JsGen.defCode (mod : JsModule) (d : JsDef) : {Throw Text} List Text :=
  let ctx := JsCtx.mk mod (Ref.new []) 0 (MutMap.new ()) (Ref.new 0) Option.none (Ref.new false) d.jdName
  match d.jdKind with
  | JsKind.primitive _ => []
  | JsKind.importFn module path n =>
      match JsGen.arrows d.jdType with
      | (ps, r) => ["const " ++ d.jdJs ++ " = rt.importFn(" ++ moduleName mod module ++ ", " ++ JsGen.quote path ++
          ", [" ++
          join ", " (List.map (JsGen.codec mod []) (List.take n ps)) ++
          "], " ++
          JsGen.codec mod [] r ++
          ", " ++
          JsGen.quote d.jdName ++
          ");"]
  | JsKind.importValue module path => ["const " ++ d.jdJs ++ " = rt.importValue(" ++ moduleName mod module ++ ", " ++ JsGen.quote path ++
      ", " ++
      JsGen.codec mod [] d.jdType ++
      ", " ++
      JsGen.quote d.jdName ++
      ");"]
  | JsKind.constant =>
      let body := JsGen.arrow ctx [] [] d.jdBody
      ["const " ++ d.jdJs ++ " = rt.lazy(" ++ JsGen.quote d.jdName ++ ", " ++ body ++ ");"]
  | JsKind.fn _ =>
      function ctx [] d.jdJs d.jdName d.jdBody
      reverse (Ref.get ctx.jxLines) ++
        ["rt.named(" ++ d.jdJs ++ ", " ++ JsGen.quote d.jdName ++ ");"]

/-- A statement that delivers `code` to `target`. -/
def JsGen.deliver (ctx : JsCtx) (target : JsTarget) (code : Text) : Unit :=
  match target with
  | JsTarget.ret => JsGen.emit ctx ("return " ++ code ++ ";")
  | JsTarget.assign name => JsGen.emit ctx (name ++ " = " ++ code ++ ";")
  | JsTarget.drop => if simple code then () else JsGen.emit ctx (code ++ ";")

/-- Core with its binder names put back, as the resolver wrote it before `Resolve.strip`:
  `(lam "x" b)`, `(let "x" v b)`, `(letrec (names "f" …) (…) b)`, `(pvar "x")`, `(pas "x" p)`,
  `(ret "x" b)`, `(on A i k ("a" … "k") b)`. Names are taken in the pre-order `strip` gave them. -/
def JsGen.dress (supply : Ref (List Text)) (form : Sexp) : Sexp :=
  match form with
  | Sexp.list (Sexp.sym "lam" :: b :: []) =>
      let x := takeName supply
      Sexp.list [Sexp.sym "lam", Sexp.str x, JsGen.dress supply b]
  | Sexp.list (Sexp.sym "let" :: v :: b :: []) =>
      let x := takeName supply
      let v2 := JsGen.dress supply v
      Sexp.list [Sexp.sym "let", Sexp.str x, v2, JsGen.dress supply b]
  | Sexp.list (Sexp.sym "letrec" :: Sexp.list fs :: b :: []) =>
      let names := takeNames supply (List.length fs)
      let fs2 := List.map (JsGen.dress supply) fs
      Sexp.list [Sexp.sym "letrec", Sexp.list (Sexp.sym "names" :: names), Sexp.list fs2, JsGen.dress supply b]
  | Sexp.list (Sexp.sym "pvar" :: []) => Sexp.list [Sexp.sym "pvar", Sexp.str (takeName supply)]
  | Sexp.list (Sexp.sym "pas" :: p :: []) =>
      let x := takeName supply
      Sexp.list [Sexp.sym "pas", Sexp.str x, JsGen.dress supply p]
  | Sexp.list (Sexp.sym "ret" :: b :: []) =>
      let x := takeName supply
      Sexp.list [Sexp.sym "ret", Sexp.str x, JsGen.dress supply b]
  | Sexp.list (Sexp.sym "on" :: a :: i :: Sexp.int k :: b :: []) =>
      let names := takeNames supply (k + 1)
      Sexp.list [Sexp.sym "on", a, i, Sexp.int k, Sexp.list names, JsGen.dress supply b]
  | Sexp.list items => Sexp.list (List.map (JsGen.dress supply) items)
  | _ => form

def JsGen.emit (ctx : JsCtx) (line : Text) : Unit := Ref.set ctx.jxLines ((repeat ctx.jxDepth "  " ++ line) :: Ref.get ctx.jxLines)

/-- The export of a root, through the codecs of its stored type. -/
def JsGen.exportLine (mod : JsModule) (name : Text) (d : JsDef) : Text :=
  match d.jdKind with
  | JsKind.fn n =>
      match JsGen.arrows d.jdType with
      | (ps, r) =>
          let known := List.length ps >= n
          let paramCodecs := if known then List.map (JsGen.codec mod []) (List.take n ps) else replicate n "['raw']"
          let resultCodec := if known && List.length ps == n then JsGen.codec mod [] r else "['raw']"
          "export const " ++ name ++ " = rt.exportFn(" ++ d.jdJs ++ ", [" ++ join ", " paramCodecs ++
            "], " ++
            resultCodec ++
            ");"
  | JsKind.importFn _ _ _ => "export const " ++ name ++ " = " ++ d.jdJs ++ ";"
  | _ => "export const " ++ name ++ " = rt.toJs(" ++ JsGen.codec mod [] d.jdType ++ ", " ++ d.jdJs ++
      "());"

/-- `e` as a JavaScript expression; statements it needs are emitted first. -/
def JsGen.expr (ctx : JsCtx) (env : List Text) (e : Sexp) : {Throw Text} Text :=
  match e with
  | Sexp.list (Sexp.sym "int" :: Sexp.int n :: []) => JsGen.int n
  | Sexp.list (Sexp.sym "text" :: Sexp.str s :: []) => JsGen.quote s
  | Sexp.list (Sexp.sym "var" :: Sexp.int i :: []) =>
      match get? env i with
      | Option.some name => name
      | Option.none => Throw.throw ("unbound variable " ++ toText i)
  | Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) => refValue ctx h
  | Sexp.list (Sexp.sym "con" :: Sexp.str "#Bool" :: Sexp.int tag :: _ :: []) => if tag == 1 then "true" else "false"
  | Sexp.list (Sexp.sym "con" :: Sexp.str "#Unit" :: _ :: _ :: []) => "undefined"
  | Sexp.list (Sexp.sym "con" :: Sexp.str "#List" :: Sexp.int 0 :: _ :: []) => "rt.NIL"
  | Sexp.list (Sexp.sym "con" :: Sexp.str t :: Sexp.int tag :: Sexp.int 0 :: []) => "rt.con0(" ++ JsGen.quote t ++ ", " ++ toText tag ++ ")"
  | Sexp.list (Sexp.sym "con" :: Sexp.str t :: Sexp.int tag :: Sexp.int k :: []) => "rt.conFn(" ++ JsGen.quote t ++ ", " ++ toText tag ++ ", " ++ toText k ++ ")"
  | Sexp.list (Sexp.sym "op" :: Sexp.str a :: Sexp.int i :: Sexp.int k :: []) => "rt.opFn(" ++ JsGen.quote a ++ ", " ++ toText i ++ ", " ++ toText k ++ ")"
  | Sexp.list (Sexp.sym "prim" :: Sexp.str p :: []) => primValue p
  | Sexp.list (Sexp.sym "lam" :: _ :: _ :: []) =>
      match JsGen.unlam e with
      | (n, _) =>
          match JsGen.params n e with
          | (xs, body) => "rt.named(" ++ JsGen.arrow ctx env (List.map (fun x => JsGen.local ctx x) xs) body ++
              ", " ++ JsGen.quote (ctx.jxOwner ++ "/λ") ++ ")"
  | Sexp.list (Sexp.sym "handle" :: body :: clauses) => JsGen.handleExpr ctx env body clauses
  | Sexp.list (Sexp.sym "app" :: f :: args) => JsGen.app ctx env f args
  | _ => if needsStatements e then
      let name := temp ctx "r"
      JsGen.emit ctx ("let " ++ name ++ ";")
      stmt ctx env e (JsTarget.assign name)
      name
    else Throw.throw ("outside the js target: " ++ Text.take 120 (Sexp.print e))

/-- The patterns of fields `i`, `i + 1`, … of the value at `path`. -/
def JsGen.fields (path : Text) (i : Int) (subs : List Sexp) : {Throw Text} (List Text, List (Text, Text)) :=
  match subs with
  | [] => ([], [])
  | sub :: rest =>
      match (JsGen.pattern (path ++ ".fields[" ++ toText i ++ "]") sub, JsGen.fields path (i + 1) rest) with
      | ((t1, b1), t2, b2) => (t1 ++ t2, b1 ++ b2)

def JsGen.fnCodec (mod : JsModule) (seen : List Text) (t : Sexp) : Text :=
  match JsGen.arrows t with
  | (ps, r) => "['fn', [" ++ join ", " (List.map (JsGen.codec mod seen) ps) ++ "], " ++ JsGen.codec mod seen r ++
      "]"

/-- A function declaration for the dressed lambda chain `lam` (a `letrec` member, or a definition
  when `env` is empty): `function name(…) { … }`, with a loop when it calls itself in tail position. -/
def JsGen.function (ctx : JsCtx) (env : List Text) (jsName : Text) (display : Text) (lam : Sexp) : {Throw Text} Unit :=
  match JsGen.unlam lam with
  | (n, _) =>
      match JsGen.params n lam with
      | (xs, body) =>
          let names := List.map (fun x => JsGen.local ctx x) xs
          let slots := List.map (fun x => JsGen.local ctx (x ++ "$")) names
          let inner := JsCtx.mk
            ctx.jxMod
            (Ref.new [])
            0
            ctx.jxUsed
            ctx.jxNext
            (Option.some (jsName, n, slots))
            (Ref.new false)
            ctx.jxOwner
          stmt inner (reverse names ++ env) body JsTarget.ret
          let lines := reverse (Ref.get inner.jxLines)
          let pad := repeat (ctx.jxDepth + 1) "  "
          if Ref.get inner.jxLooped then
            JsGen.emit ctx ("function " ++ jsName ++ "(" ++ join ", " slots ++ ") {")
            JsGen.emit ctx "  for (;;) {"
            JsGen.emit ctx ("    const " ++
              join ", " (List.map (fun pair => fst pair ++ " = " ++ snd pair) (zip names slots)) ++ ";")
            forEach lines (fun line => JsGen.emit ctx ("    " ++ line))
            JsGen.emit ctx "  }"
            JsGen.emit ctx "}"
          else
            JsGen.emit ctx ("function " ++ jsName ++ "(" ++ join ", " names ++ ") {")
            forEach lines (fun line => JsGen.emit ctx ("  " ++ line))
            JsGen.emit ctx "}"
          if env == [] then () else JsGen.emit ctx ("rt.named(" ++ jsName ++ ", " ++ JsGen.quote display ++ ");")

/-- Every definition the roots reach, by hash. `jsImport` is the hash of `Js.import`, or "" when
  the codebase has none. -/
def JsGen.gather (fetch : Text -> {Throw Text | r} Option Sexp) (meta : Text -> {Throw Text | r} Option Sexp) (ns : Map Text Entry) (jsImport : Text) (roots : List Text) : {Throw Text | r} List JsDef :=
  let names := JsGen.namesByHash ns
  let taken := MutMap.new ()
  let jsName := fun display =>
    let base := mangle display
    let rec pick n :=
      let candidate := if n == 0 then base else base ++ "_" ++ toText n
      if MutMap.has taken candidate then pick (n + 1) else
        MutMap.set taken candidate ()
        candidate
    pick 0
  let seen := MutMap.new ()
  let rec go pending acc :=
    match pending with
    | [] => reverse acc
    | h :: rest => if MutMap.has seen h then go rest acc else
        MutMap.set seen h ()
        let display := getOr (Dict.lookup h names) ("#" ++ Text.take 10 h)
        let m := meta h
        let t := JsGen.storedType m
        match fetch h with
        | Option.some (Sexp.list (Sexp.sym "term" :: Sexp.list (Sexp.sym "prim" :: Sexp.str p :: []) :: [])) => go rest (JsDef.mk h display "" (JsKind.primitive p) (Sexp.list []) t :: acc)
        | Option.some (Sexp.list (Sexp.sym "term" :: core :: [])) =>
            match importOf jsImport core with
            | Option.some (module, path) =>
                let kind :=
                  match JsGen.arrows t with
                  | ([], _) => JsKind.importValue module path
                  | (ps, _) => JsKind.importFn module path (List.length ps)
                go rest (JsDef.mk h display (jsName display) kind (Sexp.list []) t :: acc)
            | Option.none =>
                if not (Text.isEmpty jsImport) && List.contains jsImport (Wasm.refsOf core) then Throw.throw (display ++
                  " uses Js.import inside an expression; a binding is a definition whose whole body is Js.import \"<module>\" \"<path>\"") else ()
                let body := dress (Ref.new (locals m)) core
                let kind :=
                  match JsGen.unlam core with
                  | (0, _) => JsKind.constant
                  | (n, _) => JsKind.fn n
                go
                  (rest ++ Wasm.refsOf core)
                  (JsDef.mk h display (jsName display) kind body t :: acc)
        | _ => Throw.throw ("#" ++ Text.take 10 h ++ " is not a term the js target can compile")
  go roots []

/-- `(handle b r? o…)` as `rt.handle(clauses, ret, body)`. A clause that resumes at once is called
  where the request is made; one that never resumes unwinds; any other is refused. -/
def JsGen.handleExpr (ctx : JsCtx) (env : List Text) (body : Sexp) (clauses : List Sexp) : {Throw Text} Text :=
  let ret := List.find (fun c => head c == "ret") clauses
  let ons := List.filter (fun c => head c == "on") clauses
  let compiled := List.map (fun c =>
    match c with
    | Sexp.list (Sexp.sym "on" :: Sexp.str a :: Sexp.int i :: Sexp.int k :: Sexp.list names :: b :: []) =>
        let locals := List.map (fun x => JsGen.local ctx (asText x)) names
        let resumed :=
          match b with
          | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "var" :: Sexp.int 0 :: []) :: value :: []) => if JsGen.occurs 0 value then Option.none else Option.some value
          | _ => Option.none
        match resumed with
        | Option.some value => "[" ++ JsGen.quote a ++ ", " ++ toText i ++ ", rt.RESUME, " ++
            JsGen.arrow (deeper ctx) env locals value ++ "]"
        | Option.none => if JsGen.occurs 0 b then Throw.throw ("the handler for " ++ opName ctx a i ++
            " uses its continuation in a way the js target does not support (only `k e` with nothing after it, or not at all)") else "[" ++ JsGen.quote a ++ ", " ++ toText i ++ ", rt.ABORT, " ++
            JsGen.arrow (deeper ctx) env locals b ++ "]"
    | _ => Throw.throw "malformed handler clause") ons
  let retCode :=
    match ret with
    | Option.some (Sexp.list (Sexp.sym "ret" :: Sexp.str x :: b :: [])) => JsGen.arrow ctx env [JsGen.local ctx x] b
    | _ => "null"
  let thunk := JsGen.arrow ctx env [] body
  let pad := repeat (ctx.jxDepth + 1) "  "
  "rt.handle([\n" ++ join ",\n" (List.map (fun c => pad ++ c) compiled) ++ "\n" ++
    repeat ctx.jxDepth "  " ++ "], " ++ retCode ++ ", " ++ thunk ++ ")"

/-- `code` in a constant unless it is already simple. -/
def JsGen.hold (ctx : JsCtx) (code : Text) : Text := if simple code then code else
  let name := temp ctx "t"
  JsGen.emit ctx ("const " ++ name ++ " = " ++ code ++ ";")
  name

def JsGen.identPart (c : Int) : Bool := identStart c || isDigit c

def JsGen.identStart (c : Int) : Bool := isAlpha c || c == '_' || c == '$'

/-- The module and path of `Js.import "<module>" "<path>"`, when `core` is one. -/
def JsGen.importOf (jsImport : Text) (core : Sexp) : Option (Text, Text) :=
  match core with
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "ref" :: Sexp.str callee :: []) :: Sexp.list (Sexp.sym "text" :: Sexp.str module :: []) :: Sexp.list (Sexp.sym "text" :: Sexp.str path :: []) :: []) => if callee == jsImport && not (Text.isEmpty jsImport) then Option.some (module, path) else Option.none
  | _ => Option.none

/-- Inline code for a saturated primitive, when there is some. -/
def JsGen.inlinePrim (p : Text) (args : List Text) : Option Text :=
  match args with
  | a :: [] => if p == "Int.neg" then Option.some ("(-" ++ a ++ " | 0)") else Option.none
  | a :: b :: [] => if p == "Int.add" then Option.some ("((" ++ a ++ " + " ++ b ++ ") | 0)") else if p == "Int.sub" then Option.some ("((" ++ a ++ " - " ++ b ++ ") | 0)") else if p == "Int.mul" then Option.some ("Math.imul(" ++ a ++ ", " ++ b ++ ")") else if p == "Int.div" then Option.some ("rt.div(" ++ a ++ ", " ++ b ++ ")") else if p == "Int.mod" then Option.some ("rt.mod(" ++ a ++ ", " ++ b ++ ")") else if p == "Int.and" then Option.some ("(" ++ a ++ " & " ++ b ++ ")") else if p == "Int.or" then Option.some ("(" ++ a ++ " | " ++ b ++ ")") else if p == "Int.xor" then Option.some ("(" ++ a ++ " ^ " ++ b ++ ")") else if p == "Int.shl" then Option.some ("(" ++ a ++ " << " ++ b ++ ")") else if p == "Int.shr" then Option.some ("(" ++ a ++ " >> " ++ b ++ ")") else if p == "Int.ushr" then Option.some ("((" ++ a ++ " >>> " ++ b ++ ") | 0)") else if p == "eq" then Option.some (if scalar a || scalar b then "(" ++ a ++ " === " ++ b ++ ")" else "rt.equal(" ++ a ++ ", " ++ b ++ ")") else if p == "neq" then Option.some (if scalar a || scalar b then "(" ++ a ++ " !== " ++ b ++ ")" else "!rt.equal(" ++ a ++ ", " ++ b ++ ")") else if p == "lt" && (scalar a || scalar b) then Option.some ("(" ++ a ++ " < " ++ b ++ ")") else if p == "le" && (scalar a || scalar b) then Option.some ("(" ++ a ++ " <= " ++ b ++ ")") else if p == "gt" && (scalar a || scalar b) then Option.some ("(" ++ a ++ " > " ++ b ++ ")") else if p == "ge" && (scalar a || scalar b) then Option.some ("(" ++ a ++ " >= " ++ b ++ ")") else Option.none
  | _ => Option.none

def JsGen.int (n : Int) : Text := if n < 0 then "(" ++ toText n ++ ")" else toText n

/-- Whether `t` is a JavaScript identifier this compiler may bind. -/
def JsGen.isIdent (t : Text) : Bool := Text.length t > 0 && identStart (code t 0) && List.all (fun i => identPart (code t i)) (range 0 (Text.length t)) && not (Dict.contains t JsGen.reserved)

/-- A fresh JavaScript local for the DEUS name `x`, unique in the definition. -/
def JsGen.local (ctx : JsCtx) (x : Text) : Text :=
  let base := if Text.isEmpty x then "v" else mangle x
  let rec pick n :=
    let candidate := if n == 0 then base else base ++ "_" ++ toText n
    if MutMap.has ctx.jxUsed candidate then pick (n + 1) else
      MutMap.set ctx.jxUsed candidate ()
      candidate
  pick 0

def JsGen.locals (meta : Option Sexp) : List Text := List.map asText (metaList meta "locals")

def JsGen.lookupDef (ctx : JsCtx) (h : Text) : {Throw Text} JsDef :=
  match Dict.lookup h (ctx.jxMod).jmDefs with
  | Option.some d => d
  | Option.none => Throw.throw ("unknown definition #" ++ Text.take 10 h)

/-- A JavaScript identifier for a DEUS name: `.` becomes `$`, `'` `$q`, `?` `$p`, `!` `$b`, any
  other character outside ASCII identifiers `_`; a reserved word or a leading digit gets `_`. -/
def JsGen.mangle (name : Text) : Text :=
  let body := Text.concat (List.map (fun i =>
    let c := code name i
    if identPart c then fromCode c else if c == '.' then "$" else if c == '\'' then "$q" else if c == '?' then "$p" else if c == '!' then "$b" else "_") (range 0 (Text.length name)))
  if Text.isEmpty body then "_" else if isDigit (code body 0) || Dict.contains body JsGen.reserved then "_" ++ body else body

/-- The source-map line for one generated line: unmapped, or the first line of source `s`. -/
def JsGen.mappings (sources : List (Option Int)) : Text :=
  let rec go rest prev acc :=
    match rest with
    | [] => join ";" (reverse acc)
    | Option.none :: more => go more prev ("" :: acc)
    | Option.some s :: more => go more s (("A" ++ vlq (s - prev) ++ "AA") :: acc)
  go sources 0 []

def JsGen.matchStmt (ctx : JsCtx) (env : List Text) (s : Sexp) (cases : List Sexp) (target : JsTarget) : {Throw Text} Unit :=
  let scrutinee := hold ctx (JsGen.expr ctx env s)
  let label := temp ctx "m"
  JsGen.emit ctx (label ++ ": {")
  let inner := deeper ctx
  forEach cases (fun c =>
    match match c with
    | Sexp.list (Sexp.sym "case" :: p :: body :: []) => (p, Option.none, body)
    | Sexp.list (Sexp.sym "gcase" :: p :: g :: body :: []) => (p, Option.some g, body)
    | _ => (Sexp.list [Sexp.sym "pany"], Option.none, c) with
    | (p, guard, body) =>
        match JsGen.pattern scrutinee p with
        | (tests, binds) =>
            JsGen.emit
              inner
              ("if (" ++ (if List.isEmpty tests then "true" else join " && " tests) ++ ") {")
            let body1 := deeper inner
            let locals := List.map (fun pair =>
              let name := JsGen.local body1 (fst pair)
              JsGen.emit body1 ("const " ++ name ++ " = " ++ snd pair ++ ";")
              name) binds
            let env2 := reverse locals ++ env
            match guard with
            | Option.none =>
                stmt body1 env2 body target
                match target with
                | JsTarget.ret => ()
                | _ => JsGen.emit body1 ("break " ++ label ++ ";")
            | Option.some g =>
                JsGen.emit body1 ("if (" ++ JsGen.expr body1 env2 g ++ ") {")
                stmt (deeper body1) env2 body target
                JsGen.emit (deeper body1) ("break " ++ label ++ ";")
                JsGen.emit body1 "}"
            JsGen.emit inner "}")
  JsGen.emit inner ("rt.nomatch(" ++ scrutinee ++ ");")
  JsGen.emit ctx "}"

--
-- The module.
--
/-- A JavaScript import of `module`: its local name. The runtime itself is `rt`. -/
def JsGen.moduleName (mod : JsModule) (module : Text) : Text := if module == "deus:runtime" then "rt" else if module == "" then "globalThis" else "m" ++ toText (findIndex (fun m => m == module) mod.jmModules)

/-- Name of each term, constructor-free: hash to its shortest name. -/
def JsGen.namesByHash (ns : Map Text Entry) : Dict Text Text :=
  let pairs := filterMap (fun pair =>
    match snd pair with
    | Entry.term h => Option.some (h, fst pair)
    | _ => Option.none) (Map.toList ns)
  -- Later keys win in a Dict, so order longest first and the shortest name is kept.
  Dict.fromList (sortBy (fun a b => compare (Text.length (snd b)) (Text.length (snd a))) pairs)

/-- Whether compiling `e` as an expression emits statements first (so earlier operands must be held). -/
def JsGen.needsStatements (e : Sexp) : Bool :=
  match e with
  | Sexp.list (Sexp.sym head :: rest) => (head == "if" || head == "match" || head == "let" || head == "seq" || head == "letrec") || (if head == "lam" || head == "handle" then false else any JsGen.needsStatements rest)
  | _ => false

/-- Whether de Bruijn index `i` occurs free in a dressed form. -/
def JsGen.occurs (i : Int) (form : Sexp) : Bool :=
  match form with
  | Sexp.list (Sexp.sym "var" :: Sexp.int j :: []) => i == j
  | Sexp.list (Sexp.sym "lam" :: _ :: b :: []) => JsGen.occurs (i + 1) b
  | Sexp.list (Sexp.sym "let" :: _ :: v :: b :: []) => JsGen.occurs i v || JsGen.occurs (i + 1) b
  | Sexp.list (Sexp.sym "letrec" :: Sexp.list (_ :: names) :: Sexp.list fs :: b :: []) =>
      let n := List.length names
      any (JsGen.occurs (i + n)) fs || JsGen.occurs (i + n) b
  | Sexp.list (Sexp.sym "case" :: p :: b :: []) => JsGen.occurs (i + patBinds p) b
  | Sexp.list (Sexp.sym "gcase" :: p :: g :: b :: []) => JsGen.occurs (i + patBinds p) g || JsGen.occurs (i + patBinds p) b
  | Sexp.list (Sexp.sym "ret" :: _ :: b :: []) => JsGen.occurs (i + 1) b
  | Sexp.list (Sexp.sym "on" :: _ :: _ :: Sexp.int k :: _ :: b :: []) => JsGen.occurs (i + k + 1) b
  | Sexp.list items => any (JsGen.occurs i) items
  | _ => false

/-- An operation's name, for messages. -/
def JsGen.opName (ctx : JsCtx) (a : Text) (i : Int) : Text := getOr (Option.map fst (List.find (fun pair =>
  match snd pair with
  | Entry.op owner index _ => owner == a && index == i
  | _ => false) (Map.toList (ctx.jxMod).jmNs))) ("#" ++ Text.take 10 a ++ " operation " ++ toText i)

/-- Operands evaluated left to right: when one needs statements, the ones before it are held first. -/
def JsGen.operands (ctx : JsCtx) (env : List Text) (items : List Sexp) : {Throw Text} List Text := if any needsStatements items then List.map (fun x => hold ctx (JsGen.expr ctx env x)) items else List.map (fun x => JsGen.expr ctx env x) items

/-- The parameter names of a dressed lambda chain of `n`, and its body. -/
def JsGen.params (n : Int) (core : Sexp) : (List Text, Sexp) := if n == 0 then ([], core) else
  match core with
  | Sexp.list (Sexp.sym "lam" :: Sexp.str x :: b :: []) =>
      match JsGen.params (n - 1) b with
      | (xs, body) => (x :: xs, body)
  | _ => ([], core)

/-- How many variables a pattern binds. -/
def JsGen.patBinds (p : Sexp) : Int :=
  match p with
  | Sexp.list (Sexp.sym "pvar" :: _ :: []) => 1
  | Sexp.list (Sexp.sym "pas" :: _ :: q :: []) => 1 + JsGen.patBinds q
  | Sexp.list (Sexp.sym "pcon" :: _ :: _ :: subs) => sum (List.map JsGen.patBinds subs)
  | _ => 0

/-- A pattern against the JavaScript expression `path`: its tests and what it binds, left to right. -/
def JsGen.pattern (path : Text) (p : Sexp) : {Throw Text} (List Text, List (Text, Text)) :=
  match p with
  | Sexp.list (Sexp.sym "pany" :: []) => ([], [])
  | Sexp.list (Sexp.sym "pvar" :: Sexp.str x :: []) => ([], [(x, path)])
  | Sexp.list (Sexp.sym "pas" :: Sexp.str x :: q :: []) =>
      match JsGen.pattern path q with
      | (tests, binds) => (tests, (x, path) :: binds)
  | Sexp.list (Sexp.sym "pint" :: Sexp.int n :: []) => ([path ++ " === " ++ JsGen.int n], [])
  | Sexp.list (Sexp.sym "ptext" :: Sexp.str s :: []) => ([path ++ " === " ++ JsGen.quote s], [])
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str "#Bool" :: Sexp.int tag :: []) => ([path ++ (if tag == 1 then " === true" else " === false")], [])
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str "#Unit" :: _ :: []) => ([], [])
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str _ :: Sexp.int tag :: subs) =>
      match JsGen.fields path 0 subs with
      | (tests, binds) => ((path ++ ".tag === " ++ toText tag) :: tests, binds)
  | _ => Throw.throw ("the pattern " ++ Sexp.print p ++ " is outside the js target")

def JsGen.primValue (p : Text) : {Throw Text} Text := if startsWith "Code." p then Throw.throw ("the primitive " ++ p ++ " is outside the js target") else "rt.prims[" ++ JsGen.quote p ++ "]"

/-
  A JavaScript back end (D97, the codebase's JsGen.Spec): compiles definitions, and every definition they
  reach, to one ES module with no kernel.

  Each definition is a JavaScript function of its parameters, named after the DEUS name, so a
  stack trace reads as DEUS. Locals keep the author's names (the `locals` metadata). A call to the
  function itself in tail position becomes a loop; data are `rt.Con`s; `Int` arithmetic is inlined
  with `| 0` and `Math.imul`.

  Handlers run in direct style. A clause that resumes at once (`k e`) runs where the request is
  made; a clause that never resumes unwinds to its `handle` by exception; any other use of the
  continuation is refused. So the output has no generators and no continuations, and JavaScript
  can call DEUS functions (and DEUS can call JavaScript) as plain functions.

  A definition `def f : T := Js.import "<module>" "<path>"` is a foreign import: values cross by
  codecs chosen from `T`. Exports cross by the same codecs.
-/

--
-- Text.
--
/-- A JavaScript string literal that is ASCII, so a lone surrogate survives being written as UTF-8. -/
def JsGen.quote (t : Text) : Text :=
  let n := Text.length t
  let rec go start i acc := if i >= n then Text.concat (reverse (Text.slice t start n :: acc)) else
    let c := code t i
    if c == '"' || c == '\\' || c < 32 || c > 126 then
      let piece := if c == '"' then "\\\"" else if c == '\\' then "\\\\" else if c == 10 then "\\n" else "\\u" ++ hexDigit (and (shr c 12) 15) ++ hexDigit (and (shr c 8) 15) ++
        hexDigit (and (shr c 4) 15) ++ hexDigit (and c 15)
      go (i + 1) (i + 1) (piece :: Text.slice t start i :: acc)
    else go start (i + 1) acc
  "\"" ++ go 0 0 [] ++ "\""

/-- The arity of a reference when it is a function the module calls directly. -/
def JsGen.refArity (ctx : JsCtx) (h : Text) : {Throw Text} Int :=
  match (lookupDef ctx h).jdKind with
  | JsKind.fn n => n
  | JsKind.importFn _ _ n => n
  | _ => 0

/-- The module-level name a reference reads, as a value. -/
def JsGen.refValue (ctx : JsCtx) (h : Text) : {Throw Text} Text :=
  let d := lookupDef ctx h
  match d.jdKind with
  | JsKind.primitive p => primValue p
  | JsKind.constant => d.jdJs ++ "()"
  | JsKind.importValue _ _ => d.jdJs ++ "()"
  | _ => d.jdJs

def JsGen.refsOf (form : Sexp) : List Text :=
  match form with
  | Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) => [h]
  | Sexp.list items => concatMap JsGen.refsOf items
  | _ => []

def JsGen.reserved : Dict Text Unit := dict ["break", "case", "catch", "class", "const", "continue", "debugger", "default", "delete", "do", "else", "enum", "export", "extends", "false", "finally", "for", "function", "if", "import", "in", "instanceof", "new", "null", "return", "super", "switch", "this", "throw", "true", "try", "typeof", "var", "void", "while", "with", "yield", "let", "static", "implements", "interface", "package", "private", "protected", "public", "await", "async", "arguments", "eval", "undefined", "NaN", "Infinity", "rt", "raw", "Object", "Math", "Error", "Array", "String", "Number", "Map", "globalThis", "console"]

/-- Whether `code` is an `Int`, `Text` or `Bool` literal, so `===` and `<` compare as the kernel does. -/
def JsGen.scalar (code : Text) : Bool := code == "true" || code == "false" || startsWith "\"" code || startsWith "(-" code || Text.length code > 0 && isDigit (Text.code code 0) && List.all (fun i => isDigit (Text.code code i)) (range 0 (Text.length code))

/-- Whether `code` is a name or a literal, which costs nothing to repeat. -/
def JsGen.simple (code : Text) : Bool := isIdent code || code == "undefined" || code == "true" || code == "false" || startsWith "\"" code || startsWith "(-" code || Text.length code > 0 && isDigit (Text.code code 0) && indexOf code " " 0 < 0

/-- `e` as statements whose value goes to `target`. -/
def JsGen.stmt (ctx : JsCtx) (env : List Text) (e : Sexp) (target : JsTarget) : {Throw Text} Unit :=
  match e with
  | Sexp.list (Sexp.sym "if" :: c :: t :: f :: []) =>
      let cond := JsGen.expr ctx env c
      JsGen.emit ctx ("if (" ++ cond ++ ") {")
      JsGen.stmt (deeper ctx) env t target
      JsGen.emit ctx "} else {"
      JsGen.stmt (deeper ctx) env f target
      JsGen.emit ctx "}"
  | Sexp.list (Sexp.sym "let" :: Sexp.str x :: v :: b :: []) =>
      let name := JsGen.bind ctx env x v
      JsGen.stmt ctx (name :: env) b target
  | Sexp.list (Sexp.sym "seq" :: a :: b :: []) =>
      JsGen.stmt ctx env a JsTarget.drop
      JsGen.stmt ctx env b target
  | Sexp.list (Sexp.sym "match" :: s :: cases) => matchStmt ctx env s cases target
  | Sexp.list (Sexp.sym "letrec" :: Sexp.list (_ :: names) :: Sexp.list fs :: b :: []) =>
      let jsNames := List.map (fun x => JsGen.local ctx (asText x)) names
      let env2 := reverse jsNames ++ env
      forEach (zip jsNames fs) (fun pair => function ctx env2 (fst pair) (fst pair) (snd pair))
      JsGen.stmt ctx env2 b target
  | Sexp.list (Sexp.sym "app" :: f :: args) =>
      match (target, calleeName ctx env f, ctx.jxSelf) with
      | (JsTarget.ret, Option.some callee, Option.some (selfName, arity, slots)) => if callee == selfName && arity == List.length args then
          let values := operands ctx env args
          -- The parameters are `const` copies of the slots, so closures made this round keep their values.
          forEach
            (zip slots values)
            (fun pair => if fst pair == snd pair then () else JsGen.emit ctx (fst pair ++ " = " ++ snd pair ++ ";"))
          JsGen.emit ctx "continue;"
          Ref.set ctx.jxLooped true
        else deliver ctx target (JsGen.expr ctx env e)
      | _ => deliver ctx target (JsGen.expr ctx env e)
  | _ => deliver ctx target (JsGen.expr ctx env e)

/-- A definition's stored type: its signature, else its inferred scheme, else `()`. -/
def JsGen.storedType (meta : Option Sexp) : Sexp :=
  match metaField meta "sig" with
  | Option.some t => t
  | Option.none => getOr (metaField meta "scheme") (Sexp.list [])

def JsGen.structCodec (mod : JsModule) (seen : List Text) (iri : Text) (args : List Sexp) : Text := if List.contains iri seen then "['raw']" else
  match structureOf mod iri with
  | Option.some (h, fields, types) => "['struct', " ++ JsGen.quote h ++ ", [" ++ join ", " (List.map JsGen.quote fields) ++ "], [" ++
      join
        ", "
        (List.map (fun ty => JsGen.codec mod (iri :: seen) (JsGen.substitute args ty)) types) ++ "]]"
  | Option.none => "['raw']"

/-- The structure a type IRI names: its hash, field names and field types; none for anything else. -/
def JsGen.structureOf (mod : JsModule) (iri : Text) : Option (Text, (List Text, List Sexp)) :=
  match List.find (fun pair =>
    match snd pair with
    | Entry.type _ i _ => i == iri
    | _ => false) (Map.toList mod.jmNs) with
  | Option.some (_, Entry.type h _ fields) =>
      match jmFetch mod h with
      | Option.some (Sexp.list (Sexp.sym "type" :: _ :: _ :: Sexp.list (Sexp.sym "ctor" :: _ :: types) :: [])) => if List.length fields == List.length types && List.length fields > 0 then Option.some (h, fields, types) else Option.none
      | _ => Option.none
  | _ => Option.none

/-- `t` with the declaration's parameters `(tvar i)` replaced by `args`. -/
def JsGen.substitute (args : List Sexp) (t : Sexp) : Sexp :=
  match t with
  | Sexp.list (Sexp.sym "tvar" :: Sexp.int i :: []) => getOr (get? args i) t
  | Sexp.list items => Sexp.list (List.map (JsGen.substitute args) items)
  | _ => t

--
-- Binder names.
--
def JsGen.takeName (supply : Ref (List Text)) : Text :=
  match Ref.get supply with
  | x :: rest =>
      Ref.set supply rest
      x
  | [] => ""

def JsGen.takeNames (supply : Ref (List Text)) (n : Int) : List Sexp := List.map (fun _ => Sexp.str (takeName supply)) (range 0 n)

def JsGen.temp (ctx : JsCtx) (prefix : Text) : Text :=
  let n := Ref.get ctx.jxNext
  Ref.set ctx.jxNext (n + 1)
  JsGen.local ctx (prefix ++ toText n)

/-- The items of a right-nested pair type. -/
def JsGen.tupleItems (t : Sexp) : List Sexp :=
  match t with
  | Sexp.list (Sexp.sym "tapp" :: Sexp.list (Sexp.sym "tref" :: Sexp.str "#Pair" :: []) :: a :: b :: []) => a :: JsGen.tupleItems b
  | _ => [t]

/-- `(lam (lam … b))` as (parameter count, b). -/
def JsGen.unlam (core : Sexp) : (Int, Sexp) :=
  match core with
  | Sexp.list (Sexp.sym "lam" :: b :: []) =>
      match JsGen.unlam b with
      | (n, inner) => (n + 1, inner)
  | Sexp.list (Sexp.sym "lam" :: Sexp.str _ :: b :: []) =>
      match JsGen.unlam b with
      | (n, inner) => (n + 1, inner)
  | _ => (0, core)

/-- The number `vlq` wrote. -/
def JsGen.unvlq (t : Text) : Int :=
  let rec go i shift acc :=
    let digit := indexOf base64 (Text.slice t i (i + 1)) 0
    let acc2 := or acc (shl (and digit 31) shift)
    if and digit 32 == 0 then acc2 else go (i + 1) (shift + 5) acc2
  let v := go 0 0 0
  if and v 1 == 1 then Int.neg (ushr v 1) else ushr v 1

/-- One source-map number, sign in the lowest bit, five bits per digit. -/
def JsGen.vlq (n : Int) : Text :=
  let rec digits v :=
    let digit := and v 31
    let rest := ushr v 5
    if rest == 0 then Text.slice base64 digit (digit + 1) else Text.slice base64 (or digit 32) (or digit 32 + 1) ++ digits rest
  digits (if n < 0 then or (shl (Int.neg n) 1) 1 else shl n 1)
