def Unsound.len : List Int -> Int
| [] => 0
| _ :: rest => 1 + Unsound.len rest

/-
  Claims the prover must refuse (src/cli.test.ts checks that `deus check` rejects every
  `Unsound.wrong*` theorem and proves every `Unsound.right*` one).
-/
def Unsound.loop (n : Int) : Int := Unsound.loop n + 1

theorem Unsound.rightAddComm (a : Int) (b : Int) (c : Int) : a + (b + c) == c + a + b := by simp

theorem Unsound.rightLenAppend (xs : List Int) (ys : List Int) : Sort.len (xs ++ ys) == Sort.len xs + Sort.len ys := by induction xs ; simp

theorem Unsound.wrongAllEmpty (xs : List Int) : xs == [] := by induction xs ; auto

theorem Unsound.wrongLenPositive (xs : List Int) : Sort.len xs > 0 == true := by induction xs ; auto

/-- `loop` is not structurally recursive, so it is never unfolded (it would "prove" 0 = 1). -/
theorem Unsound.wrongLoop (n : Int) : loop n == loop n + 1 := by auto

/-- False: `Int` wraps at 2³¹ - 1. -/
theorem Unsound.wrongSuccGreater (x : Int) : x < x + 1 == true := by auto

/-- True, but a misspelled tactic must fail the proof rather than be skipped. -/
theorem Unsound.wrongTacticName (a : Int) (b : Int) : a + b == b + a := by simp ; smip
