/-- What rewriting one function sees. -/
structure Unique.Cx @"urn:deus:unique:Cx" where
  cxInfos : List Info
  cxScope : Wasm.Scope
  cxResult : Sexp
  cxNext : Ref Int

/-
  Uniqueness for the compiled back ends (D96, the codebase's `Array.Spec`).

  `Array.set` returns a new array and leaves the old one as it was. Compiled code has one block of
  memory per array, so a `set` may write into the block only when nothing will read the old array
  again. This pass decides that statically, over the Core of the functions `Wasm.gather` collects,
  and rewrites each `Array.set` to one of:

    Array.setInPlace a i v   a is unique here: write into its block and return it
    Array.set a i v          it may not be: copy the block, then write

  It also inserts `Array.copy e` where an array would otherwise get a second owner.

  The rules, in Lean 4's and Koka's terms:

  - A local of type `Array` is *owned* when the code holding it is its only owner: a parameter
    that is not borrowed, a `let` whose value is fresh, or a field of a fresh structure.
  - A parameter is *borrowed* when the function only reads it (`Array.get`, `Array.length`, or
    passing it to another borrowed parameter). A caller keeps ownership across the call.
    Inferred by fixpoint, starting from every array parameter borrowed.
  - An owned local is *moved* by its last use: not used later (`live`) and not already pending
    in an earlier argument of the same call (`before`). A moved array is fresh.
  - Owned parameters and array results must be fresh. A function whose result is an `Array`
    returns a fresh one, so its call is fresh. A function whose every result is a constructor
    of one monomorphic structure ("fresh structure", inferred by fixpoint) gives fresh arrays in
    its array fields, so `match lomuto … with | (a, i) => …` owns `a`.
  - An owned local stored anywhere (a constructor, a `let`, a `Ref`, an array item, a generic
    parameter) while it is still live is copied first, so no second owner exists.

  Reading an argument after a call has started does not happen: arguments are evaluated before
  the call, so reads in later arguments (`Array.get a j` next to `a`) do not prevent a move.
-/
/-- What the pass knows of a function: declared parameter and result types, and the inferences. -/
structure Unique.Info @"urn:deus:unique:Info" where
  infoHash : Text
  params : List Sexp
  resultType : Sexp
  borrowed : List Bool
  freshStruct : Bool

def Unique.applyPrim (p : Text) (args : List Sexp) : Sexp := Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "prim", Sexp.str p] :: args)

/-- The environment a pattern extends `env` to, binding in `Wasm.pattern`'s order, and the locals it
  owns: the array fields of a top-level constructor pattern on a fresh structure. -/
def Unique.bind (cx : Unique.Cx) (env : List Int) (pat : Sexp) (resultOf : Option Sexp) : (List Int, List Int) :=
  match (pat, resultOf) with
  | (Sexp.list (Sexp.sym "pcon" :: Sexp.str t :: Sexp.int tag :: subs), Option.some result) => foldl (fun acc pair =>
      match (acc, pair) with
      | ((bound, ownedFields), i, Sexp.list (Sexp.sym "pvar" :: [])) =>
          let l := Unique.fresh cx
          (l :: bound, if isArray (fieldType cx.cxScope t tag i result) then l :: ownedFields else ownedFields)
      | ((bound, ownedFields), _, sub) => (bindAll cx bound sub, ownedFields)) (env, []) (mapIndexed (fun i x => (i, x)) subs)
  | _ => (bindAll cx env pat, [])

def Unique.bindAll (cx : Unique.Cx) (env : List Int) (pat : Sexp) : List Int :=
  match pat with
  | Sexp.list (Sexp.sym "pvar" :: []) => Unique.fresh cx :: env
  | Sexp.list (Sexp.sym "pas" :: p :: []) => Unique.bindAll cx (Unique.fresh cx :: env) p
  | Sexp.list (Sexp.sym "pcon" :: _ :: _ :: subs) => foldl (fun bound sub => Unique.bindAll cx bound sub) env subs
  | _ => env

/-- How many locals a pattern binds. -/
def Unique.bindCount (pat : Sexp) : Int :=
  match pat with
  | Sexp.list (Sexp.sym "pvar" :: []) => 1
  | Sexp.list (Sexp.sym "pas" :: p :: []) => 1 + Unique.bindCount p
  | Sexp.list (Sexp.sym "pcon" :: _ :: _ :: subs) => foldl (fun n p => n + Unique.bindCount p) 0 subs
  | _ => 0

/-- How a call uses each argument: a borrowed parameter reads it, an owned array consumes it. -/
def Unique.callKinds (f : Info) (n : Int) : List Int := List.map
  (fun i => if getOr (get? f.borrowed i) false then kindBorrow else if isArray (getOr (get? f.params i) unknown) then kindRequire else kindProtect)
  (range 0 n)

def Unique.constructed (form : Sexp) : List Text :=
  match form with
  | Sexp.list (Sexp.sym "con" :: Sexp.str t :: _ :: _ :: []) => [t]
  | Sexp.list items => concatMap Unique.constructed items
  | _ => []

def Unique.copy (e : Sexp) : Sexp := applyPrim "Array.copy" [e]

/-- The data types `fns` construct or take apart, by hash, as `(type …)` objects. -/
def Unique.datatypesOf (fetch : Text -> {Throw Text | r} Option Sexp) (fns : List Fn) : {Throw Text | r} List (Text, Sexp) :=
  let names := dedup (concatMap (fun f => patternTypes f.fnBody ++ Unique.constructed f.fnBody) fns)
  filterMap (fun t => Option.map (fun form => (t, form)) (fetch t)) names

/-- `e` used as `need` asks, once its value is known to be fresh or not. -/
def Unique.demand (need : Int) (pair : (Sexp, Bool)) : (Sexp, Bool) :=
  match pair with
  | (e, isFresh) => if need == kindRequire && not isFresh then (Unique.copy e, true) else pair

/-- The locals `e` uses in a way that keeps or changes them (every use but a read). -/
def Unique.esc (infos : List Info) (env : List Int) (e : Sexp) : List Int :=
  let read := fun a => if isVar a then [] else Unique.esc infos env a
  match e with
  | Sexp.list (Sexp.sym "var" :: Sexp.int _ :: []) => known [localOf env e]
  | Sexp.list (Sexp.sym "let" :: v :: b :: []) => Unique.esc infos env v ++ Unique.esc infos (-1 :: env) b
  | Sexp.list (Sexp.sym "seq" :: a :: b :: []) => read a ++ Unique.esc infos env b
  | Sexp.list (Sexp.sym "if" :: c :: t :: f :: []) => read c ++ Unique.esc infos env t ++ Unique.esc infos env f
  | Sexp.list (Sexp.sym "match" :: s :: cases) => Unique.esc infos env s ++ concatMap (fun c =>
      match c with
      | Sexp.list (Sexp.sym "case" :: pat :: body :: []) => Unique.esc infos (untracked pat env) body
      | _ => []) cases
  | Sexp.list (Sexp.sym "app" :: head :: args) => List.concat (List.map
      (fun pair => if fst pair == kindBorrow then read (snd pair) else Unique.esc infos env (snd pair))
      (zip (kindsOf infos head (List.length args)) args))
  | _ => []

def Unique.fresh (cx : Unique.Cx) : Int :=
  let l := Ref.get cx.cxNext
  Ref.set cx.cxNext (l + 1)
  l

def Unique.freshTail (infos : List Info) (e : Sexp) : Bool :=
  match e with
  | Sexp.list (Sexp.sym "con" :: _ :: _ :: _ :: []) => true
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "con" :: _ :: _ :: _ :: []) :: _) => true
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) :: _) =>
      match Unique.info infos h with
      | Option.some f => f.freshStruct
      | Option.none => false
  | _ => false

def Unique.hasVar (t : Sexp) : Bool :=
  match t with
  | Sexp.list (Sexp.sym "tvar" :: _ :: []) => true
  | Sexp.list items => any Unique.hasVar items
  | _ => false

/-- One round of both inferences; a fixpoint once nothing changes. -/
def Unique.infer (fns : List Fn) (infos : List Info) : List Info :=
  let next := List.map (fun pair =>
    match pair with
    | (f, i) =>
        let escaping := Unique.esc infos (reverse (range 0 f.fnArity)) f.fnBody
        let borrowed := mapIndexed (fun k b => b && not (List.contains k escaping)) i.borrowed
        Info.mk
          i.infoHash
          i.params
          i.resultType
          borrowed
          (i.freshStruct && List.all (fun t => freshTail infos t) (tails f.fnBody))) (zip fns infos)
  if List.all
    (fun pair => (fst pair).borrowed == (snd pair).borrowed && (fst pair).freshStruct == (snd pair).freshStruct)
    (zip next infos) then next else Unique.infer fns next

def Unique.info (infos : List Info) (h : Text) : Option Info := List.find (fun f => f.infoHash == h) infos

def Unique.isArray (t : Sexp) : Bool :=
  match t with
  | Sexp.list (Sexp.sym "tapp" :: Sexp.list (Sexp.sym "tref" :: Sexp.str "#Array" :: []) :: _ :: []) => true
  | _ => false

/-- A type whose values are blocks built by constructors: a fresh structure's candidate result. -/
def Unique.isStruct (t : Sexp) : Bool := if t == unknown || isArray t || isScalar t || hasVar t then false else
  match t with
  | Sexp.list (Sexp.sym "tref" :: Sexp.str _ :: []) => true
  | Sexp.list (Sexp.sym "tapp" :: Sexp.list (Sexp.sym "tref" :: Sexp.str _ :: []) :: _) => true
  | _ => false

def Unique.isVar (e : Sexp) : Bool :=
  match e with
  | Sexp.list (Sexp.sym "var" :: Sexp.int _ :: []) => true
  | _ => false

-- How an argument is used: read (`kindBorrow`), stored (`kindProtect`), consumed (`kindRequire`), or the
-- `Array.set` target (`kindTarget`); `kindFields` is the result of a fresh structure.
def Unique.kindBorrow : Int := 0

def Unique.kindFields : Int := 4

def Unique.kindProtect : Int := 1

def Unique.kindRequire : Int := 2

def Unique.kindTarget : Int := 3

def Unique.kindsOf (infos : List Info) (head : Sexp) (n : Int) : List Int :=
  match head with
  | Sexp.list (Sexp.sym "prim" :: Sexp.str p :: []) => primKinds p n
  | Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) =>
      match Unique.info infos h with
      | Option.some f => callKinds f n
      | Option.none => replicate n kindProtect
  | _ => replicate n kindProtect

def Unique.known (ls : List Int) : List Int := List.filter (fun l => l >= 0) ls

/-- A variable used as `need` says: copied when it must be fresh and is not moved, or when it is an
  owned array stored while still live. Returns the expression and whether its value is fresh. -/
def Unique.leaf (owned : List Int) (live : List Int) (before : List Int) (need : Int) (l : Int) (e : Sexp) : (Sexp, Bool) :=
  let isOwned := List.contains l owned
  let moved := isOwned && not (List.contains l live) && not (List.contains l before)
  if need == kindRequire && not moved then (Unique.copy e, true) else if (need == kindProtect || need == kindFields) && isOwned && not moved then (Unique.copy e, true) else (e, moved)

/-- The local a variable names; binders that this pass does not track are -1. -/
def Unique.localOf (env : List Int) (e : Sexp) : Int :=
  match e with
  | Sexp.list (Sexp.sym "var" :: Sexp.int i :: []) => getOr (get? env i) (-1)
  | _ => -1

/-- The locals `e` mentions. -/
def Unique.occ (env : List Int) (e : Sexp) : List Int :=
  match e with
  | Sexp.list (Sexp.sym "var" :: Sexp.int _ :: []) => known [localOf env e]
  | Sexp.list (Sexp.sym "let" :: v :: b :: []) => Unique.occ env v ++ Unique.occ (-1 :: env) b
  | Sexp.list (Sexp.sym "match" :: s :: cases) => Unique.occ env s ++ concatMap (fun c => occCase env c) cases
  | Sexp.list items => concatMap (fun x => Unique.occ env x) items
  | _ => []

def Unique.occCase (env : List Int) (c : Sexp) : List Int :=
  match c with
  | Sexp.list (Sexp.sym "case" :: pat :: body :: []) => occ (untracked pat env) body
  | _ => []

/-- How a primitive uses each of its `n` arguments. -/
def Unique.primKinds (p : Text) (n : Int) : List Int := if p == "Array.get" then [kindBorrow, kindBorrow] else if p == "Array.length" || p == "Ref.get" then [kindBorrow] else if p == "Array.make" then [kindBorrow, kindProtect] else if p == "Array.set" then [kindTarget, kindBorrow, kindProtect] else if p == "Ref.set" then [kindBorrow, kindProtect] else if p == "Int.neg" || isSome (binary p) then replicate n kindBorrow else replicate n kindProtect

/-- `e` rewritten. `live`: locals used after it; `before`: locals pending in earlier arguments;
  `owned`: the locals this code owns. Returns the expression and whether its value is fresh. -/
def Unique.rewrite (cx : Unique.Cx) (env : List Int) (owned : List Int) (live : List Int) (before : List Int) (need : Int) (e : Sexp) : (Sexp, Bool) :=
  match e with
  | Sexp.list (Sexp.sym "var" :: Sexp.int _ :: []) =>
      let l := localOf env e
      if l < 0 then demand need (e, false) else Unique.leaf owned live before need l e
  | Sexp.list (Sexp.sym "let" :: v :: b :: []) =>
      let l := Unique.fresh cx
      match Unique.rewrite cx env owned (live ++ occ (-1 :: env) b) before kindProtect v with
      | (v2, isFresh) =>
          match Unique.rewrite cx (l :: env) (if isFresh then l :: owned else owned) live before need b with
          | (b2, bodyFresh) => (Sexp.list [Sexp.sym "let", v2, b2], bodyFresh)
  | Sexp.list (Sexp.sym "seq" :: a :: b :: []) =>
      match Unique.rewrite cx env owned (live ++ occ env b) before kindBorrow a with
      | (a2, _) =>
          match Unique.rewrite cx env owned live before need b with
          | (b2, bodyFresh) => (Sexp.list [Sexp.sym "seq", a2, b2], bodyFresh)
  | Sexp.list (Sexp.sym "if" :: c :: t :: f :: []) =>
      match Unique.rewrite cx env owned (live ++ occ env t ++ occ env f) before kindBorrow c with
      | (c2, _) =>
          match (Unique.rewrite cx env owned live before need t, Unique.rewrite cx env owned live before need f) with
          | ((t2, tf), f2, ff) => (Sexp.list [Sexp.sym "if", c2, t2, f2], tf && ff)
  | Sexp.list (Sexp.sym "match" :: s :: cases) =>
      match Unique.rewrite
        cx
        env
        owned
        (live ++ concatMap (fun c => occCase env c) cases)
        before
        kindBorrow
        s with
      | (s2, _) =>
          let arms := List.map (fun c => rewriteCase cx env owned live before need s c) cases
          (Sexp.list (Sexp.sym "match" :: s2 :: List.map fst arms), List.all snd arms)
  | Sexp.list (Sexp.sym "app" :: head :: args) =>
      let shape :=
        match head with
        | Sexp.list (Sexp.sym "con" :: Sexp.str t :: Sexp.int tag :: _ :: []) => if need == kindFields then Option.some (t, tag) else Option.none
        | _ => Option.none
      let kinds :=
        match shape with
        | Option.some (t, tag) => mapIndexed
            (fun i _ => if isArray (fieldType cx.cxScope t tag i cx.cxResult) then kindRequire else kindProtect)
            args
        | Option.none => kindsOf cx.cxInfos head (List.length args)
      match rewriteArgs cx env owned live before kinds args with
      | (args2, inPlace) =>
          match head with
          | Sexp.list (Sexp.sym "prim" :: Sexp.str "Array.set" :: []) => (applyPrim (if inPlace then "Array.setInPlace" else "Array.set") args2, true)
          | Sexp.list (Sexp.sym "prim" :: Sexp.str "Array.make" :: []) => (Sexp.list (Sexp.sym "app" :: head :: args2), true)
          | Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) =>
              let isFresh :=
                match Unique.info cx.cxInfos h with
                | Option.some f => isArray f.resultType
                | Option.none => false
              demand need (Sexp.list (Sexp.sym "app" :: head :: args2), isFresh)
          | _ => demand need (Sexp.list (Sexp.sym "app" :: head :: args2), false)
  | _ => demand need (e, false)

/-- Every function of a module with its `Array.set`s decided and its copies inserted. -/
def Unique.rewriteAll (fns : List Fn) (datatypes : List (Text, Sexp)) : List Fn :=
  let start := List.map (fun f =>
    match peel f.fnArity f.fnType with
    | (params, result) => Info.mk f.fnHash params result (List.map isArray params) (isStruct result)) fns
  let infos := Unique.infer fns start
  List.map (fun pair =>
    match pair with
    | (f, i) =>
        let scope := Wasm.Scope.mk fns datatypes (Ref.new []) (Ref.new [])
        let cx := Unique.Cx.mk infos scope i.resultType (Ref.new f.fnArity)
        let owned := filterMap
          (fun k => if isArray (getOr (get? i.params k) unknown) && not (getOr (get? i.borrowed k) false) then Option.some k else Option.none)
          (range 0 f.fnArity)
        let need := if isArray i.resultType then kindRequire else if i.freshStruct then kindFields else kindProtect
        Fn.mk
          f.fnHash
          f.fnArity
          (fst (Unique.rewrite cx (reverse (range 0 f.fnArity)) owned [] [] need f.fnBody))
          f.fnType) (zip fns infos)

/-- The arguments of one call, left to right, and whether its `target` argument is unique there. A
  variable argument is moved unless a later argument keeps or changes it (a later read happens
  before the call); any other argument runs before the later ones, so every later use counts. -/
def Unique.rewriteArgs (cx : Unique.Cx) (env : List Int) (owned : List Int) (live : List Int) (before : List Int) (kinds : List Int) (args : List Sexp) : (List Sexp, Bool) :=
  let indexed := mapIndexed (fun k a => (k, a)) args
  let results := List.map (fun pair =>
    match pair with
    | (k, a) =>
        let later := List.drop (k + 1) args
        let pending := before ++ concatMap (fun x => tailVars env x) (List.take k args)
        let kind := getOr (get? kinds k) kindProtect
        let need := if kind == kindTarget then kindBorrow else kind
        if isVar a && localOf env a >= 0 then
          match Unique.leaf
            owned
            (live ++ concatMap (fun x => Unique.esc cx.cxInfos env x) later)
            pending
            need
            (localOf env a)
            a with
          | (a2, moved) => (a2, kind == kindTarget && moved)
        else
          match Unique.rewrite cx env owned (live ++ concatMap (fun x => occ env x) later) pending need a with
          | (a2, isFresh) => (a2, kind == kindTarget && isFresh)) indexed
  (List.map fst results, any snd results)

/-- One arm of a match on `s`: fields of a fresh structure that are arrays are owned. -/
def Unique.rewriteCase (cx : Unique.Cx) (env : List Int) (owned : List Int) (live : List Int) (before : List Int) (need : Int) (s : Sexp) (c : Sexp) : (Sexp, Bool) :=
  match c with
  | Sexp.list (Sexp.sym "case" :: pat :: body :: []) =>
      let resultOf :=
        match s with
        | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) :: _) =>
            match Unique.info cx.cxInfos h with
            | Option.some f => if f.freshStruct then Option.some f.resultType else Option.none
            | Option.none => Option.none
        | _ => Option.none
      -- A pattern that binds the scrutinee itself aliases it, so the scrutinee stays live in the arm.
      let aliased :=
        match pat with
        | Sexp.list (Sexp.sym "pvar" :: []) => known [localOf env s]
        | Sexp.list (Sexp.sym "pas" :: _ :: []) => known [localOf env s]
        | _ => []
      match Unique.bind cx env pat resultOf with
      | (env2, ownedFields) =>
          match Unique.rewrite cx env2 (ownedFields ++ owned) (live ++ aliased) before need body with
          | (body2, isFresh) => (Sexp.list [Sexp.sym "case", pat, body2], isFresh)
  | other => (other, false)

/-- The locals `e`'s value may be, when it is not a new value. -/
def Unique.tailVars (env : List Int) (e : Sexp) : List Int :=
  match e with
  | Sexp.list (Sexp.sym "var" :: Sexp.int _ :: []) => known [localOf env e]
  | Sexp.list (Sexp.sym "if" :: _ :: t :: f :: []) => Unique.tailVars env t ++ Unique.tailVars env f
  | Sexp.list (Sexp.sym "seq" :: _ :: b :: []) => Unique.tailVars env b
  | Sexp.list (Sexp.sym "let" :: _ :: b :: []) => Unique.tailVars (-1 :: env) b
  | Sexp.list (Sexp.sym "match" :: s :: cases) => Unique.tailVars env s ++ concatMap (fun c =>
      match c with
      | Sexp.list (Sexp.sym "case" :: pat :: body :: []) => Unique.tailVars (untracked pat env) body
      | _ => []) cases
  | _ => []

/-- `e`'s results: what an `if`, `let`, `seq` or `match` evaluates to last. -/
def Unique.tails (e : Sexp) : List Sexp :=
  match e with
  | Sexp.list (Sexp.sym "if" :: _ :: t :: f :: []) => Unique.tails t ++ Unique.tails f
  | Sexp.list (Sexp.sym "seq" :: _ :: b :: []) => Unique.tails b
  | Sexp.list (Sexp.sym "let" :: _ :: b :: []) => Unique.tails b
  | Sexp.list (Sexp.sym "match" :: _ :: cases) => concatMap (fun c =>
      match c with
      | Sexp.list (Sexp.sym "case" :: _ :: body :: []) => Unique.tails body
      | _ => [c]) cases
  | _ => [e]

def Unique.untracked (pat : Sexp) (env : List Int) : List Int := replicate (bindCount pat) (-1) ++ env
