/-
  Higher-order programs for the C back end's closures (D111): lambdas that capture locals, partial
  application, functions passed and returned as values, and the prelude's `letrec`-based list
  functions, which are lambda-lifted. `docs/spec/NATIVE.md` has the numbers.
-/
inductive Closures.Ints where
  | nil
  | cons (head : Int) (tail : Ints)

def Closures.after (f : Int -> Int) (g : Int -> Int) (x : Int) : Int := f (g x)

def Closures.anyLast (n : Int) : Int := if any (fun x => x == n - 1) (range 0 n) then 1 else 0

/-- Many short-lived closures. -/
def Closures.closureLoop (i : Int) (acc : Int) : Int := if i == 0 then acc else Closures.closureLoop (i - 1) (acc + Closures.run 100 i % 1000)

test Closures.closuresSmall := Closures.run 10 3 == 1185

def Closures.evens (n : Int) : List Int := List.filter (fun x => x % 2 == 0) (range 0 n)

def Closures.foldInts (f : Int -> Int -> Int) (acc : Int) (xs : Ints) : Int :=
  match xs with
  | Ints.nil => acc
  | Ints.cons x rest => Closures.foldInts f (f acc x) rest

def Closures.hof (n : Int) : Int := foldl (fun a b => a + b) 0 (evens n) + opt n + anyLast n + zipped n % 1000

def Closures.hofLoop (i : Int) (n : Int) (acc : Int) : Int := if i == 0 then acc else Closures.hofLoop (i - 1) n ((acc + hof n) % 1000000)

test Closures.hofSmall := hof 100 == 2901

def Closures.mapInts (f : Int -> Int) (xs : Ints) : Ints :=
  match xs with
  | Ints.nil => Ints.nil
  | Ints.cons x rest => Ints.cons (f x) (Closures.mapInts f rest)

def Closures.opt (n : Int) : Int := getOr (Option.map (fun x => x + 1) (head? (reverse (range 0 n)))) 0

def Closures.plus (a : Int) (b : Int) : Int := a + b

/-- Lambdas capturing locals, partial application, a function passed as a value, composition. -/
def Closures.run (n : Int) (k : Int) : Int :=
  let xs := upTo 0 n
  let ys := mapInts (fun x => x * k + 1) xs
  let zs := mapInts (times k) ys
  let ws := mapInts (after (plus 3) (times 2)) zs
  foldInts plus 0 ws + foldInts (fun a b => a + b * b) 0 xs

def Closures.times (k : Int) (x : Int) : Int := k * x

def Closures.upTo (i : Int) (n : Int) : Ints := if i >= n then Ints.nil else Ints.cons i (Closures.upTo (i + 1) n)

def Closures.zipped (n : Int) : Int := foldl (fun acc p => acc + fst p * snd p) 0 (zip (range 0 n) (range 0 n))
