def External.andThen (result : Result e a) (f : a -> {r} Result e b) : {r} Result e b :=
  match result with
  | Result.ok value => f value
  | Result.err error => Result.err error

/-- The `container` block type. -/
@[ext "org.dxos.deus.container@1.0"]
def External.checkContainer (b : Block) : {MdlHost} List Text := problemsOf (containerOf b)

/-- The `requirement` block type. -/
@[ext "org.dxos.deus.requirement@1.0"]
def External.checkRequirement (b : Block) : {MdlHost} List Text := problemsOf (requirementOf b)

/-- A `container` block as data. -/
def External.containerOf (b : Block) : Result (List Text) Container :=
  let image := External.prop b "image"
  let command := List.filter (fun w => not (Text.isEmpty w)) (Text.split (External.prop b "command") " ")
  match (pairsOf (External.prop b "env"), portsOf (External.prop b "ports")) with
  | (Result.ok env, Result.ok ports) =>
      match imageProblems image with
      | [] => Result.ok (Container.mk image command env ports)
      | found => Result.err found
  | (envResult, portResult) => Result.err (problemsOf envResult ++ problemsOf portResult)

def External.crates : Registry := Registry.mk "crates" "https://static.crates.io/crates/{package}/{package}-{version}.crate"

/-- Handles `Containers` with the host's `docker`. -/
def External.docker (body : Unit -> {Containers, IO | r} a) : {IO | r} a :=
  handle body () with
  | Containers.start c -> k => k (match imageProblems c.image with
    | [] => andThen (External.run "docker" (dockerArgs c)) (fun out => Result.ok (trim out))
    | found => Result.err (join "; " found))
  | Containers.stop id -> k =>
      IO.exec "docker" ["stop", id]
      k ()

def External.dockerArgs (c : Container) : List Text := List.concat [["run", "-d", "--rm"], concatMap (fun kv => ["-e", fst kv ++ "=" ++ snd kv]) c.env, concatMap (fun p => ["-p", toText (fst p) ++ ":" ++ toText (snd p)]) c.ports, [c.image], c.command]

/-- Downloads, verifies and unpacks `r` into `dir`; a hash mismatch leaves nothing behind. -/
def External.download (dir : Text) (r : Requirement) : {IO} Result Text Text :=
  let file := dir ++ "/" ++ r.sha256
  let partial := file ++ ".partial"
  IO.mkdirp dir
  andThen
    (External.run "curl" ["-fsSL", "-o", partial, External.resolve r])
    (fun _ => andThen (hashFile partial) (fun actual => if actual != r.sha256 then
      IO.remove partial
      Result.err ("sha256 mismatch for " ++ External.resolve r ++ ": expected " ++ r.sha256 ++ ", got " ++
        actual)
    else andThen
      (External.run "mv" [partial, file])
      (fun _ => if Text.isEmpty r.entry then andThen (External.run "chmod" ["+x", file]) (fun _ => Result.ok file) else
        IO.mkdirp (file ++ ".d")
        andThen
          (External.run "tar" ["-xf", file, "-C", file ++ ".d"])
          (fun _ => Result.ok (located dir r)))))

/-- Handles `Fetch` for real, caching under `dir` by hash; a cached artifact is not fetched again. -/
def External.fetching (dir : Text) (body : Unit -> {Fetch, IO | r} a) : {IO | r} a :=
  handle body () with
  | Fetch.fetch req -> k => k (match External.problems req with
    | [] => if IO.exists (located dir req) then Result.ok (located dir req) else External.download dir req
    | found => Result.err (join "; " found))

/-- `package` is `owner/repo`, `version` the release tag, `platform` the asset's file name. -/
def External.github : Registry := Registry.mk "github" "https://github.com/{package}/releases/download/{version}/{platform}"

/-- The SHA-256 of a file, by the host's `sha256sum`. -/
def External.hashFile (path : Text) : {IO} Result Text Text := andThen (External.run "sha256sum" [path]) (fun out => Result.ok (Text.take 64 out))

/-- `name@sha256:<hex>`: a tag alone may move, so an image is accepted only with its digest. -/
def External.imageProblems (image : Text) : List Text :=
  let at := indexOf image "@sha256:" 0
  if at <= 0 then ["image: " ++ image ++ " has no @sha256: digest; a tag alone may move"] else if isSha256 (Text.drop (at + 8) image) then [] else ["image: the digest of " ++ image ++ " is not 64 lowercase hex digits"]

def External.isHex (t : Text) : Bool := List.all (fun i =>
  let c := code t i
  isDigit c || c >= 'a' && c <= 'f') (range 0 (Text.length t))

def External.isSha256 (t : Text) : Bool := Text.length t == 64 && External.isHex t

/-- The requirement's path once present: the file, or `entry` inside the extracted archive. -/
def External.located (dir : Text) (r : Requirement) : Text := if Text.isEmpty r.entry then dir ++ "/" ++ r.sha256 else dir ++ "/" ++ r.sha256 ++ ".d/" ++ r.entry

def External.npm : Registry := Registry.mk "npm" "https://registry.npmjs.org/{package}/-/{package}-{version}.tgz"

/-- `KEY=VALUE` pairs, one per line or separated by spaces. -/
def External.pairsOf (t : Text) : Result (List Text) (List (Text, Text)) :=
  let items := List.filter (fun w => not (Text.isEmpty w)) (Text.split (replace "\n" " " t) " ")
  let parsed := List.map (fun w =>
    let i := indexOf w "=" 0
    if i <= 0 then Result.err ("env: `" ++ w ++ "` is not KEY=VALUE") else Result.ok (Text.take i w, Text.drop (i + 1) w)) items
  let bad := filterMap (fun r =>
    match r with
    | Result.err e => Option.some e
    | _ => Option.none) parsed
  if List.isEmpty bad then Result.ok (filterMap (fun r =>
    match r with
    | Result.ok kv => Option.some kv
    | _ => Option.none) parsed) else Result.err bad

/-- `HOST:CONTAINER` port pairs. -/
def External.portsOf (t : Text) : Result (List Text) (List (Int, Int)) :=
  match pairsOf (replace ":" "=" t) with
  | Result.err _ => Result.err ["ports: `" ++ t ++ "` is not a list of HOST:CONTAINER"]
  | Result.ok kvs =>
      let ports := filterMap (fun kv =>
        match (fromText (fst kv), fromText (snd kv)) with
        | (Option.some host, Option.some inner) => Option.some (host, inner)
        | _ => Option.none) kvs
      if List.length ports == List.length kvs then Result.ok ports else Result.err ["ports: `" ++ t ++ "` is not a list of HOST:CONTAINER"]

/-- What makes a requirement unpinned: a floating version or a missing or malformed hash. -/
def External.problems (r : Requirement) : List Text := List.concat [if Text.isEmpty r.pkg then ["package: is required"] else [], if r.version == "latest" || r.version == "*" then ["version: " ++ r.version ++ " floats; pin a version"] else [], if isSha256 r.sha256 then [] else ["sha256: must be 64 lowercase hex digits, got `" ++ r.sha256 ++ "`"]]

def External.problemsOf (r : Result (List Text) a) : List Text :=
  match r with
  | Result.ok _ => []
  | Result.err found => found

--
-- MDL blocks.
--
def External.prop (b : Block) (key : Text) : Text := getOr (List.lookup key b.props) ""

def External.registries : List Registry := [npm, crates, github, External.url]

def External.registryNamed (name : Text) : Option Registry := List.find (fun r => r.registryName == name) registries

/-- A `requirement` block as data. -/
def External.requirementOf (b : Block) : Result (List Text) Requirement :=
  match registryNamed (External.prop b "registry") with
  | Option.none => Result.err ["registry: `" ++ External.prop b "registry" ++ "` is not one of " ++
      join ", " (List.map (fun r => r.registryName) registries)]
  | Option.some registry =>
      let req := Requirement.mk
        registry
        (External.prop b "package")
        (External.prop b "version")
        (External.prop b "platform")
        (External.prop b "sha256")
        (External.prop b "entry")
      match External.problems req with
      | [] => Result.ok req
      | found => Result.err found

def External.resolve (r : Requirement) : Text := replace
  "{platform}"
  r.platform
  (replace "{version}" r.version (replace "{package}" r.pkg (r.registry).urlTemplate))

/-- Runs a program; a non-zero exit is an `err` carrying stderr. -/
def External.run (program : Text) (arguments : List Text) : {IO} Result Text Text :=
  match IO.exec program arguments with
  | (0, out, _) => Result.ok out
  | (code, _, err) => Result.err (program ++ " " ++ join " " arguments ++ " exited with " ++ toText code ++ ": " ++ trim err)

/-- Handles `Containers` in memory: returns the result and the `docker` command lines that would have run. -/
def External.simulateContainers (body : Unit -> {Containers | r} a) : {r} (a, List Text) :=
  let log := Ref.new []
  let result :=
    handle body () with
    | Containers.start c -> k =>
        match imageProblems c.image with
        | [] =>
            Ref.set log (("docker " ++ join " " (dockerArgs c)) :: Ref.get log)
            k (Result.ok ("sim-" ++ toText (List.length (Ref.get log))))
        | found => k (Result.err (join "; " found))
    | Containers.stop id -> k =>
        Ref.set log (("docker stop " ++ id) :: Ref.get log)
        k ()
  (result, reverse (Ref.get log))

/-- Handles `Fetch` from memory: `files` maps a hash to its path; anything else is missing. -/
def External.simulateFetch (files : List (Text, Text)) (body : Unit -> {Fetch | r} a) : {r} a :=
  handle body () with
  | Fetch.fetch req -> k => k (match External.problems req with
    | [] => getOr
        (Option.map Result.ok (List.lookup req.sha256 files))
        (Result.err ("not fetched: " ++ External.resolve req))
    | found => Result.err (join "; " found))

/-- Fetches a tool and runs it: (exit code, stdout, stderr). -/
def External.tool (req : Requirement) (arguments : List Text) : {Fetch, IO} Result Text (Int, (Text, Text)) := andThen (Fetch.fetch req) (fun path => Result.ok (IO.exec path arguments))

/-- `package` is the whole URL. -/
def External.url : Registry := Registry.mk "url" "{package}"
