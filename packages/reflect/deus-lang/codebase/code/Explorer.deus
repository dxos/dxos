test Explorer.Spec.aliasesShareAPage := inSite (fun _ =>
  deus "cb" ["area", "zArea"] (fun a => mv a true)
  regenerate ()
  match Map.lookup "area" (Codebase.current "cb") with
  | Option.some e =>
      let page := Spec.file ("def/" ++ pageOf (Entry.hash e) ++ ".json")
      startsWith "{\"name\":\"zArea\"" page && Text.contains "\"aliases\":[\"area\"]" page
  | Option.none => false)

theorem Explorer.Spec.assetNamesAreLong (t : Text) : Assets.isHash t == true -> Text.length t == 64 := by test 100 using hashLike

theorem Explorer.Spec.builtinPagesHaveNoHash (t : Text) : pageOf ("#" ++ t) == "_" ++ t := by test 100

test Explorer.Spec.commentsAreListed := inSite (fun _ =>
  Comments.add
    "cb"
    [(Comments.definition "area", Comment.mk "github:o" "why area?" "t" [])]
    "comment"
  regenerate ()
  match Map.lookup "def:area" (Comments.current "cb") with
  | Option.some (c :: []) => c.note == "why area?" && Text.contains
      "\"def:area\":[{\"author\":\"github:o\",\"note\":\"why area?\""
      (Spec.file "comments.json")
  | _ => false)

test Explorer.Spec.edgesAgree := inStore (fun _ =>
  site (Export.Spec.sample ++
    "\ndef countdown (n : Int) : Int := if n == 0 then 0 else countdown (n - 1)\n")
  let hashes := List.map
    (fun pair => Entry.hash (snd pair))
    (List.filter visible (Map.toList (Codebase.current "cb")))
  List.all (fun h =>
    let page := pageFor h
    List.all (fun u => u != h && List.contains h (refsIn "deps" (pageFor u))) (refsIn "users" page) && List.all (fun d => List.contains h (refsIn "users" (pageFor d))) (refsIn "deps" page)) hashes && any (fun h => not (List.isEmpty (refsIn "users" (pageFor h)))) hashes)

test Explorer.Spec.eventsAreListed := inStore (fun _ =>
  site withEvents
  let h := seeArea ()
  let events := Spec.file "events.json"
  Text.contains "{\"name\":\"Seen\"" events && Text.contains "\"count\":1," events && Text.contains ("\"" ++ h ++ "\":{\"names\":[\"area\"],\"count\":1,") events)

test Explorer.Spec.everyDefinitionHasAPage := inSite (fun _ =>
  let entries := List.filter visible (Map.toList (Codebase.current "cb"))
  List.all
    (fun pair => IO.exists ("site/def/" ++ pageOf (Entry.hash (snd pair)) ++ ".json"))
    entries && IO.exists "site/def/_Bool.json" && Text.contains ("\"definitions\":" ++ toText (List.length entries) ++ ",") (Spec.file "meta.json"))

test Explorer.Spec.featuresAreListed := inStore (fun _ =>
  siteWithFeatures ()
  let json := Spec.file "features.json"
  let first := indexOf json "\"id\":\"F-1\"" 0
  let second := indexOf json "\"id\":\"F-2\"" 0
  Text.contains "\"document\":\"Demo.Features\"" json && first >= 0 && second > first && Text.contains "\"status\":\"shipped\",\"parent\":\"\",\"depth\":0" json && Text.contains "\"defs\":[\"area\"]" json && Text.contains "gap: nothing links this feature" json)

def Explorer.Spec.file (path : Text) : {IO} Text := getOr (IO.readFile ("site/" ++ path)) ""

test Explorer.Spec.generationIsStable := inSite (fun _ =>
  let snapshot := fun u => List.map (fun f => (f, Spec.file ("def/" ++ f))) (IO.listDir "site/def") ++
    [("names", Spec.file "names.json"), ("meta", Spec.file "meta.json")]
  let first := snapshot ()
  regenerate ()
  first == snapshot ())

/-- A generator of asset names: a SHA-256 in hex, or one cut short, so `isHash` sees both (random text never is one). -/
def Explorer.Spec.hashLike (seed : Int) : Text :=
  let h := Text.sha256 (toText seed)
  if seed % 2 == 0 then h else Text.take ((if seed < 0 then 0 - seed else seed) % 64) h

test Explorer.Spec.htmlIsEscaped :=
  let html := htmlLinked Map.empty "def f (a : Int) : Bool := a < 2 && a > 0 -- \"q\" & r"
  Text.contains "&lt;" html && Text.contains "&gt;" html && Text.contains "&amp;&amp;" html && Text.contains "&amp; r" html && not (Text.contains " < " html) && not (Text.contains " > " html)

def Explorer.Spec.inSite (body : Unit -> {IO, Throw Text} Bool) : Bool := inStore (fun _ =>
  site Export.Spec.sample
  body ())

test Explorer.Spec.inboxOpensTasks := inSite (fun _ =>
  applyOne "cb" (Spec.request "github:o")
  any
    (fun t => t.title == "Wrap long lines" && t.labels == ["explorer", "report"] && not (List.isEmpty t.links))
    (Map.values (Tasks.current "cb")))

test Explorer.Spec.inboxRefusesStrangers := inSite (fun _ =>
  match try (fun _ => applyOne "cb" (Spec.request "agent")) with
  | Result.ok _ => false
  | Result.err _ => not (any (fun t => t.title == "Wrap long lines") (Map.values (Tasks.current "cb"))))

test Explorer.Spec.metaCountsEvents := inStore (fun _ =>
  site withEvents
  let before := Text.contains "\"events\":0," (Spec.file "meta.json")
  seeArea ()
  before && Text.contains "\"events\":1," (Spec.file "meta.json"))

test Explorer.Spec.metaCountsFeatures := inStore (fun _ =>
  site Export.Spec.sample
  let before := Text.contains "\"features\":0," (Spec.file "meta.json")
  siteWithFeatures ()
  before && Text.contains "\"features\":2," (Spec.file "meta.json"))

test Explorer.Spec.metaNamesTheConsole := inSite (fun _ =>
  let without := Text.contains "\"console\":false" (Spec.file "meta.json")
  IO.mkdirp "site/console"
  IO.writeFile "site/console/info.json" "{}"
  regenerate ()
  without && Text.contains "\"console\":true" (Spec.file "meta.json"))

test Explorer.Spec.namesAreTheVisibleNames := inSite (fun _ =>
  let listed := namesIn (Spec.file "names.json")
  listed == visibleNames () && listed == sort listed && List.contains "Shape" listed && not (List.contains "Shape.circle" listed) && not (List.contains "Ask.ask" listed))

/-- The `name` fields of a JSON array of objects, in order. -/
def Explorer.Spec.namesIn (json : Text) : List Text := List.map
  (fun piece => Text.take (indexOf piece "\"" 0) piece)
  (List.drop 1 (Text.split json "{\"name\":\""))

theorem Explorer.Spec.otherPagesAreTheHash (t : Text) : startsWith "#" t == false -> pageOf t == t := by test 100

def Explorer.Spec.pageFor (h : Text) : {IO} Text := Spec.file ("def/" ++ pageOf h ++ ".json")

/-- The hashes listed in one of a page's `deps` or `users` arrays. -/
def Explorer.Spec.refsIn (field : Text) (page : Text) : List Text :=
  let start := indexOf page ("\"" ++ field ++ "\":[") 0
  let rest := Text.drop (start + Text.length field + 4) page
  let list := Text.take (indexOf rest "]" 0) rest
  List.map
    (fun piece => Text.take (indexOf piece "\"" 0) piece)
    (List.drop 1 (Text.split list "\"hash\":\""))

def Explorer.Spec.regenerate (u : Unit) : {IO, Throw Text} Int := withHome (fun _ => Explorer.generate "cb" "site")

def Explorer.Spec.request (author : Text) : Sexp := Sexp.read ("(request (kind \"task\") (by \"" ++ author ++
  "\") (at \"t\") (title \"Wrap long lines\") (details \"\") (link \"area\") (labels \"explorer,report\") (assets))")

/-- Records one `Seen` event about `area` and regenerates the site; returns `area`'s hash. -/
def Explorer.Spec.seeArea (u : Unit) : {IO, Throw Text} Text :=
  let ns := Codebase.current "cb"
  match Map.lookup "area" ns with
  | Option.some e =>
      Analytics.record
        "cb"
        (Analytics.find "cb" ns "Seen")
        "claude"
        [("subject", Cell.text ("#" ++ Entry.hash e)), ("note", Cell.text "x")]
      regenerate ()
      Entry.hash e
  | Option.none => Throw.throw "no area"

/-- A codebase from `source` and its site in `site/`. -/
def Explorer.Spec.site (source : Text) : {IO, Throw Text} Int :=
  forEach appFiles (fun f => IO.writeFile ("home/platform/explorer/" ++ f) ("app " ++ f))
  IO.mkdirp "src"
  IO.writeFile "src/a.deus" (Compile.Spec.prelude ++ source)
  deus "cb" ["src"] (fun a => addOrUpdate a false)
  regenerate ()

/-- Generates the sample site with a two-feature map: a shipped feature linked to `area`, and a planned child linked to nothing. -/
def Explorer.Spec.siteWithFeatures (u : Unit) : {IO, Throw Text} Int :=
  let fence := repeat 3 "`"
  IO.mkdirp "src"
  IO.writeFile
    "src/f.mdl"
    ("---\nid: org.dxos.deus.features.demo\nname: Demo.Features\nversion: 1.0\n---\n\n# Demo\n\n## Extensions\n\n| Term | URI |\n| --- | --- |\n| `feature` | `org.dxos.deus.feature@1.0` |\n\n" ++
      fence ++
      "mdl\nfeature F-1: Areas\n  status: shipped\n  defs: area\n" ++
      fence ++
      "\n\n" ++
      fence ++
      "mdl\nfeature F-2: Volumes\n  status: planned\n  parent: F-1\n" ++
      fence ++
      "\n")
  site Export.Spec.sample

test Explorer.Spec.snapshotSkipsLocalState := inSite (fun _ =>
  forEach ["cache/site/x", "artifacts/a", "assets/0", "remotes/origin/url", "exports/k"] (fun f =>
    IO.mkdirp (join "/" (reverse (List.drop 1 (reverse (Text.split ("cb/" ++ f) "/")))))
    IO.writeFile ("cb/" ++ f) "x")
  let files := snapshotFiles "cb"
  List.contains "HEAD" files && any (fun f => startsWith "objects/" f) files && not (any (fun f => any (fun skip => startsWith (skip ++ "/") f) consoleSkips) files))

theorem Explorer.Spec.subjectsNameSomething (t : Text) : isSubject (Comments.definition t) == not (Text.isEmpty t) := by test 100

test Explorer.Spec.usersInvertDependencies := inSite (fun _ =>
  let ns := Codebase.current "cb"
  match (Map.lookup "area" ns, Map.lookup "Shape" ns) with
  | (Option.some area, Option.some shape) =>
      let areaPage := Spec.file ("def/" ++ Entry.hash area ++ ".json")
      let shapePage := Spec.file ("def/" ++ Entry.hash shape ++ ".json")
      let ref := "{\"name\":\"area\",\"hash\":\"" ++ Entry.hash area ++ "\"}"
      Text.contains ("\"hash\":\"" ++ Entry.hash shape ++ "\"") areaPage && Text.contains ref shapePage
  | _ => false)

test Explorer.Spec.verdictsAreShown := inSite (fun _ =>
  deus "cb" [] theorems
  regenerate ()
  match Map.lookup "notNot" (Codebase.current "cb") with
  | Option.some e => Text.contains
      "\"verdict\":\"(pass \\\"decide\\\" 2)\""
      (Spec.file ("def/" ++ Entry.hash e ++ ".json")) && Text.contains
      ("\"name\":\"notNot\",\"kind\":\"theorem\",\"hash\":\"" ++ Entry.hash e ++ "\"")
      (Spec.file "names.json") && Text.contains "\"summary\":\"A theorem.\",\"status\":\"pass\"" (Spec.file "names.json")
  | Option.none => false)

def Explorer.Spec.visibleNames (u : Unit) : {IO, Throw Text} List Text := List.map fst (List.filter visible (Map.toList (Codebase.current "cb")))

/-- The sample codebase with an event type whose `subject` column refers to a definition. -/
def Explorer.Spec.withEvents : Text := Export.Spec.sample ++
  "\nstructure CodeRef @\"urn:deus:analytics:CodeRef\" where\n  target : Text\n\n@[event]\nstructure Seen @\"urn:test:Seen\" where\n  subject : CodeRef\n  note : Text\n"

/-- Answers `$DEUS_HOME` with a simulated directory; the rest of `IO` passes through. -/
def Explorer.Spec.withHome (body : Unit -> {IO, Throw Text} a) : {IO, Throw Text} a :=
  handle body () with
  | IO.getEnv name -> k => k (if name == "DEUS_HOME" then Option.some "home" else IO.getEnv name)

/-- The app's files, from the toolchain's sources. -/
def Explorer.appFiles : List Text := ["index.html", "app.js", "app.css"]

/-- `[("at", seconds)]` when the change's time is known: from its history node (D165), else from
  this store's provenance, which recorded it for changes made here before nodes carried a time. -/
def Explorer.atJson (dir : Text) (causal : Text) : {IO} List (Text, Json) :=
  match madeAt dir causal with
  | Option.some seconds => [("at", Json.num seconds)]
  | Option.none => []

def Explorer.changeJson (dir : Text) (pair : (Text, Causal)) : {IO} Json := Json.obj ([("causal", Json.str (fst pair)), ("message", Json.str (snd pair).message)] ++
  getOr (Option.map (fun agent => [("by", Json.str agent)]) (producedBy dir (fst pair))) [] ++ atJson dir (fst pair))

/-- What a change did, against its first parent: names added, rebound or removed, and tasks it
  touched. A root change compares with an empty namespace. -/
def Explorer.changePage (dir : Text) (causal : Text) : {IO, Throw Text} Json :=
  let node := readCausal dir causal
  let before :=
    match parentsOf dir causal with
    | p :: _ => readCausal dir p
    | [] => Causal.mk "" [] "" "" "" "" "" ""
  let diff := diffNamespaces dir before.snapshot node.snapshot
  let added := filterMap (fun change =>
    match change with
    | (name, Option.none, Option.some e) => if visible (name, e) then Option.some (name, e) else Option.none
    | _ => Option.none) diff
  let changed := filterMap (fun change =>
    match change with
    | (name, Option.some old, Option.some new) => if Entry.hash old == Entry.hash new || not (visible (name, new)) then Option.none else Option.some (name, old, new)
    | _ => Option.none) diff
  let removed := filterMap (fun change =>
    match change with
    | (name, Option.some e, Option.none) => if visible (name, e) then Option.some (name, e) else Option.none
    | _ => Option.none) diff
  -- A rebound name carries both sources, so the app can show the change as a diff; a printer
  -- indexes a whole namespace, so both are read only for changes that rebind something.
  let nsBefore := if List.isEmpty changed || Text.isEmpty before.snapshot then Map.empty else readNamespace dir before.snapshot
  let nsAfter := if List.isEmpty changed then Map.empty else readNamespace dir node.snapshot
  let printers := if List.isEmpty changed then Option.none else Option.some (Print.printer nsBefore [], Print.printer nsAfter [])
  let tasksAfter := Tasks.snapshotOf dir node
  let tasksBefore := Tasks.snapshotOf dir before
  let touched := List.filter
    (fun id => Map.lookup id tasksAfter != Map.lookup id tasksBefore)
    (Set.toList (Set.fromList (Map.keys tasksAfter ++ Map.keys tasksBefore)))
  Json.obj ([("causal", Json.str causal), ("message", Json.str node.message), ("parents", Json.arr (List.map Json.str node.parents)), ("added", Json.arr (List.map (fun pair => refJson (fst pair) (Entry.hash (snd pair))) added)), ("changed", Json.arr (List.map (fun c =>
    match (c, printers) with
    | ((name, old, new), Option.some (pBefore, pAfter)) => Json.obj [("name", Json.str name), ("from", Json.str (Entry.hash old)), ("hash", Json.str (Entry.hash new)), ("before", Json.str (sourceOf pBefore dir nsBefore name old)), ("after", Json.str (sourceOf pAfter dir nsAfter name new))]
    | _ => Json.null) changed)), ("removed", Json.arr (List.map (fun pair => Json.str (fst pair)) removed)), ("tasks", Json.arr (List.map Json.str touched))] ++
    getOr (Option.map (fun agent => [("by", Json.str agent)]) (producedBy dir causal)) [] ++
    atJson dir causal)

/-- Whether a definition has a verdict: tests and theorems are checked, other kinds never are. -/
def Explorer.checked (e : Entry) : Bool := Entry.kind e == "test" || Entry.kind e == "theorem"

/-- Writes `out/console/` (D84): the wasm kernel (base64) and its drivers, the toolchain image, and the
  codebase directory as `codebase.json` (path to text), so the explorer can run `deus` against
  the codebase it shows. The page loads it only when the console opens. Returns the files in the
  snapshot. -/
def Explorer.console (dir : Text) (out : Text) : {IO, Throw Text} Int :=
  let copied := try (fun _ =>
    let home := require "DEUS_HOME"
    let crate := home ++ "/../deus-kernel"
    IO.mkdirp (out ++ "/console")
    -- The site is text end to end (the bundled server and `Remote.writeAll`), so the kernel ships as base64.
    IO.writeFile
      (out ++ "/console/deus_kernel.wasm.b64")
      (Build.tool "openssl" ["base64", "-in", wasmKernel ()])
    Build.tool "cp" [crate ++ "/embed/kernel.mjs", crate ++ "/embed/host.mjs", out ++ "/console/"]
    Build.tool "cp" [home ++ "/seed/deus.image", out ++ "/console/deus.image"])
  match copied with
  | Result.err f => Throw.throw (Failure.render f)
  | Result.ok _ =>
      let files := snapshotFiles dir
      IO.writeFile
        (out ++ "/console/codebase.json")
        (Json.render (Json.obj (List.map (fun f => (f, Json.str (getOr (IO.readFile (dir ++ "/" ++ f)) ""))) files)))
      -- The app offers the console when this small file is there, before loading anything large.
      IO.writeFile
        (out ++ "/console/info.json")
        (Json.render (Json.obj [("files", Json.num (List.length files)), ("branch", Json.str (currentBranch dir))]))
      List.length files

/-- Directories a console snapshot leaves out: local state, binary files and remote bookkeeping. -/
def Explorer.consoleSkips : List Text := ["cache", "artifacts", "assets", "remotes", "exports"]

def Explorer.docOf (meta : Option Sexp) : Option Text := Option.map asText (metaField meta "doc")

/-- Writes the explorer for the current branch to `out`; returns the number of definitions. -/
def Explorer.generate (dir : Text) (out : Text) : {IO, Throw Text} Int :=
  let home :=
    match IO.getEnv "DEUS_HOME" with
    | Option.some h => h
    | Option.none => Throw.throw "$DEUS_HOME is not set; run deus through bin/deus.mjs"
  let ns := Codebase.current dir
  let entries := List.filter visible (Map.toList ns)
  let index := nameIndex ns
  let namesByHash := Codebase.namesByHash ns
  let printer := Print.printer ns []
  let project :=
    match Project.read dir with
    | Option.some p => p.projectIri
    | Option.none => "codebase"
  -- Each definition's object and metadata are read once: its dependencies, and dependents inverted from them.
  let metaOf := Map.fromList (List.map (fun pair => (Entry.hash (snd pair), readMeta dir (Entry.hash (snd pair)))) entries)
  let metaFor := fun h => getOr (Map.lookup h metaOf) Option.none
  let depsOf := Map.fromList (List.map (fun pair =>
    let h := Entry.hash (snd pair)
    let fromObject := getOr (Option.map namedHashes (readObject dir h)) []
    let fromScheme := getOr (Option.map namedHashes (metaField (metaFor h) "scheme")) []
    (h, dedup (sort (fromObject ++ fromScheme)))) entries)
  let dependents := Map.foldr
    (fun h ds m => foldl (fun m2 d => Map.insert d (h :: getOr (Map.lookup d m2) []) m2) m ds)
    Map.empty
    depsOf
  let tasks := sortBy order (Map.values (Tasks.current dir))
  let taskMap := Map.fromList (List.map (fun t => (t.id, t)) tasks)
  let histories := histories dir 200
  let historyOf := fun t => getOr (Map.lookup t.id histories) []
  IO.mkdirp (out ++ "/def")
  forEach appFiles (fun f =>
    match IO.readFile (home ++ "/platform/explorer/" ++ f) with
    | Option.some text => IO.writeFile (out ++ "/" ++ f) text
    | Option.none => Throw.throw ("missing " ++ home ++ "/platform/explorer/" ++ f))
  let branch := currentBranch dir
  -- Events about the codebase (D104), for the Events card and per-definition counts; a codebase
  -- whose event types cannot be read still gets a site, with no events.
  let events :=
    match try (fun _ =>
      let ts := Analytics.types dir ns
      (siteJson dir project ns 20, sum (List.map (fun c =>
        match c with
        | (_, pending, pushed) => pending + pushed) (counts dir ts)))) with
    | Result.ok pair => pair
    | Result.err _ => (Json.obj [("project", Json.str project), ("types", Json.arr []), ("byDefinition", Json.obj [])], 0)
  IO.writeFile (out ++ "/events.json") (Json.render (fst events))
  -- Feature maps (D118) for the Features card; a map that cannot be read leaves the card empty rather than the site missing.
  let featureMaps :=
    match try (fun _ =>
      let docs := featureDocuments dir ns
      (featuresJson dir ns docs, sum (List.map (fun d => List.length (fst (featuresOf dir ns d))) docs))) with
    | Result.ok pair => pair
    | Result.err _ => (Json.arr [], 0)
  IO.writeFile (out ++ "/features.json") (Json.render (fst featureMaps))
  IO.writeFile
    (out ++ "/meta.json")
    (Json.render (Json.obj [("project", Json.str project), ("branch", Json.str branch), ("branches", Json.arr (List.map Json.str (branches dir))), ("definitions", Json.num (List.length entries)), ("tasks", Json.num (List.length tasks)), ("open", Json.num (List.length (List.filter isOpen tasks))), ("console", Json.bool (IO.exists (out ++ "/console/info.json"))), ("events", Json.num (snd events)), ("features", Json.num (snd featureMaps)), ("history", Json.arr (List.map (logJson dir) (fullLog dir historyLimit)))]))
  -- The signature and doc summary let the app list, search and preview names without opening their pages.
  IO.writeFile (out ++ "/names.json") (Json.render (Json.arr (List.map (fun pair =>
    let h := Entry.hash (snd pair)
    Json.obj [("name", Json.str (fst pair)), ("kind", Json.str (Entry.kind (snd pair))), ("hash", Json.str h), ("sig", Json.str (Explorer.signature (Option.map (Codebase.metaFor (fst pair)) (metaFor h)))), ("summary", Json.str (summaryOf (Explorer.docOf (Option.map (Codebase.metaFor (fst pair)) (metaFor h))))), ("status", Json.str (if Explorer.checked (snd pair) then statusOf (Explorer.verdictOf dir h) else ""))]) entries)))
  IO.writeFile
    (out ++ "/tasks.json")
    (Json.render (Json.arr (List.map (fun t => Explorer.taskJson dir ns (historyOf t) t) tasks)))
  -- Comments on definitions and changes (D82), by subject, and the assets they and tasks attach.
  IO.writeFile (out ++ "/comments.json") (Json.render (Json.obj (List.map
    (fun pair => (fst pair, Json.arr (List.map commentJson (snd pair))))
    (Map.toList (Comments.current dir)))))
  IO.mkdirp (out ++ "/assets")
  forEach
    (Assets.named dir)
    (fun h => if IO.exists (out ++ "/assets/" ++ h) || not (Assets.has dir h) then () else
      IO.exec "cp" [Assets.path dir h, out ++ "/assets/" ++ h]
      ())
  -- A page per change the app links to: recent history, and every change in a task's history.
  IO.mkdirp (out ++ "/change")
  let linked := concatMap (fun t => List.map fst (historyOf t)) tasks
  let shown := Set.toList (Set.fromList (List.map fst (Codebase.history dir branch 30) ++ linked))
  forEach shown (fun c =>
    let path := out ++ "/change/" ++ c ++ ".json"
    -- A change never changes, so a page written once stays right.
    if IO.exists path then () else IO.writeFile path (Json.render (changePage dir c)))
  forEach entries (fun pair =>
    match pair with
    | (name, e) =>
        let h := Entry.hash e
        let source :=
          match try (fun _ => viewEntryWith printer dir ns name e false) with
          | Result.ok text => join "\n" (List.filter (fun l => not (startsWith "-- " l)) (Text.lines text))
          | Result.err message => "-- " ++ message
        -- The same definition in the TypeScript-like dialect (D70), shown when the viewer picks it.
        let tsSource :=
          match try (fun _ => viewEntryIn printer dir ns name e "ts") with
          | Result.ok text => join "\n" (List.filter (fun l => not (startsWith "// " l)) (Text.lines text))
          | Result.err message => "// " ++ message
        let deps := List.filter (fun d => Map.contains d index && d != h) (getOr (Map.lookup h depsOf) [])
        -- References in the source print under their display names; those names link to the definitions.
        let links := Map.fromList (List.map (fun d => (nameFor printer d, d)) deps)
        -- A recursive definition depends on itself; listing it as its own user would make the graph view loop.
        let users := List.filter (fun u => u != h) (dedup (sort (getOr (Map.lookup h dependents) [])))
        let named := fun hs => Json.arr (List.map (fun x => refJson (getOr (Map.lookup x index) (short x)) x) hs)
        let meta := Option.map (Codebase.metaFor name) (metaFor h)
        let sig := Explorer.signature meta
        IO.writeFile
          (out ++ "/def/" ++ pageOf h ++ ".json")
          (Json.render (Json.obj [("name", Json.str name), ("kind", Json.str (Entry.kind e)), ("hash", Json.str h), ("aliases", Json.arr (List.map
            Json.str
            (List.filter (fun other => other != name) (getOr (Map.lookup h namesByHash) [])))), ("signature", Json.str (if Text.isEmpty sig then "" else lastOf name ++ " : " ++ sig)), ("doc", getOr (Option.map Json.str (Explorer.docOf meta)) Json.null), ("html", Json.str (htmlLinked links source)), ("ts", Json.str (htmlLinkedIn "ts" links tsSource)), ("deps", named deps), ("users", named users), ("verdict", Json.str (Explorer.verdictOf dir h)), ("tasks", Json.arr (List.map
            (fun t => Json.obj [("id", Json.str t.id), ("title", Json.str t.title), ("state", Json.str (stateText t.state))])
            (about taskMap name h)))])))
  List.length entries

/-- How many changes the History view lists, imported ones (D67) included. -/
def Explorer.historyLimit : Int := 1000

def Explorer.lastOf (name : Text) : Text := getOr (last? (Text.split name ".")) name

/-- A row of the full log. A change imported from an export has no causal node in this store, so it
  is marked `imported` and gets no page. -/
def Explorer.logJson (dir : Text) (entry : (Text, (Text, Text))) : {IO} Json :=
  match entry with
  | (h, message, agent) => Json.obj ([("causal", Json.str h), ("message", Json.str message)] ++
      (if Text.isEmpty agent then [] else [("by", Json.str agent)]) ++ atJson dir h ++ (if isSome (readObject dir h) then [] else [("imported", Json.bool true)]))

/-- Every hash a form names, builtins included. Unlike `Codebase.dependencies`, which lists what an
  update must propagate to, this also counts types named only in a signature, so `Bool` has users. -/
def Explorer.namedHashes (form : Sexp) : List Text :=
  let rec go x acc :=
    match x with
    | Sexp.list (Sexp.sym head :: Sexp.str h :: rest) => foldl (fun a y => go y a) (if Map.contains head refHeads then h :: acc else acc) rest
    | Sexp.list items => foldl (fun a y => go y a) acc items
    | _ => acc
  go form []

/-- A definition's page file: builtin hashes are IRIs such as `#Bool`, and `#` cannot appear in a URL path. -/
def Explorer.pageOf (h : Text) : Text := if startsWith "#" h then "_" ++ Text.drop 1 h else h

/-- Heads of the forms that name another definition: terms, constructors, operations and types. -/
def Explorer.refHeads : Map Text Unit := Set.fromList ["ref", "tref", "con", "pcon", "op", "on"]

def Explorer.refJson (name : Text) (h : Text) : Json := Json.obj [("name", Json.str name), ("hash", Json.str h)]

/-
  The codebase explorer (D58): a single-page app over JSON written from a codebase, in the spirit
  of Unison Share. Definitions and tasks open as cards in one workspace, so several can be read
  at once, and a task board shows every task by state. The app is static files, so the same
  output is served locally (`deus explore`, by the native web runtime and `platform/site.deus`)
  and hosted from the bucket that holds the codebase's bundles (`deus explore --publish <remote>`).

    index.html, app.js, app.css   the app (`platform/explorer/`), copied as they are
    meta.json                     the project, branches, counts and recent history
    names.json                    every visible name: name, kind, hash
    def/<hash>.json               a definition: names, signature, highlighted source with its
                                  references linked, dependencies, dependents, verdict, tasks
    tasks.json                    every task, with its links resolved and its history
    comments.json                 comments on definitions and changes, by subject (D82)
    assets/<sha256>               the files comments and tasks attach
    console/                      with `--console` (D84): the wasm kernel (as base64), its
                                  drivers, the toolchain image and `codebase.json`, so the page
                                  runs `deus` against this codebase with no server
-/
def Explorer.signature (meta : Option Sexp) : Text := getOr (Option.map (fun s => displayScheme s) (metaField meta "scheme")) ""

/-- The codebase files a console snapshot holds: all of them but those under `consoleSkips`. -/
def Explorer.snapshotFiles (dir : Text) : {IO} List Text := List.filter
  (fun f => not (any (fun skip => startsWith (skip ++ "/") f) consoleSkips))
  (filesUnder dir "")

/-- A definition's source as `deus view` prints it, without its `-- ` header lines. -/
def Explorer.sourceOf (printer : Printer) (dir : Text) (ns : Map Text Entry) (name : Text) (e : Entry) : {IO} Text :=
  match try (fun _ => viewEntryWith printer dir ns name e false) with
  | Result.ok text => join "\n" (List.filter (fun l => not (startsWith "-- " l)) (Text.lines text))
  | Result.err message => "-- " ++ message

/-- `pass` or `fail` from a cached verdict, or `""` when there is none. -/
def Explorer.statusOf (verdict : Text) : Text := if startsWith "(pass" verdict then "pass" else if startsWith "(fail" verdict then "fail" else ""

/-- The first line of a doc comment, for listings. -/
def Explorer.summaryOf (doc : Option Text) : Text := trim (getOr (Option.bind doc (fun d => head? (Text.lines (trim d)))) "")

def Explorer.taskJson (dir : Text) (ns : Map Text Entry) (history : List (Text, Causal)) (t : Task) : {IO, Throw Text} Json :=
  let link := fun a =>
    match a with
    | Attachment.definition name linked => Json.obj [("definition", Json.str name), ("hash", Json.str linked), ("current", getOr (Option.map (fun e => Json.str (Entry.hash e)) (Map.lookup name ns)) Json.null)]
    | Attachment.change h =>
        let message :=
          match readObject dir h with
          | Option.some form => (causalFromSexp form).message
          | Option.none => ""
        Json.obj [("change", Json.str h), ("message", Json.str message)]
  Json.obj [("id", Json.str t.id), ("title", Json.str t.title), ("state", Json.str (stateText t.state)), ("priority", Json.num t.priority), ("assignee", Json.str t.assignee), ("labels", Json.arr (List.map Json.str t.labels)), ("parent", Json.str t.parent), ("details", Json.str t.details), ("links", Json.arr (List.map link t.links)), ("comments", Json.arr (List.map commentJson t.comments)), ("history", Json.arr (List.map (Explorer.changeJson dir) history))]

def Explorer.verdictOf (dir : Text) (h : Text) : {IO} Text := trim (getOr (IO.readFile (dir ++ "/results/" ++ h)) "")

/-- Names that are not hidden: not constructors' and operations' own pages. -/
def Explorer.visible (pair : (Text, Entry)) : Bool :=
  match snd pair with
  | Entry.ctor _ _ _ => false
  | Entry.op _ _ _ => false
  | _ => true
