/-- The app's files, from the toolchain's sources. -/
def Explorer.appFiles : List Text := ["index.html", "app.js", "app.css"]

def Explorer.changeJson (dir : Text) (pair : (Text, Causal)) : {IO} Json := Json.obj ([("causal", Json.str (fst pair)), ("message", Json.str (snd pair).message)] ++
  getOr (Option.map (fun agent => [("by", Json.str agent)]) (producedBy dir (fst pair))) [])

/-- What a change did, against its first parent: names added, rebound or removed, and tasks it
  touched. A root change compares with an empty namespace. -/
def Explorer.changePage (dir : Text) (causal : Text) : {IO, Throw Text} Json :=
  let node := readCausal dir causal
  let before :=
    match parentsOf dir causal with
    | p :: _ => readCausal dir p
    | [] => Causal.mk "" [] "" ""
  let nsAfter := readNamespace dir node.snapshot
  let nsBefore := if Text.isEmpty before.snapshot then Map.empty else readNamespace dir before.snapshot
  let visibleNames := fun ns => List.filter visible (Map.toList ns)
  let added := List.filter (fun pair => isNone (Map.lookup (fst pair) nsBefore)) (visibleNames nsAfter)
  let changed := filterMap (fun pair =>
    match Map.lookup (fst pair) nsBefore with
    | Option.some old => if hash old == hash (snd pair) then Option.none else Option.some (fst pair, old, snd pair)
    | Option.none => Option.none) (visibleNames nsAfter)
  let printers := if List.isEmpty changed then Option.none else Option.some (printer nsBefore [], printer nsAfter [])
  let removed := List.filter (fun pair => isNone (Map.lookup (fst pair) nsAfter)) (visibleNames nsBefore)
  let tasksAfter := snapshotOf dir node
  let tasksBefore := snapshotOf dir before
  let touched := List.filter
    (fun id => Map.lookup id tasksAfter != Map.lookup id tasksBefore)
    (Set.toList (Set.fromList (Map.keys tasksAfter ++ Map.keys tasksBefore)))
  Json.obj ([("causal", Json.str causal), ("message", Json.str node.message), ("parents", Json.arr (List.map Json.str node.parents)), ("added", Json.arr (List.map (fun pair => refJson (fst pair) (hash (snd pair))) added)), ("changed", Json.arr (List.map (fun c =>
    match (c, printers) with
    | ((name, old, new), Option.some (pBefore, pAfter)) => Json.obj [("name", Json.str name), ("from", Json.str (hash old)), ("hash", Json.str (hash new)), ("before", Json.str (sourceOf pBefore dir nsBefore name old)), ("after", Json.str (sourceOf pAfter dir nsAfter name new))]
    | _ => Json.null) changed)), ("removed", Json.arr (List.map (fun pair => Json.str (fst pair)) removed)), ("tasks", Json.arr (List.map Json.str touched))] ++
    getOr (Option.map (fun agent => [("by", Json.str agent)]) (producedBy dir causal)) [])

/-- Whether a definition has a verdict: tests and theorems are checked, other kinds never are. -/
def Explorer.checked (e : Entry) : Bool := Entry.kind e == "test" || Entry.kind e == "theorem"

def Explorer.docOf (meta : Option Sexp) : Option Text := Option.map asText (metaField meta "doc")

/-- Writes the explorer for the current branch to `out`; returns the number of definitions. -/
def Explorer.generate (dir : Text) (out : Text) : {IO, Throw Text} Int :=
  let home :=
    match IO.getEnv "DEUS_HOME" with
    | Option.some h => h
    | Option.none => Throw.throw "$DEUS_HOME is not set; run deus through bin/deus.mjs"
  let ns := Codebase.current dir
  let entries := List.filter visible (Map.toList ns)
  let index := nameIndex ns
  let namesByHash := namesByHash ns
  let printer := printer ns []
  let project :=
    match Project.read dir with
    | Option.some p => p.projectIri
    | Option.none => "codebase"
  let metaOf := Map.fromList (List.map (fun pair => (hash (snd pair), readMeta dir (hash (snd pair)))) entries)
  let metaFor := fun h => getOr (Map.lookup h metaOf) Option.none
  let depsOf := Map.fromList (List.map (fun pair =>
    let h := hash (snd pair)
    let fromObject := getOr (Option.map namedHashes (readObject dir h)) []
    let fromScheme := getOr (Option.map namedHashes (metaField (metaFor h) "scheme")) []
    (h, dedup (sort (fromObject ++ fromScheme)))) entries)
  let dependents := Map.foldr
    (fun h ds m => foldl (fun m2 d => Map.insert d (h :: getOr (Map.lookup d m2) []) m2) m ds)
    Map.empty
    depsOf
  let tasks := sortBy order (Map.values (Tasks.current dir))
  let taskMap := Map.fromList (List.map (fun t => (t.id, t)) tasks)
  let histories := histories dir 200
  let historyOf := fun t => getOr (Map.lookup t.id histories) []
  IO.mkdirp (out ++ "/def")
  forEach appFiles (fun f =>
    match IO.readFile (home ++ "/platform/explorer/" ++ f) with
    | Option.some text => IO.writeFile (out ++ "/" ++ f) text
    | Option.none => Throw.throw ("missing " ++ home ++ "/platform/explorer/" ++ f))
  let branch := currentBranch dir
  IO.writeFile
    (out ++ "/meta.json")
    (Json.render (Json.obj [("project", Json.str project), ("branch", Json.str branch), ("branches", Json.arr (List.map Json.str (branches dir))), ("definitions", Json.num (List.length entries)), ("tasks", Json.num (List.length tasks)), ("open", Json.num (List.length (List.filter isOpen tasks))), ("history", Json.arr (List.map (Cli.changeJson dir) (history dir branch 30)))]))
  IO.writeFile (out ++ "/names.json") (Json.render (Json.arr (List.map (fun pair =>
    let h := hash (snd pair)
    Json.obj [("name", Json.str (fst pair)), ("kind", Json.str (Entry.kind (snd pair))), ("hash", Json.str h), ("sig", Json.str (Explorer.signature (metaFor h))), ("summary", Json.str (summaryOf (docOf (metaFor h)))), ("status", Json.str (if checked (snd pair) then statusOf (verdictOf dir h) else ""))]) entries)))
  IO.writeFile
    (out ++ "/tasks.json")
    (Json.render (Json.arr (List.map (fun t => Explorer.taskJson dir ns (historyOf t) t) tasks)))
  IO.mkdirp (out ++ "/change")
  let linked := concatMap (fun t => List.map fst (historyOf t)) tasks
  let shown := Set.toList (Set.fromList (List.map fst (history dir branch 30) ++ linked))
  forEach shown (fun c =>
    let path := out ++ "/change/" ++ c ++ ".json"
    if IO.exists path then () else IO.writeFile path (Json.render (changePage dir c)))
  forEach entries (fun pair =>
    match pair with
    | (name, e) =>
        let h := hash e
        let source :=
          match try (fun _ => viewEntryWith printer dir ns name e false) with
          | Result.ok text => join "\n" (List.filter (fun l => not (startsWith "-- " l)) (lines text))
          | Result.err message => "-- " ++ message
        let deps := List.filter (fun d => Map.contains d index && d != h) (getOr (Map.lookup h depsOf) [])
        let links := Map.fromList (List.map (fun d => (nameFor printer d, d)) deps)
        let users := dedup (sort (getOr (Map.lookup h dependents) []))
        let named := fun hs => Json.arr (List.map (fun x => refJson (getOr (Map.lookup x index) (short x)) x) hs)
        let meta := metaFor h
        let sig := Explorer.signature meta
        IO.writeFile
          (out ++ "/def/" ++ pageOf h ++ ".json")
          (Json.render (Json.obj [("name", Json.str name), ("kind", Json.str (Entry.kind e)), ("hash", Json.str h), ("aliases", Json.arr (List.map
            Json.str
            (List.filter (fun other => other != name) (getOr (Map.lookup h namesByHash) [])))), ("signature", Json.str (if Text.isEmpty sig then "" else lastOf name ++ " : " ++ sig)), ("doc", getOr (Option.map Json.str (docOf meta)) Json.null), ("html", Json.str (htmlLinked links source)), ("deps", named deps), ("users", named users), ("verdict", Json.str (verdictOf dir h)), ("tasks", Json.arr (List.map
            (fun t => Json.obj [("id", Json.str t.id), ("title", Json.str t.title), ("state", Json.str (stateText t.state))])
            (about taskMap name h)))])))
  List.length entries

def Explorer.lastOf (name : Text) : Text := getOr (last? (Text.split name ".")) name

/-- Every hash a form names, builtins included. Unlike `Codebase.dependencies`, which lists what an
  update must propagate to, this also counts types named only in a signature, so `Bool` has users. -/
def Explorer.namedHashes (form : Sexp) : List Text :=
  let rec go x acc :=
    match x with
    | Sexp.list (Sexp.sym head :: Sexp.str h :: rest) => foldl (fun a y => go y a) (if Map.contains head refHeads then h :: acc else acc) rest
    | Sexp.list items => foldl (fun a y => go y a) acc items
    | _ => acc
  go form []

/-- A definition's page file: builtin hashes are IRIs such as `#Bool`, and `#` cannot appear in a URL path. -/
def Explorer.pageOf (h : Text) : Text := if startsWith "#" h then "_" ++ Text.drop 1 h else h

/-- Heads of the forms that name another definition: terms, constructors, operations and types. -/
def Explorer.refHeads : Map Text Unit := Set.fromList ["ref", "tref", "con", "pcon", "op", "on"]

def Explorer.refJson (name : Text) (h : Text) : Json := Json.obj [("name", Json.str name), ("hash", Json.str h)]

def Explorer.signature (meta : Option Sexp) : Text := getOr (Option.map (fun s => displayScheme s) (metaField meta "scheme")) ""

/-- A definition's source as `deus view` prints it, without its `-- ` header lines. -/
def Explorer.sourceOf (printer : Printer) (dir : Text) (ns : Map Text Entry) (name : Text) (e : Entry) : {IO} Text :=
  match try (fun _ => viewEntryWith printer dir ns name e false) with
  | Result.ok text => join "\n" (List.filter (fun l => not (startsWith "-- " l)) (lines text))
  | Result.err message => "-- " ++ message

/-- `pass` or `fail` from a cached verdict, or `""` when there is none. -/
def Explorer.statusOf (verdict : Text) : Text := if startsWith "(pass" verdict then "pass" else if startsWith "(fail" verdict then "fail" else ""

/-- The first line of a doc comment, for listings. -/
def Explorer.summaryOf (doc : Option Text) : Text := trim (getOr (Option.bind doc (fun d => head? (lines (trim d)))) "")

def Explorer.taskJson (dir : Text) (ns : Map Text Entry) (history : List (Text, Causal)) (t : Task) : {IO, Throw Text} Json :=
  let link := fun a =>
    match a with
    | Attachment.definition name linked => Json.obj [("definition", Json.str name), ("hash", Json.str linked), ("current", getOr (Option.map (fun e => Json.str (hash e)) (Map.lookup name ns)) Json.null)]
    | Attachment.change h =>
        let message :=
          match readObject dir h with
          | Option.some form => (causalFromSexp form).message
          | Option.none => ""
        Json.obj [("change", Json.str h), ("message", Json.str message)]
  Json.obj [("id", Json.str t.id), ("title", Json.str t.title), ("state", Json.str (stateText t.state)), ("priority", Json.num t.priority), ("assignee", Json.str t.assignee), ("labels", Json.arr (List.map Json.str t.labels)), ("parent", Json.str t.parent), ("details", Json.str t.details), ("links", Json.arr (List.map link t.links)), ("comments", Json.arr (List.map (fun c => Json.obj [("author", Json.str c.author), ("note", Json.str c.note)]) t.comments)), ("history", Json.arr (List.map (Cli.changeJson dir) history))]

def Explorer.verdictOf (dir : Text) (h : Text) : {IO} Text := trim (getOr (IO.readFile (dir ++ "/results/" ++ h)) "")

/-- Names that are not hidden: not constructors' and operations' own pages. -/
def Explorer.visible (pair : (Text, Entry)) : Bool :=
  match snd pair with
  | Entry.ctor _ _ _ => false
  | Entry.op _ _ _ => false
  | _ => true
