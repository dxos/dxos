/-- Every case at once, so a test can check the lot. -/
def Aliasing.all (n : Int) : Int := keepOld n + earlierArgument n + laterArgument n + letAlias n + inStructure n + matchAlias n +
  sharedItem n + twoNew n + sameTwice n + ifAlias n + inRef n + throughGeneric n + returned n + Aliasing.chain n

test Aliasing.allAgree := keepOld 3 == 105 && earlierArgument 3 == 1115 && laterArgument 3 == 9002 && letAlias 3 == 39 && inStructure 3 == 1049 && matchAlias 3 == 59 && sharedItem 3 == 69 && twoNew 3 == 12 && sameTwice 3 == 89 && ifAlias 3 == 39 && inRef 3 == 49 && throughGeneric 3 == 5795 && returned 3 == 69 && Aliasing.chain 3 == 3

/-- Through a generic function, which may return what it was given. -/
def Aliasing.back (x : t) : t := x

def Aliasing.chain (n : Int) : Int :=
  let a := Aliasing.fillGo (Array.make n 0) 0 n
  sumGo a (n - 1) 0

def Aliasing.earlierArgument (n : Int) : Int :=
  let a := Array.make n 1
  pair (first a) (Array.set a 0 7) + mixed a (Array.set a 0 8)

/-- A run of writes to the newest array: every one in place. -/
def Aliasing.fillGo (a : Array Int) (i : Int) (n : Int) : Array Int := if i >= n then a else Aliasing.fillGo (Array.set a i i) (i + 1) n

/-
  Aliasing cases for the pure `Array` (D96, docs/spec/ARRAY.mdl): each keeps an old array alive
  while a new one is made from it, in a different way. Every function gives the same number on the
  kernels, in wasm and in C; compiled, `deus/unique.deus` must copy exactly where an old array is
  still read, or the number changes.
-/
def Aliasing.first (a : Array Int) : Int := Array.get a 0

/-- An `if` whose result may be the array. -/
def Aliasing.ifAlias (n : Int) : Int :=
  let a := Array.make n 3
  let b := if n > 2 then a else Array.make n 0
  let c := Array.set a 0 9
  first b * 10 + first c

/-- The array in a `Ref`. -/
def Aliasing.inRef (n : Int) : Int :=
  let a := Array.make n 4
  let r := Ref.new a
  let c := Array.set a 0 9
  first (Ref.get r) * 10 + first c

/-- The array stored in a structure. -/
def Aliasing.inStructure (n : Int) : Int :=
  let a := Array.make n 4
  let p := (a, 1)
  let c := Array.set a 0 9
  match p with
  | (x, k) => first x * 10 + first c + k * 1000

/-- The old array, read after the new one is made. -/
def Aliasing.keepOld (n : Int) : Int :=
  let a := Array.make n 1
  let b := Array.set a 0 5
  Array.get a 0 * 100 + Array.get b 0

/-- A later argument reads the array an earlier one writes. -/
def Aliasing.laterArgument (n : Int) : Int :=
  let a := Array.make n 2
  mixed (Array.set a 0 9) a

/-- A second name for the array. -/
def Aliasing.letAlias (n : Int) : Int :=
  let a := Array.make n 3
  let b := a
  let c := Array.set a 0 9
  first b * 10 + first c

/-- A match that names the array itself. -/
def Aliasing.matchAlias (n : Int) : Int :=
  let a := Array.make n 5
  match a with
  | x =>
      let c := Array.set a 0 9
      first x * 10 + first c

def Aliasing.mixed (a : Array Int) (b : Array Int) : Int := first a * 1000 + first b

/-- An earlier argument still holds the array the later one writes. -/
def Aliasing.pair (x : Int) (a : Array Int) : Int := x * 100 + first a

def Aliasing.returned (n : Int) : Int :=
  let a := Array.make n 6
  let b := Array.set (id a) 0 9
  first a * 10 + first b

/-- Through a generic function, which may return what it was given. -/
def Aliasing.same (x : t) : t := x

def Aliasing.sameTwice (n : Int) : Int :=
  let a := Array.make n 8
  writeBoth a a

/-- Arrays made with `make` share their item: writing into one item must not change the other. -/
def Aliasing.sharedItem (n : Int) : Int :=
  let outer := Array.make 2 (Array.make n 6)
  let inner := Array.set (Array.get outer 0) 0 9
  first (Array.get outer 1) * 10 + first inner

def Aliasing.sumGo (a : Array Int) (i : Int) (acc : Int) : Int := if i < 0 then acc else Aliasing.sumGo a (i - 1) (acc + Array.get a i)

def Aliasing.throughGeneric (n : Int) : Int :=
  let a := Array.make n 5
  let b := id a
  let c := Array.set a 0 9
  let d := Array.set b 1 7
  first b * 1000 + Array.get d 1 * 100 + first c * 10 + Array.get a 1

/-- Two new arrays from one old one. -/
def Aliasing.twoFrom (a : Array Int) : (Array Int, Array Int) := (Array.set a 0 1, Array.set a 0 2)

def Aliasing.twoNew (n : Int) : Int :=
  match twoFrom (Array.make n 7) with
  | (b, c) => first b * 10 + first c

/-- One array passed for two owned parameters. -/
def Aliasing.writeBoth (a : Array Int) (b : Array Int) : Int :=
  let c := Array.set a 0 9
  first b * 10 + first c
