/-- Infers every pending definition's type, dependencies first; returns "@name" to scheme. -/
def Unnamed.h073a4d6c1d (objectOf : Text -> {Throw Text | r} Option Sexp) (metaOf : Text -> {Throw Text | r} Option Sexp) (prims : Text -> {Throw Text | r} Option Sexp) (pending : List Pending) (warnOnly : Bool) (warnings : Ref (List Text)) : {Throw Text | r} Map Text Sexp :=
  let byName := Map.fromList (List.map (fun p => (p.name, p)) pending)
  let depMap := Compile.dependencies byName
  let deps := fun name => getOr (Map.lookup name depMap) []
  let schemes := Ref.new Map.empty
  forEach (components (sort (Map.keys byName)) deps) (fun group =>
    let u := newUnifier ()
    let members := filterMap (fun name => Map.lookup name byName) group
    let vars := Map.fromList (List.map (fun p => ("@" ++ p.name, freshType u)) members)
    -- A member with a signature is used at its signature inside the group (polymorphic
    -- recursion, as in Haskell); only unannotated members are monomorphic while inferred.
    let signed := filterMap
      (fun p => Option.map (fun sig => ("@" ++ p.name, sig)) (metaField (metaOf ("@" ++ p.name)) "sig"))
      members
    let groupSchemes := Ref.new (foldl (fun m pair => Map.insert (fst pair) (snd pair) m) (Ref.get schemes) signed)
    let unsigned := Map.filter (fun key _ => not (isSome (List.lookup key signed))) vars
    let env := TypeEnv.mk objectOf metaOf (Ref.new unsigned) groupSchemes prims
    forEach members (fun p =>
      let key := "@" ++ p.name
      catch (fun _ =>
        let core :=
          match p.checked with
          | Sexp.list (Sexp.sym "theorem" :: _ :: prop :: _) => prop
          | c => c
        let t := getOr (Map.lookup key vars) (freshType u)
        match metaField (metaOf key) "sig" with
        | Option.some (Sexp.list (Sexp.sym "teff" :: Sexp.list (Sexp.sym "eff" :: effs) :: result :: [])) =>
            -- A definition with no binders: its row bounds the body itself (D95).
            let sigVars := Ref.new Map.empty
            let sigRows := Ref.new Map.empty
            let declared := signatureType u result sigVars sigRows
            Types.unify u t declared
            #341a53a343 u env core declared [] (signatureRow u effs sigVars sigRows)
            checkRigid u sigVars sigRows
        | Option.some sig =>
            -- Checked against its signature, so parameters have their declared types and rows.
            let sigVars := Ref.new Map.empty
            let sigRows := Ref.new Map.empty
            let declared := signatureType u sig sigVars sigRows
            Types.unify u t declared
            #341a53a343 u env core declared [] (freshRow u)
            checkRigid u sigVars sigRows
        | Option.none =>
            Types.unify u t (#341a53a343 u env core [] (freshRow u))
            if p.wrap == "test" then Types.unify u t Types.bool else ()) (fun e => if warnOnly then Ref.set warnings ((p.name ++ ": " ++ e) :: Ref.get warnings) else Throw.throw (p.name ++ ": " ++ e)))
    forEach members (fun p =>
      let key := "@" ++ p.name
      match Map.lookup key vars with
      | Option.some t => Ref.set schemes (Map.insert key (scheme u t) (Ref.get schemes))
      | Option.none => ()))
  Ref.get schemes

--
-- Commands: replication.
--
/-- Runs `body` against the remote `name`: a directory, or `r2://<bucket>/<prefix>` (an
  S3-compatible bucket at `$DEUS_R2_ENDPOINT`, with `$R2_ACCESS_KEY_ID` and `$R2_SECRET_ACCESS_KEY`). -/
def Unnamed.h2fee9e6b7d (dir : Text) (name : Text) (body : Unit -> {Remote, IO, Throw Text} a) : {IO, Throw Text} a :=
  let url :=
    match IO.readFile (dir ++ "/remotes/" ++ name ++ "/url") with
    | Option.some text => trim text
    | Option.none => Throw.throw ("no remote " ++ name ++ "; run `deus remote add " ++ name ++ " <dir|r2://bucket/prefix>`")
  if startsWith "r2://" url then
    let path := Text.drop 5 url
    let slash := indexOf path "/" 0
    let bucketName := if slash < 0 then path else Text.take slash path
    let prefix := if slash < 0 then "deus" else Text.drop (slash + 1) path
    let need := fun key =>
      match IO.getEnv key with
      | Option.some value => value
      | Option.none => Throw.throw ("$" ++ key ++ " is not set")
    let endpoint := need "DEUS_R2_ENDPOINT"
    let user := need "R2_ACCESS_KEY_ID" ++ ":" ++ need "R2_SECRET_ACCESS_KEY"
    -- The file is made private before the secret is written to it.
    let config := dir ++ "/cache/remote-" ++ name ++ ".curl"
    IO.mkdirp (dir ++ "/cache")
    IO.exec "install" ["-m", "600", "/dev/null", config]
    IO.writeFile config ("user = \"" ++ user ++ "\"\n")
    let result := try (fun _ => bucket endpoint bucketName prefix config body)
    IO.remove config
    match result with
    | Result.ok value => value
    | Result.err message => Throw.throw message
  else directory url body

/-- `deus event …`: event types, recording, listing, counts and the push-only sync. -/
def Unnamed.h3f84493ccc (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let ns := Codebase.current dir
  let project := projectOf dir
  let ts := Analytics.types dir ns
  match args.positional with
  | "types" :: [] =>
      let rows := counts dir ts
      Cli.output args (fun _ => Json.arr (List.map (fun e =>
        match e with
        | (t, pending, pushed) => Json.obj [("name", Json.str t.typeName), ("hash", Json.str t.typeHash), ("columns", columnsJson t.columns), ("count", Json.num (pending + pushed)), ("pending", Json.num pending)]) rows)) (fun _ => if List.isEmpty rows then "No event types; mark a structure with @[event]." else join "\n" (List.map typeLine rows))
  | "record" :: typeName :: pairs =>
      let t := Analytics.find dir ns typeName
      let values := List.map (fun pair =>
        let eq := indexOf pair "=" 0
        if eq < 0 then Throw.throw ("expected field=value, not " ++ pair) else
          let key := Text.take eq pair
          match List.find (fun c => c.columnName == key) t.columns with
          | Option.some c => (key, parseCell project ns c (Text.drop (eq + 1) pair))
          | Option.none => Throw.throw ("event " ++ t.typeName ++ " has no field " ++ key)) pairs
      let id := Analytics.record dir t (getOr (option args "by") (recorder ())) values
      Cli.output
        args
        (fun _ => Json.obj [("event", Json.str id), ("type", Json.str t.typeName)])
        (fun _ => "Recorded " ++ t.typeName ++ " " ++ id ++ ".")
  | "import" :: path :: [] =>
      let n := importFile dir project ns ts path
      Cli.output
        args
        (fun _ => Json.obj [("imported", Json.num n)])
        (fun _ => "Recorded " ++ toText n ++ " events.")
  | "backfill" :: source :: path :: [] =>
      let n := if source == "history" then backfillHistory dir (Analytics.find dir ns "AgentChange") path else if source == "timeline" then backfillTimeline dir (Analytics.find dir ns "AgentStage") path else Throw.throw Analytics.usage
      Cli.output
        args
        (fun _ => Json.obj [("recorded", Json.num n)])
        (fun _ => "Recorded " ++ toText n ++ " events from " ++ path ++ ".")
  | "list" :: rest =>
      let selected :=
        match rest with
        | name :: [] => [Analytics.find dir ns name]
        | _ => ts
      let limit := getOr (Option.bind (option args "limit") fromText) 20
      let about := Option.map (fun name =>
        match Map.lookup name ns with
        | Option.some e => Entry.hash e
        | Option.none => Throw.throw ("unknown name " ++ name)) (option args "about")
      let mentions := fun t r =>
        match about with
        | Option.none => true
        | Option.some h => any (fun pair => if (fst pair).columnType == "ref" then
            match snd pair with
            | Cell.text ref => refHash project ns ref == h
            | _ => false
          else false) (zip t.columns r.cells)
      let picked := List.map (fun t =>
        match Analytics.rows dir t with
        | (pending, pushed) => (t, List.take limit (List.filter (mentions t) (reverse (pushed ++ pending))))) selected
      Cli.output
        args
        (fun _ => Json.arr (concatMap (fun pair => List.map (rowJson (fst pair)) (snd pair)) picked))
        (fun _ => join "\n" (concatMap
          (fun pair => if List.isEmpty (snd pair) then [] else ("-- " ++ (fst pair).typeName) :: List.map (rowLine (fst pair)) (snd pair))
          picked))
  | "stats" :: [] =>
      let limit := getOr (Option.bind (option args "limit") fromText) 20
      let site := if Cli.flag args "json" then siteJson dir project ns limit else Json.null
      Cli.output args (fun _ => site) (fun _ =>
        let byHash := sortBy
          (fun a b => sum (List.map tallyCount (snd b)) - sum (List.map tallyCount (snd a)))
          (Map.toList (byDefinition dir project ns ts))
        let index := nameIndex ns
        join "\n" (List.map typeLine (counts dir ts) ++
          ["", toText (List.length byHash) ++ " definitions have events"] ++ List.map
          (fun pair => "  " ++ getOr (Map.lookup (fst pair) index) ("#" ++ Text.take 10 (fst pair)) ++ "  " ++
            toText (sum (List.map tallyCount (snd pair))))
          (List.take limit byHash)))
  | "push" :: rest =>
      let name := getOr (head? rest) "origin"
      let pushed := h2fee9e6b7d dir name (fun _ => Analytics.push dir ts)
      Cli.output args (fun _ => Json.arr (List.map (fun p =>
        match p with
        | (typeName, n, key) => Json.obj [("type", Json.str typeName), ("rows", Json.num n), ("key", Json.str key)]) pushed)) (fun _ => if List.isEmpty pushed then "Nothing to push." else join "\n" (List.map (fun p =>
        match p with
        | (typeName, n, key) => "  " ++ typeName ++ "  " ++ toText n ++ " rows  " ++ key) pushed))
  | _ => Throw.throw Analytics.usage

/-- Compiles parsed files against a base namespace. Batch names shadow base names. -/
def Unnamed.hbe595dabb3 (base : Map Text Entry) (store : Text -> {Throw Text | r} Option Sexp) (storeMeta : Text -> {Throw Text | r} Option Sexp) (typeMode : Text) (files : List (Text, List Decl)) : {Throw Text | r} Batch :=
  let items := Compile.collect files
  -- Duplicate names within the batch are an error; shadowing the base is an update.
  let seen := Ref.new Map.empty
  let claim := fun fqn => if Map.contains fqn (Ref.get seen) then Throw.throw ("duplicate definition " ++ fqn) else Ref.set seen (Map.insert fqn () (Ref.get seen))
  -- Pass 1: provisional type entries so field types can resolve names to IRIs.
  let provisional := foldl (fun table item =>
    match item.decl with
    | Decl.data _ _ iri _ _ _ _ => Map.insert item.fqn (Entry.type "" (iriFor item.fqn iri) []) table
    | Decl.record _ _ iri fields _ _ _ => Map.insert item.fqn (Entry.type "" (iriFor item.fqn iri) (List.map fst fields)) table
    | Decl.effect _ _ iri _ _ _ _ => Map.insert item.fqn (Entry.ability "" (iriFor item.fqn iri)) table
    | _ => table) base items
  let typeNames := Names.build provisional
  let typeObjects := Ref.new []
  let metas := Ref.new []
  let pending := Ref.new []
  let addMetaWith := fun h doc sig locals attrs extra =>
    match (doc, sig, locals, attrs, extra) with
    | (Option.none, Option.none, [], [], []) => ()
    | _ => Ref.set metas ((h, metaForm doc sig locals attrs extra) :: Ref.get metas)
  let addMeta := fun h doc sig locals extra => addMetaWith h doc sig locals [] extra
  -- A type's parameter and constructor field names are the author's, kept out of its hash for `view`.
  let addTypeMeta := fun h doc params fieldNames attrs lead =>
    let docPart :=
      match doc with
      | Option.some d => [Compile.node "doc" [Sexp.s d]]
      | Option.none => []
    let paramsPart := if List.isEmpty params then [] else [Compile.node "params" (List.map Sexp.s params)]
    let fieldsPart := if List.all (fun names => List.all Text.isEmpty names) fieldNames then [] else [Compile.node
      "fields"
      (List.map (fun names => Compile.node "c" (List.map Sexp.s names)) fieldNames)]
    let attrsPart := if List.isEmpty attrs then [] else [Compile.node
      "attrs"
      (List.map (fun a => Sexp.list (Sexp.s a.attr :: List.map Sexp.s a.values)) attrs)]
    match docPart ++ paramsPart ++ fieldsPart ++ attrsPart ++ commentMeta lead [] [] with
    | [] => ()
    | parts => Ref.set metas ((h, Compile.node "meta" parts) :: Ref.get metas)
  let entries := concatMap (fun item =>
    let fqn := item.fqn
    match item.decl with
    | Decl.data _ params iri ctors doc attributes _ =>
        claim fqn
        let i := iriFor fqn iri
        let form := typeForm typeNames item i params (List.map (fun c => List.map snd (snd c)) ctors)
        let h := hashFor i form
        Ref.set typeObjects ((h, form) :: Ref.get typeObjects)
        addTypeMeta
          h
          doc
          params
          (List.map (fun c => List.map fst (snd c)) ctors)
          attributes
          item.lead
        (fqn, Entry.type h i []) :: mapIndexed (fun tag ctor =>
          match ctor with
          | (name, fields) =>
              claim (fqn ++ "." ++ name)
              (fqn ++ "." ++ name, Entry.ctor h tag (List.length fields))) ctors
    | Decl.record _ params iri fields doc attributes _ =>
        claim fqn
        let i := iriFor fqn iri
        let form := typeForm typeNames item i params [List.map snd fields]
        let h := hashFor i form
        Ref.set typeObjects ((h, form) :: Ref.get typeObjects)
        addTypeMeta h doc params [] attributes item.lead
        let count := List.length fields
        claim (fqn ++ ".mk")
        let accessors := mapIndexed (fun index field =>
          let name := fqn ++ "." ++ fst field
          claim name
          Ref.set
            pending
            (Pending.mk name "term" (accessorCore h count index) (accessorCore h count index) :: Ref.get pending)
          (name, Entry.term ("@" ++ name))) fields
        (fqn, Entry.type h i (List.map fst fields)) :: (fqn ++ ".mk", Entry.ctor h 0 count) :: accessors
    | Decl.effect _ params iri ops doc attributes _ =>
        claim fqn
        let i := iriFor fqn iri
        let scope := bodyScope item
        let form := Compile.node "ability" ([Sexp.s i, Sexp.i (List.length params)] ++ List.map
          (fun op => Compile.node "op" [Sexp.i (arrowCount (snd op)), tyCore typeNames scope params (snd op)])
          ops)
        let h := hashFor i form
        Ref.set typeObjects ((h, form) :: Ref.get typeObjects)
        addTypeMeta h doc params [] attributes item.lead
        (fqn, Entry.ability h i) :: mapIndexed (fun index op =>
          match op with
          | (name, type) =>
              let arity := arrowCount type
              if arity == 0 then Throw.throw (item.path ++ ": ability operation " ++ fqn ++ "." ++ name ++
                " needs an argument (use Unit)") else
                claim (fqn ++ "." ++ name)
                (fqn ++ "." ++ name, Entry.op h index arity)) ops
    | Decl.defn _ _ _ _ _ _ _ _ =>
        claim fqn
        [(fqn, Entry.term ("@" ++ fqn))]
    | Decl.check _ _ _ _ _ =>
        claim fqn
        [(fqn, Entry.test ("@" ++ fqn))]
    | Decl.thm _ _ _ _ _ _ _ =>
        claim fqn
        [(fqn, Entry.theorem ("@" ++ fqn))]
    | _ => []) items
  let table := foldl (fun t pair => Map.insert (fst pair) (snd pair) t) base entries
  let names := Names.build table
  -- Pass 2: bodies to Core with placeholders.
  forEach items (fun item =>
    let ctx := Ctx.mk names (bodyScope item) (item.path ++ ": " ++ item.fqn)
    let fqn := item.fqn
    match item.decl with
    | Decl.defn _ binders type body arms doc attributes pos =>
        let params := List.map (fun b => Pat.id b.binder [] pos) binders
        let sig := Compile.signature names (bodyScope item) binders type
        let named := lambda ctx params (fun locals =>
          match (body, arms) with
          | (Option.some e, _) => Resolve.expr ctx e locals
          | (_, Option.some list) => equations ctx list locals
          | _ => stub fqn sig) []
        match stripNoted named with
        | (core, locals, notes, spellings, checked) =>
            Ref.set pending (Pending.mk fqn "term" core checked :: Ref.get pending)
            addMetaWith
              ("@" ++ fqn)
              doc
              (Option.some sig)
              locals
              attributes
              (commentMeta item.lead notes spellings)
    | Decl.check _ body doc attributes _ =>
        match stripNoted (Resolve.expr ctx body []) with
        | (core, locals, notes, spellings, checked) =>
            Ref.set pending (Pending.mk fqn "test" core checked :: Ref.get pending)
            addMetaWith
              ("@" ++ fqn)
              doc
              Option.none
              locals
              attributes
              (commentMeta item.lead notes spellings)
    | Decl.thm _ binders prop proof doc _ pos =>
        let params := List.map (fun b => Pat.id b.binder [] pos) binders
        let types := List.map (fun b =>
          match b.annot with
          | Option.some t => tyCore names (bodyScope item) [] t
          | Option.none => Compile.node "tvar" [Sexp.s "?"]) binders
        match strip (lambda ctx params (fun locals => Resolve.expr ctx prop locals) []) with
        | (core, locals) =>
            let form := Compile.node
              "theorem"
              [Sexp.list (Sexp.sym "binders" :: types), core, Compile.node "proof" (proofTokens names (bodyScope item) proof)]
            Ref.set pending (Pending.mk fqn "theorem" form form :: Ref.get pending)
            addMeta ("@" ++ fqn) doc Option.none locals (commentMeta item.lead [] [])
    | _ => ())
  -- Pass 2½: infer types, group by group, and check signatures; schemes join the metadata.
  let typeObjectMap := Map.fromList (Ref.get typeObjects)
  let metaMap := Map.fromList (Ref.get metas)
  let objectOf := fun h => orElse (Map.lookup h typeObjectMap) (fun _ => store h)
  let metaOf := fun h => if startsWith "@" h then Map.lookup h metaMap else storeMeta h
  let prims := primTypes (Ref.get pending) metaMap base storeMeta
  let warnings := Ref.new []
  let schemes := if typeMode == "off" then Map.empty else h073a4d6c1d objectOf metaOf prims (Ref.get pending) (typeMode == "warn") warnings
  Ref.set metas (List.map (fun pair =>
    match Map.lookup (fst pair) schemes with
    | Option.some scheme => (fst pair, Sexp.list (Sexp.asList (snd pair) ++ [Compile.node "scheme" [scheme]]))
    | Option.none => pair) (Ref.get metas) ++ filterMap
    (fun pair => if Map.contains (fst pair) metaMap then Option.none else Option.some (fst pair, Compile.node "meta" [Compile.node "scheme" [snd pair]]))
    (Map.toList schemes))
  -- Pass 3: hash terms, then rewrite placeholder entries and metadata keys.
  let baseHashes := Map.empty
  match hashTerms (Ref.get pending) baseHashes with
  | (hashes, termObjects) =>
      let resolveHash := fun h => if startsWith "@" h then getOr (Map.lookup (Text.drop 1 h) hashes) h else h
      let finalEntries := List.map (fun pair =>
        match pair with
        | (name, Entry.term h) => (name, Entry.term (resolveHash h))
        | (name, Entry.test h) => (name, Entry.test (resolveHash h))
        | (name, Entry.theorem h) => (name, Entry.theorem (resolveHash h))
        | other => other) entries
      let finalMetas := List.map (fun pair => (resolveHash (fst pair), snd pair)) (Ref.get metas)
      Batch.mk
        (reverse (Ref.get typeObjects) ++ termObjects)
        finalEntries
        finalMetas
        (reverse (Ref.get warnings))
