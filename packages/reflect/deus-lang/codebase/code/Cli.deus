/-
  The `deus` command line. Every command is DEUS code; the kernel only runs the seed.

  People and agents use the same commands. `--json` switches output to one JSON document per
  command, so an agent can read definitions and write patches without scraping text.
-/
/-- Command-line arguments split into positionals and `--flag value` / `--flag` options. -/
structure Cli.Args where
  positional : List Text
  options : Map Text Text

/-- A loaded expression: its hash, its type, and the data types its value may hold, for `quoteAt`. -/
structure Cli.Compiled where
  compiledHash : Text
  compiledType : Sexp
  compiledTypes : Map Text (Text, Sexp)

/-- What every block of a `deus mdl` run reads from the namespace, built once: each lookup walked the
  whole namespace, once per name an api block named. -/
structure Cli.MdlFacts where
  printer : Printer
  fullTypes : Map Text Text
  documents : List Text

/-- One block's outcome: `ok`, `fail` with its problems, `gap` when every problem is a known gap, or `unchecked` when no extension is found. -/
structure Cli.Outcome where
  place : Text
  verdict : Text
  problems : List Text

/-- `add`: new names only; `update`: may replace names, then propagates to dependents. -/
def Cli.addOrUpdate (args : Args) (isUpdate : Bool) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let ns := Codebase.current dir
  let batch := catch (fun _ => batch
    ns
    (fun h => readObject dir h)
    (fun h => readMeta dir h)
    (checkTypes ())
    (parseFiles args.positional)) (fun e => Throw.throw (nameCallee ns e))
  Cli.warn batch
  let entries := batch.entries ++ specEntries dir args.positional
  let replaced := changes ns entries
  let crossings := layerCrossings dir batch
  let trespasses :=
    match Project.read dir with
    | Option.some p => trespasses p entries
    | Option.none => []
  if not (List.isEmpty crossings) then Throw.throw ("a layer may not depend on these:\n  " ++ join "\n  " crossings) else if not (List.isEmpty trespasses) then Throw.throw ("only a library may mint types under its IRI:\n  " ++ join "\n  " trespasses) else if not isUpdate && not (List.isEmpty replaced) then Throw.throw ("these names already exist; use `deus update`:\n  " ++ join "\n  " (List.map (fun c =>
    match c with
    | (name, _, _) => name) replaced)) else
    let retagged := metadataChanged ns batch.entries (fun h => readMeta dir h) (Map.fromList (Batch.metas batch))
    Codebase.store dir batch
    let added := List.filter (fun pair => not (Map.contains (fst pair) ns)) entries
    -- A dropped field, constructor or operation would keep a name that no source declares (R-18).
    let orphaned := Update.orphans ns entries
    let ns2 := foldl
      (fun m name => Map.remove name m)
      (foldl (fun m pair => Map.insert (fst pair) (snd pair) m) ns entries)
      orphaned
    let subst := Map.fromList (List.map (fun c =>
      match c with
      | (_, old, new) => (Entry.hash old, Entry.hash new)) replaced)
    let propagated := catch (fun _ => propagate
      dir
      ns2
      subst
      (Set.fromList (List.map (fun pair => Entry.hash (snd pair)) batch.entries))
      (checkTypes ())) (fun e => Throw.throw (join "\n" (List.map (nameCallee ns2) (Text.split e "\n"))))
    let ns3 := fst propagated
    let message := getOr
      (option args "message")
      ((if isUpdate then "update " else "add ") ++ join " " args.positional)
    let causal := commit dir ns3 message
    recordProvenance dir args causal (List.map fst batch.objects ++ List.map
      (fun pair => Entry.hash (snd pair))
      (List.filter (fun pair => Entry.kind (snd pair) == "spec") entries))
    match option args "by" with
    | Option.some agent => recordWrites
        dir
        ns3
        agent
        (if isUpdate then "update" else "add")
        (List.map fst added ++ List.map (fun c =>
          match c with
          | (name, _, _) => name) replaced)
    | Option.none => ()
    match option args "closes" with
    | Option.some id =>
        let t := Tasks.find (Tasks.current dir) id
        recordProvenance dir args (save
          dir
          [link (setField t "state" "done") (Attachment.change causal)]
          ("close " ++ t.id ++ " by " ++ short causal)) []
    | Option.none => ()
    if Cli.flag args "quiet" then () else Cli.output
      args
      (fun _ => Json.obj [("added", Json.arr (List.map (fun p => entryJson (fst p) (snd p)) added)), ("updated", Json.arr (List.map (fun c =>
        match c with
        | (name, _, new) => entryJson name new) replaced)), ("metadata", Json.arr (List.map Json.str retagged)), ("removed", Json.arr (List.map Json.str orphaned)), ("propagated", Json.arr (List.map Json.str (snd propagated))), ("causal", Json.str causal)])
      (fun _ =>
        let addedLines := List.map (fun p => "  + " ++ fst p ++ "  " ++ short (Entry.hash (snd p))) added
        let updatedLines := List.map (fun c =>
          match c with
          | (name, old, new) => "  ~ " ++ name ++ "  " ++ short (Entry.hash old) ++ " -> " ++ short (Entry.hash new)) replaced
        let propagatedLines := List.map (fun name => "  ^ " ++ name ++ " (dependent, rehashed)") (snd propagated)
        let metadataLines := List.map (fun name => "  * " ++ name ++ " (metadata)") retagged
        let removedLines := List.map (fun name => "  - " ++ name ++ " (no longer declared)") orphaned
        let lines := addedLines ++ updatedLines ++ removedLines ++ metadataLines ++ propagatedLines
        if List.isEmpty lines then "Nothing changed." else join "\n" lines)

/-- Keeps a text file in the asset store under the SHA-256 of its text; the kernel hashes text, so no host tool runs. -/
def Cli.addText (dir : Text) (file : Text) : {IO, Throw Text} Text :=
  match IO.readFile file with
  | Option.none => Throw.throw ("no file " ++ file)
  | Option.some text =>
      let sha := Text.sha256 text
      if Assets.has dir sha then () else
        IO.mkdirp (dir ++ "/assets")
        IO.writeFile (Assets.path dir sha) text
      sha

/-- The options of `task new` / `task set` that name task fields, applied in order; a `--parent` must name another task (Tasks.Spec R-8). -/
def Cli.applyFields (args : Args) (tasks : Map Text Task) (t : Task) : {Throw Text} Task :=
  let set := foldl (fun acc field =>
    match option args field with
    | Option.some value => setField acc field value
    | Option.none => acc) t Tasks.fields
  if isSome (option args "parent") then resolveParent tasks set else set

/-- `deus artifact <name> [--out file]`: evaluates an `@[artifact]` constant once and keeps its value
  under its hash (task 88004c30); `--out` writes a Text value's characters to a file. -/
def Cli.artifact (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let ns := Codebase.current dir
  let name := getOr (head? args.positional) ""
  match Cli.lookupName ns name with
  | (_, Entry.term h) =>
      if not (isArtifact dir h) then Throw.throw (name ++ " is not marked @[artifact]") else ()
      let fresh := isNone (cachedValue dir h)
      if fresh then evaluateArtifact dir h name else h
      match (option args "out", cachedValue dir h) with
      | (Option.some out, Option.some (Sexp.list (Sexp.sym "text" :: Sexp.str value :: []))) => IO.writeFile out value
      | (Option.some _, _) => Throw.throw (name ++ " is not a Text value, so --out cannot write it")
      | _ => ()
      if Cli.flag args "quiet" then () else Cli.output
        args
        (fun _ => Json.obj [("name", Json.str name), ("hash", Json.str h), ("evaluated", Json.bool fresh)])
        (fun _ => (if fresh then "Evaluated and kept " else "Already kept ") ++ name ++ " " ++ short h ++ ".")
  | _ => Throw.throw "usage: deus artifact <constant> [--out file]"

def Cli.artifactPath (dir : Text) (h : Text) : Text := dir ++ "/artifacts/value-" ++ h

/-- `deus asset add <file>` (D82): stores a file in the asset store by its SHA-256. -/
def Cli.asset (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  match args.positional with
  | "add" :: file :: [] =>
      let a := Assets.add dir file
      Cli.output
        args
        (fun _ => assetJson a)
        (fun _ => a.hash ++ "  " ++ a.mediaType ++ "  " ++ a.fileName)
  | _ => Throw.throw "usage: deus asset add <file>"

/-- An asset's bytes; the kernel reads files only as text, so `od` lists them. -/
def Cli.assetBytes (dir : Text) (sha : Text) : {IO, Throw Text} List Int :=
  match IO.exec "od" ["-An", "-v", "-tu1", Assets.path dir sha] with
  | (0, out, _) => filterMap fromText (Text.split (replace "\n" " " out) " ")
  | (_, _, err) => Throw.throw ("cannot read the embedded file " ++ sha ++ ": " ++ trim err)

def Cli.assetJson (a : Asset) : Json := Json.obj [("hash", Json.str a.hash), ("type", Json.str a.mediaType), ("name", Json.str a.fileName)]

--
-- Commands: tasks (D59).
--
def Cli.attachmentJson (a : Attachment) : Json :=
  match a with
  | Attachment.definition name h => Json.obj [("definition", Json.str name), ("hash", Json.str h)]
  | Attachment.change h => Json.obj [("change", Json.str h)]

/-- `--attach <file>` copied into the asset store (D82); none without the option. -/
def Cli.attachments (dir : Text) (args : Args) : {IO, Throw Text} List Asset :=
  match option args "attach" with
  | Option.some file => [Assets.add dir file]
  | Option.none => []

/-- The last path segment without its extension. -/
def Cli.baseName (path : Text) : Text :=
  let file := getOr (last? (Text.split path "/")) path
  let dot := indexOf file "." 0
  if dot > 0 then Text.take dot file else file

/-- `deus bindings <prefix|name…> -o <dir> [--name stem]` (D81, D87): a JavaScript module and its
  declarations for the functions under the prefixes, `<dir>/<stem>.js` and `<dir>/<stem>.d.ts`,
  with the runtime and the wasm kernel it loads. -/
def Cli.bindings (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  match (args.positional, option args "out") with
  | (first :: _, Option.some out) =>
      let stem := getOr (option args "name") (toLower (lastSegment first))
      let command := "deus bindings " ++ join " " args.positional
      match Bindings.generate dir args.positional command with
      | (js, dts, exported, skipped) =>
          let path := out ++ "/" ++ stem ++ ".js"
          let types := out ++ "/" ++ stem ++ ".d.ts"
          let copied := try (fun _ =>
            let home := require "DEUS_HOME"
            IO.mkdirp out
            IO.writeFile path js
            IO.writeFile types dts
            Build.tool
              "cp"
              [home ++ "/src/bindings/deus-runtime.js", home ++ "/src/bindings/deus-runtime.d.ts", out ++ "/"]
            Build.tool "cp" [wasmKernel (), out ++ "/deus_kernel.wasm"]
            ())
          match copied with
          | Result.err f => Throw.throw (Failure.render f)
          | Result.ok _ =>
              forEach
                skipped
                (fun s => eprintln ("warning: not exported: " ++ fst s ++ ": " ++ snd s))
              Cli.output
                args
                (fun _ => Json.obj [("module", Json.str path), ("types", Json.str types), ("exported", Json.arr (List.map Json.str exported)), ("skipped", Json.arr (List.map
                  (fun s => Json.obj [("name", Json.str (fst s)), ("reason", Json.str (snd s))])
                  skipped))])
                (fun _ => "Wrote " ++ path ++ " and " ++ types ++ " with " ++ toText (List.length exported) ++
                  " functions.")
  | _ => Throw.throw "usage: deus bindings <prefix|name…> -o <dir> [--name stem]"

/-- Options that never take a value. -/
def Cli.booleanFlags : Map Text Unit := Set.fromList ["json", "core", "all", "force", "empty", "help", "integration", "wasm", "c", "native", "worker", "server", "browser", "console", "coverage", "quiet", "bytes"]

--
-- Commands: branches and history.
--
def Cli.branch (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  match args.positional with
  | [] =>
      let current := currentBranch dir
      let all := branches dir
      Cli.output
        args
        (fun _ => Json.obj [("current", Json.str current), ("branches", Json.arr (List.map Json.str all))])
        (fun _ => join "\n" (List.map (fun b => (if b == current then "* " else "  ") ++ b) all))
  | name :: [] => if not (validBranch name) then Throw.throw ("invalid branch name " ++ name) else if isSome (branchHead dir name) then Throw.throw ("branch " ++ name ++ " exists") else
      setBranch dir name (headOf dir (currentBranch dir))
      IO.writeFile (dir ++ "/HEAD") (name ++ "\n")
      Cli.output
        args
        (fun _ => Json.obj [("branch", Json.str name)])
        (fun _ => "Created and switched to branch " ++ name ++ ".")
  | _ => Throw.throw "usage: deus branch [name]"

/-- `deus build <term> -o <file> [--native]`: a standalone executable that runs `term ()`. -/
def Cli.build (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let ns := Codebase.current dir
  if Cli.flag args "js" then
    match option args "out" with
    | Option.some out =>
        let roots := List.map (fun name =>
          match Cli.lookupName ns name with
          | (_, Entry.term h) => (mangle (lastSegment name), h)
          | _ => Throw.throw (name ++ " is not a term")) args.positional
        if List.isEmpty roots then Throw.throw "usage: deus build <name…> -o <file.js> --js" else ()
        writeJs dir ns (fun h => readObject dir h) (fun h => readMeta dir h) roots out
        Cli.output
          args
          (fun _ => Json.obj [("module", Json.str out), ("map", Json.str (out ++ ".map"))])
          (fun _ => "Built " ++ out ++ ".")
    | Option.none => Throw.throw "usage: deus build <name…> -o <file.js> --js"
  else buildImage args dir ns

/-- `deus build` for every target that runs an image or compiles one definition. -/
def Cli.buildImage (args : Args) (dir : Text) (ns : Map Text Entry) : {IO, Throw Text} Unit :=
  match (Cli.lookupName ns (getOr (head? args.positional) ""), option args "out") with
  | ((_, Entry.term h), Option.some out) =>
      ensureArtifacts dir [h]
      let image := Image.build (fetcher dir) h
      let target := fun u => if Cli.flag args "wasm" then
        -- A signature names a type by IRI; the back end reads the type's object to compare its values (D100).
        let byIri := Map.fromList (filterMap (fun pair =>
          match snd pair with
          | Entry.type th iri _ => Option.some (iri, th)
          | _ => Option.none) (Map.toList ns))
        let fetch := fun x => orElse (readObject dir x) (fun _ => Option.bind (Map.lookup x byIri) (readObject dir))
        match try (fun _ => Wasm.compile
          fetch
          (fun x => readMeta dir x)
          h
          (lastSegment (getOr (head? args.positional) "main"))) with
        | Result.ok bytes => IO.writeBytes out bytes
        | Result.err message => Throw.throw (Failure.of message [])
      else if Cli.flag args "c" then
        match try (fun _ => CGen.compile
          (fun x => readObject dir x)
          (fun x => readMeta dir x)
          h
          (lastSegment (getOr (head? args.positional) "main"))) with
        | Result.ok source => cExecutable source out
        | Result.err message => Throw.throw (Failure.of message [])
      else if Cli.flag args "worker" then worker image (replace "." "-" (toLower (getOr (head? args.positional) "actor"))) out else if Cli.flag args "browser" then browser image out else if Cli.flag args "server" then server image out else if Cli.flag args "native" then native image out else executable image out (dir ++ "/artifacts")
      match try target with
      | Result.ok _ => Cli.output
          args
          (fun _ => Json.obj [("binary", Json.str out)])
          (fun _ => "Built " ++ out ++ ".")
      | Result.err f => Throw.throw (Failure.render f)
  | _ => Throw.throw "usage: deus build <term> -o <file>"

/-- The value kept for the `@[artifact]` constant `h`, as Core; `none` until it is evaluated (Artifact.Spec). -/
def Cli.cachedValue (dir : Text) (h : Text) : {IO} Option Sexp := Option.map Sexp.read (IO.readFile (artifactPath dir h))

def Cli.changeJson (dir : Text) (pair : (Text, Causal)) : {IO} Json := Json.obj ([("causal", Json.str (fst pair)), ("message", Json.str (snd pair).message)] ++
  getOr (Option.map (fun agent => [("by", Json.str agent)]) (producedBy dir (fst pair))) [])

def Cli.changeLine (dir : Text) (pair : (Text, Causal)) : {IO} Text := "  " ++ short (fst pair) ++ "  " ++ (snd pair).message ++
  getOr (Option.map (fun agent => "  (" ++ agent ++ ")") (producedBy dir (fst pair))) ""

/-- Names a batch would change: (name, old, new) for every name already bound to something else. -/
def Cli.changes (ns : Map Text Entry) (entries : List (Text, Entry)) : List (Text, (Entry, Entry)) := filterMap (fun pair =>
  match pair with
  | (name, e) =>
      match Map.lookup name ns with
      | Option.some old => if old == e then Option.none else Option.some (name, old, e)
      | Option.none => Option.none) entries

/-- Runs one block through the extension `uri` names in the codebase; unchecked when there is none. -/
def Cli.checkBlock (dir : Text) (ns : Map Text Entry) (facts : MdlFacts) (byUri : Map Text Text) (place : Text) (uri : Option Text) (b : Block) : {IO, Throw Text} Outcome :=
  match Option.bind uri (fun u => Map.lookup u byUri) with
  | Option.none => Outcome.mk place "unchecked" []
  | Option.some h =>
      Image.load (fetcher dir) [h]
      let check := Code.run h
      match withHost dir ns facts (fun _ => guardDefect (fun _ => check b)) with
      | Result.ok [] => Outcome.mk place "ok" []
      | Result.ok problems =>
          -- A known gap (each problem starting `gap: `) is reported but does not fail the document.
          Outcome.mk
            place
            (if List.all (fun p => startsWith "gap: " p) problems then "gap" else "fail")
            problems
      | Result.err message => Outcome.mk place "fail" ["defect: " ++ message]

/-- Checks one document: the core rules, then each block through its extension. -/
def Cli.checkDoc (dir : Text) (ns : Map Text Entry) (facts : MdlFacts) (byUri : Map Text Text) (path : Text) : {IO, Throw Text} List Outcome :=
  let doc := Mdl.parse (readSource path)
  let core := validate doc
  let declared := Mdl.declared doc
  let outcomes := List.map (fun b => checkBlock
    dir
    ns
    facts
    byUri
    (path ++ ":" ++ toText b.lineNo ++ " " ++ Mdl.describe b)
    (List.lookup b.blockType declared)
    b) (List.filter (fun b => b.blockType != "ext") doc.blocks)
  if List.isEmpty core then outcomes else Outcome.mk path "fail" core :: outcomes

def Cli.checkMdl (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let ns := Codebase.current dir
  let byUri := extensions dir ns
  let facts := mdlFacts ns
  let documents := List.filter (fun a => List.contains a facts.documents && not (IO.exists a)) args.positional
  let files := List.filter (fun a => not (List.contains a documents)) args.positional
  let paths := List.filter (fun p => endsWith ".mdl" p) (expandPaths files)
  let fromCodebase := if List.isEmpty args.positional || not (List.isEmpty documents) then checkSpecs dir ns facts byUri documents else []
  let outcomes := fromCodebase ++ concatMap (fun path => checkDoc dir ns facts byUri path) paths
  let count := fun v => List.length (List.filter (fun o => o.verdict == v) outcomes)
  Cli.output args (fun _ => Json.arr (List.map
    (fun o => Json.obj [("block", Json.str o.place), ("status", Json.str o.verdict), ("problems", Json.arr (List.map Json.str o.problems))])
    outcomes)) (fun _ => join "\n" (List.map (fun o => padRight 10 o.verdict ++ o.place ++
    Text.concat (List.map (fun p => "\n          " ++ p) o.problems)) outcomes ++ [toText (count "ok") ++ " ok, " ++ toText (count "fail") ++ " failed, " ++
    toText (count "unchecked") ++ " unchecked" ++ (if count "gap" > 0 then ", " ++ toText (count "gap") ++ " known gaps" else "")]))
  if count "fail" > 0 then IO.exit 1 else ()

/-- Checks the spec objects the codebase names: all of them, or those of the named documents in document order. -/
def Cli.checkSpecs (dir : Text) (ns : Map Text Entry) (facts : MdlFacts) (byUri : Map Text Text) (documents : List Text) : {IO, Throw Text} List Outcome :=
  let wanted := if List.isEmpty documents then facts.documents else documents
  let orderOf := fun h =>
    match metaField (readMeta dir h) "order" with
    | Option.some (Sexp.int k) => k
    | _ => 1000000
  let blocks := filterMap (fun pair =>
    match pair with
    | (name, Entry.spec h) => Option.some (documentOf name, name, h)
    | _ => Option.none) (Map.toList ns)
  concatMap (fun d =>
    let mine := filterMap (fun x =>
      match x with
      | (doc, name, h) => if doc == d then Option.some (orderOf h, name, h) else Option.none) blocks
    filterMap (fun x =>
      match x with
      | (_, name, h) => Option.map (fun form =>
          match Mdl.fromSexp form with
          | (uri, b) => checkBlock
              dir
              ns
              facts
              byUri
              name
              (if Text.isEmpty uri then Option.none else Option.some uri)
              b) (readObject dir h)) (sortBy (fun a b =>
      match (a, b) with
      | ((oa, na, _), ob, nb, _) => if oa == ob then compare na nb else compare oa ob) mine)) wanted

/-- `DEUS_TYPECHECK=0` skips type checking (only to bootstrap a change to the checker itself);
  `DEUS_TYPECHECK=warn` reports type errors as warnings. -/
def Cli.checkTypes (u : Unit) : {IO} Text :=
  match IO.getEnv "DEUS_TYPECHECK" with
  | Option.some "0" => "off"
  | Option.some "warn" => "warn"
  | _ => "strict"

/-- The codebase directory: `--codebase`, then `$DEUS_CODEBASE`, then one per user, `~/.deus`, as Unison keeps `~/.unison`. -/
def Cli.codebaseDir (args : Args) : {IO} Text :=
  match option args "codebase" with
  | Option.some dir => dir
  | Option.none =>
      match IO.getEnv "DEUS_CODEBASE" with
      | Option.some dir => dir
      | Option.none => getOr (IO.getEnv "HOME") "." ++ "/.deus"

/-- `deus comment <name|change:h> <text…>` (D82): a comment on a definition or a change, kept in the codebase. -/
def Cli.comment (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let author := getOr (option args "by") (getOr (IO.getEnv "USER") "someone")
  match args.positional with
  | given :: words =>
      let subject := subjectOf dir given
      let c := Comment.mk author (join " " words) (IO.wallClock ()) (attachments dir args)
      if Text.isEmpty c.note && List.isEmpty c.assets then Throw.throw "usage: deus comment <name|change:h> <text…> [--attach file]" else
        recordProvenance dir args (Comments.add dir [(subject, c)] ("comment on " ++ subject)) []
        Cli.output
          args
          (fun _ => Json.obj [("subject", Json.str subject), ("comment", commentJson c)])
          (fun _ => "Commented on " ++ subject ++ ".")
  | [] => Throw.throw "usage: deus comment <name|change:h> <text…> [--attach file]"

def Cli.commentJson (c : Comment) : Json := Json.obj [("author", Json.str c.author), ("note", Json.str c.note), ("at", Json.str c.written), ("assets", Json.arr (List.map assetJson c.assets))]

def Cli.commentLine (c : Comment) : Text := "  " ++ c.author ++ ": " ++ c.note ++
  Text.concat (List.map (fun a => " [" ++ a.fileName ++ " " ++ Text.take 10 a.hash ++ "]") c.assets)

/-- `deus comments [<name|change:h>]`: the comments on one subject, or on every subject that has some. -/
def Cli.comments (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  match args.positional with
  | "import" :: path :: [] =>
      let n := importComments dir path
      Cli.output
        args
        (fun _ => Json.obj [("imported", Json.num n)])
        (fun _ => "Imported " ++ toText n ++ " comments.")
  | _ =>
      let all := Comments.current dir
      let shown :=
        match args.positional with
        | given :: [] =>
            let subject := subjectOf dir given
            [(subject, getOr (Map.lookup subject all) [])]
        | _ => Map.toList all
      Cli.output
        args
        (fun _ => Json.obj (List.map (fun pair => (fst pair, Json.arr (List.map commentJson (snd pair)))) shown))
        (fun _ => if List.all (fun pair => List.isEmpty (snd pair)) shown then "No comments." else join "\n" (concatMap (fun pair => [fst pair] ++ List.map commentLine (snd pair)) shown))

/-- `deus compact [remote] [--level k]`: rewrites history into level-k strata and drops covered
  bundles. It never drops history: a bundle goes only once strata hold all its objects (D73). -/
def Cli.compact (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let name := remoteName args
  let level := getOr (Option.bind (option args "level") fromText) 1
  if Map.contains "keep" args.options then Throw.throw "compact keeps the whole history (D73); there is no --keep" else
    match withRemote dir name (fun _ => Replicate.compact dir name level) with
    | (written, deleted) => Cli.output
        args
        (fun _ => Json.obj [("written", Json.arr (List.map Json.str written)), ("deleted", Json.arr (List.map Json.str deleted))])
        (fun _ => "Wrote " ++ toText (List.length written) ++ " level-" ++ toText level ++
          " bundles; deleted " ++ toText (List.length deleted) ++ ".")

--
-- Commands: compiling.
--
/-- `deus compile <files…> --main <name> -o <image>`: compiles files alone, without a codebase. -/
def Cli.compile (args : Args) : {IO, Throw Text} Unit :=
  let result := batch
    Map.empty
    (fun _ => Option.none)
    (fun _ => Option.none)
    (checkTypes ())
    (parseFiles args.positional)
  Cli.warn result
  let main := getOr (option args "main") "main"
  let entry :=
    match List.lookup main result.entries with
    | Option.some (Entry.term h) => h
    | _ => Throw.throw ("no definition named " ++ main)
  let objects := Map.fromList result.objects
  let image := Image.build (fun h => Map.lookup h objects) entry
  match option args "out" with
  | Option.some out => IO.writeFile out image
  | Option.none => IO.print image

/-- Compiles `def it := <source>` against the codebase and loads it; returns its hash. -/
def Cli.compileExpr (dir : Text) (ns : Map Text Entry) (source : Text) : {IO, Throw Text} Text := (compileTyped dir ns source).compiledHash

/-- Compiles `def it := <source>` against the codebase and loads it. -/
def Cli.compileTyped (dir : Text) (ns : Map Text Entry) (source : Text) : {IO, Throw Text} Compiled :=
  let batch := batch
    ns
    (fun h => readObject dir h)
    (fun h => readMeta dir h)
    (checkTypes ())
    [parseFile "<eval>" ("def it := " ++ source)]
  match List.lookup "it" batch.entries with
  | Option.some (Entry.term h) =>
      let objects := Map.fromList batch.objects
      let fetch := fun x => orElse (Map.lookup x objects) (fun _ => readObject dir x)
      Image.load fetch [h]
      Compiled.mk h (Wasm.storedType (List.lookup h (Batch.metas batch))) (dataTypes fetch h)
  | _ => Throw.throw ("cannot compile " ++ source)

/-- `deus mdl --coverage [documents…]`: each spec document's laws no block cites, the public
  definitions in its api namespaces that no api block names (D125), and `@[req]` links to no
  requirement. Omissions are reported, not failed. -/
def Cli.coverage (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let ns := Codebase.current dir
  let entries := Map.toList ns
  let blocks := filterMap (fun pair =>
    match pair with
    | (name, Entry.spec h) => Option.map (fun form => (documentOf name, snd (Mdl.fromSexp form))) (readObject dir h)
    | _ => Option.none) entries
  let named := Set.fromList (concatMap (fun pair => apiNames (snd pair)) blocks)
  let byHash := Codebase.namesByHash ns
  -- A definition is public when a name in another namespace refers to it.
  let public := foldl (fun acc pair =>
    match pair with
    | (name, Entry.term h) => usedOutside dir byHash name h acc
    | (name, Entry.test h) => usedOutside dir byHash name h acc
    | (name, Entry.theorem h) => usedOutside dir byHash name h acc
    | _ => acc) Map.empty entries
  let terms := filterMap (fun pair =>
    match pair with
    | (name, Entry.term _) => if Set.contains name public then Option.some name else Option.none
    | _ => Option.none) entries
  let reqs := Set.fromList (filterMap
    (fun pair => if (snd pair).blockType == "req" then Option.some (fst pair ++ "." ++ (snd pair).blockId) else Option.none)
    blocks)
  let stored := specDocuments ns
  let wanted := if List.isEmpty args.positional then stored else List.filter (fun d => List.contains d stored) args.positional
  let reports := List.map (fun d =>
    let laws := filterMap (fun pair =>
      match pair with
      | (name, Entry.test _) => if documentOf name == d then Option.some name else Option.none
      | (name, Entry.theorem _) => if documentOf name == d then Option.some name else Option.none
      | _ => Option.none) entries
    let links := filterMap (fun law =>
      match Map.lookup law ns with
      | Option.some (Entry.test h) => Option.some (law, reqLinks (metaList (readMeta dir h) "attrs"))
      | Option.some (Entry.theorem h) => Option.some (law, reqLinks (metaList (readMeta dir h) "attrs"))
      | _ => Option.none) laws
    linked reqs links (covers
      d
      (filterMap (fun pair => if fst pair == d then Option.some (snd pair) else Option.none) blocks)
      laws
      named
      terms)) wanted
  Cli.output args (fun _ => Json.arr (List.map
    (fun c => Json.obj [("document", Json.str c.coverageDoc), ("uncitedLaws", Json.arr (List.map Json.str c.uncitedLaws)), ("unnamedApi", Json.arr (List.map Json.str c.unnamedApi)), ("danglingLinks", Json.arr (List.map Json.str c.danglingLinks))])
    reports)) (fun _ => join "\n" (concatMap Coverage.render reports ++
    [toText (sum (List.map (fun c => List.length c.uncitedLaws) reports)) ++ " uncited laws, " ++
      toText (sum (List.map (fun c => List.length c.unnamedApi) reports)) ++ " public definitions no api names, " ++ toText (sum (List.map (fun c => List.length c.danglingLinks) reports)) ++ " links to no requirement"]))

/-- The constructors' field types of data type `t`, and the hash its constructors name, if `types` has it. -/
def Cli.ctorsOf (types : Map Text (Text, Sexp)) (t : Sexp) : Option (Text, List (List Sexp)) :=
  match Option.bind (headName t) (fun n => Map.lookup n types) with
  | Option.some (hash, form) =>
      let ctors := Wasm.ctorFields form
      if List.isEmpty ctors then Option.none else Option.some (hash, List.map (List.map (Wasm.instantiate (Wasm.typeArgs t))) ctors)
  | Option.none => Option.none

/-- The data types a value of definition `h` may hold, by IRI: the built-in ones and those its code constructs. -/
def Cli.dataTypes (fetch : Text -> {IO, Throw Text} Option Sexp) (h : Text) : {IO, Throw Text} Map Text (Text, Sexp) :=
  let hashes := ["#Unit", "#Bool", "#List", "#Option", "#Pair"] ++
    dedup (foldl (fun acc pair => nominal (snd pair) acc) [] (closure fetch [h]))
  Map.fromList (filterMap (fun x =>
    match fetch x with
    | Option.some (Sexp.list (Sexp.sym "type" :: Sexp.str iri :: rest)) => Option.some (iri, x, Sexp.list (Sexp.sym "type" :: Sexp.str iri :: rest))
    | _ => Option.none) hashes)

--
-- Commands: replication.
--
/-- The DXOS account's R2 endpoint, so a thread needs only the access keys. -/
def Cli.defaultEndpoint : Text := "https://950816f3f59b079880a1ae33fb0ec320.r2.cloudflarestorage.com"

/-- Remotes the toolchain's own codebase has when none is configured: `origin`, the shared remote
  every thread pulls and pushes, and `explorer-demo`, where its public explorer is hosted. -/
def Cli.defaultRemote (dir : Text) (name : Text) : {IO} Option Text :=
  match Project.read dir with
  | Option.some p => if p.projectIri != toolchainIri then Option.none else if name == "origin" then Option.some toolchainRemote else if name == explorerDemo then Option.some "r2://agent-artifacts/deus/explorer-demo" else Option.none
  | Option.none => Option.none

/-- The last defect's stack as `    at <hash>` lines, stable enough to cache with a verdict. -/
def Cli.defectTrace (u : Unit) : Text := join "" (List.map (fun h => "\n    at " ++ h) (Code.defectTrace ()))

def Cli.deps (args : Args) (reverse : Bool) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let ns := Codebase.current dir
  match Cli.lookupName ns (getOr (head? args.positional) "") with
  | (name, e) =>
      let h := Entry.hash e
      let index := nameIndex ns
      let display := fun x => getOr (Map.lookup x index) (short x)
      let found := if reverse then dependentsOf dir ns h else
        match readObject dir h with
        | Option.some obj => Codebase.dependencies obj
        | Option.none => []
      Cli.output
        args
        (fun _ => Json.obj [("name", Json.str name), (if reverse then "dependents" else "dependencies", Json.arr (List.map (fun x => Json.obj [("hash", Json.str x), ("name", Json.str (display x))]) found))])
        (fun _ => join "\n" (List.map display found))

/-- What `MdlHost.describe` reports about a name: its kind, hash, displayed type, declaration as
  source, and for a test or a theorem its verdict (checked now unless a result is cached). -/
def Cli.describeName (dir : Text) (ns : Map Text Entry) (facts : MdlFacts) (name : Text) : {IO, Throw Text} List (Text, Text) :=
  let printer := facts.printer
  match Map.lookup name ns with
  | Option.none => Throw.throw (name ++ " is not in the codebase")
  | Option.some e =>
      let h := Entry.hash e
      let meta := Option.map (metaFor name) (readMeta dir h)
      let typed :=
        match ownScheme meta (List.length (getOr (Map.lookup h printer.namesByHash) [])) with
        | Option.some scheme => [("type", displaySchemeNamed printer.declared scheme)]
        | Option.none => []
      let verdict :=
        match Check.verdictOf dir ns e with
        | Option.some (Verdict.pass evidence cases) => [("verdict", "pass"), ("evidence", evidence), ("cases", toText cases)]
        | Option.some (Verdict.fail reason) => [("verdict", "fail"), ("reason", reason)]
        | Option.some Verdict.unchecked => [("verdict", "unchecked")]
        | Option.none => []
      -- Specs name things in full, so the statement prints every reference by its full name.
      let statement :=
        match readObject dir h with
        | Option.some (Sexp.list (Sexp.sym "theorem" :: Sexp.list (Sexp.sym "binders" :: types) :: prop :: proof :: _)) =>
            let base := withLocals printer (List.map asText (metaList meta "locals"))
            let full := Printer.mk
              base.fullNames
              base.fullNames
              facts.fullTypes
              Map.empty
              base.declared
              base.namesByHash
              base.supply
              base.fresh
            let decl := View.theoremDecl full name types prop proof
            let stop := indexOf decl " := " 0
            [("statement", trim (Text.drop
              (Text.length ("theorem " ++ name))
              (if stop < 0 then decl else Text.take stop decl)))]
        | Option.some (Sexp.list (Sexp.sym "term" :: core :: [])) => if isStub core then [("implemented", "false")] else []
        | _ => []
      [("kind", Entry.kind e), ("hash", h), ("view", snd (viewParts (withLocals printer []) dir ns name e "deus"))] ++
        typed ++
        statement ++
        verdict

def Cli.die (message : Text) : {IO} a :=
  eprintln ("deus: " ++ message)
  IO.exit 1

def Cli.dispatch (argv : List Text) : {IO, Throw Text} Unit :=
  match argv with
  | [] => IO.print Cli.usage
  | command :: rest =>
      let args := parseArgs rest
      if command == "compile" then Cli.compile args else if command == "init" then Cli.init args else if command == "add" then addOrUpdate args false else if command == "update" then addOrUpdate args true else if command == "ls" then ls args else if command == "find" then Cli.find args else if command == "view" then Cli.view args else if command == "names" then Cli.names args else if command == "deps" then deps args false else if command == "dependents" then deps args true else if command == "mv" then mv args false else if command == "alias" then mv args true else if command == "rm" then rm args else if command == "branch" then branch args else if command == "switch" then switch args else if command == "merge" then Cli.merge args else if command == "log" then Cli.log args else if command == "layers" then Cli.layers args else if command == "migrate" then Cli.migrate args else if command == "project" then project args else if command == "lib" then Cli.lib args else if command == "remote" then remote args else if command == "push" then Cli.push args else if command == "pull" then Cli.pull args else if command == "compact" then Cli.compact args else if command == "undo" then undo args else if command == "run" then
        match leadingOptions rest with
        | (options, program) => Cli.run (parseArgs options) program
      else if command == "eval" then eval args else if command == "artifact" then artifact args else if command == "embed" then embed args else if command == "mdl" then mdl args else if command == "features" then features args else if command == "test" then tests args else if command == "check" then theorems args else if command == "image" then Cli.image args else if command == "build" then Cli.build args else if command == "bindings" then bindings args else if command == "serve" then Cli.serve args else if command == "explore" then explore args else if command == "task" then Cli.task args else if command == "comment" then Cli.comment args else if command == "comments" then Cli.comments args else if command == "asset" then asset args else if command == "inbox" then inbox args else if command == "export" then export args else if command == "history" then Cli.history args else if command == "event" then Analytics.command args else if command == "help" then IO.print Cli.usage else die ("unknown command " ++ command ++ "\n" ++ Cli.usage)

/-- `deus embed <file> --as <Name>` keeps the file's text in the asset store under its SHA-256 and
  defines `Name` as `Embed.text "<sha256>"`, so git carries the hash and never the text (task 88004c30). -/
def Cli.embed (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  match (args.positional, option args "as") with
  | (file :: [], Option.some name) =>
      let binary := Cli.flag args "bytes"
      let sha := if binary then (Assets.add dir file).hash else addText dir file
      let kind := if binary then "bytes" else "text"
      let valueType := if binary then "List Int" else "Text"
      let source := dir ++ "/cache/embed.deus"
      IO.mkdirp (dir ++ "/cache")
      IO.writeFile
        source
        ("/-- Embedded from " ++ Assets.baseName file ++ " (deus embed). -/\n@[artifact]\ndef " ++
          name ++ " : " ++ valueType ++ " := Embed." ++ kind ++ " \"" ++ sha ++ "\"\n")
      let author :=
        match option args "by" with
        | Option.some agent => ["--by", agent]
        | Option.none => []
      addOrUpdate (parseArgs ([source, "--codebase", dir, "--quiet"] ++ author)) true
      IO.remove source
      if Cli.flag args "quiet" then () else Cli.output
        args
        (fun _ => Json.obj [("name", Json.str name), ("sha256", Json.str sha)])
        (fun _ => "Embedded " ++ file ++ " as " ++ name ++ " " ++ Text.take 10 sha ++ ".")
  | _ => Throw.throw "usage: deus embed <file> --as <Name> [--bytes]"

/-- The asset an embedded constant names, with its kind: its body is exactly `Embed.text "<sha256>"`
  (Artifact.Spec R-6) or `Embed.bytes "<sha256>"` (R-10). -/
def Cli.embeddedAsset (dir : Text) (h : Text) : {IO, Throw Text} Option (Text, Text) :=
  match readObject dir h with
  | Option.some (Sexp.list (Sexp.sym "term" :: Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "ref" :: Sexp.str callee :: []) :: Sexp.list (Sexp.sym "text" :: Sexp.str sha :: []) :: []) :: [])) =>
      let ns := Codebase.current dir
      let names := fun kind => Option.map Entry.hash (Map.lookup ("Embed." ++ kind) ns) == Option.some callee
      if names "text" then Option.some ("text", sha) else if names "bytes" then Option.some ("bytes", sha) else Option.none
  | _ => Option.none

/-- Evaluates every uncached `@[artifact]` constant `roots` reach and keeps its value; returns their hashes. -/
def Cli.ensureArtifacts (dir : Text) (roots : List Text) : {IO, Throw Text} List Text :=
  let wanted := List.filter
    (fun h => isArtifact dir h && isNone (cachedValue dir h))
    (List.map fst (closure (fun h => readObject dir h) roots))
  List.map (fun h => evaluateArtifact dir h ("#" ++ short h)) wanted

def Cli.entryJson (name : Text) (e : Entry) : Json := Json.obj [("name", Json.str name), ("kind", Json.str (Entry.kind e)), ("hash", Json.str (Entry.hash e))]

/-- `deus eval "<expr>"`: evaluates an expression against the codebase and prints it; the expression may perform `Workspace`. -/
def Cli.eval (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let text := evaluate dir (forwarded args) (join " " args.positional)
  Cli.output args (fun _ => Json.obj [("value", Json.str text)]) (fun _ => text)

/-- `source` compiled against `dir` and run with `Workspace` handled; the value as source. -/
def Cli.evaluate (dir : Text) (passed : List Text) (source : Text) : {IO, Throw Text} Text :=
  let compiled := compileTyped dir (Codebase.current dir) source
  let value := withWorkspace dir passed (fun _ => Code.run compiled.compiledHash)
  Print.expr
    (Print.printer (Codebase.current dir) [])
    (Sexp.read (quoteAt compiled.compiledTypes compiled.compiledType value))
    []
    0
    0

/-- Evaluates the constant `h` and keeps its value; `label` names it in the error a function gets (R-5). -/
def Cli.evaluateArtifact (dir : Text) (h : Text) (label : Text) : {IO, Throw Text} Text :=
  let quoted :=
    match embeddedAsset dir h with
    | Option.some (kind, sha) => if not (Assets.has dir sha) then Throw.throw (label ++ " embeds the file " ++ sha ++ ", which is not in the asset store") else if kind == "bytes" then
        match Map.lookup "Embed.fromLatin1" (Codebase.current dir) with
        | Option.some e => "(app (ref \"" ++ Entry.hash e ++ "\") " ++ Code.quote (fromCodes (assetBytes dir sha)) ++
            ")"
        | Option.none => Throw.throw (label ++ " embeds a binary file, which needs Embed.fromLatin1 in the codebase")
      else Code.quote (getOr (IO.readFile (Assets.path dir sha)) "")
    | Option.none =>
        Image.load (fun x => readObject dir x) [h]
        Code.quote (Code.run h)
  if Text.contains "(prim \"<function>\")" quoted then Throw.throw (label ++ " is a function; an @[artifact] must be a first-order constant") else
    IO.mkdirp (dir ++ "/artifacts")
    IO.writeFile (artifactPath dir h) (quoted ++ "\n")
    h

/-- Expands directories to the `.deus` and `.mdl` files they contain, sorted. -/
def Cli.expandPaths (paths : List Text) : {IO} List Text := concatMap (fun path => if IO.isDir path then List.map
  (fun f => path ++ "/" ++ f)
  (List.filter (fun f => endsWith ".deus" f || endsWith ".mdl" f) (IO.listDir path)) else [path]) paths

/-- `deus explore [--out dir] [--port n] [--publish remote] [--console]` (D58): writes the codebase
  explorer for the current branch, then serves it locally, or uploads it next to a remote's bundles
  (`<prefix>/site/`), where a public bucket serves it. `--console` adds a console that runs `deus`
  in the page (D84); a site that has one keeps it. -/
def Cli.explore (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let out := getOr (option args "out") (dir ++ "/cache/site")
  -- The console goes first, so meta.json can say whether the site has one.
  if Cli.flag args "console" || IO.exists (out ++ "/console/codebase.json") then console dir out else 0
  let pages := Explorer.generate dir out
  match (option args "publish", option args "out") with
  | (Option.some name, _) =>
      match publishSite dir name out (Cli.flag args "force") with
      | (files, uploaded) => Cli.output
          args
          (fun _ => Json.obj [("definitions", Json.num pages), ("remote", Json.str name), ("files", Json.num files), ("uploaded", Json.num uploaded)])
          (fun _ => "Published " ++ toText uploaded ++ " changed of " ++ toText files ++ " files to " ++ name ++
            " under site/ (open site/index.html at the bucket's public URL).")
  | (Option.none, Option.some _) => Cli.output
      args
      (fun _ => Json.obj [("definitions", Json.num pages), ("out", Json.str out)])
      (fun _ => "Wrote the explorer for " ++ toText pages ++ " definitions to " ++ out ++ ".")
  | (Option.none, Option.none) =>
      let image := siteImage ()
      let server := dir ++ "/artifacts/site-server-" ++ Text.sha256 image
      let built := if IO.exists server then Result.ok () else try (fun _ =>
        IO.mkdirp (dir ++ "/artifacts")
        Build.server image server)
      match built with
      | Result.err f => Throw.throw (Failure.render f)
      | Result.ok _ =>
          let port := getOr (option args "port") "8080"
          IO.eprint ("Wrote the explorer for " ++ toText pages ++
            " definitions; exploring on http://127.0.0.1:" ++ port ++ "\n")
          match IO.exec "env" ["PORT=" ++ port, "DEUS_SITE=" ++ out, server] with
          | (code, _, err) =>
              IO.eprint err
              if code == 0 then () else IO.exit code

/-- The public explorer of the toolchain's codebase, refreshed by every push to the shared remote. -/
def Cli.explorerDemo : Text := "explorer-demo"

/-- `deus export <dir>` (D64): the codebase as text for a git repository: source per namespace,
  tasks, and history. `deus add <dir>/code` and `deus task import <dir>/tasks.sexp` restore it. -/
def Cli.export (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  match head? args.positional with
  | Option.none => Throw.throw "usage: deus export <dir>"
  | Option.some out =>
      match Export.write dir out with
      | (files, definitions, tasks) => Cli.output
          args
          (fun _ => Json.obj [("files", Json.num files), ("definitions", Json.num definitions), ("tasks", Json.num tasks)])
          (fun _ => "Exported " ++ toText definitions ++ " definitions in " ++ toText files ++ " files and " ++
            toText tasks ++
            " tasks to " ++
            out ++
            ".")

/-- Extensions in the codebase by URI: the terms carrying `@[ext "<uri>"]`. -/
def Cli.extensions (dir : Text) (ns : Map Text Entry) : {IO} Map Text Text := Map.fromList (concatMap (fun pair =>
  match snd pair with
  | Entry.term h => filterMap (fun a =>
      match a with
      | Sexp.list (Sexp.str "ext" :: Sexp.str uri :: []) => Option.some (uri, h)
      | _ => Option.none) (metaList (readMeta dir h) "attrs")
  | _ => []) (Map.toList ns))

/-- The spec documents that hold `feature` blocks. -/
def Cli.featureDocuments (dir : Text) (ns : Map Text Entry) : {IO, Throw Text} List Text := List.filter (fun d => not (List.isEmpty (fst (featuresOf dir ns d)))) (specDocuments ns)

/-- What `MdlHost.describe` says about `task:<id>` (its state and title) and `spec:<Doc>` names, which
  feature blocks link (D118); `none` for any other name. `tasks` caches the branch's tasks, read on
  first use. -/
def Cli.featureFact (dir : Text) (documents : List Text) (tasks : Ref (Option (Map Text Task))) (name : Text) : {IO} Option (Result Text (List (Text, Text))) := if startsWith "task:" name then
  let all :=
    match Ref.get tasks with
    | Option.some known => known
    | Option.none =>
        let known :=
          match try (fun _ => Tasks.current dir) with
          | Result.ok found => found
          | Result.err _ => Map.empty
        Ref.set tasks (Option.some known)
        known
  Option.some (match Map.lookup (Text.drop 5 name) all with
  | Option.some t => Result.ok [("kind", "task"), ("state", stateText t.state), ("title", t.title)]
  | Option.none => Result.err (name ++ " is not in the codebase"))
else if startsWith "spec:" name then Option.some (if List.contains (Text.drop 5 name) documents then Result.ok [("kind", "spec")] else Result.err (name ++ " is not in the codebase")) else Option.none

/-- What `deus features` knows about a name: a definition's kind and whether it is only declared, a task, or a spec document. -/
def Cli.featureFacts (dir : Text) (ns : Map Text Entry) : ({IO} Text) -> {IO, Throw Text} Result Text (List (Text, Text)) :=
  let tasks := Ref.new Option.none
  let documents := specDocuments ns
  fun name =>
    match featureFact dir documents tasks name with
    | Option.some answer => answer
    | Option.none =>
        match Map.lookup name ns with
        | Option.none => Result.err (name ++ " is not in the codebase")
        | Option.some e =>
            let stub :=
              match readObject dir (Entry.hash e) with
              | Option.some (Sexp.list (Sexp.sym "term" :: core :: [])) => isStub core
              | _ => false
            Result.ok ([("kind", Entry.kind e)] ++ (if stub then [("implemented", "false")] else []))

/-- Problems that span the map (unparsed blocks, orphans) followed by each feature's own. -/
def Cli.featureNotes (facts : Text -> {IO, Throw Text} Result Text (List (Text, Text))) (fs : List Feature) (bad : List Text) : {IO, Throw Text} List Text := bad ++ Features.orphans fs ++
  concatMap (fun f => List.map (fun p => f.featureId ++ ": " ++ p) (Features.problems f facts)) fs

/-- `deus features [documents…]`: the feature maps (D118), each a tree of features with their status
  and open tasks, then what is wrong or missing. With no arguments, every document with a
  `feature` block. -/
def Cli.features (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let ns := Codebase.current dir
  let facts := featureFacts dir ns
  let docs := if List.isEmpty args.positional then featureDocuments dir ns else args.positional
  if Cli.flag args "json" then println (Json.render (featuresJson dir ns docs)) else
    let text := join "\n\n" (List.map (fun d =>
      match featuresOf dir ns d with
      | (fs, bad) =>
          let found := featureNotes facts fs bad
          d ++ "\n" ++ Features.render fs facts ++
            (if List.isEmpty found then "" else "\n" ++ join "\n" (List.map (fun n => "  " ++ n) found))) docs)
    if Text.isEmpty text then () else println text

/-- Feature maps as `deus features --json` prints them and the explorer's `features.json` holds them
  (D118): per document, its features in tree order with status, links, open tasks and problems,
  then notes on blocks that do not parse and features whose parent is missing. -/
def Cli.featuresJson (dir : Text) (ns : Map Text Entry) (docs : List Text) : {IO, Throw Text} Json :=
  let facts := featureFacts dir ns
  Json.arr (List.map (fun d =>
    match featuresOf dir ns d with
    | (fs, bad) => Json.obj [("document", Json.str d), ("features", Json.arr (List.map (fun pair =>
        match pair with
        | (depth, f) =>
            let opened := List.filter (fun id =>
              match facts ("task:" ++ id) with
              | Result.ok known => isOpenState (prop0 known "state")
              | Result.err _ => false) f.taskIds
            Json.obj [("id", Json.str f.featureId), ("title", Json.str f.featureTitle), ("status", Json.str f.featureStatus), ("parent", Json.str f.parentId), ("depth", Json.num depth), ("specs", Json.arr (List.map Json.str f.specDocs)), ("defs", Json.arr (List.map Json.str f.definitions)), ("tasks", Json.arr (List.map Json.str f.taskIds)), ("openTasks", Json.arr (List.map Json.str opened)), ("problems", Json.arr (List.map Json.str (Features.problems f facts)))]) (Features.tree fs))), ("notes", Json.arr (List.map Json.str (featureNotes facts fs bad)))]) docs)

/-- A document's `feature` blocks as features, in document order, with the blocks that do not parse. -/
def Cli.featuresOf (dir : Text) (ns : Map Text Entry) (d : Text) : {IO, Throw Text} (List Feature, List Text) :=
  let orderOf := fun h =>
    match metaField (readMeta dir h) "order" with
    | Option.some (Sexp.int k) => k
    | _ => 1000000
  let blocks := filterMap (fun pair =>
    match pair with
    | (name, Entry.spec h) => if documentOf name != d then Option.none else Option.bind (readObject dir h) (fun form =>
        match Mdl.fromSexp form with
        | (_, b) => if b.blockType == "feature" then Option.some (orderOf h, b) else Option.none)
    | _ => Option.none) (Map.toList ns)
  let sorted := List.map snd (sortBy (fun a b => compare (fst a) (fst b)) blocks)
  foldl (fun acc b =>
    match (acc, fromBlock b) with
    | ((fs, bad), Result.ok f) => (fs ++ [f], bad)
    | ((fs, bad), Result.err found) => (fs, bad ++ List.map (fun p => b.blockId ++ ": " ++ p) found)) ([], []) sorted

--
-- Commands: running.
--
/-- Objects for images and the machine: a cached `@[artifact]` constant is its kept value (Artifact.Spec R-4). -/
def Cli.fetcher (dir : Text) (h : Text) : {IO} Option Sexp :=
  match cachedValue dir h with
  | Option.some value => Option.some (Sexp.node "term" [value])
  | Option.none => readObject dir h

/-- Every file under `dir`, as paths relative to it. -/
def Cli.filesUnder (dir : Text) (prefix : Text) : {IO} List Text := concatMap (fun f =>
  let path := if Text.isEmpty prefix then f else prefix ++ "/" ++ f
  if IO.isDir (dir ++ "/" ++ path) then Cli.filesUnder dir path else [path]) (IO.listDir (if Text.isEmpty prefix then dir else dir ++ "/" ++ prefix))

def Cli.find (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let ns := Codebase.current dir
  let query := getOr (head? args.positional) ""
  let rows := List.filter (fun pair => Text.contains query (fst pair)) (Map.toList ns)
  Cli.output
    args
    (fun _ => Json.arr (List.map (fun p => entryJson (fst p) (snd p)) rows))
    (fun _ => join "\n" (List.map (fun p => fst p ++ "  " ++ short (Entry.hash (snd p))) rows))

def Cli.flag (args : Args) (key : Text) : Bool := Map.contains key args.options

/-- The options a command run under `Workspace` passes on: the codebase and the author. -/
def Cli.forwarded (args : Args) : List Text := concatMap (fun key =>
  match option args key with
  | Option.some value => ["--" ++ key, value]
  | Option.none => []) ["codebase", "by"]

/-- The branch's first-parent history, newest first, as (causal, message, by), followed by the
  history imported from exports (D67), so a restored codebase shows what came before it. -/
def Cli.fullLog (dir : Text) (limit : Int) : {IO, Throw Text} List (Text, (Text, Text)) :=
  let live := Codebase.history dir (currentBranch dir) limit
  let own := List.map (fun pair =>
    match pair with
    | (h, c) => (h, c.message, getOr (producedBy dir h) "")) live
  let imported := concatMap
    (fun pair => if Text.isEmpty (snd pair).prior then [] else recordEntries dir (snd pair).prior)
    live
  -- Records repeat the changes they share (D79), the root `init` included; the oldest position stays.
  let rec unique entries seen acc :=
    match entries with
    | [] => reverse acc
    | entry :: rest =>
        match entry with
        | (h, _, _) => if Set.contains h seen then unique rest seen acc else unique rest (Set.insert h seen) (entry :: acc)
  List.take limit (reverse (unique (reverse (own ++ imported)) Map.empty []))

--
-- Commands: documents.
--
/-- Runs `f ()` and turns a defect into `err`. -/
def Cli.guardDefect (f : Unit -> {IO} a) : {IO} Result Text a :=
  handle Result.ok (f ()) with
  | Defect.raise message -> x0 => Result.err message

/-- `deus history import <history.sexp>`: the history of an export, kept under the restore (D67). -/
def Cli.history (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  match args.positional with
  | "import" :: path :: [] =>
      let n := importHistory dir path
      Cli.output
        args
        (fun _ => Json.obj [("imported", Json.num n)])
        (fun _ => "Imported " ++ toText n ++ " changes into the history.")
  | _ => Throw.throw "usage: deus history import <history.sexp>"

/-- `deus image <name> -o <file>`: the kernel image of a definition. -/
def Cli.image (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let ns := Codebase.current dir
  match Cli.lookupName ns (getOr (head? args.positional) "") with
  | (_, Entry.term h) =>
      ensureArtifacts dir [h]
      let text := Image.build (fetcher dir) h
      match option args "out" with
      | Option.some out => IO.writeFile out text
      | Option.none => IO.print text
  | _ => Throw.throw "usage: deus image <term> -o <file>"

/-- `deus inbox [remote]` (D82): applies the comments and tasks members filed in the hosted explorer. -/
def Cli.inbox (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let name := remoteName args
  let lines := withRemote dir name (fun _ => Inbox.apply dir)
  Cli.output
    args
    (fun _ => Json.arr (List.map Json.str lines))
    (fun _ => if List.isEmpty lines then "The inbox is empty." else join "\n" lines)

/-- `deus init [--empty]`: a codebase holding the builtins and prelude, or nothing with `--empty`. -/
def Cli.init (args : Args) : {IO, Throw Text} Unit :=
  let dir := codebaseDir args
  Codebase.init dir
  let library :=
    match (Cli.flag args "empty", IO.getEnv "DEUS_HOME") with
    | (false, Option.some home) =>
        addOrUpdate (Args.mk
          [home ++ "/deus/builtins.deus", home ++ "/deus/prelude.deus"]
          (Map.fromList [("codebase", dir), ("message", "standard library"), ("quiet", "true")])) false
        true
    | _ => false
  Cli.output
    args
    (fun _ => Json.obj [("codebase", Json.str dir), ("branch", Json.str "main"), ("library", Json.bool library)])
    (fun _ => "Initialized a codebase in " ++ dir ++ " on branch main" ++
      (if library then ", with the builtins and prelude." else ", empty."))

/-- Whether `h` is marked `@[artifact]`; the text test first spares parsing every definition's metadata. -/
def Cli.isArtifact (dir : Text) (h : Text) : {IO} Bool :=
  match IO.readFile (dir ++ "/meta/" ++ h) with
  | Option.some text => Text.contains "artifact" text && hasAttr dir h "artifact"
  | Option.none => false

/-- Whether `name` reaches the shared toolchain remote, configured or by default. -/
def Cli.isToolchainRemote (dir : Text) (name : Text) : {IO} Bool :=
  let configured := Option.map trim (IO.readFile (dir ++ "/remotes/" ++ name ++ "/url"))
  getOr (orElse configured (fun _ => defaultRemote dir name)) "" == toolchainRemote

/-- The value of `def it := <source>` on this kernel and on the js target, each printed as `deus eval`
  prints it (D97). The module runs under `$DEUS_NODE`. -/
def Cli.jsCompare (dir : Text) (ns : Map Text Entry) (source : Text) : {IO} Result Text (Text, Text) :=
  match try (fun _ =>
    let batch := batch
      ns
      (fun h => readObject dir h)
      (fun h => readMeta dir h)
      (checkTypes ())
      [parseFile "<eval>" ("def it := " ++ source)]
    match List.lookup "it" batch.entries with
    | Option.some (Entry.term h) =>
        let objects := Map.fromList batch.objects
        let metas := Map.fromList (Batch.metas batch)
        let fetch := fun x => orElse (Map.lookup x objects) (fun _ => readObject dir x)
        Image.load fetch [h]
        let types := dataTypes fetch h
        let printer := Print.printer ns []
        let render := fun quoted => Print.expr printer (Sexp.read quoted) [] 0 0
        let kernel :=
          match guardDefect (fun _ => quoteAt types (Wasm.storedType (Map.lookup h metas)) (Code.run h)) with
          | Result.ok q => render q
          | Result.err message => "defect: " ++ message
        let out := dir ++ "/cache/js-" ++ Text.take 16 (Text.sha256 (h ++ source))
        IO.mkdirp out
        writeJs
          dir
          ns
          (fun x => orElse (Map.lookup x objects) (fun _ => readObject dir x))
          (fun x => orElse (Map.lookup x metas) (fun _ => readMeta dir x))
          [("it", h)]
          (out ++ "/it.js")
        IO.writeFile (out ++ "/run.mjs") (join
          "\n"
          ["import { raw } from './it.js';", "import { quote, DeusDefect } from './deus-runtime.mjs';", "try { process.stdout.write(quote(raw.it)); } catch (err) {", "  if (!(err instanceof DeusDefect)) throw err;", "  process.stdout.write('defect: ' + err.message); }"])
        let node := getOr (IO.getEnv "DEUS_NODE") "node"
        match IO.exec node [out ++ "/run.mjs"] with
        | (0, stdout, _) => (kernel, if startsWith "defect: " stdout then stdout else render stdout)
        | (code, _, stderr) => Throw.throw ("node exited with " ++ toText code ++ ": " ++ trim stderr)
    | _ => Throw.throw ("cannot compile " ++ source)) with
  | Result.ok pair => Result.ok pair
  | Result.err message => Result.err message

/-- Dependencies of a batch's objects that their layer may not have, as `name (layer) -> name (layer)`. -/
def Cli.layerCrossings (dir : Text) (batch : Batch) : {IO} List Text :=
  let objects := Map.fromList batch.objects
  let names := Map.fromList (List.map (fun pair => (Entry.hash (snd pair), fst pair)) batch.entries)
  let nameOf := fun h => getOr (Map.lookup h names) (short h)
  let formOf := fun h => orElse (Map.lookup h objects) (fun _ => readObject dir h)
  concatMap (fun pair =>
    match pair with
    | (h, form) =>
        let layer := layerOf form
        filterMap (fun dep =>
          match formOf dep with
          | Option.some depForm =>
              let depLayer := layerOf depForm
              if any (fun allowed => allowed == depLayer) (mayDependOn layer) then Option.none else Option.some (nameOf h ++ " (" ++ layer ++ ") -> " ++ nameOf dep ++ " (" ++ depLayer ++ ")")
          | Option.none => Option.none) (Codebase.dependencies form)) batch.objects

/-- `deus layers`: each layer, where it lives, whether it is replicated, and its object count. -/
def Cli.layers (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let counts := foldl (fun m h =>
    match readObject dir h with
    | Option.some form =>
        let layer := layerOf form
        Map.insert layer (1 + getOr (Map.lookup layer m) 0) m
    | Option.none => m) Map.empty (allObjects dir)
  let fileCount := fun sub => if IO.isDir (dir ++ "/" ++ sub) then List.length (IO.listDir (dir ++ "/" ++ sub)) else 0
  let rows := List.map (fun layer =>
    match layer with
    | (name, place, replicated) =>
        let count := if place == "objects/" then getOr (Map.lookup name counts) 0 else fileCount (Text.take (Text.length place - 1) place)
        (name, place, replicated, count)) Codebase.layers
  Cli.output args (fun _ => Json.arr (List.map (fun row =>
    match row with
    | (name, place, replicated, count) => Json.obj [("layer", Json.str name), ("path", Json.str place), ("replicated", Json.bool replicated), ("entries", Json.num count)]) rows)) (fun _ => join "\n" (List.map (fun row =>
    match row with
    | (name, place, replicated, count) => padRight 12 name ++ padRight 14 place ++
        padRight 12 (if replicated then "replicated" else "local") ++ toText count) rows))

/-- Splits `--flag value` options off the front of arguments, for commands like `run` whose
  remaining arguments belong to someone else: `deus run --codebase c main a b`. -/
def Cli.leadingOptions (argv : List Text) : (List Text, List Text) :=
  match argv with
  | a :: more => if startsWith "--" a then if Set.contains (Text.drop 2 a) booleanFlags then
      match Cli.leadingOptions more with
      | (options, rest) => (a :: options, rest)
    else
      match more with
      | v :: tail =>
          match Cli.leadingOptions tail with
          | (options, rest) => (a :: v :: options, rest)
      | [] => ([a], []) else ([], argv)
  | [] => ([], [])

/-- `deus lib install <name> <codebase> [--branch b]`: mounts that project's branch head under `lib.<name>`. -/
def Cli.lib (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  match args.positional with
  | "install" :: name :: from :: [] =>
      let p :=
        match Project.read dir with
        | Option.some p => p
        | Option.none => Throw.throw "this codebase has no project; run `deus project init <iri>`"
      let installed := install dir (Codebase.current dir) name from (getOr (option args "branch") "main")
      match installed with
      | (l, ns) =>
          Project.write dir (match p with
          | Project.mk x0 x1 => Project.mk x0 (l :: List.filter (fun other => other.libName != name) p.libs))
          let causal := commit dir ns ("lib install " ++ name ++ " " ++ l.libIri ++ " @ " ++ short l.release)
          Cli.output
            args
            (fun _ => Json.obj [("lib", Json.str name), ("iri", Json.str l.libIri), ("release", Json.str l.release), ("causal", Json.str causal)])
            (fun _ => "Installed lib." ++ name ++ " = " ++ l.libIri ++ " @ " ++ short l.release ++ ".")
  | _ => Throw.throw "usage: deus lib install <name> <codebase> [--branch <branch>]"

/-- A linked definition: its name, the hash it was linked at, its current hash, and the changes that rebound it. -/
def Cli.linkReport (dir : Text) (ns : Map Text Entry) (a : Attachment) : {IO, Throw Text} (Json, List Text) :=
  match a with
  | Attachment.change h =>
      let message :=
        match readObject dir h with
        | Option.some form => (causalFromSexp form).message
        | Option.none => "(not in this store)"
      (Json.obj [("change", Json.str h), ("message", Json.str message)], ["  change " ++ short h ++ "  " ++ message])
  | Attachment.definition name h =>
      let now := Option.map Entry.hash (Map.lookup name ns)
      let changes := historyOfName dir name 200
      let state :=
        match now with
        | Option.none => "  (no longer named)"
        | Option.some n => if n == h then "" else "  (now " ++ short n ++ ")"
      (Json.obj [("definition", Json.str name), ("hash", Json.str h), ("current", getOr (Option.map Json.str now) Json.null), ("changes", Json.arr (List.map (Cli.changeJson dir) changes))], ("  " ++ name ++ "  " ++ short h ++ state) :: List.map (fun c => "  " ++ changeLine dir c) changes)

def Cli.log (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let limit := getOr (Option.bind (option args "n") fromText) 20
  let entries := fullLog dir limit
  Cli.output args (fun _ => Json.arr (List.map (fun entry =>
    match entry with
    | (h, message, agent) => Json.obj ([("causal", Json.str h), ("message", Json.str message)] ++
        (if Text.isEmpty agent then [] else [("by", Json.str agent)]))) entries)) (fun _ => join "\n" (List.map (fun entry =>
    match entry with
    | (h, message, agent) => short h ++ "  " ++ message ++ (if Text.isEmpty agent then "" else "  (by " ++ agent ++ ")")) entries))

/-- Resolves a reference in a namespace to its full name and entry (D105): a name, a `#hashprefix`,
  a name IRI `<project>/<name>`, or a pinned `<project>/<name>#<hash>`. A prefix that matches
  more than one hash is an error; a pinned hash whose name moved resolves to another name of it. -/
def Cli.lookupName (ns : Map Text Entry) (name : Text) : {Throw Text} (Text, Entry) := if startsWith "#" name then
  let prefix := Text.drop 1 name
  match List.filter (fun pair => startsWith prefix (Entry.hash (snd pair))) (Map.toList ns) with
  | [] => Throw.throw ("no definition with hash " ++ name)
  | pair :: rest =>
      match List.filter (fun other => Entry.hash (snd other) != Entry.hash (snd pair)) rest with
      | [] => pair
      | others => Throw.throw ("ambiguous hash " ++ name ++ ": " ++ join ", " (List.map
          (fun p => fst p ++ " " ++ short (Entry.hash (snd p)))
          (List.take 5 (pair :: others))))
else if Text.contains "://" name then
  match parts name with
  | (iri, fragment) =>
      let bare := foldl (fun acc piece => piece) "" (Text.split iri "/")
      if not (Analytics.isHex fragment) then Cli.lookupName ns bare else
        let h := Analytics.hashOf name
        match Map.lookup bare ns with
        | Option.some e => if Entry.hash e == h then (bare, e) else Cli.lookupName ns ("#" ++ fragment)
        | Option.none => Cli.lookupName ns ("#" ++ fragment)
else
  match Map.lookup name ns with
  | Option.some e => (name, e)
  | Option.none =>
      match Names.lookup (Names.build ns) name (Scope.mk [] []) (fun _ => true) true with
      | Option.some hit => hit
      | Option.none => Throw.throw ("unknown name " ++ name)

--
-- Commands: reading the codebase.
--
def Cli.ls (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let ns := Codebase.current dir
  let prefix := getOr (head? args.positional) ""
  let rows := List.filter (fun pair => startsWith prefix (fst pair)) (Map.toList ns)
  let width := foldl (fun w p => if Text.length (fst p) > w then Text.length (fst p) else w) 0 rows
  let colour := enabled ()
  let paint := fun code t => if colour then Highlight.esc ++ "[" ++ code ++ "m" ++ t ++ Highlight.esc ++ "[0m" else t
  let lines := List.map
    (fun p => padRight (width + 2) (fst p) ++ paint "36" (padRight 8 (Entry.kind (snd p))) ++ " " ++
      paint "2" (short (Entry.hash (snd p))))
    rows
  Cli.output
    args
    (fun _ => Json.arr (List.map (fun p => entryJson (fst p) (snd p)) rows))
    (fun _ => join "\n" lines)

def Cli.main (u : Unit) : {IO} Unit :=
  match try (fun _ => dispatch (IO.args ())) with
  | Result.ok _ => ()
  | Result.err message => die message

/-- `deus mdl [documents|files|dirs…]`: checks spec documents in the codebase by name (D99), MDL
  files, or with no arguments every spec document the codebase holds. Each block goes to the
  extension its term's URI names in the codebase; a block whose extension the codebase lacks is
  reported unchecked. -/
def Cli.mdl (args : Args) : {IO, Throw Text} Unit := if Cli.flag args "coverage" then coverage args else checkMdl args

def Cli.mdlFacts (ns : Map Text Entry) : MdlFacts :=
  let fullTypes := Map.fromList (filterMap (fun pair =>
    match pair with
    | (n, Entry.type _ iri _) => Option.some (iri, n)
    | (n, Entry.ability _ iri) => Option.some (iri, n)
    | _ => Option.none) (Map.toList ns))
  MdlFacts.mk (Print.printer ns []) fullTypes (specDocuments ns)

def Cli.merge (args : Args) : {IO, Throw Text} Unit :=
  match args.positional with
  | other :: [] =>
      let dir := openCodebase args
      match Codebase.merge dir other with
      | MergeResult.upToDate => Cli.output
          args
          (fun _ => Json.obj [("result", Json.str "up-to-date")])
          (fun _ => "Already up to date.")
      | MergeResult.fastForward h => Cli.output
          args
          (fun _ => Json.obj [("result", Json.str "fast-forward"), ("causal", Json.str h)])
          (fun _ => "Fast-forwarded to " ++ short h ++ ".")
      | MergeResult.merged h changed => Cli.output
          args
          (fun _ => Json.obj [("result", Json.str "merged"), ("causal", Json.str h), ("changed", Json.arr (List.map Json.str changed))])
          (fun _ => "Merged " ++ other ++ " (" ++ short h ++ "):\n" ++
            join "\n" (List.map (fun x => "  " ++ x) changed))
      | MergeResult.conflicts names =>
          Cli.output
            args
            (fun _ => Json.obj [("result", Json.str "conflicts"), ("names", Json.arr (List.map Json.str names))])
            (fun _ => "Conflicts; nothing was merged:\n" ++ join "\n" (List.map (fun x => "  " ++ x) names))
          IO.exit 1
  | _ => Throw.throw "usage: deus merge <branch>"

/-- `deus migrate`: rewrites history so every snapshot is a namespace tree (D72). Causal hashes
  change, so a remote that already holds the old history should be replaced by a new one. -/
def Cli.migrate (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  match Codebase.migrate dir with
  | (nodes, moved) =>
      let remotes := if IO.isDir (dir ++ "/remotes") then IO.listDir (dir ++ "/remotes") else []
      let note := if nodes == 0 || List.isEmpty remotes then "" else " Remotes still hold the old history (" ++ join ", " remotes ++
        "); push to a new remote to replace them."
      Cli.output
        args
        (fun _ => Json.obj [("rewritten", Json.num nodes), ("branches", Json.num moved)])
        (fun _ => "Rewrote " ++ toText nodes ++ " history nodes; moved " ++ toText moved ++ " branches." ++
          note)

--
-- Commands: names.
--
/-- Moves a name and everything under it (`T` moves `T.mk`, `T.field`…). -/
def Cli.mv (args : Args) (keep : Bool) : {IO, Throw Text} Unit :=
  match args.positional with
  | from :: to :: [] =>
      let dir := openCodebase args
      let ns := Codebase.current dir
      let moving := List.filter
        (fun pair => fst pair == from || startsWith (from ++ ".") (fst pair))
        (Map.toList ns)
      if List.isEmpty moving then Throw.throw ("unknown name " ++ from) else
        let renamed := List.map (fun pair => (to ++ Text.drop (Text.length from) (fst pair), snd pair)) moving
        match List.find (fun pair => Map.contains (fst pair) ns) renamed with
        | Option.some (taken, _) => Throw.throw (taken ++ " already exists")
        | Option.none =>
            let without := if keep then ns else foldl (fun m pair => Map.remove (fst pair) m) ns moving
            let ns2 := foldl (fun m pair => Map.insert (fst pair) (snd pair) m) without renamed
            commit dir ns2 ((if keep then "alias " else "move ") ++ from ++ " " ++ to)
            Cli.output
              args
              (fun _ => Json.arr (List.map (fun p => entryJson (fst p) (snd p)) renamed))
              (fun _ => join "\n" (List.map (fun p => "  " ++ fst p) renamed))
  | _ => Throw.throw "usage: deus mv <from> <to>"

/-- A type error's `(calling #<hash prefix>)` with the definition's name, since the checker sees only hashes. -/
def Cli.nameCallee (ns : Map Text Entry) (message : Text) : Text :=
  let marker := " (calling #"
  let found := indexOf message marker 0
  if found < 0 then message else
    let start := found + Text.length marker
    let prefix := Text.slice message start (start + 10)
    match List.find (fun pair => startsWith prefix (Entry.hash (snd pair))) (Map.toList ns) with
    | Option.some (name, _) => Text.take (start - 1) message ++ name ++ Text.drop (start + 10) message
    | Option.none => message

/-- Replaces the hashes in `    at <hash>` lines with names from the codebase, and drops lines for
  definitions the codebase does not name (the toolchain's own handlers). -/
def Cli.nameTrace (index : Map Text Text) (text : Text) : Text := join "\n" (filterMap
  (fun l => if startsWith "    at " l then Option.map (fun name => "    at " ++ name) (Map.lookup (Text.drop 7 l) index) else Option.some l)
  (Text.split text "\n"))

def Cli.names (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let ns := Codebase.current dir
  match Cli.lookupName ns (getOr (head? args.positional) "") with
  | (_, e) =>
      let all := namesOf ns (Entry.hash e)
      Cli.output
        args
        (fun _ => Json.obj [("hash", Json.str (Entry.hash e)), ("names", Json.arr (List.map Json.str all))])
        (fun _ => join "\n" all)

def Cli.openCodebase (args : Args) : {IO, Throw Text} Text :=
  let dir := codebaseDir args
  if isCodebase dir then dir else Throw.throw ("no codebase at " ++ dir ++ " (run `deus init`)")

def Cli.option (args : Args) (key : Text) : Option Text := Map.lookup key args.options

/-- Prints JSON when `--json` is set, otherwise the text. -/
def Cli.output (args : Args) (json : Unit -> Json) (text : Unit -> Text) : {IO} Unit := if Cli.flag args "json" then println (Json.render (json ())) else
  let t := text ()
  if Text.isEmpty t then () else println t

/-- The type a name shows: with other names on its hash, its own signature, since the shared scheme
  generalizes every sharer's (D116, View.Spec R-4); otherwise the scheme. -/
def Cli.ownScheme (meta : Option Sexp) (sharers : Int) : Option Sexp :=
  match (sharers > 1, metaField meta "sig") with
  | (true, Option.some sig) => Option.some (declaredScheme sig)
  | _ => metaField meta "scheme"

def Cli.parseArgs (args : List Text) : Args :=
  let rec go rest pos opts :=
    match rest with
    | [] => Args.mk (reverse pos) opts
    | a :: more => if startsWith "--" a then
        let key := Text.drop 2 a
        if Set.contains key booleanFlags then go more pos (Map.insert key "true" opts) else
          match more with
          | v :: tail => go tail pos (Map.insert key v opts)
          | [] => go more pos (Map.insert key "true" opts)
      else if a == "-o" then
        match more with
        | v :: tail => go tail pos (Map.insert "out" v opts)
        | [] => go more pos opts
      else go more (a :: pos) opts
  go args [] Map.empty

def Cli.parseFiles (paths : List Text) : {IO, Throw Text} List (Text, List Decl) := List.map (fun path => parseFile path (readSource path)) (expandPaths paths)

/-- Who produced a causal node, from its provenance record. -/
def Cli.producedBy (dir : Text) (causal : Text) : {IO} Option Text := Option.bind
  (IO.readFile (dir ++ "/provenance/" ++ causal))
  (fun text => Option.map asText (metaField (Option.some (Sexp.read text)) "by"))

/-- `deus project`: the project's IRI, its libraries, and the size of its subgraph.
  `deus project init <iri>`: names the codebase's project. -/
def Cli.project (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  match args.positional with
  | "init" :: iri :: [] =>
      match Project.read dir with
      | Option.some p => Throw.throw ("this codebase is already the project " ++ p.projectIri)
      | Option.none =>
          Project.write dir (Project.mk iri [])
          Cli.output
            args
            (fun _ => Json.obj [("project", Json.str iri)])
            (fun _ => "Project " ++ iri ++ " (authority " ++ authority iri ++ ").")
  | [] =>
      match Project.read dir with
      | Option.none => Throw.throw "this codebase has no project; run `deus project init <iri>`"
      | Option.some p =>
          let parts := subgraph dir (Codebase.current dir)
          Cli.output
            args
            (fun _ => Json.obj [("project", Json.str p.projectIri), ("authority", Json.str (authority p.projectIri)), ("owned", Json.num (List.length (fst parts))), ("fromLibs", Json.num (List.length (snd parts))), ("libs", Json.arr (List.map
              (fun l => Json.obj [("name", Json.str l.libName), ("iri", Json.str l.libIri), ("release", Json.str l.release)])
              p.libs))])
            (fun _ => join
              "\n"
              ([p.projectIri ++ "  (authority " ++ authority p.projectIri ++ ")", "  owns " ++ toText (List.length (fst parts)) ++ " definitions; " ++
                toText (List.length (snd parts)) ++ " come from libraries"] ++
                List.map
                  (fun l => "  lib." ++ l.libName ++ "  " ++ l.libIri ++ " @ " ++ short l.release)
                  p.libs))
  | _ => Throw.throw "usage: deus project [init <iri>]"

/-- Uploads the explorer in `out` beside a remote's bundles, under `site/`. Files are compared by
  content hash with the last upload, so a republish sends only what changed (`force` sends all).
  Returns (files, uploaded). -/
def Cli.publishSite (dir : Text) (name : Text) (out : Text) (force : Bool) : {IO, Throw Text} (Int, Int) :=
  let manifest := siteManifest dir name
  let previous := if force then Map.empty else Map.fromList (filterMap (fun line =>
    match Text.split line " " with
    | sum :: path :: [] => Option.some (path, sum)
    | _ => Option.none) (Text.lines (getOr (IO.readFile manifest) "")))
  -- Attached files are binary and already on the remote under `assets/`, where the Worker serves them (D82).
  let files := List.filter (fun f => not (startsWith "assets/" f)) (filesUnder out "")
  let sums := List.map (fun f => (f, Text.sha256 (getOr (IO.readFile (out ++ "/" ++ f)) ""))) files
  let changed := List.filter (fun pair => Map.lookup (fst pair) previous != Option.some (snd pair)) sums
  withRemote dir name (fun _ =>
    pushAssets dir
    Remote.writeAll (List.map
      (fun pair => ("site/" ++ fst pair, getOr (IO.readFile (out ++ "/" ++ fst pair)) ""))
      changed))
  IO.writeFile
    manifest
    (Text.concat (List.map (fun pair => snd pair ++ " " ++ fst pair ++ "\n") sums))
  (List.length sums, List.length changed)

/-- `deus pull [remote]`: imports new bundles and moves `<remote>.<branch>` to the remote's heads. -/
def Cli.pull (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let name := remoteName args
  let branches := withRemote dir name (fun _ =>
    let pulled := Replicate.pull dir name
    pullAssets dir
    pulled)
  Cli.output args (fun _ => Json.arr (List.map
    (fun b => Json.obj [("branch", Json.str (fst b)), ("heads", Json.arr (List.map Json.str (snd b)))])
    branches)) (fun _ => join "\n" (List.map (fun b =>
    match b with
    | (branch, h :: []) => name ++ "." ++ branch ++ "  " ++ short h
    | (branch, hs) => name ++ "." ++ branch ++ "  " ++ toText (List.length hs) ++
        " heads (concurrent pushes); merge " ++ name ++ "." ++ branch ++ ".2 to join them") branches))

/-- `deus push [remote] [--branch b]`: uploads one bundle with what the remote lacks. -/
def Cli.push (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let name := remoteName args
  let branch := getOr (option args "branch") (currentBranch dir)
  let pushed := withRemote dir name (fun _ =>
    let bundle := Replicate.push dir name branch
    pushAssets dir
    bundle)
  -- A remote that hosts the explorer (`explore --publish`) gets it refreshed with each push of the current branch;
  -- so does the public explorer of the toolchain, from whichever store pushes to the shared remote.
  let siteOf := fun target =>
    let out := dir ++ "/cache/site-" ++ target
    -- A site published with its console keeps it, on the codebase as pushed (D84).
    if Text.contains " console/codebase.json\n" (getOr (IO.readFile (siteManifest dir target)) "") then console dir out else 0
    Explorer.generate dir out
    snd (publishSite dir target out false)
  let onMain := branch == currentBranch dir && branch == "main"
  let targets := (if IO.exists (siteManifest dir name) then [name] else []) ++
    (if onMain && name != explorerDemo && isToolchainRemote dir name then [explorerDemo] else [])
  let site := if branch == currentBranch dir && not (List.isEmpty targets) then Option.some (sum (List.map siteOf targets)) else Option.none
  let siteJson := getOr (Option.map (fun n => [("site", Json.num n)]) site) []
  let siteText := getOr
    (Option.map (fun n => " Refreshed the explorer (" ++ toText n ++ " files changed).") site)
    ""
  match pushed with
  | Option.some bundle => Cli.output
      args
      (fun _ => Json.obj ([("bundle", Json.str bundle)] ++ siteJson))
      (fun _ => "Pushed " ++ branch ++ " to " ++ name ++ " as " ++ bundle ++ "." ++ siteText)
  | Option.none => Cli.output
      args
      (fun _ => Json.obj ([("bundle", Json.null)] ++ siteJson))
      (fun _ => name ++ " already has " ++ branch ++ "." ++ siteText)

/-- `value`, of type `t`, as Core text (D146). It is walked by its type, since a native build's values
  do not carry their constructors' types: a Bool and an Int are the same words there, and so are the
  nullary constructors of different types. A value whose type it does not know is quoted as it is. -/
def Cli.quoteAt (types : Map Text (Text, Sexp)) (t : Sexp) (value : a) : Text := if t == tref "#Int" then "(int " ++ toText (cast value) ++ ")" else if t == tref "#Text" then "(text " ++ Sexp.print (Sexp.str (cast value)) ++ ")" else if t == tref "#Bool" then "(con \"#Bool\" " ++ toText (tag value) ++ " 0)" else
  match ctorsOf types t with
  | Option.some (hash, ctors) =>
      let tag := tag value
      let fields := getOr (get? ctors tag) []
      let con := "(con " ++ Sexp.print (Sexp.str hash) ++ " " ++ toText tag ++ " " ++
        toText (List.length fields) ++ ")"
      if List.isEmpty fields then con else "(app " ++ con ++
        Text.concat (mapIndexed (fun i f => " " ++ Cli.quoteAt types f (Code.field value i)) fields) ++ ")"
  | Option.none => Code.quote value

def Cli.readSource (path : Text) : {IO, Throw Text} Text :=
  match IO.readFile path with
  | Option.some text => text
  | Option.none => Throw.throw ("cannot read " ++ path)

/-- With `--by <agent>` (and `--prompt <file>`), records who produced a change in the provenance
  layer: the agent, the prompt's SHA-256 and the objects the change wrote. -/
def Cli.recordProvenance (dir : Text) (args : Args) (causal : Text) (objects : List Text) : {IO} Unit :=
  match option args "by" with
  | Option.none => ()
  | Option.some agent =>
      let prompt :=
        match Option.bind (option args "prompt") IO.readFile with
        | Option.some text => [Sexp.node "prompt" [Sexp.str (Text.sha256 text)]]
        | Option.none => []
      let form := Sexp.node
        "provenance"
        ([Sexp.node "by" [Sexp.str agent], Sexp.node "at" [Sexp.str (IO.wallClock ())]] ++ prompt ++
          [Sexp.node "objects" (List.map Sexp.str objects)])
      IO.writeFile (dir ++ "/provenance/" ++ causal) (Sexp.print form ++ "\n")

/-- `deus remote add <name> <dir|r2://bucket/prefix>` / `deus remote`: configure remotes. -/
def Cli.remote (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  match args.positional with
  | "add" :: name :: url :: [] => if not (validBranch name) then Throw.throw ("invalid remote name " ++ name) else
      IO.writeFile (dir ++ "/remotes/" ++ name ++ "/url") (url ++ "\n")
      Cli.output
        args
        (fun _ => Json.obj [("remote", Json.str name), ("url", Json.str url)])
        (fun _ => "Added remote " ++ name ++ " = " ++ url ++ ".")
  | [] =>
      let names := if IO.isDir (dir ++ "/remotes") then IO.listDir (dir ++ "/remotes") else []
      let urls := List.map
        (fun n => (n, trim (getOr (IO.readFile (dir ++ "/remotes/" ++ n ++ "/url")) "")))
        names
      Cli.output
        args
        (fun _ => Json.arr (List.map (fun p => Json.obj [("remote", Json.str (fst p)), ("url", Json.str (snd p))]) urls))
        (fun _ => join "\n" (List.map (fun p => fst p ++ "  " ++ snd p) urls))
  | _ => Throw.throw "usage: deus remote [add <name> <dir|r2://bucket/prefix>]"

def Cli.remoteName (args : Args) : Text := getOr (head? args.positional) "origin"

def Cli.rm (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let ns := Codebase.current dir
  let ns2 := foldl
    (fun m name => if Map.contains name m then Map.remove name m else Throw.throw ("unknown name " ++ name))
    ns
    args.positional
  commit dir ns2 ("delete " ++ join " " args.positional)
  Cli.output
    args
    (fun _ => Json.arr (List.map Json.str args.positional))
    (fun _ => "Deleted " ++ join ", " args.positional ++ ".")

/-- `deus run <name> [args…]`: runs `name ()` with `IO.args` answering the remaining arguments.
  Telemetry goes to stderr as JSON lines, or as OTLP/JSON files under `$DEUS_OTLP`. -/
def Cli.run (args : Args) (rest : List Text) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let ns := Codebase.current dir
  match rest with
  | [] => Throw.throw "usage: deus run <name> [args…]"
  | name :: programArgs =>
      match Cli.lookupName ns name with
      | (_, Entry.term h) =>
          ensureArtifacts dir [h]
          Image.load (fetcher dir) [h]
          let f := Code.run h
          -- External artifacts are cached in the codebase's cache layer, by hash.
          let program := fun u => docker (fun _ => fetching (dir ++ "/cache/fetch") (fun _ =>
            handle f () with
            | IO.args x2 -> k => k programArgs))
          let observed := fun u =>
            match IO.getEnv "DEUS_OTLP" with
            | Option.some out => otlp out name program
            | Option.none => ndjson program
          handle observed () with
          | Defect.raise message -> x3 =>
              IO.eprint ("defect: " ++ nameTrace (nameIndex ns) (message ++ Cli.defectTrace ()) ++ "\n")
              IO.exit 70
      | _ => Throw.throw (name ++ " is not a term")

/-- `deus serve <handler> [--port n]`: serves a web handler on this machine (D57). The server is
  built into the artifacts layer by the hash of its image, so serving unchanged code starts at
  once. It runs until stopped. -/
def Cli.serve (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let ns := Codebase.current dir
  match Cli.lookupName ns (getOr (head? args.positional) "") with
  | (_, Entry.term h) =>
      ensureArtifacts dir [h]
      let image := Image.build (fetcher dir) h
      let out := dir ++ "/artifacts/server-" ++ Text.sha256 image
      let built := if IO.exists out then Result.ok () else try (fun _ =>
        IO.mkdirp (dir ++ "/artifacts")
        server image out)
      match built with
      | Result.err f => Throw.throw (Failure.render f)
      | Result.ok _ =>
          let port := getOr (option args "port") "8080"
          IO.eprint ("serving " ++ getOr (head? args.positional) "" ++ " on http://127.0.0.1:" ++ port ++ "\n")
          match IO.exec "env" ["PORT=" ++ port, out] with
          | (code, out2, err) =>
              IO.print out2
              IO.eprint err
              if code == 0 then () else IO.exit code
  | _ => Throw.throw "usage: deus serve <handler> [--port n]"

def Cli.short (h : Text) : Text := if startsWith "#" h then h else "#" ++ Text.take 10 h

/-- The image of the static-site handler (`platform/site.deus`), compiled from the toolchain's sources. -/
def Cli.siteImage (u : Unit) : {IO, Throw Text} Text :=
  let home :=
    match IO.getEnv "DEUS_HOME" with
    | Option.some h => h
    | Option.none => Throw.throw "$DEUS_HOME is not set; run deus through bin/deus.mjs"
  let files := List.map
    (fun f => home ++ "/" ++ f)
    ["deus/builtins.deus", "deus/prelude.deus", "platform/web.deus", "platform/site.deus"]
  let result := batch Map.empty (fun _ => Option.none) (fun _ => Option.none) (checkTypes ()) (parseFiles files)
  match List.lookup "Site.serve" result.entries with
  | Option.some (Entry.term h) =>
      let objects := Map.fromList result.objects
      Image.build (fun x => Map.lookup x objects) h
  | _ => Throw.throw "platform/site.deus has no Site.serve"

/-- Where `--publish` records what it uploaded to a remote; its presence means the remote hosts a site. -/
def Cli.siteManifest (dir : Text) (name : Text) : Text := dir ++ "/cache/site-" ++ name ++ ".sums"

/-- The identified ```mdl blocks of `.mdl` files, stored as spec objects and named
  `<document>.<block id>`; the document is its frontmatter `name`, or the file's base name.
  The document's prose is kept in each block's metadata (D99): its order, the text before it,
  and on the first block the frontmatter and on the last the text after it, so the codebase holds
  the whole document and the export writes it back. -/
def Cli.specEntries (dir : Text) (paths : List Text) : {IO, Throw Text} List (Text, Entry) := concatMap (fun path => if not (endsWith ".mdl" path) then [] else
  let text := readSource path
  let doc := Mdl.parse text
  let prefix := getOr (List.lookup "name" doc.front) (Cli.baseName path)
  let declared := Mdl.declared doc
  let blocks := List.filter stored doc.blocks
  let last := List.length blocks - 1
  match prose text with
  | (leads, tail) => mapIndexed (fun i b =>
      let uri := getOr (List.lookup b.blockType declared) ""
      let h := Codebase.put dir (Mdl.toSexp uri b)
      let front := if i == 0 then [Sexp.node
        "front"
        (List.map (fun kv => Sexp.list [Sexp.str (fst kv), Sexp.str (snd kv)]) doc.front)] else []
      let after := if i == last && not (Text.isEmpty tail) then [Sexp.node "tail" [Sexp.str tail]] else []
      writeMeta dir h (Sexp.node
        "meta"
        ([Sexp.node "document" [Sexp.str prefix], Sexp.node "order" [Sexp.int i], Sexp.node "lead" [Sexp.str (getOr (get? leads i) "")]] ++
          front ++
          after))
      (prefix ++ "." ++ b.blockId, Entry.spec h)) blocks) (expandPaths paths)

/-- A comment's subject from what a command was given: a definition's name, `change:<causal>`, or `def:<name>`. -/
def Cli.subjectOf (dir : Text) (given : Text) : {IO, Throw Text} Text := if startsWith "change:" given then
  let h := Text.drop 7 given
  match List.filter (fun c => startsWith h (fst c)) (Codebase.history dir (currentBranch dir) 100000) with
  | c :: _ => Comments.change (fst c)
  | [] => Throw.throw ("no change " ++ h ++ " on this branch")
else
  match Cli.lookupName
    (Codebase.current dir)
    (if startsWith "def:" given then Text.drop 4 given else given) with
  | (full, _) => Comments.definition full

def Cli.switch (args : Args) : {IO, Throw Text} Unit :=
  match args.positional with
  | name :: [] =>
      let dir := openCodebase args
      headOf dir name
      IO.writeFile (dir ++ "/HEAD") (name ++ "\n")
      Cli.output
        args
        (fun _ => Json.obj [("branch", Json.str name)])
        (fun _ => "Switched to branch " ++ name ++ ".")
  | _ => Throw.throw "usage: deus switch <branch>"

/-- `deus task …` (D59): issues kept in the codebase, attached to definitions and changes.
  `new <title…>`, `list` (open tasks; `--all`, `--state s`, `--label l`, `--about <name>`),
  `show <id>`, `set <id> --state doing …`, `comment <id> <text…>`, `link <id> <name>|--change <causal>`
  and `unlink <id> <name>`. `deus update … --closes <id>` closes a task with the change that fixed it. -/
def Cli.task (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let author := getOr (option args "by") (getOr (IO.getEnv "USER") "someone")
  let tasks := Tasks.current dir
  let saved := fun t message =>
    -- `--by` names who made the change, as it does for `update`, so history shows task work too.
    recordProvenance dir args (save dir [t] message) []
    Cli.output args (fun _ => Cli.taskJson t) (fun _ => taskLine t)
  match args.positional with
  | "new" :: words =>
      let title := join " " words
      if Text.isEmpty title then Throw.throw "usage: deus task new <title…>" else
        let t := applyFields args tasks (blank (freshId dir title author) title)
        let linked :=
          match option args "link" with
          | Option.some name =>
              match Cli.lookupName (Codebase.current dir) name with
              | (full, e) => link t (Attachment.definition full (Entry.hash e))
          | Option.none => t
        let attached :=
          match attachments dir args with
          | [] => linked
          | assets => Tasks.comment linked (Comment.mk author "" (IO.wallClock ()) assets)
        saved attached ("task: open " ++ t.id ++ " " ++ title)
  | [] => Cli.task (Args.mk ["list"] args.options)
  | "list" :: [] =>
      let about := Option.map (fun name =>
        match Cli.lookupName (Codebase.current dir) name with
        | (full, e) => Set.fromList (List.map (fun t => t.id) (about tasks full (Entry.hash e)))) (option args "about")
      let keep := fun t =>
        let byState :=
          match option args "state" with
          | Option.some s => stateText t.state == s
          | Option.none => Cli.flag args "all" || isOpen t
        let byLabel :=
          match option args "label" with
          | Option.some l => any (fun x => x == l) t.labels
          | Option.none => true
        let byLink :=
          match about with
          | Option.some ids => Set.contains t.id ids
          | Option.none => true
        byState && byLabel && byLink
      let rows := sortBy order (List.filter keep (Map.values tasks))
      Cli.output
        args
        (fun _ => Json.arr (List.map Cli.taskJson rows))
        (fun _ => if List.isEmpty rows then "No tasks." else join "\n" (List.map taskLine rows))
  | "show" :: id :: [] =>
      let t := Tasks.find tasks id
      let ns := Codebase.current dir
      let links := List.map (linkReport dir ns) t.links
      let history := historyOf dir t.id 200
      let children := List.filter (fun c => c.parent == t.id) (Map.values tasks)
      Cli.output
        args
        (fun _ => Json.obj [("task", Cli.taskJson t), ("links", Json.arr (List.map fst links)), ("history", Json.arr (List.map (Cli.changeJson dir) history)), ("children", Json.arr (List.map Cli.taskJson children))])
        (fun _ =>
          let head := [t.id ++ "  " ++ t.title, stateText t.state ++ " · " ++ priorityText t.priority ++
            (if Text.isEmpty t.assignee then "" else " · @" ++ t.assignee) ++ (if List.isEmpty t.labels then "" else " · " ++ join ", " t.labels) ++ (if Text.isEmpty t.parent then "" else " · parent " ++ t.parent)]
          let section := fun title lines => if List.isEmpty lines then [] else ["", title] ++ lines
          join "\n" (head ++ (if Text.isEmpty t.details then [] else ["", t.details]) ++
            section "Links" (concatMap snd links) ++ section "Subtasks" (List.map (fun c => "  " ++ taskLine c) children) ++ section "Comments" (List.map commentLine t.comments) ++ section "History" (List.map (changeLine dir) history)))
  | "set" :: id :: [] =>
      -- Options every command takes; any other name is a misspelt field, which would otherwise set nothing.
      let unknown := List.filter
        (fun key => not (List.contains key (Tasks.fields ++ ["codebase", "by", "json", "quiet"])))
        (Map.keys args.options)
      if not (List.isEmpty unknown) then Throw.throw ("unknown task field " ++ join ", " unknown ++ "; the fields are " ++ join ", " Tasks.fields) else
        let t := applyFields args tasks (Tasks.find tasks id)
        saved t ("task: set " ++ t.id ++ " " ++
          join " " (List.filter (fun f => Cli.flag args f) Tasks.fields))
  | "comment" :: id :: words =>
      let t := Tasks.find tasks id
      saved
        (Tasks.comment
          t
          (Comment.mk author (join " " words) (IO.wallClock ()) (attachments dir args)))
        ("task: comment on " ++ t.id)
  | "link" :: id :: [] =>
      let t := Tasks.find tasks id
      match option args "change" with
      | Option.some h =>
          let full :=
            match List.filter
              (fun c => startsWith h (fst c))
              (Codebase.history dir (currentBranch dir) 100000) with
            | c :: _ => fst c
            | [] => Throw.throw ("no change " ++ h ++ " on this branch")
          saved (link t (Attachment.change full)) ("task: link " ++ t.id ++ " to " ++ short full)
      | Option.none => Throw.throw "usage: deus task link <id> <name> | --change <causal>"
  | "link" :: id :: name :: [] =>
      let t := Tasks.find tasks id
      match Cli.lookupName (Codebase.current dir) name with
      | (full, e) => saved
          (link t (Attachment.definition full (Entry.hash e)))
          ("task: link " ++ t.id ++ " to " ++ full)
  | "unlink" :: id :: name :: [] =>
      let t := Tasks.find tasks id
      saved (unlink t name) ("task: unlink " ++ t.id ++ " from " ++ name)
  | "import" :: path :: [] =>
      let n := importTasks dir path
      Cli.output
        args
        (fun _ => Json.obj [("imported", Json.num n)])
        (fun _ => "Imported " ++ toText n ++ " tasks.")
  | _ => Throw.throw "usage: deus task [new <title…> | list | show <id> | set <id> --<field> v | comment <id> <text…> | link <id> <name> | unlink <id> <name>]"

def Cli.taskJson (t : Task) : Json := Json.obj [("id", Json.str t.id), ("title", Json.str t.title), ("state", Json.str (stateText t.state)), ("priority", Json.num t.priority), ("assignee", Json.str t.assignee), ("labels", Json.arr (List.map Json.str t.labels)), ("parent", Json.str t.parent), ("details", Json.str t.details), ("links", Json.arr (List.map attachmentJson t.links)), ("comments", Json.arr (List.map commentJson t.comments))]

def Cli.taskLine (t : Task) : Text :=
  let labels := if List.isEmpty t.labels then "" else "  [" ++ join ", " t.labels ++ "]"
  let assignee := if Text.isEmpty t.assignee then "" else "  @" ++ t.assignee
  let pad := fun n x => x ++ repeat (n - Text.length x) " "
  t.id ++ "  " ++ pad 8 (stateText t.state) ++ " " ++ pad 6 (priorityText t.priority) ++ " " ++
    t.title ++ labels ++ assignee

def Cli.toolchainIri : Text := "https://dxos.org/deus/toolchain"

def Cli.toolchainRemote : Text := "r2://agent-artifacts/deus/toolchain"

/-- Moves the branch back to its first parent; the undone node stays in the store. -/
def Cli.undo (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let branchName := currentBranch dir
  let head := headOf dir branchName
  match (readCausal dir head).parents with
  | parent :: _ =>
      setBranch dir branchName parent
      Cli.output
        args
        (fun _ => Json.obj [("causal", Json.str parent)])
        (fun _ => "Undid " ++ short head ++ "; now at " ++ short parent ++ ".")
  | [] => Throw.throw "nothing to undo"

def Cli.usage : Text := join
  "\n"
  ["usage: deus <command> [args] [--json] [--codebase <dir>]", "", "codebase", "  init [--empty]                       create a codebase with the builtins and prelude (~/.deus, $DEUS_CODEBASE or --codebase)", "  add <files|dirs…>                    add new definitions (.deus, or ```deus fences in .mdl)", "  update <files|dirs…>                 add or replace definitions; dependents are rehashed", "                                       (both take --message <why> for the history, and", "                                       --by <agent> [--prompt <file>] to record provenance)", "  ls [prefix]                          list names", "  find <text>                          names containing text", "  view <name|#hash…> [--core]          print definitions as source (or as Core)", "       [--dialect deus|ts]              … in DEUS (default) or TypeScript-like syntax", "  names <name|#hash>                   every name of a hash", "  deps <name> / dependents <name>      what a definition uses / what uses it", "  mv <from> <to> / alias <name> <new>  rename (with everything under it) / add a name", "  rm <names…>                          remove names", "", "history", "  branch [name]                        list branches, or create one and switch to it", "  switch <branch>                      change branch", "  merge <branch>                       three-way merge into the current branch", "  log [--n N] / undo                   history / step the branch back", "  history import <history.sexp>        keep an export's history under a restored codebase", "  layers                               objects per layer (code, tests, proofs, history, results, …)", "  migrate                              rewrite history with namespace-tree snapshots", "", "analytics (events about the codebase, in @[event] structures; push-only, D104)", "  event types                          event types with their columns and counts", "  event record <Type> field=value…     record an event (a ref field takes a name, an IRI or #hash)", "  event import <file>                  record (event \"Type\" (field value)…) forms", "  event backfill history|timeline <f>  AgentChange events from history.sexp, AgentStage from TIMELINE.md", "  event list [Type] [--about name]     the latest events, of a type or about a definition", "  event stats                          counts per type and per definition (--json: the explorer's events.json)", "  event push [remote]                  write pending events to the remote as Parquet; never pulls", "", "projects", "  project [init <iri>]                 the project's IRI, libraries and owned subgraph", "  lib install <name> <codebase>        mount that project's head under lib.<name> (--branch b)", "", "replication", "  remote add <name> <dir|r2://b/p>     a remote: a directory, or an R2 bucket and prefix", "  push [remote] [--branch b]           upload one immutable bundle of what the remote lacks", "  pull [remote]                        import new bundles; <remote>.<branch> tracks its heads", "  compact [remote] [--level k]         sedimentree compaction into level-k strata", "  inbox [remote]                       apply comments and tasks members filed in the hosted explorer", "", "running", "  run [--codebase c] <name> [args…]    run name () with IO.args = args (options go before the name)", "  eval <expr>                          evaluate an expression; it may use Workspace.names, .view,", "                                       .update and .run to read and change the codebase", "  artifact <constant> [--out file]     evaluate an @[artifact] constant once and keep its value by hash;", "                                       run, image, build and serve then use the kept value", "  embed <file> --as <Name> [--bytes]   keep a file in the asset store and define Name as its text (or, with", "                                       --bytes, its bytes): an @[artifact] that names only the file's SHA-256", "  mdl [files|dirs…]                    check .mdl documents (or the codebase's specs): each block runs through the", "                                       @[ext \"<uri>\"] term its Extensions table names", "  mdl --coverage [documents…]          what specs leave unstated: laws no block cites, public definitions no api names (D125)", "  features [documents…]                feature maps: each feature's status, open tasks, and what is missing (D118)", "  test [prefix] [--integration]        run tests in a deterministic simulation (cached by hash);", "                                       --integration also runs @[integration] tests for real", "  check [prefix]                       check theorems and report their evidence", "  image <name> -o <file>               write a kernel image", "  build <name> -o <file> [--native]    write a standalone executable that runs name ()", "                                       (--native: Rust kernel + image, ~1 MB; default: Node SEA)", "  build <actor> -o <dir> --worker      write a Cloudflare Worker serving the actor from a Durable Object", "  build <name> -o <dir> --browser      write a static web page that runs name in the browser on the wasm kernel", "  build <handler> -o <file> --server   write a standalone native web server for a handler", "  serve <handler> [--port n]           serve a web handler locally (storage in ./deus-data)", "  explore [--out d|--port n|--publish r|--console]  the codebase explorer: write, serve, or host it on a remote", "", "tasks", "  task new <title…> [--priority p --labels a,b --assignee a --parent id --details d --link name]", "  task [list] [--all|--state s|--label l|--about name]   open tasks, most urgent first", "  task show <id>                       a task, what it links (and how that changed since), its history", "  task set <id> --state doing|done|canceled …   change fields (title, state, priority, assignee, labels, parent, details)", "  task comment <id> <text…>            add a comment (--by <agent>; --attach <file> adds an image)", "  comment <name|change:h> <text…>      comment on a definition or a change (--by, --attach <file>)", "  comments [<name|change:h>]           comments on one subject, or every subject with comments", "  comments import <comments.sexp>      restore comments from an export", "  asset add <file>                     store a file in the codebase's asset store; prints its SHA-256", "  task link <id> <name>|--change <h>   attach a definition or a change; unlink <id> <name> detaches", "  update <files…> --closes <id>        mark a task done, linked to the change that fixed it", "  task import <tasks.sexp>             restore tasks from an export", "  export <dir>                         the codebase as text for git: code/<Namespace>.deus, tasks, history", "  build <name…> -o <file.js> --js      compile to an ES module with a source map, no kernel (D97)", "  build <fn> -o <file.wasm> --wasm     compile a first-order function on Int, Bool and data (and its callees) to wasm", "  build <fn> -o <file> --c             the same subset to C, compiled to an executable by $CC (default cc); -o x.c writes the source", "  bindings <prefix|name…> -o <dir>     a JS module + .d.ts that calls those functions on the wasm kernel", "  compile <files|dirs…> --main <name>  compile files without a codebase", ""]

/-- `acc` with each name `h`'s object refers to that lies outside `name`'s namespace. -/
def Cli.usedOutside (dir : Text) (byHash : Map Text (List Text)) (name : Text) (h : Text) (acc : Map Text Unit) : {IO, Throw Text} Map Text Unit :=
  let home := Coverage.namespaceOf name
  match readObject dir h with
  | Option.none => acc
  | Option.some form => foldl (fun marked dep => foldl
      (fun m target => if Coverage.namespaceOf target == home then m else Set.insert target m)
      marked
      (getOr (Map.lookup dep byHash) [])) acc (Codebase.dependencies form)

def Cli.view (args : Args) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let ns := Codebase.current dir
  -- One printer for all entries: its name tables cost more to build than printing one definition.
  let printer := Print.printer ns []
  let dialect := if Cli.flag args "core" then "core" else getOr (option args "dialect") "deus"
  if dialect == "deus" || dialect == "ts" || dialect == "core" then () else Throw.throw ("unknown dialect " ++ dialect ++ "; expected deus or ts")
  -- A spec document's name prints the whole document from its blocks (D99).
  let documents := specDocuments ns
  -- (name, kind, hash, text); a document has no hash.
  let shownFor := fun name => if not (Map.contains name ns) && List.contains name documents then (name, "document", "", document dir ns name) else
    match Cli.lookupName ns name with
    | (full, e) => (full, Entry.kind e, Entry.hash e, viewEntryIn printer dir ns full e dialect)
  let views := List.map shownFor args.positional
  let shown := join "\n\n" (List.map (fun v =>
    match v with
    | (_, kind, _, text) => if kind == "document" then text else forTerminalIn dialect text) views)
  Cli.output args (fun _ => Json.arr (List.map (fun v =>
    match v with
    | (name, kind, h, text) => Json.obj ([("name", Json.str name), ("kind", Json.str kind)] ++
        (if Text.isEmpty h then [] else [("hash", Json.str h)]) ++ [("source", Json.str text)])) views)) (fun _ => shown)

/-- Source text of one entry (a definition, a type, an ability). -/
def Cli.viewEntry (dir : Text) (ns : Map Text Entry) (name : Text) (e : Entry) (core : Bool) : {IO, Throw Text} Text := viewEntryWith (Print.printer ns []) dir ns name e core

/-- One entry in a dialect (D70): `deus` (the primary syntax), `ts` (TypeScript-like) or `core`. -/
def Cli.viewEntryIn (base : Printer) (dir : Text) (ns : Map Text Entry) (name : Text) (e : Entry) (dialect : Text) : {IO, Throw Text} Text :=
  match viewParts base dir ns name e dialect with
  | (header, source) => header ++ source

/-- `viewEntry` with a printer whose name tables are already built (one per namespace, not per entry). -/
def Cli.viewEntryWith (base : Printer) (dir : Text) (ns : Map Text Entry) (name : Text) (e : Entry) (core : Bool) : {IO, Throw Text} Text := viewEntryIn base dir ns name e (if core then "core" else "deus")

/-- The header comment lines, and the source (empty for a constructor, an operation or a field). -/
def Cli.viewParts (base : Printer) (dir : Text) (ns : Map Text Entry) (name : Text) (e : Entry) (dialect : Text) : {IO, Throw Text} (Text, Text) :=
  let core := dialect == "core"
  let ts := dialect == "ts"
  let h := Entry.hash e
  let meta := Option.map (metaFor name) (readMeta dir h)
  let comment := if ts then "// " else "-- "
  let typeLine :=
    match ownScheme meta (List.length (getOr (Map.lookup h base.namesByHash) [])) with
    | Option.some scheme => comment ++ ": " ++ displaySchemeNamed base.declared scheme ++ "\n"
    | Option.none => ""
  let header := comment ++ name ++ " " ++ short h ++ "\n" ++ typeLine
  match e with
  | Entry.ctor _ _ _ => (header ++ comment ++ "a constructor of " ++ join ", " (getOr (Map.lookup h base.namesByHash) []), "")
  | Entry.op _ _ _ => (header ++ comment ++ "an operation of " ++ join ", " (getOr (Map.lookup h base.namesByHash) []), "")
  | _ =>
      -- A field accessor comes with its structure, so it prints as a note, as constructors do.
      let owner := join "." (List.take (List.length (Text.split name ".") - 1) (Text.split name "."))
      let isField :=
        match Map.lookup owner ns with
        | Option.some (Entry.type _ _ fields) => List.contains (lastSegment name) fields
        | _ => false
      if isField then (header ++ comment ++ "a field of structure " ++ owner, "") else
        match readObject dir h with
        | Option.none => if startsWith "#" h then (header ++ comment ++ "builtin", "") else Throw.throw ("missing object " ++ h)
        | Option.some obj => if core then (header, Sexp.print obj) else
            let locals := List.map asText (metaList meta "locals")
            let p := withSelf (withLocals base locals) h name
            let doc := Option.map asText (metaField meta "doc")
            let display := lastSegment name
            if ts then (header, match obj with
            | Sexp.list (Sexp.sym "term" :: c :: []) => Ts.definition p name c (metaField meta "sig") doc
            | Sexp.list (Sexp.sym "test" :: c :: []) => testDecl p name c
            | Sexp.list (Sexp.sym "theorem" :: Sexp.list (Sexp.sym "binders" :: types) :: prop :: proof :: _) => Ts.theoremDecl p name types prop proof
            | Sexp.list (Sexp.sym "type" :: _) => Ts.typeDecl p ns name e obj meta
            | Sexp.list (Sexp.sym "ability" :: _) => Ts.abilityDecl p ns name e obj meta
            | Sexp.list (Sexp.sym "spec" :: _) => Mdl.render (snd (Mdl.fromSexp obj))
            | _ => Sexp.print obj) else
              -- Comments come back from metadata: the lead above the declaration, notes inside it (D66).
              let lead :=
                match metaField meta "lead" with
                | Option.some text => commentLines (asText text) 0
                | Option.none => ""
              let notes := notesOf meta
              let spellings := spellingsOf meta
              -- Doc comment and attributes go above every kind of declaration, as the parser reads them.
              let docText :=
                match doc with
                | Option.some d => "/-- " ++ d ++ " -/\n"
                | Option.none => ""
              let attrs := List.map (fun a =>
                match Sexp.asList a with
                | key :: values => asText key ++ Text.concat (List.map (fun v => " " ++ quoteText (asText v)) values)
                | [] => "") (metaList meta "attrs")
              let attrText := if List.isEmpty attrs then "" else "@[" ++ join ", " attrs ++ "]\n"
              (header, lead ++ docText ++ attrText ++ (match obj with
              | Sexp.list (Sexp.sym "term" :: c :: []) => Print.definition
                  p
                  name
                  (restore notes spellings c)
                  (metaField meta "sig")
                  Option.none
              | Sexp.list (Sexp.sym "test" :: c :: []) => "test " ++ name ++ " :=" ++ Print.body p (restore notes spellings c) [] 0
              | Sexp.list (Sexp.sym "theorem" :: Sexp.list (Sexp.sym "binders" :: types) :: prop :: proof :: _) => View.theoremDecl p name types prop proof
              | Sexp.list (Sexp.sym "type" :: _) => View.typeDecl p ns name e obj meta
              | Sexp.list (Sexp.sym "ability" :: _) => View.abilityDecl p ns name e obj meta
              | Sexp.list (Sexp.sym "spec" :: _) => Mdl.render (snd (Mdl.fromSexp obj))
              | _ => Sexp.print obj))

def Cli.warn (b : Batch) : {IO} Unit := forEach b.warnings (fun w => eprintln ("warning: " ++ w))

/-- Answers `MdlHost` against the codebase: expressions are compiled the way `eval` compiles them.
  `facts` are `ns`'s, built once per run: its name tables cost more than describing a name. -/
def Cli.withHost (dir : Text) (ns : Map Text Entry) (facts : MdlFacts) (body : Unit -> {MdlHost, IO} a) : {IO} a :=
  let tasks := Ref.new Option.none
  let compiled := fun source => try (fun _ => compileExpr dir ns source)
  handle body () with
  | MdlHost.cost source -> k => k (match compiled ("fun (u : Unit) => " ++ source) with
    | Result.ok h => guardDefect (fun _ => Code.cost (Code.run h))
    | Result.err message => Result.err message)
  | MdlHost.holds source -> k => k (match compiled source with
    | Result.ok h => guardDefect (fun _ => Code.run h)
    | Result.err message => Result.err message)
  | MdlHost.run source -> k => k (match compiled source with
    | Result.ok h => guardDefect (fun _ => Code.run h)
    | Result.err message => Result.err message)
  | MdlHost.js source -> k => k (jsCompare dir ns source)
  | MdlHost.describe name -> k => k (match featureFact dir facts.documents tasks name with
    | Option.some answer => answer
    | Option.none =>
        match guardDefect (fun _ => try (fun _ => describeName dir ns facts name)) with
        | Result.ok r => r
        | Result.err message => Result.err message)

/-- Runs `body` against the remote `name`: a directory, or `r2://<bucket>/<prefix>` (an
  S3-compatible bucket at `$DEUS_R2_ENDPOINT`, by default the DXOS account's, with `$R2_ACCESS_KEY_ID`
  and `$R2_SECRET_ACCESS_KEY`). -/
def Cli.withRemote (dir : Text) (name : Text) (body : Unit -> {Remote, IO, Throw Text} a) : {IO, Throw Text} a :=
  let url :=
    match IO.readFile (dir ++ "/remotes/" ++ name ++ "/url") with
    | Option.some text => trim text
    | Option.none =>
        match defaultRemote dir name with
        | Option.some known => known
        | Option.none => Throw.throw ("no remote " ++ name ++ "; run `deus remote add " ++ name ++ " <dir|r2://bucket/prefix>`")
  if startsWith "r2://" url then
    let path := Text.drop 5 url
    let slash := indexOf path "/" 0
    let bucketName := if slash < 0 then path else Text.take slash path
    let prefix := if slash < 0 then "deus" else Text.drop (slash + 1) path
    let need := fun key =>
      match IO.getEnv key with
      | Option.some value => value
      | Option.none => Throw.throw ("$" ++ key ++ " is not set")
    let endpoint := getOr (IO.getEnv "DEUS_R2_ENDPOINT") defaultEndpoint
    let user := need "R2_ACCESS_KEY_ID" ++ ":" ++ need "R2_SECRET_ACCESS_KEY"
    -- The file is made private before the secret is written to it.
    let config := dir ++ "/cache/remote-" ++ name ++ ".curl"
    IO.mkdirp (dir ++ "/cache")
    IO.exec "install" ["-m", "600", "/dev/null", config]
    IO.writeFile config ("user = \"" ++ user ++ "\"\n")
    let result := try (fun _ => bucket endpoint bucketName prefix config body)
    IO.remove config
    match result with
    | Result.ok value => value
    | Result.err message => Throw.throw message
  else directory url body

/-- Runs `body` with `Workspace` handled against `dir`; `passed` goes to every command it runs. -/
def Cli.withWorkspace (dir : Text) (passed : List Text) (body : Unit -> {Workspace, IO, Throw Text} a) : {IO, Throw Text} a :=
  handle body () with
  | Workspace.names prefix -> k => k (List.filter (fun name => startsWith prefix name) (Map.keys (Codebase.current dir)))
  | Workspace.view name -> k =>
      let ns := Codebase.current dir
      k (match Cli.lookupName ns name with
      | (full, e) => viewEntryIn (Print.printer ns []) dir ns full e "deus")
  | Workspace.update source -> k =>
      -- The source goes through a file, as `deus update` reads one.
      IO.mkdirp (dir ++ "/tmp")
      let path := dir ++ "/tmp/workspace-" ++ Text.take 16 (Text.sha256 source) ++ ".deus"
      IO.writeFile path source
      addOrUpdate (parseArgs ([path, "--quiet"] ++ passed)) true
      IO.remove path
      k ()
  | Workspace.run argv -> k =>
      dispatch (argv ++ passed)
      k ()

/-- Writes the JS module of `roots` (export name, hash) to `out` (D97), its source map to
  `<out>.map`, and the runtime beside it as `deus-runtime.mjs`. -/
def Cli.writeJs (dir : Text) (ns : Map Text Entry) (fetch : Text -> {IO} Option Sexp) (meta : Text -> {IO} Option Sexp) (roots : List (Text, Text)) (out : Text) : {IO, Throw Text} Unit :=
  let printer := Print.printer ns []
  let jsImport :=
    match Map.lookup "Js.import" ns with
    | Option.some (Entry.term h) => h
    | _ => ""
  let parts := Text.split out "/"
  let folder := if List.length parts < 2 then "." else join "/" (List.take (List.length parts - 1) parts)
  let base := getOr (last? parts) out
  let home :=
    match IO.getEnv "DEUS_HOME" with
    | Option.some h => h
    | Option.none => Throw.throw "$DEUS_HOME is not set; run deus through bin/deus.mjs"
  let runtime :=
    match IO.readFile (home ++ "/platform/js/runtime.mjs") with
    | Option.some text => text
    | Option.none => Throw.throw ("cannot read " ++ home ++ "/platform/js/runtime.mjs")
  -- Wrapped: a closed-row function where `{Throw Text | r}` is expected hangs the checker (task in TASKS.md).
  match JsGen.compile
    (fun h => fetch h)
    (fun h => meta h)
    (fun h name => sourceOf printer dir ns name (Entry.term h))
    ns
    jsImport
    roots
    "./deus-runtime.mjs"
    (base ++ ".map") with
  | (code, map) =>
      IO.writeFile out code
      IO.writeFile (out ++ ".map") map
      IO.writeFile (folder ++ "/deus-runtime.mjs") runtime
