test Tally.alarmsFireInOrder :=
  match simulateMany
    Tally.serve
    [("b", Request.mk "POST" "/remind" ""), ("a", Request.mk "POST" "/remind" "")] with
  | (_, stores, fired) => fired == [("a", 1000), ("b", 1000)] && Option.bind (Map.lookup "a" stores) (fun m => Map.lookup "reminded" m) == Option.some "yes"

def Tally.bump (key : Text) : {Storage} Int :=
  let next := 1 + getOr (Option.bind (Storage.get key) fromText) 0
  Storage.put key (toText next)
  next

test Tally.objectsCallEachOther :=
  let add := Request.mk "POST" "/add" ""
  match simulateMany Tally.serve [("a", add), ("b", add), ("a", add)] with
  | (responses, stores, _) => List.map (fun r => r.content) responses ==
      ["count 1, total 1", "count 1, total 2", "count 2, total 3"] && Option.bind (Map.lookup "total" stores) (fun m => Map.lookup "count" m) == Option.some "3"

def Tally.serve (request : Request) : {Storage, Actors, Alarm} Response := if request.url == "/add" then
  let mine := Tally.bump "count"
  let total := Actors.call "total" (Request.mk "POST" "/add-total" "")
  Web.ok ("count " ++ toText mine ++ ", " ++ total.content)
else if request.url == "/add-total" then Web.ok ("total " ++ toText (Tally.bump "count")) else if request.url == "/remind" then
  Alarm.set 1000
  Web.ok "reminder set"
else if request.url == "/reminded" then Web.ok (getOr (Storage.get "reminded") "no") else if request.verb == "ALARM" then
  Storage.put "reminded" "yes"
  Web.ok "reminded"
else notFound request.url
