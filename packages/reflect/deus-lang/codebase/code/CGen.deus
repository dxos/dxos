/-- What the compiler knows while compiling one function: its index, its arity and its label counter. -/
structure CGen.FnCtx @"urn:deus:cgen:FnCtx" where
  cScope : Wasm.Scope
  cSelf : Int
  cArity : Int
  cNext : Ref Int

def CGen.args (xs : List Text) : Text := "(" ++ join ", " xs ++ ")"

/-- The index and definition of the function `h`. -/
def CGen.callee (ctx : FnCtx) (h : Text) (argc : Int) : {Throw Text} (Int, Fn) :=
  match List.find (fun f => f.fnHash == h) (ctx.cScope).fns with
  | Option.some f => if f.fnArity != argc then Throw.throw ("#" ++ Text.take 10 h ++ " takes " ++ toText f.fnArity ++ " arguments but is applied to " ++
      toText argc ++ "; partial application is outside the C subset") else (findIndex (fun g => g.fnHash == h) (ctx.cScope).fns, f)
  | Option.none => Throw.throw ("unknown function #" ++ Text.take 10 h)

/-- Compiles `main` and what it calls to C exporting it as `export`. -/
def CGen.compile (fetch : Text -> {Throw Text | r} Option Sexp) (meta : Text -> {Throw Text | r} Option Sexp) (main : Text) (export : Text) : {Throw Text | r} Text :=
  let fns := gather fetch meta main
  let names := dedup (concatMap (fun f => patternTypes f.fnBody) fns)
  CGen.unit fns (filterMap (fun t => Option.map (fun form => (t, form)) (fetch t)) names) export

/-- `e` compiled to C. In tail position the result is statements that return `e` (a call to
  itself becomes a jump); otherwise it is an expression, using GNU statement expressions for
  `let`, `seq` and `match`. -/
def CGen.expr (ctx : FnCtx) (env : List Int) (tail : Bool) (e : Sexp) : {Throw Text} Text :=
  let sub := fun x => CGen.expr ctx env false x
  let ret := fun x => if tail then "return " ++ x ++ ";" else x
  match e with
  | Sexp.list (Sexp.sym "int" :: Sexp.int n :: []) => ret (lit n)
  | Sexp.list (Sexp.sym "con" :: Sexp.str "#Bool" :: Sexp.int tag :: Sexp.int 0 :: []) => ret ("(V)" ++ toText tag)
  | Sexp.list (Sexp.sym "con" :: Sexp.str _ :: Sexp.int tag :: Sexp.int 0 :: []) => ret ("(V)&deus_nullary[" ++ toText tag ++ "]")
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "con" :: Sexp.str t :: Sexp.int tag :: Sexp.int n :: []) :: xs) => if n != List.length xs || t == "#Bool" then Throw.throw ("partial application of a constructor of " ++ t ++ " is outside the C subset") else
      let p := CGen.fresh ctx
      let stores := mapIndexed (fun i a => local p ++ "[" ++ toText (i + 1) ++ "] = " ++ sub a ++ "; ") xs
      ret ("({ V *" ++ local p ++ " = deus_alloc(" ++ toText (n + 1) ++ "); " ++ local p ++ "[0] = " ++
        toText tag ++ "; " ++ Text.concat stores ++ "(V)" ++ local p ++ "; })")
  | Sexp.list (Sexp.sym "match" :: scrutinee :: cases) =>
      let v := CGen.fresh ctx
      setType ctx.cScope v (typeOf ctx.cScope env scrutinee)
      let r := CGen.fresh ctx
      let done := "m" ++ toText r
      let arms := List.map (fun c =>
        match c with
        | Sexp.list (Sexp.sym "case" :: pat :: body :: []) =>
            match CGen.pattern ctx v env pat with
            | (guard, bound) => if tail then "do { " ++ guard ++ CGen.expr ctx bound true body ++ " } while (0); " else "do { " ++ guard ++ local r ++ " = " ++ CGen.expr ctx bound false body ++ "; goto " ++
                done ++ "; } while (0); "
        | other => Throw.throw ("outside the C subset: " ++ Sexp.print other)) cases
      let head := "V " ++ local v ++ " = " ++ sub scrutinee ++ "; "
      if tail then "{ " ++ head ++ Text.concat arms ++ "__builtin_trap(); }" else "({ " ++ head ++ "V " ++ local r ++ "; " ++ Text.concat arms ++ "__builtin_trap(); " ++ done ++
        ": " ++
        local r ++
        "; })"
  | Sexp.list (Sexp.sym "var" :: Sexp.int i :: []) =>
      match get? env i with
      | Option.some l => ret (local l)
      | Option.none => Throw.throw ("unbound variable " ++ toText i)
  | Sexp.list (Sexp.sym "if" :: c :: t :: f :: []) => if tail then "if (" ++ sub c ++ ") { " ++ CGen.expr ctx env true t ++ " } else { " ++
      CGen.expr ctx env true f ++ " }" else "(" ++ sub c ++ " ? " ++ sub t ++ " : " ++ sub f ++ ")"
  | Sexp.list (Sexp.sym "seq" :: a :: b :: []) => if tail then "(void)" ++ sub a ++ "; " ++ CGen.expr ctx env true b else "({ (void)" ++ sub a ++ "; " ++ sub b ++ "; })"
  | Sexp.list (Sexp.sym "let" :: v :: b :: []) =>
      let l := CGen.fresh ctx
      setType ctx.cScope l (typeOf ctx.cScope env v)
      let bind := "V " ++ local l ++ " = " ++ sub v ++ "; "
      if tail then "{ " ++ bind ++ CGen.expr ctx (l :: env) true b ++ " }" else "({ " ++ bind ++ CGen.expr ctx (l :: env) false b ++ "; })"
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "prim" :: Sexp.str "Int.neg" :: []) :: a :: []) => ret ("SUB(0, " ++ sub a ++ ")")
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "prim" :: Sexp.str p :: []) :: xs) =>
      match (p, List.map sub xs) with
      | ("Array.make", n :: x :: []) =>
          -- `Array` is a block `[length, item…]` and `Ref` a block `[value]` (D83); the writes return `()`.
          ret ("deus_array(" ++ n ++ ", " ++ x ++ ")")
      | ("Array.length", a :: []) => ret ("((V *)(" ++ a ++ "))[0]")
      | ("Array.get", a :: i :: []) => ret ("(*AT(" ++ a ++ ", " ++ i ++ "))")
      | ("Array.set", a :: i :: x :: []) => ret ("({ *AT(" ++ a ++ ", " ++ i ++ ") = " ++ x ++ "; (V)&deus_nullary[0]; })")
      | ("Ref.new", x :: []) =>
          let l := CGen.fresh ctx
          ret ("({ V *" ++ local l ++ " = deus_alloc(1); " ++ local l ++ "[0] = " ++ x ++ "; (V)" ++
            local l ++ "; })")
      | ("Ref.get", r :: []) => ret ("((V *)(" ++ r ++ "))[0]")
      | ("Ref.set", r :: x :: []) => ret ("({ ((V *)(" ++ r ++ "))[0] = " ++ x ++ "; (V)&deus_nullary[0]; })")
      | (_, ca :: cb :: []) =>
          match xs with
          | a :: b :: [] => if isComparison p && not (isScalar (typeOf ctx.cScope env a) || isScalar (typeOf ctx.cScope env b)) then Throw.throw (p ++
              " on values that are not known to be Int or Bool is outside the C subset, since it would compare addresses: " ++ Text.take 120 (Sexp.print e)) else
              match (macro p, infix p) with
              | (Option.some m, _) => ret (m ++ "(" ++ ca ++ ", " ++ cb ++ ")")
              | (_, Option.some op) => ret ("(V)(" ++ ca ++ " " ++ op ++ " " ++ cb ++ ")")
              | _ => Throw.throw ("the primitive " ++ p ++ " is outside the C subset")
          | _ => Throw.throw ("the primitive " ++ p ++ " is outside the C subset")
      | _ => Throw.throw ("the primitive " ++ p ++ " is outside the C subset")
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) :: xs) =>
      match callee ctx h (List.length xs) with
      | (index, f) =>
          let values := List.map sub xs
          if tail && index == ctx.cSelf then
            -- Evaluate every argument before assigning any parameter, since they read the old ones.
            let temps := List.map (fun _ => CGen.fresh ctx) values
            let evals := List.map
              (fun pair => "V " ++ local (fst pair) ++ " = " ++ snd pair ++ "; ")
              (zip temps values)
            let assigns := mapIndexed (fun i t => local i ++ " = " ++ local t ++ "; ") temps
            "{ " ++ Text.concat evals ++ Text.concat assigns ++ "goto top; }"
          else if tail && f.fnArity == ctx.cArity then "__attribute__((musttail)) return " ++ fnName index ++ CGen.args values ++ ";" else ret (fnName index ++ CGen.args values)
  | other => Throw.throw ("outside the C subset: " ++ Text.take 120 (Sexp.print other))

def CGen.fnName (i : Int) : Text := "f" ++ toText i

def CGen.fresh (ctx : FnCtx) : Int := Wasm.fresh ctx.cNext

def CGen.infix (p : Text) : Option Text := if p == "Int.and" then Option.some "&" else if p == "Int.or" then Option.some "|" else if p == "Int.xor" then Option.some "^" else if p == "eq" then Option.some "==" else if p == "neq" then Option.some "!=" else if p == "lt" then Option.some "<" else if p == "gt" then Option.some ">" else if p == "le" then Option.some "<=" else if p == "ge" then Option.some ">=" else Option.none

def CGen.larger (a : Int) (b : Int) : Int := if a > b then a else b

/-- A C integer literal; the most negative `Int` has no literal of its own. -/
def CGen.lit (n : Int) : Text := if n == -2147483648 then "(-2147483647 - 1)" else "(V)" ++ toText n

def CGen.local (l : Int) : Text := "l" ++ toText l

def CGen.macro (p : Text) : Option Text := if p == "Int.add" then Option.some "ADD" else if p == "Int.sub" then Option.some "SUB" else if p == "Int.mul" then Option.some "MUL" else if p == "Int.div" then Option.some "DIV" else if p == "Int.mod" then Option.some "MOD" else if p == "Int.shl" then Option.some "SHL" else if p == "Int.shr" then Option.some "SHR" else if p == "Int.ushr" then Option.some "USHR" else Option.none

/-- One more than the largest tag of a nullary constructor (other than `Bool`'s) in `form`. -/
def CGen.nullaryCount (form : Sexp) : Int :=
  match form with
  | Sexp.list (Sexp.sym "con" :: Sexp.str t :: Sexp.int tag :: Sexp.int 0 :: []) => if t == "#Bool" then 0 else tag + 1
  | Sexp.list items => foldl (fun acc x => larger acc (CGen.nullaryCount x)) 0 items
  | _ => 0

def CGen.params (n : Int) : Text := CGen.args (List.map (fun i => "V " ++ local i) (range 0 n))

/-- A pattern test against the C expression `v` (a local): statements that `break` out of the
  enclosing `do … while (0)` when it does not match, and the environment with what it binds. -/
def CGen.pattern (ctx : FnCtx) (v : Int) (env : List Int) (pat : Sexp) : {Throw Text} (Text, List Int) :=
  match pat with
  | Sexp.list (Sexp.sym "pany" :: []) => ("", env)
  | Sexp.list (Sexp.sym "pvar" :: []) => ("", v :: env)
  | Sexp.list (Sexp.sym "pas" :: p :: []) => CGen.pattern ctx v (v :: env) p
  | Sexp.list (Sexp.sym "pint" :: Sexp.int n :: []) => ("if (" ++ local v ++ " != " ++ lit n ++ ") break; ", env)
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str "#Bool" :: Sexp.int tag :: []) => ("if (" ++ local v ++ " != " ++ toText tag ++ ") break; ", env)
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str t :: Sexp.int tag :: subs) =>
      let tagTest := "if (((V *)" ++ local v ++ ")[0] != " ++ toText tag ++ ") break; "
      foldl (fun acc pair =>
        match (acc, pair) with
        | ((code, bound), i, Sexp.list (Sexp.sym "pany" :: [])) => (code, bound)
        | ((code, bound), i, sub) =>
            let f := CGen.fresh ctx
            setType ctx.cScope f (fieldType ctx.cScope t tag i (typeOfLocal ctx.cScope v))
            match CGen.pattern ctx f bound sub with
            | (subCode, bound2) => (code ++ "V " ++ local f ++ " = ((V *)" ++ local v ++ ")[" ++ toText (i + 1) ++ "]; " ++
                subCode, bound2)) (tagTest, env) (mapIndexed (fun i x => (i, x)) subs)
  | other => Throw.throw ("the pattern " ++ Sexp.print other ++ " is outside the C subset")

/-
  A C back end (D80): compiles a definition and the definitions it calls to C, which a C compiler
  (clang, so LLVM) turns into native code.

  It accepts the same first-order subset as the wasm back end (D51) and reuses that back end's
  gathering and type tracking, so a program compiles to both or to neither. Each definition is a
  C function of `V`s, a machine word. `Int` and `Bool` are themselves, sign-extended from 32 bits,
  and arithmetic wraps at 32 bits as in the interpreter. Any other constructed value points at a
  block `[tag, field…]` from a bump allocator that never frees; a nullary constructor is a static
  block. A call to itself in tail position is a jump back to the top of the function; a tail call
  of a function of the same arity is `musttail`, so mutual recursion in tail position runs in
  constant stack too.

  `Int.div` and `Int.mod` by zero trap, as in wasm.
-/
/-- The C every unit starts with; `nullary` static blocks serve the nullary constructors' tags. -/
def CGen.prelude (nullary : Int) : Text := join
  "\n"
  ["#include <stdint.h>", "#include <stdlib.h>", "typedef intptr_t V;", "#define W(x) ((V)(int32_t)(uint32_t)(x))", "#define ADD(a, b) W((uint32_t)(a) + (uint32_t)(b))", "#define SUB(a, b) W((uint32_t)(a) - (uint32_t)(b))", "#define MUL(a, b) W((uint32_t)(a) * (uint32_t)(b))", "#define SHL(a, b) W((uint32_t)(a) << ((b) & 31))", "#define SHR(a, b) ((V)((int32_t)(a) >> ((b) & 31)))", "#define USHR(a, b) W((uint32_t)(a) >> ((b) & 31))", "static inline V DIV(V a, V b) { if (b == 0) __builtin_trap(); return b == -1 ? SUB(0, a) : (V)((int32_t)a / (int32_t)b); }", "static inline V MOD(V a, V b) { if (b == 0) __builtin_trap(); return b == -1 ? 0 : (V)((int32_t)a % (int32_t)b); }", "static V *deus_hp, *deus_hl;", "static V *deus_refill(V n) { V size = n > (1 << 22) ? n : (1 << 22); deus_hp = malloc(size * sizeof(V)); if (!deus_hp) abort(); deus_hl = deus_hp + size; V *p = deus_hp; deus_hp += n; return p; }", "static inline V *deus_alloc(V n) { if (deus_hl - deus_hp < n) return deus_refill(n); V *p = deus_hp; deus_hp += n; return p; }", "static V deus_array(V n, V x) { if (n < 0) __builtin_trap(); V *p = deus_alloc(n + 1); p[0] = n; for (V i = 1; i <= n; i++) p[i] = x; return (V)p; }", "#define AT(a, i) ({ V *a_ = (V *)(a); V i_ = (i); if ((uint32_t)i_ >= (uint32_t)a_[0]) __builtin_trap(); &a_[i_ + 1]; })", "static V deus_nullary[" ++ toText (larger nullary 1) ++ "] = {" ++
    join ", " (List.map toText (range 0 (larger nullary 1))) ++ "};", ""]

/-- The C translation unit: every function, and `export` as an `int32_t` entry point. -/
def CGen.unit (fns : List Fn) (datatypes : List (Text, Sexp)) (export : Text) : {Throw Text} Text :=
  let decls := mapIndexed (fun i f => "static V " ++ fnName i ++ CGen.params f.fnArity ++ ";") fns
  let bodies := mapIndexed (fun i f =>
    let scope := Wasm.Scope.mk
      fns
      datatypes
      (Ref.new (mapIndexed (fun j t => (j, t)) (fst (peel f.fnArity f.fnType))))
    let ctx := FnCtx.mk scope i f.fnArity (Ref.new f.fnArity)
    let env := reverse (range 0 f.fnArity)
    "/* #" ++ Text.take 10 f.fnHash ++ " */\nstatic V " ++ fnName i ++ CGen.params f.fnArity ++
      " {\ntop:;\n  " ++ CGen.expr ctx env true f.fnBody ++ "\n}") fns
  let arity := getOr (Option.map (fun f => f.fnArity) (head? fns)) 0
  let inputs := range 0 arity
  let entry := "int32_t " ++ export ++ CGen.args (List.map (fun i => "int32_t a" ++ toText i) inputs) ++
    " { return (int32_t)f0" ++ CGen.args (List.map (fun i => "(V)a" ++ toText i) inputs) ++ "; }"
  let main := join
    "\n"
    ["#ifdef DEUS_MAIN", "#include <stdio.h>", "int main(int argc, char **argv) {", "  if (argc != " ++ toText (arity + 1) ++ ") { fprintf(stderr, \"usage: %s" ++
      Text.concat (List.map (fun _ => " <int>") inputs) ++ "\\n\", argv[0]); return 2; }", "  printf(\"%d\\n\", " ++ export ++
      CGen.args (List.map (fun i => "(int32_t)atol(argv[" ++ toText (i + 1) ++ "])") inputs) ++ ");", "  return 0;", "}", "#endif"]
  let nullary := foldl (fun acc f => larger acc (nullaryCount f.fnBody)) 0 fns
  join "\n" ([prelude nullary] ++ decls ++ [""] ++ bodies ++ ["", entry, main, ""])
