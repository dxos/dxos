/-- What the compiler knows while compiling one function: its index, its arity and its label counter. -/
structure CGen.FnCtx @"urn:deus:cgen:FnCtx" where
  cScope : Wasm.Scope
  cSelf : Int
  cArity : Int
  cNext : Ref Int
  cBorrow : List (Int, List Bool)
  cLifted : Ref (List Text)

/-- A reuse token: the C local holding a dead block's memory, and its field count. -/
structure CGen.Token @"urn:deus:cgen:Token" where
  tokLocal : Int
  tokFields : Int

def CGen.args (xs : List Text) : Text := "(" ++ join ", " xs ++ ")"

/-- The index and definition of the function `h`. -/
def CGen.arityOf (ctx : FnCtx) (h : Text) : {Throw Text} Int :=
  let found := List.find (fun f => f.fnHash == h) (ctx.cScope).fns
  if isNone found then Throw.throw ("unknown function #" ++ Text.take 10 h) else getOr (Option.map (fun f => f.fnArity) found) 0

/-- `pre` (statements) runs before `body`: in tail position both are statements. -/
def CGen.before (tail : Bool) (pre : Text) (body : Text) : Text := if pre == "" then body else if tail then pre ++ body else "({ " ++ pre ++ body ++ "; })"

--
-- Reference counting (D86). Every local the code owns is consumed exactly once: its last use
-- moves it, earlier uses `deus_dup` it, and a path that never uses it drops it first.
--
/-- How many variables a pattern binds. -/
def CGen.binders (pat : Sexp) : Int :=
  match pat with
  | Sexp.list (Sexp.sym "pvar" :: []) => 1
  | Sexp.list (Sexp.sym "pas" :: p :: []) => 1 + CGen.binders p
  | Sexp.list (Sexp.sym "pcon" :: _ :: _ :: subs) => sum (List.map CGen.binders subs)
  | _ => 0

/-- The field count of a pattern that takes apart a heap block, or 0. -/
def CGen.blockFields (pat : Sexp) : Int :=
  match pat with
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str t :: Sexp.int _ :: subs) => if t == "#Bool" then 0 else List.length subs
  | _ => 0

def CGen.borrowsAt (flags : List Bool) (k : Int) : Bool := getOr (get? flags k) false

/-- Which parameters of function `index` are borrowed: the caller keeps ownership (D86). -/
def CGen.borrowsOf (ctx : FnCtx) (index : Int) : List Bool := getOr (List.lookup index ctx.cBorrow) []

/-- The data types whose constructors `form` applies. -/
def CGen.builtTypes (form : Sexp) : List Text :=
  match form with
  | Sexp.list (Sexp.sym "con" :: Sexp.str t :: _) => if t == "#Bool" then [] else [t]
  | Sexp.list items => concatMap CGen.builtTypes items
  | _ => []

def CGen.callee (ctx : FnCtx) (h : Text) (argc : Int) : {Throw Text} (Int, Fn) :=
  match List.find (fun f => f.fnHash == h) (ctx.cScope).fns with
  | Option.some f => if f.fnArity != argc then Throw.throw ("#" ++ Text.take 10 h ++ " takes " ++ toText f.fnArity ++ " arguments but is applied to " ++
      toText argc ++ "; partial application is outside the C subset") else (findIndex (fun g => g.fnHash == h) (ctx.cScope).fns, f)
  | Option.none => Throw.throw ("unknown function #" ++ Text.take 10 h)

/-- Compiles `main` and what it calls to C exporting it as `export`. -/
def CGen.compile (fetch : Text -> {Throw Text | r} Option Sexp) (meta : Text -> {Throw Text | r} Option Sexp) (main : Text) (export : Text) : {Throw Text | r} Text :=
  let fns := liftAll (Wasm.gather fetch meta main)
  -- The types the code builds as well as the ones it matches, so comparisons know their constructors.
  let names := dedup (concatMap (fun f => patternTypes f.fnBody ++ builtTypes f.fnBody) fns)
  -- A definition that is only a primitive is inlined at its calls and gathers to nothing.
  if List.isEmpty fns then Throw.throw (export ++ " is a primitive, not a definition the C back end compiles") else CGen.unit fns (filterMap (fun t => Option.map (fun form => (t, form)) (fetch t)) names) export

/-- Whether `e` consumes local `l` of function `self`, given which parameters are borrowed so far:
  any use but as the container of an `Array` or `Ref` access, or as an argument a callee borrows
  (a call to `self` only in the same position, so a jump to the top keeps it borrowed). -/
def CGen.consumes (borrow : List (Int, List Bool)) (fns : List Fn) (self : Int) (param : Int) (env : List Int) (l : Int) (e : Sexp) : Bool :=
  let again := fun x => CGen.consumes borrow fns self param env l x
  match e with
  | Sexp.list (Sexp.sym "var" :: Sexp.int i :: []) => get? env i == Option.some l
  | Sexp.list (Sexp.sym "let" :: v :: b :: []) => again v || CGen.consumes borrow fns self param (-1 :: env) l b
  | Sexp.list (Sexp.sym "lam" :: b :: []) => isIn (freeLocals (-1 :: env) b) l
  | Sexp.list (Sexp.sym "match" :: scrutinee :: cases) => again scrutinee || any (fun c =>
      match c with
      | Sexp.list (Sexp.sym "case" :: pat :: b :: []) => CGen.consumes borrow fns self param (replicate (CGen.binders pat) (-1) ++ env) l b
      | _ => false) cases
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "prim" :: Sexp.str p :: []) :: x :: rest) =>
      let container := (startsWith "Array." p || startsWith "Ref." p) && p != "Array.make" && p != "Array.set" && p != "Ref.new" && isLocal env l x
      not container && again x || any again rest
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) :: xs) =>
      let index := findIndex (fun f => f.fnHash == h) fns
      let flags := getOr (List.lookup index borrow) []
      any (fun pair =>
        match pair with
        | (k, x) => if isLocal env l x then not (borrowsAt flags k && (index != self || k == param)) else again x) (mapIndexed (fun k x => (k, x)) xs)
  | Sexp.list items => any again items
  | _ => false

def CGen.dropLocal (ctx : FnCtx) (l : Int) : Text := if scalarLocal ctx l then "" else "deus_drop(" ++ CGen.local l ++ "); "

def CGen.dupLocal (ctx : FnCtx) (l : Int) : Text := if scalarLocal ctx l then "" else "deus_dup(" ++ CGen.local l ++ "); "

/-- `e` compiled to C, consuming each local in `owned` exactly once and the reuse token, if any.
  In tail position the result is statements that return `e` (a call to itself becomes a jump);
  otherwise it is an expression, using GNU statement expressions. -/
def CGen.expr (ctx : FnCtx) (env : List Int) (tail : Bool) (owned : List Int) (token : Option CGen.Token) (e : Sexp) : {Throw Text} Text :=
  let used := freeLocals env e
  let live := List.filter (isIn used) owned
  let dead := Text.concat (List.map (dropLocal ctx) (List.filter (fun l => not (isIn used l)) owned))
  match token with
  | Option.some t => if wants t.tokFields e then before tail dead (form ctx env tail live token e) else before
      tail
      (dead ++ "deus_unused(" ++ tokenName t ++ "); ")
      (form ctx env tail live Option.none e)
  | Option.none => before tail dead (form ctx env tail live Option.none e)

/-- `x` and `y`, of type `field`, compared for equality (a C truth value) or, with `order`, as -1, 0 or 1. -/
def CGen.fieldTest (scope : Wasm.Scope) (order : Bool) (field : Sexp) (x : Text) (y : Text) : {Throw Text} Text :=
  let both := "(" ++ x ++ ", " ++ y ++ ")"
  if isScalar field then if order then "deus_int_cmp" ++ both else "(" ++ x ++ " == " ++ y ++ ")" else if field == tref "#Text" then (if order then "deus_text_cmp" else "deus_text_eq") ++ both else if isData scope field then (if order then "deus_cmp" else "deus_eq") ++ toText (structIndex scope field) ++ both else if field == unknown || head field == "tvar" then (if order then "deus_cmp_any" else "deus_eq_any") ++ both else Throw.throw ("comparing values of type " ++ Sexp.print field ++ " is outside the C subset")

def CGen.fnName (i : Int) : Text := "f" ++ toText i

/-- `e` once `expr` has dropped what it does not use: `owned` are exactly the locals it consumes. -/
def CGen.form (ctx : FnCtx) (env : List Int) (tail : Bool) (owned : List Int) (token : Option CGen.Token) (e : Sexp) : {Throw Text} Text :=
  let ret := fun x => if tail then "return " ++ x ++ ";" else x
  match e with
  | Sexp.list (Sexp.sym "int" :: Sexp.int n :: []) => ret (lit n)
  | Sexp.list (Sexp.sym "text" :: Sexp.str t :: []) => ret (textLiteral t)
  | Sexp.list (Sexp.sym "prim" :: Sexp.str p :: []) =>
      -- A primitive used as a value is its eta-expansion: one lambda per parameter.
      let arity := primArity p
      if arity <= 0 then Throw.throw ("the primitive " ++ p ++ " as a value is outside the C subset") else CGen.form ctx env tail owned token (foldl (fun body _ => Sexp.node "lam" [body]) (Sexp.node
        "app"
        (Sexp.node "prim" [Sexp.str p] :: List.map (fun i => Sexp.node "var" [Sexp.int i]) (reverse (range 0 arity)))) (range 0 arity))
  | Sexp.list (Sexp.sym "con" :: Sexp.str "#Bool" :: Sexp.int tag :: Sexp.int 0 :: []) => ret ("(V)" ++ toText tag)
  | Sexp.list (Sexp.sym "con" :: Sexp.str _ :: Sexp.int tag :: Sexp.int 0 :: []) => ret ("STATIC(&deus_nullary[" ++ toText tag ++ "])")
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "con" :: Sexp.str t :: Sexp.int tag :: Sexp.int n :: []) :: xs) => if n != List.length xs || t == "#Bool" then Throw.throw ("partial application of a constructor of " ++ t ++ " is outside the C subset") else
      let mine :=
        match token with
        | Option.some tok => tok.tokFields == n
        | Option.none => false
      match CGen.sequence ctx env owned (if mine then Option.none else token) [] xs with
      | (decls, values, _) =>
          let p := CGen.fresh ctx
          let memory :=
            match token with
            | Option.some tok => if mine then tokenName tok else "0"
            | Option.none => "0"
          let stores := mapIndexed
            (fun i v => CGen.local p ++ "[" ++ toText (i + 1) ++ "] = " ++ v ++ "; ")
            values
          ret ("({ " ++ decls ++ "V *" ++ CGen.local p ++ " = deus_con(" ++ memory ++ ", " ++ toText n ++
            "); " ++ CGen.local p ++ "[0] = " ++ toText tag ++ "; " ++ Text.concat stores ++ "BOX(" ++ CGen.local p ++ "); })")
  | Sexp.list (Sexp.sym "match" :: scrutinee :: cases) => matchForm ctx env tail owned token scrutinee cases
  | Sexp.list (Sexp.sym "var" :: Sexp.int i :: []) =>
      match get? env i with
      | Option.some l => if isIn owned l || scalarLocal ctx l then ret (CGen.local l) else ret ("deus_dup(" ++ CGen.local l ++ ")")
      | Option.none => Throw.throw ("unbound variable " ++ toText i)
  | Sexp.list (Sexp.sym "if" :: c :: t :: f :: []) =>
      let branches := freeLocals env t ++ freeLocals env f
      let mine := List.filter (fun l => not (isIn branches l)) owned
      let rest := List.filter (isIn branches) owned
      let cond := CGen.expr ctx env false mine Option.none c
      if tail then "if (" ++ cond ++ ") { " ++ CGen.expr ctx env true rest token t ++ " } else { " ++
        CGen.expr ctx env true rest token f ++ " }" else "(" ++ cond ++ " ? " ++ CGen.expr ctx env false rest token t ++ " : " ++
        CGen.expr ctx env false rest token f ++ ")"
  | Sexp.list (Sexp.sym "seq" :: a :: b :: []) =>
      let later := freeLocals env b
      let mine := List.filter (fun l => not (isIn later l)) owned
      let rest := List.filter (isIn later) owned
      let first := if wants (getOr (Option.map (fun t => t.tokFields) token) 0) a then token else Option.none
      let second :=
        match first with
        | Option.some _ => Option.none
        | Option.none => token
      let value := CGen.expr ctx env false mine first a
      let consumed := if uncounted (Wasm.typeOf ctx.cScope env a) then "(void)" ++ value ++ "; " else "deus_drop(" ++ value ++ "); "
      before tail consumed (CGen.expr ctx env tail rest second b)
  | Sexp.list (Sexp.sym "let" :: v :: b :: []) =>
      let later := freeLocals (-1 :: env) b
      let mine := List.filter (fun l => not (isIn later l)) owned
      let rest := List.filter (isIn later) owned
      let first := if wants (getOr (Option.map (fun t => t.tokFields) token) 0) v then token else Option.none
      let second :=
        match first with
        | Option.some _ => Option.none
        | Option.none => token
      let l := CGen.fresh ctx
      setType ctx.cScope l (Wasm.typeOf ctx.cScope env v)
      before
        tail
        ("V " ++ CGen.local l ++ " = " ++ CGen.expr ctx env false mine first v ++ "; ")
        (CGen.expr ctx (l :: env) tail (l :: rest) second b)
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "prim" :: Sexp.str "Int.neg" :: []) :: a :: []) => ret ("SUB(0, " ++ CGen.expr ctx env false owned Option.none a ++ ")")
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "prim" :: Sexp.str p :: []) :: xs) =>
      match runtime ctx env owned token p xs with
      | Option.some code => ret code
      | Option.none => ret (CGen.primitive ctx env owned token e p xs)
  | Sexp.list (Sexp.sym "lam" :: b :: []) => ret (lambdaClosure ctx env owned b)
  | Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) => CGen.form ctx env tail owned token (partial h (arityOf ctx h) [])
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) :: xs) =>
      let arity := arityOf ctx h
      if List.length xs < arity then CGen.form ctx env tail owned token (partial h arity xs) else if List.length xs > arity then CGen.form
        ctx
        env
        tail
        owned
        token
        (Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "ref", Sexp.str h] :: List.take arity xs) :: List.drop arity xs)) else
        match callee ctx h (List.length xs) with
        | (index, f) =>
            match CGen.sequence ctx env owned token (borrowsOf ctx index) xs with
            | (decls, values, after) => if tail && index == ctx.cSelf && after == "" then "{ " ++ decls ++
                Text.concat (mapIndexed (fun i v => CGen.local i ++ " = " ++ v ++ "; ") values) ++ "goto top; }" else
                let call := fnName index ++ CGen.args values
                if after != "" then ret ("({ " ++ decls ++ "V r = " ++ call ++ "; " ++ after ++ "r; })") else if tail && f.fnArity == ctx.cArity then "{ " ++ decls ++ "MUSTTAIL return " ++ call ++ "; }" else ret (if decls == "" then call else "({ " ++ decls ++ call ++ "; })")
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "ref" :: Sexp.str h :: []) :: ys) :: xs) => CGen.form
      ctx
      env
      tail
      owned
      token
      (Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "ref", Sexp.str h] :: ys ++ xs))
  | Sexp.list (Sexp.sym "app" :: f :: x :: rest) =>
      -- An unknown function: the closure is borrowed by the first call; each later one consumes the closure before it.
      match CGen.sequence ctx env owned token [true] (f :: x :: rest) with
      | (decls, values, after) =>
          match values with
          | fv :: xv :: more =>
              let call := foldl
                (fun c v => "deus_apply_drop(" ++ c ++ ", " ++ v ++ ")")
                ("deus_apply(" ++ fv ++ ", " ++ xv ++ ")")
                more
              ret ("({ " ++ decls ++ "V r = " ++ call ++ "; " ++ after ++ "r; })")
          | _ => Throw.throw "an application without arguments"
  | other => Throw.throw ("outside the C subset: " ++ Text.take 120 (Sexp.print other))

/-- The locals `e` reads, with `env` mapping its de Bruijn indices to locals (-1 for none). -/
def CGen.freeLocals (env : List Int) (e : Sexp) : List Int :=
  match e with
  | Sexp.list (Sexp.sym "var" :: Sexp.int i :: []) =>
      match get? env i with
      | Option.some l => if l >= 0 then [l] else []
      | Option.none => []
  | Sexp.list (Sexp.sym "let" :: v :: b :: []) => CGen.freeLocals env v ++ CGen.freeLocals (-1 :: env) b
  | Sexp.list (Sexp.sym "lam" :: b :: []) => CGen.freeLocals (-1 :: env) b
  | Sexp.list (Sexp.sym "match" :: scrutinee :: cases) => CGen.freeLocals env scrutinee ++ concatMap (fun c =>
      match c with
      | Sexp.list (Sexp.sym "case" :: pat :: b :: []) => CGen.freeLocals (replicate (CGen.binders pat) (-1) ++ env) b
      | _ => []) cases
  | Sexp.list items => concatMap (CGen.freeLocals env) items
  | _ => []

--
-- Lambda lifting. A `letrec` function becomes a top-level function that takes the locals it
-- captures as extra leading parameters, so recursion is a direct call and never a closure
-- that holds itself (a cycle reference counting could not free).
--
/-- The variables of `e` bound outside it, below `depth` binders, as indices outside them. -/
def CGen.freeVars (depth : Int) (e : Sexp) : List Int :=
  match e with
  | Sexp.list (Sexp.sym "var" :: Sexp.int i :: []) => if i >= depth then [i - depth] else []
  | Sexp.list (Sexp.sym "lam" :: b :: []) => CGen.freeVars (depth + 1) b
  | Sexp.list (Sexp.sym "let" :: v :: b :: []) => CGen.freeVars depth v ++ CGen.freeVars (depth + 1) b
  | Sexp.list (Sexp.sym "letrec" :: Sexp.list fs :: b :: []) =>
      let n := List.length fs
      concatMap (CGen.freeVars (depth + n)) fs ++ CGen.freeVars (depth + n) b
  | Sexp.list (Sexp.sym "match" :: scrutinee :: cases) => CGen.freeVars depth scrutinee ++ concatMap (fun c =>
      match c with
      | Sexp.list (Sexp.sym "case" :: pat :: b :: []) => CGen.freeVars (depth + CGen.binders pat) b
      | _ => []) cases
  | Sexp.list items => concatMap (CGen.freeVars depth) items
  | _ => []

def CGen.fresh (ctx : FnCtx) : Int := Wasm.fresh ctx.cNext

/-- The token for each of `xs`: the first that builds a block of the token's size gets it. -/
def CGen.hand (token : Option CGen.Token) (xs : List Sexp) : List (Option CGen.Token) :=
  match (token, xs) with
  | (_, []) => []
  | (Option.none, _ :: rest) => Option.none :: CGen.hand Option.none rest
  | (Option.some t, x :: rest) => if wants t.tokFields x then token :: CGen.hand Option.none rest else Option.none :: CGen.hand token rest

/-- The borrowed parameters of every function: the largest set no body consumes. -/
def CGen.inferBorrow (fns : List Fn) : List (Int, List Bool) :=
  let initial := mapIndexed
    (fun i f => (i, List.map (fun t => not (isScalar t)) (fst (peel f.fnArity f.fnType))))
    fns
  let rec step borrow :=
    let next := mapIndexed (fun i f =>
      let flags := getOr (List.lookup i borrow) []
      let env := reverse (range 0 f.fnArity)
      (i, mapIndexed (fun k b => b && not (consumes borrow fns i k env k f.fnBody)) flags)) fns
    if next == borrow then borrow else step next
  step initial

def CGen.infix (p : Text) : Option Text := if p == "Int.and" then Option.some "&" else if p == "Int.or" then Option.some "|" else if p == "Int.xor" then Option.some "^" else if p == "eq" then Option.some "==" else if p == "neq" then Option.some "!=" else if p == "lt" then Option.some "<" else if p == "gt" then Option.some ">" else if p == "le" then Option.some "<=" else if p == "ge" then Option.some ">=" else Option.none

def CGen.isIn (xs : List Int) (x : Int) : Bool := List.contains x xs

/-- Whether `e` maps de Bruijn index `i` of `env` to local `l`. -/
def CGen.isLocal (env : List Int) (l : Int) (e : Sexp) : Bool :=
  match e with
  | Sexp.list (Sexp.sym "var" :: Sexp.int i :: []) => get? env i == Option.some l
  | _ => false

/-- A lambda as a closure: its code is lifted to `static V c<k>(V self, V arg)`, which reads the
  captured locals from `self` without counting them, and the block holds the code and captures. -/
def CGen.lambdaClosure (ctx : FnCtx) (env : List Int) (owned : List Int) (b : Sexp) : {Throw Text} Text :=
  let free := dedup (freeLocals (-1 :: env) b)
  if List.length free > 253 then Throw.throw "a lambda that captures more than 253 locals is outside the C subset" else
    let k := List.length (Ref.get ctx.cLifted)
    let captures := mapIndexed (fun i l => (l, i + 2)) free
    let typed := List.map (fun pair => (snd pair, typeOfLocal ctx.cScope (fst pair))) captures
    let scope := Wasm.Scope.mk (ctx.cScope).fns (ctx.cScope).datatypes (Ref.new typed) (ctx.cScope).eqs
    let inner := FnCtx.mk scope (-1) 2 (Ref.new (2 + List.length free)) ctx.cBorrow ctx.cLifted
    -- Reserve the slot first, so closures nested in `b` take the next numbers.
    Ref.set ctx.cLifted (Ref.get ctx.cLifted ++ [""])
    let innerEnv := 1 :: List.map (fun l => getOr (List.lookup l captures) (-1)) env
    let loads := Text.concat (List.map
      (fun pair => "V " ++ CGen.local (snd pair) ++ " = UNBOX(l0)[" ++ toText (snd pair - 1) ++ "]; ")
      captures)
    let code := "static V c" ++ toText k ++ "(V l0, V l1) {\n  " ++ loads ++
      CGen.expr inner innerEnv true [1] Option.none b ++ "\n}"
    Ref.set ctx.cLifted (mapIndexed (fun i t => if i == k then code else t) (Ref.get ctx.cLifted))
    let vars := List.map (fun l => Sexp.list [Sexp.sym "var", Sexp.int (findIndex (fun x => x == l) env)]) free
    match CGen.sequence ctx env owned Option.none [] vars with
    | (decls, values, _) =>
        let p := CGen.fresh ctx
        let stores := mapIndexed (fun i v => CGen.local p ++ "[" ++ toText (i + 1) ++ "] = " ++ v ++ "; ") values
        "({ " ++ decls ++ "V *" ++ CGen.local p ++ " = deus_con(0, " ++ toText (List.length free) ++
          "); " ++ CGen.local p ++ "[0] = (V)(uintptr_t)&c" ++ toText k ++ "; " ++ Text.concat stores ++ "BOX(" ++ CGen.local p ++ "); })"

def CGen.larger (a : Int) (b : Int) : Int := if a > b then a else b

/-- A call of a runtime function that borrows the arguments `borrows` marks: each is passed as it is, and dropped after if owned. -/
def CGen.lending (ctx : FnCtx) (env : List Int) (owned : List Int) (token : Option CGen.Token) (borrows : List Bool) (call : List Text -> Text) (xs : List Sexp) : {Throw Text} Text :=
  match CGen.sequence ctx env owned token borrows xs with
  | (decls, values, after) => "({ " ++ decls ++ "V r = " ++ call values ++ "; " ++ after ++ "r; })"

/-- Every function with its `letrec`s lifted into new functions after the originals. -/
def CGen.liftAll (fns : List Fn) : {Throw Text} List Fn :=
  let out := Ref.new []
  let next := Ref.new 0
  let done := List.map (fun f => Fn.mk f.fnHash f.fnArity (liftExpr f.fnHash next out f.fnBody) f.fnType) fns
  done ++ Ref.get out

/-- `e` with every `letrec` lifted out; the lifted functions are added to `out`. -/
def CGen.liftExpr (parent : Text) (next : Ref Int) (out : Ref (List Fn)) (e : Sexp) : {Throw Text} Sexp :=
  let again := fun x => CGen.liftExpr parent next out x
  match e with
  | Sexp.list (Sexp.sym "letrec" :: Sexp.list fs :: b :: []) =>
      let n := List.length fs
      let caps := dedup (concatMap (freeVars n) fs)
      let count := List.length caps
      let names := List.map (fun _ =>
        let k := Ref.get next
        Ref.set next (k + 1)
        parent ++ "/rec" ++ toText k) fs
      let capAt := fun o => count - 1 - findIndex (fun c => c == o) caps
      -- Inside a lifted function, outside its own parameters, capture t is (var count-1-t).
      let inside := fun o => if o < n then lifted (getOr (get? names (n - 1 - o)) "") count (fun t => CGen.var (count - 1 - t)) else CGen.var (capAt (o - n))
      List.map (fun pair =>
        match pair with
        | (name, f) =>
            match Wasm.unlam f with
            | (0, _) => Throw.throw "a letrec binding that is not a lambda is outside the C subset"
            | (arity, body) =>
                let lifted := CGen.liftExpr parent next out (subst arity inside body)
                Ref.set out (Ref.get out ++ [Fn.mk name (count + arity) lifted unknown])) (zip names fs)
      let outside := fun o => if o < n then lifted (getOr (get? names (n - 1 - o)) "") count (fun t => CGen.var (getOr (get? caps t) 0)) else CGen.var (o - n)
      again (subst 0 outside b)
  | Sexp.list items => Sexp.list (List.map again items)
  | _ => e

/-- `h` applied to the captures, where capture `t` is the term `at t`. -/
def CGen.lifted (h : Text) (count : Int) (at : Int -> Sexp) : Sexp := if count == 0 then Sexp.list [Sexp.sym "ref", Sexp.str h] else Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "ref", Sexp.str h] :: List.map at (range 0 count))

/-- A C integer literal; the most negative `Int` has no literal of its own. -/
def CGen.lit (n : Int) : Text := if n == -2147483648 then "(-2147483647 - 1)" else "(V)" ++ toText n

def CGen.local (l : Int) : Text := "l" ++ toText l

def CGen.macro (p : Text) : Option Text := if p == "Int.add" then Option.some "ADD" else if p == "Int.sub" then Option.some "SUB" else if p == "Int.mul" then Option.some "MUL" else if p == "Int.div" then Option.some "DIV" else if p == "Int.mod" then Option.some "MOD" else if p == "Int.shl" then Option.some "SHL" else if p == "Int.shr" then Option.some "SHR" else if p == "Int.ushr" then Option.some "USHR" else Option.none

/-- A `match`. Each case that takes apart a block the code owns and does not use again reads its
  fields, then: if the block is unique, its fields' references pass to the case and its memory
  becomes the case's reuse token; if it is shared, the case `deus_dup`s the fields it uses and
  decrements the block. -/
def CGen.matchForm (ctx : FnCtx) (env : List Int) (tail : Bool) (owned : List Int) (token : Option CGen.Token) (scrutinee : Sexp) (cases : List Sexp) : {Throw Text} Text :=
  let inCases := freeLocals env (Sexp.list (Sexp.sym "match" :: Sexp.list [Sexp.sym "int", Sexp.int 0] :: cases))
  -- A local is matched where it is: the cases own it if the code does, else they borrow it.
  let named :=
    match scrutinee with
    | Sexp.list (Sexp.sym "var" :: Sexp.int i :: []) => get? env i
    | _ => Option.none
  let mine := List.filter (fun l => not (isIn inCases l) && Option.some l != named) owned
  let rest := List.filter (fun l => isIn inCases l || Option.some l == named) owned
  let v := getOr named (CGen.fresh ctx)
  let vOwned :=
    match named with
    | Option.some l => isIn owned l
    | Option.none => true
  match named with
  | Option.some _ => ()
  | Option.none => setType ctx.cScope v (Wasm.typeOf ctx.cScope env scrutinee)
  let r := CGen.fresh ctx
  let done := "m" ++ toText r
  let arms := List.map (fun c =>
    match c with
    | Sexp.list (Sexp.sym "case" :: pat :: body :: []) =>
        match CGen.pattern ctx v env pat with
        | (guard, bound, loads) =>
            let usedInBody := freeLocals bound body
            let vUsed := isIn usedInBody v
            let loaded := List.map (fun triple =>
              match triple with
              | (l, _, _) => l) loads
            let usedLoads := List.filter (isIn usedInBody) loaded
            let n := blockFields pat
            let ownedInBody := List.filter (fun l => l != v) rest ++ usedLoads ++ (if vUsed && vOwned then [v] else [])
            let shareFields := Text.concat (List.map (dupLocal ctx) usedLoads)
            let ownership := if n > 0 && not vUsed && vOwned then
              let direct := List.filter (fun triple =>
                match triple with
                | (_, parent, _) => parent == v) loads
              let nested := List.filter (fun triple =>
                match triple with
                | (_, parent, _) => parent != v) loads
              let directAt := fun i => List.find (fun triple =>
                match triple with
                | (_, _, k) => k == i) direct
              -- Unique: the fields' references pass to the case; drop those it does not use.
              let keepNested := Text.concat (List.map (fun triple =>
                match triple with
                | (l, _, _) => if isIn usedInBody l then dupLocal ctx l else "") nested)
              let dropUnused := Text.concat (List.map (fun i =>
                match directAt i with
                | Option.some (l, _, _) => if isIn usedInBody l then "" else dropLocal ctx l
                | Option.none => "deus_drop(UNBOX(" ++ CGen.local v ++ ")[" ++ toText (i + 1) ++ "]); ") (range 0 n))
              match token with
              | Option.none => if wants n body then
                  let t := CGen.Token.mk (CGen.fresh ctx) n
                  ("V *" ++ tokenName t ++ "; if (UNIQUE(" ++ CGen.local v ++ ")) { " ++ keepNested ++
                    dropUnused ++
                    tokenName t ++
                    " = UNBOX(" ++
                    CGen.local v ++
                    "); } else { " ++
                    shareFields ++
                    "HDR(" ++
                    CGen.local v ++
                    ") -= 256; " ++
                    tokenName t ++
                    " = 0; } ", Option.some t)
                else ("if (UNIQUE(" ++ CGen.local v ++ ")) { " ++ keepNested ++ dropUnused ++
                  "deus_release(UNBOX(" ++ CGen.local v ++ ")); } else { " ++ shareFields ++ "HDR(" ++ CGen.local v ++ ") -= 256; } ", Option.none)
              | Option.some _ => ("if (UNIQUE(" ++ CGen.local v ++ ")) { " ++ keepNested ++ dropUnused ++
                  "deus_release(UNBOX(" ++ CGen.local v ++ ")); } else { " ++ shareFields ++ "HDR(" ++ CGen.local v ++ ") -= 256; } ", token)
            else (shareFields ++ (if vUsed || not vOwned then "" else dropLocal ctx v), token)
            match ownership with
            | (rc, caseToken) => if tail then "do { " ++ guard ++ rc ++ CGen.expr ctx bound true ownedInBody caseToken body ++
                " } while (0); " else "do { " ++ guard ++ rc ++ CGen.local r ++ " = " ++
                CGen.expr ctx bound false ownedInBody caseToken body ++ "; goto " ++ done ++ "; } while (0); "
    | other => Throw.throw ("outside the C subset: " ++ Sexp.print other)) cases
  let head :=
    match named with
    | Option.some _ => Text.concat (List.map (dropLocal ctx) mine)
    | Option.none => "V " ++ CGen.local v ++ " = " ++ CGen.expr ctx env false mine Option.none scrutinee ++ "; "
  if tail then "{ " ++ head ++ Text.concat arms ++ "__builtin_trap(); }" else "({ " ++ head ++ "V " ++ CGen.local r ++ "; " ++ Text.concat arms ++ "__builtin_trap(); " ++ done ++
    ": " ++
    CGen.local r ++
    "; })"

/-- The argument that passes `l` itself and after which no argument consumes it: moving `l` there
  keeps it alive until the call, so later arguments read it without counting. -/
def CGen.mover (ctx : FnCtx) (env : List Int) (xs : List Sexp) (l : Int) : Option Int := foldl (fun acc pair =>
  match pair with
  | (k, x) => if isLocal env l x && not (any (consumes ctx.cBorrow (ctx.cScope).fns ctx.cSelf (-1) env l) (List.drop (k + 1) xs)) then Option.some k else acc) Option.none (mapIndexed (fun k x => (k, x)) xs)

/-- One more than the largest tag of a nullary constructor (other than `Bool`'s) in `form`. -/
def CGen.nullaryCount (form : Sexp) : Int :=
  match form with
  | Sexp.list (Sexp.sym "con" :: Sexp.str t :: Sexp.int tag :: Sexp.int 0 :: []) => if t == "#Bool" then 0 else tag + 1
  | Sexp.list items => foldl (fun acc x => larger acc (CGen.nullaryCount x)) 0 items
  | _ => 0

def CGen.params (n : Int) : Text := CGen.args (List.map (fun i => "V " ++ CGen.local i) (range 0 n))

/-- `h`, of arity `arity`, applied to fewer arguments: the arguments bound in order, then a lambda
  for each missing parameter around the saturated call. -/
def CGen.partial (h : Text) (arity : Int) (xs : List Sexp) : Sexp :=
  let given := List.length xs
  let call := Sexp.list (Sexp.sym "app" :: Sexp.list [Sexp.sym "ref", Sexp.str h] :: List.map (fun i => Sexp.list [Sexp.sym "var", Sexp.int (arity - 1 - i)]) (range 0 arity))
  let lams := foldl (fun body _ => Sexp.list [Sexp.sym "lam", body]) call (range given arity)
  List.foldr (fun pair body =>
    match pair with
    | (i, x) => Sexp.list [Sexp.sym "let", shift i 0 x, body]) lams (mapIndexed (fun i x => (i, x)) xs)

/-- A pattern test against the value in local `v`: statements that `break` out of the enclosing
  `do … while (0)` when it does not match, the environment with what it binds, and each local it
  loads as (local, the local it was loaded from, field index). -/
def CGen.pattern (ctx : FnCtx) (v : Int) (env : List Int) (pat : Sexp) : {Throw Text} (Text, (List Int, List (Int, (Int, Int)))) :=
  match pat with
  | Sexp.list (Sexp.sym "pany" :: []) => ("", env, [])
  | Sexp.list (Sexp.sym "pvar" :: []) => ("", v :: env, [])
  | Sexp.list (Sexp.sym "pas" :: p :: []) => CGen.pattern ctx v (v :: env) p
  | Sexp.list (Sexp.sym "pint" :: Sexp.int n :: []) => ("if (" ++ CGen.local v ++ " != " ++ lit n ++ ") break; ", env, [])
  | Sexp.list (Sexp.sym "ptext" :: Sexp.str t :: []) => ("if (!deus_text_eq(" ++ CGen.local v ++ ", " ++ textLiteral t ++ ")) break; ", env, [])
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str "#Bool" :: Sexp.int tag :: []) => ("if (" ++ CGen.local v ++ " != " ++ toText tag ++ ") break; ", env, [])
  | Sexp.list (Sexp.sym "pcon" :: Sexp.str t :: Sexp.int tag :: subs) =>
      let tagTest := "if (UNBOX(" ++ CGen.local v ++ ")[0] != " ++ toText tag ++ ") break; "
      foldl (fun acc pair =>
        match (acc, pair) with
        | ((code, bound, loads), i, Sexp.list (Sexp.sym "pany" :: [])) => (code, bound, loads)
        | ((code, bound, loads), i, sub) =>
            let f := CGen.fresh ctx
            setType ctx.cScope f (fieldType ctx.cScope t tag i (typeOfLocal ctx.cScope v))
            match CGen.pattern ctx f bound sub with
            | (subCode, bound2, subLoads) => (code ++ "V " ++ CGen.local f ++ " = UNBOX(" ++ CGen.local v ++ ")[" ++ toText (i + 1) ++
                "]; " ++
                subCode, bound2, loads ++ (f, v, i) :: subLoads)) (tagTest, env, []) (mapIndexed (fun i x => (i, x)) subs)
  | other => Throw.throw ("the pattern " ++ Sexp.print other ++ " is outside the C subset")

/-
  A C back end (D80): compiles a definition and the definitions it calls to C, which a C compiler
  (clang, so LLVM) turns into native code.

  It accepts the same first-order subset as the wasm back end (D51) and reuses that back end's
  gathering and type tracking, so a program compiles to both or to neither. Each definition is a
  C function of `V`s, a machine word. `Int` and `Bool` are themselves, sign-extended from 32 bits,
  and arithmetic wraps at 32 bits as in the interpreter. Any other constructed value points at a
  block `[tag, field…]` with a header word before it; a nullary constructor is a static block.

  Blocks are reference counted (D86), as in Perceus (Koka, Lean 4). The header holds the count
  and the block's kind. The code owns each local it binds and consumes it exactly once, so a block
  is freed the moment its last reference goes, and a `match` that takes apart a unique block it
  does not use again builds the case's new block in the old one's memory. Parameters that a
  function only reads through are borrowed, so passing them costs nothing. Every block lives in
  one reserved region, which tells blocks apart from integers without types. Cycles, which only
  `Ref` can make, are never freed.

  A call to itself in tail position is a jump back to the top of the function; a tail call of a
  function of the same arity is `musttail` where the C compiler has it (clang; gcc from 15), so
  mutual recursion in tail position runs in constant stack too.

  `Int.div` and `Int.mod` by zero trap, as in wasm.

  `Text` is a block of UTF-16 units with a C runtime ported from the Rust kernel (D115); a unique
  text that is appended to grows in place.
-/
/-- The C every unit starts with; `nullary` static blocks serve the nullary constructors' tags. -/
def CGen.prelude (nullary : Int) : Text := join
  "\n"
  ["#include <stdint.h>", "#if defined(__has_attribute) && __has_attribute(musttail)", "#define MUSTTAIL __attribute__((musttail))", "#else", "#define MUSTTAIL", "#endif", "#ifdef __wasm__", "/* wasm32: a value is 64 bits; a block is its address with bit 32 set, so integers need no tag (D86). */", "typedef int64_t V;", "#define BOX(p) ((V)(uintptr_t)(p) | ((V)1 << 32))", "#define UNBOX(v) ((V *)(uintptr_t)(uint32_t)(v))", "#define IS_PTR(v) ((uint64_t)(v) >> 32 == 1)", "#define EXPORT(name) __attribute__((export_name(name)))", "extern unsigned char __heap_base;", "/* With -nostdlib, clang still lowers fill and copy loops to these calls. */", "void *memset(void *d, int c, unsigned long n) { unsigned char *p = d; while (n--) *p++ = (unsigned char)c; return d; }", "void *memcpy(void *d, const void *s, unsigned long n) { unsigned char *p = d; const unsigned char *q = s; while (n--) *p++ = *q++; return d; }", "static V *deus_base, *deus_hp, *deus_hl;", "static void deus_init(void) { deus_base = deus_hp = (V *)(((uintptr_t)&__heap_base + 7) & ~(uintptr_t)7); deus_hl = (V *)(__builtin_wasm_memory_size(0) * 65536); }", "static V *deus_raw(V words) { V *p = deus_hp; deus_hp += words; while (deus_hp > deus_hl) { uintptr_t pages = __builtin_wasm_memory_size(0); if (__builtin_wasm_memory_grow(0, pages) == (uintptr_t)-1) __builtin_trap(); deus_hl = (V *)((pages * 2) * 65536); } return p; }", "#else", "#include <stdlib.h>", "#include <sys/mman.h>", "/* The heap is one reserved region, so a word is a block exactly when it points into it (D86). */", "typedef intptr_t V;", "#define BOX(p) ((V)(p))", "#define UNBOX(v) ((V *)(v))", "#define DEUS_HEAP ((V)1 << 36)", "#define EXPORT(name)", "static V *deus_base, *deus_hp, *deus_hl;", "#define IS_PTR(v) ((uintptr_t)(v) - (uintptr_t)deus_base < (uintptr_t)DEUS_HEAP)", "static void deus_init(void) { void *m = mmap(0, DEUS_HEAP, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0); if (m == MAP_FAILED) __builtin_trap(); deus_base = deus_hp = m; deus_hl = deus_base + DEUS_HEAP / (V)sizeof(V); }", "static V *deus_raw(V words) { V *p = deus_hp; deus_hp += words; if (deus_hp > deus_hl) __builtin_trap(); return p; }", "#endif", "/* Nullary constructors and () are static blocks, never counted. */", "#define STATIC(p) ((V)(uintptr_t)(p))", "#define W(x) ((V)(int32_t)(uint32_t)(x))", "#define ADD(a, b) W((uint32_t)(a) + (uint32_t)(b))", "#define SUB(a, b) W((uint32_t)(a) - (uint32_t)(b))", "#define MUL(a, b) W((uint32_t)(a) * (uint32_t)(b))", "#define SHL(a, b) W((uint32_t)(a) << ((b) & 31))", "#define SHR(a, b) ((V)((int32_t)(a) >> ((b) & 31)))", "#define USHR(a, b) W((uint32_t)(a) >> ((b) & 31))", "static inline V DIV(V a, V b) { if (b == 0) __builtin_trap(); return b == -1 ? SUB(0, a) : (V)((int32_t)a / (int32_t)b); }", "static inline V MOD(V a, V b) { if (b == 0) __builtin_trap(); return b == -1 ? 0 : (V)((int32_t)a % (int32_t)b); }", "static V deus_live, deus_peak;", "static V *deus_free_lists[257];", "/* Freed blocks over 256 words, as [next, words, …]: reused by an exact fit among the first 16. */", "static V *deus_big;", "static V *deus_big_take(V words) { V **link = &deus_big; for (int i = 0; *link && i < 16; i++, link = (V **)(uintptr_t)*link) { V *h = *link; if (h[1] == words) { *link = (V *)(uintptr_t)h[0]; return h; } } return 0; }", "/* A block's header, the word before it: its count times 256, plus its kind. */", "#define PHDR(p) ((p)[-1])", "#define HDR(v) PHDR(UNBOX(v))", "#define K_TEXT 253", "#define K_REF 254", "#define K_ARRAY 255", "#define UNIQUE(v) (HDR(v) < 512)", "static inline V *deus_block(V kind, V body) { V words = body + 1; V *h; deus_live += words; if (deus_live > deus_peak) deus_peak = deus_live; if (words <= 256 && (h = deus_free_lists[words])) deus_free_lists[words] = (V *)(uintptr_t)h[0]; else if (words <= 256 || !(h = deus_big_take(words))) h = deus_raw(words); h[0] = 256 | kind; return h + 1; }", "static inline V deus_body(V *p) { V k = PHDR(p) & 255; return k == K_ARRAY ? p[0] + 1 : k == K_REF ? 1 : k == K_TEXT ? 2 + (p[1] + 3) / 4 : k + 1; }", "static inline void deus_release(V *p) { V words = deus_body(p) + 1; deus_live -= words; if (words <= 256) { p[-1] = (V)(uintptr_t)deus_free_lists[words]; deus_free_lists[words] = p - 1; } else { p[-1] = (V)(uintptr_t)deus_big; p[0] = words; deus_big = p - 1; } }", "static V *deus_stack, deus_sp, deus_cap;", "static void deus_push(V v) { if (deus_sp == deus_cap) { V cap = deus_cap ? 2 * deus_cap : 1024; V *bigger = deus_raw(cap); for (V i = 0; i < deus_sp; i++) bigger[i] = deus_stack[i]; deus_stack = bigger; deus_cap = cap; } deus_stack[deus_sp++] = v; }", "static void deus_free(V *p) {", "  for (;;) {", "    V k = PHDR(p) & 255; V *from = k == K_REF ? p : p + 1; V n = k == K_ARRAY ? p[0] : k == K_REF ? 1 : k == K_TEXT ? 0 : k;", "    for (V i = 0; i < n; i++) { V c = from[i]; if (IS_PTR(c)) { if (!UNIQUE(c)) HDR(c) -= 256; else deus_push(c); } }", "    deus_release(p);", "    if (deus_sp == 0) return;", "    p = UNBOX(deus_stack[--deus_sp]);", "  }", "}", "static inline V deus_dup(V v) { if (IS_PTR(v)) HDR(v) += 256; return v; }", "static inline void deus_drop(V v) { if (IS_PTR(v)) { if (!UNIQUE(v)) HDR(v) -= 256; else deus_free(UNBOX(v)); } }", "/* A constructor block, in the memory of a dead block of the same size when there is one. */", "static inline V *deus_con(V *token, V fields) { if (token) { token[-1] = 256 | fields; return token; } return deus_block(fields, fields + 1); }", "/* A closure is a block [code, captured…]; the code borrows it and owns its argument. */", "typedef V (*deus_code)(V, V);", "static inline V deus_apply(V c, V x) { return ((deus_code)(uintptr_t)UNBOX(c)[0])(c, x); }", "static inline V deus_apply_drop(V c, V x) { V r = deus_apply(c, x); deus_drop(c); return r; }", "static inline void deus_unused(V *token) { if (token) deus_release(token); }", "static V deus_array(V n, V x) { if (n < 0) __builtin_trap(); V *p = deus_block(K_ARRAY, n + 1); p[0] = n; if (n == 0) deus_drop(x); else if (IS_PTR(x)) HDR(x) += 256 * (n - 1); for (V i = 1; i <= n; i++) p[i] = x; return BOX(p); }", "/* A pure `Array.set` (D96) writes into a unique array and copies a shared one, counting each item again. */", "static V deus_array_copy(V a) { V *q = UNBOX(a); V n = q[0]; V *p = deus_block(K_ARRAY, n + 1); p[0] = n; for (V i = 1; i <= n; i++) p[i] = deus_dup(q[i]); return BOX(p); }", "static inline V deus_array_unique(V a) { if (UNIQUE(a)) return a; V r = deus_array_copy(a); HDR(a) -= 256; return r; }", "#define AT(a, i) ({ V *a_ = UNBOX(a); V i_ = (i); if ((uint32_t)i_ >= (uint32_t)a_[0]) __builtin_trap(); &a_[i_ + 1]; })", "static V deus_nullary[" ++ toText (larger nullary 1) ++ "] = {" ++
    join ", " (List.map toText (range 0 (larger nullary 1))) ++ "};", "/* Text is a block [length, capacity, UTF-16 units…] (D115). These borrow their arguments. */", "#define TLEN(v) (UNBOX(v)[0])", "#define TCAP(v) (UNBOX(v)[1])", "#define TU(v) ((uint16_t *)(UNBOX(v) + 2))", "static V deus_text_cap(V n, V cap) { cap = (cap + 3) & ~(V)3; V *p = deus_block(K_TEXT, 2 + cap / 4); p[0] = n; p[1] = cap; return BOX(p); }", "static V deus_text(V n) { return deus_text_cap(n, n); }", "static void deus_units(uint16_t *d, const uint16_t *s, V n) { for (V i = 0; i < n; i++) d[i] = s[i]; }", "static V deus_text_of(const uint16_t *s, V n) { V r = deus_text(n); deus_units(TU(r), s, n); return r; }", "static V deus_text_append(V a, V b) { V m = TLEN(a), n = TLEN(b); if (n == 0) return deus_dup(a); if (m == 0) return deus_dup(b); V r = deus_text(m + n); deus_units(TU(r), TU(a), m); deus_units(TU(r) + m, TU(b), n); return r; }", "/* `a ++ b` that consumes `a`: a unique `a` grows in place, doubling its capacity when it is full, so a loop that appends to its text is linear. */", "static V deus_text_extend(V a, V b) { V m = TLEN(a), n = TLEN(b); if (n == 0) return a; if (IS_PTR(a) && UNIQUE(a)) { if (m + n <= TCAP(a)) { deus_units(TU(a) + m, TU(b), n); TLEN(a) = m + n; return a; } V r = deus_text_cap(m + n, 2 * (m + n)); deus_units(TU(r), TU(a), m); deus_units(TU(r) + m, TU(b), n); deus_release(UNBOX(a)); return r; } V r = deus_text_append(a, b); deus_drop(a); return r; }", "static V deus_text_cmp(V a, V b) { V m = TLEN(a), n = TLEN(b); uint16_t *x = TU(a), *y = TU(b); for (V i = 0; i < m && i < n; i++) if (x[i] != y[i]) return x[i] < y[i] ? -1 : 1; return m < n ? -1 : m > n ? 1 : 0; }", "static V deus_text_eq(V a, V b) { if (a == b) return 1; V n = TLEN(a); if (n != TLEN(b)) return 0; uint16_t *x = TU(a), *y = TU(b); for (V i = 0; i < n; i++) if (x[i] != y[i]) return 0; return 1; }", "static V deus_text_code(V t, V i) { return (uint32_t)i < (uint32_t)TLEN(t) ? (V)TU(t)[i] : -1; }", "static V deus_clamp(V i, V n) { return i < 0 ? (n + i < 0 ? 0 : n + i) : i > n ? n : i; }", "static V deus_text_slice(V t, V s, V e) { V n = TLEN(t), from = deus_clamp(s, n), to = deus_clamp(e, n); if (from == 0 && to == n) return deus_dup(t); return deus_text_of(TU(t) + from, from < to ? to - from : 0); }", "static V deus_text_from_code(V c) { uint16_t u = (uint16_t)c; return deus_text_of(&u, 1); }", "static V deus_text_index(V t, V needle, V from) { V n = TLEN(t), m = TLEN(needle), i = from < 0 ? 0 : from > n ? n : from; uint16_t *x = TU(t), *y = TU(needle); for (; i + m <= n; i++) { V j = 0; while (j < m && x[i + j] == y[j]) j++; if (j == m) return i; } return -1; }", "static int deus_space(uint16_t u) { return (u >= 9 && u <= 13) || u == 32 || u == 0xa0 || u == 0x1680 || (u >= 0x2000 && u <= 0x200a) || u == 0x2028 || u == 0x2029 || u == 0x202f || u == 0x205f || u == 0x3000 || u == 0xfeff; }", "static V deus_text_trim(V t) { V n = TLEN(t), s = 0, e = n; uint16_t *x = TU(t); while (s < n && deus_space(x[s])) s++; while (e > s && deus_space(x[e - 1])) e--; return deus_text_slice(t, s, e); }", "/* A list is nil, the static block [0], or a block [1, head, tail]. */", "static V deus_text_join(V sep, V xs) { V n = 0, k = 0; for (V c = xs; UNBOX(c)[0]; c = UNBOX(c)[2], k++) n += TLEN(UNBOX(c)[1]); if (k == 1) return deus_dup(UNBOX(xs)[1]); if (k > 1) n += (k - 1) * TLEN(sep); V r = deus_text(n); uint16_t *d = TU(r); for (V c = xs; UNBOX(c)[0]; c = UNBOX(c)[2]) { if (c != xs) { deus_units(d, TU(sep), TLEN(sep)); d += TLEN(sep); } V h = UNBOX(c)[1]; deus_units(d, TU(h), TLEN(h)); d += TLEN(h); } return r; }", "static V deus_cons(V h, V t) { V *p = deus_block(2, 3); p[0] = 1; p[1] = h; p[2] = t; return BOX(p); }", "static V deus_text_split(V t, V sep) { V n = TLEN(t), m = TLEN(sep), r, *slot = &r; uint16_t *x = TU(t), *y = TU(sep); if (m == 0) { for (V i = 0; i < n; i++) { V c = deus_cons(deus_text_of(x + i, 1), 0); *slot = c; slot = &UNBOX(c)[2]; } } else { V start = 0, i = 0; while (i + m <= n) { V j = 0; while (j < m && x[i + j] == y[j]) j++; if (j == m) { V c = deus_cons(deus_text_of(x + start, i - start), 0); *slot = c; slot = &UNBOX(c)[2]; i += m; start = i; } else i++; } V c = deus_cons(deus_text_of(x + start, n - start), 0); *slot = c; slot = &UNBOX(c)[2]; } *slot = STATIC(&deus_nullary[0]); return r; }", "static V deus_int_text(V v) { uint16_t u[12]; int k = 12; uint32_t m = (int32_t)v < 0 ? 0u - (uint32_t)v : (uint32_t)v; do { u[--k] = (uint16_t)('0' + m % 10); m /= 10; } while (m); if ((int32_t)v < 0) u[--k] = '-'; return deus_text_of(u + k, 12 - k); }", "/* `/^-?[0-9]+$/`, then wrapped to 32 bits as `Number(t) | 0` is (exactly, below 2^53). */", "static V deus_text_int(V t) { V n = TLEN(t), i = 0; uint16_t *x = TU(t); int neg = n > 0 && x[0] == '-'; if (neg) i = 1; if (i == n) return STATIC(&deus_nullary[0]); uint32_t m = 0; for (; i < n; i++) { if (x[i] < '0' || x[i] > '9') return STATIC(&deus_nullary[0]); m = m * 10 + (x[i] - '0'); } V *p = deus_block(1, 2); p[0] = 1; p[1] = W(neg ? 0u - m : m); return BOX(p); }", "/* A literal is made once, on first use, with a count no program brings to one, and is not counted as live. */", "static V deus_literal(const uint16_t *u, V n) { V r = deus_text_of(u, n); HDR(r) = ((V)1 << 48) | K_TEXT; deus_live -= deus_body(UNBOX(r)) + 1; return r; }", "/* Values whose type the compiler does not know: a text is a heap block of kind K_TEXT, an Int is not a block. */", "#define IS_TEXT(v) (IS_PTR(v) && (HDR(v) & 255) == K_TEXT)", "static V deus_cmp_any(V a, V b) { if (IS_TEXT(a) && IS_TEXT(b)) return deus_text_cmp(a, b); if (IS_PTR(a) || IS_PTR(b)) __builtin_trap(); return (a > b) - (a < b); }", "static V deus_eq_any(V a, V b) { if (IS_TEXT(a) && IS_TEXT(b)) return deus_text_eq(a, b); if (IS_PTR(a) || IS_PTR(b)) __builtin_trap(); return a == b; }", "static V deus_text_concat(V xs) { static struct { V h, n, cap; } empty = {0, 0, 0}; return deus_text_join(STATIC(&empty.n), xs); }", "static inline V deus_int_cmp(V x, V y) { return (x > y) - (x < y); }", "/* `++` on lists: the unique prefix of the first list is relinked in place, the rest copied (D115). Consumes both. */", "static V deus_list_append(V a, V b) { V r, *slot = &r, c = a; int mine = 1; while (UNBOX(c)[0]) { V *p = UNBOX(c); if (mine && UNIQUE(c)) { *slot = c; slot = &p[2]; } else { if (mine) HDR(c) -= 256; mine = 0; V n = deus_cons(deus_dup(p[1]), 0); *slot = n; slot = &UNBOX(n)[2]; } c = p[2]; } *slot = b; return r; }", "static V deus_append_any(V a, V b) { if (IS_TEXT(a)) { V r = deus_text_extend(a, b); deus_drop(b); return r; } return deus_list_append(a, b); }", ""]

/-- How many arguments a primitive the C back end compiles takes, or 0. -/
def CGen.primArity (p : Text) : Int := if any
  (fun x => x == p)
  ["Text.length", "Text.fromCode", "Text.concat", "Text.trim", "Int.toText", "Int.fromText"] then 1 else if any (fun x => x == p) ["Text.slice", "Text.indexOf"] then 3 else if isSome (macro p) || isSome (infix p) || any (fun x => x == p) ["Text.code", "Text.join", "Text.split", "append", "compare"] then 2 else 0

/-- A primitive. `Array` is a block `[length, item…]` and `Ref` a block `[value]` (D83). Their
  first argument is borrowed when it is a local used again later, so a read does not touch its
  count; otherwise it is dropped after the access. Reads `deus_dup` what they return; the writes
  drop what they overwrite. `Ref.set` returns `()`; `Array.set` is pure (D96) and returns the
  array, written in place when the code holds its only reference, else a copy. -/
def CGen.primitive (ctx : FnCtx) (env : List Int) (owned : List Int) (token : Option CGen.Token) (e : Sexp) (p : Text) (xs : List Sexp) : {Throw Text} Text :=
  -- The container is a local the code still needs afterwards: borrow it rather than count it.
  let borrowed := if startsWith "Array." p || startsWith "Ref." p then
    match head? xs with
    | Option.some (Sexp.list (Sexp.sym "var" :: Sexp.int i :: [])) =>
        match get? env i with
        | Option.some l => if isIn owned l then -1 else l
        | Option.none => -1
    | _ => -1
  else -1
  let evaluated := if borrowed >= 0 && p != "Ref.new" && p != "Array.make" then
    match CGen.sequence ctx env owned token [] (List.drop 1 xs) with
    | (decls, values, _) => (decls, CGen.local borrowed :: values, true)
  else
    match CGen.sequence ctx env owned token [] xs with
    | (decls, values, _) => (decls, values, false)
  -- What a read returns is counted again, unless it is an `Int` or a `Bool`.
  let share := if uncounted (Wasm.typeOf ctx.cScope env e) then "" else "deus_dup"
  let item :=
    match xs with
    | a :: _ => Wasm.typeArgs (Wasm.typeOf ctx.cScope env a)
    | [] => []
  let dropOld := if List.all uncounted item && not (List.isEmpty item) then "" else "deus_drop(old); "
  match evaluated with
  | (decls, vs, isBorrowed) =>
      let release :=
        match head? vs with
        | Option.some c => if isBorrowed then "" else "deus_drop(" ++ c ++ "); "
        | Option.none => ""
      let unit := "STATIC(&deus_nullary[0])"
      let block := fun code => "({ " ++ decls ++ code ++ "; })"
      match (p, vs, xs) with
      | ("Array.make", n :: x :: [], _) => block ("deus_array(" ++ n ++ ", " ++ x ++ ")")
      | ("Array.length", a :: [], _) => block ("V r = UNBOX(" ++ a ++ ")[0]; " ++ release ++ "r")
      | ("Array.get", a :: i :: [], _) => block ("V r = " ++ share ++ "(*AT(" ++ a ++ ", " ++ i ++ ")); " ++ release ++ "r")
      | ("Array.set", a :: i :: x :: [], _) =>
          -- An array the code owns passes its reference to the result; a borrowed one is copied.
          let target := if isBorrowed then "deus_array_copy(" ++ a ++ ")" else "deus_array_unique(" ++ a ++ ")"
          block ("V r = " ++ target ++ "; V *s = AT(r, " ++ i ++ "); V old = *s; *s = " ++ x ++ "; " ++
            dropOld ++ "r")
      | ("Ref.new", x :: [], _) => block ("V *r = deus_block(K_REF, 1); r[0] = " ++ x ++ "; BOX(r)")
      | ("Ref.get", r :: [], _) => block ("V v = " ++ share ++ "(UNBOX(" ++ r ++ ")[0]); " ++ release ++ "v")
      | ("Ref.set", r :: x :: [], _) => block ("V old = UNBOX(" ++ r ++ ")[0]; UNBOX(" ++ r ++ ")[0] = " ++ x ++ "; " ++ dropOld ++ release ++
          unit)
      | (_, ca :: cb :: [], a :: b :: []) =>
          let ta := Wasm.typeOf ctx.cScope env a
          let tb := Wasm.typeOf ctx.cScope env b
          if isComparison p && not (isScalar ta || isScalar tb) then Throw.throw (p ++
            " on values that are not known to be Int or Bool is outside the C subset, since it would compare addresses: " ++ Text.take 120 (Sexp.print e)) else
            match (macro p, infix p) with
            | (Option.some m, _) => block (m ++ "(" ++ ca ++ ", " ++ cb ++ ")")
            | (_, Option.some op) => block ("(V)(" ++ ca ++ " " ++ op ++ " " ++ cb ++ ")")
            | _ => Throw.throw ("the primitive " ++ p ++ " is outside the C subset")
      | _ => Throw.throw ("the primitive " ++ p ++ " is outside the C subset")

def CGen.registerStruct (scope : Wasm.Scope) (t : Sexp) : Int :=
  let known := Ref.get scope.eqs
  Ref.set scope.eqs (known ++ [t])
  List.length known

/-- A primitive the C runtime implements (D115): those on `Text`, `++` on texts and on lists, and
  comparisons of texts by their UTF-16 units, as JavaScript orders strings. None for the others. -/
def CGen.runtime (ctx : FnCtx) (env : List Int) (owned : List Int) (token : Option CGen.Token) (p : Text) (xs : List Sexp) : {Throw Text} Option Text :=
  let types := List.map (Wasm.typeOf ctx.cScope env) xs
  let isText := any (fun t => t == tref "#Text") types
  let isList := any (fun t => headName t == Option.some "#List") types
  -- Unknown (a lifted function's parameter) or a type variable (a hash whose names differ in type, D116).
  let isDynamic := not (List.isEmpty types) && List.all (fun t => t == unknown || head t == "tvar") types
  let data := List.find (fun t => isData ctx.cScope t) types
  let lend := fun call => Option.some (lending ctx env owned token (List.map (fun _ => true) xs) call xs)
  match textFunction p with
  | Option.some f => lend (fun vs => f ++ CGen.args vs)
  | Option.none => if p == "append" && isText then Option.some (lending ctx env owned token [false, true] (fun vs => "deus_text_extend" ++ CGen.args vs) xs) else if p == "append" && isList then
      match CGen.sequence ctx env owned token [] xs with
      | (decls, values, _) => Option.some ("({ " ++ decls ++ "deus_list_append" ++ CGen.args values ++ "; })")
    else if p == "append" && isDynamic then
      match CGen.sequence ctx env owned token [] xs with
      | (decls, values, _) => Option.some ("({ " ++ decls ++ "deus_append_any" ++ CGen.args values ++ "; })")
    else if p == "append" then Throw.throw "++ on values not known to be Text or a List is outside the C subset" else if p == "compare" && isText then lend (fun vs => "deus_text_cmp" ++ CGen.args vs) else if p == "compare" && List.all isScalar types then lend (fun vs => "deus_int_cmp" ++ CGen.args vs) else if p == "eq" && isText then lend (fun vs => "deus_text_eq" ++ CGen.args vs) else if p == "neq" && isText then lend (fun vs => "!deus_text_eq" ++ CGen.args vs) else if isSome data && (isComparison p || p == "compare") then
      let k := toText (structIndex ctx.cScope (getOr data unknown))
      if p == "eq" then lend (fun vs => "deus_eq" ++ k ++ CGen.args vs) else if p == "neq" then lend (fun vs => "!deus_eq" ++ k ++ CGen.args vs) else if p == "compare" then lend (fun vs => "deus_cmp" ++ k ++ CGen.args vs) else
        match infix p with
        | Option.some op => lend (fun vs => "(V)(deus_cmp" ++ k ++ CGen.args vs ++ " " ++ op ++ " 0)")
        | Option.none => Option.none
    else if p == "compare" && isDynamic then lend (fun vs => "deus_cmp_any" ++ CGen.args vs) else if p == "eq" && isDynamic then lend (fun vs => "deus_eq_any" ++ CGen.args vs) else if p == "neq" && isDynamic then lend (fun vs => "!deus_eq_any" ++ CGen.args vs) else if isDynamic && isComparison p then
      match infix p with
      | Option.some op => lend (fun vs => "(V)(deus_cmp_any" ++ CGen.args vs ++ " " ++ op ++ " 0)")
      | Option.none => Option.none
    else if isText && isComparison p then
      match infix p with
      | Option.some op => lend (fun vs => "(V)(deus_text_cmp" ++ CGen.args vs ++ " " ++ op ++ " 0)")
      | Option.none => Option.none
    else Option.none

def CGen.scalarLocal (ctx : FnCtx) (l : Int) : Bool := uncounted (typeOfLocal ctx.cScope l)

/-- Each of `xs`, evaluated in order into a fresh local: the declarations, the C for each value,
  and the drops to run after the values are used. An argument in a position `borrows` marks is
  not counted: a local is passed as it is, and anything else is dropped afterwards. -/
def CGen.sequence (ctx : FnCtx) (env : List Int) (owned : List Int) (token : Option CGen.Token) (borrows : List Bool) (xs : List Sexp) : {Throw Text} (Text, (List Text, Text)) :=
  let last := CGen.split owned (List.map (freeLocals env) xs)
  let movers := List.map (fun l => (l, mover ctx env xs l)) owned
  let shares := mapIndexed (fun k here => List.filter (fun l =>
    match Option.bind (List.lookup l movers) (fun m => m) with
    | Option.some m => m == k
    | Option.none => isIn here l) owned) last
  let tokens := hand token xs
  let parts := mapIndexed (fun k triple =>
    match triple with
    | ((x, mine), tok) =>
        -- A borrowed local is passed as it is, unless a later argument consumes it first.
        let consumedLater := List.concat (List.drop (k + 1) shares)
        let direct :=
          match x with
          | Sexp.list (Sexp.sym "var" :: Sexp.int i :: []) => if borrowsAt borrows k then Option.bind
              (get? env i)
              (fun l => if isIn consumedLater l then Option.none else Option.some l) else Option.none
          | _ => Option.none
        match direct with
        | Option.some l => ("", CGen.local l, if isIn mine l then dropLocal ctx l else "")
        | Option.none =>
            let l := CGen.fresh ctx
            setType ctx.cScope l (Wasm.typeOf ctx.cScope env x)
            ("V " ++ CGen.local l ++ " = " ++ CGen.expr ctx env false mine tok x ++ "; ", CGen.local l, if borrowsAt borrows k then dropLocal ctx l else "")) (zip (zip xs shares) tokens)
  (Text.concat (List.map (fun t =>
    match t with
    | (d, _, _) => d) parts), List.map (fun t =>
    match t with
    | (_, v, _) => v) parts, Text.concat (List.map (fun t =>
    match t with
    | (_, _, a) => a) parts))

/-- `e` with its variables from index `cut` up moved `amount` further out, as under `amount` more binders. -/
def CGen.shift (amount : Int) (cut : Int) (e : Sexp) : Sexp :=
  match e with
  | Sexp.list (Sexp.sym "var" :: Sexp.int i :: []) => if i >= cut then Sexp.list [Sexp.sym "var", Sexp.int (i + amount)] else e
  | Sexp.list (Sexp.sym "lam" :: b :: []) => Sexp.list [Sexp.sym "lam", CGen.shift amount (cut + 1) b]
  | Sexp.list (Sexp.sym "let" :: v :: b :: []) => Sexp.list [Sexp.sym "let", CGen.shift amount cut v, CGen.shift amount (cut + 1) b]
  | Sexp.list (Sexp.sym "letrec" :: Sexp.list fs :: b :: []) =>
      let n := List.length fs
      Sexp.list [Sexp.sym "letrec", Sexp.list (List.map (CGen.shift amount (cut + n)) fs), CGen.shift amount (cut + n) b]
  | Sexp.list (Sexp.sym "match" :: scrutinee :: cases) => Sexp.list (Sexp.sym "match" :: CGen.shift amount cut scrutinee :: List.map (fun c =>
      match c with
      | Sexp.list (Sexp.sym "case" :: pat :: b :: []) => Sexp.list [Sexp.sym "case", pat, CGen.shift amount (cut + CGen.binders pat) b]
      | other => other) cases)
  | Sexp.list items => Sexp.list (List.map (CGen.shift amount cut) items)
  | _ => e

/-- For expressions evaluated in order, the owned locals each one consumes: its last uses. -/
def CGen.split (owned : List Int) (frees : List (List Int)) : List (List Int) :=
  match frees with
  | [] => []
  | here :: later => List.filter (fun l => isIn here l && not (any (fun f => isIn f l) later)) owned :: CGen.split owned later

/-- The structural equality (or, with `order`, the order) of data type `t`, as both kernels define
  it: the tags first, then the fields in order. The last field, when it is `t` again (a list's
  tail), is a loop rather than a call, so a long list takes no stack. -/
def CGen.structFunction (scope : Wasm.Scope) (order : Bool) (k : Int) (t : Sexp) : {Throw Text} Text :=
  let form := getOr (Option.bind (headName t) (typeObject scope)) unknown
  let typeArgs := Wasm.typeArgs t
  let same := if order then "0" else "1"
  let cases := mapIndexed (fun tag fields =>
    let typed := List.map (Wasm.instantiate typeArgs) fields
    let n := List.length typed
    let field := fun i f =>
      let x := "UNBOX(a)[" ++ toText (i + 1) ++ "]"
      let y := "UNBOX(b)[" ++ toText (i + 1) ++ "]"
      if i == n - 1 && f == t then "a = " ++ x ++ "; b = " ++ y ++ "; continue; " else if i == n - 1 then "return " ++ fieldTest scope order f x y ++ "; " else if order then "{ V c = " ++ fieldTest scope order f x y ++ "; if (c) return c; } " else "if (!" ++ fieldTest scope order f x y ++ ") return 0; "
    if n == 0 then "" else "case " ++ toText tag ++ ": " ++ Text.concat (mapIndexed field typed)) (Wasm.ctorFields form)
  let differ := if order then "ta < tb ? -1 : 1" else "0"
  "static V " ++ (if order then "deus_cmp" else "deus_eq") ++ toText k ++
    "(V a, V b) { for (;;) { if (a == b) return " ++ same ++ "; V ta = UNBOX(a)[0], tb = UNBOX(b)[0]; if (ta != tb) return " ++ differ ++ "; switch (ta) { " ++ Text.concat cases ++ "default: return " ++ same ++ "; } } }"

/-- The comparison functions of every data type registered from index `k`, registering what they compare in turn. -/
def CGen.structFunctions (scope : Wasm.Scope) (k : Int) (acc : List Text) : {Throw Text} List Text :=
  match get? (Ref.get scope.eqs) k with
  | Option.some t => CGen.structFunctions
      scope
      (k + 1)
      (acc ++ [structFunction scope false k t, structFunction scope true k t])
  | Option.none => acc

/-- The index of the equality and order functions of data type `t`, registering them on first use. -/
def CGen.structIndex (scope : Wasm.Scope) (t : Sexp) : Int :=
  let known := Ref.get scope.eqs
  let i := findIndex (fun x => x == t) known
  if i >= 0 then i else registerStruct scope t

/-- `e` with each variable `i` bound outside it replaced by `sub i`, a term outside `e`'s binders. -/
def CGen.subst (depth : Int) (sub : Int -> Sexp) (e : Sexp) : Sexp :=
  let again := fun d x => CGen.subst d sub x
  match e with
  | Sexp.list (Sexp.sym "var" :: Sexp.int i :: []) => if i < depth then e else shift depth 0 (sub (i - depth))
  | Sexp.list (Sexp.sym "lam" :: b :: []) => Sexp.list [Sexp.sym "lam", again (depth + 1) b]
  | Sexp.list (Sexp.sym "let" :: v :: b :: []) => Sexp.list [Sexp.sym "let", again depth v, again (depth + 1) b]
  | Sexp.list (Sexp.sym "letrec" :: Sexp.list fs :: b :: []) =>
      let n := List.length fs
      Sexp.list [Sexp.sym "letrec", Sexp.list (List.map (again (depth + n)) fs), again (depth + n) b]
  | Sexp.list (Sexp.sym "match" :: scrutinee :: cases) => Sexp.list (Sexp.sym "match" :: again depth scrutinee :: List.map (fun c =>
      match c with
      | Sexp.list (Sexp.sym "case" :: pat :: b :: []) => Sexp.list [Sexp.sym "case", pat, again (depth + CGen.binders pat) b]
      | other => other) cases)
  | Sexp.list items => Sexp.list (List.map (again depth) items)
  | _ => e

/-- The runtime function of a primitive on `Text` (D115). -/
def CGen.textFunction (p : Text) : Option Text := List.lookup
  p
  [("Text.length", "TLEN"), ("Text.code", "deus_text_code"), ("Text.slice", "deus_text_slice"), ("Text.fromCode", "deus_text_from_code"), ("Text.concat", "deus_text_concat"), ("Text.join", "deus_text_join"), ("Text.split", "deus_text_split"), ("Text.indexOf", "deus_text_index"), ("Text.trim", "deus_text_trim"), ("Int.toText", "deus_int_text"), ("Int.fromText", "deus_text_int")]

/-- A Text literal (D115): made on first use and kept, so it is a heap block like any other text. -/
def CGen.textLiteral (t : Text) : Text :=
  let n := Text.length t
  let units := if n == 0 then "0" else join ", " (List.map (fun i => toText (code t i)) (range 0 n))
  "({ static V s_; static const uint16_t u_[" ++ toText (larger n 1) ++ "] = {" ++ units ++
    "}; s_ ? s_ : (s_ = deus_literal(u_, " ++ toText n ++ ")); })"

def CGen.tokenName (t : CGen.Token) : Text := "t" ++ toText t.tokLocal

/-- Whether values of type `t` are never counted: `Int` and `Bool` are not blocks, and `()` is static. -/
def CGen.uncounted (t : Sexp) : Bool := isScalar t || t == tref "#Unit"

/-- The C translation unit: every function, and `export` as an `int32_t` entry point. -/
def CGen.unit (fns : List Fn) (datatypes : List (Text, Sexp)) (export : Text) : {Throw Text} Text :=
  let borrow := inferBorrow fns
  let lifted := Ref.new []
  let structs := Ref.new []
  let decls := mapIndexed (fun i f => "static V " ++ fnName i ++ CGen.params f.fnArity ++ ";") fns
  let bodies := mapIndexed (fun i f =>
    let scope := Wasm.Scope.mk
      fns
      datatypes
      (Ref.new (mapIndexed (fun j t => (j, t)) (fst (peel f.fnArity f.fnType))))
      structs
    let ctx := FnCtx.mk scope i f.fnArity (Ref.new f.fnArity) borrow lifted
    let env := reverse (range 0 f.fnArity)
    "/* #" ++ Text.take 10 f.fnHash ++ " */\nstatic V " ++ fnName i ++ CGen.params f.fnArity ++
      " {\ntop:;\n  " ++ CGen.expr
      ctx
      env
      true
      (List.filter (fun k => not (borrowsAt (borrowsOf ctx i) k)) (range 0 f.fnArity))
      Option.none
      f.fnBody ++ "\n}") fns
  let arity := getOr (Option.map (fun f => f.fnArity) (head? fns)) 0
  let inputs := range 0 arity
  let entry := "EXPORT(\"" ++ export ++ "\") int32_t " ++ export ++
    CGen.args (List.map (fun i => "int32_t a" ++ toText i) inputs) ++ " { if (!deus_base) deus_init(); return (int32_t)f0" ++ CGen.args (List.map (fun i => "(V)a" ++ toText i) inputs) ++ "; }"
  let result :=
    match head? fns with
    | Option.some f => snd (peel f.fnArity f.fnType)
    | Option.none => unknown
  let argv := List.map (fun i => "(int32_t)atol(argv[" ++ toText (i + 1) ++ "])") inputs
  -- A Text result prints as the interpreter shows it: JSON, in UTF-8.
  let run := if result == tref "#Text" then "  deus_init(); V r = f0" ++ CGen.args (List.map (fun a => "(V)" ++ a) argv) ++
    "; deus_print_text(r); deus_drop(r);" else "  printf(\"%d\\n\", " ++ export ++ CGen.args argv ++ ");"
  let main := join
    "\n"
    ["#ifdef __wasm__", "EXPORT(\"deus_live\") int32_t deus_live_words(void) { return (int32_t)deus_live; }", "#elif defined(DEUS_MAIN)", "#include <stdio.h>", "static void deus_print_text(V t) { V n = TLEN(t); uint16_t *x = TU(t); putchar('\"'); for (V i = 0; i < n; i++) { uint32_t u = x[i]; if (u == '\"' || u == '\\\\') { putchar('\\\\'); putchar(u); } else if (u == '\\n') fputs(\"\\\\n\", stdout); else if (u == '\\r') fputs(\"\\\\r\", stdout); else if (u == '\\t') fputs(\"\\\\t\", stdout); else if (u == 8) fputs(\"\\\\b\", stdout); else if (u == 12) fputs(\"\\\\f\", stdout); else if (u < 32) printf(\"\\\\u%04x\", u); else if (u >= 0xd800 && u < 0xdc00 && i + 1 < n && x[i + 1] >= 0xdc00 && x[i + 1] < 0xe000) { uint32_t c = 0x10000 + ((u - 0xd800) << 10) + (x[++i] - 0xdc00); putchar(0xf0 | c >> 18); putchar(0x80 | (c >> 12 & 63)); putchar(0x80 | (c >> 6 & 63)); putchar(0x80 | (c & 63)); } else if (u >= 0xd800 && u < 0xe000) printf(\"\\\\u%04x\", u); else if (u < 0x80) putchar(u); else if (u < 0x800) { putchar(0xc0 | u >> 6); putchar(0x80 | (u & 63)); } else { putchar(0xe0 | u >> 12); putchar(0x80 | (u >> 6 & 63)); putchar(0x80 | (u & 63)); } } puts(\"\\\"\"); }", "int main(int argc, char **argv) {", "  if (argc != " ++ toText (arity + 1) ++ ") { fprintf(stderr, \"usage: %s" ++
      Text.concat (List.map (fun _ => " <int>") inputs) ++ "\\n\", argv[0]); return 2; }", run, "  if (getenv(\"DEUS_HEAP_STATS\")) fprintf(stderr, \"heap: %ld words bumped, %ld live, %ld peak\\n\", (long)(deus_hp - deus_base), (long)deus_live, (long)deus_peak);", "  return 0;", "}", "#endif"]
  let nullary := foldl (fun acc f => larger acc (nullaryCount f.fnBody)) 0 fns
  let codes := Ref.get lifted
  let codeDecls := mapIndexed (fun k _ => "static V c" ++ toText k ++ "(V, V);") codes
  let comparisons := structFunctions (Wasm.Scope.mk fns datatypes (Ref.new []) structs) 0 []
  let comparisonDecls := mapIndexed
    (fun k _ => "static V deus_eq" ++ toText k ++ "(V, V); static V deus_cmp" ++ toText k ++ "(V, V);")
    (Ref.get structs)
  join
    "\n"
    ([CGen.prelude nullary] ++ decls ++ codeDecls ++ comparisonDecls ++ [""] ++ bodies ++ codes ++
      comparisons ++ ["", entry, main, ""])

def CGen.var (i : Int) : Sexp := Sexp.list [Sexp.sym "var", Sexp.int i]

/-- Whether `e` builds a block of `n` fields, which a dead block of that size can become. -/
def CGen.wants (n : Int) (e : Sexp) : Bool :=
  match e with
  | Sexp.list (Sexp.sym "app" :: Sexp.list (Sexp.sym "con" :: Sexp.str t :: Sexp.int _ :: Sexp.int k :: []) :: rest) => k == n && t != "#Bool" || any (CGen.wants n) rest
  | Sexp.list (Sexp.sym "lam" :: _ :: []) => false
  | Sexp.list items => any (CGen.wants n) items
  | _ => false
