/-- The `perf` block type. -/
@[ext "org.dxos.deus.perf@1.0"]
def Perf.check (b : Block) : {MdlHost} List Text :=
  match List.lookup "run" b.props with
  | Option.none => ["perf needs run:"]
  | Option.some run =>
      match List.lookup "sizes" b.props with
      | Option.none =>
          match MdlHost.cost run with
          | Result.ok steps => overBudget b steps
          | Result.err message => [message]
      | Option.some sizes =>
          let parsed := List.map (fun s => fromText (trim s)) (Text.split sizes "|")
          if any isNone parsed then ["sizes: " ++ sizes ++ " is not a list of numbers like 10 | 20 | 40"] else scaling b run (filterMap (fun s => s) parsed)

/-- An order's growth function at `n`; none for an order this extension does not know. -/
def Perf.growth (order : Text) (n : Int) : Option Int := if order == "1" then Option.some 1 else if order == "log n" then Option.some (log2 n) else if order == "n" then Option.some n else if order == "n log n" then Option.some (n * log2 n) else if order == "n^2" then Option.some (n * n) else Option.none

/-
  Performance requirements as MDL blocks (D46). Costs are machine steps, which are deterministic
  and the same on every kernel, so a requirement is a test with a verdict, not a benchmark with a
  tolerance for noise.

    ```mdl
    perf P-1: insertion sort is quadratic
      run: fun n => Sort.isort (List.reverse (List.range 0 n))
      sizes: 20 | 40 | 80
      order: n^2
      budget: 50000
    ```

  - `run:` an expression; with `sizes:` a function of the size, applied to each.
  - `budget:` the most steps `run` may take (at the largest size).
  - `order:` `1`, `log n`, `n`, `n log n` or `n^2`: from one size to the next the cost may grow
    by at most the order's ratio, plus 25% for lower-order terms.
-/
def Perf.log2 (n : Int) : Int := if n <= 2 then 1 else 1 + Perf.log2 (n / 2)

def Perf.overBudget (b : Block) (steps : Int) : List Text :=
  match List.lookup "budget" b.props with
  | Option.none => []
  | Option.some text =>
      match fromText text with
      | Option.none => ["budget: " ++ text ++ " is not a number of steps"]
      | Option.some limit => if steps <= limit then [] else ["took " ++ toText steps ++ " steps; the budget is " ++ text]

def Perf.pairs (xs : List a) : List (a, a) :=
  match xs with
  | x :: y :: rest => (x, y) :: Perf.pairs (y :: rest)
  | _ => []

/-- A ratio scaled by 100, as `x.yz`. -/
def Perf.ratio (hundredths : Int) : Text :=
  let cents := hundredths % 100
  toText (hundredths / 100) ++ (if cents < 10 then ".0" else ".") ++ toText cents

def Perf.scaling (b : Block) (run : Text) (sizes : List Int) : {MdlHost} List Text :=
  let samples := List.map (fun n => (n, MdlHost.cost ("(" ++ run ++ ") " ++ toText n))) sizes
  let failed := filterMap (fun s =>
    match snd s with
    | Result.err message => Option.some message
    | Result.ok _ => Option.none) samples
  if not (List.isEmpty failed) then failed else
    let costs := filterMap (fun s =>
      match s with
      | (n, Result.ok steps) => Option.some (n, steps)
      | _ => Option.none) samples
    let largest := foldl (fun _ s => snd s) 0 costs
    let growthProblems :=
      match List.lookup "order" b.props with
      | Option.none => []
      | Option.some order => concatMap (fun p => tooFast order (fst p) (snd p)) (pairs costs)
    growthProblems ++ overBudget b largest

/-- Whether the cost grows no faster than `order` between two (size, steps) samples. -/
def Perf.tooFast (order : Text) (small : (Int, Int)) (large : (Int, Int)) : List Text :=
  match (small, large) with
  | ((n1, c1), n2, c2) =>
      match (growth order n1, growth order n2) with
      | (Option.some g1, Option.some g2) =>
          let observed := c2 * 100 / (if c1 < 1 then 1 else c1)
          let allowed := g2 * 125 / g1
          if observed <= allowed then [] else ["cost grew x" ++ ratio observed ++ " from n=" ++ toText n1 ++ " to n=" ++ toText n2 ++
            " (" ++ toText c1 ++ " -> " ++ toText c2 ++ " steps); order " ++ order ++ " allows x" ++ ratio allowed]
      | _ => ["order: " ++ order ++ " is not one of 1, log n, n, n log n, n^2"]
