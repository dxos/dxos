def Lexer.escape (e : Int) : Int := if e == 110 then 10 else if e == 116 then 9 else if e == 114 then 13 else if e == 48 then 0 else e

/-- Lexer failures are checked errors: callers handle `Throw Text`. -/
def Lexer.fail (line : Int) (col : Int) (message : Text) : {Throw Text} a := Throw.throw (toText line ++ ":" ++ toText col ++ ": " ++ message)

def Lexer.hexValue (c : Int) : Int := if isDigit c then c - 48 else if c >= 97 && c <= 102 then c - 97 + 10 else c - 65 + 10

def Lexer.isHex (c : Int) : Bool := isDigit c || c >= 97 && c <= 102 || c >= 65 && c <= 70

def Lexer.isIdentPart (c : Int) : Bool := isIdentStart c || isDigit c || c == 39 || c == 63 || c == 33

def Lexer.isIdentStart (c : Int) : Bool := isAlpha c || c == 95 || c >= 880 && c <= 1023

def Lexer.keywords : Dict Text Unit := dict ["def", "theorem", "test", "inductive", "structure", "ability", "namespace", "end", "open", "match", "with", "fun", "let", "rec", "if", "then", "else", "handle", "return", "by", "sorry", "where", "do", "prim", "true", "false"]

def Lexer.lex (source : Text) : {Throw Text} List Token :=
  let n := Text.length source
  let at := fun i => code source i
  let rec identEnd i :=
    let c := at i
    if isIdentPart c then identEnd (i + 1) else if c == 46 && isIdentStart (at (i + 1)) then identEnd (i + 1) else i
  let rec digitsEnd i := if isDigit (at i) || at i == 95 then digitsEnd (i + 1) else i
  let rec hexEnd i := if Lexer.isHex (at i) || at i == 95 then hexEnd (i + 1) else i
  let rec lineEnd i := if i >= n || at i == 10 then i else lineEnd (i + 1)
  let rec commentEnd i depth line lineStart := if i >= n then (i, line, lineStart) else if at i == 47 && at (i + 1) == 45 then commentEnd (i + 2) (depth + 1) line lineStart else if at i == 45 && at (i + 1) == 47 then if depth == 1 then (i + 2, line, lineStart) else commentEnd (i + 2) (depth - 1) line lineStart else if at i == 10 then commentEnd (i + 1) depth (line + 1) (i + 1) else commentEnd (i + 1) depth line lineStart
  let rec stringEnd i acc line lineStart :=
    let c := at i
    if i >= n then Lexer.fail line 0 "unterminated string" else if c == 34 then (fromCodes (reverse acc), i + 1, line, lineStart) else if c == 92 then
      let e := at (i + 1)
      if e == 117 && at (i + 2) == 123 then
        let rec digitsEnd1 j := if Lexer.isHex (at j) then digitsEnd1 (j + 1) else j
        let close := digitsEnd1 (i + 3)
        if close == i + 3 || at close != 125 then Lexer.fail line 0 "malformed \\u{} escape" else
          let code := foldl (fun v d => v * 16 + Lexer.hexValue d) 0 (List.map at (range (i + 3) close))
          stringEnd (close + 1) (code :: acc) line lineStart
      else stringEnd (i + 2) (Lexer.escape e :: acc) line lineStart
    else if c == 10 then stringEnd (i + 1) (c :: acc) (line + 1) (i + 1) else stringEnd (i + 1) (c :: acc) line lineStart
  let rec go i line lineStart bol acc :=
    let tok := fun kind value start => Token.mk kind value line (start - lineStart) bol :: acc
    if i >= n then reverse (Token.mk Kind.eof "" line 0 true :: acc) else
      let c := at i
      let col := i - lineStart
      if c == 10 then go (i + 1) (line + 1) (i + 1) true acc else if c == 32 || c == 9 || c == 13 then go (i + 1) line lineStart bol acc else if c == 45 && at (i + 1) == 45 then go (lineEnd i) line lineStart bol acc else if c == 47 && at (i + 1) == 45 then
        let isDoc := at (i + 2) == 45 && at (i + 3) != 47
        match commentEnd i 0 line lineStart with
        | (j, line2, lineStart2) => if isDoc then
            let body := trim (slice source (i + 3) (j - 2))
            go j line2 lineStart2 bol (Token.mk Kind.doc body line col bol :: acc)
          else go j line2 lineStart2 bol acc
      else if c == 34 then
        match stringEnd (i + 1) [] line lineStart with
        | (value, j, line2, lineStart2) => go j line2 lineStart2 false (tok Kind.text value i)
      else if c == 39 then
        let isEscape := at (i + 1) == 92
        let code := if isEscape then Lexer.escape (at (i + 2)) else at (i + 1)
        let close := if isEscape then i + 3 else i + 2
        if at close != 39 then Lexer.fail line col "bad character literal" else go (close + 1) line lineStart false (tok Kind.int (toText code) i)
      else if isDigit c then if c == 48 && at (i + 1) == 120 then
        let j := hexEnd (i + 2)
        let digits := List.filter (fun d => d != 95) (List.map at (range (i + 2) j))
        let value := foldl (fun v d => v * 16 + Lexer.hexValue d) 0 digits
        go j line lineStart false (tok Kind.int (toText value) i)
      else
        let j := digitsEnd i
        go j line lineStart false (tok Kind.int (replace "_" "" (slice source i j)) i) else if c == 46 && isIdentStart (at (i + 1)) then
        let j := identEnd (i + 1)
        let kind := if at (i - 1) == 41 || at (i - 1) == 93 then Kind.proj else Kind.dot
        go j line lineStart false (tok kind (slice source (i + 1) j) i)
      else if isIdentStart c && not (c == 95 && not (isIdentPart (at (i + 1)))) then
        let j := identEnd i
        let word := slice source i j
        if word == "λ" then go j line lineStart false (tok Kind.kw "fun" i) else if Dict.contains word Lexer.keywords then go j line lineStart false (tok Kind.kw word i) else go j line lineStart false (tok Kind.ident word i)
      else
        let mapped := unicode c
        if mapped != "" then go (i + 1) line lineStart false (tok Kind.sym mapped i) else
          let two := slice source i (i + 2)
          if Dict.contains two twoCharSymbols then go (i + 2) line lineStart false (tok Kind.sym two i) else
            let one := slice source i (i + 1)
            if Dict.contains one oneCharSymbols then go (i + 1) line lineStart false (tok Kind.sym one i) else Lexer.fail line col ("unexpected character " ++ one)
  go 0 1 0 true []

def Lexer.oneCharSymbols : Dict Text Unit := dict ["(", ")", "[", "]", "{", "}", ",", ":", "|", "@", "+", "-", "*", "/", "%", "<", ">", "=", "!", "_", ";"]

def Lexer.twoCharSymbols : Dict Text Unit := dict [":=", "=>", "->", "<-", "::", "++", "==", "!=", "<=", ">=", "&&", "||", "|>", "<|", "@["]

/-- Unicode spellings of ASCII symbols. -/
def Lexer.unicode (c : Int) : Text := if c == 8594 then "->" else if c == 8658 then "=>" else if c == 8800 then "!=" else if c == 8804 then "<=" else if c == 8805 then ">=" else if c == 215 then "*" else if c == 8592 then "<-" else ""
