ability Actors @"urn:deus:web:Actors" where
  call : Text -> Request -> Response

ability Alarm @"urn:deus:web:Alarm" where
  set : Int -> Unit

structure Arm where
  pats : List Pat
  body : Expr

inductive Attachment @"urn:deus:task:Attachment" where
  | definition (name : Text) (hash : Text)
  | change (hash : Text)

structure Attr where
  attr : Text
  values : List Text

structure Batch where
  objects : List (Text, Sexp)
  entries : List (Text, Entry)
  metas : List (Text, Sexp)
  warnings : List Text

structure Binder where
  binder : Text
  annot : Option Ty

structure Block @"urn:deus:mdl:Block" where
  blockType : Text
  blockId : Text
  blockTitle : Text
  props : List (Text, Text)
  lineNo : Int

inductive Bool @"#Bool" where
  | false
  | true

structure Comment @"urn:deus:task:Comment" where
  author : Text
  note : Text

structure Container @"urn:deus:external:Container" where
  image : Text
  command : List Text
  env : List (Text, Text)
  ports : List (Int, Int)

ability Containers @"urn:deus:external:Containers" where
  start : Container -> Result Text Text
  stop : Text -> Unit

inductive Decl where
  | defn (name : Text) (binders : List Binder) (type : Option Ty) (body : Option Expr) (arms : Option (List Arm)) (doc : Option Text) (attrs : List Attr) (pos : Pos)
  | thm (name : Text) (binders : List Binder) (prop : Expr) (proof : List Text) (doc : Option Text) (attrs : List Attr) (pos : Pos)
  | check (name : Text) (body : Expr) (doc : Option Text) (attrs : List Attr) (pos : Pos)
  | data (name : Text) (params : List Text) (iri : Option Text) (ctors : List (Text, List (Text, Ty))) (doc : Option Text) (pos : Pos)
  | record (name : Text) (params : List Text) (iri : Option Text) (fields : List (Text, Ty)) (doc : Option Text) (pos : Pos)
  | effect (name : Text) (params : List Text) (iri : Option Text) (ops : List (Text, Ty)) (doc : Option Text) (pos : Pos)
  | ns (name : Text)
  | endNs (name : Option Text)
  | openNs (names : List Text)

ability Defect @"#Defect" where
  raise : Text -> a

inductive Dict k v @"#Dict" where

structure Doc @"urn:deus:mdl:Doc" where
  front : List (Text, Text)
  terms : List (Text, Text)
  blocks : List Block

inductive Entry where
  | term (hash : Text)
  | ctor (type : Text) (tag : Int) (arity : Int)
  | type (hash : Text) (iri : Text) (fields : List Text)
  | ability (hash : Text) (iri : Text)
  | op (owner : Text) (index : Int) (arity : Int)
  | test (hash : Text)
  | theorem (hash : Text)
  | spec (hash : Text)

inductive Event where
  | log (level : Text) (message : Text) (fields : List (Text, Text)) (within : Int) (time : Text)
  | span (id : Int) (parent : Int) (name : Text) (attrs : List (Text, Text)) (begin : Text) (finished : Text)
  | metric (kind : Text) (name : Text) (value : Int) (time : Text)

inductive Expr where
  | var (name : Text) (pos : Pos)
  | dot (name : Text) (pos : Pos)
  | int (value : Int)
  | text (value : Text)
  | bool (value : Bool)
  | unit
  | app (f : Expr) (args : List Expr)
  | lam (params : List Pat) (body : Expr)
  | lamMatch (arms : List Arm)
  | letPat (pat : Pat) (value : Expr) (body : Expr)
  | letFun (name : Text) (params : List Pat) (value : Expr) (body : Expr) (isRec : Bool)
  | seq (first : Expr) (rest : Expr)
  | ite (cond : Expr) (yes : Expr) (no : Expr)
  | matchOn (scruts : List Expr) (arms : List Arm)
  | handleWith (body : Expr) (ret : Option (Pat, Expr)) (ops : List OpArm)
  | binop (op : Text) (left : Expr) (right : Expr) (pos : Pos)
  | neg (e : Expr)
  | not (e : Expr)
  | tuple (items : List Expr)
  | list (items : List Expr)
  | prim (name : Text)
  | record (base : Option Expr) (fields : List (Text, Expr)) (pos : Pos)
  | ann (e : Expr) (type : Ty)
  | proj (e : Expr) (field : Text) (pos : Pos)

structure Failure where
  reason : Text
  facts : List (Text, Text)
  cause : Option Failure

ability Fetch @"urn:deus:external:Fetch" where
  fetch : Requirement -> Result Text Text

structure Goal where
  hyps : List Sym
  prop : Sym
  vars : List (Text, Sexp)

ability Http @"urn:deus:web:Http" where
  fetch : Request -> Response

ability IO @"#IO" where
  print : Text -> Unit
  eprint : Text -> Unit
  readFile : Text -> Option Text
  writeFile : Text -> Text -> Unit
  exists : Text -> Bool
  listDir : Text -> List Text
  mkdirp : Text -> Unit
  remove : Text -> Unit
  args : Unit -> List Text
  exit : Int -> a
  time : Unit -> Int
  readStdin : Unit -> Text
  writeBytes : Text -> List Int -> Unit
  getEnv : Text -> Option Text
  isDir : Text -> Bool
  wallClock : Unit -> Text
  appendFile : Text -> Text -> Unit
  exec : Text -> List Text -> (Int, (Text, Text))

inductive Int @"#Int" where

structure Item where
