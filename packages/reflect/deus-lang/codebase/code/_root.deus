  opens : List Text

structure Seen @"urn:deus:replicate:Seen" where
  bundleName : Text
  claims : List (Text, Text)
  hashes : List Text

inductive Sexp where
  | int Int
  | sym Text
  | str Text
  | list (List Sexp)

ability Storage @"urn:deus:web:Storage" where
  get : Text -> Option Text
  put : Text -> Text -> Unit
  delete : Text -> Bool

ability Stuck where
  stuck : Text -> a

inductive Sym where
  | int Int
  | text Text
  | data Text Int (List Sym)
  | fv Text
  | pv Text
  | call Text (List Sym)
  | fn Text (List Sym)
  | ctorFn Text Int Int (List Sym)
  | primFn Text (List Sym)
  | prim Text (List Sym)
  | ite Sym Sym Sym
  | clo (List Sym) Sexp
  | app Sym (List Sym)

inductive TRow where
  | empty
  | extend TType TRow
  | var Int

inductive TType where
  | con Text (List TType)
  | fn TType TRow TType
  | var Int
  | row TRow

structure Task @"urn:deus:task:Task" where
  id : Text
  title : Text
  state : TaskState
  priority : Int
  assignee : Text
  labels : List Text
  parent : Text
  details : Text
  links : List Attachment
  comments : List Comment

inductive TaskState @"urn:deus:task:State" where
  | todo
  | doing
  | done
  | canceled

inductive Text @"#Text" where

ability Throw b where
  throw : b -> a

structure Token where
  kind : Kind
  value : Text
  line : Int
  col : Int
  bol : Bool

ability Trace where
  start : Text -> List (Text, Text) -> Int
  finish : Int -> Unit

inductive Ty where
  | named Text (List Ty)
  | arrow Ty Ty (Option (List Ty))
  | tuple (List Ty)
  | unit
  | effects (List Ty) Ty
  | row (List Ty)

structure Unifier where
  types : MutMap Int TType
  rows : MutMap Int TRow
  next : Ref Int

inductive Unit @"#Unit" where
  | unit

inductive Verdict where
  | pass Text Int
  | fail Text
  | unchecked

structure World where
  files : Ref (Map Text Text)
  dirs : Ref (Map Text Unit)
  output : Ref (List Text)
  clock : Ref Int
  rng : Ref Int

/-- `++`: concatenates two texts or two lists. -/
def append : a -> a -> a := prim "append"

/-- Runs `body`, recovering from a `throw` with `onError`. -/
def catch (body : Unit -> {Throw e | r} a) (onError : e -> {r} a) : {r} a :=
  handle body () with
  | Throw.throw e -> x0 => onError e

/-- Structural order: -1, 0 or 1. -/
def compare : a -> a -> Int := prim "compare"

def const (x : a) (y : b) : a := x

/-- Raises a defect: the program reached a state its author ruled out. -/
def defect : Text -> a := prim "defect"

def eprintln (t : Text) : {IO} Unit := IO.eprint (t ++ "\n")

/-- Structural equality; functions are never equal. -/
def eq : a -> a -> Bool := prim "eq"

def fst (p : (a, b)) : a :=
  match p with
  | (x, _) => x

def ge : a -> a -> Bool := prim "ge"

def gt : a -> a -> Bool := prim "gt"

def id (x : a) : a := x

/-- `a -> b` in a theorem's statement. -/
def implies : Bool -> Bool -> Bool := prim "implies"

def le : a -> a -> Bool := prim "le"

/-- Structural order (`<`, `<=`, `>`, `>=`), as `compare`. -/
def lt : a -> a -> Bool := prim "lt"

def max (a : Int) (b : Int) : Int := if a < b then b else a

def min (a : Int) (b : Int) : Int := if a < b then a else b

def neq : a -> a -> Bool := prim "neq"

def not (b : Bool) : Bool := if b then false else true

def println (t : Text) : {IO} Unit := IO.print (t ++ "\n")

/-- Debug rendering of any value. -/
def show : a -> Text := prim "show"

def snd (p : (a, b)) : b :=
  match p with
  | (_, y) => y

def trace : Text -> a -> a := prim "trace"

/-- Runs `body`, turning a `throw` into `Result.err`. -/
def try (body : Unit -> {Throw e | r} a) : {r} Result e a :=
  handle body () with
  | return x => Result.ok x
  | Throw.throw e -> x0 => Result.err e
