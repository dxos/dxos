inductive List a @"#List" where
  | nil
  | cons (head : a) (tail : List a)

ability Log where
  emit : Text -> Text -> List (Text, Text) -> Unit

inductive Map k v where
  | tip
  | node (height : Int) (left : Map k v) (key : k) (value : v) (right : Map k v)

ability MdlHost @"urn:deus:mdl:Host" where
