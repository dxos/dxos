inductive Json where
  | null
  | bool (value : Bool)
  | num (value : Int)
  | str (value : Text)
  | arr (items : List Json)
  | obj (fields : List (Text, Json))

inductive Kind where
  | ident
  | dot
  | proj
  | int
  | text
  | sym
  | kw
  | doc
  | eof

structure Lib @"urn:deus:project:Lib" where
  libName : Text
