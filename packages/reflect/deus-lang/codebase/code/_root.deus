inductive Pat where
  | wild
  | id (name : Text) (args : List Pat) (pos : Pos)
  | dot (name : Text) (args : List Pat) (pos : Pos)
  | int (value : Int)
  | text (value : Text)
  | bool (value : Bool)
  | cons (head : Pat) (tail : Pat)
  | tuple (items : List Pat)
  | list (items : List Pat)
  | unit
  | as (name : Text) (pat : Pat)

structure Pos where
  atLine : Int
  atCol : Int

structure Printer where
  display : Map Text Text
  fullNames : Map Text Text
  typeNames : Map Text Text
  fieldNames : Map Text Text
  supply : Ref (List Text)
