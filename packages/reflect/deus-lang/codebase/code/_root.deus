  assumptions : Ref (List Text)

ability Random where
  nextInt : Int -> Int

inductive Ref a @"#Ref" where

structure Registry @"urn:deus:external:Registry" where
  registryName : Text
  urlTemplate : Text

ability Remote @"urn:deus:replicate:Remote" where
  list : Unit -> List Text
