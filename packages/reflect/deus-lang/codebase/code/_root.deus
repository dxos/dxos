  stop : Ref Int

inductive Pat where
  | wild
  | id Text (List Pat) Pos
  | dot Text (List Pat) Pos
  | int Int
  | text Text
  | bool Bool
  | cons Pat Pat
  | tuple (List Pat)
  | list (List Pat)
  | unit
  | as Text Pat

structure Pos where
