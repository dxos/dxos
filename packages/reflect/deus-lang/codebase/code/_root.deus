ability Containers @"urn:deus:external:Containers" where
  start : Container -> Result Text Text
  stop : Text -> Unit

inductive Decl where
  | defn Text (List Binder) (Option Ty) (Option Expr) (Option (List Arm)) (Option Text) (List Attr) Pos
  | thm Text (List Binder) Expr (List Text) (Option Text) (List Attr) Pos
  | check Text Expr (Option Text) (List Attr) Pos
  | data Text (List Text) (Option Text) (List (Text, List Ty)) (Option Text) Pos
  | record Text (List Text) (Option Text) (List (Text, Ty)) (Option Text) Pos
  | effect Text (List Text) (Option Text) (List (Text, Ty)) (Option Text) Pos
  | ns Text
  | endNs (Option Text)
  | openNs (List Text)

ability Defect @"#Defect" where
  raise : Text -> a

inductive Dict a b @"#Dict" where

structure Doc @"urn:deus:mdl:Doc" where
  front : List (Text, Text)
  terms : List (Text, Text)
  blocks : List Block

inductive Entry where
  | term Text
  | ctor Text Int Int
  | type Text Text (List Text)
  | ability Text Text
  | op Text Int Int
  | test Text
  | theorem Text
  | spec Text

inductive Event where
  | log Text Text (List (Text, Text)) Int Text
  | span Int Int Text (List (Text, Text)) Text Text
  | metric Text Text Int Text

inductive Expr where
  | var Text Pos
  | dot Text Pos
  | int Int
  | text Text
  | bool Bool
  | unit
  | app Expr (List Expr)
  | lam (List Pat) Expr
  | lamMatch (List Arm)
  | letPat Pat Expr Expr
  | letFun Text (List Pat) Expr Expr Bool
  | seq Expr Expr
  | ite Expr Expr Expr
  | matchOn (List Expr) (List Arm)
  | handleWith Expr (Option (Pat, Expr)) (List OpArm)
  | binop Text Expr Expr Pos
  | neg Expr
  | not Expr
  | tuple (List Expr)
  | list (List Expr)
  | prim Text
  | record (Option Expr) (List (Text, Expr)) Pos
  | ann Expr Ty
  | proj Expr Text Pos

structure Failure where
  reason : Text
  facts : List (Text, Text)
  cause : Option Failure

ability Fetch @"urn:deus:external:Fetch" where
  fetch : Requirement -> Result Text Text

structure Goal where
  hyps : List Sym
  prop : Sym
  vars : List (Text, Sexp)

ability Http @"urn:deus:web:Http" where
  fetch : Request -> Response

ability IO @"#IO" where
  print : Text -> Unit
  eprint : Text -> Unit
  readFile : Text -> Option Text
  writeFile : Text -> Text -> Unit
  exists : Text -> Bool
  listDir : Text -> List Text
  mkdirp : Text -> Unit
  remove : Text -> Unit
  args : Unit -> List Text
  exit : Int -> a
  time : Unit -> Int
  readStdin : Unit -> Text
  writeBytes : Text -> List Int -> Unit
  getEnv : Text -> Option Text
  isDir : Text -> Bool
  wallClock : Unit -> Text
  appendFile : Text -> Text -> Unit
  exec : Text -> List Text -> (Int, (Text, Text))

inductive Int @"#Int" where

structure Item where
