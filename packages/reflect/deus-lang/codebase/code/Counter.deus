test Counter.countsAcrossRequests :=
  let request := Request.mk "GET" "/" ""
  match Web.simulate Counter.serve [request, request, request] with
  | (responses, store) => List.map (fun r => r.content) responses == ["count 1", "count 2", "count 3"] && Map.lookup "count" store == Option.some "3"

/-- Each request adds one and answers the new count; `?actor=` picks the object. -/
def Counter.serve (request : Request) : {Storage} Response :=
  let current := getOr (Option.bind (Storage.get "count") fromText) 0
  let next := current + 1
  Storage.put "count" (toText next)
  Web.ok ("count " ++ toText next)
