/-- R-1: after `deus artifact A.big`, its value is kept under its hash. -/
test Artifact.Spec.artifactKeepsItsValue := inStore (fun dir =>
  let ns := cliUpdate dir (Artifact.Spec.program "v1")
  cli dir ["artifact", "A.big"]
  match Map.lookup "A.big" ns with
  | Option.some e => cachedValue dir (Entry.hash e) == Option.some (Sexp.node "text" [Sexp.str "v1"]) && evaluations () == 1
  | Option.none => false)

/-- R-10: a binary file embedded with `--bytes` comes back byte for byte from a program, after the file is gone. -/
@[integration]
test Artifact.Spec.bytesRoundTrip := inRealStore (fun root dir =>
  let source := fun text =>
    IO.writeFile (root ++ "/t.deus") (Compile.Spec.prelude ++ embedLib ++ text)
    addOrUpdate (parseArgs [root ++ "/t.deus", "--codebase", dir, "--quiet"]) true
  source ""
  let bytes := List.map (fun i => (i * 37 + i / 7) % 256) (range 0 5000)
  IO.writeBytes (root ++ "/in.bin") bytes
  IO.writeBytes (root ++ "/kept.bin") bytes
  cli dir ["embed", root ++ "/in.bin", "--as", "A.blob", "--bytes"]
  IO.remove (root ++ "/in.bin")
  source ("def A.main (u : Unit) : Unit := IO.writeBytes \"" ++ root ++ "/out.bin\" A.blob\n")
  dispatch ["run", "--codebase", dir, "A.main"]
  match IO.exec "cmp" [root ++ "/kept.bin", root ++ "/out.bin"] with
  | (0, _, _) => true
  | _ => false)

/-- R-3: after `A.base` changes, the next run evaluates `A.big` again and writes the new value. -/
test Artifact.Spec.changeEvaluatesAgain := inStore (fun dir =>
  cliUpdate dir (Artifact.Spec.program "x1")
  dispatch ["run", "--codebase", dir, "A.main"]
  cliUpdate dir (Artifact.Spec.program "x2")
  dispatch ["run", "--codebase", dir, "A.main"]
  evaluations () == 2 && IO.readFile "out" == Option.some "x2")

/-- `deus <words> --codebase dir`, quietly. -/
def Artifact.Spec.cli (dir : Text) (words : List Text) : {IO, Throw Text} Unit := dispatch (words ++ ["--codebase", dir, "--quiet"])

/-- `deus embed <file> --as <name>` on a file holding `text`; returns the text's SHA-256. -/
def Artifact.Spec.embedFile (dir : Text) (file : Text) (text : Text) (name : Text) : {IO, Throw Text} Text :=
  cliUpdate dir embedLib
  IO.writeFile file text
  cli dir ["embed", file, "--as", name]
  Text.sha256 text

/-- R-6: after `deus embed`, the store holds the text under its SHA-256 and the constant is an artifact naming it. -/
test Artifact.Spec.embedKeepsTheFile := inStore (fun dir =>
  let sha := embedFile dir "page1.txt" "<p>e1</p>" "A.page1"
  match Map.lookup "A.page1" (Codebase.current dir) with
  | Option.some e => IO.readFile (Assets.path dir sha) == Option.some "<p>e1</p>" && isArtifact dir (Entry.hash e) && embeddedAsset dir (Entry.hash e) == Option.some ("text", sha)
  | Option.none => false)

/-- `Artifact.Spec.lib` with `Embed.text` and `Embed.bytes`, which `deus embed` names. -/
def Artifact.Spec.embedLib : Text := Artifact.Spec.lib ++
  "def Embed.text (sha : Text) : Text := sha\ndef Embed.bytes (sha : Text) : List Int := List.nil\n" ++ latin1

/-- R-7: after the file is removed, a run of `A.main` still writes the embedded text. -/
test Artifact.Spec.embeddedValueIsTheText := inStore (fun dir =>
  embedFile dir "page2.txt" "<p>e2</p>" "A.page2"
  IO.remove "page2.txt"
  cliUpdate dir (embedLib ++ "def A.main (u : Unit) : Unit := IO.writeFile \"out\" A.page2\n")
  dispatch ["run", "--codebase", dir, "A.main"]
  IO.readFile "out" == Option.some "<p>e2</p>")

/-- How many times `A.big` has been evaluated. -/
def Artifact.Spec.evaluations (u : Unit) : {IO} Int := Text.length (getOr (IO.readFile "evaluations") "")

/-- R-8: the exported code names the hash and not the embedded text. -/
test Artifact.Spec.exportNamesTheHash := inStore (fun dir =>
  let sha := embedFile dir "page3.txt" "<p>e3-only-in-the-store</p>" "A.page3"
  cli dir ["export", "exported"]
  let code := getOr (IO.readFile "exported/code/A.deus") ""
  Text.contains sha code && not (Text.contains "e3-only-in-the-store" code))

/-- R-5: an artifact that is a function, or takes a parameter, is refused with its name. -/
test Artifact.Spec.functionsAreRefused := inStore (fun dir =>
  cliUpdate dir (Artifact.Spec.lib ++
    "@[artifact]\ndef A.f : Int -> Int := fun n => n\n@[artifact]\ndef A.g (n : Int) : Int := n\n")
  let refused := fun name =>
    match try (fun _ => cli dir ["artifact", name]) with
    | Result.err message => Text.contains name message
    | Result.ok _ => false
  refused "A.f" && refused "A.g")

/-- R-4: once cached, the image of `A.main` names neither `A.base` nor the evaluation's file. -/
test Artifact.Spec.imageHoldsTheValue := inStore (fun dir =>
  let ns := cliUpdate dir (Artifact.Spec.program "y1")
  cli dir ["artifact", "A.big"]
  dispatch ["image", "A.main", "--codebase", dir, "--out", "main.image"]
  let image := getOr (IO.readFile "main.image") ""
  match Map.lookup "A.base" ns with
  | Option.some e => Text.contains "\"y1\"" image && not (Text.contains (Entry.hash e) image) && not (Text.contains "evaluations" image)
  | Option.none => false)

/-- Runs `body` on a fresh codebase in a real temporary directory, which it removes after; a thrown error is `false`. -/
def Artifact.Spec.inRealStore (body : Text -> Text -> {IO, Throw Text} Bool) : {IO} Bool :=
  match IO.exec "mktemp" ["-d"] with
  | (0, out, _) =>
      let root := trim out
      let held :=
        match try (fun _ =>
          Codebase.init (root ++ "/cb")
          body root (root ++ "/cb")) with
        | Result.ok value => value
        | Result.err _ => false
      IO.exec "rm" ["-rf", root]
      held
  | _ => false

/-- `Embed.fromLatin1`, which a binary's kept value applies, with the builtins it calls. -/
def Artifact.Spec.latin1 : Text := "def Text.utf8 : Text -> List Int := prim \"Text.utf8\"\ndef Embed.back (acc : List Int) (xs : List Int) : List Int :=\n  match xs with\n  | List.nil => acc\n  | List.cons x rest => Embed.back (List.cons x acc) rest\ndef Embed.fromLatin1 (latin1 : Text) : List Int :=\n  let rec go acc units :=\n    match units with\n    | List.nil => Embed.back List.nil acc\n    | List.cons b rest =>\n      if b < 128 then go (List.cons b acc) rest\n      else\n        match rest with\n        | List.cons c more => go (List.cons ((b - 192) * 64 + (c - 128)) acc) more\n        | List.nil => Embed.back List.nil acc\n  go List.nil (Text.utf8 latin1)\n"

/-- The builtins the program uses: `IO` up to `appendFile`, in the kernel's order. -/
def Artifact.Spec.lib : Text := "inductive Option a @\"#Option\" where\n  | none\n  | some (value : a)\nability IO @\"#IO\" where\n  print : Text -> Unit\n  eprint : Text -> Unit\n  readFile : Text -> Option Text\n  writeFile : Text -> Text -> Unit\n  exists : Text -> Bool\n  listDir : Text -> List Text\n  mkdirp : Text -> Unit\n  remove : Text -> Unit\n  args : Unit -> List Text\n  exit : Int -> a\n  time : Unit -> Int\n  readStdin : Unit -> Text\n  writeBytes : Text -> List Int -> Unit\n  getEnv : Text -> Option Text\n  isDir : Text -> Bool\n  wallClock : Unit -> Text\n  appendFile : Text -> Text -> Unit\ninductive List a @\"#List\" where\n  | nil\n  | cons (head : a) (tail : List a)\n"

/-- R-9: an embedded constant whose hash is not in the store fails with its name and the hash. -/
test Artifact.Spec.missingFileIsNamed := inStore (fun dir =>
  let sha := Text.sha256 "never embedded"
  cliUpdate dir (embedLib ++ "@[artifact]\ndef A.lost : Text := Embed.text \"" ++ sha ++ "\"\n")
  match try (fun _ => cli dir ["artifact", "A.lost"]) with
  | Result.err message => Text.contains "A.lost" message && Text.contains sha message
  | Result.ok _ => false)

/-- `A.big` notes each evaluation in the file `evaluations`; `A.main` writes it to `out`. -/
def Artifact.Spec.program (base : Text) : Text := Artifact.Spec.lib ++ "def A.base : Text := \"" ++ base ++
  "\"\n@[artifact]\ndef A.big : Text :=\n  let _ := IO.appendFile \"evaluations\" \"x\"\n  A.base\ndef A.main (u : Unit) : Unit := IO.writeFile \"out\" A.big\n"

/-- R-2: a run of `A.main` evaluates `A.big` once, keeps its value and writes it. -/
test Artifact.Spec.runFillsTheCache := inStore (fun dir =>
  let ns := cliUpdate dir (Artifact.Spec.program "w1")
  dispatch ["run", "--codebase", dir, "A.main"]
  match Map.lookup "A.big" ns with
  | Option.some e => cachedValue dir (Entry.hash e) == Option.some (Sexp.node "text" [Sexp.str "w1"]) && evaluations () == 1 && IO.readFile "out" == Option.some "w1"
  | Option.none => false)
