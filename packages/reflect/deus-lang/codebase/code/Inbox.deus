/-- Applies the remote's pending requests in name order (names start with the time they were made)
  and deletes each one applied or refused. Returns a line per request. -/
def Inbox.apply (dir : Text) : {Remote, IO, Throw Text} List Text :=
  pullAssets dir
  let staged := dir ++ "/cache/inbox-request"
  IO.mkdirp (dir ++ "/cache")
  List.map (fun name =>
    let key := "inbox/" ++ name
    let line := if not (Remote.download key staged) then name ++ ": gone" else
      match Option.map readAll (IO.readFile staged) with
      | Option.some (form :: []) =>
          match try (fun _ => applyOne dir form) with
          | Result.ok text => name ++ ": " ++ text
          | Result.err message => name ++ ": refused: " ++ message
      | _ => name ++ ": refused: not one request"
    IO.remove staged
    Remote.drop key
    line) (sort (List.filter (fun n => endsWith ".sexp" n) (Remote.keys "inbox")))

/-- Applies one request; returns a line saying what it did. A request that names nothing it can apply to throws. -/
def Inbox.applyOne (dir : Text) (form : Sexp) : {IO, Throw Text} Text :=
  let author := field form "by"
  let at := field form "at"
  let assets := List.map assetFromSexp (metaList (Option.some form) "assets")
  let missing := List.filter (fun a => not (Assets.has dir a.hash)) assets
  if not (startsWith "github:" author) then Throw.throw "a request must be by github:<login>" else if not (List.isEmpty missing) then Throw.throw ("missing asset " ++ join ", " (List.map (fun a => a.hash) missing)) else
    let kind := field form "kind"
    let done := fun causal line =>
      recordBy dir causal author at
      line
    if kind == "comment" then
      let subject := field form "subject"
      if not (isSubject subject) then Throw.throw ("bad subject " ++ subject) else done (Comments.add
        dir
        [(subject, Comment.mk author (field form "note") at assets)]
        ("comment on " ++ subject)) ("comment on " ++ subject ++ " by " ++ author)
    else if kind == "task" then
      let title := trim (field form "title")
      if Text.isEmpty title then Throw.throw "a task needs a title" else
        let t := setField
          (setField (blank (freshId dir title author) title) "details" (field form "details"))
          "labels"
          (field form "labels")
        let ns := Codebase.current dir
        let linked :=
          match Map.lookup (field form "link") ns with
          | Option.some e => link t (Attachment.definition (field form "link") (Entry.hash e))
          | Option.none => t
        let withAssets := if List.isEmpty assets then linked else Tasks.comment linked (Comment.mk author "" at assets)
        done
          (save dir [withAssets] ("task: open " ++ t.id ++ " " ++ title))
          ("task " ++ t.id ++ " " ++ title ++ " by " ++ author)
    else if kind == "task-comment" then
      let t := Tasks.find (Tasks.current dir) (field form "task")
      done (save
        dir
        [Tasks.comment t (Comment.mk author (field form "note") at assets)]
        ("task: comment on " ++ t.id)) ("comment on task " ++ t.id ++ " by " ++ author)
    else Throw.throw ("unknown request kind " ++ kind)

/-
  The explorer's inbox (D82): the hosted explorer cannot run DEUS, so a signed-in member's
  comment or new task is stored on the remote as a request, `<prefix>/inbox/<name>.sexp`, and its
  images under `assets/`. `deus inbox` applies the requests to the current branch, each as its
  own change by `github:<login>`, and deletes them; the next push publishes them.

    (request (kind "comment") (by "github:octocat") (at "2026-10-14T19:30:00Z") (subject "def:List.map") (note "…") (assets (asset "<sha256>" "image/png" "shot.png")))
    (request (kind "task") (by …) (at …) (title "…") (details "…") (link "List.map") (labels "a,b") (assets …))
    (request (kind "task-comment") (by …) (at …) (task "<id>") (note "…") (assets …))
-/
/-- A request's text field, or `""`. -/
def Inbox.field (form : Sexp) (key : Text) : Text := getOr (Option.map asText (metaField (Option.some form) key)) ""

/-- Who made a change, as `deus … --by` records it. -/
def Inbox.recordBy (dir : Text) (causal : Text) (author : Text) (at : Text) : {IO} Unit :=
  IO.mkdirp (dir ++ "/provenance")
  IO.writeFile (dir ++ "/provenance/" ++ causal) (Sexp.print (Sexp.node
    "provenance"
    [Sexp.node "by" [Sexp.str author], Sexp.node "at" [Sexp.str at], Sexp.node "objects" []]) ++ "\n")
