/-- Every program here, summed into one number: what the tests compare across back ends. -/
def Texts.all (n : Int) : Int := parsed n + searched n + sortedKeys n + listJoined n + Text.length (shown 5)

def Texts.genKeys (n : Int) : List Text := genKeysGo [] n (step 7)

def Texts.genKeysGo (acc : List Text) (k : Int) (s : Int) : List Text := if k == 0 then acc else Texts.genKeysGo (("key-" ++ toText (ushr s 12)) :: acc) (k - 1) (step s)

def Texts.insertText (x : Text) (xs : List Text) : List Text :=
  match xs with
  | [] => [x]
  | y :: rest => if x <= y then x :: xs else y :: Texts.insertText x rest

def Texts.lengths (xs : List Text) (acc : Int) : Int :=
  match xs with
  | [] => acc
  | x :: rest => Texts.lengths rest (acc + Text.length x)

/-- `++` on lists, written in place over a unique first list. -/
def Texts.listJoined (n : Int) : Int :=
  let xs := List.map toText (range 0 n) ++ ["x", "yz"]
  lengths xs 0 + textKinds xs 0

/-
  Text in the C back end (D115): literals, `++`, `Text.join`, `Text.split`, `Text.indexOf`,
  `Int.toText` and `Int.fromText`, and ordering texts. Every loop is first-order and specialised
  to `Text`, so the same definitions run on the interpreter and compile to C and to wasm.

    deus add examples/texts.deus && deus build Texts.parseLoop -o parse --c
-/
/-- `0,1,…,n-1`. -/
def Texts.numerals (n : Int) : Text := join "," (List.map toText (range 0 n))

def Texts.occurrences (t : Text) (needle : Text) (from : Int) (acc : Int) : Int :=
  let i := indexOf t needle from
  if i < 0 then acc else Texts.occurrences t needle (i + 1) (acc + 1)

/-- The length of `xs` if it is in order, else -1. -/
def Texts.orderedGo (prev : Text) (n : Int) (xs : List Text) : Int :=
  match xs with
  | [] => n
  | x :: rest => if prev > x then -1 else Texts.orderedGo x (n + 1) rest

def Texts.parseLoop (k : Int) (n : Int) (acc : Int) : Int := if k == 0 then acc else Texts.parseLoop (k - 1) n (acc + parsed n)

/-- Prints, joins, splits and parses back `0 … n-1`: their sum. -/
def Texts.parsed (n : Int) : Int := sumParsed (Text.split (numerals n) ",") 0

def Texts.phrase (n : Int) (acc : Text) : Text := if n == 0 then acc else Texts.phrase (n - 1) (acc ++ "deus " ++ toText n ++ "; ")

/-- Builds a text of `n` phrases by `++` and counts a word in it. -/
def Texts.searched (n : Int) : Int := occurrences (phrase n "") "us 1" 0 0

/-- A text result, so the native entry prints Text as the interpreter shows it. -/
def Texts.shown (n : Int) : Text := trim ("  " ++ join " | " (List.map (fun k => Text.slice k 4 9) (genKeys n)) ++ " \"q\" é ✓ \n")

def Texts.sortTexts (xs : List Text) (acc : List Text) : List Text :=
  match xs with
  | [] => acc
  | x :: rest => Texts.sortTexts rest (insertText x acc)

/-- Sorts `n` keys by insertion: the count if in order, plus their total length. -/
def Texts.sortedKeys (n : Int) : Int :=
  match sortTexts (genKeys n) [] with
  | [] => 0
  | x :: rest => orderedGo x 1 rest + lengths (x :: rest) 0

/-- A linear congruential generator, so every back end orders the same keys. -/
def Texts.step (s : Int) : Int := and (s * 1664525 + 1013904223) 0x7FFFFFFF

def Texts.sumParsed (xs : List Text) (acc : Int) : Int :=
  match xs with
  | [] => acc
  | x :: rest => Texts.sumParsed rest (acc + getOr (fromText x) 0)

/-- A `match` on text literals. -/
def Texts.textKind (t : Text) : Int :=
  match t with
  | "x" => 1
  | "yz" => 2
  | _ => 0

def Texts.textKinds (xs : List Text) (acc : Int) : Int :=
  match xs with
  | [] => acc
  | x :: rest => Texts.textKinds rest (acc + textKind x)

test Texts.textsSmall := Texts.all 30 == 871
