/-- Runs `body`; a `Failure` it throws is wrapped in one more layer of context. -/
def Failure.context (reason : Text) (facts : List (Text, Text)) (body : Unit -> {Throw Failure | r} a) : {Throw Failure | r} a :=
  handle body () with
  | Throw.throw inner -> x0 => Throw.throw (Failure.mk reason facts (Option.some inner))

def Failure.of (reason : Text) (facts : List (Text, Text)) : Failure := Failure.mk reason facts Option.none

/-- Outermost context first, each cause on its own line. -/
def Failure.render (f : Failure) : Text :=
  let shown := if List.isEmpty f.facts then "" else " (" ++ join ", " (List.map (fun pair => fst pair ++ "=" ++ snd pair) f.facts) ++ ")"
  f.reason ++ shown ++ (match f.cause with
  | Option.some inner => "\n  caused by: " ++ Failure.render inner
  | Option.none => "")
