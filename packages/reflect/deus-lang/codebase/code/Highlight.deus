/-- ANSI colours: keywords magenta, strings green, comments dim, types cyan. -/
def Highlight.ansi (source : Text) : Text := ansiIn "deus" source

def Highlight.ansiIn (dialect : Text) (source : Text) : Text :=
  let paint := fun code t => esc ++ "[" ++ code ++ "m" ++ t ++ esc ++ "[0m"
  Text.concat (List.map (fun run =>
    match run with
    | ("kw", t) => paint "35" t
    | ("str", t) => paint "32" t
    | ("cm", t) => paint "2" t
    | ("ty", t) => paint "36" t
    | (_, t) => t) (runsWith (keywordsFor dialect) source))

/-- Text dimmed on a terminal, as is. -/
def Highlight.dim (t : Text) : {IO} Text := if enabled () then esc ++ "[2m" ++ t ++ esc ++ "[0m" else t

/-- Whether output goes to a terminal that wants colour: the kernel sets `DEUS_TTY`, and `NO_COLOR` turns it off. -/
def Highlight.enabled (u : Unit) : {IO} Bool := isSome (IO.getEnv "DEUS_TTY") && isNone (IO.getEnv "NO_COLOR")

def Highlight.esc : Text := fromCode 27

def Highlight.escape (t : Text) : Text := replace ">" "&gt;" (replace "<" "&lt;" (replace "&" "&amp;" t))

/-- Colours `text` with ANSI codes when the terminal wants colour. -/
def Highlight.forTerminal (source : Text) : {IO} Text := forTerminalIn "deus" source

def Highlight.forTerminalIn (dialect : Text) (source : Text) : {IO} Text := if enabled () then ansiIn dialect source else source

/-- HTML with a `span` class per kind. -/
def Highlight.html (source : Text) : Text := Text.concat (List.map (fun run =>
  match run with
  | ("plain", t) => Highlight.escape t
  | (kind, t) => "<span class=" ++ kind ++ ">" ++ Highlight.escape t ++ "</span>") (runs source))

/-- HTML in which names found in `links` (display name -> hash) open that definition. -/
def Highlight.htmlLinked (links : Map Text Text) (source : Text) : Text := htmlLinkedIn "deus" links source

def Highlight.htmlLinkedIn (dialect : Text) (links : Map Text Text) (source : Text) : Text := Text.concat (List.map (fun run =>
  match run with
  | (kind, t) =>
      let inner := if kind == "plain" then Highlight.escape t else "<span class=" ++ kind ++ ">" ++ Highlight.escape t ++ "</span>"
      if kind == "plain" || kind == "ty" then
        match Map.lookup t links with
        | Option.some h => "<a class=ref data-open=\"d:" ++ h ++ "\">" ++ inner ++ "</a>"
        | Option.none => inner
      else inner) (runsWith (keywordsFor dialect) source))

def Highlight.isWordChar (c : Int) : Bool := isAlpha c || isDigit c || c == '_' || c == '.' || c == '?'

/-
  Syntax highlighting of printed source, shared by the explorer (HTML) and the CLI (ANSI colours
  on a terminal). Source splits into runs of one kind: kw(keyword), str(ing), cm (comment),
  ty(pe or other capitalized name) and plain text.
-/
def Highlight.keywords : Map Text Unit := Set.fromList ["def", "theorem", "test", "inductive", "structure", "ability", "namespace", "end", "match", "with", "fun", "let", "rec", "if", "then", "else", "handle", "return", "by", "where", "prim", "sorry"]

def Highlight.keywordsFor (dialect : Text) : Map Text Unit := if dialect == "ts" then tsKeywords else Highlight.keywords

/-- The source as (kind, text) runs, in order. -/
def Highlight.runs (source : Text) : List (Text, Text) := runsWith Highlight.keywords source

/-- `runs` with a dialect's keywords; comments are DEUS's (`--`, `/- -/`) or TypeScript's (`//`, `/* */`). -/
def Highlight.runsWith (kws : Map Text Unit) (source : Text) : List (Text, Text) :=
  let n := Text.length source
  let rec scan i acc := if i >= n then reverse acc else
    let c := code source i
    if c == '"' then
      let rec close j := if j >= n then n else if code source j == '\\' then close (j + 2) else if code source j == '"' then j + 1 else close (j + 1)
      let j := close (i + 1)
      scan j (("str", slice source i j) :: acc)
    else if c == '/' && i + 1 < n && code source (i + 1) == '-' then
      let stop := indexOf source "-/" (i + 2)
      let j := if stop < 0 then n else stop + 2
      scan j (("cm", slice source i j) :: acc)
    else if c == '/' && i + 1 < n && code source (i + 1) == '*' then
      let stop := indexOf source "*/" (i + 2)
      let j := if stop < 0 then n else stop + 2
      scan j (("cm", slice source i j) :: acc)
    else if (c == '-' || c == '/') && i + 1 < n && code source (i + 1) == c then
      let stop := indexOf source "\n" i
      let j := if stop < 0 then n else stop
      scan j (("cm", slice source i j) :: acc)
    else if isAlpha c || c == '_' then
      let rec word j := if j < n && isWordChar (code source j) then word (j + 1) else j
      let j := word i
      let w := slice source i j
      let kind := if Map.contains w kws then "kw" else if c >= 'A' && c <= 'Z' then "ty" else "plain"
      scan j ((kind, w) :: acc)
    else scan (i + 1) (("plain", fromCode c) :: acc)
  scan 0 []

test Highlight.spansKinds := Highlight.html "def x : Int := \"a<b\" -- note" ==
  "<span class=kw>def</span> x : <span class=ty>Int</span> := <span class=str>\"a&lt;b\"</span> <span class=cm>-- note</span>"

/-- Keywords of the TypeScript-like dialect (D70). -/
def Highlight.tsKeywords : Map Text Unit := Set.fromList ["function", "const", "return", "switch", "case", "if", "else", "try", "handle", "do", "uses", "type", "interface", "ability", "test", "theorem", "by", "prim", "sorry", "undefined", "true", "false"]

test Highlight.tsKeywordsAndComments := htmlLinkedIn "ts" Map.empty "const x = 1; // note" ==
  "<span class=kw>const</span> x = 1; <span class=cm>// note</span>"
