/-- Metadata without what the compiler derives or the printer renames. -/
def Update.authored (meta : Sexp) : List Sexp := List.filter (fun item => head item != "scheme" && head item != "locals") (Sexp.args meta)

/-- Term-like entries whose objects reference `h`. -/
def Update.dependentsOf (dir : Text) (ns : Map Text Entry) (h : Text) : {IO} List Text := dedup (sort (filterMap (fun pair =>
  let eh := Entry.hash (snd pair)
  if isTermLike (snd pair) && eh != h then
    match readObject dir eh with
    | Option.some obj => if List.contains h (Codebase.dependencies obj) then Option.some eh else Option.none
    | Option.none => Option.none
  else Option.none) (Map.toList ns)))

/-
  Update propagation (Unison's `update`): when a definition gets a new hash, every definition
  that depends on it, directly or not, is rewritten to the new hash and rehashed. Rehashing
  goes through `Compile.hashTerms`, so recursive groups are hashed as cycles exactly as `add`
  would hash them.
-/
def Update.isTermLike (e : Entry) : Bool :=
  match e with
  | Entry.term _ => true
  | Entry.test _ => true
  | Entry.theorem _ => true
  | _ => false

/-- The names in `entries` that keep their hash in `ns` but whose metadata in `metas` (a doc comment,
  attributes, comments, annotations) differs from what `stored` holds, so an update that changed only
  those is not silent. The inferred scheme and local names are left out: printing renames locals. -/
def Update.metadataChanged (ns : Map Text Entry) (entries : List (Text, Entry)) (stored : Text -> {r} Option Sexp) (metas : Map Text Sexp) : {r} List Text := filterMap (fun pair =>
  let h := Entry.hash (snd pair)
  match (Map.lookup (fst pair) ns, Map.lookup h metas) with
  | (Option.some old, Option.some meta) => if Entry.hash old != h then Option.none else
      let before := stored h
      if Option.map authored before == Option.some (authored (mergeMeta before meta)) then Option.none else Option.some (fst pair)
  | _ => Option.none) entries

/-- Rebuilds a pending definition from a stored object. -/
def Update.pendingOf (name : Text) (obj : Sexp) : Pending :=
  match obj with
  | Sexp.list (Sexp.sym "term" :: c :: []) => Pending.mk name "term" c c
  | Sexp.list (Sexp.sym "test" :: c :: []) => Pending.mk name "test" c c
  | _ => Pending.mk name "theorem" obj obj

/-- Propagates `subst` (old hash to new hash) through the namespace. Returns the new namespace and the
  names that were rehashed. A name just compiled refers to the batch's new hashes, but still to the
  old hash of a name outside the batch that depends on a changed one, so it is a candidate too. -/
def Update.propagate (dir : Text) (ns : Map Text Entry) (subst : Map Text Text) : {IO} (Map Text Entry, List Text) := if Map.size subst == 0 then (ns, []) else
  let candidates := List.filter (fun pair => isTermLike (snd pair)) (Map.toList ns)
  let objectOf := fun h => getOr (readObject dir h) (Sexp.list [])
  -- Grow the set of changed hashes until no candidate depends on one.
  let rec grow changed affected :=
    let next := List.filter (fun pair =>
      let h := Entry.hash (snd pair)
      not (Set.contains h affected) && any (fun d => Set.contains d changed) (Codebase.dependencies (objectOf h))) candidates
    if List.isEmpty next then affected else
      let hs := List.map (fun pair => Entry.hash (snd pair)) next
      grow
        (foldl (fun s h => Set.insert h s) changed hs)
        (foldl (fun s h => Set.insert h s) affected hs)
  let affected := grow (Set.fromList (Map.keys subst)) Map.empty
  if Map.size affected == 0 then (ns, []) else
    -- One canonical name per affected hash; aliases follow it.
    let canonical := foldl (fun m pair =>
      let h := Entry.hash (snd pair)
      if Set.contains h affected && not (Map.contains h m) then Map.insert h (fst pair) m else m) Map.empty candidates
    let rewriteMap := foldl (fun m pair => Map.insert (fst pair) ("@" ++ snd pair) m) subst (Map.toList canonical)
    let pending := List.map (fun pair =>
      match pair with
      | (h, name) => pendingOf name (Codebase.rewrite (objectOf h) rewriteMap)) (Map.toList canonical)
    match hashTerms pending Map.empty with
    | (hashes, objects) =>
        forEach objects (fun pair => writeObject dir (fst pair) (snd pair))
        forEach (Map.toList canonical) (fun pair =>
          match (readMeta dir (fst pair), Map.lookup (snd pair) hashes) with
          | (Option.some m, Option.some h2) => writeMeta dir h2 m
          | _ => ())
        let newHash := fun old => getOr (Option.bind (Map.lookup old canonical) (fun name => Map.lookup name hashes)) old
        let renamed := List.filter (fun pair => Set.contains (Entry.hash (snd pair)) affected) candidates
        let ns2 := foldl (fun m pair =>
          match pair with
          | (name, Entry.term h) => Map.insert name (Entry.term (newHash h)) m
          | (name, Entry.test h) => Map.insert name (Entry.test (newHash h)) m
          | (name, Entry.theorem h) => Map.insert name (Entry.theorem (newHash h)) m
          | _ => m) ns renamed
        (ns2, List.map fst renamed)
