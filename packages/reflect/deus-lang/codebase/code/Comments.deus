/-- Adds comments to subjects on the current branch as one change. Returns the new causal hash. -/
def Comments.add (dir : Text) (added : List (Text, Comment)) (message : Text) : {IO, Throw Text} Text :=
  let head := readCausal dir (headOf dir (currentBranch dir))
  let threads := foldl (fun m pair =>
    let before :=
      match Map.lookup (fst pair) m with
      | Option.some h => Comments.read dir h
      | Option.none => []
    Map.insert (fst pair) (Codebase.put dir (threadToSexp (before ++ [snd pair]))) m) (Comments.snapshotOf dir head) added
  commitComments dir (Comments.putSnapshot dir threads) message

/-- The subject of a change's comments. -/
def Comments.change (causal : Text) : Text := "change:" ++ causal

/-- The current branch's comments, by subject. -/
def Comments.current (dir : Text) : {IO, Throw Text} Map Text (List Comment) :=
  let snapshot := Comments.snapshotOf dir (readCausal dir (headOf dir (currentBranch dir)))
  mapValues (fun h => Comments.read dir h) snapshot

/-
  Comments (D81): notes on definitions and changes, kept in the codebase as tasks are (D59), so
  they branch, merge and replicate with the code. A task keeps its own comments; this holds the
  rest, one thread per subject.

  Every history node may point at a comments snapshot, which maps a subject to the hash of its
  thread. A definition's subject is its name, so its comments follow it across edits; a change's
  is its causal hash.
-/
/-- The subject of a definition's comments. -/
def Comments.definition (name : Text) : Text := "def:" ++ name

/-- A subject as the explorer and the inbox write it: `def:<name>` or `change:<causal>`. -/
def Comments.isSubject (subject : Text) : Bool := startsWith "def:" subject && Text.length subject > 4 || startsWith "change:" subject && Text.length subject > 7

/-- Three-way merge of comments snapshots. Comments are only ever added, so a thread changed on both
  sides keeps ours and then theirs' new comments; there are no conflicts. -/
def Comments.merge (dir : Text) (base : Map Text Text) (ours : Map Text Text) (theirs : Map Text Text) : {IO, Throw Text} Text :=
  let subjects := Set.toList (Set.fromList (Map.keys ours ++ Map.keys theirs))
  Comments.putSnapshot dir (foldl (fun merged subject =>
    match (Map.lookup subject ours, Map.lookup subject theirs) with
    | (Option.some o, Option.some t) => if o == t || Map.lookup subject base == Option.some t then merged else if Map.lookup subject base == Option.some o then Map.insert subject t merged else
        let mine := Comments.read dir o
        let extra := List.filter (fun c => not (any (fun d => d == c) mine)) (Comments.read dir t)
        Map.insert subject (Codebase.put dir (threadToSexp (mine ++ extra))) merged
    | (Option.none, Option.some t) => Map.insert subject t merged
    | _ => merged) ours subjects)

/-- Stores a comments snapshot; no comments is `""`, so a history node without them keeps its old hash. -/
def Comments.putSnapshot (dir : Text) (threads : Map Text Text) : {IO} Text := if Map.size threads == 0 then "" else Codebase.put dir (Sexp.node "comments" (List.map
  (fun pair => Sexp.node "s" [Sexp.str (fst pair), Sexp.node "ref" [Sexp.str (snd pair)]])
  (Map.toList threads)))

def Comments.read (dir : Text) (h : Text) : {IO, Throw Text} List Comment :=
  match readObject dir h with
  | Option.some form => List.map commentFromSexp (Sexp.args form)
  | Option.none => Throw.throw ("missing comment thread #" ++ h)

/-- A history node's comments snapshot: subject -> thread hash. -/
def Comments.snapshotOf (dir : Text) (c : Causal) : {IO, Throw Text} Map Text Text := if Text.isEmpty c.threads then Map.empty else
  match readObject dir c.threads with
  | Option.none => Throw.throw ("missing comments snapshot #" ++ c.threads)
  | Option.some form => Map.fromList (List.map (fun item =>
      match Sexp.args item with
      | subject :: ref :: [] => (asText subject, asText (getOr (head? (Sexp.args ref)) (Sexp.str "")))
      | _ => defect ("bad comments entry " ++ Sexp.print item)) (Sexp.args form))

def Comments.threadToSexp (comments : List Comment) : Sexp := Sexp.node "thread" (List.map commentToSexp comments)
