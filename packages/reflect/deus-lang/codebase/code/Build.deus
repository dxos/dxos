/-- A copy of the kernel with `image` appended under `trailer` (D42). -/
def Build.appended (image : Text) (out : Text) (trailer : Text) : {IO, Throw Failure} Unit :=
  Build.tool "cp" [kernel (), out]
  let digits := toText (List.length (utf8 image))
  IO.appendFile out (image ++ repeat (20 - Text.length digits) "0" ++ digits ++ trailer)

def Build.buildExecutable (image : Text) (out : Text) (home : Text) (node : Text) : {IO, Throw Failure} Unit :=
  let work := out ++ ".build"
  IO.mkdirp work
  IO.writeFile (work ++ "/deus.image") image
  context "bundling the kernel" [] (fun _ => Build.tool
    "npx"
    ["--yes", esbuild, home ++ "/src/bin/standalone.ts", "--bundle", "--platform=node", "--format=cjs", "--log-level=warning", "--outfile=" ++ work ++ "/main.cjs"])
  let config := Json.obj [("main", Json.str (work ++ "/main.cjs")), ("output", Json.str (work ++ "/sea.blob")), ("disableExperimentalSEAWarning", Json.bool true), ("assets", Json.obj [("image", Json.str (work ++ "/deus.image"))])]
  IO.writeFile (work ++ "/sea.json") (Json.render config)
  context
    "preparing the application blob"
    []
    (fun _ => Build.tool node ["--experimental-sea-config", work ++ "/sea.json"])
  Build.tool "cp" [node, out]
  let mac := trim (Build.tool "uname" []) == "Darwin"
  if mac then Build.tool "codesign" ["--remove-signature", out] else ""
  let macho := if mac then ["--macho-segment-name", "NODE_SEA"] else []
  context "injecting the application blob" [] (fun _ => Build.tool
    "npx"
    (["--yes", postject, out, "NODE_SEA_BLOB", work ++ "/sea.blob", "--sentinel-fuse", fuse] ++ macho))
  if mac then Build.tool "codesign" ["--sign", "-", out] else ""
  IO.remove work

def Build.esbuild : Text := "esbuild@0.28.2"

/-- Writes `out`, an executable that runs the image's main with its command-line arguments. The
  result is kept in the artifacts layer under the hash of its inputs, so rebuilding unchanged code
  is a copy. -/
def Build.executable (image : Text) (out : Text) (artifacts : Text) : {IO, Throw Failure} Unit :=
  let home := require "DEUS_HOME"
  let node := require "DEUS_NODE"
  let key := Text.sha256 (image ++ "\n" ++ executableInputs home node)
  let cached := artifacts ++ "/" ++ key
  if IO.exists cached then
    Build.tool "cp" [cached, out]
    ()
  else
    buildExecutable image out home node
    IO.mkdirp artifacts
    Build.tool "cp" [out, cached]
    ()

/-- What an executable's bytes depend on besides its image: the Node binary and the kernel sources
  bundled into it. -/
def Build.executableInputs (home : Text) (node : Text) : {IO, Throw Failure} Text :=
  let kernel := List.map (fun f => home ++ "/src/kernel/" ++ f) (List.filter
    (fun f => endsWith ".ts" f && not (endsWith ".test.ts" f))
    (IO.listDir (home ++ "/src/kernel")))
  Build.tool node ["--version"] ++
    Build.tool "sha256sum" ((home ++ "/src/bin/standalone.ts") :: kernel)

/-- The sentinel Node looks for to know it carries an application. Split, so an image of this code
  (the CLI building itself) does not contain the sentinel postject must find exactly once. -/
def Build.fuse : Text := "NODE_SEA_FUSE_" ++ "fce680ab2cc467b6e072b8b5df1996b2"

/-- The Rust kernel, built with cargo when it is missing; `$DEUS_KERNEL` names another one. -/
def Build.kernel (u : Unit) : {IO, Throw Failure} Text :=
  let crate := require "DEUS_HOME" ++ "/../deus-kernel"
  let path := getOr (IO.getEnv "DEUS_KERNEL") (crate ++ "/target/release/deus-kernel")
  if IO.exists path then "" else context
    "building the Rust kernel"
    []
    (fun _ => Build.tool "cargo" ["build", "--release", "--quiet", "--manifest-path", crate ++ "/Cargo.toml"])
  path

/-- Writes `out`: the Rust kernel with the image appended (D42), about 1 MB plus the image. -/
def Build.native (image : Text) (out : Text) : {IO, Throw Failure} Unit := appended image out "DEUSIMG1"

def Build.postject : Text := "postject@1.0.0-alpha.6"

def Build.require (name : Text) : {IO, Throw Failure} Text :=
  match IO.getEnv name with
  | Option.some value => value
  | Option.none => Throw.throw (of ("$" ++ name ++ " is not set; run deus through bin/deus.mjs") [])

/-- Writes `out`: a standalone web server for a handler (D57). It serves HTTP on `$PORT` (8080)
  with each object's storage under `$DEUS_DATA` (`./deus-data`). -/
def Build.server (image : Text) (out : Text) : {IO, Throw Failure} Unit := appended image out "DEUSSRV1"

/-- Runs a tool and returns its stdout; a non-zero exit is a failure carrying its output. -/
def Build.tool (program : Text) (arguments : List Text) : {IO, Throw Failure} Text :=
  match IO.exec program arguments with
  | (0, out, _) => out
  | (code, out, err) => Throw.throw (of
      (program ++ " exited with " ++ toText code)
      [("args", join " " arguments), ("stderr", trim err), ("stdout", trim out)])

/-- Writes a Cloudflare Worker to the directory `out` (D45): the wasm kernel, the actor's image,
  the Durable Object that serves it (`deus-kernel/embed/worker.mjs`) and `wrangler.toml`.
  `wrangler dev` in `out` serves it locally on workerd; `wrangler deploy` publishes it. -/
def Build.worker (image : Text) (name : Text) (out : Text) : {IO, Throw Failure} Unit :=
  let crate := require "DEUS_HOME" ++ "/../deus-kernel"
  let wasm := crate ++ "/target/wasm32-unknown-unknown/release/deus_kernel.wasm"
  if IO.exists wasm then "" else context "building the wasm kernel" [] (fun _ => Build.tool
    "cargo"
    ["build", "--release", "--quiet", "--lib", "--target", "wasm32-unknown-unknown", "--manifest-path", crate ++ "/Cargo.toml"])
  IO.mkdirp out
  IO.writeFile (out ++ "/app.image") image
  Build.tool "cp" [wasm, out ++ "/deus_kernel.wasm"]
  Build.tool "cp" [crate ++ "/embed/kernel.mjs", out ++ "/kernel.mjs"]
  Build.tool "cp" [crate ++ "/embed/worker.mjs", out ++ "/worker.mjs"]
  IO.writeFile (out ++ "/wrangler.toml") (join
    "\n"
    ["name = " ++ Json.render (Json.str name), "main = \"worker.mjs\"", "compatibility_date = \"2025-01-01\"", "", "[[rules]]", "type = \"Text\"", "globs = [\"**/*.image\"]", "fallthrough = true", "", "[[durable_objects.bindings]]", "name = \"ACTOR\"", "class_name = \"DeusActor\"", "", "[[migrations]]", "tag = \"v1\"", "new_sqlite_classes = [\"DeusActor\"]", ""])
