def List.all (p : a -> Bool) (x0 : List a) : Bool :=
  match x0 with
  | [] => true
  | x :: rest => p x && List.all p rest

def List.any (p : a -> Bool) (x0 : List a) : Bool :=
  match x0 with
  | [] => false
  | x :: rest => p x || List.any p rest

def List.concat (xss : List (List a)) : List a := List.foldr (fun xs acc => xs ++ acc) [] xss

def List.concatMap (f : a -> List b) (xs : List a) : List b := List.concat (List.map f xs)

def List.contains (x : a) (xs : List a) : Bool := any (fun y => y == x) xs

/-- Removes adjacent duplicates (all duplicates, on a sorted list). -/
def List.dedup : List a -> List a
| x :: y :: rest => if x == y then List.dedup (y :: rest) else x :: List.dedup (y :: rest)
| xs => xs

def List.drop (n : Int) (xs : List a) : List a :=
  match xs with
  | [] => []
  | _ :: rest => if n <= 0 then xs else List.drop (n - 1) rest

def List.filter (p : a -> Bool) (xs : List a) : List a :=
  let rec go acc ys :=
    match ys with
    | [] => reverse acc
    | y :: rest => if p y then go (y :: acc) rest else go acc rest
  go [] xs

def List.filterMap (f : a -> Option b) (xs : List a) : List b :=
  let rec go acc ys :=
    match ys with
    | [] => reverse acc
    | y :: rest =>
        match f y with
        | Option.some z => go (z :: acc) rest
        | Option.none => go acc rest
  go [] xs

def List.find (p : a -> Bool) (x0 : List a) : Option a :=
  match x0 with
  | [] => Option.none
  | x :: rest => if p x then Option.some x else List.find p rest

def List.findIndex (p : a -> Bool) (xs : List a) : Int :=
  let rec go i ys :=
    match ys with
    | [] => -1
    | y :: rest => if p y then i else go (i + 1) rest
  go 0 xs

def List.foldl (f : b -> a -> b) (init : b) (xs : List a) : b :=
  match xs with
  | [] => init
  | x :: rest => List.foldl f (f init x) rest

def List.foldr (f : a -> b -> b) (init : b) (xs : List a) : b := foldl (fun acc x => f x acc) init (reverse xs)

def List.forEach (xs : List a) (f : a -> Unit) : Unit :=
  match xs with
  | [] => ()
  | x :: rest =>
      f x
      List.forEach rest f

def List.get? (xs : List a) (i : Int) : Option a :=
  match xs with
  | [] => Option.none
  | x :: rest => if i == 0 then Option.some x else List.get? rest (i - 1)

def List.head? : List a -> Option a
| [] => Option.none
| x :: _ => Option.some x

def List.intersperse (sep : a) (x0 : List a) : List a :=
  match x0 with
  | [] => []
  | x :: [] => [x]
  | x :: rest => x :: sep :: List.intersperse sep rest

def List.isEmpty : List a -> Bool
| [] => true
| _ => false

def List.last? : List a -> Option a
| [] => Option.none
| x :: [] => Option.some x
| _ :: rest => List.last? rest

def List.length (xs : List a) : Int :=
  let rec go acc ys :=
    match ys with
    | [] => acc
    | _ :: rest => go (acc + 1) rest
  go 0 xs

def List.lookup (key : k) (x0 : List (k, v)) : Option v :=
  match x0 with
  | [] => Option.none
  | (k2, v) :: rest => if k2 == key then Option.some v else List.lookup key rest

/-- Map without growing the stack: builds in reverse, then flips. -/
def List.map (f : a -> b) (xs : List a) : List b :=
  let rec go acc ys :=
    match ys with
    | [] => reverse acc
    | y :: rest => go (f y :: acc) rest
  go [] xs

def List.mapIndexed (f : Int -> a -> b) (xs : List a) : List b :=
  let rec go i acc ys :=
    match ys with
    | [] => reverse acc
    | y :: rest => go (i + 1) (f i y :: acc) rest
  go 0 [] xs

/-- The largest element; 0 for the empty list. -/
def List.maximum (xs : List Int) : Int :=
  match xs with
  | [] => 0
  | x :: rest => foldl max x rest

def List.merge (cmp : a -> a -> Int) (xs : List a) (ys : List a) : List a :=
  let rec go acc l r :=
    match (l, r) with
    | ([], _) => reverse acc ++ r
    | (_, []) => reverse acc ++ l
    | (x :: xt, y :: yt) => if cmp x y <= 0 then go (x :: acc) xt r else go (y :: acc) l yt
  go [] xs ys

def List.partition (p : a -> Bool) (xs : List a) : (List a, List a) := (List.filter p xs, List.filter (fun x => not (p x)) xs)

def List.range (lo : Int) (hi : Int) : List Int :=
  let rec go acc i := if i < lo then acc else go (i :: acc) (i - 1)
  go [] (hi - 1)

def List.replicate (n : Int) (x : a) : List a :=
  let rec go acc k := if k <= 0 then acc else go (x :: acc) (k - 1)
  go [] n

def List.reverse (xs : List a) : List a :=
  let rec go acc ys :=
    match ys with
    | [] => acc
    | y :: rest => go (y :: acc) rest
  go [] xs

def List.sort (xs : List a) : List a := sortBy compare xs

/-- Stable merge sort by a comparison returning -1, 0 or 1. -/
def List.sortBy (cmp : a -> a -> Int) (xs : List a) : List a :=
  let n := List.length xs
  if n <= 1 then xs else
    let half := n / 2
    List.merge cmp (List.sortBy cmp (List.take half xs)) (List.sortBy cmp (List.drop half xs))

def List.sum (xs : List Int) : Int := foldl (fun a b => a + b) 0 xs

def List.take (n : Int) (xs : List a) : List a :=
  let rec go acc k ys :=
    match ys with
    | [] => reverse acc
    | y :: rest => if k <= 0 then reverse acc else go (y :: acc) (k - 1) rest
  go [] n xs

def List.zip (xs : List a) (ys : List b) : List (a, b) :=
  let rec go acc l r :=
    match (l, r) with
    | (x :: xt, y :: yt) => go ((x, y) :: acc) xt yt
    | (_, _) => reverse acc
  go [] xs ys
