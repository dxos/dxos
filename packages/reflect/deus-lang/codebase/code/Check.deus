def Check.alphabet : List Text := ["a", "b", "z", " ", "0", "\n", "é", "-", "\""]

def Check.below (state : Ref Int) (n : Int) : Int :=
  let r := and (nextRandom state) 2147483647
  if n <= 0 then 0 else r % n

def Check.cached (dir : Text) (h : Text) : {IO} Option Verdict := Option.map (fun t => Check.fromSexp (Sexp.read t)) (IO.readFile (dir ++ "/results/" ++ h))

def Check.caseCore (prop : Sexp) (args : List Sexp) : Sexp := if List.isEmpty args then prop else Sexp.list (Sexp.sym "app" :: prop :: args)

/-- A test, by default in a deterministic simulation seeded from its hash; integration tests run for real. -/
def Check.checkTest (h : Text) (integration : Bool) : {IO} Verdict :=
  let outcome := if integration then fst (Observe.collect (fun _ => guarded h)) else
    match Sim.run (seedOf h) (fun _ => fst (Observe.collect (fun _ => guarded h))) with
    | (r, _) => r
  match outcome with
  | Result.ok true => Verdict.pass (if integration then "integration" else "test") 1
  | Result.ok _ => Verdict.fail "returned false"
  | Result.err message => Verdict.fail ("defect: " ++ message)

def Check.checkTheorem (dir : Text) (ns : Map Text Entry) (h : Text) (obj : Sexp) : {IO} Verdict :=
  match obj with
  | Sexp.list (Sexp.sym "theorem" :: Sexp.list (Sexp.sym "binders" :: types) :: prop :: proof :: _) =>
      let tactic := List.map (fun x =>
        match x with
        | Sexp.list (Sexp.sym "ref" :: Sexp.str l :: []) => "#" ++ l
        | _ => asText x) (Sexp.args proof)
      -- Only a failure is described, so the printer's name tables are not built for a theorem that passes.
      let describe := fun args =>
        let printer := printer ns []
        join ", " (List.map (fun a => Print.expr printer a [] 0 100) args)
      let typeDecls := typesByIri dir ns
      match tactic with
      | "sorry" :: [] => Verdict.unchecked
      | "rfl" :: [] => if not (List.isEmpty types) then Verdict.fail "rfl needs a closed proposition (no binders); use decide or test" else
          match runCases prop [[]] describe with
          | Option.none => Verdict.pass "rfl" 1
          | Option.some reason => Verdict.fail reason
      | "decide" :: [] =>
          let domains := List.map (fun t => enumerate typeDecls t) types
          if any isNone domains then Verdict.fail "decide needs finite binder types; use test" else
            let cases := product (List.map (fun d => getOr d []) domains)
            match runCases prop cases describe with
            | Option.none => Verdict.pass "decide" (List.length cases)
            | Option.some reason => Verdict.fail reason
      | "test" :: rest =>
          let count := getOr (Option.bind (head? rest) fromText) 100
          let state := Ref.new (seedOf h)
          let cases := List.map
            (fun _ => List.map (fun t => Check.generate typeDecls state t 4) types)
            (range 0 count)
          match runCases prop cases describe with
          | Option.none => Verdict.pass "test" count
          | Option.some reason => Verdict.fail reason
      | _ =>
          -- A tactic proof. Binder names come from metadata (the author's names, in order).
          let locals := List.map asText (metaList (readMeta dir h) "locals")
          let names := mapIndexed (fun i _ => getOr (get? locals i) ("x" ++ toText i)) types
          let pr := Prover.mk
            dir
            ns
            (Ref.new Map.empty)
            (Ref.new 20000)
            (Ref.new [])
            (Ref.new 0)
            (Ref.new [])
            (Ref.new [])
          -- Lemmas must be checked first; one that is only tested weakens this verdict.
          let lemmas := filterMap (fun x =>
            match x with
            | Sexp.list (Sexp.sym "ref" :: Sexp.str l :: []) => Option.some l
            | _ => Option.none) (Sexp.args proof)
          let weak := List.filter (fun l =>
            match lemmaVerdict dir ns l with
            | Verdict.pass evidence _ => evidence == "test"
            | _ => true) lemmas
          if any (fun l =>
            match lemmaVerdict dir ns l with
            | Verdict.fail _ => true
            | _ => false) lemmas then Verdict.fail "a lemma it uses does not hold" else
            match proveTheorem pr names types prop (Sexp.args proof) with
            | Result.ok used => Verdict.pass (if List.isEmpty weak then "proof" else "proof assuming tested lemmas") 1
            | Result.err reason => Verdict.fail reason
  | _ => Verdict.fail "not a theorem"

def Check.con (hash : Text) (tag : Int) (fields : List Sexp) : Sexp :=
  let c := Sexp.node "con" [Sexp.str hash, Sexp.int tag, Sexp.int (List.length fields)]
  if List.isEmpty fields then c else Sexp.list (Sexp.sym "app" :: c :: fields)

/-- Every value of a finite type, or `none` if the type is infinite or too large. -/
def Check.enumerate (types : Map Text Sexp) (t : Sexp) : Option (List Sexp) :=
  match headAndArgs t with
  | (Sexp.list (Sexp.sym "tref" :: Sexp.str iri :: []), args) => if iri == "#Bool" then Option.some [Check.con "#Bool" 0 [], Check.con "#Bool" 1 []] else if iri == "#Unit" then Option.some [Check.con "#Unit" 0 []] else if iri == "#Option" then Option.map
      (fun vs => Check.con "#Option" 0 [] :: List.map (fun v => Check.con "#Option" 1 [v]) vs)
      (Option.bind (head? args) (fun a => Check.enumerate types a)) else if iri == "#Pair" then
      match args with
      | a :: b :: [] => Option.bind (Check.enumerate types a) (fun xs => Option.map
          (fun ys => concatMap (fun x => List.map (fun y => Check.con "#Pair" 0 [x, y]) ys) xs)
          (Check.enumerate types b))
      | _ => Option.none
    else
      match Map.lookup iri types with
      | Option.some decl =>
          let ctors := View.typeArgs decl
          if List.all (fun c => List.length (Sexp.args c) == 1) ctors then
            let hash := hashFor iri decl
            Option.some (mapIndexed (fun i _ => Check.con hash i []) ctors)
          else Option.none
      | Option.none => Option.none
  | _ => Option.none

/-- Evaluates a Core term (built by the checker) in the running machine. -/
def Check.evalCore (core : Sexp) : Result Text a :=
  let h := "check:" ++ Text.sha256 (Sexp.print core)
  if Code.has h then guarded h else
    Code.load (Sexp.print (Sexp.node "def" [Sexp.str h, core]))
    guarded h

def Check.fromSexp (s : Sexp) : Verdict :=
  match s with
  | Sexp.list (Sexp.sym "pass" :: Sexp.str evidence :: Sexp.int cases :: []) => Verdict.pass evidence cases
  | Sexp.list (Sexp.sym "fail" :: Sexp.str reason :: []) => Verdict.fail reason
  | _ => Verdict.unchecked

/-- One random value of a type, as Core; `depth` bounds recursive types. -/
def Check.generate (types : Map Text Sexp) (state : Ref Int) (t : Sexp) (depth : Int) : Sexp :=
  match headAndArgs t with
  | (Sexp.list (Sexp.sym "tref" :: Sexp.str iri :: []), args) => if iri == "#Int" then
      let k := below state 4
      let v := if k == 0 then getOr (get? interestingInts (below state 8)) 0 else if k == 1 then nextRandom state else below state 41 - 20
      Sexp.node "int" [Sexp.int v]
    else if iri == "#Text" then Sexp.node
      "text"
      [Sexp.str (Text.concat (List.map (fun _ => getOr (get? alphabet (below state 9)) "a") (range 0 (below state 6))))] else if iri == "#Bool" then Check.con "#Bool" (below state 2) [] else if iri == "#Unit" then Check.con "#Unit" 0 [] else if iri == "#List" then
      let elem := getOr (head? args) (Sexp.node "tref" [Sexp.str "#Int"])
      let count := if depth <= 0 then 0 else below state 6
      foldl
        (fun acc _ => Check.con "#List" 1 [Check.generate types state elem (depth - 1), acc])
        (Check.con "#List" 0 [])
        (range 0 count)
    else if iri == "#Option" then if below state 3 == 0 || depth <= 0 then Check.con "#Option" 0 [] else Check.con
      "#Option"
      1
      [Check.generate
        types
        state
        (getOr (head? args) (Sexp.node "tref" [Sexp.str "#Int"]))
        (depth - 1)] else if iri == "#Array" then
      -- `Array.make` then one `Array.set` per index, so each item is drawn on its own.
      let elem := getOr (head? args) (Sexp.node "tref" [Sexp.str "#Int"])
      let count := if depth <= 0 then 0 else below state 6
      let applyPrim := fun p xs => Sexp.list (Sexp.sym "app" :: Sexp.node "prim" [Sexp.str p] :: xs)
      let made := applyPrim
        "Array.make"
        [Sexp.node "int" [Sexp.int count], Check.generate types state elem (depth - 1)]
      foldl (fun acc i => applyPrim
        "Array.set"
        [acc, Sexp.node "int" [Sexp.int i], Check.generate types state elem (depth - 1)]) made (range 0 count)
    else if iri == "#Pair" then
      match args with
      | a :: b :: [] => Check.con "#Pair" 0 [Check.generate types state a depth, Check.generate types state b depth]
      | _ => Check.con "#Unit" 0 []
    else
      match Map.lookup iri types with
      | Option.some decl =>
          let hash := hashFor iri decl
          let ctors := View.typeArgs decl
          let nullary := List.filter
            (fun pair => List.length (Sexp.args (snd pair)) == 1)
            (mapIndexed (fun i c => (i, c)) ctors)
          let pool := if depth <= 0 && not (List.isEmpty nullary) then nullary else mapIndexed (fun i c => (i, c)) ctors
          match get? pool (below state (List.length pool)) with
          | Option.some (tag, c) => Check.con hash tag (List.map
              (fun ft => Check.generate types state (substVars ft args) (depth - 1))
              (List.drop 1 (Sexp.args c)))
          | Option.none => defect ("cannot generate a value of " ++ iri)
      | Option.none => defect ("cannot generate a value of " ++ iri)
  | _ => defect ("cannot generate a value of type " ++ Sexp.print t)

/-- Runs a loaded definition; a defect becomes `Result.err`. -/
def Check.guarded (h : Text) : Result Text a :=
  handle Result.ok (Code.run h) with
  | Defect.raise message -> x0 => Result.err (message ++ Cli.defectTrace ())

/-- Whether a definition carries an attribute, e.g. `@[integration]`. -/
def Check.hasAttr (dir : Text) (h : Text) (name : Text) : {IO} Bool := any (fun a => if head a == name then true else
  match a with
  | Sexp.list (Sexp.str n :: _) => n == name
  | _ => false) (metaList (readMeta dir h) "attrs")

def Check.headAndArgs (t : Sexp) : (Sexp, List Sexp) :=
  match t with
  | Sexp.list (Sexp.sym "tapp" :: f :: args) => (f, args)
  | _ => (t, [])

def Check.interestingInts : List Int := [0, 1, -1, 2, 7, -100, 2147483647, -2147483648]

/-- A lemma's verdict, checking (and caching) it first if needed. -/
def Check.lemmaVerdict (dir : Text) (ns : Map Text Entry) (h : Text) : {IO} Verdict :=
  match Check.cached dir h with
  | Option.some v => v
  | Option.none =>
      match readObject dir h with
      | Option.some obj =>
          match try (fun _ => Image.load (fun x => readObject dir x) [h]) with
          | Result.err message => Verdict.fail message
          | Result.ok _ =>
              let v := checkTheorem dir ns h obj
              remember dir h v
              v
      | Option.none => Verdict.fail "missing lemma"

--
-- Generators: values of a binder type, as Core terms.
--
/-- A deterministic generator: xorshift over a 32-bit state. -/
def Check.nextRandom (state : Ref Int) : Int :=
  let x1 := Ref.get state
  let x2 := xor x1 (shl x1 13)
  let x3 := xor x2 (ushr x2 17)
  let x4 := xor x3 (shl x3 5)
  Ref.set state x4
  x4

/-- Every combination of the binders' values. -/
def Check.product (domains : List (List Sexp)) : List (List Sexp) :=
  match domains with
  | [] => [[]]
  | d :: rest => concatMap (fun v => List.map (fun vs => v :: vs) (Check.product rest)) d

def Check.remember (dir : Text) (h : Text) (v : Verdict) : {IO} Unit :=
  match v with
  | Verdict.unchecked => ()
  | _ => IO.writeFile (dir ++ "/results/" ++ h) (Sexp.print (Check.toSexp v) ++ "\n")

/-- Runs every test or theorem under a prefix; prints a report; exits 1 on failure. -/
def Check.run (args : Args) (wantTheorems : Bool) : {IO, Throw Text} Unit :=
  let dir := openCodebase args
  let ns := Codebase.current dir
  let prefix := getOr (head? args.positional) ""
  let runIntegration := Cli.flag args "integration"
  let selected := List.filter
    (fun pair => startsWith prefix (fst pair) && (if wantTheorems || runIntegration || not (hasAttr dir (Entry.hash (snd pair)) "integration") then
      match snd pair with
      | Entry.test _ => not wantTheorems
      | Entry.theorem _ => wantTheorems
      | _ => false
    else false))
    (Map.toList ns)
  let eventTypes := typesNow dir
  let results := List.map (fun pair =>
    match pair with
    | (name, e) =>
        let h := Entry.hash e
        let integration := not wantTheorems && hasAttr dir h "integration"
        let started := IO.time ()
        -- An integration test talks to the real world, so its result is never reused.
        let outcome :=
          match if integration then Option.none else Check.cached dir h with
          | Option.some v => (name, v, true)
          | Option.none =>
              Image.load (fetcher dir) [h]
              let v := if wantTheorems then
                match readObject dir h with
                | Option.some obj => checkTheorem dir ns h obj
                | Option.none => Verdict.fail "missing object"
              else checkTest h integration
              if integration then () else remember dir h v
              (name, v, false)
        match outcome with
        | (_, v, wasCached) =>
            let fields :=
              match v with
              | Verdict.pass evidence cases => (true, evidence, cases, "")
              | Verdict.fail reason => (false, "", 0, reason)
              | Verdict.unchecked => (false, "sorry", 0, "unchecked")
            match fields with
            | (passed, evidence, cases, failure) => recordRun
                dir
                eventTypes
                ns
                name
                (if wantTheorems then "theorem" else "test")
                passed
                wasCached
                (not integration)
                evidence
                cases
                failure
                (IO.time () - started)
        outcome) selected
  let failed := List.filter (fun r =>
    match r with
    | (_, Verdict.fail _, _) => true
    | _ => false) results
  let index := nameIndex ns
  let line := fun r =>
    match r with
    | (name, v, wasCached) =>
        let suffix := if wasCached then "  (cached)" else ""
        match v with
        | Verdict.pass evidence cases => if wantTheorems then "  ✓ " ++ name ++ "  " ++
            (if evidence == "test" then "tested, " ++ toText cases ++ " cases" else if startsWith "proof" evidence then "proved (" ++ evidence ++ ")" else "proved by " ++ evidence ++ (if cases > 1 then ", " ++ toText cases ++ " cases" else "")) ++ suffix else "  ✓ " ++ name ++ suffix
        | Verdict.fail reason => "  ✗ " ++ name ++ "  " ++ nameTrace index reason ++ suffix
        | Verdict.unchecked => "  ? " ++ name ++ "  sorry (unchecked)"
  Cli.output args (fun _ => Json.arr (List.map (fun r =>
    match r with
    | (name, v, wasCached) =>
        let status :=
          match v with
          | Verdict.pass evidence cases => [("status", Json.str "pass"), ("evidence", Json.str evidence), ("cases", Json.num cases)]
          | Verdict.fail reason => [("status", Json.str "fail"), ("reason", Json.str (nameTrace index reason))]
          | Verdict.unchecked => [("status", Json.str "unchecked")]
        Json.obj ([("name", Json.str name), ("cached", Json.bool wasCached)] ++ status)) results)) (fun _ =>
    let summary := toText (List.length results - List.length failed) ++ " passed, " ++ toText (List.length failed) ++
      " failed"
    join "\n" (List.map line results ++ [summary]))
  if List.isEmpty failed then () else IO.exit 1

/-- Checks cases in order; the first failing one is the counterexample. -/
def Check.runCases (prop : Sexp) (cases : List (List Sexp)) (describe : List Sexp -> Text) : Option Text :=
  match cases with
  | [] => Option.none
  | args :: rest =>
      match Check.evalCore (caseCore prop args) with
      | Result.ok true => Check.runCases prop rest describe
      | Result.ok _ => Option.some ("counterexample: " ++ describe args)
      | Result.err message => Option.some ("defect " ++ show message ++ " at " ++ describe args)

def Check.seedOf (h : Text) : Int :=
  match fromText (join "" (List.map (fun c => toText (and c 7)) (List.take 9 (utf8 h)))) with
  | Option.some v => if v == 0 then 1 else v
  | Option.none => 1

def Check.substVars (t : Sexp) (args : List Sexp) : Sexp :=
  match t with
  | Sexp.list (Sexp.sym "tvar" :: Sexp.int i :: []) => getOr (get? args i) t
  | Sexp.list items => Sexp.list (List.map (fun x => Check.substVars x args) items)
  | _ => t

def Check.tests (args : Args) : {IO, Throw Text} Unit := Check.run args false

def Check.theorems (args : Args) : {IO, Throw Text} Unit := Check.run args true

def Check.toSexp : Verdict -> Sexp
| Verdict.pass evidence cases => Sexp.node "pass" [Sexp.str evidence, Sexp.int cases]
| Verdict.fail reason => Sexp.node "fail" [Sexp.str reason]
| Verdict.unchecked => Sexp.node "unchecked" []

/-- Type declarations by IRI, for generating values of user types. -/
def Check.typesByIri (dir : Text) (ns : Map Text Entry) : {IO} Map Text Sexp := foldl (fun m pair =>
  match snd pair with
  | Entry.type h iri _ =>
      match readObject dir h with
      | Option.some obj => Map.insert iri obj m
      | Option.none => m
  | _ => m) Map.empty (Map.toList ns)

/-- A test's or a theorem's verdict, from the cache or checked now and cached; `none` for other entries. -/
def Check.verdictOf (dir : Text) (ns : Map Text Entry) (e : Entry) : {IO} Option Verdict :=
  match e with
  | Entry.theorem h => Option.some (lemmaVerdict dir ns h)
  | Entry.test h =>
      let integration := hasAttr dir h "integration"
      match if integration then Option.none else Check.cached dir h with
      | Option.some v => Option.some v
      | Option.none =>
          let v :=
            match try (fun _ => Image.load (fetcher dir) [h]) with
            | Result.err message => Verdict.fail message
            | Result.ok _ => checkTest h integration
          if integration then () else remember dir h v
          Option.some v
  | _ => Option.none
