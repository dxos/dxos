def Sim.children (w : World) (dir : Text) : List Text :=
  let prefix := if dir == "" || dir == "." then "" else dir ++ "/"
  let direct := fun p => if startsWith prefix p && p != dir then
    let rest := Text.drop (Text.length prefix) p
    if Text.contains "/" rest || rest == "" then Option.none else Option.some rest
  else Option.none
  dedup (sort (filterMap direct (Map.keys (Ref.get w.files) ++ Map.keys (Ref.get w.dirs))))

def Sim.mkdirs (w : World) (path : Text) : Unit := if Set.contains path (Ref.get w.dirs) then () else
  Ref.set w.dirs (Set.insert path (Ref.get w.dirs))
  Sim.mkdirs w (Sim.parent path)

def Sim.newWorld (seed : Int) : World := World.mk
  (Ref.new Map.empty)
  (Ref.new (Set.fromList ["", "."]))
  (Ref.new [])
  (Ref.new 0)
  (Ref.new (if seed == 0 then 1 else seed))

/-- xorshift32: a small, well-mixed deterministic generator. -/
def Sim.next (w : World) : Int :=
  let x1 := Ref.get w.rng
  let x2 := xor x1 (shl x1 13)
  let x3 := xor x2 (ushr x2 17)
  let x4 := xor x3 (shl x3 5)
  Ref.set w.rng x4
  x4

def Sim.parent (path : Text) : Text :=
  let rec go i := if i < 0 then "" else if code path i == '/' then Text.take i path else go (i - 1)
  go (Text.length path - 1)

/-- Runs `body` against a simulated world; returns its result and everything it printed. -/
def Sim.run (seed : Int) (body : Unit -> {IO, Random | r} a) : {r} (a, Text) :=
  let w := newWorld seed
  let result :=
    handle body () with
    | Random.nextInt bound -> k => k (if bound <= 0 then 0 else and (Sim.next w) 2147483647 % bound)
    | IO.print t -> k =>
        Ref.set w.output (t :: Ref.get w.output)
        k ()
    | IO.eprint t -> k =>
        Ref.set w.output (t :: Ref.get w.output)
        k ()
    | IO.readFile p -> k => k (Map.lookup p (Ref.get w.files))
    | IO.writeFile p t -> k =>
        mkdirs w (Sim.parent p)
        Ref.set w.files (Map.insert p t (Ref.get w.files))
        k ()
    | IO.exists p -> k => k (Map.contains p (Ref.get w.files) || Set.contains p (Ref.get w.dirs))
    | IO.listDir p -> k => k (children w p)
    | IO.mkdirp p -> k =>
        mkdirs w p
        k ()
    | IO.remove p -> k =>
        Ref.set
          w.files
          (Map.filter (fun key _ => key != p && not (startsWith (p ++ "/") key)) (Ref.get w.files))
        Ref.set
          w.dirs
          (Map.filter (fun key _ => key != p && not (startsWith (p ++ "/") key)) (Ref.get w.dirs))
        k ()
    | IO.args x2 -> k => k []
    | IO.exit code -> x3 => defect ("exit " ++ toText code ++ " inside a simulated run")
    | IO.time x4 -> k =>
        Ref.set w.clock (Ref.get w.clock + 1)
        k (Ref.get w.clock)
    | IO.wallClock x5 -> k =>
        -- The same simulated clock, in nanoseconds: a history node's time is then deterministic too.
        Ref.set w.clock (Ref.get w.clock + 1)
        k (toText (Ref.get w.clock) ++ "000000000")
    | IO.readStdin x6 -> k => k ""
    | IO.writeBytes p bytes -> k =>
        Ref.set w.files (Map.insert p (fromCodes bytes) (Ref.get w.files))
        k ()
    | IO.getEnv x7 -> k => k Option.none
    | IO.isDir p -> k => k (Set.contains p (Ref.get w.dirs))
    | IO.wallClock x8 -> k =>
        Ref.set w.clock (Ref.get w.clock + 1)
        k (toText (Ref.get w.clock))
    | IO.exec program x9 -> k => k (127, "", program ++ ": processes are not simulated")
    | IO.appendFile p t -> k =>
        mkdirs w (Sim.parent p)
        Ref.set
          w.files
          (Map.insert p (getOr (Map.lookup p (Ref.get w.files)) "" ++ t) (Ref.get w.files))
        k ()
  (result, Text.concat (reverse (Ref.get w.output)))
