(task (id "f9cd5624") (title "Native: structural equality and ordering of data in the C back end") (state "done") (priority 3) (assignee "") (labels "native" "perf") (parent "") (details "eq, compare and < on constructed values are refused in C (and wasm compares only some data types); the runtime can walk blocks by kind as the kernels' equal and compare do.") (links (change "c9c3e09be7725a37136929bb27c58c9926ddf06b5858ef5d2962a6a62a472279")) (comments))
