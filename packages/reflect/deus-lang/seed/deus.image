 1 2) (text "  while (i < n) {") (app (con "#List" 1 2) (text "    uint32_t c = s[i], m = c < 0x80 ? 0 : c >= 0xc2 && c < 0xe0 ? 1 : c >= 0xe0 && c < 0xf0 ? 2 : c >= 0xf0 && c < 0xf5 ? 3 : 4;") (app (con "#List" 1 2) (text "    if (m == 0) { o[k++] = (uint16_t)c; i++; continue; }") (app (con "#List" 1 2) (text "    if (m == 4) { o[k++] = 0xfffd; i++; continue; }") (app (con "#List" 1 2) (text "    uint32_t v = c & (0x3f >> m); size_t j = 1;") (app (con "#List" 1 2) (text "    for (; j <= m; j++) { if (i + j >= n) break; uint32_t b = s[i + j]; if ((b & 0xc0) != 0x80) break; if (j == 1 && ((m == 2 && c == 0xe0 && b < 0xa0) || (m == 2 && c == 0xed && b >= 0xa0) || (m == 3 && c == 0xf0 && b < 0x90) || (m == 3 && c == 0xf4 && b >= 0x90))) break; v = v << 6 | (b & 0x3f); }") (app (con "#List" 1 2) (text "    if (j <= m) { o[k++] = 0xfffd; i += j; continue; }") (app (con "#List" 1 2) (text "    if (v > 0xffff) { o[k++] = (uint16_t)(0xd800 + ((v - 0x10000) >> 10)); o[k++] = (uint16_t)(0xdc00 + ((v - 0x10000) & 0x3ff)); } else o[k++] = (uint16_t)v;") (app (con "#List" 1 2) (text "    i += m + 1;") (app (con "#List" 1 2) (text "  }") (app (con "#List" 1 2) (text "  TLEN(r) = k; return r;") (app (con "#List" 1 2) (text "}") (app (con "#List" 1 2) (text "static V deus_text_cs(const char *s) { return deus_text_utf8_of((const uint8_t *)s, strlen(s)); }") (app (con "#List" 1 2) (text "/* All of a file's bytes, or 0 when it cannot be read; `*n` is the length. */") (app (con "#List" 1 2) (text "static uint8_t *deus_slurp(int fd, size_t *n) {") (app (con "#List" 1 2) (text "  size_t cap = 4096, len = 0; uint8_t *b = malloc(cap); if (!b) __builtin_trap();") (app (con "#List" 1 2) (text "  for (;;) { if (len == cap) { cap *= 2; b = realloc(b, cap); if (!b) __builtin_trap(); } ssize_t got = read(fd, b + len, cap - len); if (got < 0) { if (errno == EINTR) continue; free(b); return 0; } if (got == 0) break; len += (size_t)got; }") (app (con "#List" 1 2) (text "  *n = len; return b;") (app (con "#List" 1 2) (text "}") (app (con "#List" 1 2) (text "static void deus_mkdirs(char *path) { for (char *p = path + 1; *p; p++) if (*p == '/') { *p = 0; mkdir(path, 0777); *p = '/'; } mkdir(path, 0777); }") (app (con "#List" 1 2) (text "static void deus_mkparent(const char *path) { const char *slash = strrchr(path, '/'); if (!slash || slash == path) return; size_t n = (size_t)(slash - path); char *d = malloc(n + 1); memcpy(d, path, n); d[n] = 0; deus_mkdirs(d); free(d); }") (app (con "#List" 1 2) (text "static void deus_rm(const char *path) {") (app (con "#List" 1 2) (text "  struct stat st; if (lstat(path, &st) != 0) return;") (app (con "#List" 1 2) (text "  if (S_ISDIR(st.st_mode)) { DIR *d = opendir(path); if (d) { struct dirent *e; while ((e = readdir(d))) { if (!strcmp(e->d_name, \".\") || !strcmp(e->d_name, \"..\")) continue; size_t n = strlen(path) + strlen(e->d_name) + 2; char *c = malloc(n); snprintf(c, n, \"%s/%s\", path, e->d_name); deus_rm(c); free(c); } closedir(d); } rmdir(path); }") (app (con "#List" 1 2) (text "  else unlink(path);") (app (con "#List" 1 2) (text "}") (app (con "#List" 1 2) (text "static V deus_io_put(FILE *f, V t) { V b = deus_scratch(3 * TLEN(t)); V k = deus_utf8(TU(t), TLEN(t), (uint8_t *)TU(b)); fwrite(TU(b), 1, (size_t)k, f); deus_drop(b); return UNIT; }") (app (con "#List" 1 2) (text "static V deus_io_print(V t) { return deus_io_put(stdout, t); }") (app (con "#List" 1 2) (text "static V deus_io_eprint(V t) { fflush(stdout); return deus_io_put(stderr, t); }") (app (con "#List" 1 2) (text "static V deus_io_readFile(V path) { char *p = deus_cstr(path); int fd = open(p, O_RDONLY); free(p); if (fd < 0) return UNIT; size_t n; uint8_t *b = deus_slurp(fd, &n); close(fd); if (!b) return UNIT; V r = deus_text_utf8_of(b, n); free(b); return deus_some(r); }") (app (con "#List" 1 2) (text "static V deus_io_save(V path, V t, const char *mode) { char *p = deus_cstr(path); deus_mkparent(p); FILE *f = fopen(p, mode); free(p); if (!f) __built