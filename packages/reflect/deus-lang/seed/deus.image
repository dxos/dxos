(con "#List" 1 2) (text "  branch [name]                        list branches, or create one and switch to it") (app (con "#List" 1 2) (text "  switch <branch>                      change branch") (app (con "#List" 1 2) (text "  merge <branch>                       three-way merge into the current branch") (app (con "#List" 1 2) (text "  log [--n N] / undo                   history / step the branch back") (app (con "#List" 1 2) (text "  audit [--since <branch|causal>]      merges that dropped names neither side deleted, and the deletions") (app (con "#List" 1 2) (text "  restore <branch|causal> [--names …]  add back the names that node had and the branch lacks") (app (con "#List" 1 2) (text "  history import <history.sexp>        keep an export's history under a restored codebase") (app (con "#List" 1 2) (text "  layers                               objects per layer (code, tests, proofs, history, results, …)") (app (con "#List" 1 2) (text "  migrate                              rewrite history with namespace-tree snapshots") (app (con "#List" 1 2) (text "") (app (con "#List" 1 2) (text "analytics (events about the codebase, in @[event] structures; push-only, D104)") (app (con "#List" 1 2) (text "  event types                          event types with their columns and counts") (app (con "#List" 1 2) (text "  event record <Type> field=value…     record an event (a ref field takes a name, an IRI or #hash)") (app (con "#List" 1 2) (text "  event import <file>                  record (event \"Type\" (field value)…) forms") (app (con "#List" 1 2) (text "  event backfill history|timeline <f>  AgentChange events from history.sexp, AgentStage from TIMELINE.md") (app (con "#List" 1 2) (text "  event list [Type] [--about name]     the latest events, of a type or about a definition") (app (con "#List" 1 2) (text "  event stats                          counts per type and per definition (--json: the explorer's events.json)") (app (con "#List" 1 2) (text "  event push [remote]                  write pending events to the remote as Parquet; never pulls") (app (con "#List" 1 2) (text "") (app (con "#List" 1 2) (text "projects") (app (con "#List" 1 2) (text "  project [init <iri>]                 the project's IRI, libraries and owned subgraph") (app (con "#List" 1 2) (text "  lib install <name> <codebase>        mount that project's head under lib.<name> (--branch b)") (app (con "#List" 1 2) (text "") (app (con "#List" 1 2) (text "replication") (app (con "#List" 1 2) (text "  remote add <name> <dir|url|r2://b/p> a remote: a directory, the DEUS Worker (https://<host>/v1/<project>),") (app (con "#List" 1 2) (text "                                       or an R2 bucket and prefix") (app (con "#List" 1 2) (text "  link [name…] [--remote r|--host h]   explorer links for definitions and namespaces on the remote's Worker") (app (con "#List" 1 2) (text "  push [remote] [--branch b]           upload one immutable bundle of what the remote lacks; refuses to drop") (app (con "#List" 1 2) (text "                                       names no change deleted unless --allow-drop") (app (con "#List" 1 2) (text "                                       or makes passing checks fail unless --allow-failing") (app (con "#List" 1 2) (text "  heads [remote] [--branch b]          every head the remote claimed for the branch, newest first") (app (con "#List" 1 2) (text "  pull [remote]                        import new bundles; <remote>.<branch> tracks its heads") (app (con "#List" 1 2) (text "  compact [remote] [--level k]         sedimentree compaction into level-k strata") (app (con "#List" 1 2) (text "  inbox [remote]                       apply comments and tasks members filed in the hosted explorer") (app (con "#List" 1 2) (text "  key list|new|revoke [--remote r]     the Worker's API keys, with an admin key in $DEUS_API_KEY:") (app (con "#List" 1 2) (text "                                       new <label> --scopes push,site [--projects @o/p,…] [--days n]; revoke <id>") (app (con "#List" 1 2) (text "") (app (con "#List" 1 2) (text "running") (app (con "#List" 1 2) (text "  run [--codebase c] <name> [args…]    run name () with IO.args = args (options go before the name)") (app (con "#List" 1 2) (text "  eval <expr>                          evaluate an expression; it may use Workspace.names, .view,") (app (con "#List" 1 2) (text "                                       .update and .run to read and change the codebase") (app (con "#List" 1 2) (text "  artifact <constant> [--out file]     evaluate an @[artifact] constant once and keep its value by hash;") (app (con "#List" 1 2) (text "                                       run, image, build and serve then use the kept value") (app (con "#List" 1 2) (text "  embed <file> --as <Name> [--bytes]   keep a file in the asset store and define Name as its text (or, with") (app (con "#List" 1 2) (text "                                       --bytes, its bytes): an @[artifact] that names only the file's SHA-256") (app (con "#List" 1 2) (text "  mdl [files|dirs…]                    check .mdl documents (or the codebase's specs): each block runs through the") (app (con "#List" 1 2) (text "                                       @[ext \"<uri>\"] term its Extensions table names") (app (con "#List" 1 2) (text "  mdl <files> --base <url> [--browser] run qa flows against a running server instead of in simulation;") (app (con "#List" 1 2) (text "                                       --browser opens each GET in headless Chromium") (app (con "#List" 1 2) (text "  mdl --coverage [documents…]          what specs leave unstated: laws no block cites, public definitions no api names (D125)") (app (con "#List" 1 2) (text "  features [documents…]                feature maps: each feature's status, open tasks, and what is missing (D118)") (app (con "#List" 1 2) (text "  test [prefix] [--integration]        run tests in a deterministic simulation (cached by hash);") (app (con "#List" 1 2) (text "                                       --integration also runs @[integration] tests for real") (app (con "#List" 1 2) (text "                                       --exact: only the test named; --fresh: ignore kept verdicts") (app (con "#List" 1 2) (text "  check [prefix] [--fresh]             check theorems and report their evidence (--fresh: ignore kept verdicts)") (app (con "#List" 1 2) (text "  image <name> -o <file>               write a kernel image") (app (con "#List" 1 2) (text "  build <name> -o <file> [--native]    write a standalone executable that runs name ()") (app (con "#List" 1 2) (text "                                       (--native: Rust kernel + image, ~1 MB; default: Node SEA)") (app (con "#List" 1 2) (text "  build <actor> -o <dir> --worker      write a Cloudflare Worker serving the actor from a Durable Object") (app (con "#List" 1 2) (text "  build <name> -o <dir> --browser      write a static web page that runs name in the browser on the wasm kernel") (app (con "#List" 1 2) (text "  build <handler> -o <file> --server   write a standalone native web server for a handler") (app (con "#List" 1 2) (text "  serve <handler> [--port n]           serve a web handler locally (storage in ./deus-data)") (app (con "#List" 1 2) (text "  explore [--out d|--port n|--publish r|--console]  the codebase explorer: write, serve, or host it on a remote") (app (con "#List" 1 2) (text "") (app (con "#List" 1 2) (text "tasks") (app (con "#List" 1 2) (text "  task new <title…> [--priority p --labels a,b --assignee a --parent id --details d --link name]") (app (con "#List" 1 2) (text "  task [list] [--all|--state s|--label l|--about name]   open tasks, most urgent first") (app (con "#List" 1 2) (text "  task show <id>                       a task, what it links (and how that changed since), its history") (app (con "#List" 1 2) (text "  task set <id> --state doing|done|canceled …   change fields (title, state, priority, assignee, labels, parent, details)") (app (con "#List" 1 2) (text "  task comment <id> <text…>            add a comment (--by <agent>; --attach <file> adds an image)") (app (con "#List" 1 2) (text "  comment <name|change:h> <text…>      comment on a definition or a change (--by, --attach <file>)") (app (con "#List" 1 2) (text "  comments [<name|change:h>]           comments on one subject, or every subject with comments") (app (con "#List" 1 2) (text "  comments import <comments.sexp>      restore comments from an export") (app (con "#List" 1 2) (text "  asset add <file>                     store a file in the codebase's asset store; prints its SHA-256") (app (con "#List" 1 2) (text "  task link <id> <name>|--change <h>   attach a definition or a change; unlink <id> <name> detaches") (app (con "#List" 1 2) (text "  update <files…> --closes <id>        mark a task done, linked to the change that fixed it") (app (con "#List" 1 2) (text "  task import <tasks.sexp>             restore tasks from an export") (app (con "#List" 1 2) (text "  export <dir>                         the codebase as text for git: code/<Namespace>.deus, tasks, history") (app (con "#List" 1 2) (text "  export <dir> --terms                 one file per definition at its namespace path (A/B/c.deus), specs as A/B.mdl") (app (con "#List" 1 2) (text "  build <name…> -o <file.js> --js      compile to an ES module with a source map, no kernel (D97)") (app (con "#List" 1 2) (text "  build <fn> -o <file.wasm> --wasm     compile a first-order function on Int, Bool and data (and its callees) to wasm") (app (con "#List" 1 2) (text "  build <fn> -o <file> --c             the same subset to C, compiled to an executable by $CC (default cc); -o x.c writes the source") (app (con "#List" 1 2) (text "  bindings <prefix|name…> -o <dir>     a JS module + .d.ts that calls those functions on the wasm kernel") (app (con "#List" 1 2) (text "  compile <files|dirs…> --main <name>  compile files without a codebase") (app (con "#List" 1 2) (text "") (con "#List" 0 0)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
