> ((b) & 31)))") (app (con "#List" 1 2) (text "#define USHR(a, b) W((uint32_t)(a) >> ((b) & 31))") (app (con "#List" 1 2) (text "static inline V DIV(V a, V b) { if (b == 0) __builtin_trap(); return b == -1 ? SUB(0, a) : (V)((int32_t)a / (int32_t)b); }") (app (con "#List" 1 2) (text "static inline V MOD(V a, V b) { if (b == 0) __builtin_trap(); return b == -1 ? 0 : (V)((int32_t)a % (int32_t)b); }") (app (con "#List" 1 2) (text "static V deus_live, deus_peak;") (app (con "#List" 1 2) (text "static V *deus_free_lists[257];") (app (con "#List" 1 2) (text "/* Freed blocks over 256 words, as [next, words, …]: reused by an exact fit among the first 16. */") (app (con "#List" 1 2) (text "static V *deus_big;") (app (con "#List" 1 2) (text "static V *deus_big_take(V words) { V **link = &deus_big; for (int i = 0; *link && i < 16; i++, link = (V **)(uintptr_t)*link) { V *h = *link; if (h[1] == words) { *link = (V *)(uintptr_t)h[0]; return h; } } return 0; }") (app (con "#List" 1 2) (text "/* A block's header, the word before it: its count times 256, plus its kind. */") (app (con "#List" 1 2) (text "#define PHDR(p) ((p)[-1])") (app (con "#List" 1 2) (text "#define HDR(v) PHDR(UNBOX(v))") (app (con "#List" 1 2) (text "#define K_TABLE 252") (app (con "#List" 1 2) (text "#define K_TEXT 253") (app (con "#List" 1 2) (text "#define K_REF 254") (app (con "#List" 1 2) (text "#define K_ARRAY 255") (app (con "#List" 1 2) (text "#define UNIQUE(v) (HDR(v) < 512)") (app (con "#List" 1 2) (text "static inline V *deus_block(V kind, V body) { V words = body + 1; V *h; deus_live += words; if (deus_live > deus_peak) deus_peak = deus_live; if (words <= 256 && (h = deus_free_lists[words])) deus_free_lists[words] = (V *)(uintptr_t)h[0]; else if (words <= 256 || !(h = deus_big_take(words))) h = deus_raw(words); h[0] = 256 | kind; return h + 1; }") (app (con "#List" 1 2) (text "static inline V deus_body(V *p) { V k = PHDR(p) & 255; return k == K_ARRAY ? p[0] + 1 : k == K_REF ? 1 : k == K_TEXT ? 2 + (p[1] + 3) / 4 : k == K_TABLE ? 4 : k + 1; }") (app (con "#List" 1 2) (text "static inline void deus_release(V *p) { V words = deus_body(p) + 1; deus_live -= words; if (words <= 256) { p[-1] = (V)(uintptr_t)deus_free_lists[words]; deus_free_lists[words] = p - 1; } else { p[-1] = (V)(uintptr_t)deus_big; p[0] = words; deus_big = p - 1; } }") (app (con "#List" 1 2) (text "static V *deus_stack, deus_sp, deus_cap;") (app (con "#List" 1 2) (text "static void deus_push(V v) { if (deus_sp == deus_cap) { V cap = deus_cap ? 2 * deus_cap : 1024; V *bigger = deus_raw(cap); for (V i = 0; i < deus_sp; i++) bigger[i] = deus_stack[i]; deus_stack = bigger; deus_cap = cap; } deus_stack[deus_sp++] = v; }") (app (con "#List" 1 2) (text "/* A native program with the interpreter frees what its closures hold; `deus_icodes` names their code. */") (app (con "#List" 1 2) (text "static void (*deus_ifree)(V *p);") (app (con "#List" 1 2) (text "static V deus_icodes[3];") (app (con "#List" 1 2) (text "static void deus_free(V *p) {") (app (con "#List" 1 2) (text "  for (;;) {") (app (con "#List" 1 2) (text "    V k = PHDR(p) & 255; V *from = k == K_REF ? p : k == K_TABLE ? p + 2 : p + 1; V n = k == K_ARRAY ? p[0] : k == K_REF ? 1 : k == K_TEXT ? 0 : k == K_TABLE ? 2 : k;") (app (con "#List" 1 2) (text "    for (V i = 0; i < n; i++) { V c = from[i]; if (IS_PTR(c)) { if (!UNIQUE(c)) HDR(c) -= 256; else deus_push(c); } }") (app (con "#List" 1 2) (text "    if (deus_ifree && k >= 2 && k < K_TABLE && (p[0] == deus_icodes[0] || p[0] == deus_icodes[1] || p[0] == deus_icodes[2])) deus_ifree(p); deus_release(p);") (app (con "#List" 1 2) (text "    if (deus_sp == 0) return;") (app (con "#List" 1 2) (text "    p = UNBOX(deus_stack[--deus_sp]);") (app (con "#List" 1 2) (text "  }") (app (con "#List" 1 2) (text "}") (app (con "#List" 1 2) (text "static inline V deus_dup(V v) { if (IS_PTR(v)) HDR(v) += 256; return v; }") (app (con "#List" 1 2) (text "static inline void deus_drop(V v) { if (IS_PTR(v)) { if (!UNIQUE(v)) HDR(v) -= 256; else deus_free(UNBOX(v)); } }") (app (con "#List" 1 2) (text "/* A constructor block, in the memory of a dead block of the same size when there is one. */") (app (con "#List" 1 2) (text "static inline V *deus_con(V *token, V fields) { if (token) { token[-1] = 256 | fields; return token; } return deus_block(fields, fields + 1); }") (app (con "#List" 1 2) (text "/* A closure is a block [code, captured…]; the code borrows it and owns its argument. */") (app (con "#List" 1 2) (text "typedef V (*deus_code)(V, V);") (app (con "#List" 1 2) (text "static inline V deus_apply(V c, V x) { return ((deus_code)(uintptr_t)UNBOX(c)[0])(c, x); }") (app (con "#List" 1 2) (text "static inline V deus_apply_drop(V c, V x) { V r = deus_apply(c, x); deus_drop(c); return r; }") (app (con "#List" 1 2) (text "static inline void deus_unused(V *token) { if (token) deus_release(token); }") (app (con "#List" 1 2) (text "static V deus_array(V n, V x) { if (n < 0) __builtin_trap(); V *p = deus_block(K_ARRAY, n + 1); p[0] = n; if (n == 0) deus_drop(x); else if (IS_PTR(x)) HDR(x) += 256 * (n - 1); for (V i = 1; i <= n; i++) p[i] = x; return BOX(p); }") (app (con "#List" 1 2) (text "/* A pure `Array.set` (D96) writes into a unique array and copies a shared one, counting each item again. */") (app (con "#List" 1 2) (text "static V deus_array_copy(V a) { V *q = UNBOX(a); V n = q[0]; V *p = deus_block(K_ARRAY, n + 1); p[0] = n; for (V i = 1; i <= n; i++) p[i] = deus_dup(q[i]); return BOX(p); }") (app (con "#List" 1 2) (text "static inline V deus_array_unique(V a) { if (UNIQUE(a)) return a; V r = deus_array_copy(a); HDR(a) -= 256; return r; }") (app (con "#List" 1 2) (text "#define AT(a, i) ({ V *a_ = UNBOX(a); V i_ = (i); if ((uint32_t)i_ >= (uint32_t)a_[0]) __builtin_trap(); &a_[i_ + 1]; })") (app (con "#List" 1 2) (app (prim "append") (app (prim "append") (app (prim "append") (app (prim "append") (text "static V deus_nullary[") (app (ref "ec6b009651baeb055ac9a9943e35a15b6d30f7f6c9991b4df50e7377efc3569a") (app (ref "42ba69c5dd889ac41613460f91ef85f673a3ee56ec8caaff48e39720573ed823") (var 0) (int 1)))) (text "] = {")) (app (ref "39916a90fbeb5d8aa0cddf9fd42cf449ccd9d0da82811353177fff735b8efcd5") (text ", ") (app (ref "a0acb612a35ab13ff8495a68db1d9bacfa8f04d745d42c1372a7ef3c5fd2f952") (ref "ec6b009651baeb055ac9a9943e35a15b6d30f7f6c9991b4df50e7377efc3569a") (app (ref "4dceb78c198b16c921f5fdafe25d56b995b36282566eb5eacca007c26f343dd4") (int 0) (app (ref "42ba69c5dd889ac41613460f91ef85f673a3ee56ec8caaff48e39720573ed823") (var 0) (int 1)))))) (text "};")) (app (con "#List" 1 2) (text "/* Text is a block [length, capacity, UTF-16 units…] (D115). These borrow their arguments. */") (app (con "#List" 1 2) (text "#define TLEN(v) (UNBOX(v)[0])") (app (con "#List" 1 2) (text "#define TCAP(v) (UNBOX(v)[1])") (app (con "#List" 1 2) (text "#define TU(v) ((uint16_t *)(UNBOX(v) + 2))") (app (con "#List" 1 2) (text "static V deus_text_cap(V n, V cap) { cap = (cap + 3) & ~(V)3; V *p = deus_block(K_TEXT, 2 + cap / 4); p[0] = n; p[1] = cap; return BOX(p); }") (app (con "#List" 1 2) (text "static V deus_text(V n) { return deus_text_cap(n, n); }") (app (con "#List" 1 2) (text "static void deus_units(uint16_t *d, const uint16_t *s, V n) { for (V i = 0; i < n; i++) d[i] = s[i]; }") (app (con "#List" 1 2) (text "static V deus_text_of(const uint16_t *s, V n) { V r = deus_text(n); deus_units(TU(r), s, n); return r; }") (app (con "#List" 1 2) (text "static V deus_text_append(V a, V b) { V m = TLEN(a), n = TLEN(b); if (n == 0) return deus_dup(a); if (m == 0) return deus_dup(b); V r = deus_text(m + n); deus_units(TU(r), TU(a), m); deus_units(TU(r) + m, TU(b), n); return r; }") (app (con "#List" 1 2) (text "/* `a ++ b` that consumes `a`: a unique `a` grows in place, doubling its capacity when it is full, so a loop that appends to its text is linear. */") (app (con "#List" 1 2) (text "static V deus_text_extend(V a, V b) { V m = TLEN(a), n = TLEN(b); if (n == 0) return a; if (IS_PTR(a) && UNIQUE(a)) { if (m + n <= TCAP(a)) { deus_units(TU(a) + m, TU(b), n); TLEN(a) = m + n; return a; } V r = deus_text_cap(m + n, 2 * (m + n)); deus_units(TU(r), TU(a), m); deus_units(TU(r) + m, TU(b), n); deus_release(UNBOX(a)); return r; } V r = deus_text_append(a, b); deus_drop(a); return r; }") (app (con "#List" 1 2) (text "static V deus_text_cmp(V a, V b) { V m = TLEN(a), n = TLEN(b); uint16_t *x = TU(a), *y = TU(b); for (V i = 0; i < m && i < n; i++) if (x[i] != y[i]) return x[i] < y[i] ? -1 : 1; return m < n ? -1 : m > n ? 1 : 0; }") (app (con "#List" 1 2) (text "static V deus_text_eq(V a, V b) { if (a == b) return 1; V n = TLEN(a); if (n != TLEN(b)) return 0; uint16_t *x = TU(a), *y = TU(b); for (V i = 0; i < n; i++) if (x[i] != y[i]) return 0; return 1; }") (app (con "#List" 1 2) (text "static V deus_text_code(V t, V i) { return (uint32_t)i < (uint32_t)TLEN(t) ? (V)TU(t)[i] : -1; }") (app (con "#List" 1 2) (text "static V deus_clamp(V i, V n) { return i < 0 ? (n + i < 0 ? 0 : n + i) : i > n ? n : i; }") (app (con "#List" 1 2) (text "static V deus_text_slice(V t, V s, V e) { V n = TLEN(t), from = deus_clamp(s, n), to = deus_clamp(e, n); if (from == 0 && to == n) return deus_dup(t); return deus_text_of(TU(t) + from, from < to ? to - from : 0); }") (app (con "#List" 1 2) (text "static V deus_text_from_code(V c) { uint16_t u = (uint16_t)c; return deus_text_of(&u, 1); }") (app (con "#List" 1 2) (text "static V deus_text_index(V t, V needle, V from) { V n = TLEN(t), m = TLEN(needle), i = from < 0 ? 0 : from > n ? n : from; uint16_t *x = TU(t), *y = TU(needle); for (; i + m <= n; i++) { V j = 0; while (j < m && x[i + j] == y[j]) j++; if (j == m) return i; } return -1; }") (app (con "#List" 1 2) (text "static int deus_space(uint16_t u) { return (u >= 9 && u <= 13) || u == 32 || u == 0xa0 || u == 0x1680 || (u >= 0x2000 && u <= 0x200a) || u == 0x2028 || u == 0x2029 || u == 0x202f || u == 0x205f || u == 0x3000 || u == 0xfeff; }") (app (con "#List" 1 2) (text "static V deus_text_trim(V t) { V n = TLEN(t), s = 0, e = n; uint16_t *x = TU(t); while (s < n && deus_space(x[s])) s++; while (e > s && deus_space(x[e - 1])) e--; return deus_text_slice(t, s, e); }") (app (con "#List" 1 2) (text "/* A list is nil, the static block [0], or a block [1, head, tail]. */") (app (con "#List" 1 2) (text "static V deus_text_join(V sep, V xs) { V n = 0, k = 0; for (V c = xs; UNBOX(c)[0]; c = UNBOX(c)[2], k++) n += TLEN(UNBOX(c)[1]); if (k == 1) return deus_dup(UNBOX(xs)[1]); if (k > 1) n += (k - 1) * TLEN(sep); V r = deus_text(n); uint16_t *d = TU(r); for (V c = xs; UNBOX(c)[0]; c = UNBOX(c)[2]) { if (c != xs) { deus_units(d, TU(sep), TLEN(sep)); d += TLEN(sep); } V h = UNBOX(c)[1]; deus_units(d, TU(h), TLEN(h)); d += TLEN(h); } return r; }") (app (con "#List" 1 2) (text "static V deus_cons(V h, V t) { V *p = deus_block(2, 3); p[0] = 1; p[1] = h; p[2] = t; return BOX(p); }") (app (con "#List" 1 2) (text "static V deus_text_split(V t, V sep) { V n = TLEN(t), m = TLEN(sep), r, *slot = &r; uint16_t *x = TU(t), *y = TU(sep); if (m == 0) { for (V i = 0; i < n; i++) { V c = deus_cons(deus_text_of(x + i, 1), 0); *slot = c; slot = &UNBOX(c)[2]; } } else { V start = 0, i = 0; while (i + m <= n) { V j = 0; while (j < m && x[i + j] == y[j]) j++; if (j == m) { V c = deus_cons(deus_text_of(x + start, i - start), 0); *slot = c; slot = &UNBOX(c)[2]; i += m; start = i; } else i++; } V c = deus_cons(deus_text_of(x + start, n - start), 0); *slot = c; slot = &UNBOX(c)[2]; } *slot = STATIC(&deus_nullary[0]); return r; }") (app (con "#List" 1 2) (text "static V deus_int_text(V v) { uint16_t u[12]; int k = 12; uint32_t m = (int32_t)v < 0 ? 0u - (uint32_t)v : (uint32_t)v; do { u[--k] = (uint16_t)('0' + m % 10); m /= 10; } while (m); if ((int32_t)v < 0) u[--k] = '-'; return deus_text_of(u + k, 12 - k); }") (app (con "#List" 1 2) (text "/* `/^-?[0-9]+$/`, then wrapped to 32 bits as `Number(t) | 0` is (exactly, below 2^53). */") (app (con "#List" 1 2) (text "static V deus_text_int(V t) { V n = TLEN(t), i = 0; uint16_t *x = TU(t); int neg = n > 0 && x[0] == '-'; if (neg) i = 1; if (i == n) return STATIC(&deus_nullary[0]); uint32_t m = 0; for (; i < n; i++) { if (x[i] < '0' || x[i] > '9') return STATIC(&deus_nullary[0]); m = m * 10 + (x[i] - '0'); } V *p = deus_block(1, 2); p[0] = 1; p[1] = W(neg ? 0u - m : m); return BOX(p); }") (app (con "#List" 1 2) (text "/* A literal is made once, on first use, with a count no program brings to one, and is not counted as live. */") (app (con "#List" 1 2) (text "static V deus_literal(const uint16_t *u, V n) { V r = deus_text_of(u, n); HDR(r) = ((V)1 << 48) | K_TEXT; deus_live -= deus_body(UNBOX(r)) + 1; return r; }") (app (con "#List" 1 2) (text "/* A constant's value (D125) keeps a count no program brings to one, like a literal's. */") (app (con "#List" 1 2) (text "static void deus_immortal(V v) { if (IS_PTR(v)) HDR(v) = ((V)1 << 48) | (HDR(v) & 255); }") (app (con "#List" 1 2) (text "/* Values whose type the compiler does not know (D137): a text is a heap block of kind K_TEXT, an Int is not a block,") (app (con "#List" 1 2) (text "   a nullary constructor is its static block and any other is [tag, fields…] of kind its field count. */") (app (con "#List" 1 2) (text "#define IS_TEXT(v) (IS_PTR(v) && (HDR(v) & 255) == K_TEXT)") (app (con "#List" 1 2) (text "static V deus_tag_any(V v) { if (IS_PTR(v)) { if ((HDR(v) & 255) >= K_TABLE) __builtin_trap(); return UNBOX(v)[0]; } return (V)((V *)(uintptr_t)v - deus_nullary); }") (app (con "#List" 1 2) (text "static V deus_cmp_any(V a, V b) { if (a == b) return 0; if (IS_TEXT(a) && IS_TEXT(b)) return deus_text_cmp(a, b); if (!IS_PTR(a) && !IS_PTR(b)) return (a > b) - (a < b); V x = deus_tag_any(a), y = deus_tag_any(b); if (x != y || !IS_PTR(a) || !IS_PTR(b)) return (x > y) - (x < y); for (V i = 1, k = HDR(a) & 255; i <= k; i++) { V c = deus_cmp_any(UNBOX(a)[i], UNBOX(b)[i]); if (c) return c; } return 0; }") (app (con "#List" 1 2) (text "static V deus_eq_any(V a, V b) { if (a == b) return 1; if (IS_TEXT(a) && IS_TEXT(b)) return deus_text_eq(a, b); if (!IS_PTR(a) && !IS_PTR(b)) return 0; if (deus_tag_any(a) != deus_tag_any(b) || !IS_PTR(a) || !IS_PTR(b)) return 0; for (V i = 1, k = HDR(a) & 255; i <= k; i++) if (!deus_eq_any(UNBOX(a)[i], UNBOX(b)[i])) return 0; return 1; }") (app (con "#List" 1 2) (text "static V deus_text_concat(V xs) { static struct { V h, n, cap; } empty = {0, 0, 0}; return deus_text_join(STATIC(&empty.n), xs); }") (app (con "#List" 1 2) (text "static inline V deus_int_cmp(V x, V y) { return (x > y) - (x < y); }") (app (con "#List" 1 2) (text "/* `++` on lists: the unique prefix of the first list is relinked in place, the rest copied (D115). Consumes both. */") (app (con "#List" 1 2) (text "static V deus_list_append(V a, V b) { V r, *slot = &r, c = a; int mine = 1; while (UNBOX(c)[0]) { V *p = UNBOX(c); if (mine && UNIQUE(c)) { *slot = c; slot = &p[2]; } else { if (mine) HDR(c) -= 256; mine = 0; V n = deus_cons(deus_dup(p[1]), 0); *slot = n; slot = &UNBOX(n)[2]; } c = p[2]; } *slot = b; return r; }") (app (con "#List" 1 2) (text "static V deus_append_any(V a, V b) { if (IS_TEXT(a)) { V r = deus_text_extend(a, b); deus_drop(b); return r; } return deus_list_append(a, b); }") (app (con "#List" 1 2) (text "/* Dict and MutMap (D119): a block [size, used, entries, index] of kind K_TABLE. `entries` is an array of") (app (con "#List" 1 2) (text "   key-value pairs in insertion order, a deleted key being DEUS_NOKEY; `index` an open-addressed array of") (app (con "#List" 1 2) (text "   entry numbers, -1 where empty, at most half full. Keys are Int or Text, as in the kernels. All borrow. */") (app (con "#List" 1 2) (text "#define DEUS_NOKEY ((V)1 << 62)") (app (con "#List" 1 2) (text "static uint32_t deus_hash(V k) { if (IS_TEXT(k)) { uint32_t h = 2166136261u; V n = TLEN(k); uint16_t *x = TU(k); for (V i = 0; i < n; i++) h = (h ^ x[i]) * 16777619u; return h; } if (IS_PTR(k)) __builtin_trap(); uint32_t h = (uint32_t)k * 2654435761u; return h ^ (h >> 16); }") (app (con "#List" 1 2) (text "static inline V deus_key_eq(V a, V b) { return a == b || (IS_TEXT(a) && IS_TEXT(b) && deus_text_eq(a, b)); }") (app (con "#List" 1 2) (text "static V deus_table_new(V unit) { (void)unit; V *t = deus_block(K_TABLE, 4); t[0] = 0; t[1] = 0; t[2] = deus_array(16, DEUS_NOKEY); t[3] = deus_array(16, -1); return BOX(t); }") (app (con "#List" 1 2) (text "static V deus_table_find(V *t, V k) { V *ix = UNBOX(t[3]) + 1, *es = UNBOX(t[2]) + 1; V mask = UNBOX(t[3])[0] - 1; for (V i = deus_hash(k) & mask;; i = (i + 1) & mask) { V e = ix[i]; if (e < 0) return -1; if (deus_key_eq(es[2 * e], k)) return e; } }") (app (con "#List" 1 2) (text "static void deus_table_index(V *t, V k, V e) { V *ix = UNBOX(t[3]) + 1; V mask = UNBOX(t[3])[0] - 1; V i = deus_hash(k) & mask; while (ix[i] >= 0) i = (i + 1) & mask; ix[i] = e; }") (app (con "#List" 1 2) (text "/* Room for twice the live entries: the live ones move, in order, to new arrays, and the index is rebuilt. */") (app (con "#List" 1 2) (text "static void deus_table_grow(V *t) { V cap = 2 * t[0] + 8, icap = 16; while (icap < 2 * cap) icap *= 2; V *old = UNBOX(t[2]) + 1, used = t[1]; V es = deus_array(2 * cap, DEUS_NOKEY); V *to = UNBOX(es) + 1; V n = 0; for (V e = 0; e < used; e++) if (old[2 * e] != DEUS_NOKEY) { to[2 * n] = old[2 * e]; to[2 * n + 1] = old[2 * e + 1]; old[2 * e] = DEUS_NOKEY; old[2 * e + 1] = 0; n++; } deus_drop(t[2]); deus_drop(t[3]); t[2] = es; t[3] = deus_array(icap, -1); t[1] = n; for (V e = 0; e < n; e++) deus_table_index(t, to[2 * e], e); }") (app (con "#List" 1 2) (text "static V deus_table_set(V m, V k, V v) { V *t = UNBOX(m); V e = deus_table_find(t, k); if (e >= 0) { V *s = UNBOX(t[2]) + 2 + 2 * e; V old = *s; *s = deus_dup(v); deus_drop(old); } else { if (2 * (t[1] + 1) > UNBOX(t[2])[0]) deus_table_grow(t); e = t[1]++; t[0]++; V *s = UNBOX(t[2]) + 1 + 2 * e; s[0] = deus_dup(k); s[1] = deus_dup(v); deus_table_index(t, k, e); } return STATIC(&deus_nullary[0]); }") (app (con "#List" 1 2) (text "static V deus_table_get(V m, V k) { V *t = UNBOX(m); V e = deus_table_find(t, k); if (e < 0) return STATIC(&deus_nullary[0]); V *p = deus_block(1, 2); p[0] = 1; p[1] = deus_dup(UNBOX(t[2])[2 + 2 * e]); return BOX(p); }") (app (con "#List" 1 2) (text "static V deus_table_has(V m, V k) { return deus_table_find(UNBOX(m), k) >= 0; }") (app (con "#List" 1 2) (text "static V deus_table_delete(V m, V k) { V *t = UNBOX(m); V e = deus_table_find(t, k); if (e >= 0) { V *s = UNBOX(t[2]) + 1 + 2 * e; deus_drop(s[0]); deus_drop(s[1]); s[0] = DEUS_NOKEY; s[1] = 0; t[0]--; } return STATIC(&deus_nullary[0]); }") (app (con "#List" 1 2) (text "static V deus_table_size(V m) { return UNBOX(m)[0]; }") (app (con "#List" 1 2) (text "static V deus_table_keys(V m) { V *t = UNBOX(m), *es = UNBOX(t[2]) + 1, r, *slot = &r; for (V e = 0; e < t[1]; e++) if (es[2 * e] != DEUS_NOKEY) { V c = deus_cons(deus_dup(es[2 * e]), 0); *slot = c; slot = &UNBOX(c)[2]; } *slot = STATIC(&deus_nullary[0]); return r; }") (app (con "#List" 1 2) (text "/* A list of pairs [0, key, value]; a later key replaces an earlier one's value, as in the kernels. */") (app (con "#List" 1 2) (text "static V deus_dict_from_list(V xs) { V d = deus_table_new(0); for (V c = xs; UNBOX(c)[0]; c = UNBOX(c)[2]) { V *pair = UNBOX(UNBOX(c)[1]); deus_table_set(d, pair[1], pair[2]); } return d; }") (app (con "#List" 1 2) (text "static V deus_dict_lookup(V k, V d) { return deus_table_get(d, k); }") (app (con "#List" 1 2) (text "static V deus_dict_contains(V k, V d) { return deus_table_has(d, k); }") (app (con "#List" 1 2) (text "/* Handlers (D124). The abort marker is no value a program makes: not an Int, not a block. */") (app (con "#List" 1 2) (text "#ifdef __wasm__") (app (con "#List" 1 2) (text "#define DEUS_ABORT ((V)1 << 40)") (app (con "#List" 1 2) (text "#else") (app (con "#List" 1 2) (text "#define DEUS_ABORT ((V)(uintptr_t)deus_base - 8)") (app (con "#List" 1 2) (text "#endif") (app (con "#List" 1 2) (text "/* An installed clause is a record [parent, frame, ability, op, clause]; a handler's first record is its frame, with no clause.") (app (con "#List" 1 2) (text "   `deus_hctx` is the innermost visible record. A running clause hides its handler and the ones inside it. */") (app (con "#List" 1 2) (text "static V *deus_hrec, deus_hn, deus_hcap, deus_hctx = -1, *deus_cst, deus_cn, deus_ccap, deus_abort_frame = -1, deus_abort_value;") (app (con "#List" 1 2) (text "static V *deus_grow(V *p, V used, V *cap, V need) { if (used + need <= *cap) return p; V c = *cap ? 2 * *cap : 64; while (used + need > c) c *= 2; V *q = deus_raw(c); for (V i = 0; i < used; i++) q[i] = p[i]; *cap = c; return q; }") (app (con "#List" 1 2) (text "#define HREC(r, f) deus_hrec[5 * (r) + (f)]") (app (con "#List" 1 2) (text "static V deus_hpush(V parent, V frame, V a, V i, V c) { deus_hrec = deus_grow(deus_hrec, 5 * deus_hn, &deus_hcap, 5); V r = deus_hn++; HREC(r, 0) = parent; HREC(r, 1) = frame; HREC(r, 2) = a; HREC(r, 3) = i; HREC(r, 4) = c; return r; }") (app (con "#List" 1 2) (text "static V deus_handle_enter(V unused) { (void)unused; V f = deus_hpush(deus_hctx, deus_hn, -1, -1, 0); deus_hctx = f; return f; }") (app (con "#List" 1 2) (text "static V deus_handle_add(V f, V a, V i, V c) { deus_hctx = deus_hpush(deus_hctx, f, a, i, deus_dup(c)); return STATIC(&deus_nullary[0]); }") (app (con "#List" 1 2) (text "static V deus_handle_exit(V f) { deus_hctx = HREC(f, 0); for (V r = f; r < deus_hn; r++) deus_drop(HREC(r, 4)); deus_hn = f; return STATIC(&deus_nullary[0]); }") (app (con "#List" 1 2) (text "/* The clause for operation `i` of ability `a`, run with its handler hidden until `deus_clause_done`; none is a defect. */") (app (con "#List" 1 2) (text "static V deus_clause(V a, V i) { for (V r = deus_hctx; r >= 0; r = HREC(r, 0)) if (HREC(r, 2) == a && HREC(r, 3) == i) { V f = HREC(r, 1); deus_cst = deus_grow(deus_cst, 2 * deus_cn, &deus_ccap, 2); deus_cst[2 * deus_cn] = deus_hctx; deus_cst[2 * deus_cn + 1] = f; deus_cn++; deus_hctx = HREC(f, 0); return deus_dup(HREC(r, 4)); } __builtin_trap(); }") (app (con "#List" 1 2) (text "/* Whether a visible handler has a clause for operation `i` of ability `a`; `IO` falls back to the host (D129). */") (app (con "#List" 1 2) (text "static V deus_handled(V a, V i) { for (V r = deus_hctx; r >= 0; r = HREC(r, 0)) if (HREC(r, 2) == a && HREC(r, 3) == i) return 1; return 0; }") (app (con "#List" 1 2) (text "static V deus_clause_done(V v) { deus_cn--; deus_hctx = deus_cst[2 * deus_cn]; return deus_dup(v); }") (app (con "#List" 1 2) (text "static V deus_abort_to(V v) { if (v == DEUS_ABORT) return v; deus_abort_frame = deus_cst[2 * deus_cn - 1]; deus_abort_value = deus_dup(v); return DEUS_ABORT; }") (app (con "#List" 1 2) (text "static V deus_caught(V f, V r) { return r == DEUS_ABORT && deus_abort_frame == f; }") (app (con "#List" 1 2) (text "static V deus_caught_value(V unused) { (void)unused; deus_abort_frame = -1; return deus_abort_value; }") (app (con "#List" 1 2) (text "static V deus_aborted(V r) { return r == DEUS_ABORT; }") (app (con "#List" 1 2) (text "static V deus_abort_marker(V unused) { (void)unused; return DEUS_ABORT; }") (app (con "#List" 1 2) (text "/* UTF-8, as the kernels encode a text: a lone surrogate becomes U+FFFD. `o` needs 3 bytes a unit. */") (app (con "#List" 1 2) (text "static V deus_utf8(const uint16_t *x, V n, uint8_t *o) { V k = 0; for (V i = 0; i < n; i++) { uint32_t c = x[i]; if (c >= 0xd800 && c < 0xdc00 && i + 1 < n && x[i + 1] >= 0xdc00 && x[i + 1] < 0xe000) c = 0x10000 + ((c - 0xd800) << 10) + (x[++i] - 0xdc00); else if (c >= 0xd800 && c < 0xe000) c = 0xfffd; if (c < 0x80) o[k++] = (uint8_t)c; else if (c < 0x800) { o[k++] = (uint8_t)(0xc0 | c >> 6); o[k++] = (uint8_t)(0x80 | (c & 63)); } else if (c < 0x10000) { o[k++] = (uint8_t)(0xe0 | c >> 12); o[k++] = (uint8_t)(0x80 | (c >> 6 & 63)); o[k++] = (uint8_t)(0x80 | (c & 63)); } else { o[k++] = (uint8_t)(0xf0 | c >> 18); o[k++] = (uint8_t)(0x80 | (c >> 12 & 63)); o[k++] = (uint8_t)(0x80 | (c >> 6 & 63)); o[k++] = (uint8_t)(0x80 | (c & 63)); } } return k; }") (app (con "#List" 1 2) (text "/* A scratch buffer of `bytes` bytes is a text block, so it comes from and returns to the heap. */") (app (con "#List" 1 2) (text "static V deus_scratch(V bytes) { return deus_text(bytes / 2 + 1); }") (app (con "#List" 1 2) (text "static V deus_text_utf8(V t) { V b = deus_scratch(3 * TLEN(t)); uint8_t *o = (uint8_t *)TU(b); V k = deus_utf8(TU(t), TLEN(t), o), r, *slot = &r; for (V i = 0; i < k; i++) { V c = deus_cons(o[i], 0); *slot = c; slot = &UNBOX(c)[2]; } *slot = STATIC(&deus_nullary[0]); deus_drop(b); return r; }") (app (con "#List" 1 2) (text "/* Code points to units, a code above U+FFFF as its surrogate pair (D76); a code out of range is a defect. */") (app (con "#List" 1 2) (text "static V deus_text_from_codes(V xs) { V n = 0; for (V c = xs; UNBOX(c)[0]; c = UNBOX(c)[2]) { V v = UNBOX(c)[1]; if (v < 0 || v > 0x10ffff) __builtin_trap(); n += v > 0xffff ? 2 : 1; } V r = deus_text(n); uint16_t *o = TU(r); V k = 0; for (V c = xs; UNBOX(c)[0]; c = UNBOX(c)[2]) { V v = UNBOX(c)[1]; if (v > 0xffff) { o[k++] = (uint16_t)(0xd800 + ((v - 0x10000) >> 10)); o[k++] = (uint16_t)(0xdc00 + ((v - 0x10000) & 0x3ff)); } else o[k++] = (uint16_t)v; } return r; }") (app (con "#List" 1 2) (text "static const uint32_t deus_k256[64] = { 0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,