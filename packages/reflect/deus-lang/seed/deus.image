ist" 1 2) (text "    case P_COST: { uint32_t before = deus_isteps; V r = deus_iapply(a[0], UNIT); if (r == DEUS_ABORT) return r; deus_drop(r); deus_drop(a[0]); return W(deus_isteps - before); }") (app (con "#List" 1 2) (text "    case P_RUN: { V r = deus_irun(a[0]); deus_drop(a[0]); return r; }") (app (con "#List" 1 2) (text "    case P_TAG: { V r = deus_code_tag(a[0]); deus_drop(a[0]); return r; }") (app (con "#List" 1 2) (text "    case P_FIELD: { V r = deus_dup(UNBOX(a[0])[a[1] + 1]); deus_drop(a[0]); return r; }") (app (con "#List" 1 2) (text "    case P_CAST: return a[0];") (app (con "#List" 1 2) (text "  }") (app (con "#List" 1 2) (text "  return deus_idefect_c(\"unknown primitive\");") (app (con "#List" 1 2) (text "}") (app (con "#List" 1 2) (text "") (app (con "#List" 1 2) (text "/* A saturated call of a primitive, constructor, operation or clause; `args` holds exactly its arity. */") (app (con "#List" 1 2) (text "static V deus_icall(DT *callee, DE *e, V *args) {") (app (con "#List" 1 2) (text "  switch (callee->t) {") (app (con "#List" 1 2) (text "    case DT_PRIM: return deus_iprim(callee->i, args);") (app (con "#List" 1 2) (text "    case DT_CON: { V n = callee->arity, *p = deus_block(n, n + 1); p[0] = callee->tag; for (V i = 0; i < n; i++) p[1 + i] = args[i]; return BOX(p); }") (app (con "#List" 1 2) (text "    case DT_OP: return deus_iperform(callee, args);") (app (con "#List" 1 2) (text "    default: { DE *c = deus_eref(e); for (V i = 0; i < callee->arity; i++) c = deus_ipush(c, args[i]); c = deus_ipush(c, DEUS_K); V r = deus_itail(callee->a, c); deus_erelease(c); return r; }") (app (con "#List" 1 2) (text "  }") (app (con "#List" 1 2) (text "}") (app (con "#List" 1 2) (text "/* Function `i` of a `letrec` group, [deus_ilamrec, group, env, i]: it holds the environment around the group, and a call") (app (con "#List" 1 2) (text "   makes the group's cells anew, so no cell holds a closure that holds that cell. */") (app (con "#List" 1 2) (text "static V d