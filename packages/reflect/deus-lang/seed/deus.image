c V deus_icmp(V a, V b, int *bad) {") (app (con "#List" 1 2) (text "  for (;;) {") (app (con "#List" 1 2) (text "    if (a == b) return 0;") (app (con "#List" 1 2) (text "    int pa = IS_PTR(a), pb = IS_PTR(b);") (app (con "#List" 1 2) (text "    if (pa && pb && (HDR(a) & 255) == K_TEXT && (HDR(b) & 255) == K_TEXT) return deus_text_cmp(a, b);") (app (con "#List" 1 2) (text "    if (!pa && !pb) { int na = (uintptr_t)a - (uintptr_t)deus_nullary < sizeof deus_nullary, nb = (uintptr_t)b - (uintptr_t)deus_nullary < sizeof deus_nullary; if (!na && !nb) return (a > b) - (a < b); }") (app (con "#List" 1 2) (text "    V ka = pa ? HDR(a) & 255 : 0, kb = pb ? HDR(b) & 255 : 0;") (app (con "#List" 1 2) (text "    if (ka == K_ARRAY && kb == K_ARRAY) { V m = UNBOX(a)[0], n = UNBOX(b)[0]; for (V i = 1; i <= m && i <= n; i++) { V c = deus_icmp(UNBOX(a)[i], UNBOX(b)[i], bad); if (c) return c; } return (m > n) - (m < n); }") (app (con "#List" 1 2) (text "    if (ka >= K_TABLE || kb >= K_TABLE || (pa && UNBOX(a)[0] > 4096) || (pb && UNBOX(b)[0] > 4096) || a == DEUS_K || b == DEUS_K) { *bad = 1; return 0; }") (app (con "#List" 1 2) (text "    V ta = deus_tag_any(a), tb = deus_tag_any(b);") (app (con "#List" 1 2) (text "    if (ta != tb) return ta < tb ? -1 : 1;") (app (con "#List" 1 2) (text "    V n = ka < kb ? ka : kb;") (app (con "#List" 1 2) (text "    if (n == 0) return (ka > kb) - (ka < kb);") (app (con "#List" 1 2) (text "    for (V i = 1; i < n; i++) { V c = deus_icmp(UNBOX(a)[i], UNBOX(b)[i], bad); if (c || *bad) return c; }") (app (con "#List" 1 2) (text "    a = UNBOX(a)[n]; b = UNBOX(b)[n];") (app (con "#List" 1 2) (text "  }") (app (con "#List" 1 2) (text "}") (app (con "#List" 1 2) (text "") (app (con "#List" 1 2) (text "static int deus_ikey(V k) { return !IS_PTR(k) || (HDR(k) & 255) == K_TEXT; }") (con "#List" 0 0))))))))))))))))))))))))))))))))))))))))) (app (con "#List" 1 2) (app (con "#List" 1 2) (text "static V deus_iload(V source);") (app (con "#List" 1 2) (text "static V deus_irun(V hash);") (app (con "#List" 1 2) (text "/* The tag of a data value: a Bool's is itself, a nullary constructor's is its static block's index. */") (app (con "#List" 1 2) (text "static V deus_code_tag(V v) { if (IS_PTR(v)) return UNBOX(v)[0]; if ((uintptr_t)v - (uintptr_t)deus_nullary < sizeof deus_nullary) return (V)((V *)(uintptr_t)v - deus_nullary); return v; }") (app (con "#List" 1 2) (text "") (app (con "#List" 1 2) (text "static V deus_iprim(V id, V *a) {") (app (con "#List" 1 2) (text "  switch (id) {") (app (con "#List" 1 2) (text "    case P_ADD: return ADD(a[0], a[1]); case P_SUB: return SUB(a[0], a[1]); case P_MUL: return MUL(a[0], a[1]);") (app (con "#List" 1 2) (text "    case P_DIV: if (a[1] == 0) return deus_idefect_c(\"division by zero\"); return DIV(a[0], a[1]);") (app (con "#List" 1 2) (text "    case P_MOD: if (a[1] == 0) return deus_idefect_c(\"division by zero\"); return MOD(a[0], a[1]);") (app (con "#List" 1 2) (text "    case P_NEG: return SUB(0, a[0]); case P_AND: return a[0] & a[1]; case P_OR: return a[0] | a[1]; case P_XOR: return a[0] ^ a[1];") (app (con "#List" 1 2) (text "    case P_SHL: return SHL(a[0], a[1]); case P_SHR: return SHR(a[0], a[1]); case P_USHR: return USHR(a[0], a[1]);") (app (con "#List" 1 2) (text "    case P_ITEXT: return deus_int_text(a[0]); case P_IFROM: { V r = deus_text_int(a[0]); deus_drop(a[0]); return r; }") (app (con "#List" 1 2) (text "    case P_EQ: case P_NEQ: case P_CMP: case P_LT: case P_LE: case P_GT: case P_GE: {") (app (con "#List" 1 2) (text "      int bad = 0; V c = deus_icmp(a[0], a[1], &bad);") (app (con "#List" 1 2) (text "      if (bad) { if ((id == P_EQ || id == P_NEQ) && a[0] == a[1]) c = 0; else return deus_idefect_c(\"cannot compare functions\"); }") (app (con "#List" 1 2) (text "      deus_drop(a[0]); deus_drop(a[1]); switch (id) { case P_EQ: return c == 0; case P_NEQ: return c != 0; case P_CMP: return c; case P_LT: return c < 0; case P_LE: return c <= 0; case P_GT: return c > 0; default: return c >= 0; }") (app (con "#List" 1 2) (text "    }") (app (con "#List" 1 2) (text "    case P_APPEND: return deus_append_any(a[0], a[1]);") (app (con "#List" 1 2) (text "    case P_IMPLIES: return !a[0] || a[1];") (app (con "#List" 1 2) (text "    case P_TLEN: { V r = TLEN(a[0]); deus_drop(a[0]); return r; } case P_TCODE: { V r = deus_text_code(a[0], a[1]); deus_drop(a[0]); return r; } case P_TSLICE: { V r = deus_text_slice(a[0], a[1], a[2]); deus_drop(a[0]); return r; }") (app (con "#List" 1 2) (text "    case P_TFROMCODE: return deus_text_from_code(a[0]); case P_TCONCAT: { V r = deus_text_concat(a[0]); deus_drop(a[0]); return r; } case P_TJOIN: { V r = deus_text_join(a[0], a[1]); deus_drop(a[0]); deus_drop(a[1]); return r; }") (app (con "#List" 1 2) (text "    case P_TSPLIT: { V r = deus_text_split(a[0], a[1]); deus_drop(a[0]); deus_drop(a[1]); return r; } case P_TINDEX: { V r = deus_text_index(a[0], a[1], a[2]); deus_drop(a[0]); deus_drop(a[1]); return r; } case P_TTRIM: { V r = deus_text_trim(a[0]); deus_drop(a[0]); return r; }") (app (con "#List" 1 2) (text "    case P_TSHA: { V r = deus_text_sha256(a[0]); deus_drop(a[0]); return r; }") (app (con "#List" 1 2) (text "    case P_TFROMCODES: { for (V c = a[0]; UNBOX(c)[0]; c = UNBOX(c)[2]) { V v = UNBOX(c)[1]; if (v < 0 || v > 0x10ffff) { char m[64]; snprintf(m, sizeof m, \"Text.fromCodes: %d is not a code point\", (int)v); return deus_idefect_c(m); } } V r = deus_text_from_codes(a[0]); deus_drop(a[0]); return r; }") (app (con "#List" 1 2) (text "    case P_TUTF8: { V r = deus_text_utf8(a[0]); deus_drop(a[0]); return r; }") (app (con "#List" 1 2) (text "    case P_RNEW: { V *r = deus_block(K_REF, 1); r[0] = a[0]; return BOX(r); }") (app (con "#List" 1 2) (text "    case P_RGET: { V r = deus_dup(UNBOX(a[0])[0]); deus_drop(a[0]); return r; } case P_RSET: { V old = UNBOX(a[0])[0]; UNBOX(a[0])[0] = a[1]; deus_drop(old); deus_drop(a[0]); return UNIT; }") (app (con "#List" 1 2) (text "    case P_AMAKE: if (a[0] < 0) { char m[64]; snprintf(m, sizeof m, \"Array.make: negative length %d\", (int)a[0]); return deus_idefect_c(m); } return deus_array(a[0], a[1]);") (app (con "#List" 1 2) (text "    case P_ALEN: { V r = UNBOX(a[0])[0]; deus_drop(a[0]); return r; }") (app (con "#List" 1 2) (text "    case P_AGET: case P_ASET: {") (app (con "#List" 1 2) (text "      V n = UNBOX(a[0])[0];") (app (con "#List" 1 2) (text "      if (a[1] < 0 || a[1] >= n) { char m[96]; snprintf(m, sizeof m, \"%s: index %d out of bounds 0 .. %d\", id == P_AGET ? \"Array.get\" : \"Array.set\", (int)a[1], (int)n); return deus_idefect_c(m); }") (app (con "#List" 1 2) (text "      if (id == P_AGET) { V r = deus_dup(UNBOX(a[0])[a[1] + 1]); deus_drop(a[0]); return r; }") (app (con "#List" 1 2) (text "      V r = deus_array_unique(a[0]); V old = UNBOX(r)[a[1] + 1]; UNBOX(r)[a[1] + 1] = a[2]; deus_drop(old); return r;") (app (con "#List" 1 2) (text "    }") (app (con "#List" 1 2) (text "    case P_DFROM: for (V c = a[0]; UNBOX(c)[0]; c = UNBOX(c)[2]) if (!deus_ikey(UNBOX(UNBOX(c)[1])[1])) return deus_idefect_show(\"hash map keys are Text or Int, got \", UNBOX(UNBOX(c)[1])[1]); { V r = deus_dict_from_list(a[0]); deus_drop(a[0]); return r; }") (con "#List" 0 0)))))))))))))))))))))))))))))))))))))) (app (con "#List" 1 2) (app (con "#List" 1 2) (text "    case P_DLOOKUP: if (!deus_ikey(a[0])) return deus_idefect_show(\"hash map keys are Text or Int, got \", a[0]); { V r = deus_dict_lookup(a[0], a[1]); deus_drop(a[0]); deus_drop(a[1]); return r; }") (app (con "#List" 1 2) (text "    case P_DHAS: if (!deus_ikey(a[0])) return deus_idefect_show(\"hash map keys are Text or Int, got \", a[0]); { V r = deus_dict_contains(a[0], a[1]); deus_drop(a[0]); deus_drop(a[1]); return r; }") (app (con "#List" 1 2) (text "    case P_DSIZE: case P_MSIZE: { V r = deus_table_size(a[0]); deus_drop(a[0]); return r; }") (app (con "#List" 1 2) (text "    case P_DKEYS: case P_MKEYS: { V r = deus_table_keys(a[0]); deus_drop(a[0]); retu