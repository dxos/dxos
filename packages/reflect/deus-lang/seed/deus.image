> ((b) & 31)))") (app (con "#List" 1 2) (text "#define USHR(a, b) W((uint32_t)(a) >> ((b) & 31))") (app (con "#List" 1 2) (text "static inline V DIV(V a, V b) { if (b == 0) __builtin_trap(); return b == -1 ? SUB(0, a) : (V)((int32_t)a / (int32_t)b); }") (app (con "#List" 1 2) (text "static inline V MOD(V a, V b) { if (b == 0) __builtin_trap(); return b == -1 ? 0 : (V)((int32_t)a % (int32_t)b); }") (app (con "#List" 1 2) (text "static V deus_live, deus_peak;") (app (con "#List" 1 2) (text "static V *deus_free_lists[257];") (app (con "#List" 1 2) (text "/* A block's header, the word before it: its count times 256, plus its kind. */") (app (con "#List" 1 2) (text "#define PHDR(p) ((p)[-1])") (app (con "#List" 1 2) (text "#define HDR(v) PHDR(UNBOX(v))") (app (con "#List" 1 2) (text "#define K_REF 254") (app (con "#List" 1 2) (text "#define K_ARRAY 255") (app (con "#List" 1 2) (text "#define UNIQUE(v) (HDR(v) < 512)") (app (con "#List" 1 2) (text "static inline V *deus_block(V kind, V body) { V words = body + 1; V *h; deus_live += words; if (deus_live > deus_peak) deus_peak = deus_live; if (words <= 256 && (h = deus_free_lists[words])) deus_free_lists[words] = (V *)(uintptr_t)h[0]; else h = deus_raw(words); h[0] = 256 | kind; return h + 1; }") (app (con "#List" 1 2) (text "static inline V deus_body(V *p) { V k = PHDR(p) & 255; return k == K_ARRAY ? p[0] + 1 : k == K_REF ? 1 : k + 1; }") (app (con "#List" 1 2) (text "static inline void deus_release(V *p) { V words = deus_body(p) + 1; deus_live -= words; if (words <= 256) { p[-1] = (V)(uintptr_t)deus_free_lists[words]; deus_free_lists[words] = p - 1; } }") (app (con "#List" 1 2) (text "static V *deus_stack, deus_sp, deus_cap;") (app (con "#List" 1 2) (text "static void deus_push(V v) { if (deus_sp == deus_cap) { V cap = deus_cap ? 2 * deus_cap : 1024; V *bigger = deus_raw(cap); for (V i = 0; i < deus_sp; i++) bigger[i] = deus_stack[i]; deus_stack = bigger; deus_cap = cap; } deus_stack[deus_sp++] = v; }") (app (con "#List" 1 2) (text "static void deus_free(V *p) {") (app (con "#List" 1 2) (text "  for (;;) {") (app (con "#List" 1 2) (text "    V k = PHDR(p) & 255; V *from = k == K_REF ? p : p + 1; V n = k == K_ARRAY ? p[0] : k == K_REF ? 1 : k;") (app (con "#List" 1 2) (text "    for (V i = 0; i < n; i++) { V c = from[i]; if (IS_PTR(c)) { if (!UNIQUE(c)) HDR(c) -= 256; else deus_push(c); } }") (app (con "#List" 1 2) (text "    deus_release(p);") (app (con "#List" 1 2) (text "    if (deus_sp == 0) return;") (app (con "#List" 1 2) (text "    p = UNBOX(deus_stack[--deus_sp]);") (app (con "#List" 1 2) (text "  }") (app (con "#List" 1 2) (text "}") (app (con "#List" 1 2) (text "static inline V deus_dup(V v) { if (IS_PTR(v)) HDR(v) += 256; return v; }") (app (con "#List" 1 2) (text "static inline void deus_drop(V v) { if (IS_PTR(v)) { if (!UNIQUE(v)) HDR(v) -= 256; else deus_free(UNBOX(v)); } }") (app (con "#List" 1 2) (text "/* A constructor block, in the memory of a dead block of the same size when there is one. */") (app (con "#List" 1 2) (text "static inline V *deus_con(V *token, V fields) { if (token) { token[-1] = 256 | fields; return token; } return deus_block(fields, fields + 1); }") (app (con "#List" 1 2) (text "static inline void deus_unused(V *token) { if (token) deus_release(token); }") (app (con "#List" 1 2) (text "static V deus_array(V n, V x) { if (n < 0) __builtin_trap(); V *p = deus_block(K_ARRAY, n + 1); p[0] = n; if (n == 0) deus_drop(x); else if (IS_PTR(x)) HDR(x) += 256 * (n - 1); for (V i = 1; i <= n; i++) p[i] = x; return BOX(p); }") (app (con "#List" 1 2) (text "#define AT(a, i) ({ V *a_ = UNBOX(a); V i_ = (i); if ((uint32_t)i_ >= (uint32_t)a_[0]) __builtin_trap(); &a_[i_ + 1]; })") (app (con "#List" 1 2) (app (prim "append") (app (prim "append") (app (prim "append") (app (prim "append") (text "static V deus_nullary[") (app (ref "ec6b009651baeb055ac9a9943e35a15b6d30f7f6c9991b4df50e7377efc3569a") (app (ref "42ba69c5dd889ac41613460f91ef85f673a3ee56ec8caaff48e39720573ed