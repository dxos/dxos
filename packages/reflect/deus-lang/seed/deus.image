 { (void)unused; V r = UNIT; for (int i = deus_argc; i-- > 1;) r = deus_cons(deus_text_cs(deus_argv[i]), r); return r; }") (app (con "#List" 1 2) (text "static V deus_io_exit(V code) { fflush(stdout); exit((int)code); }") (app (con "#List" 1 2) (text "/* A defect no handler takes ends the run as `deus run` does, with status 70. */") (app (con "#List" 1 2) (text "static V deus_defect(V message) { fflush(stdout); fputs(\"defect: \", stderr); deus_io_put(stderr, message); fputs(\"\\n\", stderr); exit(70); }") (app (con "#List" 1 2) (text "static V deus_io_time(V unused) { (void)unused; struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); int64_t ms = (int64_t)(t.tv_sec - deus_start.tv_sec) * 1000 + (t.tv_nsec - deus_start.tv_nsec) / 1000000; return W((uint32_t)ms); }") (app (con "#List" 1 2) (text "static V deus_io_readStdin(V unused) { (void)unused; size_t n; uint8_t *b = deus_slurp(0, &n); if (!b) return deus_text(0); V r = deus_text_utf8_of(b, n); free(b); return r; }") (app (con "#List" 1 2) (text "static V deus_io_writeBytes(V path, V bytes) { char *p = deus_cstr(path); deus_mkparent(p); FILE *f = fopen(p, \"wb\"); free(p); if (!f) __builtin_trap(); for (V c = bytes; UNBOX(c)[0]; c = UNBOX(c)[2]) { V b = UNBOX(c)[1]; fputc(IS_PTR(b) ? 0 : (int)(b & 255), f); } fclose(f); return UNIT; }") (app (con "#List" 1 2) (text "static V deus_io_getEnv(V name) { char *p = deus_cstr(name); const char *v = getenv(p); free(p); return v ? deus_some(deus_text_cs(v)) : UNIT; }") (app (con "#List" 1 2) (text "static V deus_io_wallClock(V unused) { (void)unused; struct timespec t; clock_gettime(CLOCK_REALTIME, &t); char s[32]; snprintf(s, sizeof s, \"%lld%09ld\", (long long)t.tv_sec, (long)t.tv_nsec); return deus_text_cs(s); }") (app (con "#List" 1 2) (text "/* Runs `prog` with `args`, its stdin empty: (exit code, stdout, stderr), 127 when it cannot start. */") (app (con "#List" 1 2) (text "static V deus_io_exec(V prog, V args) {") (app (con "#List" 1 2) (text "  V n = 0; for (V c 