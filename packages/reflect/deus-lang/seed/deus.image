(def "4ad4be5d7e12762280a51189e59c6fb40821722cf0c6a8b6aa5e16dc8654302f" (app (ref "39916a90fbeb5d8aa0cddf9fd42cf449ccd9d0da82811353177fff735b8efcd5") (text "\n") (app (con "#List" 1 2) (text "usage: deus <command> [args] [--json] [--codebase <dir>]") (app (con "#List" 1 2) (text "") (app (con "#List" 1 2) (text "codebase") (app (con "#List" 1 2) (text "  init [--empty]                       create a codebase with the builtins and prelude (~/.deus, $DEUS_CODEBASE or --codebase)") (app (con "#List" 1 2) (text "  add <files|dirs…>                    add new definitions (.deus, or ```deus fences in .mdl)") (app (con "#List" 1 2) (text "  update <files|dirs…>                 add or replace definitions; dependents are rehashed") (app (con "#List" 1 2) (text "                                       (both take --message <why> for the history, and") (app (con "#List" 1 2) (text "                                       --by <agent> [--prompt <file>] to record provenance)") (app (con "#List" 1 2) (text "  ls [prefix]                          list names") (app (con "#List" 1 2) (text "  find <text>                          names containing text") (app (con "#List" 1 2) (text "  view <name|#hash…> [--core]          print definitions as source (or as Core)") (app (con "#List" 1 2) (text "       [--dialect deus|ts]              … in DEUS (default) or TypeScript-like syntax") (app (con "#List" 1 2) (text "  names <name|#hash>                   every name of a hash") (app (con "#List" 1 2) (text "  deps <name> / dependents <name>      what a definition uses / what uses it") (app (con "#List" 1 2) (text "  mv <from> <to> / alias <name> <new>  rename (with everything under it) / add a name") (app (con "#List" 1 2) (text "  rm <names…>                          remove names") (app (con "#List" 1 2) (text "") (app (con "#List" 1 2) (text "history") (app (con "#List" 1 2) (text "  branch [name]                        list branches, or create one and switch to it") (app (con "#List" 1 2) (text "  switch <branch>                      change branch") (app (con "#List" 1 2) (text "  merge <branch>                       three-way merge into the current branch") (app (con "#List" 1 2) (text "  log [--n N] / undo                   history / step the branch back") (app (con "#List" 1 2) (text "  history import <history.sexp>        keep an export's history under a restored codebase") (app (con "#List" 1 2) (text "  layers                               objects per layer (code, tests, proofs, history, results, …)") (app (con "#List" 1 2) (text "  migrate                              rewrite history with namespace-tree snapshots") (app (con "#List" 1 2) (text "") (app (con "#List" 1 2) (text "projects") (app (con "#List" 1 2) (text "  project [init <iri>]                 the project's IRI, libraries and owned subgraph") (app (con "#List" 1 2) (text "  lib install <name> <codebase>        mount that project's head under lib.<name> (--branch b)") (app (con "#List" 1 2) (text "") (app (con "#List" 1 2) (text "replication") (app (con "#List" 1 2) (text "  remote add <name> <dir|r2://b/p>     a remote: a directory, or an R2 bucket and prefix") (app (con "#List" 1 2) (text "  push [remote] [--branch b]           upload one immutable bundle of what the remote lacks") (app (con "#List" 1 2) (text "  pull [remote]                        import new bundles; <remote>.<branch> tracks its heads") (app (con "#List" 1 2) (text "  compact [remote] [--level k]         sedimentree compaction into level-k strata") (app (con "#List" 1 2) (text "") (app (con "#List" 1 2) (text "running") (app (con "#List" 1 2) (text "  run [--codebase c] <name> [args…]    run name () with IO.args = args (options go before the name)") (app (con "#List" 1 2) (text "  eval <expr>                          evaluate an expression") (app (con "#List" 1 2) (text "  mdl [files|dirs…]                    check .mdl documents (or the codebase's specs): each block runs through the") (app (con "#List" 1 2) (text "                                       @[ext \"<uri>\"] term its Extensions table names") (app (con "#List" 1 2) (text "  test [prefix] [--integration]        run tests in a deterministic simulation (cached by hash);") (app (con "#List" 1 2) (text "                                       --integration also runs @[integration] tests for real") (app (con "#List" 1 2) (text "  check [prefix]                       check theorems and report their evidence") (app (con "#List" 1 2) (text "  image <name> -o <file>               write a kernel image") (app (con "#List" 1 2) (text "  build <name> -o <file> [--native]    write a standalone executable that runs name ()") (app (con "#List" 1 2) (text "                                       (--native: Rust kernel + image, ~1 MB; default: Node SEA)") (app (con "#List" 1 2) (text "  build <actor> -o <dir> --worker      write a Cloudflare Worker serving the actor from a Durable Object") (app (con "#List" 1 2) (text "  build <handler> -o <file> --server   write a standalone native web server for a handler") (app (con "#List" 1 2) (text "  serve <handler> [--port n]           serve a web handler locally (storage in ./deus-data)") (app (con "#List" 1 2) (text "  explore [--out d|--port n|--publish r]  the codebase explorer: write, serve, or host it on a remote") (app (con "#List" 1 2) (text "") (app (con "#List" 1 2) (text "tasks") (app (con "#List" 1 2) (text "  task new <title…> [--priority p --labels a,b --assignee a --parent id --details d --link name]") (app (con "#List" 1 2) (text "  task [list] [--all|--state s|--label l|--about name]   open tasks, most urgent first") (app (con "#List" 1 2) (text "  task show <id>                       a task, what it links (and how that changed since), its history") (app (con "#List" 1 2) (text "  task set <id> --state doing|done|canceled …   change fields (title, state, priority, assignee, labels, parent, details)") (app (con "#List" 1 2) (text "  task comment <id> <text…>            add a comment (--by <agent>)") (app (con "#List" 1 2) (text "  task link <id> <name>|--change <h>   attach a definition or a change; unlink <id> <name> detaches") (app (con "#List" 1 2) (text "  update <files…> --closes <id>        mark a task done, linked to the change that fixed it") (app (con "#List" 1 2) (text "  task import <tasks.sexp>             restore tasks from an export") (app (con "#List" 1 2) (text "  export <dir>                         the codebase as text for git: code/<Namespace>.deus, tasks, history") (app (con "#List" 1 2) (text "  build <fn> -o <file.wasm> --wasm     compile a first-order Int/Bool function (and its callees) to wasm") (app (con "#List" 1 2) (text "  compile <files|dirs…> --main <name>  compile files without a codebase") (app (con "#List" 1 2) (text "") (con "#List" 0 0))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
