{") (app (con "#List" 1 2) (text "          if (!lam && deus_icode(f, deus_ilam)) { lam = (DT *)(uintptr_t)UNBOX(f)[1]; env = (DE *)(uintptr_t)UNBOX(f)[2]; }") (app (con "#List" 1 2) (text "          if (!lam) { if (from == n - 1) return deus_iapply(f, args[from]); f = deus_iapply(f, args[from]); if (f == DEUS_ABORT) return f; continue; }") (app (con "#List" 1 2) (text "          env = deus_ipush(env, args[from]);") (app (con "#List" 1 2) (text "          if (from == n - 1) break;") (app (con "#List" 1 2) (text "          if (lam->a->t == DT_LAM) { lam = lam->a; continue; }") (app (con "#List" 1 2) (text "          f = deus_ieval(lam->a, env); if (f == DEUS_ABORT) return f; lam = 0;") (app (con "#List" 1 2) (text "        }") (app (con "#List" 1 2) (text "        e = env; t = lam->a; continue;") (app (con "#List" 1 2) (text "      }") (app (con "#List" 1 2) (text "      case DT_LET: { V v; EV(v, t->a, e); e = deus_ipush(e, v); t = t->b; continue; }") (app (con "#List" 1 2) (text "      case DT_SEQ: { V v; EV(v, t->a, e); (void)v; t = t->b; continue; }") (app (con "#List" 1 2) (text "      case DT_LETREC: {") (app (con "#List" 1 2) (text "        DE *cells = e; for (V i = 0; i < t->n; i++) cells = deus_ipush(cells, 0);") (app (con "#List" 1 2) (text "        DE *c = cells; for (V i = t->n; i-- > 0; c = c->next) c->v = deus_iclosure(t->xs[i], cells);") (app (con "#List" 1 2) (text "        e = cells; t = t->b; continue;") (app (con "#List" 1 2) (text "      }") (app (con "#List" 1 2) (text "      case DT_IF: { V v; EV(v, t->a, e); t = v ? t->b : t->c; continue; }") (app (con "#List" 1 2) (text "      case DT_MATCH: {") (app (con "#List" 1 2) (text "        V s; EV(s, t->a, e); DE *bound = 0; V i = 0;") (app (con "#List" 1 2) (text "        for (; i < t->n; i++) {") (app (con "#List" 1 2) (text "          int ok = 1; bound = deus_ibind(t->cases[i].p, s, e, &ok);") (app (con "#List" 1 2) (text "          if (!ok) continue;") (app (con "#List" 1 2) (text "          if (t