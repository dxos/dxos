 (app (con "#List" 1 2) (text "    case DP_AS: return deus_ibind(p->inner, v, deus_ipush(e, v), ok);") (app (con "#List" 1 2) (text "    case DP_INT: if (v != p->v) *ok = 0; return e;") (app (con "#List" 1 2) (text "    case DP_TEXT: if (!IS_TEXT(v) || !deus_text_eq(v, p->v)) *ok = 0; return e;") (app (con "#List" 1 2) (text "    case DP_BOOL: if (v != p->tag) *ok = 0; return e;") (app (con "#List" 1 2) (text "    default:") (app (con "#List" 1 2) (text "      if (deus_code_tag(v) != p->tag) { *ok = 0; return e; }") (app (con "#List" 1 2) (text "      for (V i = 0; i < p->n && *ok; i++) e = deus_ibind(p->ps[i], UNBOX(v)[i + 1], e, ok);") (app (con "#List" 1 2) (text "      return e;") (app (con "#List" 1 2) (text "  }") (app (con "#List" 1 2) (text "}") (app (con "#List" 1 2) (text "static DG *deus_iglobal(DT *t) {") (app (con "#List" 1 2) (text "  if (t->g) return t->g;") (app (con "#List" 1 2) (text "  DG *g = deus_global(t->name->u, t->name->n);") (app (con "#List" 1 2) (text "  if (!g) { fflush(stdout); fprintf(stderr, \"deus: panic: unknown definition %s\\n\", deus_ds_cstr(t->name)); exit(1); }") (app (con "#List" 1 2) (text "  return t->g = g;") (app (con "#List" 1 2) (text "}") (app (con "#List" 1 2) (text "static V deus_ivalue(DG *g) {") (app (con "#List" 1 2) (text "  if (g->state == 2) return g->value;") (app (con "#List" 1 2) (text "  if (!g->term) g->term = deus_iterm(g->form);") (app (con "#List" 1 2) (text "  if (g->term->t == DT_LAM) { g->value = deus_iclosure(g->term, 0); g->state = 2; return g->value; }") (app (con "#List" 1 2) (text "  if (g->state == 1) { V s = deus_put(deus_text_cap(0, 16), \"definition \"); s = deus_text_extend(s, deus_keep(deus_text_of(g->hash->u, g->hash->n))); s = deus_put(s, \" depends on its own value\"); return deus_idefect(deus_keep(s)); }") (app (con "#List" 1 2) (text "  g->state = 1; V v = deus_ieval(g->term, 0);") (app (con "#List" 1 2) (text "  if (v == DEUS_ABORT) { g->state = 0; return v; }") (app (con "#List" 1 2)