2) (text "static void deus_erelease(DE *e) { while (e && --e->rc == 0) { DE *n = e->next; deus_drop(e->v); e->next = deus_efree; deus_efree = e; e = n; } }") (app (con "#List" 1 2) (text "static void deus_ifree_code(V *p) { deus_erelease((DE *)(uintptr_t)p[2]); }") (app (con "#List" 1 2) (text "static V deus_iclosure(DT *lam, DE *e) { V *p = deus_block(2, 3); p[0] = (V)(uintptr_t)deus_ilam; p[1] = (V)(uintptr_t)lam; p[2] = (V)(uintptr_t)deus_eref(e); return BOX(p); }") (app (con "#List" 1 2) (text "static V deus_ipap_of(DT *callee, DE *e, const V *args, V n) { V *p = deus_block(3 + n, 4 + n); p[0] = (V)(uintptr_t)deus_ipap; p[1] = (V)(uintptr_t)callee; p[2] = (V)(uintptr_t)deus_eref(e); p[3] = n; for (V i = 0; i < n; i++) p[4 + i] = args[i]; return BOX(p); }") (app (con "#List" 1 2) (text "static int deus_icode(V f, deus_code code) { return IS_PTR(f) && (HDR(f) & 255) < K_TABLE && UNBOX(f)[0] == (V)(uintptr_t)code; }") (app (con "#List" 1 2) (text "") (app (con "#List" 1 2) (text "static V deus_ieval(DT *t, DE *e);") (app (con "#List" 1 2) (text "static V deus_itail(DT *t, DE *e);") (app (con "#List" 1 2) (text "static V deus_iapply(V f, V x);") (app (con "#List" 1 2) (text "static V deus_icall(DT *callee, DE *e, V *args);") (app (con "#List" 1 2) (text "static V deus_ishow(V s, V v);") (app (con "#List" 1 2) (text "") (app (con "#List" 1 2) (text "/* Operation `i` of ability index `a`: the innermost handler's clause, else the host for `IO` and `Defect`. */") (app (con "#List" 1 2) (text "static V deus_ihost(V i, V *a);") (app (con "#List" 1 2) (text "#define EV(dst, term, env) do { dst = deus_ieval(term, env); if (dst == DEUS_ABORT) return DEUS_ABORT; } while (0)") (app (con "#List" 1 2) (text "static V deus_iperform_at(V a, const char *name, V i, V *args, V k) {") (app (con "#List" 1 2) (text "  if (deus_handled(a, i)) { V r = deus_clause(a, i); for (V j = 0; j < k && r != DEUS_ABORT; j++) { V g = deus_iapply(r, args[j]); deus_drop(r); r = g; } V d = deus_clause_d