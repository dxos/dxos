#!/bin/sh
#
# Copyright 2026 DXOS.org
#

# Starts the native CLI built for this checkout's seed without starting node, which costs most of a command's time
# (D292); with no native CLI ready, or when one should not run, `deus.mjs` decides as before.
# The checkout's physical path, through any symlink to this script or its folders, is the one deus.mjs indexes.
script="$0"
while [ -L "$script" ]; do
  link=$(readlink "$script")
  case "$link" in /*) script="$link" ;; *) script="$(dirname "$script")/$link" ;; esac
done
here=$(cd "$(dirname "$script")/.." && pwd -P)
seed="$here/seed/deus.image"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/deus/native"
if [ -z "$DEUS_SEED" ] && [ -z "$CI" ] && [ "$DEUS_NATIVE" != 0 ] && [ -f "$seed" ]; then
  index="$cache/seeds/$(printf '%s' "$seed" | tr / %)"
  stamp=$(stat -c '%s %Y' "$seed" 2>/dev/null || stat -f '%z %m' "$seed")
  if [ -f "$index" ]; then
    read -r size mtime hash < "$index"
    if [ "$size $mtime" = "$stamp" ] && [ -x "$cache/$hash/deus" ]; then
      [ -t 1 ] && export DEUS_TTY="${DEUS_TTY:-1}"
      if [ -z "$DEUS_NODE" ] && node=$(command -v node); then export DEUS_NODE="$node"; fi
      DEUS_HOME="${DEUS_HOME:-$here}" DEUS_IMAGE_HASH="${DEUS_IMAGE_HASH:-$hash}" DEUS_KERNEL=native exec "$cache/$hash/deus" "$@"
    fi
  fi
fi
exec node "$here/bin/deus.mjs" "$@"
