{
  "name": "@dxos/deus",
  "version": "0.17.0",
  "description": "Deus — pattern specification language for human-agent collaborative software development. Carries the .mdl grammar, CodeMirror extension, and core dialects.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "info@dxos.org",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./extension": {
      "source": "./src/extension/index.ts",
      "types": "./dist/types/src/extension/index.d.ts",
      "import": "./dist/lib/extension.mjs"
    },
    "./parse": {
      "source": "./src/extension/parse.ts",
      "types": "./dist/types/src/extension/parse.d.ts",
      "import": "./dist/lib/parse.mjs"
    },
    "./review": {
      "source": "./src/review/index.ts",
      "types": "./dist/types/src/review/index.d.ts",
      "import": "./dist/lib/review.mjs"
    },
    "./spec-index": {
      "source": "./src/spec-index/index.ts",
      "types": "./dist/types/src/spec-index/index.d.ts",
      "import": "./dist/lib/spec-index.mjs"
    },
    "./cli": {
      "source": "./src/cli/index.ts",
      "types": "./dist/types/src/cli/index.d.ts",
      "import": "./dist/lib/cli.mjs"
    }
  },
  "bin": {
    "deus": "./bin/deus.ts"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "lang",
    "src"
  ],
  "dependencies": {
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/lint": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@dxos/errors": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@lezer/highlight": "catalog:",
    "@lezer/lr": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@lezer/generator": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
