{
  "name": "@dxos/plugin-messenger",
  "version": "0.12.0",
  "private": true,
  "description": "Cross-space notifications inbox: messages relayed between identities through the HALO inbox",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "tauri": "./src/capabilities/gen/tauri.ts",
        "browser": "./src/capabilities/gen/browser.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "tauri": "./dist/lib/capabilities.tauri.mjs",
      "browser": "./dist/lib/capabilities.browser.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#materializer": {
      "source": "./src/materializer/index.ts",
      "types": "./dist/types/src/materializer/index.d.ts",
      "default": "./dist/lib/materializer.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.ts",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./MessengerCapabilities": {
      "source": "./src/types/MessengerCapabilities.ts",
      "types": "./dist/types/src/types/MessengerCapabilities.d.ts",
      "import": "./dist/lib/MessengerCapabilities.mjs"
    },
    "./MessengerOperation": {
      "source": "./src/types/MessengerOperation.ts",
      "types": "./dist/types/src/types/MessengerOperation.d.ts",
      "import": "./dist/lib/MessengerOperation.mjs"
    },
    "./MessengerPlugin": {
      "source": "./src/MessengerPlugin.ts",
      "types": "./dist/types/src/MessengerPlugin.d.ts",
      "import": "./dist/lib/MessengerPlugin.mjs"
    },
    "./Notifications": {
      "source": "./src/types/Notifications.ts",
      "types": "./dist/types/src/types/Notifications.d.ts",
      "import": "./dist/lib/Notifications.mjs"
    },
    "./package.json": "./package.json",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "MessengerCapabilities": [
        "dist/types/src/types/MessengerCapabilities.d.ts"
      ],
      "MessengerOperation": [
        "dist/types/src/types/MessengerOperation.d.ts"
      ],
      "MessengerPlugin": [
        "dist/types/src/MessengerPlugin.d.ts"
      ],
      "Notifications": [
        "dist/types/src/types/Notifications.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/client": "workspace:*",
    "@dxos/client-protocol": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/graph": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/protocols": "workspace:*",
    "@dxos/react-ui-card": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/react-ui-mosaic": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/util": "workspace:*",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@dxos/async": "workspace:*",
    "@dxos/client-services": "workspace:*",
    "@dxos/echo-client": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
