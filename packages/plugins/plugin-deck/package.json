{
  "name": "@dxos/plugin-deck",
  "version": "0.12.0",
  "description": "DXOS Surface plugin for the main application layout.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#hooks": {
      "source": "./src/hooks/index.ts",
      "types": "./dist/types/src/hooks/index.d.ts",
      "default": "./dist/lib/hooks.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.ts",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./package.json": "./package.json",
    "./hooks": {
      "source": "./src/hooks/index.ts",
      "types": "./dist/types/src/hooks/index.d.ts",
      "import": "./dist/lib/hooks.mjs"
    },
    "./overlays": {
      "source": "./src/containers/Overlays/index.ts",
      "types": "./dist/types/src/containers/Overlays/index.d.ts",
      "import": "./dist/lib/overlays.mjs"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "import": "./dist/lib/testing.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./CompanionViewState": {
      "source": "./src/types/CompanionViewState.ts",
      "types": "./dist/types/src/types/CompanionViewState.d.ts",
      "import": "./dist/lib/CompanionViewState.mjs"
    },
    "./DeckCapabilities": {
      "source": "./src/types/DeckCapabilities.ts",
      "types": "./dist/types/src/types/DeckCapabilities.d.ts",
      "import": "./dist/lib/DeckCapabilities.mjs"
    },
    "./DeckOperation": {
      "source": "./src/types/DeckOperation.ts",
      "types": "./dist/types/src/types/DeckOperation.d.ts",
      "import": "./dist/lib/DeckOperation.mjs"
    },
    "./DeckPlugin": {
      "source": "./src/DeckPlugin.ts",
      "types": "./dist/types/src/DeckPlugin.d.ts",
      "import": "./dist/lib/DeckPlugin.mjs"
    },
    "./DeckRole": {
      "source": "./src/types/DeckRole.ts",
      "types": "./dist/types/src/types/DeckRole.d.ts",
      "import": "./dist/lib/DeckRole.mjs"
    },
    "./DeckSchema": {
      "source": "./src/types/DeckSchema.ts",
      "types": "./dist/types/src/types/DeckSchema.d.ts",
      "import": "./dist/lib/DeckSchema.mjs"
    },
    "./Settings": {
      "source": "./src/types/Settings.ts",
      "types": "./dist/types/src/types/Settings.d.ts",
      "import": "./dist/lib/Settings.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "DeckCapabilities": [
        "dist/types/src/types/DeckCapabilities.d.ts"
      ],
      "DeckOperation": [
        "dist/types/src/types/DeckOperation.d.ts"
      ],
      "DeckRole": [
        "dist/types/src/types/DeckRole.d.ts"
      ],
      "DeckSchema": [
        "dist/types/src/types/DeckSchema.d.ts"
      ],
      "Settings": [
        "dist/types/src/types/Settings.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/async": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/graph": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-attention": "workspace:*",
    "@dxos/plugin-graph": "workspace:*",
    "@dxos/plugin-observability": "workspace:*",
    "@dxos/react-focus": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/react-ui-dnd": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/react-ui-mosaic": "workspace:*",
    "@dxos/react-ui-tabs": "workspace:*",
    "@dxos/ui-types": "workspace:*",
    "@dxos/util": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@radix-ui/react-context": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@tauri-apps/plugin-deep-link": "catalog:",
    "immer": "catalog:"
  },
  "devDependencies": {
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/random": "workspace:*",
    "@dxos/react-hooks": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-editor": "workspace:*",
    "@dxos/react-ui-list": "workspace:*",
    "@dxos/react-ui-syntax-highlighter": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/ui-editor": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
