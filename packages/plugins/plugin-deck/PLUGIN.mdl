scenario T-11a: Card navigation always adds beside the card's plank (add)
  tags: [F-7]
  given: a card navigation dispatches Open({ subject: ['C'], disposition: 'add', pivotId: 'A' })
         (pivotId is the plank the card is rendered within, resolved via Attention.getRootAttendableId)
  when: the deck is solo [A]
  then:
