{
  "name": "@dxos/plugin-blogger",
  "version": "0.12.0",
  "private": true,
  "description": "Author blog posts with agent assistance.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./package.json": "./package.json",
    "./Blog": {
      "source": "./src/types/Blog.ts",
      "types": "./dist/types/src/types/Blog.d.ts",
      "import": "./dist/lib/Blog.mjs"
    },
    "./BloggerCapabilities": {
      "source": "./src/types/BloggerCapabilities.ts",
      "types": "./dist/types/src/types/BloggerCapabilities.d.ts",
      "import": "./dist/lib/BloggerCapabilities.mjs"
    },
    "./BloggerEvents": {
      "source": "./src/types/BloggerEvents.ts",
      "types": "./dist/types/src/types/BloggerEvents.d.ts",
      "import": "./dist/lib/BloggerEvents.mjs"
    },
    "./BloggerPlugin": {
      "source": "./src/BloggerPlugin.ts",
      "types": "./dist/types/src/BloggerPlugin.d.ts",
      "import": "./dist/lib/BloggerPlugin.mjs"
    },
    "./Publisher": {
      "source": "./src/types/Publisher.ts",
      "types": "./dist/types/src/types/Publisher.d.ts",
      "import": "./dist/lib/Publisher.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Blog": [
        "dist/types/src/types/Blog.d.ts"
      ],
      "BloggerCapabilities": [
        "dist/types/src/types/BloggerCapabilities.d.ts"
      ],
      "BloggerEvents": [
        "dist/types/src/types/BloggerEvents.d.ts"
      ],
      "Publisher": [
        "dist/types/src/types/Publisher.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/client": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/graph": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-connector": "workspace:*",
    "@dxos/plugin-graph": "workspace:*",
    "@dxos/plugin-markdown": "workspace:*",
    "@dxos/plugin-review": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/react-ui-masonry": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@dxos/agent-runtime": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-preview": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
