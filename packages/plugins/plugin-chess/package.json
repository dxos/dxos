{
  "name": "@dxos/plugin-chess",
  "version": "0.11.1",
  "description": "Chess for new plugin",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/types/src/testing.d.ts",
      "import": "./dist/lib/testing.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./package.json": "./package.json",
    "./Chess": {
      "source": "./src/types/Chess.ts",
      "types": "./dist/types/src/types/Chess.d.ts",
      "import": "./dist/lib/Chess.mjs"
    },
    "./ChessEvents": {
      "source": "./src/types/ChessEvents.ts",
      "types": "./dist/types/src/types/ChessEvents.d.ts",
      "import": "./dist/lib/ChessEvents.mjs"
    },
    "./ChessOperation": {
      "source": "./src/types/ChessOperation.ts",
      "types": "./dist/types/src/types/ChessOperation.d.ts",
      "import": "./dist/lib/ChessOperation.mjs"
    },
    "./ChessPlugin": {
      "source": "./src/ChessPlugin.ts",
      "types": "./dist/types/src/ChessPlugin.d.ts",
      "import": "./dist/lib/ChessPlugin.mjs"
    },
    "./ChessPositionIndex": {
      "source": "./src/types/ChessPositionIndex.ts",
      "types": "./dist/types/src/types/ChessPositionIndex.d.ts",
      "import": "./dist/lib/ChessPositionIndex.mjs"
    },
    "./PlayerReview": {
      "source": "./src/types/PlayerReview.ts",
      "types": "./dist/types/src/types/PlayerReview.d.ts",
      "import": "./dist/lib/PlayerReview.mjs"
    },
    "./ChessOperationHandlerSet": {
      "source": "./src/operations/ChessOperationHandlerSet.ts",
      "types": "./dist/types/src/operations/ChessOperationHandlerSet.d.ts",
      "import": "./dist/lib/ChessOperationHandlerSet.mjs"
    },
    "./ChessSkill": {
      "source": "./src/skills/ChessSkill.ts",
      "types": "./dist/types/src/skills/ChessSkill.d.ts",
      "import": "./dist/lib/ChessSkill.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Chess": [
        "dist/types/src/types/Chess.d.ts"
      ],
      "ChessEvents": [
        "dist/types/src/types/ChessEvents.d.ts"
      ],
      "ChessOperation": [
        "dist/types/src/types/ChessOperation.d.ts"
      ],
      "ChessPositionIndex": [
        "dist/types/src/types/ChessPositionIndex.d.ts"
      ],
      "PlayerReview": [
        "dist/types/src/types/PlayerReview.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-game": "workspace:*",
    "@dxos/react-ui-audio": "workspace:*",
    "@dxos/react-ui-gameboard": "workspace:*",
    "@dxos/util": "workspace:*",
    "@effect/atom-react": "catalog:",
    "chess.js": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@dxos/agent-runtime": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-mosaic": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
