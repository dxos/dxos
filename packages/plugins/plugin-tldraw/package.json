{
  "name": "@dxos/plugin-tldraw",
  "version": "0.11.1",
  "description": "tldraw canvas renderer for the DXOS Illustrator plugin.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#hooks": {
      "source": "./src/hooks/index.ts",
      "types": "./dist/types/src/hooks/index.d.ts",
      "default": "./dist/lib/hooks.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#model": {
      "source": "./src/model/index.ts",
      "types": "./dist/types/src/model/index.d.ts",
      "default": "./dist/lib/model.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "default": "./dist/lib/testing.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./package.json": "./package.json",
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "import": "./dist/lib/testing.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./Settings": {
      "source": "./src/types/Settings.ts",
      "types": "./dist/types/src/types/Settings.d.ts",
      "import": "./dist/lib/Settings.mjs"
    },
    "./Tldraw": {
      "source": "./src/types/Tldraw.ts",
      "types": "./dist/types/src/types/Tldraw.d.ts",
      "import": "./dist/lib/Tldraw.mjs"
    },
    "./TldrawCapabilities": {
      "source": "./src/types/TldrawCapabilities.ts",
      "types": "./dist/types/src/types/TldrawCapabilities.d.ts",
      "import": "./dist/lib/TldrawCapabilities.mjs"
    },
    "./TldrawEvents": {
      "source": "./src/types/TldrawEvents.ts",
      "types": "./dist/types/src/types/TldrawEvents.d.ts",
      "import": "./dist/lib/TldrawEvents.mjs"
    },
    "./TldrawModel": {
      "source": "./src/model/index.ts",
      "types": "./dist/types/src/model/index.d.ts",
      "import": "./dist/lib/model.mjs"
    },
    "./TldrawPlugin": {
      "source": "./src/TldrawPlugin.ts",
      "types": "./dist/types/src/TldrawPlugin.d.ts",
      "import": "./dist/lib/TldrawPlugin.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Settings": [
        "dist/types/src/types/Settings.d.ts"
      ],
      "Tldraw": [
        "dist/types/src/types/Tldraw.d.ts"
      ],
      "TldrawCapabilities": [
        "dist/types/src/types/TldrawCapabilities.d.ts"
      ],
      "TldrawEvents": [
        "dist/types/src/types/TldrawEvents.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "scripts": {
    "copy:assets": "./scripts/copy_assets.sh"
  },
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-doc": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-graph": "workspace:*",
    "@dxos/plugin-illustrator": "workspace:*",
    "@dxos/react-hooks": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/util": "workspace:*",
    "@tldraw/assets": "catalog:",
    "@tldraw/editor": "catalog:",
    "@tldraw/state": "catalog:",
    "@tldraw/tldraw": "catalog:",
    "@tldraw/tlschema": "catalog:",
    "@tldraw/utils": "catalog:",
    "effect": "catalog:",
    "lodash.defaultsdeep": "catalog:",
    "react-resize-detector": "catalog:"
  },
  "devDependencies": {
    "@dxos/agent-runtime": "workspace:*",
    "@dxos/echo-client": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-mosaic": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@effect/vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tldraw/store": "catalog:",
    "@types/lodash.defaultsdeep": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
