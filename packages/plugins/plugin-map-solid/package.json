{
  "name": "@dxos/plugin-map-solid",
  "version": "0.16.0",
  "description": "Map plugin with solid web components",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": [
    "./src/components/MapSurface/**",
    "./dist/lib/**"
  ],
  "type": "module",
  "imports": {
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/MapPlugin.workerd.mjs",
      "node": "./dist/lib/MapPlugin.node.mjs",
      "default": "./dist/lib/MapPlugin.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "default": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./MapPlugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/MapPlugin.workerd.mjs",
      "node": "./dist/lib/MapPlugin.node.mjs",
      "import": "./dist/lib/MapPlugin.mjs"
    },
    "./MapSolidEvents": {
      "source": "./src/MapSolidEvents.ts",
      "types": "./dist/types/src/MapSolidEvents.d.ts",
      "import": "./dist/lib/ns/MapSolidEvents.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-solid": "workspace:*",
    "@dxos/plugin-map": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/solid-ui-geo": "workspace:*",
    "@dxos/util": "workspace:*",
    "solid-element": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
