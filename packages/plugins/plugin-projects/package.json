{
  "name": "@dxos/plugin-projects",
  "version": "0.11.1",
  "description": "Projects — interactive, long-running processes with instructions, routines, and artifacts",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./package.json": "./package.json",
    "./templates": {
      "source": "./src/templates/index.ts",
      "types": "./dist/types/src/templates/index.d.ts",
      "import": "./dist/lib/templates.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./ProjectCapabilities": {
      "source": "./src/types/ProjectCapabilities.ts",
      "types": "./dist/types/src/types/ProjectCapabilities.d.ts",
      "import": "./dist/lib/ProjectCapabilities.mjs"
    },
    "./ProjectOperation": {
      "source": "./src/types/ProjectOperation.ts",
      "types": "./dist/types/src/types/ProjectOperation.d.ts",
      "import": "./dist/lib/ProjectOperation.mjs"
    },
    "./ProjectsEvents": {
      "source": "./src/types/ProjectsEvents.ts",
      "types": "./dist/types/src/types/ProjectsEvents.d.ts",
      "import": "./dist/lib/ProjectsEvents.mjs"
    },
    "./ProjectsPlugin": {
      "source": "./src/ProjectsPlugin.ts",
      "types": "./dist/types/src/ProjectsPlugin.d.ts",
      "import": "./dist/lib/ProjectsPlugin.mjs"
    },
    "./ProjectOperationHandlerSet": {
      "source": "./src/operations/ProjectOperationHandlerSet.ts",
      "types": "./dist/types/src/operations/ProjectOperationHandlerSet.d.ts",
      "import": "./dist/lib/ProjectOperationHandlerSet.mjs"
    },
    "./ProjectSkill": {
      "source": "./src/skills/project/ProjectSkill.ts",
      "types": "./dist/types/src/skills/project/ProjectSkill.d.ts",
      "import": "./dist/lib/ProjectSkill.mjs"
    },
    "./ProjectMailboxOperation": {
      "source": "./src/types/ProjectMailboxOperation.ts",
      "types": "./dist/types/src/types/ProjectMailboxOperation.d.ts",
      "import": "./dist/lib/ProjectMailboxOperation.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "ProjectCapabilities": [
        "dist/types/src/types/ProjectCapabilities.d.ts"
      ],
      "ProjectMcpOperation": [
        "dist/types/src/types/ProjectMcpOperation.d.ts"
      ],
      "ProjectOperation": [
        "dist/types/src/types/ProjectOperation.d.ts"
      ],
      "ProjectsEvents": [
        "dist/types/src/types/ProjectsEvents.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src"
  ],
  "dependencies": {
    "@codemirror/state": "catalog:",
    "@dxos/ai": "workspace:*",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/assistant-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/extractor-lib": "workspace:*",
    "@dxos/graph": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-assistant": "workspace:*",
    "@dxos/plugin-inbox": "workspace:*",
    "@dxos/plugin-markdown": "workspace:*",
    "@dxos/plugin-routine": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/plugin-tasks": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/react-ui-masonry": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/react-ui-search": "workspace:*",
    "@dxos/react-ui-tabs": "workspace:*",
    "@dxos/react-ui-task": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@dxos/agent-runtime": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/assistant": "workspace:*",
    "@dxos/compute-runtime": "workspace:*",
    "@dxos/echo-client": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-github": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@effect/atom-react": "catalog:",
    "react": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
