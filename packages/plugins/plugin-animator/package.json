{
  "name": "@dxos/plugin-animator",
  "version": "0.16.0",
  "private": true,
  "description": "Animations over objects other plugins own: shots, timelines, declarative scripts and stages.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "tauri": "./src/capabilities/gen/tauri.ts",
        "browser": "./src/capabilities/gen/browser.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "tauri": "./dist/lib/capabilities.tauri.mjs",
      "browser": "./dist/lib/capabilities.browser.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#effects": {
      "source": "./src/effects/index.ts",
      "types": "./dist/types/src/effects/index.d.ts",
      "default": "./dist/lib/effects.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#model": {
      "source": "./src/model/index.ts",
      "types": "./dist/types/src/model/index.d.ts",
      "default": "./dist/lib/model.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./package.json": "./package.json",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "import": "./dist/lib/testing.mjs"
    },
    "./AnimatorPlugin": {
      "source": "./src/AnimatorPlugin.ts",
      "types": "./dist/types/src/AnimatorPlugin.d.ts",
      "import": "./dist/lib/AnimatorPlugin.mjs"
    },
    "./Animation": {
      "source": "./src/types/Animation.ts",
      "types": "./dist/types/src/types/Animation.d.ts",
      "import": "./dist/lib/Animation.mjs"
    },
    "./AnimatorCapabilities": {
      "source": "./src/types/AnimatorCapabilities.ts",
      "types": "./dist/types/src/types/AnimatorCapabilities.d.ts",
      "import": "./dist/lib/AnimatorCapabilities.mjs"
    },
    "./AnimatorEvents": {
      "source": "./src/types/AnimatorEvents.ts",
      "types": "./dist/types/src/types/AnimatorEvents.d.ts",
      "import": "./dist/lib/AnimatorEvents.mjs"
    },
    "./AnimatorOperation": {
      "source": "./src/types/AnimatorOperation.ts",
      "types": "./dist/types/src/types/AnimatorOperation.d.ts",
      "import": "./dist/lib/AnimatorOperation.mjs"
    },
    "./AnimatorOperationHandlerSet": {
      "source": "./src/operations/AnimatorOperationHandlerSet.ts",
      "types": "./dist/types/src/operations/AnimatorOperationHandlerSet.d.ts",
      "import": "./dist/lib/AnimatorOperationHandlerSet.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Animation": [
        "dist/types/src/types/Animation.d.ts"
      ],
      "AnimatorCapabilities": [
        "dist/types/src/types/AnimatorCapabilities.d.ts"
      ],
      "AnimatorEvents": [
        "dist/types/src/types/AnimatorEvents.d.ts"
      ],
      "AnimatorOperation": [
        "dist/types/src/types/AnimatorOperation.d.ts"
      ],
      "testing": [
        "dist/types/src/testing/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src"
  ],
  "dependencies": {
    "@dxos/animation": "workspace:*",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/react-ui-animation": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/util": "workspace:*",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:",
    "esbuild-wasm": "catalog:"
  },
  "devDependencies": {
    "@dxos/agent-runtime": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
