  rect box 0,0 300x176 "Triage agent"
}   # card kind=feed-card icon=robot tone=ink feed=9 marks=5:accent,6:accent feed-label="feed" footer="Agent DO · ProcessObject" body="Delegates tasks; each opens a child feed."
