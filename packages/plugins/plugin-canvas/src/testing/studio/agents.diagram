object space @ 1142,292 {
  ellipse ring 0,0 392x392
}   # component=space-graph seed=7 pitch=26 fill=0.6 extra=0.45 size=24 lit=15,20,28,37,38,63,80,96

object links @ 0,0 {
  arrow email-triage email/box -> triage/box head=triangle   # route=curve-h
  arrow discord-triage discord/box -> triage/box head=triangle   # route=curve-h
  arrow chat-planner chat/box -> planner/box head=triangle   # route=curve-h
  arrow triage-research triage/box -> research/box head=triangle stroke=dashed   # route=curve-h color=accent
  arrow triage-reply triage/box -> reply/box head=triangle stroke=dashed   # route=curve-h color=accent
  arrow planner-calendar planner/box -> calendar/box head=triangle stroke=dashed   # route=curve-h color=accent
  arrow planner-travel planner/box -> travel/box head=triangle stroke=dashed   # route=curve-h color=accent
  arrow research-space research/box -> space/ring stroke=dashed   # route=curve-h color=accent arrow=none tap=28,37
  arrow reply-space reply/box -> space/ring stroke=dashed   # route=curve-h color=accent arrow=none tap=80,15
  arrow calendar-space calendar/box -> space/ring stroke=dashed   # route=curve-h color=accent arrow=none tap=63,96
  arrow travel-space travel/box -> space/ring stroke=dashed   # route=curve-h color=accent arrow=none tap=38,20
