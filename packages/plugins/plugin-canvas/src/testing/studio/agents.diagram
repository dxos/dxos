# Agents: Feeds route work to agents; agents delegate through feeds of their own
# Exported from studio assets/deck (slide "agents"), 1600 × 900 slide units.

object title @ 80,40 {
  text heading 0,0 "Agents"
  text subtitle 0,44 "Feeds route work to agents; agents delegate through feeds of their own"
}

object subagents @ 778,160 {
  rect frame 0,0 336x648 "Sub-agents · child feeds" color=grey stroke=dashed
}
object space-frame @ 1108,258 {
  rect frame 0,0 460x484 color=grey stroke=dashed
}
object l-inbound @ 70,172 {
  text label 0,0 "Inbound feeds"
}   # role=label
object l-space @ 1142,702 {
  text label 0,0 "One space · its graph"
}   # role=label
object l-triggers @ 287,543 {
  text label 0,0 "triggers route each new message"
}   # role=link-label for=email-triage,discord-triage,chat-planner
object footnote @ 70,842 {
  text label 0,0 "Feeds are append-only. A delegation is a block in the parent’s feed that opens a child feed, so every sub-agent’s work is attributable and replayable."
}   # role=note

object email @ 70,204 {
  rect box 0,0 300x138 "Email"
}   # card kind=feed-card icon=envelope feed=9 marks=8:accent footer="plugin-inbox · JMAP"
object discord @ 70,364 {
  rect box 0,0 300x138 "Discord"
}   # card kind=feed-card icon=discord-logo feed=9 marks=8:accent footer="plugin-discord"
