object agents @ 0,0 scale=1 {
  grid slide 0,0 1600x880 cols=4 gap=64 padding=48 {
    grid inbound-body gap=24 {
      grid inbound-col-0 gap=16 autoRows=176 alignContent=center {
        rect email "Email" kind=feed-card feed=9 footer="plugin-inbox · JMAP" icon=envelope
        rect discord "Discord" kind=feed-card feed=9 footer=plugin-discord icon=discord-logo
        rect chat "Chat" kind=feed-card feed=9 footer=plugin-thread icon=chat-circle-dots
      }
    }
    grid agents-body gap=24 {
      grid agents-col-0 gap=16 autoRows=176 alignContent=center {
        rect triage "Triage agent" kind=feed-card body="Delegates tasks; each opens a child feed." feed=9 feedLabel=feed footer="Agent DO · ProcessObject" icon=robot tone=ink
        rect planner "Planner agent" kind=feed-card body="Delegates tasks; each opens a child feed." feed=9 feedLabel=feed footer="Agent DO · ProcessObject" icon=robot tone=ink
      }
    }
    grid subagents-body gap=24 {
      grid subagents-col-0 gap=16 autoRows=176 alignContent=center {
        rect research "Research" kind=feed-card feed=6 feedLabel=task footer="parent: triage agent" icon=magnifying-glass
        rect reply "Draft reply" kind=feed-card feed=6 feedLabel=task footer="parent: triage agent" icon=pencil-simple-line
        rect calendar "Calendar" kind=feed-card feed=6 feedLabel=task footer="parent: planner agent" icon=calendar-blank
        rect travel "Travel" kind=feed-card feed=6 feedLabel=task footer="parent: planner agent" icon=airplane-tilt
      }
    }
    grid space-body gap=24 {
      rect space kind=space-graph extra=0.45 data-fill=0.6 hue=neutral pitch=26 seed=7 size=24
    }
  }
  arrow email-triage email -> triage head=triangle
  arrow discord-triage discord -> triage head=triangle
  arrow chat-planner chat -> planner head=triangle
  arrow triage-research triage -> research head=triangle
  arrow triage-reply triage -> reply head=triangle
  arrow planner-calendar planner -> calendar head=triangle
  arrow planner-travel planner -> travel head=triangle
  arrow research-space research -> space head=triangle
  arrow reply-space reply -> space head=triangle
  arrow calendar-space calendar -> space head=triangle
  arrow travel-space travel -> space head=triangle
}
