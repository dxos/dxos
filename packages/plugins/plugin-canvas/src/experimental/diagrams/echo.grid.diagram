object echo @ 0,0 scale=1 {
  grid slide 0,0 1600x880 cols="1096 344" gap=64 padding=48 {
    grid layers-section rows="224 544" gap=16 {
      grid types-section rows="48 1fr" gap=16 padding=16 border=true {
        rect types-heading "ECHO Core" fill=none border=false align=center valign=middle fontSize=34
        grid types-row cols=3 gap=64 {
          grid types-col-0 gap=16 {
            rect validation "Validation" kind=card footer="every write" icon=shield-check variant="simple"
            rect typescript "TypeScript" kind=card footer="Effect Schema" icon=file-ts variant="simple"
          }
          grid types-col-1 gap=16 {
            rect json-schema "JSON Schema" kind=card footer="agent tools" icon=brackets-angle variant="simple"
            rect uri "URI" kind=card footer="dxn:type:org.dxos/Task" icon=link variant="simple"
          }
          grid types-col-2 gap=16 {
            rect versioning "Versioning" kind=card footer="semver per type" icon=git-branch variant="simple"
            rect migration "Schema migration" kind=card footer="lenses" icon=arrows-clockwise variant="simple"
          }
        }
      }
      grid layers-body cols=3 gap=64 padding=16 border=true {
        grid layers-col-0 gap=16 autoRows=160 {
          rect graph "Graph" kind=card body="Typed objects and relations: a property graph per space." footer="one Automerge doc per object" icon=graph iconTone=accent
          rect crdt "CRDT" kind=card body="Automerge: concurrent edits from people and agents merge deterministically." footer="no locks · no primary" icon=git-merge iconTone=message
          rect pipeline "Pipeline" kind=card body="Triggers on queries, feeds, cron, webhooks and email run functions on each change." footer="EDGE: Scheduler DO · alarms" icon=flow-arrow iconTone=event
        }
        grid layers-col-1 gap=16 autoRows=160 {
          rect feeds "Feeds" kind=card body="Append-only logs: chat, transcripts, agent trajectories." footer="EDGE: FeedSpace DO" icon=queue iconTone=file
          rect sync "Sync" kind=card body="Subduction exchanges compacted history fragments by fingerprint." footer="EDGE: replicator DO" icon=arrows-clockwise iconTone=teal
          rect index "Index" kind=card body="SQLite everywhere: typed queries, full-text search, reverse references." footer="EDGE: Indexer DO · vectors planned" icon=list-magnifying-glass iconTone=sheet
        }
        grid layers-col-2 gap=16 autoRows=160 {
          rect blobs "Blobs" kind=card body="Files and binary content, referenced from objects." footer="EDGE: R2" icon=files iconTone=violet
          rect cache "Cache" kind=card body="A full replica on every device; reads never wait on the network." footer="OPFS · KV fast path" icon=lightning iconTone=lime
          rect memory "Memory" kind=card body="Shared memory for people and agents: branches, provenance, facts and rules." footer="EDGE: Agent DO · BrainObject" icon=brain iconTone=rose
        }
      }
    }
    grid runtime-section rows="48 1fr" gap=16 padding=16 border=true {
      rect runtime-heading "Runtime" fill=none border=false align=center valign=middle fontSize=34
      grid runtime-col-0 gap=16 autoRows=160 alignContent=end {
        rect browser "Browser" kind=card body="Full replica in the tab; works offline." footer="wa-sqlite on OPFS" icon=browser
        rect node-box "Node" kind=card body="Agents, CLIs and servers." footer="native SQLite" icon=terminal-window
        rect worker "Worker" kind=card body="Always-on peer, sync hub and index per space." footer="Workers · DO SQLite" icon=cloud
      }
    }
  }
}
