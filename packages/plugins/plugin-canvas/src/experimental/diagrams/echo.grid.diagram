object echo @ 0,0 scale=1 {
  grid slide 0,0 1600x880 cols=2 gap=64 padding=48 {
    grid layers-section rows="auto 1fr" gap=16 {
      rect types "Types" kind=card chips="shield-check~Validation~every write | file-ts~TypeScript~Effect Schema | brackets-angle~JSON Schema~agent tools | link~URI~dxn:type:org.dxos/Task | git-branch~Versioning~semver per type | arrows-clockwise~Schema migration~lenses" icon=brackets-curly
      grid layers-body cols=3 gap=24 {
        grid layers-col-0 gap=16 {
          rect graph "Graph" kind=card body="Typed objects and relations: a property graph per space." footer="one Automerge doc per object" icon=graph
          rect crdt "CRDT" kind=card body="Automerge: concurrent edits from people and agents merge deterministically." footer="no locks · no primary" icon=git-merge
          rect pipeline "Pipeline" kind=card body="Triggers on queries, feeds, cron, webhooks and email run functions on each change." footer="EDGE: Scheduler DO · alarms" icon=flow-arrow
        }
        grid layers-col-1 gap=16 {
          rect feeds "Feeds" kind=card body="Append-only logs: chat, transcripts, agent trajectories." footer="EDGE: FeedSpace DO" icon=queue
          rect sync "Sync" kind=card body="Subduction exchanges compacted history fragments by fingerprint." footer="EDGE: replicator DO" icon=arrows-clockwise
          rect index "Index" kind=card body="SQLite everywhere: typed queries, full-text search, reverse references. 0.4–1.8 ms at 10k objects." footer="EDGE: Indexer DO · vectors planned" icon=list-magnifying-glass
        }
        grid layers-col-2 gap=16 {
          rect blobs "Blobs" kind=card body="Files and binary content, referenced from objects." footer="EDGE: R2" icon=files
          rect cache "Cache" kind=card body="A full replica on every device; reads never wait on the network." footer="OPFS · KV fast path" icon=lightning
          rect memory "Memory" kind=card body="Shared memory for people and agents: branches, provenance, facts and rules." footer="EDGE: Agent DO · BrainObject" icon=brain
        }
      }
    }
    grid runtime-section rows="48 1fr" gap=16 {
      rect runtime-heading "Runtime" fill=none border=false align=center valign=middle fontSize=34
      grid runtime-body gap=24 {
        grid runtime-col-0 gap=16 {
          rect browser "Browser" kind=card body="Full replica in the tab; works offline." footer="wa-sqlite on OPFS" icon=browser
          rect node-box "Node" kind=card body="Agents, CLIs and servers." footer="native SQLite" icon=terminal-window
          rect worker "Worker" kind=card body="Always-on peer, sync hub and index per space." footer="Workers · DO SQLite" icon=cloud
        }
      }
    }
  }
}
