# The Hyperspace slide as a hierarchy of grids: three columns, each a heading over a body, each body a run of
# what the column holds. Nothing below the outermost frame states a coordinate — every position on screen comes
# from a rule, so adding a service or resizing the slide re-solves rather than needing the deck re-exported.

object hyperspace @ 0,0 {
  grid slide 0,0 1600x880 cols="1fr 2fr 1fr" gap=64 padding=48 {
    grid composer rows="48 1fr" gap=16 {
      rect heading-composer "Composer" fill=none border=false align=center valign=middle fontSize=34
      grid planks gap=24 {
        rect plank-board "Roadmap" kind=plank comp=board package=react-ui-board
        rect plank-sheet "Budget" kind=plank comp=sheet package=react-ui-sheet
        rect plank-thread "Design chat" kind=plank comp=thread package=react-ui-thread
      }
    }
    grid hyperspace rows="48 1fr" gap=16 {
      rect heading-hyperspace "ECHO Hyperspace" fill=none border=false align=center valign=middle fontSize=34
      grid field-row cols="1fr 0" gap=0 {
        grid field-body padding=24 border=true {
          grid field layout=pack packSeed=29 packMin=36 packMax=185 gap=10 {
            rect s0 kind=space-graph border=true seed=29 pitch=24 data-fill=0.55 extra=0.4 size=24 dots=true root=0 depth=5 tones="violet | green | amber | blue"
            rect s1 kind=space-graph border=true seed=30 pitch=24 data-fill=0.55 extra=0.4 size=24 dots=true
            rect s2 kind=space-graph border=true seed=31 pitch=24 data-fill=0.55 extra=0.4 size=24 dots=true
            rect s3 kind=space-graph border=true seed=32 pitch=24 data-fill=0.55 extra=0.4 size=24 dots=true
            rect s4 kind=space-graph border=true seed=33 pitch=24 data-fill=0.55 extra=0.4 size=24 dots=true
            rect s5 kind=space-graph border=true seed=34 pitch=24 data-fill=0.55 extra=0.4 size=24 dots=true
            rect s6 kind=space-graph border=true seed=35 pitch=24 data-fill=0.55 extra=0.4 size=24 dots=true
            rect s7 kind=space-graph border=true seed=36 pitch=24 data-fill=0.55 extra=0.4 size=24 dots=true
            rect s8 kind=space-graph border=true seed=37 pitch=24 data-fill=0.55 extra=0.4 size=24 dots=true
          }
        }
        grid field-ports gap=12 {
          rect port-calendar fill=none border=false
          rect port-email fill=none border=false
          rect port-storage fill=none border=false
          rect port-translation fill=none border=false
          rect port-search fill=none border=false
          rect port-sql fill=none border=false
          rect port-files fill=none border=false
          rect port-commerce fill=none border=false
          rect port-travel fill=none border=false
          rect port-slack fill=none border=false
        }
      }
    }
    grid services rows="48 1fr" gap=16 {
      rect heading-services "EDGE Services" fill=none border=false align=center valign=middle fontSize=34
      grid service-list gap=12 {
        rect calendar "Calendar" kind=card icon=calendar-blank tone=event variant=simple
        rect email "Email" kind=card icon=envelope tone=message variant=simple
        rect storage "Storage" kind=card icon=database tone=file variant=simple
        rect translation "Translation" kind=card icon=translate variant=simple
        rect search "Search" kind=card icon=magnifying-glass variant=simple
        rect sql "SQL" kind=card icon=table variant=simple
        rect files "Files" kind=card icon=folder variant=simple
        rect commerce "Commerce" kind=card icon=shopping-cart variant=simple
        rect travel "Travel" kind=card icon=airplane-tilt tone=trip variant=simple
        rect slack "Slack" kind=card icon=hash variant=simple
      }
    }
  }

  # Each service reaching the field through the side of the column: the ports are a zero-width column on that
  # edge, in the service list's own rhythm, so every line runs level with the card it leaves.
  arrow tap-calendar calendar -> port-calendar path=line head=none stroke=dashed
  arrow tap-email email -> port-email path=line head=none stroke=dashed
  arrow tap-storage storage -> port-storage path=line head=none stroke=dashed
  arrow tap-translation translation -> port-translation path=line head=none stroke=dashed
  arrow tap-search search -> port-search path=line head=none stroke=dashed
  arrow tap-sql sql -> port-sql path=line head=none stroke=dashed
  arrow tap-files files -> port-files path=line head=none stroke=dashed
  arrow tap-commerce commerce -> port-commerce path=line head=none stroke=dashed
  arrow tap-travel travel -> port-travel path=line head=none stroke=dashed
  arrow tap-slack slack -> port-slack path=line head=none stroke=dashed

  arrow bridge-0-5 s0 -> s5 head=none stroke=dashed
  arrow bridge-0-6 s0 -> s6 head=none stroke=dashed
  arrow bridge-1-5 s1 -> s5 head=none stroke=dashed
  arrow bridge-1-4 s1 -> s4 head=none stroke=dashed
  arrow bridge-3-6 s3 -> s6 head=none stroke=dashed
  arrow bridge-3-8 s3 -> s8 head=none stroke=dashed
  arrow bridge-4-8 s4 -> s8 head=none stroke=dashed
  arrow bridge-7-8 s7 -> s8 head=none stroke=dashed

  # The deck's dashed taps: each plank reading out of the field it draws from.
  arrow tap-board plank-board -> s1 path=line head=none stroke=dashed
  arrow tap-sheet plank-sheet -> s2 path=line head=none stroke=dashed
  arrow tap-thread plank-thread -> s3 path=line head=none stroke=dashed
}
