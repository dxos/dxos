diagram kind=grid size=1600x880 cols=2 gap=64 padding=48

group layers rows="auto 1fr" gap=16 {
  node types "Types" kind=card chips="shield-check~Validation~every write | file-ts~TypeScript~Effect Schema | brackets-angle~JSON Schema~agent tools | link~URI~dxn:type:org.dxos/Task | git-branch~Versioning~semver per type | arrows-clockwise~Schema migration~lenses" icon=brackets-curly
  group layers-cols cols=3 gap=24 {
    group layers-col-0 gap=16 {
      node graph "Graph" kind=card body="Typed objects and relations: a property graph per space." footer="one Automerge doc per object" icon=graph
      node crdt "CRDT" kind=card body="Automerge: concurrent edits from people and agents merge deterministically." footer="no locks · no primary" icon=git-merge
      node pipeline "Pipeline" kind=card body="Triggers on queries, feeds, cron, webhooks and email run functions on each change." footer="EDGE: Scheduler DO · alarms" icon=flow-arrow
    }
    group layers-col-1 gap=16 {
      node feeds "Feeds" kind=card body="Append-only logs: chat, transcripts, agent trajectories." footer="EDGE: FeedSpace DO" icon=queue
      node sync "Sync" kind=card body="Subduction exchanges compacted history fragments by fingerprint." footer="EDGE: replicator DO" icon=arrows-clockwise
      node index "Index" kind=card body="SQLite everywhere: typed queries, full-text search, reverse references. 0.4–1.8 ms at 10k objects." footer="EDGE: Indexer DO · vectors planned" icon=list-magnifying-glass
    }
    group layers-col-2 gap=16 {
      node blobs "Blobs" kind=card body="Files and binary content, referenced from objects." footer="EDGE: R2" icon=files
      node cache "Cache" kind=card body="A full replica on every device; reads never wait on the network." footer="OPFS · KV fast path" icon=lightning
      node memory "Memory" kind=card body="Shared memory for people and agents: branches, provenance, facts and rules." footer="EDGE: Agent DO · BrainObject" icon=brain
    }
  }
}

group runtime "Runtime" gap=16 {
  node browser "Browser" kind=card body="Full replica in the tab; works offline." footer="wa-sqlite on OPFS" icon=browser
  node node-box "Node" kind=card body="Agents, CLIs and servers." footer="native SQLite" icon=terminal-window
  node worker "Worker" kind=card body="Always-on peer, sync hub and index per space." footer="Workers · DO SQLite" icon=cloud
}
