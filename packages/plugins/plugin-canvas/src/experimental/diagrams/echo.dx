diagram kind=grid size=1600x880 cols="1088 352" gap=64 padding=48

group layers-section rows="256 512" gap=16 {
  group types-section padding=24 border=true {
    group types-section-inner "ECHO Core" cols=3 gap=64 {
      group types-col-0 gap=16 {
        node validation "Validation" kind=card footer="every write" icon=shield-check variant=simple
        node typescript "TypeScript" kind=card footer="Effect Schema" icon=file-ts variant=simple
      }
      group types-col-1 gap=16 {
        node json-schema "JSON Schema" kind=card footer="agent tools" icon=brackets-angle variant=simple
        node uri "URI" kind=card footer="dxn:type:org.dxos/Task" icon=link variant=simple
      }
      group types-col-2 gap=16 {
        node versioning "Versioning" kind=card footer="semver per type" icon=git-branch variant=simple
        node migration "Schema migration" kind=card footer=lenses icon=arrows-clockwise variant=simple
      }
    }
  }
  group layers-body cols=3 gap=64 padding=24 border=true {
    group layers-col-0 gap=16 autoRows=144 {
      node graph "Graph" kind=card body="Typed objects and relations: a property graph per space." footer="one Automerge doc per object" icon=graph iconTone=accent
      node crdt "CRDT" kind=card body="Automerge: concurrent edits from people and agents merge deterministically." footer="no locks · no primary" icon=git-merge iconTone=message
      node pipeline "Pipeline" kind=card body="Triggers on queries, feeds, cron, webhooks and email run functions on each change." footer="EDGE: Scheduler DO · alarms" icon=flow-arrow iconTone=event
    }
    group layers-col-1 gap=16 autoRows=144 {
      node feeds "Feeds" kind=card body="Append-only logs: chat, transcripts, agent trajectories." footer="EDGE: FeedSpace DO" icon=queue iconTone=file
      node sync "Sync" kind=card body="Subduction exchanges compacted history fragments by fingerprint." footer="EDGE: replicator DO" icon=arrows-clockwise iconTone=teal
      node index "Index" kind=card body="SQLite everywhere: typed queries, full-text search, reverse references." footer="EDGE: Indexer DO · vectors planned" icon=list-magnifying-glass iconTone=sheet
    }
    group layers-col-2 gap=16 autoRows=144 {
      node blobs "Blobs" kind=card body="Files and binary content, referenced from objects." footer="EDGE: R2" icon=files iconTone=violet
      node cache "Cache" kind=card body="A full replica on every device; reads never wait on the network." footer="OPFS · KV fast path" icon=lightning iconTone=lime
      node memory "Memory" kind=card body="Shared memory for people and agents: branches, provenance, facts and rules." footer="EDGE: Agent DO · BrainObject" icon=brain iconTone=rose
    }
  }
}

group runtime-section padding=24 border=true {
  group runtime-section-inner "Runtime" gap=16 autoRows=144 alignContent=end {
    node browser "Browser" kind=card body="Full replica in the tab; works offline." footer="wa-sqlite on OPFS" icon=browser
    node node-box "Node" kind=card body="Agents, CLIs and servers." footer="native SQLite" icon=terminal-window
    node worker "Worker" kind=card body="Always-on peer, sync hub and index per space." footer="Workers · DO SQLite" icon=cloud
  }
}
