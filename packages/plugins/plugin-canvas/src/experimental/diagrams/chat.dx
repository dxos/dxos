diagram kind=grid size=1600x880 rows="128 320 128" gap=64 padding=48 alignContent=center

group operator-row autoCols=384 justifyContent=center {
  node operator "Operator" kind=card icon=user
}

group agent cols="384 384 384" gap=64 justifyContent=center {
  group agent-col-0 gap=64 autoRows=128 {
    node skill "Skill" kind=card icon=graduation-cap
    node tool "Tool" kind=card icon=wrench
  }
  group agent-col-1 gap=64 autoRows=128 {
    node feed "Feed" kind=card icon=queue
    node session "Session" kind=card icon=play-circle
  }
  group agent-col-2 gap=64 autoRows=128 {
    node model-box "Model" kind=card icon=cpu
  }
}

group artifact-row autoCols=384 justifyContent=center {
  node artifact "Artifact" kind=card icon=cube
}

edge operator -> feed "writes" head=triangle
edge operator -> skill head=triangle
edge operator -> model-box head=triangle
edge session -> feed "writes" head=triangle
edge session -> model-box "run by" head=triangle
edge session -> tool "uses" head=triangle
edge skill -> tool "defines" head=triangle
edge tool -> artifact "makes" head=triangle
