diagram kind=grid size=1600x880 cols=3 gap=64 padding=48

group left gap=16 {
  node navtree "Navtree" kind=card body="The space tree in the sidebar, built from the app graph." footer=plugin-navtree icon=tree-view
  node document "Document" kind=card body="Collaborative markdown; the text lives in ECHO." footer=plugin-markdown icon=file-text
  node sheet "Sheet" kind=card body="A spreadsheet embedded in the document." footer=plugin-sheet icon=grid-four
}

node frame kind=app-frame highlight=true

group right gap=16 {
  node assistant "Assistant" kind=card body="Assistant chat about the object on screen." footer=plugin-assistant icon=sparkle
  node canvas "Canvas" kind=card body="A diagram embedded in the document." footer=plugin-excalidraw icon=pen-nib
}

edge navtree -- frame/r-nav stroke=dashed
edge document -- frame/r-doc stroke=dashed
edge sheet -- frame/r-sheet stroke=dashed
edge assistant -- frame/r-comp stroke=dashed
edge canvas -- frame/r-canvas stroke=dashed
