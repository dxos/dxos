object ontology @ 0,0 scale=1 {
  grid slide 0,0 1600x880 cols="256 928 256" gap=32 padding=48 {
    grid types-section rows="48 1fr" gap=16 {
      rect types-heading "Types" fill=none border=false align=center valign=middle fontSize=34
      grid types-body gap=24 {
        grid types-col-0 gap=16 autoRows=88 alignContent=center {
          rect type-text "Text" kind=card icon=text-t
          rect type-drawing "Drawing" kind=card icon=scribble
          rect type-contact "Contact" kind=card icon=address-book
          rect type-address "Address" kind=card icon=map-pin
          rect type-file "File" kind=card icon=file tone=file
        }
      }
    }
    grid entities-section rows="48 1fr" gap=16 {
      rect entities-heading "Entities" fill=none border=false align=center valign=middle fontSize=34
      grid entities-body cols=3 gap=56 padding=24 border=true {
        grid entities-col-0 gap=16 autoRows=88 alignContent=center {
          rect project "Project" kind=card icon=folder
          rect group-box "Group" kind=card icon=users-three
          rect organization "Organization" kind=card icon=buildings
          rect account "Account" kind=card icon=user-circle
        }
        grid entities-col-1 gap=16 autoRows=88 alignContent=center {
          rect person "Person" kind=card icon=user
        }
        grid entities-col-2 gap=16 autoRows=88 alignContent=center {
          rect task "Task" kind=card icon=check-square
          rect event "Event" kind=card icon=calendar-blank tone=event
          rect message "Message" kind=card icon=chat-text tone=message
          rect transaction "Transaction" kind=card icon=currency-circle-dollar
          rect trip "Trip" kind=card icon=airplane-tilt tone=trip
        }
      }
    }
    grid containers-section rows="48 1fr" gap=16 {
      rect containers-heading "Containers" fill=none border=false align=center valign=middle fontSize=34
      grid containers-body gap=24 {
        grid containers-col-0 gap=16 autoRows=88 alignContent=center {
          rect container-document "Document" kind=card icon=file-text
          rect container-presentation "Presentation" kind=card icon=presentation-chart
          rect container-sheet "Sheet" kind=card icon=grid-four tone=sheet
          rect container-kanban "Kanban" kind=card icon=kanban
          rect container-table "Table" kind=card icon=table
          rect container-transcript "Transcript" kind=card icon=microphone
          rect container-tag "Tag" kind=card icon=tag
        }
      }
    }
  }
  arrow group-box-organization group-box -> organization "part of" head=triangle
  arrow project-group-box project -> group-box "owned by" head=triangle
  arrow person-group-box person -> group-box "member of" head=triangle
  arrow task-project task -> project "in" head=triangle
  arrow task-person task -> person "assignee" head=triangle
  arrow event-person event -> person "attendee" head=triangle
  arrow message-person message -> person "sender" head=triangle
  arrow transaction-person transaction -> person "payee" head=triangle
  arrow transaction-organization transaction -> organization "payer" head=triangle
  arrow person-trip person -> trip "traveller" head=triangle
}
