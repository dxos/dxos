object composer @ 0,0 scale=1 {
  grid slide 0,0 1600x880 cols="1fr 2fr 1fr" gap=64 padding=48 {
    grid left-body gap=24 {
      grid left-col-0 gap=16 autoRows=240 alignContent=center {
        rect navtree "Navtree" kind=card body="The space tree in the sidebar, built from the app graph." footer=plugin-navtree icon=tree-view tone=accent
        rect document "Document" kind=card body="Collaborative markdown; the text lives in ECHO." footer=plugin-markdown icon=file-text tone=message
        rect sheet "Sheet" kind=card body="A spreadsheet embedded in the document." footer=plugin-sheet icon=grid-four tone=sheet
      }
    }
    grid app-body gap=24 {
      rect frame kind=app-frame highlight=true colors="nav~accent | doc~message | sheet~sheet | comp~event | canvas~violet"
    }
    grid right-body gap=24 {
      grid right-col-0 gap=16 autoRows=240 alignContent=center {
        rect assistant "Assistant" kind=card body="Assistant chat about the object on screen." footer=plugin-assistant icon=sparkle tone=event
        rect canvas "Canvas" kind=card body="A diagram embedded in the document." footer=plugin-excalidraw icon=pen-nib tone=violet
      }
    }
  }
  arrow wire-navtree navtree#e3 -> frame#w1 path=ortho head=none stroke=dashed color=light-blue
  arrow wire-document document#e3 -> frame#w3 path=ortho head=none stroke=dashed color=green
  arrow wire-sheet sheet#e3 -> frame#w5 path=ortho head=none stroke=dashed color=orange
  arrow wire-assistant assistant#w3 -> frame#e2 path=ortho head=none stroke=dashed color=light-violet
  arrow wire-canvas canvas#w3 -> frame#e4 path=ortho head=none stroke=dashed color=violet
}
