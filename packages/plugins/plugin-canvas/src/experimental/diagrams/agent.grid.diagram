object agent @ 0,0 scale=1 {
  grid slide 0,0 1600x880 gap=32 padding=48 {
    grid layer-ui-section rows="48 1fr" gap=16 {
      rect layer-ui-heading "UI / Control" fill=none border=false align=center valign=middle fontSize=34
      grid layer-ui-body cols="384 384 384" rows=2 gap=48 justifyContent=center {
        rect goal "Goal" kind=card icon=target
        rect ui-centre-0 fill=none border=false
        rect outcome "Outcome" kind=card icon=trophy
        rect project "Project" kind=card icon=folder
        rect ui-centre-1 fill=none border=false
        rect task "Task" kind=card icon=check-square
      }
    }
    grid layer-activity-section rows="48 1fr" gap=16 {
      rect layer-activity-heading "Activity" fill=none border=false align=center valign=middle fontSize=34
      grid layer-activity-body cols="384 384 384" rows=2 gap=48 justifyContent=center {
        rect feed "Feed" kind=card icon=queue
        rect session "Session" kind=card icon=play-circle
        rect model "Model" kind=card icon=cpu
        rect scheduler "Scheduler" kind=card icon=alarm
        rect tool "Tool" kind=card icon=wrench
        rect plan "Plan" kind=card icon=list-numbers
      }
    }
    grid layer-knowledge-section rows="48 1fr" gap=16 {
      rect layer-knowledge-heading "Knowledge" fill=none border=false align=center valign=middle fontSize=34
      grid layer-knowledge-body cols="384 384 384" rows=2 gap=48 justifyContent=center {
        rect memory "Memory" kind=card icon=brain
        rect graph "Graph" kind=card icon=graph
        rect skill "Skill" kind=card icon=graduation-cap
        rect schema "Schema" kind=card icon=brackets-curly
        rect artifact "Artifact" kind=card icon=cube
        rect spec "Specification" kind=card icon=clipboard-text
      }
    }
  }
  arrow project-goal project -> goal "serves" head=triangle
  arrow outcome-goal outcome -> goal "achieves" head=triangle
  arrow task-project task -> project "in" head=triangle
  arrow task-outcome task -> outcome "produces" head=triangle
  arrow task-spec task -> spec "implements" head=triangle
  arrow plan-spec plan -> spec "follows" head=triangle
  arrow session-task session -> task "works on" head=triangle
  arrow session-model session -> model "run by" head=triangle
  arrow session-tool session -> tool "uses" head=triangle
  arrow session-feed session -> feed "writes" head=triangle
  arrow scheduler-session scheduler -> session "starts" head=triangle
  arrow scheduler-feed scheduler -> feed "watches" head=triangle
  arrow feed-graph feed -> graph "updates" head=triangle
  arrow memory-feed memory -> feed "learns from" head=triangle
  arrow memory-graph memory -> graph "part of" head=triangle
  arrow tool-graph tool -> graph "acts on" head=triangle
  arrow tool-artifact tool -> artifact "makes" head=triangle
  arrow skill-tool skill -> tool "defines" head=triangle
  arrow graph-schema graph -> schema "typed by" head=triangle
  arrow artifact-graph artifact -> graph "stored in" head=triangle
}
