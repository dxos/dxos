diagram kind=grid size=1600x880 cols="256 928 256" gap=32 padding=48

group types "Types" gap=16 autoRows=88 alignContent=center {
  node type-text "Text" kind=card icon=text-t
  node type-drawing "Drawing" kind=card icon=scribble
  node type-contact "Contact" kind=card icon=address-book
  node type-address "Address" kind=card icon=map-pin
  node type-file "File" kind=card icon=file tone=file
}

group entities "Entities" cols=3 gap=56 padding=24 border=true {
  group entities-col-0 gap=16 autoRows=88 alignContent=center {
    node project "Project" kind=card icon=folder
    node group-box "Group" kind=card icon=users-three
    node organization "Organization" kind=card icon=buildings
    node account "Account" kind=card icon=user-circle
  }
  group entities-col-1 gap=16 autoRows=88 alignContent=center {
    node person "Person" kind=card icon=user
  }
  group entities-col-2 gap=16 autoRows=88 alignContent=center {
    node task "Task" kind=card icon=check-square
    node event "Event" kind=card icon=calendar-blank tone=event
    node message "Message" kind=card icon=chat-text tone=message
    node transaction "Transaction" kind=card icon=currency-circle-dollar
    node trip "Trip" kind=card icon=airplane-tilt tone=trip
  }
}

group containers "Containers" gap=16 autoRows=88 alignContent=center {
  node container-document "Document" kind=card icon=file-text
  node container-presentation "Presentation" kind=card icon=presentation-chart
  node container-sheet "Sheet" kind=card icon=grid-four tone=sheet
  node container-kanban "Kanban" kind=card icon=kanban
  node container-table "Table" kind=card icon=table
  node container-transcript "Transcript" kind=card icon=microphone
  node container-tag "Tag" kind=card icon=tag
}

edge group-box -> organization "part of" head=triangle
edge project -> group-box "owned by" head=triangle
edge person -> group-box "member of" head=triangle
edge task -> project "in" head=triangle
edge task -> person "assignee" head=triangle
edge event -> person "attendee" head=triangle
edge message -> person "sender" head=triangle
edge transaction -> person "payee" head=triangle
edge transaction -> organization "payer" head=triangle
edge person -> trip "traveller" head=triangle
