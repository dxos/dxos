object chat @ 0,0 scale=1 {
  grid slide 0,0 1600x880 rows="96 480 96" gap=56 padding=48 autoCols=1152 justifyContent=center alignContent=center {
    grid operator-row autoCols=320 justifyContent=center {
      rect operator "Operator" kind=card icon=user iconTone=accent
    }
    grid agent-box cols=3 rows=3 gap=64 padding=32 border=true {
      rect cell-nw fill=none border=false
      rect feed "Feed" kind=card icon=queue iconTone=file
      rect cell-ne fill=none border=false
      rect cell-w fill=none border=false
      rect session "Session" kind=card icon=play-circle iconTone=message
      rect model-box "Model" kind=card icon=cpu iconTone=teal
      rect skill "Skill" kind=card icon=graduation-cap iconTone=violet
      rect tool "Tool" kind=card icon=wrench iconTone=sheet
      rect cell-se fill=none border=false
    }
    grid artifact-row autoCols=320 justifyContent=center {
      rect artifact "Artifact" kind=card icon=cube iconTone=rose
    }
  }
  arrow operator-feed operator -> feed "writes" head=triangle
  arrow operator-skill operator -> skill head=triangle
  arrow operator-model-box operator -> model-box head=triangle
  arrow session-feed session -> feed "writes" head=triangle
  arrow session-model-box session -> model-box "run by" head=triangle
  arrow session-tool session -> tool "uses" head=triangle
  arrow skill-tool skill -> tool "defines" head=triangle
  arrow tool-artifact tool -> artifact "makes" head=triangle
}
