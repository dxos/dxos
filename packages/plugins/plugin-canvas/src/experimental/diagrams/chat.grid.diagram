object chat @ 0,0 scale=1 {
  grid slide 0,0 1600x880 rows="128 320 128" gap=64 padding=48 alignContent=center {
    grid operator-row autoCols=384 justifyContent=center {
      rect operator "Operator" kind=card icon=user
    }
    grid agent-body cols="384 384 384" gap=64 justifyContent=center {
      grid agent-col-0 gap=64 autoRows=128 {
        rect skill "Skill" kind=card icon=graduation-cap
        rect tool "Tool" kind=card icon=wrench
      }
      grid agent-col-1 gap=64 autoRows=128 {
        rect feed "Feed" kind=card icon=queue
        rect session "Session" kind=card icon=play-circle
      }
      grid agent-col-2 gap=64 autoRows=128 {
        rect model-box "Model" kind=card icon=cpu
      }
    }
    grid artifact-row autoCols=384 justifyContent=center {
      rect artifact "Artifact" kind=card icon=cube
    }
  }
  arrow operator-feed operator -> feed "writes" head=triangle
  arrow operator-skill operator -> skill head=triangle
  arrow operator-model-box operator -> model-box head=triangle
  arrow session-feed session -> feed "writes" head=triangle
  arrow session-model-box session -> model-box "run by" head=triangle
  arrow session-tool session -> tool "uses" head=triangle
  arrow skill-tool skill -> tool "defines" head=triangle
  arrow tool-artifact tool -> artifact "makes" head=triangle
}
