{
  "name": "@dxos/plugin-connector",
  "version": "0.11.1",
  "description": "Composer plugin for managing external service integrations (access tokens + sync targets).",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#commands": {
      "source": {
        "node": "./src/capabilities/commands.ts",
        "default": "./src/capabilities/commands.browser.ts"
      },
      "types": "./dist/types/src/capabilities/commands.d.ts",
      "node": "./dist/lib/commands.mjs",
      "default": "./dist/lib/commands.browser.mjs"
    },
    "#create-panel": {
      "source": {
        "node": "./src/capabilities/create-panel.ts",
        "default": "./src/capabilities/create-panel.browser.ts"
      },
      "types": "./dist/types/src/capabilities/create-panel.d.ts",
      "node": "./dist/lib/create-panel.mjs",
      "default": "./dist/lib/create-panel.browser.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#hooks": {
      "source": "./src/hooks/index.ts",
      "types": "./dist/types/src/hooks/index.d.ts",
      "default": "./dist/lib/hooks.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.ts",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./Binding": {
      "source": "./src/Binding.ts",
      "types": "./dist/types/src/Binding.d.ts",
      "import": "./dist/lib/Binding.mjs"
    },
    "./components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "import": "./dist/lib/components.mjs"
    },
    "./ConnectorsSkill": {
      "source": "./src/skills/ConnectorsSkill.ts",
      "types": "./dist/types/src/skills/ConnectorsSkill.d.ts",
      "import": "./dist/lib/ConnectorsSkill.mjs"
    },
    "./ConnectorAnnotations": {
      "source": "./src/types/ConnectorAnnotations.ts",
      "types": "./dist/types/src/types/ConnectorAnnotations.d.ts",
      "import": "./dist/lib/ConnectorAnnotations.mjs"
    },
    "./ConnectorAuth": {
      "source": "./src/ConnectorAuth.ts",
      "types": "./dist/types/src/ConnectorAuth.d.ts",
      "import": "./dist/lib/ConnectorAuth.mjs"
    },
    "./ConnectorCoordination": {
      "source": "./src/types/ConnectorCoordination.ts",
      "types": "./dist/types/src/types/ConnectorCoordination.d.ts",
      "import": "./dist/lib/ConnectorCoordination.mjs"
    },
    "./ConnectorEvents": {
      "source": "./src/types/ConnectorEvents.ts",
      "types": "./dist/types/src/types/ConnectorEvents.d.ts",
      "import": "./dist/lib/ConnectorEvents.mjs"
    },
    "./ConnectorOperation": {
      "source": "./src/types/ConnectorOperation.ts",
      "types": "./dist/types/src/types/ConnectorOperation.d.ts",
      "import": "./dist/lib/ConnectorOperation.mjs"
    },
    "./ConnectorPlugin": {
      "source": "./src/ConnectorPlugin.ts",
      "types": "./dist/types/src/ConnectorPlugin.d.ts",
      "import": "./dist/lib/ConnectorPlugin.mjs"
    },
    "./ConnectorSpec": {
      "source": "./src/types/ConnectorSpec.ts",
      "types": "./dist/types/src/types/ConnectorSpec.d.ts",
      "import": "./dist/lib/ConnectorSpec.mjs"
    },
    "./package.json": "./package.json",
    "./SyncTemplate": {
      "source": "./src/SyncTemplate.ts",
      "types": "./dist/types/src/SyncTemplate.d.ts",
      "import": "./dist/lib/SyncTemplate.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Connection": [
        "dist/types/src/types/Connection.d.ts"
      ],
      "ConnectorAnnotations": [
        "dist/types/src/types/ConnectorAnnotations.d.ts"
      ],
      "ConnectorCoordination": [
        "dist/types/src/types/ConnectorCoordination.d.ts"
      ],
      "ConnectorEvents": [
        "dist/types/src/types/ConnectorEvents.d.ts"
      ],
      "ConnectorOperation": [
        "dist/types/src/types/ConnectorOperation.d.ts"
      ],
      "ConnectorSpec": [
        "dist/types/src/types/ConnectorSpec.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/cli-util": "workspace:*",
    "@dxos/client": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/context": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/edge-client": "workspace:*",
    "@dxos/edge-compute": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/graph": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/node-std": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-routine": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/protocols": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/react-ui-list": "workspace:*",
    "@dxos/react-ui-search": "workspace:*",
    "@dxos/react-ui-syntax-highlighter": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/util": "workspace:*"
  },
  "devDependencies": {
    "@dxos/echo-client": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/operation": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
