{
  "name": "@dxos/plugin-magazine",
  "version": "0.12.0",
  "description": "Magazine plugin for RSS and open protocol subscriptions.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#atoms": {
      "source": "./src/atoms/index.ts",
      "types": "./dist/types/src/atoms/index.d.ts",
      "default": "./dist/lib/atoms.mjs"
    },
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "default": "./dist/lib/testing.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./package.json": "./package.json",
    "./CreateSubscription": {
      "source": "./src/types/CreateSubscription.ts",
      "types": "./dist/types/src/types/CreateSubscription.d.ts",
      "import": "./dist/lib/CreateSubscription.mjs"
    },
    "./FeedOperation": {
      "source": "./src/types/FeedOperation.ts",
      "types": "./dist/types/src/types/FeedOperation.d.ts",
      "import": "./dist/lib/FeedOperation.mjs"
    },
    "./Magazine": {
      "source": "./src/types/Magazine.ts",
      "types": "./dist/types/src/types/Magazine.d.ts",
      "import": "./dist/lib/Magazine.mjs"
    },
    "./MagazineEvents": {
      "source": "./src/types/MagazineEvents.ts",
      "types": "./dist/types/src/types/MagazineEvents.d.ts",
      "import": "./dist/lib/MagazineEvents.mjs"
    },
    "./MagazinePlugin": {
      "source": "./src/MagazinePlugin.ts",
      "types": "./dist/types/src/MagazinePlugin.d.ts",
      "import": "./dist/lib/MagazinePlugin.mjs"
    },
    "./Subscription": {
      "source": "./src/types/Subscription.ts",
      "types": "./dist/types/src/types/Subscription.d.ts",
      "import": "./dist/lib/Subscription.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "CreateSubscription": [
        "dist/types/src/types/CreateSubscription.d.ts"
      ],
      "FeedOperation": [
        "dist/types/src/types/FeedOperation.d.ts"
      ],
      "Magazine": [
        "dist/types/src/types/Magazine.d.ts"
      ],
      "MagazineEvents": [
        "dist/types/src/types/MagazineEvents.d.ts"
      ],
      "Subscription": [
        "dist/types/src/types/Subscription.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/assistant-toolkit": "workspace:*",
    "@dxos/client": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/markdown": "workspace:*",
    "@dxos/plugin-attention": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-routine": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/react-ui-components": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/react-ui-markdown": "workspace:*",
    "@dxos/react-ui-masonry": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/util": "workspace:*",
    "@effect/atom-react": "catalog:",
    "defuddle": "catalog:",
    "fast-xml-parser": "catalog:"
  },
  "devDependencies": {
    "@dxos/agent-runtime": "workspace:*",
    "@dxos/ai": "workspace:*",
    "@dxos/echo-client": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/random": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-mosaic": "workspace:*",
    "@dxos/react-ui-syntax-highlighter": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "date-fns": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/react-ui-mosaic": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
