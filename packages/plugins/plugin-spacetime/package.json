{
  "name": "@dxos/plugin-spacetime",
  "version": "0.11.1",
  "private": true,
  "description": "3D modeling plugin with Babylon.js and Manifold",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./package.json": "./package.json",
    "./Model": {
      "source": "./src/types/Model.ts",
      "types": "./dist/types/src/types/Model.d.ts",
      "import": "./dist/lib/Model.mjs"
    },
    "./Scene": {
      "source": "./src/types/Scene.ts",
      "types": "./dist/types/src/types/Scene.d.ts",
      "import": "./dist/lib/Scene.mjs"
    },
    "./Settings": {
      "source": "./src/types/Settings.ts",
      "types": "./dist/types/src/types/Settings.d.ts",
      "import": "./dist/lib/Settings.mjs"
    },
    "./SpacetimeCapabilities": {
      "source": "./src/types/SpacetimeCapabilities.ts",
      "types": "./dist/types/src/types/SpacetimeCapabilities.d.ts",
      "import": "./dist/lib/SpacetimeCapabilities.mjs"
    },
    "./SpacetimeEvents": {
      "source": "./src/types/SpacetimeEvents.ts",
      "types": "./dist/types/src/types/SpacetimeEvents.d.ts",
      "import": "./dist/lib/SpacetimeEvents.mjs"
    },
    "./SpacetimePlugin": {
      "source": "./src/SpacetimePlugin.ts",
      "types": "./dist/types/src/SpacetimePlugin.d.ts",
      "import": "./dist/lib/SpacetimePlugin.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Model": [
        "dist/types/src/types/Model.d.ts"
      ],
      "Scene": [
        "dist/types/src/types/Scene.d.ts"
      ],
      "Settings": [
        "dist/types/src/types/Settings.d.ts"
      ],
      "SpacetimeCapabilities": [
        "dist/types/src/types/SpacetimeCapabilities.d.ts"
      ],
      "SpacetimeEvents": [
        "dist/types/src/types/SpacetimeEvents.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "docs/PLUGIN.mdl",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@babylonjs/core": "catalog:",
    "@babylonjs/loaders": "catalog:",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/react-hooks": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/react-ui-pickers": "workspace:*",
    "@dxos/util": "workspace:*",
    "@effect/atom-react": "catalog:",
    "babylonjs-gltf2interface": "catalog:",
    "effect": "catalog:",
    "manifold-3d": "catalog:"
  },
  "devDependencies": {
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
