{
  "name": "@dxos/plugin-native",
  "version": "0.11.1",
  "description": "Composer plugin that runs when on a native device.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./package.json": "./package.json",
    "./NativeCapabilities": {
      "source": "./src/types/NativeCapabilities.ts",
      "types": "./dist/types/src/types/NativeCapabilities.d.ts",
      "import": "./dist/lib/NativeCapabilities.mjs"
    },
    "./NativeEvents": {
      "source": "./src/types/NativeEvents.ts",
      "types": "./dist/types/src/types/NativeEvents.d.ts",
      "import": "./dist/lib/NativeEvents.mjs"
    },
    "./NativePlugin": {
      "source": "./src/NativePlugin.ts",
      "types": "./dist/types/src/NativePlugin.d.ts",
      "import": "./dist/lib/NativePlugin.mjs"
    },
    "./Settings": {
      "source": "./src/types/Settings.ts",
      "types": "./dist/types/src/types/Settings.d.ts",
      "import": "./dist/lib/Settings.mjs"
    },
    "./Update": {
      "source": "./src/types/Update.ts",
      "types": "./dist/types/src/types/Update.d.ts",
      "import": "./dist/lib/Update.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "NativeCapabilities": [
        "dist/types/src/types/NativeCapabilities.d.ts"
      ],
      "NativeEvents": [
        "dist/types/src/types/NativeEvents.d.ts"
      ],
      "Settings": [
        "dist/types/src/types/Settings.d.ts"
      ],
      "Update": [
        "dist/types/src/types/Update.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/ai": "workspace:*",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-assistant": "workspace:*",
    "@dxos/util": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@tauri-apps/api": "catalog:",
    "@tauri-apps/plugin-os": "catalog:",
    "@tauri-apps/plugin-process": "catalog:",
    "@tauri-apps/plugin-shell": "catalog:",
    "@tauri-apps/plugin-updater": "catalog:",
    "date-fns": "catalog:"
  },
  "devDependencies": {
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@types/react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/react-ui-form": "workspace:^",
    "effect": "catalog:",
    "react": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
