diagram kind=grid size=1600x880 cols="1fr 2fr 1fr" gap=64 padding=48

group composer "App" gap=24 {
  node plank-board "Roadmap" kind=plank comp=board package=react-ui-board
  node plank-sheet "Budget" kind=plank comp=sheet package=react-ui-sheet
  node plank-thread "Design chat" kind=plank comp=thread package=react-ui-thread
}

group hyperspace "ECHO Hyperspace" cols="1fr 0" gap=0 {
  group field-body padding=24 border=true {
    group field gap=10 layout=pack packSeed=33 packMin=36 packMax=185 {
      node s0  kind=graph border=true extra=0.4 data-fill=0.5 pitch=24 seed=1 size=24 width=800 root=9 depth=4 tones="violet | green | amber | blue"
      node s1  kind=graph border=true extra=0.4 data-fill=0.5 pitch=24 seed=2 size=24 width=500 root=5 depth=3 tones="violet | green | amber | blue"
      node s2  kind=graph border=true extra=0.4 data-fill=0.5 pitch=24 seed=3 size=24 width=400
      node s3  kind=graph border=true extra=0.4 data-fill=0.5 pitch=24 seed=4 size=24 width=450
      node s4  kind=graph border=true extra=0.4 data-fill=0.5 pitch=24 seed=5 size=24 width=400
      node s5  kind=graph border=true extra=0.4 data-fill=0.5 pitch=24 seed=6 size=24 width=450
      node s6  kind=graph border=true extra=0.4 data-fill=0.5 pitch=24 seed=7 size=24 width=400
      node s7  kind=graph border=true extra=0.4 data-fill=0.5 pitch=24 seed=8 size=24 width=475
      node s8  kind=graph border=true extra=0.4 data-fill=0.5 pitch=24 seed=9 size=24 width=400
      node s9  kind=graph border=true extra=0.4 data-fill=0.5 pitch=24 seed=9 size=24 width=300
      node s10 kind=graph border=true extra=0.4 data-fill=0.5 pitch=24 seed=9 size=24 width=200
      node s11 kind=graph border=true extra=0.4 data-fill=0.5 pitch=24 seed=9 size=24 width=200
    }
  }

  group field-ports gap=12 {
    group port-calendar { }
    group port-email { }
    group port-linear { }
    group port-github { }
    group port-search { }
    group port-discord { }
    group port-files { }
    group port-bluesky { }
    group port-trello { }
    group port-slack { }
  }
}

group services "Services" gap=12 {
  node calendar "Calendar" kind=card icon=calendar-blank tone=event variant=simple
  node email "Email" kind=card icon=envelope tone=message variant=simple
  node linear "Linear" kind=card icon=list-checks tone=file variant=simple
  node github "GitHub" kind=card icon=github-logo variant=simple
  node search "Search" kind=card icon=magnifying-glass variant=simple
  node discord "Discord" kind=card icon=discord-logo variant=simple
  node files "Files" kind=card icon=folder variant=simple
  node bluesky "Bluesky" kind=card icon=butterfly variant=simple
  node trello "Trello" kind=card icon=kanban variant=simple
  node slack "Slack" kind=card icon=hash variant=simple tone=trip 
}

edge calendar     -- port-calendar    path=line stroke=dotted
edge email        -- port-email       path=line stroke=dotted
edge linear     -- port-linear    path=line stroke=dotted
edge github  -- port-github path=line stroke=dotted
edge search       -- port-search      path=line stroke=dotted
edge discord          -- port-discord         path=line stroke=dotted
edge files        -- port-files       path=line stroke=dotted
edge bluesky     -- port-bluesky    path=line stroke=dotted
edge trello       -- port-trello      path=line stroke=dotted
edge slack        -- port-slack       path=line stroke=dotted

edge plank-board  -- s0 path=line stroke=dashed
edge plank-sheet  -- s1 path=line stroke=dashed
edge plank-thread -- s1 path=line stroke=dashed
