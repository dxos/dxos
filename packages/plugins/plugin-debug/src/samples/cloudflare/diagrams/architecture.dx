diagram kind=grid size=1600x880 cols="498 237 767" gap=32 padding=16 autoRows=744 alignContent=center

group client-section cols=2 gap=8 padding=8 border=true {
  group client-col rows=3 gap=16 {
    node client "Client" kind=card icon=browser iconTone=teal {
      item "Composer app tab"
      item "Plugins and surfaces"
    }
    group client-rest { }
  }
  group worker-col rows=3 gap=16 {
    node worker "Worker" kind=card icon=cpu iconTone=teal {
      item "Shared by every tab"
      item "Local replica in SQLite"
    }
    group worker-rest { }
  }
}

group router-section rows="8 1fr 8" {
  group router-above { }
  group router-col rows=3 gap=16 {
    node router "Router" kind=card icon=arrows-left-right iconTone=rose {
      item "Routes clients"
      item "Routes spaces"
    }
    group router-rest { }
  }
  group router-below { }
}

group edge-section cols="237 1fr" gap=32 padding=8 border=true {
  group registry-col rows=3 gap=16 {
    node registry "ServiceRegistry" kind=card icon=plugs-connected iconTone=sheet {
      item "Resolves services by tag"
      item "ECHO, AI, identity, blobs"
    }
    group registry-rest { }
  }
  group services-col gap=16 {
    group echo-block cols=2 gap=8 {
      node echo "ECHO" kind=card icon=database iconTone=accent {
        item "Realtime graph database"
        item "Durable Objects per space"
      }
      group echo-parts gap=16 {
        node graph "Graph" kind=card icon=graph iconTone=accent
        node feeds "Feeds" kind=card icon=queue iconTone=accent
        node blobs "Blobs" kind=card icon=files iconTone=accent
      }
    }
    group compute-block cols=2 gap=8 {
      node compute "Compute" kind=card icon=lightning iconTone=teal {
        item "Runs next to the data"
        item "Workers and bindings"
      }
      group compute-parts gap=16 {
        node scheduler "Scheduler" kind=card icon=clock iconTone=teal
        node agents "Agents" kind=card icon=robot iconTone=teal
        node pipeline "Pipeline" kind=card icon=flow-arrow iconTone=teal
      }
    }
    group plugins-block cols=2 gap=8 {
      node plugins "Plugins" kind=card icon=puzzle-piece iconTone=violet {
        item "Client and EDGE halves"
        item "Loaded per space"
      }
      group plugins-parts gap=16 {
        node calls "Calls" kind=card icon=video-camera iconTone=violet
        node email "Email" kind=card icon=envelope iconTone=violet
        node discord "Discord" kind=card icon=discord-logo iconTone=violet
      }
    }
  }
}

edge client -- worker
edge worker -- router
edge router -- registry
