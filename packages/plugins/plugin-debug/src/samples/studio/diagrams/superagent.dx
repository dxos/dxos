diagram kind=grid size=1600x880 cols=4 gap=64 padding=48

group inbound-body gap=24 {
  group inbound-col-0 gap=16 autoRows=176 alignContent=center {
    node email "Email" kind=feed-card feed=9 footer="plugin-inbox · JMAP" icon=envelope
    node discord "Discord" kind=feed-card feed=9 footer=plugin-discord icon=discord-logo
    node chat "Calendar" kind=feed-card feed=9 footer=plugin-thread icon=chat-circle-dots
  }
}

group agents-body gap=24 {
  group agents-col-0 gap=16 autoRows=176 alignContent=center {
    node triage "Triage agent" kind=feed-card body="Delegates tasks; each opens a child feed." feed=9 feedLabel=feed footer="Agent DO · ProcessObject" icon=robot tone=ink
    node planner "Planner agent" kind=feed-card body="Delegates tasks; each opens a child feed." feed=9 feedLabel=feed footer="Agent DO · ProcessObject" icon=robot tone=ink
  }
}

group subagents-body gap=24 {
  group subagents-col-0 gap=16 autoRows=144 alignContent=center {
    node research "Research" kind=feed-card feed=6 feedLabel=task footer="parent: triage agent" icon=robot
    node reply "Draft reply" kind=feed-card feed=6 feedLabel=task footer="parent: triage agent" icon=robot
    node summary "Summarize" kind=feed-card feed=6 feedLabel=task footer="parent: triage agent" icon=robot
    node calendar "Email" kind=feed-card feed=6 feedLabel=task footer="parent: planner agent" icon=robot
    node travel "Travel" kind=feed-card feed=6 feedLabel=task footer="parent: planner agent" icon=robot
  }
}

group space-body gap=24 {
  group space-col-0 gap=16 autoRows=144 alignContent=center {
    node research-space kind=graph border=true extra=0.45 data-fill=0.6 hue=neutral pitch=22 seed=3 size=24 width=144 height=144
    node reply-space kind=graph border=true extra=0.45 data-fill=0.6 hue=neutral pitch=22 seed=4 size=24 width=144 height=144
    node summary-space kind=graph border=true extra=0.45 data-fill=0.6 hue=neutral pitch=22 seed=7 size=24 width=144 height=144
    node calendar-space kind=graph border=true extra=0.45 data-fill=0.6 hue=neutral pitch=22 seed=5 size=24 width=144 height=144
    node travel-space kind=graph border=true extra=0.45 data-fill=0.6 hue=neutral pitch=22 seed=6 size=24 width=144 height=144
  }
}

edge email#e3    -> triage#w3 head=triangle
edge discord#e3  -> triage#w3 head=triangle
edge chat#e3     -> planner#w3 head=triangle
edge triage#e3   -> research#w3 head=triangle
edge triage#e3   -> reply#w3 head=triangle
edge triage#e3   -> summary#w3 head=triangle
edge planner#e3  -> calendar#w3 head=triangle
edge planner#e3  -> travel#w3 head=triangle
edge research#e3 -> research-space#w2 head=triangle
edge reply#e3    -> reply-space#w2 head=triangle
edge summary#e3  -> summary-space#w2 head=triangle
edge calendar#e3 -> calendar-space#w2 head=triangle
edge travel#e3   -> travel-space#w2 head=triangle
