diagram kind=grid size=1600x880 gap=32 padding=48 autoCols=1504

group layer-ui-section cols="176 1fr" gap=24 {
  node layer-ui-label "Control" kind=heading icon=steering-wheel tone=sheet
  group layer-ui-body cols=3 gap=160 padding=16 border=true {
    group layer-ui-col-0 gap=48 {
      node goal "Goal" kind=card icon=target iconTone=sheet
      node project "Project" kind=card icon=folder iconTone=sheet
    }
    group layer-ui-col-1 gap=48 {
      group ui-centre-0 { }
      group ui-centre-1 { }
    }
    group layer-ui-col-2 gap=48 {
      node outcome "Outcome" kind=card icon=trophy iconTone=sheet
      node task "Task" kind=card icon=check-square iconTone=sheet
    }
  }
}

group layer-activity-section cols="176 1fr" gap=24 {
  node layer-activity-label "Execution" kind=heading icon=lightning tone=accent
  group layer-activity-body cols=3 gap=160 padding=16 border=true {
    group layer-activity-col-0 gap=48 {
      node scheduler "Scheduler" kind=card icon=alarm iconTone=accent
      node feed "Feed" kind=card icon=queue iconTone=accent
    }
    group layer-activity-col-1 gap=48 {
      node session "Session" kind=card icon=play-circle iconTone=accent
      node tool "Tool" kind=card icon=wrench iconTone=accent
    }
    group layer-activity-col-2 gap=48 {
      node model "Model" kind=card icon=cpu iconTone=accent
      node plan "Plan" kind=card icon=list-numbers iconTone=accent
    }
  }
}

group layer-knowledge-section cols="176 1fr" gap=24 {
  node layer-knowledge-label "Knowledge" kind=heading icon=books tone=message
  group layer-knowledge-body cols=3 gap=160 padding=16 border=true {
    group layer-knowledge-col-0 gap=48 {
      node memory "Memory" kind=card icon=brain iconTone=message
      node schema "Schema" kind=card icon=brackets-curly iconTone=message
    }
    group layer-knowledge-col-1 gap=48 {
      node graph "Graph" kind=card icon=graph iconTone=message
      node artifact "Artifact" kind=card icon=cube iconTone=message
    }
    group layer-knowledge-col-2 gap=48 {
      node spec "Specification" kind=card icon=clipboard-text iconTone=message
      node skill "Skill" kind=card icon=graduation-cap iconTone=message
    }
  }
}

edge project -> goal "serves" head=triangle path=ortho
edge outcome -> goal "achieves" head=triangle path=ortho
edge task -> project "in" head=triangle path=ortho
edge task -> outcome "produces" head=triangle path=ortho
edge plan -> spec "follows" head=triangle path=ortho
edge session -> task "works on" head=triangle path=ortho
edge session -> model "run by" head=triangle path=ortho
edge session -> tool "uses" head=triangle path=ortho
edge session -> feed "writes" head=triangle path=ortho
edge scheduler -> session "starts" head=triangle path=ortho
edge scheduler -> feed "watches" head=triangle path=ortho
edge feed -> graph "updates" head=triangle path=ortho
edge memory -> feed "learns from" head=triangle path=ortho
edge memory -> graph "part of" head=triangle path=ortho
edge tool -> graph head=triangle path=ortho
edge skill -> tool "defines" head=triangle path=ortho
edge graph -> schema "typed by" head=triangle path=ortho
edge artifact -> graph "stored in" head=triangle path=ortho
