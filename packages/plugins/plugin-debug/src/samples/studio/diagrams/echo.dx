diagram kind=grid size=1600x880 cols="1096 344" gap=64 padding=48

group layers-section rows="248 520" gap=16 {
  group types-section padding=16 border=true {
    group types-section-inner "ECHO Core" cols=3 gap=24 {
      group types-col-0 gap=16 {
        node typescript "TypeScript" kind=card icon=file-ts {
          item "Effect API"
        }
      }
      group types-col-1 gap=16 {
        node json-schema "JSON Schema" kind=card icon=brackets-angle {
          item "Strong and weak types"
          item "Schema migration"
          item "dxn:type:org.dxos/Task"
        }
      }
    }
  }
  group layers-body cols=3 gap=24 padding=16 border=true {
    group layers-col-0 gap=16 autoRows=152 {
      node graph "Graph" kind=card icon=graph iconTone=accent {
        item "Typed objects and relations"
        item "Globally addressable"
      }
      node crdt "CRDT" kind=card icon=git-merge iconTone=message {
        item "Automerge: concurrent edits from people and agents merge deterministically."
      }
      node pipeline "Pipeline" kind=card icon=flow-arrow iconTone=event {
        item "Triggers on queries, feeds, cron, webhooks and email run functions on each change."
      }
    }
    group layers-col-1 gap=16 autoRows=152 {
      node feeds "Feeds" kind=card icon=queue iconTone=file {
        item "Append-only logs: chat, transcripts, agent trajectories."
      }
      node sync "Sync" kind=card icon=arrows-clockwise iconTone=teal {
        item "Subduction exchanges compacted history fragments by fingerprint."
      }
      node index "Index" kind=card icon=list-magnifying-glass iconTone=sheet {
        item "SQLite everywhere: typed queries, full-text search, reverse references."
      }
    }
    group layers-col-2 gap=16 autoRows=152 {
      node blobs "Blobs" kind=card icon=files iconTone=violet {
        item "Files and binary content, referenced from objects."
      }
      node cache "Cache" kind=card icon=lightning iconTone=lime {
        item "A full replica on every device; reads never wait on the network."
      }
      node memory "Memory" kind=card icon=brain iconTone=rose {
        item "Shared memory for people and agents: branches, provenance, facts and rules."
      }
    }
  }
}

group runtime-section padding=16 border=true {
  group runtime-section-inner "Runtime" gap=16 autoRows=152 alignContent=end {
    node browser "Browser" kind=card body="Full replica in the tab; works offline." footer="wa-sqlite on OPFS" icon=browser
    node node-box "Node" kind=card body="Agents, CLIs and servers." footer="native SQLite" icon=terminal-window
    node worker "Worker" kind=card body="Always-on peer, sync hub and index per space." footer="Workers · DO SQLite" icon=cloud
  }
}
