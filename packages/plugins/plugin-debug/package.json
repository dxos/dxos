    "@dxos/echo-react": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/graph": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/log-store-idb": "workspace:*",
    "@dxos/operation": "workspace:*",
    "@dxos/plugin-attention": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-connector": "workspace:*",
    "@dxos/plugin-google": "workspace:*",
    "@dxos/plugin-illustrator": "workspace:*",
    "@dxos/plugin-inbox": "workspace:*",
    "@dxos/plugin-markdown": "workspace:*",
    "@dxos/plugin-sheet": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/plugin-status-bar": "workspace:*",
    "@dxos/plugin-tldraw": "workspace:*",
    "@dxos/protocols": "workspace:*",
    "@dxos/random": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/react-ui-canvas-compute": "workspace:*",
    "@dxos/react-ui-canvas-editor": "workspace:*",
    "@dxos/react-ui-components": "workspace:*",
    "@dxos/react-ui-debug": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/react-ui-syntax-highlighter": "workspace:*",
    "@dxos/react-ui-tabs": "workspace:*",
    "@dxos/react-ui-terminal": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/tracing": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/ui-editor": "workspace:*",
    "@dxos/ui-types": "workspace:*",
    "@dxos/util": "workspace:*",
    "@effect/atom-react": "catalog:",
    "react-resize-detector": "catalog:"
  },
  "devDependencies": {
    "@dxos/plugin-inbox": "workspace:*",
    "@dxos/plugin-progress": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-list": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/random": "workspace:^",
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
