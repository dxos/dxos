From 0b3c9407f14089d5a0e20f1275e9c0da46208c90 Mon Sep 17 00:00:00 2001
From: Ride Check <ride-check@example.com>
Date: Tue, 27 Oct 2026 06:20:11 +0000
Subject: [PATCH] F-1.4: warn when gusts top 30 km/h

---
 src/app/main.tsx    | 12 ++++++++++++
 src/worker/index.ts |  8 +++++++-
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/src/app/main.tsx b/src/app/main.tsx
index c08ee25..ab16dbe 100644
--- a/src/app/main.tsx
+++ b/src/app/main.tsx
@@ -98,6 +98,18 @@ const VerdictCard = ({ forecast }: { forecast: Forecast }) => {
         <Card.Row icon='ph--wind--regular' trailing={<span className='tabular-nums'>{verdict.wind} km/h</span>}>
           Wind
         </Card.Row>
+        {verdict.gusts !== undefined && (
+          <Card.Row
+            icon='ph--wind--regular'
+            trailing={
+              <Tag.Tag hue={verdict.gusts > 30 ? 'amber' : 'neutral'} data-testid='verdict.gusts'>
+                {verdict.gusts} km/h
+              </Tag.Tag>
+            }
+          >
+            Gusts
+          </Card.Row>
+        )}
         <Card.Row
           icon='ph--thermometer-simple--regular'
           trailing={<span className='tabular-nums'>{verdict.temp}°C</span>}
diff --git a/src/worker/index.ts b/src/worker/index.ts
index 51f5192..39298db 100644
--- a/src/worker/index.ts
+++ b/src/worker/index.ts
@@ -57,6 +57,7 @@ const verdictFor = (hours: Hour[]): Verdict => {
   const rain = Math.max(...next.map((hour) => hour.rain));
   const wind = Math.max(...next.map((hour) => hour.wind));
   const cold = Math.min(...next.map((hour) => hour.temp));
+  const gusts = Math.max(...next.map((hour) => hour.gusts));
   const reasons: string[] = [];
   let level: Verdict['level'] = 'go';
   const worsen = (to: Verdict['level']) => {
@@ -79,6 +80,11 @@ const verdictFor = (hours: Hour[]): Verdict => {
     worsen('maybe');
     reasons.push(`Breezy (${Math.round(wind)} km/h)`);
   }
+  // F-1.4: gusts push a rider sideways long before the average wind does.
+  if (gusts > 30) {
+    worsen('maybe');
+    reasons.push(`Gusts up to ${Math.round(gusts)} km/h`);
+  }
   if (cold < 4) {
     worsen('no-go');
     reasons.push(`Near freezing (${Math.round(cold)}°C)`);
@@ -87,7 +93,7 @@ const verdictFor = (hours: Hour[]): Verdict => {
     reasons.push('Dry, calm and mild for the next three hours');
   }
 
-  return { level, reasons, rain, wind: Math.round(wind), temp: Math.round(cold) };
+  return { level, reasons, rain, wind: Math.round(wind), temp: Math.round(cold), gusts: Math.round(gusts) };
 };
 
 /** F-3: score a block by how wet, windy and cold it is; lower is better. */
-- 
2.43.0

