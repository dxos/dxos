{
  "name": "@dxos/plugin-map",
  "version": "0.12.0",
  "description": "Map plugin",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#testing": {
      "source": "./src/testing.ts",
      "types": "./dist/types/src/testing.d.ts",
      "default": "./dist/lib/testing.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./package.json": "./package.json",
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/types/src/testing.d.ts",
      "import": "./dist/lib/testing.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./Map": {
      "source": "./src/types/Map.ts",
      "types": "./dist/types/src/types/Map.d.ts",
      "import": "./dist/lib/Map.mjs"
    },
    "./MapAction": {
      "source": "./src/types/MapAction.ts",
      "types": "./dist/types/src/types/MapAction.d.ts",
      "import": "./dist/lib/MapAction.mjs"
    },
    "./MapCapabilities": {
      "source": "./src/types/MapCapabilities.ts",
      "types": "./dist/types/src/types/MapCapabilities.d.ts",
      "import": "./dist/lib/MapCapabilities.mjs"
    },
    "./MapEvents": {
      "source": "./src/types/MapEvents.ts",
      "types": "./dist/types/src/types/MapEvents.d.ts",
      "import": "./dist/lib/MapEvents.mjs"
    },
    "./MapOperation": {
      "source": "./src/types/MapOperation.ts",
      "types": "./dist/types/src/types/MapOperation.d.ts",
      "import": "./dist/lib/MapOperation.mjs"
    },
    "./MapPlugin": {
      "source": "./src/MapPlugin.ts",
      "types": "./dist/types/src/MapPlugin.d.ts",
      "import": "./dist/lib/MapPlugin.mjs"
    },
    "./MapRole": {
      "source": "./src/types/MapRole.ts",
      "types": "./dist/types/src/types/MapRole.d.ts",
      "import": "./dist/lib/MapRole.mjs"
    },
    "./MapOperationHandlerSet": {
      "source": "./src/operations/MapOperationHandlerSet.ts",
      "types": "./dist/types/src/operations/MapOperationHandlerSet.d.ts",
      "import": "./dist/lib/MapOperationHandlerSet.mjs"
    },
    "./MapSkill": {
      "source": "./src/skills/MapSkill.ts",
      "types": "./dist/types/src/skills/MapSkill.d.ts",
      "import": "./dist/lib/MapSkill.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Map": [
        "dist/types/src/types/Map.d.ts"
      ],
      "MapAction": [
        "dist/types/src/types/MapAction.d.ts"
      ],
      "MapCapabilities": [
        "dist/types/src/types/MapCapabilities.d.ts"
      ],
      "MapEvents": [
        "dist/types/src/types/MapEvents.d.ts"
      ],
      "MapOperation": [
        "dist/types/src/types/MapOperation.d.ts"
      ],
      "MapRole": [
        "dist/types/src/types/MapRole.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/graph": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/react-ui-geo": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/util": "workspace:*"
  },
  "devDependencies": {
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
