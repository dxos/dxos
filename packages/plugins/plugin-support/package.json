{
  "name": "@dxos/plugin-support",
  "version": "0.11.1",
  "private": true,
  "description": "In-app support assistant plugin for Composer.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#hooks": {
      "source": "./src/hooks/index.ts",
      "types": "./dist/types/src/hooks/index.d.ts",
      "default": "./dist/lib/hooks.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "import": "./dist/lib/components.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./package.json": "./package.json",
    "./HelpCapabilities": {
      "source": "./src/types/HelpCapabilities.ts",
      "types": "./dist/types/src/types/HelpCapabilities.d.ts",
      "import": "./dist/lib/HelpCapabilities.mjs"
    },
    "./HelpOperation": {
      "source": "./src/types/HelpOperation.ts",
      "types": "./dist/types/src/types/HelpOperation.d.ts",
      "import": "./dist/lib/HelpOperation.mjs"
    },
    "./Settings": {
      "source": "./src/types/Settings.ts",
      "types": "./dist/types/src/types/Settings.d.ts",
      "import": "./dist/lib/Settings.mjs"
    },
    "./Support": {
      "source": "./src/types/Support.ts",
      "types": "./dist/types/src/types/Support.d.ts",
      "import": "./dist/lib/Support.mjs"
    },
    "./SupportCapabilities": {
      "source": "./src/types/SupportCapabilities.ts",
      "types": "./dist/types/src/types/SupportCapabilities.d.ts",
      "import": "./dist/lib/SupportCapabilities.mjs"
    },
    "./SupportOperation": {
      "source": "./src/types/SupportOperation.ts",
      "types": "./dist/types/src/types/SupportOperation.d.ts",
      "import": "./dist/lib/SupportOperation.mjs"
    },
    "./SupportPlugin": {
      "source": "./src/SupportPlugin.ts",
      "types": "./dist/types/src/SupportPlugin.d.ts",
      "import": "./dist/lib/SupportPlugin.mjs"
    },
    "./Tour": {
      "source": "./src/types/Tour.ts",
      "types": "./dist/types/src/types/Tour.d.ts",
      "import": "./dist/lib/Tour.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "HelpCapabilities": [
        "dist/types/src/types/HelpCapabilities.d.ts"
      ],
      "HelpOperation": [
        "dist/types/src/types/HelpOperation.d.ts"
      ],
      "Settings": [
        "dist/types/src/types/Settings.d.ts"
      ],
      "Support": [
        "dist/types/src/types/Support.d.ts"
      ],
      "SupportCapabilities": [
        "dist/types/src/types/SupportCapabilities.d.ts"
      ],
      "SupportOperation": [
        "dist/types/src/types/SupportOperation.d.ts"
      ],
      "Tour": [
        "dist/types/src/types/Tour.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/brand": "workspace:*",
    "@dxos/client": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/config": "workspace:*",
    "@dxos/debug": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/graph": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-deck": "workspace:*",
    "@dxos/plugin-observability": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/plugin-status-bar": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-focus": "workspace:*",
    "@dxos/react-hooks": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/react-ui-markdown": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@dxos/util": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@radix-ui/react-context": "catalog:",
    "date-fns": "catalog:",
    "effect": "catalog:",
    "html-to-image": "catalog:",
    "react-floater": "catalog:",
    "react-joyride": "catalog:",
    "type-fest": "catalog:"
  },
  "devDependencies": {
    "@dxos/observability": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/plugin-theme": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
