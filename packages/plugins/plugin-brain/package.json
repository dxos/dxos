{
  "name": "@dxos/plugin-brain",
  "version": "0.12.0",
  "private": true,
  "description": "Assistant skill and operations for querying and summarizing the space fact store",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/neutral/containers/index.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./package.json": "./package.json",
    "./BrainCapabilities": {
      "source": "./src/types/BrainCapabilities.ts",
      "types": "./dist/types/src/types/BrainCapabilities.d.ts",
      "import": "./dist/lib/BrainCapabilities.mjs"
    },
    "./BrainEvents": {
      "source": "./src/types/BrainEvents.ts",
      "types": "./dist/types/src/types/BrainEvents.d.ts",
      "import": "./dist/lib/BrainEvents.mjs"
    },
    "./BrainOperation": {
      "source": "./src/types/BrainOperation.ts",
      "types": "./dist/types/src/types/BrainOperation.d.ts",
      "import": "./dist/lib/BrainOperation.mjs"
    },
    "./BrainPlugin": {
      "source": "./src/BrainPlugin.ts",
      "types": "./dist/types/src/BrainPlugin.d.ts",
      "import": "./dist/lib/BrainPlugin.mjs"
    },
    "./BrainSettings": {
      "source": "./src/types/BrainSettings.ts",
      "types": "./dist/types/src/types/BrainSettings.d.ts",
      "import": "./dist/lib/BrainSettings.mjs"
    },
    "./BrainSurface": {
      "source": "./src/types/BrainSurface.ts",
      "types": "./dist/types/src/types/BrainSurface.d.ts",
      "import": "./dist/lib/BrainSurface.mjs"
    },
    "./BrainOperationHandlerSet": {
      "source": "./src/operations/BrainOperationHandlerSet.ts",
      "types": "./dist/types/src/operations/BrainOperationHandlerSet.d.ts",
      "import": "./dist/lib/BrainOperationHandlerSet.mjs"
    },
    "./BrainSkill": {
      "source": "./src/skills/BrainSkill.ts",
      "types": "./dist/types/src/skills/BrainSkill.d.ts",
      "import": "./dist/lib/BrainSkill.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "BrainCapabilities": [
        "dist/types/src/types/BrainCapabilities.d.ts"
      ],
      "BrainEvents": [
        "dist/types/src/types/BrainEvents.d.ts"
      ],
      "BrainOperation": [
        "dist/types/src/types/BrainOperation.d.ts"
      ],
      "BrainSettings": [
        "dist/types/src/types/BrainSettings.d.ts"
      ],
      "BrainSurface": [
        "dist/types/src/types/BrainSurface.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/ai": "workspace:*",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/pipeline-email": "workspace:*",
    "@dxos/pipeline-rdf": "workspace:*",
    "@dxos/plugin-inbox": "workspace:*",
    "@dxos/plugin-projects": "workspace:*",
    "@dxos/plugin-routine": "workspace:*",
    "@dxos/react-ui-rdf": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/util": "workspace:*",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@dxos/echo-client": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "react": "catalog:"
  }
}
