{
  "name": "@dxos/plugin-transcription",
  "version": "0.11.1",
  "description": "Voice transcription.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#hooks": {
      "source": "./src/hooks/index.ts",
      "types": "./dist/types/src/hooks/index.d.ts",
      "default": "./dist/lib/hooks.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "default": "./dist/lib/testing.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "import": "./dist/lib/components.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./package.json": "./package.json",
    "./Settings": {
      "source": "./src/types/Settings.ts",
      "types": "./dist/types/src/types/Settings.d.ts",
      "import": "./dist/lib/Settings.mjs"
    },
    "./TranscriptOperation": {
      "source": "./src/types/TranscriptOperation.ts",
      "types": "./dist/types/src/types/TranscriptOperation.d.ts",
      "import": "./dist/lib/TranscriptOperation.mjs"
    },
    "./TranscriptionCapabilities": {
      "source": "./src/types/TranscriptionCapabilities.ts",
      "types": "./dist/types/src/types/TranscriptionCapabilities.d.ts",
      "import": "./dist/lib/TranscriptionCapabilities.mjs"
    },
    "./TranscriptionEvents": {
      "source": "./src/types/TranscriptionEvents.ts",
      "types": "./dist/types/src/types/TranscriptionEvents.d.ts",
      "import": "./dist/lib/TranscriptionEvents.mjs"
    },
    "./TranscriptionPlugin": {
      "source": "./src/TranscriptionPlugin.ts",
      "types": "./dist/types/src/TranscriptionPlugin.d.ts",
      "import": "./dist/lib/TranscriptionPlugin.mjs"
    },
    "./TranscriptionOperationHandlerSet": {
      "source": "./src/operations/TranscriptionOperationHandlerSet.ts",
      "types": "./dist/types/src/operations/TranscriptionOperationHandlerSet.d.ts",
      "import": "./dist/lib/TranscriptionOperationHandlerSet.mjs"
    },
    "./TranscriptionSkill": {
      "source": "./src/skills/TranscriptionSkill.ts",
      "types": "./dist/types/src/skills/TranscriptionSkill.d.ts",
      "import": "./dist/lib/TranscriptionSkill.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Settings": [
        "dist/types/src/types/Settings.d.ts"
      ],
      "TranscriptionCapabilities": [
        "dist/types/src/types/TranscriptionCapabilities.d.ts"
      ],
      "TranscriptionEvents": [
        "dist/types/src/types/TranscriptionEvents.d.ts"
      ],
      "TranscriptOperation": [
        "dist/types/src/types/TranscriptOperation.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/ai": "workspace:*",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/assistant": "workspace:*",
    "@dxos/async": "workspace:*",
    "@dxos/client": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/compute-runtime": "workspace:*",
    "@dxos/config": "workspace:*",
    "@dxos/context": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/graph": "workspace:*",
    "@dxos/halo-react": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/pipeline-transcription": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-markdown": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-ui-audio": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/react-ui-transcription": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/ui-editor": "workspace:*",
    "@dxos/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@codemirror/state": "catalog:",
    "@dxos/echo-doc": "workspace:*",
    "@dxos/plugin-preview": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/random": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/react-ui-list": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
