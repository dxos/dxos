{
  "name": "@dxos/plugin-code",
  "version": "0.16.0",
  "description": "Composer plugin for AI-assisted plugin development",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/CodePlugin.workerd.mjs",
      "node": "./dist/lib/CodePlugin.node.mjs",
      "default": "./dist/lib/CodePlugin.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#sync": {
      "source": "./src/sync/index.ts",
      "types": "./dist/types/src/sync/index.d.ts",
      "default": "./dist/lib/sync.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./package.json": "./package.json",
    "./CodeCapabilities": {
      "source": "./src/types/CodeCapabilities.ts",
      "types": "./dist/types/src/types/CodeCapabilities.d.ts",
      "import": "./dist/lib/CodeCapabilities.mjs"
    },
    "./CodeEvents": {
      "source": "./src/types/CodeEvents.ts",
      "types": "./dist/types/src/types/CodeEvents.d.ts",
      "import": "./dist/lib/CodeEvents.mjs"
    },
    "./CodeOperation": {
      "source": "./src/types/CodeOperation.ts",
      "types": "./dist/types/src/types/CodeOperation.d.ts",
      "import": "./dist/lib/CodeOperation.mjs"
    },
    "./CodePlugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/CodePlugin.workerd.mjs",
      "node": "./dist/lib/CodePlugin.node.mjs",
      "import": "./dist/lib/CodePlugin.mjs"
    },
    "./CodeProject": {
      "source": "./src/types/CodeProject.ts",
      "types": "./dist/types/src/types/CodeProject.d.ts",
      "import": "./dist/lib/CodeProject.mjs"
    },
    "./Settings": {
      "source": "./src/types/Settings.ts",
      "types": "./dist/types/src/types/Settings.d.ts",
      "import": "./dist/lib/Settings.mjs"
    },
    "./SourceFile": {
      "source": "./src/types/SourceFile.ts",
      "types": "./dist/types/src/types/SourceFile.d.ts",
      "import": "./dist/lib/SourceFile.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "CodeCapabilities": [
        "dist/types/src/types/CodeCapabilities.d.ts"
      ],
      "CodeEvents": [
        "dist/types/src/types/CodeEvents.d.ts"
      ],
      "CodeOperation": [
        "dist/types/src/types/CodeOperation.d.ts"
      ],
      "CodeProject": [
        "dist/types/src/types/CodeProject.d.ts"
      ],
      "Settings": [
        "dist/types/src/types/Settings.d.ts"
      ],
      "SourceFile": [
        "dist/types/src/types/SourceFile.d.ts"
      ],
      "Spec": [
        "dist/types/src/types/Spec.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@codemirror/lang-javascript": "catalog:",
    "@codemirror/lang-markdown": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/client": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/deus": "workspace:*",
    "@dxos/diagram": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-doc": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/graph": "workspace:*",
    "@dxos/halo-react": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-file-system": "workspace:*",
    "@dxos/plugin-github": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-canvas": "workspace:*",
    "@dxos/react-ui-editor": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/react-ui-mosaic": "workspace:*",
    "@dxos/react-ui-task": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/ui-editor": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@dxos/util": "workspace:*",
    "@typescript/typescript6": "catalog:",
    "@typescript/vfs": "catalog:",
    "effect": "catalog:",
    "esbuild-wasm": "catalog:"
  },
  "devDependencies": {
    "@dxos/echo-client": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@effect/vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
