{
  "name": "@dxos/plugin-sandbox",
  "version": "0.16.0",
  "private": true,
  "description": "DXOS Sandbox plugin for running isolated shell environments",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#local-backend": {
      "source": {
        "node": "./src/local/index.ts",
        "default": "./src/local/unsupported.ts"
      },
      "types": "./dist/types/src/local/index.d.ts",
      "node": "./dist/lib/local-backend.node.mjs",
      "default": "./dist/lib/local-backend.browser.mjs"
    },
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/SandboxPlugin.workerd.mjs",
      "node": "./dist/lib/SandboxPlugin.node.mjs",
      "default": "./dist/lib/SandboxPlugin.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./HttpBackend": {
      "source": "./src/services/HttpBackend.ts",
      "types": "./dist/types/src/services/HttpBackend.d.ts",
      "import": "./dist/lib/HttpBackend.mjs"
    },
    "./package.json": "./package.json",
    "./LegacyRepository": {
      "source": "./src/types/LegacyRepository.ts",
      "types": "./dist/types/src/types/LegacyRepository.d.ts",
      "import": "./dist/lib/LegacyRepository.mjs"
    },
    "./RepositoryOperation": {
      "source": "./src/types/RepositoryOperation.ts",
      "types": "./dist/types/src/types/RepositoryOperation.d.ts",
      "import": "./dist/lib/RepositoryOperation.mjs"
    },
    "./RepositoryService": {
      "source": "./src/types/RepositoryService.ts",
      "types": "./dist/types/src/types/RepositoryService.d.ts",
      "import": "./dist/lib/RepositoryService.mjs"
    },
    "./Sandbox": {
      "source": "./src/types/Sandbox.ts",
      "types": "./dist/types/src/types/Sandbox.d.ts",
      "import": "./dist/lib/Sandbox.mjs"
    },
    "./SandboxCapabilities": {
      "source": "./src/types/SandboxCapabilities.ts",
      "types": "./dist/types/src/types/SandboxCapabilities.d.ts",
      "import": "./dist/lib/SandboxCapabilities.mjs"
    },
    "./SandboxEvents": {
      "source": "./src/types/SandboxEvents.ts",
      "types": "./dist/types/src/types/SandboxEvents.d.ts",
      "import": "./dist/lib/SandboxEvents.mjs"
    },
    "./SandboxOperation": {
      "source": "./src/types/SandboxOperation.ts",
      "types": "./dist/types/src/types/SandboxOperation.d.ts",
      "import": "./dist/lib/SandboxOperation.mjs"
    },
    "./SandboxPlugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/SandboxPlugin.workerd.mjs",
      "node": "./dist/lib/SandboxPlugin.node.mjs",
      "import": "./dist/lib/SandboxPlugin.mjs"
    },
    "./SandboxService": {
      "source": "./src/types/SandboxService.ts",
      "types": "./dist/types/src/types/SandboxService.d.ts",
      "import": "./dist/lib/SandboxService.mjs"
    },
    "./SandboxSkill": {
      "source": "./src/skills/SandboxSkill.ts",
      "types": "./dist/types/src/skills/SandboxSkill.d.ts",
      "import": "./dist/lib/ns/SandboxSkill.mjs"
    },
    "./Settings": {
      "source": "./src/types/Settings.ts",
      "types": "./dist/types/src/types/Settings.d.ts",
      "import": "./dist/lib/Settings.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Sandbox": [
        "dist/types/src/types/Sandbox.d.ts"
      ],
      "SandboxEvents": [
        "dist/types/src/types/SandboxEvents.d.ts"
      ],
      "SandboxOperation": [
        "dist/types/src/types/SandboxOperation.d.ts"
      ],
      "SandboxService": [
        "dist/types/src/types/SandboxService.d.ts"
      ],
      "SandboxCapabilities": [
        "dist/types/src/types/SandboxCapabilities.d.ts"
      ],
      "Settings": [
        "dist/types/src/types/Settings.d.ts"
      ],
      "HttpBackend": [
        "dist/types/src/services/HttpBackend.d.ts"
      ],
      "LegacyRepository": [
        "dist/types/src/types/LegacyRepository.d.ts"
      ],
      "RepositoryOperation": [
        "dist/types/src/types/RepositoryOperation.d.ts"
      ],
      "RepositoryService": [
        "dist/types/src/types/RepositoryService.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@carderne/sandbox-runtime": "catalog:",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/config": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/edge-client": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/halo": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-projects": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-list": "workspace:*",
    "@dxos/react-ui-syntax-highlighter": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@dxos/util": "workspace:*",
    "@tauri-apps/plugin-shell": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@dxos/agent-runtime": "workspace:*",
    "@dxos/echo-client": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@effect/vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
