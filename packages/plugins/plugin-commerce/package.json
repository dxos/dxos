{
  "name": "@dxos/plugin-commerce",
  "version": "0.11.1",
  "private": true,
  "description": "Product search plugin.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "MIT",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    },
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./package.json": "./package.json",
    "./CommerceEvents": {
      "source": "./src/types/CommerceEvents.ts",
      "types": "./dist/types/src/types/CommerceEvents.d.ts",
      "import": "./dist/lib/CommerceEvents.mjs"
    },
    "./CommercePlugin": {
      "source": "./src/CommercePlugin.ts",
      "types": "./dist/types/src/CommercePlugin.d.ts",
      "import": "./dist/lib/CommercePlugin.mjs"
    },
    "./Provider": {
      "source": "./src/types/Provider.ts",
      "types": "./dist/types/src/types/Provider.d.ts",
      "import": "./dist/lib/Provider.mjs"
    },
    "./Result": {
      "source": "./src/types/Result.ts",
      "types": "./dist/types/src/types/Result.d.ts",
      "import": "./dist/lib/Result.mjs"
    },
    "./Search": {
      "source": "./src/types/Search.ts",
      "types": "./dist/types/src/types/Search.d.ts",
      "import": "./dist/lib/Search.mjs"
    },
    "./SearchOperation": {
      "source": "./src/types/SearchOperation.ts",
      "types": "./dist/types/src/types/SearchOperation.d.ts",
      "import": "./dist/lib/SearchOperation.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "CommerceEvents": [
        "dist/types/src/types/CommerceEvents.d.ts"
      ],
      "Provider": [
        "dist/types/src/types/Provider.d.ts"
      ],
      "Result": [
        "dist/types/src/types/Result.d.ts"
      ],
      "Search": [
        "dist/types/src/types/Search.d.ts"
      ],
      "SearchOperation": [
        "dist/types/src/types/SearchOperation.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/assistant-toolkit": "workspace:*",
    "@dxos/client": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/edge-client": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-attention": "workspace:*",
    "@dxos/plugin-graph": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/react-ui-list": "workspace:*",
    "@dxos/react-ui-masonry": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/util": "workspace:*",
    "effect": "catalog:",
    "node-html-parser": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@dxos/agent-runtime": "workspace:*",
    "@dxos/echo-client": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@effect/vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
