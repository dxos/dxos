      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./package.json": "./package.json",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./Kanban": {
      "source": "./src/types/Kanban.ts",
      "types": "./dist/types/src/types/Kanban.d.ts",
      "import": "./dist/lib/Kanban.mjs"
    },
    "./KanbanConstants": {
      "source": "./src/types/KanbanConstants.ts",
      "types": "./dist/types/src/types/KanbanConstants.d.ts",
      "import": "./dist/lib/KanbanConstants.mjs"
    },
    "./KanbanEvents": {
      "source": "./src/types/KanbanEvents.ts",
      "types": "./dist/types/src/types/KanbanEvents.d.ts",
      "import": "./dist/lib/KanbanEvents.mjs"
    },
