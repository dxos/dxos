      "source": "./src/operations/KanbanOperationHandlerSet.ts",
      "types": "./dist/types/src/operations/KanbanOperationHandlerSet.d.ts",
      "import": "./dist/lib/KanbanOperationHandlerSet.mjs"
    },
    "./KanbanSkill": {
      "source": "./src/skills/KanbanSkill.ts",
      "types": "./dist/types/src/skills/KanbanSkill.d.ts",
      "import": "./dist/lib/KanbanSkill.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Kanban": [
        "dist/types/src/types/Kanban.d.ts"
      ],
      "KanbanConstants": [
        "dist/types/src/types/KanbanConstants.d.ts"
      ],
      "KanbanEvents": [
        "dist/types/src/types/KanbanEvents.d.ts"
      ],
      "KanbanLayout": [
        "dist/types/src/types/KanbanLayout.d.ts"
      ],
      "KanbanOperation": [
        "dist/types/src/types/KanbanOperation.d.ts"
      ],
      "KanbanSchema": [
        "dist/types/src/types/KanbanSchema.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/effect": "workspace:*",
