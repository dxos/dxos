{
  "name": "@dxos/plugin-routine",
  "version": "0.11.1",
  "description": "Prompt chain plugin",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#hooks": {
      "source": "./src/hooks/index.ts",
      "types": "./dist/types/src/hooks/index.d.ts",
      "default": "./dist/lib/hooks.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "default": "./dist/lib/testing.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "import": "./dist/lib/components.mjs"
    },
    "./hooks": {
      "source": "./src/hooks/index.ts",
      "types": "./dist/types/src/hooks/index.d.ts",
      "import": "./dist/lib/hooks.mjs"
    },
    "./package.json": "./package.json",
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "import": "./dist/lib/testing.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./util": {
      "source": "./src/util/index.ts",
      "types": "./dist/types/src/util/index.d.ts",
      "import": "./dist/lib/util.mjs"
    },
    "./Routine": {
      "source": "./src/types/Routine.ts",
      "types": "./dist/types/src/types/Routine.d.ts",
      "import": "./dist/lib/Routine.mjs"
    },
    "./RoutineCapabilities": {
      "source": "./src/types/RoutineCapabilities.ts",
      "types": "./dist/types/src/types/RoutineCapabilities.d.ts",
      "import": "./dist/lib/RoutineCapabilities.mjs"
    },
    "./RoutineEvents": {
      "source": "./src/types/RoutineEvents.ts",
      "types": "./dist/types/src/types/RoutineEvents.d.ts",
      "import": "./dist/lib/RoutineEvents.mjs"
    },
    "./RoutineOperation": {
      "source": "./src/types/RoutineOperation.ts",
      "types": "./dist/types/src/types/RoutineOperation.d.ts",
      "import": "./dist/lib/RoutineOperation.mjs"
    },
    "./RoutinePlugin": {
      "source": "./src/RoutinePlugin.ts",
      "types": "./dist/types/src/RoutinePlugin.d.ts",
      "import": "./dist/lib/RoutinePlugin.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Routine": [
        "dist/types/src/types/Routine.d.ts"
      ],
      "RoutineCapabilities": [
        "dist/types/src/types/RoutineCapabilities.d.ts"
      ],
      "RoutineEvents": [
        "dist/types/src/types/RoutineEvents.d.ts"
      ],
      "RoutineOperation": [
        "dist/types/src/types/RoutineOperation.d.ts"
      ]
    }
  },
  "files": [
    "assets",
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@codemirror/autocomplete": "catalog:",
