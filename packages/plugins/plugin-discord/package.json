{
  "name": "@dxos/plugin-discord",
  "version": "0.17.0",
  "description": "DXOS plugin that integrates Discord as a sync source via the generic Integration mechanism.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/DiscordPlugin.workerd.mjs",
      "node": "./dist/lib/DiscordPlugin.node.mjs",
      "default": "./dist/lib/DiscordPlugin.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./DiscordAdminOperation": {
      "source": "./src/types/DiscordAdminOperation.ts",
      "types": "./dist/types/src/types/DiscordAdminOperation.d.ts",
      "import": "./dist/lib/DiscordAdminOperation.mjs"
    },
    "./DiscordAgentOperation": {
      "source": "./src/types/DiscordAgentOperation.ts",
      "types": "./dist/types/src/types/DiscordAgentOperation.d.ts",
      "import": "./dist/lib/DiscordAgentOperation.mjs"
    },
    "./DiscordBot": {
      "source": "./src/types/DiscordBot.ts",
      "types": "./dist/types/src/types/DiscordBot.d.ts",
      "import": "./dist/lib/DiscordBot.mjs"
    },
    "./DiscordChannel": {
      "source": "./src/types/DiscordChannel.ts",
      "types": "./dist/types/src/types/DiscordChannel.d.ts",
      "import": "./dist/lib/DiscordChannel.mjs"
    },
    "./DiscordEvents": {
      "source": "./src/types/DiscordEvents.ts",
      "types": "./dist/types/src/types/DiscordEvents.d.ts",
      "import": "./dist/lib/DiscordEvents.mjs"
    },
    "./DiscordOperation": {
      "source": "./src/types/DiscordOperation.ts",
      "types": "./dist/types/src/types/DiscordOperation.d.ts",
      "import": "./dist/lib/DiscordOperation.mjs"
    },
    "./DiscordPlugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/DiscordPlugin.workerd.mjs",
      "node": "./dist/lib/DiscordPlugin.node.mjs",
      "import": "./dist/lib/DiscordPlugin.mjs"
    },
    "./DiscordSource": {
      "source": "./src/DiscordSource.ts",
      "types": "./dist/types/src/DiscordSource.d.ts",
      "import": "./dist/lib/ns/DiscordSource.mjs"
    },
    "./DiscordTargetOptions": {
      "source": "./src/types/DiscordTargetOptions.ts",
      "types": "./dist/types/src/types/DiscordTargetOptions.d.ts",
      "import": "./dist/lib/DiscordTargetOptions.mjs"
    },
    "./package.json": "./package.json",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "DiscordAdminOperation": [
        "dist/types/src/types/DiscordAdminOperation.d.ts"
      ],
      "DiscordAgentOperation": [
        "dist/types/src/types/DiscordAgentOperation.d.ts"
      ],
      "DiscordBot": [
        "dist/types/src/types/DiscordBot.d.ts"
      ],
      "DiscordChannel": [
        "dist/types/src/types/DiscordChannel.d.ts"
      ],
      "DiscordEvents": [
        "dist/types/src/types/DiscordEvents.d.ts"
      ],
      "DiscordOperation": [
        "dist/types/src/types/DiscordOperation.d.ts"
      ],
      "DiscordTargetOptions": [
        "dist/types/src/types/DiscordTargetOptions.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/ai": "workspace:*",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/assistant": "workspace:*",
    "@dxos/blob": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/config": "workspace:*",
    "@dxos/context": "workspace:*",
    "@dxos/crawler": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-client": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/edge-client": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/pipeline": "workspace:*",
    "@dxos/pipeline-discord": "workspace:*",
    "@dxos/pipeline-rdf": "workspace:*",
    "@dxos/plugin-agent": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-connector": "workspace:*",
    "@dxos/plugin-thread": "workspace:*",
    "@dxos/protocols": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-hooks": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/react-ui-list": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/ui-types": "workspace:*",
    "@dxos/util": "workspace:*",
    "dfx": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@dxos/effect": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@effect/sql-sqlite-node": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
