{
  "name": "@dxos/plugin-client",
  "version": "0.11.1",
  "description": "DXOS Surface plugin for DXOS Client",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#commands": {
      "source": {
        "node": "./src/capabilities/commands.node.ts",
        "default": "./src/capabilities/commands.ts"
      },
      "types": "./dist/types/src/capabilities/commands.d.ts",
      "node": "./dist/lib/commands.node.mjs",
      "default": "./dist/lib/commands.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.ts",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "default": "./dist/lib/testing.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "import": "./dist/lib/testing.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./Account": {
      "source": "./src/types/Account.ts",
      "types": "./dist/types/src/types/Account.d.ts",
      "import": "./dist/lib/Account.mjs"
    },
    "./AccountCache": {
      "source": "./src/types/AccountCache.ts",
      "types": "./dist/types/src/types/AccountCache.d.ts",
      "import": "./dist/lib/AccountCache.mjs"
    },
    "./ClientAction": {
      "source": "./src/types/ClientAction.ts",
      "types": "./dist/types/src/types/ClientAction.d.ts",
      "import": "./dist/lib/ClientAction.mjs"
    },
    "./ClientCapabilities": {
      "source": "./src/types/ClientCapabilities.ts",
      "types": "./dist/types/src/types/ClientCapabilities.d.ts",
      "import": "./dist/lib/ClientCapabilities.mjs"
    },
    "./ClientEvents": {
      "source": "./src/types/ClientEvents.ts",
      "types": "./dist/types/src/types/ClientEvents.d.ts",
      "import": "./dist/lib/ClientEvents.mjs"
    },
    "./ClientOperation": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "import": "./dist/lib/operations.mjs"
    },
    "./ClientOptions": {
      "source": "./src/types/ClientOptions.ts",
      "types": "./dist/types/src/types/ClientOptions.d.ts",
      "import": "./dist/lib/ClientOptions.mjs"
    },
    "./ClientPlugin": {
      "source": "./src/ClientPlugin.ts",
      "types": "./dist/types/src/ClientPlugin.d.ts",
      "import": "./dist/lib/ClientPlugin.mjs"
    },
    "./PasskeyError": {
      "source": "./src/types/PasskeyError.ts",
      "types": "./dist/types/src/types/PasskeyError.d.ts",
      "import": "./dist/lib/PasskeyError.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Account": [
        "dist/types/src/types/Account.d.ts"
      ],
      "AccountCache": [
        "dist/types/src/types/AccountCache.d.ts"
      ],
      "ClientAction": [
        "dist/types/src/types/ClientAction.d.ts"
      ],
      "ClientCapabilities": [
        "dist/types/src/types/ClientCapabilities.d.ts"
      ],
      "ClientEvents": [
        "dist/types/src/types/ClientEvents.d.ts"
      ],
      "ClientOptions": [
        "dist/types/src/types/ClientOptions.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/async": "workspace:*",
    "@dxos/cli-util": "workspace:*",
    "@dxos/client": "workspace:*",
    "@dxos/client-protocol": "workspace:*",
    "@dxos/client-services": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/compute-runtime": "workspace:*",
    "@dxos/config": "workspace:*",
    "@dxos/context": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/edge-client": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/graph": "workspace:*",
    "@dxos/halo": "workspace:*",
    "@dxos/halo-adapter-client": "workspace:*",
    "@dxos/halo-react": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-observability": "workspace:*",
    "@dxos/protocols": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/react-ui-list": "workspace:*",
    "@dxos/react-ui-pickers": "workspace:*",
    "@dxos/shell": "workspace:*",
    "@dxos/util": "workspace:*",
    "effect": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
