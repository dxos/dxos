{
  "name": "@dxos/plugin-attention",
  "version": "0.16.0",
  "description": "Plugin for attention",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/AttentionPlugin.workerd.mjs",
      "node": "./dist/lib/AttentionPlugin.node.mjs",
      "default": "./dist/lib/AttentionPlugin.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/types/src/testing.d.ts",
      "import": "./dist/lib/testing.mjs"
    },
    "./AttentionAction": {
      "source": "./src/types/AttentionAction.ts",
      "types": "./dist/types/src/types/AttentionAction.d.ts",
      "import": "./dist/lib/AttentionAction.mjs"
    },
    "./AttentionCapabilities": {
      "source": "./src/types/AttentionCapabilities.ts",
      "types": "./dist/types/src/types/AttentionCapabilities.d.ts",
      "import": "./dist/lib/AttentionCapabilities.mjs"
    },
    "./AttentionPlugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/AttentionPlugin.workerd.mjs",
      "node": "./dist/lib/AttentionPlugin.node.mjs",
      "import": "./dist/lib/AttentionPlugin.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "AttentionAction": [
        "dist/types/src/types/AttentionAction.d.ts"
      ],
      "AttentionCapabilities": [
        "dist/types/src/types/AttentionCapabilities.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/plugin-graph": "workspace:*",
    "@dxos/react-focus": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-editor": "workspace:*",
    "@dxos/react-ui-list": "workspace:*",
    "@dxos/ui-editor": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
