{
  "name": "@dxos/plugin-s3",
  "version": "0.16.0",
  "private": true,
  "description": "S3-compatible object storage backend for Composer (Cloudflare R2, AWS S3, MinIO).",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "default": "./dist/lib/S3Plugin.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./S3Plugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "import": "./dist/lib/S3Plugin.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/blob": "workspace:*",
    "@dxos/compute-runtime": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-connector": "workspace:*",
    "@dxos/plugin-file": "workspace:*",
    "@dxos/util": "workspace:*",
    "effect": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
