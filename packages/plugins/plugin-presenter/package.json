{
  "name": "@dxos/plugin-presenter",
  "version": "0.17.0",
  "description": "Braneframe presenter plugin",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "imports": {
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#deck": {
      "source": "./src/deck/index.ts",
      "types": "./dist/types/src/deck/index.d.ts",
      "default": "./dist/lib/deck.mjs"
    },
    "#hooks": {
      "source": "./src/hooks/index.ts",
      "types": "./dist/types/src/hooks/index.d.ts",
      "default": "./dist/lib/hooks.mjs"
    },
    "#markdown": {
      "source": "./src/markdown/index.ts",
      "types": "./dist/types/src/markdown/index.d.ts",
      "default": "./dist/lib/markdown.mjs"
    },
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/PresenterPlugin.workerd.mjs",
      "node": "./dist/lib/PresenterPlugin.node.mjs",
      "default": "./dist/lib/PresenterPlugin.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "default": "./dist/lib/testing.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./package.json": "./package.json",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./Presentation": {
      "source": "./src/types/Presentation.ts",
      "types": "./dist/types/src/types/Presentation.d.ts",
      "import": "./dist/lib/Presentation.mjs"
    },
    "./PresenterCapabilities": {
      "source": "./src/types/PresenterCapabilities.ts",
      "types": "./dist/types/src/types/PresenterCapabilities.d.ts",
      "import": "./dist/lib/PresenterCapabilities.mjs"
    },
    "./PresenterEvents": {
      "source": "./src/types/PresenterEvents.ts",
      "types": "./dist/types/src/types/PresenterEvents.d.ts",
      "import": "./dist/lib/PresenterEvents.mjs"
    },
    "./PresenterOperation": {
      "source": "./src/types/PresenterOperation.ts",
      "types": "./dist/types/src/types/PresenterOperation.d.ts",
      "import": "./dist/lib/PresenterOperation.mjs"
    },
    "./PresenterPlugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/PresenterPlugin.workerd.mjs",
      "node": "./dist/lib/PresenterPlugin.node.mjs",
      "import": "./dist/lib/PresenterPlugin.mjs"
    },
    "./PresenterSettings": {
      "source": "./src/types/PresenterSettings.ts",
      "types": "./dist/types/src/types/PresenterSettings.d.ts",
      "import": "./dist/lib/PresenterSettings.mjs"
    },
    "./PresenterSurface": {
      "source": "./src/types/PresenterSurface.ts",
      "types": "./dist/types/src/types/PresenterSurface.d.ts",
      "import": "./dist/lib/PresenterSurface.mjs"
    },
    "./SlideEditorViewState": {
      "source": "./src/types/SlideEditorViewState.ts",
      "types": "./dist/types/src/types/SlideEditorViewState.d.ts",
      "import": "./dist/lib/SlideEditorViewState.mjs"
    },
    "./SlideTheme": {
      "source": "./src/types/SlideTheme.ts",
      "types": "./dist/types/src/types/SlideTheme.d.ts",
      "import": "./dist/lib/SlideTheme.mjs"
    },
    "./SlideViewState": {
      "source": "./src/types/SlideViewState.ts",
      "types": "./dist/types/src/types/SlideViewState.d.ts",
      "import": "./dist/lib/SlideViewState.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Presentation": [
        "dist/types/src/types/Presentation.d.ts"
      ],
      "PresenterCapabilities": [
        "dist/types/src/types/PresenterCapabilities.d.ts"
      ],
      "PresenterEvents": [
        "dist/types/src/types/PresenterEvents.d.ts"
      ],
      "PresenterOperation": [
        "dist/types/src/types/PresenterOperation.d.ts"
      ],
      "PresenterSettings": [
        "dist/types/src/types/PresenterSettings.d.ts"
      ],
      "PresenterSurface": [
        "dist/types/src/types/PresenterSurface.d.ts"
      ],
      "SlideViewState": [
        "dist/types/src/types/SlideViewState.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
