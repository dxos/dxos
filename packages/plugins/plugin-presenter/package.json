{
  "name": "@dxos/plugin-presenter",
  "version": "0.12.0",
  "description": "Braneframe presenter plugin",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#testing": {
      "source": "./src/testing.ts",
      "types": "./dist/types/src/testing.d.ts",
      "default": "./dist/lib/testing.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./package.json": "./package.json",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./PresenterCapabilities": {
      "source": "./src/types/PresenterCapabilities.ts",
      "types": "./dist/types/src/types/PresenterCapabilities.d.ts",
      "import": "./dist/lib/PresenterCapabilities.mjs"
    },
    "./PresenterEvents": {
      "source": "./src/types/PresenterEvents.ts",
      "types": "./dist/types/src/types/PresenterEvents.d.ts",
      "import": "./dist/lib/PresenterEvents.mjs"
    },
    "./PresenterOperation": {
      "source": "./src/types/PresenterOperation.ts",
      "types": "./dist/types/src/types/PresenterOperation.d.ts",
      "import": "./dist/lib/PresenterOperation.mjs"
    },
    "./PresenterPlugin": {
      "source": "./src/PresenterPlugin.ts",
      "types": "./dist/types/src/PresenterPlugin.d.ts",
      "import": "./dist/lib/PresenterPlugin.mjs"
    },
    "./Settings": {
      "source": "./src/types/Settings.ts",
      "types": "./dist/types/src/types/Settings.d.ts",
      "import": "./dist/lib/Settings.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Presenter": [
        "dist/types/src/types/Presenter.d.ts"
      ],
      "PresenterCapabilities": [
        "dist/types/src/types/PresenterCapabilities.d.ts"
      ],
      "PresenterEvents": [
        "dist/types/src/types/PresenterEvents.d.ts"
      ],
      "PresenterOperation": [
        "dist/types/src/types/PresenterOperation.d.ts"
      ],
      "Settings": [
        "dist/types/src/types/Settings.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@codemirror/state": "catalog:",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/plugin-deck": "workspace:*",
    "@dxos/plugin-markdown": "workspace:*",
    "@dxos/random": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/ui-editor": "workspace:*",
    "@dxos/util": "workspace:*",
    "hastscript": "catalog:",
    "highlight.js": "catalog:",
    "marked": "catalog:",
    "react-markdown": "catalog:",
    "react-resize-detector": "catalog:",
    "rehype-add-classes": "catalog:",
    "rehype-highlight": "catalog:",
    "remark-frontmatter": "catalog:",
    "remark-parse-frontmatter": "catalog:",
    "reveal.js": "catalog:"
  },
  "devDependencies": {
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/reveal.js": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
