      "Trip": [
        "dist/types/src/types/Trip.d.ts"
      ],
      "TripCapabilities": [
        "dist/types/src/types/TripCapabilities.d.ts"
      ],
      "TripEvents": [
        "dist/types/src/types/TripEvents.d.ts"
      ],
      "TripOperation": [
        "dist/types/src/types/TripOperation.d.ts"
      ]
    }
