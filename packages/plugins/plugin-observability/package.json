{
  "name": "@dxos/plugin-observability",
  "version": "0.11.1",
  "description": "DXOS app framework plugin for hooking up app observability",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operation-handler": {
      "source": {
        "workerd": "./src/capabilities/operation-handler.headless.ts",
        "default": "./src/capabilities/operation-handler.ts"
      },
      "types": "./dist/types/src/capabilities/operation-handler.d.ts",
      "workerd": "./dist/lib/operation-handler.headless.mjs",
      "default": "./dist/lib/operation-handler.mjs"
    },
    "#privacy-banner": {
      "source": {
        "node": "./src/capabilities/privacy-banner.ts",
        "default": "./src/capabilities/privacy-banner.noop.ts"
      },
      "types": "./dist/types/src/capabilities/privacy-banner.d.ts",
      "node": "./dist/lib/privacy-banner.mjs",
      "default": "./dist/lib/privacy-banner.noop.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.ts",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./package.json": "./package.json",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./ObservabilityCapabilities": {
      "source": "./src/types/ObservabilityCapabilities.ts",
      "types": "./dist/types/src/types/ObservabilityCapabilities.d.ts",
      "import": "./dist/lib/ObservabilityCapabilities.mjs"
    },
    "./ObservabilityEvents": {
      "source": "./src/types/ObservabilityEvents.ts",
      "types": "./dist/types/src/types/ObservabilityEvents.d.ts",
      "import": "./dist/lib/ObservabilityEvents.mjs"
    },
    "./ObservabilityOperation": {
      "source": "./src/types/ObservabilityOperation.ts",
      "types": "./dist/types/src/types/ObservabilityOperation.d.ts",
      "import": "./dist/lib/ObservabilityOperation.mjs"
    },
    "./ObservabilityOptions": {
      "source": "./src/types/ObservabilityOptions.ts",
      "types": "./dist/types/src/types/ObservabilityOptions.d.ts",
      "import": "./dist/lib/ObservabilityOptions.mjs"
    },
    "./ObservabilityPlugin": {
      "source": "./src/ObservabilityPlugin.ts",
      "types": "./dist/types/src/ObservabilityPlugin.d.ts",
      "import": "./dist/lib/ObservabilityPlugin.mjs"
    },
    "./Settings": {
      "source": "./src/types/Settings.ts",
      "types": "./dist/types/src/types/Settings.d.ts",
      "import": "./dist/lib/Settings.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "ObservabilityCapabilities": [
        "dist/types/src/types/ObservabilityCapabilities.d.ts"
      ],
      "ObservabilityEvents": [
        "dist/types/src/types/ObservabilityEvents.d.ts"
      ],
      "ObservabilityOperation": [
        "dist/types/src/types/ObservabilityOperation.d.ts"
      ],
      "ObservabilityOptions": [
        "dist/types/src/types/ObservabilityOptions.d.ts"
      ],
      "Settings": [
        "dist/types/src/types/Settings.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/client": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/config": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/observability": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@dxos/operation": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
