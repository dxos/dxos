{
  "name": "@dxos/plugin-code-graph",
  "version": "0.16.0",
  "private": true,
  "description": "Canvas of the codebase built from code-index, shaped by the assistant.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#client": {
      "source": "./src/client/index.ts",
      "types": "./dist/types/src/client/index.d.ts",
      "default": "./dist/lib/client.mjs"
    },
    "#command": {
      "source": "./src/command/index.ts",
      "types": "./dist/types/src/command/index.d.ts",
      "default": "./dist/lib/command.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#graph": {
      "source": "./src/graph/index.ts",
      "types": "./dist/types/src/graph/index.d.ts",
      "default": "./dist/lib/graph.mjs"
    },
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/CodeGraphPlugin.workerd.mjs",
      "node": "./dist/lib/CodeGraphPlugin.node.mjs",
      "default": "./dist/lib/CodeGraphPlugin.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./package.json": "./package.json",
    "./CodeGraph": {
      "source": "./src/types/CodeGraph.ts",
      "types": "./dist/types/src/types/CodeGraph.d.ts",
      "import": "./dist/lib/CodeGraph.mjs"
    },
    "./CodeGraphOperation": {
      "source": "./src/types/CodeGraphOperation.ts",
      "types": "./dist/types/src/types/CodeGraphOperation.d.ts",
      "import": "./dist/lib/CodeGraphOperation.mjs"
    },
    "./CodeGraphPlugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/CodeGraphPlugin.workerd.mjs",
      "node": "./dist/lib/CodeGraphPlugin.node.mjs",
      "import": "./dist/lib/CodeGraphPlugin.mjs"
    },
    "./CodeGraphSkill": {
      "source": "./src/skills/CodeGraphSkill.ts",
      "types": "./dist/types/src/skills/CodeGraphSkill.d.ts",
      "import": "./dist/lib/CodeGraphSkill.mjs"
    },
    "./vite-plugin": {
      "types": "./dist/types/src/vite-plugin/index.d.ts",
      "import": "./dist/lib/vite-plugin.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "CodeGraph": [
        "dist/types/src/types/CodeGraph.d.ts"
      ],
      "CodeGraphOperation": [
        "dist/types/src/types/CodeGraphOperation.d.ts"
      ],
      "CodeGraphPlugin": [
        "dist/types/src/CodeGraphPlugin.d.ts"
      ],
      "CodeGraphSkill": [
        "dist/types/src/skills/CodeGraphSkill.d.ts"
      ],
      "vite-plugin": [
        "dist/types/src/vite-plugin/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/ai": "workspace:*",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/diagram": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-illustrator": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/plugin-transcription": "workspace:*",
    "@dxos/react-ui-canvas": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/react-ui-scene": "workspace:*",
    "@dxos/react-ui-syntax-highlighter": "workspace:*",
    "@dxos/react-ui-transcription": "workspace:*",
    "@dxos/scene": "workspace:*",
    "@dxos/util": "workspace:*",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@dxos/edge-client": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/plugin-typesafe": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
