{
  "name": "@dxos/plugin-calls",
  "version": "0.16.0",
  "description": "DXOS Calls (video / audio conferencing) plugin",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#hooks": {
      "source": "./src/hooks/index.ts",
      "types": "./dist/types/src/hooks/index.d.ts",
      "default": "./dist/lib/hooks.mjs"
    },
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/CallsPlugin.workerd.mjs",
      "node": "./dist/lib/CallsPlugin.node.mjs",
      "default": "./dist/lib/CallsPlugin.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./CallOperation": {
      "source": "./src/types/CallOperation.ts",
      "types": "./dist/types/src/types/CallOperation.d.ts",
      "import": "./dist/lib/CallOperation.mjs"
    },
    "./CallManager": {
      "source": "./src/CallManager.ts",
      "types": "./dist/types/src/CallManager.d.ts",
      "import": "./dist/lib/ns/CallManager.mjs"
    },
    "./CallsCapabilities": {
      "source": "./src/types/CallsCapabilities.ts",
      "types": "./dist/types/src/types/CallsCapabilities.d.ts",
      "import": "./dist/lib/CallsCapabilities.mjs"
    },
    "./CallsEvents": {
      "source": "./src/types/CallsEvents.ts",
      "types": "./dist/types/src/types/CallsEvents.d.ts",
      "import": "./dist/lib/CallsEvents.mjs"
    },
    "./CallsPlugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/CallsPlugin.workerd.mjs",
      "node": "./dist/lib/CallsPlugin.node.mjs",
      "import": "./dist/lib/CallsPlugin.mjs"
    },
    "./package.json": "./package.json",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "CallOperation": [
        "dist/types/src/types/CallOperation.d.ts"
      ],
      "CallsCapabilities": [
        "dist/types/src/types/CallsCapabilities.d.ts"
      ],
      "CallsEvents": [
        "dist/types/src/types/CallsEvents.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/async": "workspace:*",
    "@dxos/av": "workspace:*",
    "@dxos/client": "workspace:*",
    "@dxos/client-protocol": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/config": "workspace:*",
    "@dxos/context": "workspace:*",
    "@dxos/debug": "workspace:*",
    "@dxos/devtools": "workspace:*",
    "@dxos/display-name": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/graph": "workspace:*",
    "@dxos/halo": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-graph": "workspace:*",
    "@dxos/protocols": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-audio": "workspace:*",
    "@dxos/react-ui-components": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@dxos/util": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@peermetrics/webrtc-stats": "catalog:",
    "md5-hex": "catalog:",
    "react-resize-detector": "catalog:"
  },
  "devDependencies": {
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/random": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-ui-experimental": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
