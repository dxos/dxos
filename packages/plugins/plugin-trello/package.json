{
  "name": "@dxos/plugin-trello",
  "version": "0.16.0",
  "private": true,
  "description": "DXOS plugin that integrates Trello as a sync source via the generic Integration mechanism.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/TrelloPlugin.workerd.mjs",
      "node": "./dist/lib/TrelloPlugin.node.mjs",
      "default": "./dist/lib/TrelloPlugin.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./package.json": "./package.json",
    "./TrelloEvents": {
      "source": "./src/types/TrelloEvents.ts",
      "types": "./dist/types/src/types/TrelloEvents.d.ts",
      "import": "./dist/lib/TrelloEvents.mjs"
    },
    "./TrelloOperation": {
      "source": "./src/types/TrelloOperation.ts",
      "types": "./dist/types/src/types/TrelloOperation.d.ts",
      "import": "./dist/lib/TrelloOperation.mjs"
    },
    "./TrelloPlugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/TrelloPlugin.workerd.mjs",
      "node": "./dist/lib/TrelloPlugin.node.mjs",
      "import": "./dist/lib/TrelloPlugin.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "TrelloEvents": [
        "dist/types/src/types/TrelloEvents.d.ts"
      ],
      "TrelloOperation": [
        "dist/types/src/types/TrelloOperation.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-connector": "workspace:*",
    "@dxos/plugin-kanban": "workspace:*",
    "@dxos/protocols": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@dxos/echo-client": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
