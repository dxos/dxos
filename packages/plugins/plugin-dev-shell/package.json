{
  "name": "@dxos/plugin-dev-shell",
  "version": "0.16.0",
  "private": true,
  "description": "Dev-only coding harness: a bash tool and a multi-string-replace tool backed by a vite dev-server route.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/DevShellPlugin.workerd.mjs",
      "node": "./dist/lib/DevShellPlugin.node.mjs",
      "default": "./dist/lib/DevShellPlugin.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#shell": {
      "source": "./src/shell/index.ts",
      "types": "./dist/types/src/shell/index.d.ts",
      "default": "./dist/lib/shell.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./DevShellOperation": {
      "source": "./src/types/DevShellOperation.ts",
      "types": "./dist/types/src/types/DevShellOperation.d.ts",
      "import": "./dist/lib/DevShellOperation.mjs"
    },
    "./DevShellPlugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/DevShellPlugin.workerd.mjs",
      "node": "./dist/lib/DevShellPlugin.node.mjs",
      "import": "./dist/lib/DevShellPlugin.mjs"
    },
    "./package.json": "./package.json",
    "./vite-plugin": {
      "types": "./dist/types/src/vite-plugin/index.d.ts",
      "import": "./dist/lib/vite-plugin.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "DevShellOperation": [
        "dist/types/src/types/DevShellOperation.d.ts"
      ],
      "vite-plugin": [
        "dist/types/src/vite-plugin/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-claude": "workspace:*",
    "@dxos/plugin-projects": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@dxos/assistant": "workspace:*",
    "@dxos/echo-client": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/schema": "workspace:*",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
