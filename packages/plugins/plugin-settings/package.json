{
  "name": "@dxos/plugin-settings",
  "version": "0.17.0",
  "description": "DXOS Settings plugin for managing application settings.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/SettingsPlugin.workerd.mjs",
      "node": "./dist/lib/SettingsPlugin.node.mjs",
      "default": "./dist/lib/SettingsPlugin.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./SettingsAction": {
      "source": "./src/SettingsAction.ts",
      "types": "./dist/types/src/SettingsAction.d.ts",
      "import": "./dist/lib/ns/SettingsAction.mjs"
    },
    "./SettingsPath": {
      "source": "./src/types/SettingsPath.ts",
      "types": "./dist/types/src/types/SettingsPath.d.ts",
      "import": "./dist/lib/SettingsPath.mjs"
    },
    "./SettingsPlugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/SettingsPlugin.workerd.mjs",
      "node": "./dist/lib/SettingsPlugin.node.mjs",
      "import": "./dist/lib/SettingsPlugin.mjs"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/types/src/testing.d.ts",
      "import": "./dist/lib/testing.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "SettingsPath": [
        "dist/types/src/types/SettingsPath.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/graph": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/util": "workspace:*"
  },
  "devDependencies": {
    "@dxos/plugin-graph": "workspace:*",
    "@types/react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:",
    "react": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
