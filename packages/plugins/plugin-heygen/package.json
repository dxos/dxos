{
  "name": "@dxos/plugin-heygen",
  "version": "0.16.0",
  "private": true,
  "description": "HeyGen video-generation provider for Composer.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/HeyGenPlugin.workerd.mjs",
      "node": "./dist/lib/HeyGenPlugin.node.mjs",
      "default": "./dist/lib/HeyGenPlugin.mjs"
    },
    "#services": {
      "source": "./src/services/index.ts",
      "types": "./dist/types/src/services/index.d.ts",
      "default": "./dist/lib/services.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./HeyGenEvents": {
      "source": "./src/HeyGenEvents.ts",
      "types": "./dist/types/src/HeyGenEvents.d.ts",
      "import": "./dist/lib/ns/HeyGenEvents.mjs"
    },
    "./HeyGenPlugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/HeyGenPlugin.workerd.mjs",
      "node": "./dist/lib/HeyGenPlugin.node.mjs",
      "import": "./dist/lib/HeyGenPlugin.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/edge-client": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-connector": "workspace:*",
    "@dxos/plugin-studio": "workspace:*",
    "@dxos/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-list": "workspace:*",
    "@dxos/react-ui-syntax-highlighter": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
