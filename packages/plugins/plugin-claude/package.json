{
  "name": "@dxos/plugin-claude",
  "version": "0.17.0",
  "private": true,
  "description": "Claude managed agents as ECHO objects, with an assistant skill to configure, deploy and run them",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#api": {
      "source": "./src/api/index.ts",
      "types": "./dist/types/src/api/index.d.ts",
      "default": "./dist/lib/api.mjs"
    },
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/ClaudePlugin.workerd.mjs",
      "node": "./dist/lib/ClaudePlugin.node.mjs",
      "default": "./dist/lib/ClaudePlugin.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./package.json": "./package.json",
    "./ClaudePlugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/ClaudePlugin.workerd.mjs",
      "node": "./dist/lib/ClaudePlugin.node.mjs",
      "import": "./dist/lib/ClaudePlugin.mjs"
    },
    "./ClaudeAgentOperation": {
      "source": "./src/types/ClaudeAgentOperation.ts",
      "types": "./dist/types/src/types/ClaudeAgentOperation.d.ts",
      "import": "./dist/lib/ClaudeAgentOperation.mjs"
    },
    "./ClaudeAgentSession": {
      "source": "./src/types/ClaudeAgentSession.ts",
      "types": "./dist/types/src/types/ClaudeAgentSession.d.ts",
      "import": "./dist/lib/ClaudeAgentSession.mjs"
    },
    "./ClaudeEvents": {
      "source": "./src/types/ClaudeEvents.ts",
      "types": "./dist/types/src/types/ClaudeEvents.d.ts",
      "import": "./dist/lib/ClaudeEvents.mjs"
    },
    "./ClaudeSkill": {
      "source": "./src/skills/ClaudeSkill.ts",
      "types": "./dist/types/src/skills/ClaudeSkill.d.ts",
      "import": "./dist/lib/ClaudeSkill.mjs"
    },
    "./ClaudeManagedAgent": {
      "source": "./src/types/ClaudeManagedAgent.ts",
      "types": "./dist/types/src/types/ClaudeManagedAgent.d.ts",
      "import": "./dist/lib/ClaudeManagedAgent.mjs"
    },
    "./ClaudeCapabilities": {
      "source": "./src/types/ClaudeCapabilities.ts",
      "types": "./dist/types/src/types/ClaudeCapabilities.d.ts",
      "import": "./dist/lib/ClaudeCapabilities.mjs"
    },
    "./HelperClient": {
      "source": "./src/agents/HelperClient.ts",
      "types": "./dist/types/src/agents/HelperClient.d.ts",
      "import": "./dist/lib/HelperClient.mjs"
    },
    "./Settings": {
      "source": "./src/types/Settings.ts",
      "types": "./dist/types/src/types/Settings.d.ts",
      "import": "./dist/lib/Settings.mjs"
    },
    "./State": {
      "source": "./src/types/State.ts",
      "types": "./dist/types/src/types/State.d.ts",
      "import": "./dist/lib/State.mjs"
    },
    "./vite-plugin": {
      "types": "./dist/types/src/agent-helper/index.d.ts",
      "import": "./dist/lib/vite-plugin.mjs"
    },
    "./AcpAgent": {
      "source": "./src/agents/AcpAgent.ts",
      "types": "./dist/types/src/agents/AcpAgent.d.ts",
      "import": "./dist/lib/AcpAgent.mjs"
    },
    "./CodeAgent": {
      "source": "./src/agents/CodeAgent.ts",
      "types": "./dist/types/src/agents/CodeAgent.d.ts",
      "import": "./dist/lib/CodeAgent.mjs"
    },
    "./ComposerMcp": {
      "source": "./src/agents/ComposerMcp.ts",
      "types": "./dist/types/src/agents/ComposerMcp.d.ts",
      "import": "./dist/lib/ComposerMcp.mjs"
    },
    "./EdgeAgent": {
      "source": "./src/agents/EdgeAgent.ts",
      "types": "./dist/types/src/agents/EdgeAgent.d.ts",
      "import": "./dist/lib/EdgeAgent.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "AcpAgent": [
        "dist/types/src/agents/AcpAgent.d.ts"
      ],
      "ClaudeAgentOperation": [
        "dist/types/src/types/ClaudeAgentOperation.d.ts"
      ],
      "ClaudeAgentSession": [
        "dist/types/src/types/ClaudeAgentSession.d.ts"
      ],
      "ClaudeCapabilities": [
        "dist/types/src/types/ClaudeCapabilities.d.ts"
      ],
      "ClaudeEvents": [
        "dist/types/src/types/ClaudeEvents.d.ts"
      ],
      "ClaudeManagedAgent": [
        "dist/types/src/types/ClaudeManagedAgent.d.ts"
      ],
      "CodeAgent": [
        "dist/types/src/agents/CodeAgent.d.ts"
      ],
      "ComposerMcp": [
        "dist/types/src/agents/ComposerMcp.d.ts"
      ],
      "EdgeAgent": [
        "dist/types/src/agents/EdgeAgent.d.ts"
      ],
      "HelperClient": [
        "dist/types/src/agents/HelperClient.d.ts"
      ],
      "Settings": [
        "dist/types/src/types/Settings.d.ts"
      ],
      "State": [
        "dist/types/src/types/State.d.ts"
      ],
      "vite-plugin": [
        "dist/types/src/agent-helper/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@dxos/agent-runtime": "workspace:*",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/assistant": "workspace:*",
    "@dxos/client": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/compute-runtime": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/edge-client": "workspace:*",
    "@dxos/edge-compute": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/mcp-client": "workspace:*",
    "@dxos/mcp-server": "workspace:*",
    "@dxos/plugin-assistant": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-connector": "workspace:*",
    "@dxos/plugin-projects": "workspace:*",
    "@dxos/protocols": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/util": "workspace:*",
    "@tauri-apps/api": "catalog:",
    "@tauri-apps/plugin-dialog": "catalog:",
    "@tauri-apps/plugin-shell": "catalog:",
    "effect": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@dxos/echo-client": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/plugin-tasks": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@effect/vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/ws": "catalog:",
    "react": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "react": "catalog:"
  }
}
