%% ECHO architecture — shared API layer, client tier (UI thread) and host tier (worker), and the RPC seam between them.
flowchart TB
  subgraph Shared [Shared API layer]
    EchoApi[Echo API and Types]
    Protocol[echo-protocol]
  end
  subgraph ClientTier [Client tier: UI thread]
    Database[DatabaseImpl proxies]
    QueryContext[Query context + cache]
    EchoClient[EchoClient hypergraph]
    RepoProxy[RepoProxy doc mirror]
  end
  subgraph HostTier [Host tier: worker]
    DataService[DataService RPC]
    QueryService[QueryService RPC]
    EchoHost[EchoHost]
    AutomergeHost[AutomergeHost Repo]
    IndexEngine[IndexEngine]
    FeedStore[FeedStore]
    Storage[SQLite storage]
    Replicators[Mesh and EDGE sync]
  end
  EchoApi --> Protocol
  Database --> EchoApi
  Database -->|db.query| QueryContext
  Database -->|doc mutations| RepoProxy
  EchoClient -->|constructs db| Database
  EchoClient -->|index source| QueryContext
  QueryContext -->|query stream| QueryService
  RepoProxy -->|doc subscribe| DataService
  DataService -->|doc sync| AutomergeHost
  QueryService -->|plan + execute| IndexEngine
  QueryService -->|load docs| AutomergeHost
  EchoHost -->|hosts| DataService
  EchoHost -->|hosts| QueryService
  EchoHost -->|owns| AutomergeHost
  EchoHost -->|owns| FeedStore
  AutomergeHost -->|doc data source| IndexEngine
  FeedStore -->|feed data source| IndexEngine
  AutomergeHost -->|storage adapter| Storage
  FeedStore --> Storage
  IndexEngine --> Storage
  AutomergeHost -->|subduction| Replicators
