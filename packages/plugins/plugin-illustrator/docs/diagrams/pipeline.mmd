%% @dxos/pipeline — generic back-pressured streaming pipeline (source → stages → sink).
flowchart TB
  subgraph Core [Pipeline core]
    Source[Stream source]
    StageMap[Stage.map]
    StageWindow[Stage.window]
    StageBuffer[Stage buffer]
    PipelineRun[Pipeline.run]
    Sink[Sink]
    AbortWith[Pipeline.abortWith]
  end
  subgraph Prog [Progress]
    TrackStage[Stage.track]
    ProgressSvc[Progress service]
    Reporter[ProgressReporter]
  end
  subgraph Testing [testing subpath]
    Instrument[instrument]
    Metrics[Metrics service]
    Benchmark[runBenchmark]
    CaptureSink[captureSink]
  end
  Source --> StageMap
  StageMap --> StageWindow
  StageWindow -->|overflow| StageBuffer
  StageBuffer --> TrackStage
  TrackStage --> PipelineRun
  PipelineRun -->|runForEach| Sink
  AbortWith -->|interrupt| PipelineRun
  TrackStage -->|advance / done / fail| ProgressSvc
  ProgressSvc -->|subscribe| Reporter
  StageMap -->|wrapped by| Instrument
  Instrument -->|in / out / ms| Metrics
  Benchmark -->|per variant| PipelineRun
  Metrics -->|snapshot| Benchmark
  CaptureSink -->|test impl| Sink
