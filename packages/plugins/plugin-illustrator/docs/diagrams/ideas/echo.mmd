%% ECHO write and read paths: one owner per store, client above host above storage, RPC seams at the host services.
flowchart TB
  subgraph Client [Client tier: app thread]
    ObjCore[ObjectCore]
    RepoProxy[RepoProxy]
    GraphCtx[GraphQueryContext]
    IndexSrc[IndexQuerySource]
  end
  subgraph Host [Host tier: worker]
    DataSvc[DataService]
    QuerySvc[QueryService]
    Executor[QueryExecutor]
    AmHost[AutomergeHost]
    IndexEngine[IndexEngine]
    FeedStore[FeedStore]
  end
  subgraph Infra [Storage and sync]
    Sqlite[SQLite]
    NetAdapter[EchoNetAdapter]
  end
  ObjCore -->|doc change| RepoProxy
  RepoProxy -->|update RPC| DataSvc
  DataSvc -->|merge| AmHost
  AmHost -->|owns doc chunks| Sqlite
  AmHost -->|replicate| NetAdapter
  GraphCtx -->|working set| ObjCore
  GraphCtx -->|remote hits| IndexSrc
  IndexSrc -->|execQuery RPC| QuerySvc
  QuerySvc -->|one per query| Executor
  Executor -->|lookup| IndexEngine
  Executor -->|loadDoc| AmHost
  IndexEngine -->|pull changes| AmHost
  IndexEngine -->|pull blocks| FeedStore
  IndexEngine -->|owns index| Sqlite
  FeedStore -->|owns blocks| Sqlite
