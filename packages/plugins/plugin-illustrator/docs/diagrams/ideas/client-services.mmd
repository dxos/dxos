%% Client services: proxies talk to one provider interface; both transports attach to the single RpcRouter.
flowchart TB
  subgraph app [App: @dxos/client]
    Halo[HaloProxy]
    Spaces[SpaceList]
    Provider[ServicesProvider]
  end
  subgraph transport [Transport]
    Local[LocalClientSvcs]
    Proxy[ClientSvcsProxy]
    Worker[WorkerRuntime]
  end
  subgraph host [Service stack]
    Router[RpcRouter]
    IdSvc[IdentityService]
    SpSvc[SpacesService]
  end
  IdMgr[IdentityManager]
  DsMgr[DataSpaceMgr]
  InvMgr[InvitationsMgr]
  Echo[EchoHost]
  Net[SwarmNetworkMgr]
  Halo -->|rpc| Provider
  Spaces -->|rpc| Provider
  Provider -->|host mode| Local
  Provider -->|worker mode| Proxy
  Local -->|in-process| Router
  Proxy -->|MessagePort| Worker
  Worker -->|attach| Router
  Router --> IdSvc
  Router --> SpSvc
  Router -->|invitations| InvMgr
  Router -->|data| Echo
  IdSvc --> IdMgr
  SpSvc --> DsMgr
  DsMgr --> Echo
  DsMgr --> InvMgr
  IdMgr -->|setEchoHost| Echo
  InvMgr --> Net
