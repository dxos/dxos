%% @dxos/app-framework — plugins contribute capabilities; dependency-driven activation; React surfaces.
flowchart TB
  subgraph Authoring [Authoring]
    Plugin[Plugin + modules]
    CapabilityTag[Capability tags]
    Contribution[Contribution]
    AppCapability[AppCapability makers]
  end
  subgraph Runtime [Runtime]
    PluginManager[PluginManager]
    Catalog[PluginCatalog]
    Scheduler[ActivationScheduler]
    ActivationGraph[ActivationGraph]
    ModuleLoader[ModuleLoader]
    CapabilityManager[CapabilityManager]
    ActivationEvent[Activation events]
    ProcessManager[ProcessManagerPlugin]
  end
  subgraph ReactLayer [React layer]
    UseApp[useApp / App]
    Surface[Surface]
  end
  AppCapability -->|module makers| Plugin
  CapabilityTag -->|requires / provides| Plugin
  Plugin -->|registered in| Catalog
  PluginManager -->|owns| Catalog
  PluginManager -->|start / activate| Scheduler
  PluginManager -->|owns| CapabilityManager
  Catalog -->|enabled modules| Scheduler
  ActivationEvent -->|activatesOn| Scheduler
  Scheduler -->|rounds and waves| ActivationGraph
  Scheduler -->|load module| ModuleLoader
  ModuleLoader -->|activate returns| Contribution
  Contribution -->|expand to entries| CapabilityManager
  CapabilityManager -->|OperationHandler| ProcessManager
  ProcessManager -->|OperationInvoker| CapabilityManager
  CapabilityManager -->|ReactSurface atom| Surface
  CapabilityManager -->|ReactContext / Root| UseApp
  UseApp -->|creates| PluginManager
  Surface -->|SurfacesRequested| ActivationEvent
