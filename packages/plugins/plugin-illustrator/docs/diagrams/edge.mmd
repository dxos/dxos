%% EDGE service architecture (dxos/edge) — the edge worker is the front door; storage and compute live in bound services.
flowchart LR
  Client[Client: Composer]
  subgraph EdgeWorker [edge worker]
    EdgeApi[edge Hono API]
    RouterDO[RouterObject DO]
  end
  subgraph DbService [db-service]
    Replicators[Replicator DOs]
    Indexer[Indexer DO]
    FeedSpace[FeedSpace queue DO]
    DoStorage[DO KV + SQLite]
  end
  subgraph ComputeService [compute-service]
    TriggersDO[TriggersDispatcher]
    FnRuntime[Function runtimes]
  end
  AiService[ai-service]
  IdentityAgent[Agent DO + D1]
  KmsSecrets[SpaceSecrets / KeyReg]
  HubAccounts[hub accounts D1]
  FnStores[R2 assets + D1 reg]
  Client -->|HTTPS + WS| EdgeApi
  EdgeApi -->|/ws upgrade| RouterDO
  EdgeApi -->|edgeAuth lookup| HubAccounts
  EdgeApi -->|/db, /spaces| Replicators
  EdgeApi -->|/identity| IdentityAgent
  EdgeApi -->|/kms, /oauth| KmsSecrets
  EdgeApi -->|/compute| FnRuntime
  EdgeApi -->|/ai| AiService
  RouterDO -->|sync frames| Replicators
  RouterDO -->|queue msgs| FeedSpace
  Replicators --> DoStorage
  Indexer --> DoStorage
  Replicators -->|docs changed| Indexer
  Indexer -->|objects changed| TriggersDO
  FeedSpace -->|items inserted| TriggersDO
  FeedSpace -->|DEK lookup| KmsSecrets
  Replicators -->|sign / admit| IdentityAgent
  TriggersDO -->|invoke| FnRuntime
  FnRuntime -->|deploy + load| FnStores
  FnRuntime -->|prompt| AiService
