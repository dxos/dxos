{
  "name": "@dxos/plugin-illustrator",
  "version": "0.11.1",
  "description": "Headless diagramming plugin for DXOS Composer (unifies canvas renderers like tldraw and excalidraw).",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#model": {
      "source": "./src/model/index.ts",
      "types": "./dist/types/src/model/index.d.ts",
      "default": "./dist/lib/model.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    },
    "#util": {
      "source": "./src/util/index.ts",
      "types": "./dist/types/src/util/index.d.ts",
      "default": "./dist/lib/util.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./model": {
      "source": "./src/model/index.ts",
      "types": "./dist/types/src/model/index.d.ts",
      "import": "./dist/lib/model.mjs"
    },
    "./skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "import": "./dist/lib/skills.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./package.json": "./package.json",
    "./Drawing": {
      "source": "./src/types/Drawing.ts",
      "types": "./dist/types/src/types/Drawing.d.ts",
      "import": "./dist/lib/Drawing.mjs"
    },
    "./DrawingOperation": {
      "source": "./src/types/DrawingOperation.ts",
      "types": "./dist/types/src/types/DrawingOperation.d.ts",
      "import": "./dist/lib/DrawingOperation.mjs"
    },
    "./IllustratorCapabilities": {
      "source": "./src/types/IllustratorCapabilities.ts",
      "types": "./dist/types/src/types/IllustratorCapabilities.d.ts",
      "import": "./dist/lib/IllustratorCapabilities.mjs"
    },
    "./IllustratorEvents": {
      "source": "./src/types/IllustratorEvents.ts",
      "types": "./dist/types/src/types/IllustratorEvents.d.ts",
      "import": "./dist/lib/IllustratorEvents.mjs"
    },
    "./IllustratorModel": {
      "source": "./src/model/index.ts",
      "types": "./dist/types/src/model/index.d.ts",
      "import": "./dist/lib/model.mjs"
    },
    "./IllustratorPlugin": {
      "source": "./src/IllustratorPlugin.ts",
      "types": "./dist/types/src/IllustratorPlugin.d.ts",
      "import": "./dist/lib/IllustratorPlugin.mjs"
    },
    "./LegacySketch": {
      "source": "./src/types/LegacySketch.ts",
      "types": "./dist/types/src/types/LegacySketch.d.ts",
      "import": "./dist/lib/LegacySketch.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Drawing": [
        "dist/types/src/types/Drawing.d.ts"
      ],
      "LegacySketch": [
        "dist/types/src/types/LegacySketch.d.ts"
      ],
      "DrawingOperation": [
        "dist/types/src/types/DrawingOperation.d.ts"
      ],
      "IllustratorCapabilities": [
        "dist/types/src/types/IllustratorCapabilities.d.ts"
      ],
      "IllustratorEvents": [
        "dist/types/src/types/IllustratorEvents.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dagrejs/dagre": "catalog:",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/react-ui-search": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/util": "workspace:*",
    "effect": "catalog:",
    "elkjs": "catalog:"
  },
  "devDependencies": {
    "@codemirror/language": "catalog:",
    "@dxos/echo-client": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/react-ui-editor": "workspace:*",
    "@dxos/ui-editor": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "codemirror-lang-mermaid": "catalog:",
    "mermaid": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
