{
  "$schema": "../../../node_modules/@dxos/app-framework/dxplugin.schema.json",
  "key": "org.dxos.plugin.markdown",
  "name": "Markdown",
  "author": "DXOS",
  "description": "A full-featured markdown editor for authoring documents in your space. Edits flow through a collaborative CodeMirror surface backed by ECHO Text, so every keystroke replicates to other peers in real time without merge conflicts or lost work.\n\nDocuments can be opened in source, preview, or read-only mode and rendered as a full-surface article or as embeddable cards. An optional formatting toolbar exposes headings, lists, links, and other common markdown actions, and dispositional toolbar actions contributed by other plugins are surfaced inline alongside it.\n\nThe editor integrates with the rest of the workspace through @ references that link to any ECHO object, image and file uploads stored in the active space, and anchored comment threads on text ranges. Comments can optionally be routed to an AI agent on every message or only on @mention.\n\nA built-in skill exposes create, open, and update operations as tools for AI agents. Updates are applied as compact find-and-replace diffs against the document, making it safe for agents to edit large documents incrementally while you continue collaborating.",
  "source": "https://github.com/dxos/dxos/tree/main/packages/plugins/plugin-markdown",
  "icon": {
    "key": "ph--text-aa--regular",
    "hue": "indigo",
  },
  "screenshots": [
    {
      "dark": "https://customer-5rxcjpyab08avpmn.cloudflarestream.com/cdf2656365bb1fd327c1fc2105d75e5a/iframe?poster=https%3A%2F%2Fcustomer-5rxcjpyab08avpmn.cloudflarestream.com%2Fcdf2656365bb1fd327c1fc2105d75e5a%2Fthumbnails%2Fthumbnail.jpg%3Ftime%3D%26height%3D600",
    },
    {
      "dark": "https://media.dxos.network/plugin-details-markdown-dark.png",
    },
  ],
  "tags": ["beta"],
  "version": "0.11.1",
  "modules": [
    {
      "id": "SkillDefinition",
      "src": "./src/capabilities/skill-definition.ts",
      "activatesOn": "org.dxos.plugin.assistant.event.start",
      "provides": ["org.dxos.app-framework.capability.skillDefinition"],
    },
    {
      "id": "CommentConfig",
      "platforms": ["browser"],
      "src": "./src/capabilities/comment-config.ts",
      "provides": ["org.dxos.app-framework.capability.commentConfig"],
    },
    {
      "id": "CreateObject",
      "platforms": ["browser", "node"],
      "src": "./src/capabilities/create-object.ts",
      "activatesOn": "org.dxos.plugin.space.event.createObjectRequested",
      "provides": ["org.dxos.plugin.space.capability.createObject"],
    },
    {
      "id": "OperationHandler",
      "src": "./src/capabilities/operation-handler.ts",
      "activatesOn": "org.dxos.app-framework.event.startup",
      "provides": ["org.dxos.app-framework.capability.operationHandler"],
    },
    {
      "id": "UndoMappings",
      "platforms": ["browser"],
      "src": "./src/capabilities/undo-mappings.ts",
      "provides": ["org.dxos.app-framework.capability.undoMapping"],
    },
    {
      "id": "schema",
      "src": "./src/capabilities/schema.ts",
      "provides": ["org.dxos.app-framework.capability.schema"],
    },
    {
      "id": "ReactSurface",
      "platforms": ["browser"],
      "src": "./src/capabilities/react-surface.ts",
      "activatesOn": {
        "oneOf": [
          {
            "id": "org.dxos.app-framework.event.surfacesRequested",
            "specifier": "org.dxos.role.article",
          },
          {
            "id": "org.dxos.app-framework.event.surfacesRequested",
            "specifier": "org.dxos.role.cardContent",
          },
          {
            "id": "org.dxos.app-framework.event.surfacesRequested",
            "specifier": "org.dxos.role.section",
          },
          {
            "id": "org.dxos.app-framework.event.surfacesRequested",
            "specifier": "org.dxos.role.tabpanel",
          },
        ],
      },
      "provides": ["org.dxos.app-framework.capability.reactSurface"],
    },
    {
      "id": "translations",
      "platforms": ["browser"],
      "src": "./src/capabilities/translations.ts",
      "provides": ["org.dxos.app-framework.capability.translations"],
    },
    {
      "id": "Settings",
      "platforms": ["browser"],
      "src": "./src/capabilities/settings.ts",
      "activatesOn": "org.dxos.app-framework.event.startup",
      "provides": [
        "org.dxos.app-framework.capability.settings",
        {
          "id": "org.dxos.plugin.markdown.capability.settings",
          "arity": "single",
        },
      ],
    },
    {
      "id": "MarkdownState",
      "platforms": ["browser"],
      "src": "./src/capabilities/state.ts",
      "requires": [
        {
          "id": "org.dxos.plugin.attention.capability.viewState",
          "arity": "single",
        },
      ],
      "provides": [
        {
          "id": "org.dxos.plugin.markdown.capability.editorState",
          "arity": "single",
        },
        {
          "id": "org.dxos.plugin.markdown.capability.editorViews",
          "arity": "single",
        },
      ],
    },
    {
      "id": "AnchorSort",
      "platforms": ["browser"],
      "src": "./src/capabilities/anchor-sort.ts",
      "requires": [
        {
          "id": "org.dxos.app-framework.capability.appGraph",
          "arity": "single",
        },
      ],
      "provides": ["org.dxos.app-framework.capability.anchorSort"],
    },
    {
      "id": "AnchorResolver",
      "platforms": ["browser"],
      "src": "./src/capabilities/anchor-resolver.ts",
      "requires": [
        {
          "id": "org.dxos.app-framework.capability.appGraph",
          "arity": "single",
        },
      ],
      "provides": ["org.dxos.app-framework.capability.anchorResolver"],
    },
  ],
}
