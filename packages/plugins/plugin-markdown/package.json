{
  "name": "@dxos/plugin-markdown",
  "version": "0.11.1",
  "description": "DXOS Surface plugin for interacting with Markdown",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#hooks": {
      "source": "./src/hooks/index.ts",
      "types": "./dist/types/src/hooks/index.d.ts",
      "default": "./dist/lib/hooks.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#testing": {
      "source": "./src/testing.ts",
      "types": "./dist/types/src/testing.d.ts",
      "default": "./dist/lib/testing.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/types/src/testing.d.ts",
      "import": "./dist/lib/testing.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./package.json": "./package.json",
    "./Markdown": {
      "source": "./src/types/Markdown.ts",
      "types": "./dist/types/src/types/Markdown.d.ts",
      "import": "./dist/lib/Markdown.mjs"
    },
    "./MarkdownCapabilities": {
      "source": "./src/types/MarkdownCapabilities.ts",
      "types": "./dist/types/src/types/MarkdownCapabilities.d.ts",
      "import": "./dist/lib/MarkdownCapabilities.mjs"
    },
    "./MarkdownEvents": {
      "source": "./src/types/MarkdownEvents.ts",
      "types": "./dist/types/src/types/MarkdownEvents.d.ts",
      "import": "./dist/lib/MarkdownEvents.mjs"
    },
    "./MarkdownOperation": {
      "source": "./src/types/MarkdownOperation.ts",
      "types": "./dist/types/src/types/MarkdownOperation.d.ts",
      "import": "./dist/lib/MarkdownOperation.mjs"
    },
    "./MarkdownPlugin": {
      "source": "./src/MarkdownPlugin.ts",
      "types": "./dist/types/src/MarkdownPlugin.d.ts",
      "import": "./dist/lib/MarkdownPlugin.mjs"
    },
    "./Settings": {
      "source": "./src/types/Settings.ts",
      "types": "./dist/types/src/types/Settings.d.ts",
      "import": "./dist/lib/Settings.mjs"
    },
    "./MarkdownOperationHandlerSet": {
      "source": "./src/operations/MarkdownOperationHandlerSet.ts",
      "types": "./dist/types/src/operations/MarkdownOperationHandlerSet.d.ts",
      "import": "./dist/lib/MarkdownOperationHandlerSet.mjs"
    },
    "./MarkdownSkill": {
      "source": "./src/skills/MarkdownSkill.ts",
      "types": "./dist/types/src/skills/MarkdownSkill.d.ts",
      "import": "./dist/lib/MarkdownSkill.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Markdown": [
        "dist/types/src/types/Markdown.d.ts"
      ],
      "MarkdownCapabilities": [
        "dist/types/src/types/MarkdownCapabilities.d.ts"
      ],
      "MarkdownEvents": [
        "dist/types/src/types/MarkdownEvents.d.ts"
      ],
      "MarkdownOperation": [
        "dist/types/src/types/MarkdownOperation.d.ts"
      ],
      "Settings": [
        "dist/types/src/types/Settings.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src"
  ],
  "dependencies": {
    "@automerge/automerge": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/assistant": "workspace:*",
    "@dxos/async": "workspace:*",
    "@dxos/client": "workspace:*",
    "@dxos/client-protocol": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-client": "workspace:*",
    "@dxos/echo-doc": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/halo": "workspace:*",
    "@dxos/halo-react": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-attention": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-graph": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-hooks": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/react-ui-components": "workspace:*",
    "@dxos/react-ui-dnd": "workspace:*",
    "@dxos/react-ui-editor": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/ui": "workspace:*",
    "@dxos/ui-editor": "workspace:*",
    "@dxos/util": "workspace:*",
    "@dxos/versioning": "workspace:*",
    "@effect/atom-react": "catalog:",
    "react-dropzone": "catalog:"
  },
  "devDependencies": {
    "@dxos/agent-runtime": "workspace:*",
    "@dxos/plugin-illustrator": "workspace:*",
    "@dxos/plugin-preview": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/plugin-tldraw": "workspace:*",
    "@dxos/random": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-mosaic": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
