{
  "name": "@dxos/plugin-meeting-recorder",
  "version": "0.15.0",
  "private": true,
  "description": "Detects meetings in other apps and records them into Meeting objects with live transcripts.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "tauri": "./src/capabilities/gen/tauri.ts",
        "browser": "./src/capabilities/gen/browser.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "tauri": "./dist/lib/capabilities.tauri.mjs",
      "browser": "./dist/lib/capabilities.browser.mjs"
    },
    "#bridge": {
      "source": "./src/bridge/index.ts",
      "types": "./dist/types/src/bridge/index.d.ts",
      "default": "./dist/lib/bridge.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.ts",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#recorder": {
      "source": "./src/recorder/index.ts",
      "types": "./dist/types/src/recorder/index.d.ts",
      "default": "./dist/lib/recorder.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./package.json": "./package.json",
    "./MeetingRecorderCapabilities": {
      "source": "./src/types/MeetingRecorderCapabilities.ts",
      "types": "./dist/types/src/types/MeetingRecorderCapabilities.d.ts",
      "import": "./dist/lib/MeetingRecorderCapabilities.mjs"
    },
    "./MeetingRecorderEvents": {
      "source": "./src/types/MeetingRecorderEvents.ts",
      "types": "./dist/types/src/types/MeetingRecorderEvents.d.ts",
      "import": "./dist/lib/MeetingRecorderEvents.mjs"
    },
    "./MeetingRecorderOperation": {
      "source": "./src/types/MeetingRecorderOperation.ts",
      "types": "./dist/types/src/types/MeetingRecorderOperation.d.ts",
      "import": "./dist/lib/MeetingRecorderOperation.mjs"
    },
    "./MeetingRecorderPlugin": {
      "source": "./src/MeetingRecorderPlugin.ts",
      "types": "./dist/types/src/MeetingRecorderPlugin.d.ts",
      "import": "./dist/lib/MeetingRecorderPlugin.mjs"
    },
    "./Settings": {
      "source": "./src/types/Settings.ts",
      "types": "./dist/types/src/types/Settings.d.ts",
      "import": "./dist/lib/Settings.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "MeetingRecorderCapabilities": [
        "dist/types/src/types/MeetingRecorderCapabilities.d.ts"
      ],
      "MeetingRecorderEvents": [
        "dist/types/src/types/MeetingRecorderEvents.d.ts"
      ],
      "MeetingRecorderOperation": [
        "dist/types/src/types/MeetingRecorderOperation.d.ts"
      ],
      "MeetingRecorderPlugin": [
        "dist/types/src/MeetingRecorderPlugin.d.ts"
      ],
      "Settings": [
        "dist/types/src/types/Settings.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/av": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-meeting": "workspace:*",
    "@dxos/plugin-status-bar": "workspace:*",
    "@dxos/plugin-transcription": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/util": "workspace:*",
    "@tauri-apps/api": "catalog:",
    "effect": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@dxos/plugin-testing": "workspace:*",
    "@types/react": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "effect": "catalog:",
    "react": "catalog:"
  }
}
