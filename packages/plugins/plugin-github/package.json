{
  "name": "@dxos/plugin-github",
  "version": "0.16.0",
  "description": "DXOS plugin that integrates GitHub as a sync source via the generic Integration mechanism.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/GitHubPlugin.workerd.mjs",
      "node": "./dist/lib/GitHubPlugin.node.mjs",
      "default": "./dist/lib/GitHubPlugin.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./Extensions": {
      "source": "./src/Extensions.ts",
      "types": "./dist/types/src/Extensions.d.ts",
      "import": "./dist/lib/ns/Extensions.mjs"
    },
    "./GitHubCapabilities": {
      "source": "./src/types/GitHubCapabilities.ts",
      "types": "./dist/types/src/types/GitHubCapabilities.d.ts",
      "import": "./dist/lib/GitHubCapabilities.mjs"
    },
    "./GitHubEvents": {
      "source": "./src/types/GitHubEvents.ts",
      "types": "./dist/types/src/types/GitHubEvents.d.ts",
      "import": "./dist/lib/GitHubEvents.mjs"
    },
    "./GitHubOperation": {
      "source": "./src/types/GitHubOperation.ts",
      "types": "./dist/types/src/types/GitHubOperation.d.ts",
      "import": "./dist/lib/GitHubOperation.mjs"
    },
    "./GitHubPlugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/GitHubPlugin.workerd.mjs",
      "node": "./dist/lib/GitHubPlugin.node.mjs",
      "import": "./dist/lib/GitHubPlugin.mjs"
    },
    "./package.json": "./package.json",
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "import": "./dist/lib/testing.mjs"
    },
    "./TextMerge": {
      "source": "./src/file-sync/TextMerge.ts",
      "types": "./dist/types/src/file-sync/TextMerge.d.ts",
      "import": "./dist/lib/TextMerge.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./Walkthrough": {
      "source": "./src/types/Walkthrough.ts",
      "types": "./dist/types/src/types/Walkthrough.d.ts",
      "import": "./dist/lib/Walkthrough.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "GitHubEvents": [
        "dist/types/src/types/GitHubEvents.d.ts"
      ],
      "GitHubOperation": [
        "dist/types/src/types/GitHubOperation.d.ts"
      ],
      "GitHubCapabilities": [
        "dist/types/src/types/GitHubCapabilities.d.ts"
      ],
      "Walkthrough": [
        "dist/types/src/types/Walkthrough.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@automerge/automerge": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@dxos/ai": "workspace:*",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-doc": "workspace:*",
    "@dxos/echo-query": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/graph": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/lit-ui": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-connector": "workspace:*",
    "@dxos/plugin-crx": "workspace:*",
    "@dxos/plugin-markdown": "workspace:*",
    "@dxos/plugin-preview": "workspace:*",
    "@dxos/plugin-search": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/protocols": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/react-ui-components": "workspace:*",
    "@dxos/react-ui-editor": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/react-ui-list": "workspace:*",
    "@dxos/react-ui-markdown": "workspace:*",
    "@dxos/react-ui-masonry": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/react-ui-query": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/ui-editor": "workspace:*",
    "@dxos/ui-types": "workspace:*",
    "@dxos/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@dxos/echo-client": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/random": "workspace:*",
    "@dxos/react-ui-editor": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@effect/atom-react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
