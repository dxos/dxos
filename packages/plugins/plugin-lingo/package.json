      "source": "./src/types/Vocabulary.ts",
      "types": "./dist/types/src/types/Vocabulary.d.ts",
      "import": "./dist/lib/Vocabulary.mjs"
    },
    "./Word": {
      "source": "./src/types/Word.ts",
      "types": "./dist/types/src/types/Word.d.ts",
      "import": "./dist/lib/Word.mjs"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/types/src/testing.d.ts",
      "import": "./dist/lib/testing.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "import": "./dist/lib/types.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Language": [
        "dist/types/src/types/Language.d.ts"
      ],
      "LingoCapabilities": [
        "dist/types/src/types/LingoCapabilities.d.ts"
      ],
      "LingoEvents": [
        "dist/types/src/types/LingoEvents.d.ts"
      ],
      "LingoOperation": [
        "dist/types/src/types/LingoOperation.d.ts"
      ],
      "LingoSettings": [
        "dist/types/src/types/LingoSettings.d.ts"
      ],
      "Vocabulary": [
        "dist/types/src/types/Vocabulary.d.ts"
      ],
      "Word": [
        "dist/types/src/types/Word.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src"
  ],
  "dependencies": {
    "@codemirror/language": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@dxos/ai": "workspace:*",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/assistant": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/nlp": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-markdown": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/react-ui-editor": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/ui": "workspace:*",
    "@dxos/ui-editor": "workspace:*",
    "@dxos/util": "workspace:*",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
