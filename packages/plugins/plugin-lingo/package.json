      "source": "./src/types/Analysis.ts",
      "types": "./dist/types/src/types/Analysis.d.ts",
      "import": "./dist/lib/Analysis.mjs"
    },
    "./Language": {
      "source": "./src/types/Language.ts",
      "types": "./dist/types/src/types/Language.d.ts",
      "import": "./dist/lib/Language.mjs"
    },
    "./LingoCapabilities": {
      "source": "./src/types/LingoCapabilities.ts",
      "types": "./dist/types/src/types/LingoCapabilities.d.ts",
      "import": "./dist/lib/LingoCapabilities.mjs"
    },
    "./LingoEvents": {
      "source": "./src/types/LingoEvents.ts",
      "types": "./dist/types/src/types/LingoEvents.d.ts",
      "import": "./dist/lib/LingoEvents.mjs"
