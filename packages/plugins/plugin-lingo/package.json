    "./LingoPlugin": {
      "source": "./src/LingoPlugin.ts",
      "types": "./dist/types/src/LingoPlugin.d.ts",
      "import": "./dist/lib/LingoPlugin.mjs"
    },
    "./LingoSettings": {
      "source": "./src/types/LingoSettings.ts",
      "types": "./dist/types/src/types/LingoSettings.d.ts",
      "import": "./dist/lib/LingoSettings.mjs"
