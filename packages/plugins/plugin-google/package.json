{
  "name": "@dxos/plugin-google",
  "version": "0.12.0",
  "description": "DXOS plugin that syncs Gmail, Google Calendar and Google Contacts into the workspace.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#apis": {
      "source": "./src/apis/index.ts",
      "types": "./dist/types/src/apis/index.d.ts",
      "default": "./dist/lib/apis.mjs"
    },
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.ts",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#services": {
      "source": "./src/services/index.ts",
      "types": "./dist/types/src/services/index.d.ts",
      "default": "./dist/lib/services.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./testing": {
      "source": {
        "node": "./src/testing/node.ts",
        "default": "./src/testing/index.ts"
      },
      "types": "./dist/types/src/testing/index.d.ts",
      "node": "./dist/lib/testing/node.mjs",
      "default": "./dist/lib/testing.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./GooglePlugin": {
      "source": "./src/GooglePlugin.ts",
      "types": "./dist/types/src/GooglePlugin.d.ts",
      "import": "./dist/lib/GooglePlugin.mjs"
    },
    "./GoogleOperationHandlerSet": {
      "source": "./src/operations/GoogleOperationHandlerSet.ts",
      "types": "./dist/types/src/operations/GoogleOperationHandlerSet.d.ts",
      "import": "./dist/lib/GoogleOperationHandlerSet.mjs"
    },
    "./GoogleOperation": {
      "source": "./src/types/GoogleOperation.ts",
      "types": "./dist/types/src/types/GoogleOperation.d.ts",
      "import": "./dist/lib/GoogleOperation.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "files": [
    "dist",
    "dx.config.ts",
    "src"
  ],
  "scripts": {
    "import-mbox": "vite-node ./scripts/import-mbox-space.ts --"
  },
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/async": "workspace:*",
    "@dxos/client": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/compute-runtime": "workspace:*",
    "@dxos/config": "workspace:*",
    "@dxos/context": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/extractor": "workspace:*",
    "@dxos/extractor-lib": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/markdown": "workspace:*",
    "@dxos/pipeline": "workspace:*",
    "@dxos/pipeline-email": "workspace:*",
    "@dxos/plugin-connector": "workspace:*",
    "@dxos/plugin-inbox": "workspace:*",
    "@dxos/protocols": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/util": "workspace:*",
    "date-fns": "catalog:"
  },
  "devDependencies": {
    "@dxos/echo-client": "workspace:*",
    "@dxos/edge-compute": "workspace:*",
    "@dxos/random": "workspace:*",
    "@effect/opentelemetry": "catalog:",
    "@effect/vitest": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "@types/mailparser": "catalog:",
    "effect": "catalog:",
    "mailparser": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
