{
  "name": "@dxos/plugin-sequencer",
  "version": "0.11.1",
  "private": true,
  "description": "Music sequencer plugin (Score / Track / Sequence / Note) with a canvas-based step grid.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./package.json": "./package.json",
    "./Note": {
      "source": "./src/types/Note.ts",
      "types": "./dist/types/src/types/Note.d.ts",
      "import": "./dist/lib/Note.mjs"
    },
    "./Patch": {
      "source": "./src/types/Patch.ts",
      "types": "./dist/types/src/types/Patch.d.ts",
      "import": "./dist/lib/Patch.mjs"
    },
    "./Score": {
      "source": "./src/types/Score.ts",
      "types": "./dist/types/src/types/Score.d.ts",
      "import": "./dist/lib/Score.mjs"
    },
    "./ScoreOperation": {
      "source": "./src/types/ScoreOperation.ts",
      "types": "./dist/types/src/types/ScoreOperation.d.ts",
      "import": "./dist/lib/ScoreOperation.mjs"
    },
    "./Sequence": {
      "source": "./src/types/Sequence.ts",
      "types": "./dist/types/src/types/Sequence.d.ts",
      "import": "./dist/lib/Sequence.mjs"
    },
    "./SequencerEvents": {
      "source": "./src/types/SequencerEvents.ts",
      "types": "./dist/types/src/types/SequencerEvents.d.ts",
      "import": "./dist/lib/SequencerEvents.mjs"
    },
    "./SequencerPlugin": {
      "source": "./src/SequencerPlugin.ts",
      "types": "./dist/types/src/SequencerPlugin.d.ts",
      "import": "./dist/lib/SequencerPlugin.mjs"
    },
    "./Track": {
      "source": "./src/types/Track.ts",
      "types": "./dist/types/src/types/Track.d.ts",
      "import": "./dist/lib/Track.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Score": [
        "dist/types/src/types/Score.d.ts"
      ],
      "ScoreOperation": [
        "dist/types/src/types/ScoreOperation.d.ts"
      ],
      "Sequence": [
        "dist/types/src/types/Sequence.d.ts"
      ],
      "SequencerEvents": [
        "dist/types/src/types/SequencerEvents.d.ts"
      ],
      "Track": [
        "dist/types/src/types/Track.d.ts"
      ],
      "Note": [
        "dist/types/src/types/Note.d.ts"
      ],
      "Patch": [
        "dist/types/src/types/Patch.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/react-ui-audio": "workspace:*",
    "@dxos/react-ui-canvas": "workspace:*",
    "@dxos/react-ui-list": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/ui-types": "workspace:*",
    "@dxos/util": "workspace:*",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:",
    "react-resize-detector": "catalog:",
    "tone": "catalog:"
  },
  "devDependencies": {
    "@dxos/react-client": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
