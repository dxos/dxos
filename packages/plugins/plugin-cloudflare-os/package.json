{
  "name": "@dxos/plugin-cloudflare-os",
  "version": "0.17.0",
  "private": true,
  "description": "Cloudflare OS workspaces, gadgets and agent in Composer.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#api": {
      "source": "./src/api/index.ts",
      "types": "./dist/types/src/api/index.d.ts",
      "default": "./dist/lib/api.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "default": "./dist/lib/CloudflareOsPlugin.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./CloudflareOs": {
      "source": "./src/types/CloudflareOs.ts",
      "types": "./dist/types/src/types/CloudflareOs.d.ts",
      "import": "./dist/lib/CloudflareOs.mjs"
    },
    "./CloudflareOsOperation": {
      "source": "./src/types/CloudflareOsOperation.ts",
      "types": "./dist/types/src/types/CloudflareOsOperation.d.ts",
      "import": "./dist/lib/CloudflareOsOperation.mjs"
    },
    "./CloudflareOsOperationHandlerSet": {
      "source": "./src/operations/CloudflareOsOperationHandlerSet.ts",
      "types": "./dist/types/src/operations/CloudflareOsOperationHandlerSet.d.ts",
      "import": "./dist/lib/CloudflareOsOperationHandlerSet.mjs"
    },
    "./CloudflareOsPlugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "import": "./dist/lib/CloudflareOsPlugin.mjs"
    },
    "./package.json": "./package.json",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "CloudflareOs": [
        "dist/types/src/types/CloudflareOs.d.ts"
      ],
      "CloudflareOsOperation": [
        "dist/types/src/types/CloudflareOsOperation.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/agent-runtime": "workspace:*",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/assistant": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-assistant": "workspace:*",
    "@dxos/plugin-connector": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/util": "workspace:*",
    "capnweb": "catalog:",
    "effect": "catalog:",
    "hash-wasm": "catalog:"
  },
  "devDependencies": {
    "@dxos/effect": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
