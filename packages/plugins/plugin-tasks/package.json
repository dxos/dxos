{
  "name": "@dxos/plugin-tasks",
  "version": "0.11.1",
  "description": "Task surface: markdown outlines and durable tasks",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./package.json": "./package.json",
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./Journal": {
      "source": "./src/types/Journal.ts",
      "types": "./dist/types/src/types/Journal.d.ts",
      "import": "./dist/lib/Journal.mjs"
    },
    "./OutlineOperation": {
      "source": "./src/types/OutlineOperation.ts",
      "types": "./dist/types/src/types/OutlineOperation.d.ts",
      "import": "./dist/lib/OutlineOperation.mjs"
    },
    "./TaskOperation": {
      "source": "./src/types/TaskOperation.ts",
      "types": "./dist/types/src/types/TaskOperation.d.ts",
      "import": "./dist/lib/TaskOperation.mjs"
    },
    "./TasksCapabilities": {
      "source": "./src/types/TasksCapabilities.ts",
      "types": "./dist/types/src/types/TasksCapabilities.d.ts",
      "import": "./dist/lib/TasksCapabilities.mjs"
    },
    "./TasksEvents": {
      "source": "./src/types/TasksEvents.ts",
      "types": "./dist/types/src/types/TasksEvents.d.ts",
      "import": "./dist/lib/TasksEvents.mjs"
    },
    "./TasksPlugin": {
      "source": "./src/TasksPlugin.ts",
      "types": "./dist/types/src/TasksPlugin.d.ts",
      "import": "./dist/lib/TasksPlugin.mjs"
    },
    "./TasksUtil": {
      "source": "./src/types/TasksUtil.ts",
      "types": "./dist/types/src/types/TasksUtil.d.ts",
      "import": "./dist/lib/TasksUtil.mjs"
    },
    "./TasksOperationHandlerSet": {
      "source": "./src/operations/TasksOperationHandlerSet.ts",
      "types": "./dist/types/src/operations/TasksOperationHandlerSet.d.ts",
      "import": "./dist/lib/TasksOperationHandlerSet.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Journal": [
        "dist/types/src/types/Journal.d.ts"
      ],
      "OutlineOperation": [
        "dist/types/src/types/OutlineOperation.d.ts"
      ],
      "TaskOperation": [
        "dist/types/src/types/TaskOperation.d.ts"
      ],
      "TasksEvents": [
        "dist/types/src/types/TasksEvents.d.ts"
      ],
      "TasksUtil": [
        "dist/types/src/types/TasksUtil.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-client": "workspace:*",
    "@dxos/echo-doc": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/graph": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-markdown": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-hooks": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/react-ui-calendar": "workspace:*",
    "@dxos/react-ui-editor": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/react-ui-task": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/ui-editor": "workspace:*",
    "@dxos/util": "workspace:*",
    "date-fns": "catalog:"
  },
  "devDependencies": {
    "@dxos/invariant": "workspace:*",
    "@dxos/plugin-github": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
