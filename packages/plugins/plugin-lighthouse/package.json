{
  "name": "@dxos/plugin-lighthouse",
  "version": "0.16.0",
  "private": true,
  "description": "Lighthouse web research plugin.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "MIT",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "tauri": "./src/capabilities/gen/tauri.ts",
        "browser": "./src/capabilities/gen/browser.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "tauri": "./dist/lib/capabilities.tauri.mjs",
      "browser": "./dist/lib/capabilities.browser.mjs"
    },
    "#client": {
      "source": "./src/client/index.ts",
      "types": "./dist/types/src/client/index.d.ts",
      "default": "./dist/lib/client.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#hooks": {
      "source": "./src/hooks/index.ts",
      "types": "./dist/types/src/hooks/index.d.ts",
      "default": "./dist/lib/hooks.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#model": {
      "source": "./src/model/index.ts",
      "types": "./dist/types/src/model/index.d.ts",
      "default": "./dist/lib/model.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./Finding": {
      "source": "./src/types/Finding.ts",
      "types": "./dist/types/src/types/Finding.d.ts",
      "import": "./dist/lib/Finding.mjs"
    },
    "./LighthouseCapabilities": {
      "source": "./src/types/LighthouseCapabilities.ts",
      "types": "./dist/types/src/types/LighthouseCapabilities.d.ts",
      "import": "./dist/lib/LighthouseCapabilities.mjs"
    },
    "./LighthouseOperation": {
      "source": "./src/types/LighthouseOperation.ts",
      "types": "./dist/types/src/types/LighthouseOperation.d.ts",
      "import": "./dist/lib/LighthouseOperation.mjs"
    },
    "./LighthousePlugin": {
      "source": "./src/LighthousePlugin.ts",
      "types": "./dist/types/src/LighthousePlugin.d.ts",
      "import": "./dist/lib/LighthousePlugin.mjs"
    },
    "./package.json": "./package.json",
    "./Research": {
      "source": "./src/types/Research.ts",
      "types": "./dist/types/src/types/Research.d.ts",
      "import": "./dist/lib/Research.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Finding": [
        "dist/types/src/types/Finding.d.ts"
      ],
      "LighthouseCapabilities": [
        "dist/types/src/types/LighthouseCapabilities.d.ts"
      ],
      "LighthouseOperation": [
        "dist/types/src/types/LighthouseOperation.d.ts"
      ],
      "LighthousePlugin": [
        "dist/types/src/LighthousePlugin.d.ts"
      ],
      "Research": [
        "dist/types/src/types/Research.d.ts"
      ],
      "translations": [
        "dist/types/src/translations.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-attention": "workspace:*",
    "@dxos/plugin-connector": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-assistant": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/react-ui-components": "workspace:*",
    "@dxos/react-ui-feed": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/react-ui-geo": "workspace:*",
    "@dxos/react-ui-masonry": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/ui-editor": "workspace:*",
    "@dxos/util": "workspace:*",
    "effect": "catalog:",
    "leaflet": "catalog:",
    "react": "catalog:",
    "react-leaflet": "catalog:"
  },
  "devDependencies": {
    "@dxos/client": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/leaflet": "catalog:",
    "@types/react": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
