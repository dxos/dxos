{
  "name": "@dxos/plugin-file",
  "version": "0.16.0",
  "description": "Inline file (image / PDF) storage plugin for DXOS",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "imports": {
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/FilePlugin.workerd.mjs",
      "node": "./dist/lib/FilePlugin.node.mjs",
      "default": "./dist/lib/FilePlugin.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./FileCapabilities": {
      "source": "./src/types/FileCapabilities.ts",
      "types": "./dist/types/src/types/FileCapabilities.d.ts",
      "import": "./dist/lib/FileCapabilities.mjs"
    },
    "./FileEvents": {
      "source": "./src/types/FileEvents.ts",
      "types": "./dist/types/src/types/FileEvents.d.ts",
      "import": "./dist/lib/FileEvents.mjs"
    },
    "./FileLimits": {
      "source": "./src/types/FileLimits.ts",
      "types": "./dist/types/src/types/FileLimits.d.ts",
      "import": "./dist/lib/FileLimits.mjs"
    },
    "./FileOperation": {
      "source": "./src/types/FileOperation.ts",
      "types": "./dist/types/src/types/FileOperation.d.ts",
      "import": "./dist/lib/FileOperation.mjs"
    },
    "./FilePlugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/FilePlugin.workerd.mjs",
      "node": "./dist/lib/FilePlugin.node.mjs",
      "import": "./dist/lib/FilePlugin.mjs"
    },
    "./FileSkill": {
      "source": "./src/skills/FileSkill.ts",
      "types": "./dist/types/src/skills/FileSkill.d.ts",
      "import": "./dist/lib/FileSkill.mjs"
    },
    "./package.json": "./package.json",
    "./Settings": {
      "source": "./src/types/Settings.ts",
      "types": "./dist/types/src/types/Settings.d.ts",
      "import": "./dist/lib/Settings.mjs"
    },
    "./StagedUpload": {
      "source": "./src/StagedUpload.ts",
      "types": "./dist/types/src/StagedUpload.d.ts",
      "import": "./dist/lib/StagedUpload.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "FileCapabilities": [
        "dist/types/src/types/FileCapabilities.d.ts"
      ],
      "FileEvents": [
        "dist/types/src/types/FileEvents.d.ts"
      ],
      "FileLimits": [
        "dist/types/src/types/FileLimits.d.ts"
      ],
      "FileOperation": [
        "dist/types/src/types/FileOperation.d.ts"
      ],
      "Settings": [
        "dist/types/src/types/Settings.d.ts"
      ],
      "StagedUpload": [
        "dist/types/src/StagedUpload.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@codemirror/language": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/blob": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-markdown": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-focus": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/ui-editor": "workspace:*",
    "@dxos/util": "workspace:*",
    "effect": "catalog:",
    "pdfjs-dist": "catalog:",
    "react-dropzone": "catalog:"
  },
  "devDependencies": {
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
