{
  "name": "@dxos/plugin-lametric",
  "version": "0.12.0",
  "private": true,
  "description": "Show a space on a LaMetric TIME — progress while a task runs, statistics otherwise.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.ts",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#protocol": {
      "source": "./src/protocol/LaMetric.ts",
      "types": "./dist/types/src/protocol/LaMetric.d.ts",
      "default": "./dist/lib/LaMetric.mjs"
    },
    "#render": {
      "source": "./src/render/index.ts",
      "types": "./dist/types/src/render/index.d.ts",
      "default": "./dist/lib/render.mjs"
    },
    "#transport": {
      "source": "./src/transport/index.ts",
      "types": "./dist/types/src/transport/index.d.ts",
      "default": "./dist/lib/transport.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./LaMetricPlugin": {
      "source": "./src/LaMetricPlugin.ts",
      "types": "./dist/types/src/LaMetricPlugin.d.ts",
      "import": "./dist/lib/LaMetricPlugin.mjs"
    },
    "./package.json": "./package.json",
    "./types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "import": "./dist/lib/types.mjs"
    },
    "./LaMetricCapabilities": {
      "source": "./src/types/LaMetricCapabilities.ts",
      "types": "./dist/types/src/types/LaMetricCapabilities.d.ts",
      "import": "./dist/lib/LaMetricCapabilities.mjs"
    },
    "./LaMetric": {
      "source": "./src/protocol/LaMetric.ts",
      "types": "./dist/types/src/protocol/LaMetric.d.ts",
      "import": "./dist/lib/LaMetric.mjs"
    },
    "./Settings": {
      "source": "./src/types/Settings.ts",
      "types": "./dist/types/src/types/Settings.d.ts",
      "import": "./dist/lib/types/Settings.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl"
  },
  "types": "dist/types/src/index.d.ts",
  "files": [
    "PLUGIN.mdl",
    "dist",
    "dx.config.ts",
    "src"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@tauri-apps/plugin-http": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
