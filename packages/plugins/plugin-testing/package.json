{
  "name": "@dxos/plugin-testing",
  "version": "0.17.0",
  "description": "Plugin testing utils",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/StorybookPlugin.workerd.mjs",
      "node": "./dist/lib/StorybookPlugin.node.mjs",
      "default": "./dist/lib/StorybookPlugin.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./CorePlugins": {
      "source": "./src/CorePlugins.ts",
      "types": "./dist/types/src/CorePlugins.d.ts",
      "import": "./dist/lib/ns/CorePlugins.mjs"
    },
    "./Corpus": {
      "source": "./src/Corpus.ts",
      "types": "./dist/types/src/Corpus.d.ts",
      "import": "./dist/lib/ns/Corpus.mjs"
    },
    "./Harness": {
      "source": "./src/Harness.ts",
      "types": "./dist/types/src/Harness.d.ts",
      "import": "./dist/lib/harness.mjs"
    },
    "./package.json": "./package.json",
    "./StorybookCapabilities": {
      "source": "./src/types/StorybookCapabilities.ts",
      "types": "./dist/types/src/types/StorybookCapabilities.d.ts",
      "import": "./dist/lib/StorybookCapabilities.mjs"
    },
    "./StorybookPlugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/StorybookPlugin.workerd.mjs",
      "node": "./dist/lib/StorybookPlugin.node.mjs",
      "import": "./dist/lib/StorybookPlugin.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "StorybookCapabilities": [
        "dist/types/src/types/StorybookCapabilities.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-attention": "workspace:*",
    "@dxos/plugin-graph": "workspace:*",
    "@dxos/plugin-settings": "workspace:*",
    "@dxos/plugin-theme": "workspace:*",
    "@dxos/react-ui-dnd": "workspace:*",
    "@dxos/util": "workspace:*",
    "@effect/atom-react": "catalog:"
  },
  "devDependencies": {
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
