{
  "name": "@dxos/plugin-studio",
  "version": "0.12.0",
  "private": true,
  "description": "Image-creation plugin for Composer.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.tsx",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#surfaces": {
      "source": "./src/surfaces.ts",
      "types": "./dist/types/src/surfaces.d.ts",
      "default": "./dist/lib/surfaces.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./surfaces": {
      "source": "./src/surfaces.ts",
      "types": "./dist/types/src/surfaces.d.ts",
      "import": "./dist/lib/surfaces.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    },
    "./package.json": "./package.json",
    "./Artifact": {
      "source": "./src/types/Artifact.ts",
      "types": "./dist/types/src/types/Artifact.d.ts",
      "import": "./dist/lib/Artifact.mjs"
    },
    "./Generation": {
      "source": "./src/types/Generation.ts",
      "types": "./dist/types/src/types/Generation.d.ts",
      "import": "./dist/lib/Generation.mjs"
    },
    "./GenerationService": {
      "source": "./src/types/GenerationService.ts",
      "types": "./dist/types/src/types/GenerationService.d.ts",
      "import": "./dist/lib/GenerationService.mjs"
    },
    "./Lightbox": {
      "source": "./src/types/Lightbox.ts",
      "types": "./dist/types/src/types/Lightbox.d.ts",
      "import": "./dist/lib/Lightbox.mjs"
    },
    "./StudioCapabilities": {
      "source": "./src/types/StudioCapabilities.ts",
      "types": "./dist/types/src/types/StudioCapabilities.d.ts",
      "import": "./dist/lib/StudioCapabilities.mjs"
    },
    "./StudioEvents": {
      "source": "./src/types/StudioEvents.ts",
      "types": "./dist/types/src/types/StudioEvents.d.ts",
      "import": "./dist/lib/StudioEvents.mjs"
    },
    "./StudioOperation": {
      "source": "./src/types/StudioOperation.ts",
      "types": "./dist/types/src/types/StudioOperation.d.ts",
      "import": "./dist/lib/StudioOperation.mjs"
    },
    "./StudioPlugin": {
      "source": "./src/StudioPlugin.ts",
      "types": "./dist/types/src/StudioPlugin.d.ts",
      "import": "./dist/lib/StudioPlugin.mjs"
    },
    "./Variant": {
      "source": "./src/types/Variant.ts",
      "types": "./dist/types/src/types/Variant.d.ts",
      "import": "./dist/lib/Variant.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "Artifact": [
        "dist/types/src/types/Artifact.d.ts"
      ],
      "Generation": [
        "dist/types/src/types/Generation.d.ts"
      ],
      "GenerationService": [
        "dist/types/src/types/GenerationService.d.ts"
      ],
      "Lightbox": [
        "dist/types/src/types/Lightbox.d.ts"
      ],
      "StudioCapabilities": [
        "dist/types/src/types/StudioCapabilities.d.ts"
      ],
      "StudioEvents": [
        "dist/types/src/types/StudioEvents.d.ts"
      ],
      "StudioOperation": [
        "dist/types/src/types/StudioOperation.d.ts"
      ],
      "Variant": [
        "dist/types/src/types/Variant.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "src",
    "PLUGIN.mdl"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/client": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-connector": "workspace:*",
    "@dxos/plugin-graph": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/react-ui-board": "workspace:*",
    "@dxos/react-ui-form": "workspace:*",
    "@dxos/react-ui-list": "workspace:*",
    "@dxos/react-ui-masonry": "workspace:*",
    "@dxos/react-ui-menu": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@dxos/util": "workspace:*",
    "@effect/atom-react": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@dxos/compute-runtime": "workspace:*",
    "@dxos/echo-client": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-preview": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
