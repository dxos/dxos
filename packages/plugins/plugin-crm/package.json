{
  "name": "@dxos/plugin-crm",
  "version": "0.11.1",
  "private": true,
  "description": "CRM plugin for Composer. Provides a skill for researching people and organizations and producing structured Profile documents.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": true,
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": {
        "workerd": "./src/capabilities/gen/workerd.ts",
        "node": "./src/capabilities/gen/node.ts",
        "default": "./src/capabilities/index.ts"
      },
      "types": "./dist/types/src/capabilities/index.d.ts",
      "workerd": "./dist/lib/capabilities.workerd.mjs",
      "node": "./dist/lib/capabilities.node.mjs",
      "default": "./dist/lib/capabilities.mjs"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations.mjs"
    },
    "#plugin": {
      "source": "./src/plugin.ts",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.mjs"
    },
    "#skills": {
      "source": "./src/skills/index.ts",
      "types": "./dist/types/src/skills/index.d.ts",
      "default": "./dist/lib/skills.mjs"
    },
    "#sources": {
      "source": "./src/sources/index.ts",
      "types": "./dist/types/src/sources/index.d.ts",
      "default": "./dist/lib/sources.mjs"
    },
    "#testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "default": "./dist/lib/testing.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/types/src/testing/index.d.ts",
      "import": "./dist/lib/testing.mjs"
    },
    "./package.json": "./package.json",
    "./CrmEvents": {
      "source": "./src/types/CrmEvents.ts",
      "types": "./dist/types/src/types/CrmEvents.d.ts",
      "import": "./dist/lib/CrmEvents.mjs"
    },
    "./CrmOperation": {
      "source": "./src/types/CrmOperation.ts",
      "types": "./dist/types/src/types/CrmOperation.d.ts",
      "import": "./dist/lib/CrmOperation.mjs"
    },
    "./CrmPlugin": {
      "source": "./src/CrmPlugin.ts",
      "types": "./dist/types/src/CrmPlugin.d.ts",
      "import": "./dist/lib/CrmPlugin.mjs"
    },
    "./ProfileOf": {
      "source": "./src/types/ProfileOf.ts",
      "types": "./dist/types/src/types/ProfileOf.d.ts",
      "import": "./dist/lib/ProfileOf.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "CrmEvents": [
        "dist/types/src/types/CrmEvents.d.ts"
      ],
      "CrmOperation": [
        "dist/types/src/types/CrmOperation.d.ts"
      ],
      "ProfileOf": [
        "dist/types/src/types/ProfileOf.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "dx.config.ts",
    "scripts",
    "src",
    "PLUGIN.mdl"
  ],
  "scripts": {
    "build-sample": "vite-node ./scripts/build-sample-space.ts"
  },
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/assistant-toolkit": "workspace:*",
    "@dxos/compute": "workspace:*",
    "@dxos/config": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/edge-client": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/errors": "workspace:*",
    "@dxos/extractor": "workspace:*",
    "@dxos/extractor-lib": "workspace:*",
    "@dxos/invariant": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/link": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/pipeline": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-inbox": "workspace:*",
    "@dxos/plugin-markdown": "workspace:*",
    "@dxos/plugin-projects": "workspace:*",
    "@dxos/plugin-routine": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/schema": "workspace:*",
    "@dxos/types": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@dxos/util": "workspace:*",
    "effect": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@dxos/agent-runtime": "workspace:*",
    "@dxos/assistant": "workspace:*",
    "@dxos/echo-client": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/effect": "workspace:*",
    "@dxos/keys": "workspace:*",
    "@dxos/plugin-testing": "workspace:*",
    "@effect/vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
