{
  "name": "@dxos/plugin-stream-deck",
  "version": "0.17.0",
  "private": true,
  "description": "Project a space onto Stream Deck hardware — favorites on keys, progress and stats on dials.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "DXOS.org",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#bridge": {
      "source": "./src/bridge/index.ts",
      "types": "./dist/types/src/bridge/index.d.ts",
      "default": "./dist/lib/bridge.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers.mjs"
    },
    "#meta": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/StreamDeckPlugin.workerd.mjs",
      "node": "./dist/lib/StreamDeckPlugin.node.mjs",
      "default": "./dist/lib/StreamDeckPlugin.mjs"
    },
    "#protocol": {
      "source": "./src/protocol/Protocol.ts",
      "types": "./dist/types/src/protocol/Protocol.d.ts",
      "default": "./dist/lib/Protocol.mjs"
    },
    "#render": {
      "source": "./src/render/index.ts",
      "types": "./dist/types/src/render/index.d.ts",
      "default": "./dist/lib/render.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./package.json": "./package.json",
    "./Protocol": {
      "source": "./src/protocol/Protocol.ts",
      "types": "./dist/types/src/protocol/Protocol.d.ts",
      "import": "./dist/lib/Protocol.mjs"
    },
    "./StreamDeckCapabilities": {
      "source": "./src/types/StreamDeckCapabilities.ts",
      "types": "./dist/types/src/types/StreamDeckCapabilities.d.ts",
      "import": "./dist/lib/StreamDeckCapabilities.mjs"
    },
    "./StreamDeckPlugin": {
      "source": "./dx.config.ts",
      "types": "./dist/types/dx.config.d.ts",
      "workerd": "./dist/lib/StreamDeckPlugin.workerd.mjs",
      "node": "./dist/lib/StreamDeckPlugin.node.mjs",
      "import": "./dist/lib/StreamDeckPlugin.mjs"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "import": "./dist/lib/translations.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "files": [
    "PLUGIN.mdl",
    "dist",
    "dx.config.ts",
    "src"
  ],
  "dependencies": {
    "@dxos/app-framework": "workspace:*",
    "@dxos/app-graph": "workspace:*",
    "@dxos/app-toolkit": "workspace:*",
    "@dxos/echo": "workspace:*",
    "@dxos/echo-react": "workspace:*",
    "@dxos/graph": "workspace:*",
    "@dxos/log": "workspace:*",
    "@dxos/plugin-client": "workspace:*",
    "@dxos/plugin-space": "workspace:*",
    "@dxos/plugin-status-bar": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/ui-types": "workspace:*",
    "@dxos/util": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@tauri-apps/api": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@dxos/plugin-testing": "workspace:*",
    "@dxos/react-client": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:",
    "ws": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
