{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "mdl",
  "rules": {
    "block": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "header"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_line"
          }
        }
      ]
    },
    "header": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_header_start"
        },
        {
          "type": "FIELD",
          "name": "type",
          "content": {
            "type": "SYMBOL",
            "name": "block_type"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "id",
              "content": {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_header_id"
                },
                "named": true,
                "value": "identifier"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "label",
              "content": {
                "type": "SYMBOL",
                "name": "label"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SEQ",
                  "members": [
                    {
                      "type": "ALIAS",
                      "content": {
                        "type": "SYMBOL",
                        "name": "_header_colon"
                      },
                      "named": false,
                      "value": ":"
                    },
                    {
                      "type": "CHOICE",
                      "members": [
                        {
                          "type": "SYMBOL",
                          "name": "_space"
                        },
                        {
                          "type": "BLANK"
                        }
                      ]
                    },
                    {
                      "type": "CHOICE",
                      "members": [
                        {
                          "type": "FIELD",
                          "name": "title",
                          "content": {
                            "type": "SYMBOL",
                            "name": "title"
                          }
                        },
                        {
                          "type": "BLANK"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "ALIAS",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_header_comment"
                  },
                  "named": true,
                  "value": "comment"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "_header_id": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[ \\t]+[^\\s:#]+"
        }
      }
    },
    "label": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[ \\t]+[^\\s:#][^\\n:#]*"
        }
      }
    },
    "_header_colon": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[ \\t]*:"
      }
    },
    "_header_comment": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[ \\t]*#[^\\n]*"
      }
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "field"
        },
        {
          "type": "SYMBOL",
          "name": "comment_line"
        },
        {
          "type": "SYMBOL",
          "name": "list_item"
        },
        {
          "type": "SYMBOL",
          "name": "text_line"
        },
        {
          "type": "SYMBOL",
          "name": "_blank_line"
        }
      ]
    },
    "field": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_field_start"
        },
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "SYMBOL",
            "name": "key"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_space"
                },
                {
                  "type": "FIELD",
                  "name": "id",
                  "content": {
                    "type": "SYMBOL",
                    "name": "identifier"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "?"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "value",
              "content": {
                "type": "SYMBOL",
                "name": "value"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "comment_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_comment_start"
        },
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "list_item": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_item_start"
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "value",
              "content": {
                "type": "SYMBOL",
                "name": "value"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "text_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_text_start"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "_blank_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_blank_start"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_space"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_eol"
        }
      ]
    },
    "value": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_inline"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "STRING",
              "value": "#"
            },
            "named": true,
            "value": "word"
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_space"
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "comment"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "text": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_inline"
          },
          {
            "type": "SYMBOL",
            "name": "_space"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "STRING",
              "value": "#"
            },
            "named": true,
            "value": "word"
          }
        ]
      }
    },
    "_inline": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "source_key"
        },
        {
          "type": "SYMBOL",
          "name": "spec_ref"
        },
        {
          "type": "SYMBOL",
          "name": "actor"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "word"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "|"
          },
          "named": true,
          "value": "operator"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "["
              },
              {
                "type": "STRING",
                "value": "]"
              }
            ]
          },
          "named": true,
          "value": "bracket"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": ","
          },
          "named": true,
          "value": "delimiter"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[:?]"
          },
          "named": true,
          "value": "word"
        }
      ]
    },
    "block_type": {
      "type": "PATTERN",
      "value": "[A-Za-z][\\w-]*"
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Za-z0-9$][\\w.$-]*"
    },
    "key": {
      "type": "PATTERN",
      "value": "[A-Za-z_][\\w-]*"
    },
    "title": {
      "type": "PATTERN",
      "value": "[^\\n]+"
    },
    "comment": {
      "type": "PATTERN",
      "value": "#[^\\n]*"
    },
    "source_key": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "github:[\\w.-]+\\/[\\w.-]+\\/[\\w./@+-]*[\\w/@+-](#[\\w$.-]*[\\w$])?"
        }
      }
    },
    "spec_ref": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[a-z][a-z0-9-]*(\\.[a-zA-Z0-9-]+)+#[\\w$.-]*\\w"
        }
      }
    },
    "actor": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "(user|agent):[^\\s,\\]]+"
        }
      }
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "\\d+(\\.\\.\\d+)?"
        }
      }
    },
    "word": {
      "type": "PATTERN",
      "value": "[^\\s\\[\\],|#:?]+"
    },
    "_space": {
      "type": "PATTERN",
      "value": "[ \\t]+"
    },
    "_eol": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_header_start"
    },
    {
      "type": "SYMBOL",
      "name": "_field_start"
    },
    {
      "type": "SYMBOL",
      "name": "_comment_start"
    },
    {
      "type": "SYMBOL",
      "name": "_item_start"
    },
    {
      "type": "SYMBOL",
      "name": "_text_start"
    },
    {
      "type": "SYMBOL",
      "name": "_blank_start"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}
