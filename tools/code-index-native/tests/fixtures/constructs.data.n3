@prefix u: <urn:u#>.
<urn:node:1> u:p <urn:node:1>, <urn:node:2>.
<urn:node:1> u:q u:k1.
<urn:node:2> u:p <urn:node:3>.
<urn:node:2> u:q u:k1, u:k3.
<urn:node:3> u:p u:k2.
<urn:node:3> u:q <urn:node:4>, u:k2.
<urn:node:4> u:q <urn:node:2>.
<urn:node:5> u:p <urn:node:2>.
<urn:node:6> u:p <urn:node:7>.
<urn:node:7> u:p <urn:node:6>.
<urn:node:8> u:q <urn:node:7>.
