{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "`",
      "close": "`"
    },
    {
      "open": "\"",
      "close": "\""
    }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["`", "`"],
    ["\"", "\""],
    ["_", "_"],
    ["*", "*"]
  ],
  "folding": {
    "offSide": true,
    "markers": {
      "start": "^\\s*(?:(?:`{3,}|~{3,})\\s*[\\w-]+|<!--\\s*#?region\\b.*-->)",
      "end": "^\\s*(?:(?:`{3,}|~{3,})\\s*$|<!--\\s*#?endregion\\b.*-->)"
    }
  },
  "wordPattern": "[\\w][\\w.-]*"
}
