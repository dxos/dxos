{
  "name": "vscode-mdl",
  "displayName": "DEUS MDL",
  "version": "0.2.0",
  "private": true,
  "description": "DEUS `.mdl` specs: syntax highlighting, lint, completion, go-to-definition, links, hovers and review verdicts.",
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "MIT",
  "author": "info@dxos.org",
  "publisher": "dxos",
  "type": "module",
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:mdl"
  ],
  "contributes": {
    "grammars": [
      {
        "language": "mdl",
        "scopeName": "text.html.markdown.mdl",
        "path": "./syntaxes/mdl.tmLanguage.json"
      },
      {
        "scopeName": "markdown.mdl.codeblock",
        "path": "./syntaxes/mdl-codeblock.tmLanguage.json",
        "injectTo": [
          "text.html.markdown",
          "text.html.markdown.mdl"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.mdl": "mdl-block"
        }
      },
      {
        "language": "mdl-block",
        "scopeName": "source.mdl-block",
        "path": "./syntaxes/mdl-block.tmLanguage.json"
      }
    ],
    "languages": [
      {
        "id": "mdl",
        "aliases": [
          "DEUS MDL",
          "mdl"
        ],
        "extensions": [
          ".mdl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "mdl-block",
        "aliases": [
          "DEUS MDL block"
        ],
        "configuration": "./language-configuration.block.json"
      }
    ],
    "commands": [
      {
        "command": "mdl.restartServer",
        "title": "Restart Language Server",
        "category": "MDL"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mdl.restartServer",
          "when": "editorLangId == mdl"
        }
      ]
    },
    "configuration": {
      "title": "DEUS MDL",
      "properties": {
        "mdl.review.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show each reviewed item's verdict and the code it cites as code lenses above its declaration (from the `<SPEC>.review.mdl` beside the spec)."
        },
        "mdl.review.inlayHints": {
          "type": "boolean",
          "default": false,
          "description": "Show the same verdict chips as inlay hints at the end of the declaration line."
        },
        "mdl.review.gutter": {
          "type": "boolean",
          "default": true,
          "description": "Colour each reviewed item's line in the margin and the overview ruler by its verdict."
        },
        "mdl.server.path": {
          "type": "string",
          "default": "",
          "description": "Run this language server script instead of the bundled one, e.g. a local build of `tools/mdl-language-server/dist/server.cjs`."
        },
        "mdl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the language server."
        }
      }
    }
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "devDependencies": {
    "@dxos/mdl-language-server": "workspace:*",
    "@types/vscode": "catalog:",
    "@vscode/vsce": "catalog:",
    "esbuild": "catalog:",
    "shiki": "catalog:",
    "tm-grammars": "catalog:",
    "vitest": "catalog:",
    "vscode-oniguruma": "catalog:",
    "vscode-textmate": "catalog:"
  },
  "dependencies": {
    "vscode-languageclient": "catalog:"
  }
}
