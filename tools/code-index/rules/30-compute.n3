# Operations, their handlers, and the skills that expose them (`@dxos/compute`).

@prefix deus: <https://dxos.org/vocab/deus#>.
@prefix handlerSet: <https://dxos.org/deus/module/@dxos/compute/OperationHandlerSet#>.
@prefix operation: <https://dxos.org/deus/module/@dxos/compute/Operation#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix skill: <https://dxos.org/deus/module/@dxos/compute/Skill#>.

# `Operation.make({ … })`.
{ ?s deus:constructedBy operation:make } => { ?s rdf:type deus:Operation }.

# A handler is an operation piped through `Operation.withHandler`, so it names the operation it
# implements: `SentenceNormalization.pipe(Operation.withHandler(fn))`.
{
  ?s deus:pipedThrough operation:withHandler.
  ?s deus:derivedFrom ?operation.
} => {
  ?s rdf:type deus:OperationHandler.
  ?s deus:implementsOperation ?operation.
}.

# Handler sets bundle handlers; the members they reference are their implementation.
{ ?s deus:constructedBy handlerSet:make } => { ?s rdf:type deus:OperationHandlerSet }.
{ ?s deus:constructedBy handlerSet:merge } => { ?s rdf:type deus:OperationHandlerSet }.
{
  ?s rdf:type deus:OperationHandlerSet.
  ?s deus:implDependsOn ?handler.
  ?handler rdf:type deus:OperationHandler.
} => {
  ?s deus:bundlesHandler ?handler.
}.

# `Skill.make({ tools: Skill.toolDefinitions({ operations: [...] }) })` — the operations a skill
# names are ordinary implementation references, so the join is enough to find them.
{ ?s deus:constructedBy skill:make } => { ?s rdf:type deus:Skill }.
{
  ?s rdf:type deus:Skill.
  ?s deus:implDependsOn ?operation.
  ?operation rdf:type deus:Operation.
} => {
  ?s deus:exposesOperation ?operation.
}.
# Skills name operations through a barrel as often as not.
{
  ?s rdf:type deus:Skill.
  ?s deus:implDependsOn ?alias.
  ?alias deus:aliasOf ?operation.
  ?operation rdf:type deus:Operation.
} => {
  ?s deus:exposesOperation ?operation.
}.
