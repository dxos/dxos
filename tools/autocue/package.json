{
  "name": "@dxos/autocue",
  "version": "0.16.0",
  "private": true,
  "description": "autocue's browser UI: the Frame overlay injected into recorded pages, the Player for autocue bundles, the Grid showcase, and the DXOS ident compositions for Remotion.",
  "homepage": "https://dxos.org",
  "bugs": "https://github.com/dxos/dxos/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dxos/dxos"
  },
  "license": "FSL-1.1-Apache-2.0",
  "author": "info@dxos.org",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/lib/index.mjs"
    },
    "./player": {
      "source": "./src/player/index.ts",
      "types": "./dist/types/src/player/index.d.ts",
      "import": "./dist/lib/player.mjs"
    },
    "./grid": {
      "source": "./src/components/Grid/index.ts",
      "types": "./dist/types/src/components/Grid/index.d.ts",
      "import": "./dist/lib/grid.mjs"
    },
    "./ident": {
      "source": "./src/components/Ident/index.ts",
      "types": "./dist/types/src/components/Ident/index.d.ts",
      "import": "./dist/lib/ident.mjs"
    }
  },
  "types": "dist/types/src/index.d.ts",
  "typesVersions": {
    "*": {
      "player": [
        "dist/types/src/player/index.d.ts"
      ],
      "grid": [
        "dist/types/src/components/Grid/index.d.ts"
      ],
      "ident": [
        "dist/types/src/components/Ident/index.d.ts"
      ]
    }
  },
  "files": [
    "dist/lib",
    "dist/types",
    "src"
  ],
  "dependencies": {
    "@dxos/brand": "workspace:*",
    "@dxos/plugin-deck": "workspace:*",
    "@dxos/react-ui-canvas": "workspace:*",
    "@fontsource/poiret-one": "catalog:",
    "@remotion/fonts": "catalog:",
    "@remotion/motion-blur": "catalog:",
    "@remotion/player": "catalog:",
    "remotion": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@dxos/node-std": "workspace:*",
    "@dxos/react-ui": "workspace:*",
    "@dxos/react-ui-attention": "workspace:*",
    "@dxos/react-ui-dnd": "workspace:*",
    "@dxos/ui-theme": "workspace:*",
    "@dxos/vite-plugin-import-source": "workspace:*",
    "@phosphor-icons/core": "catalog:",
    "@remotion/bundler": "catalog:",
    "@remotion/cli": "catalog:",
    "@remotion/renderer": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@dxos/react-ui": "workspace:^",
    "@dxos/react-ui-attention": "workspace:^",
    "@dxos/react-ui-dnd": "workspace:^",
    "@dxos/ui-theme": "workspace:^",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
