{
  "name": "client-metrics-vibptxv0",
  "schemaVersion": "v6",
  "image": "/assets/Icons/eight-ball",
  "tags": [
    {
      "key": "tag",
      "value": "dxos"
    },
    {
      "key": "tag",
      "value": "client"
    }
  ],
  "spec": {
    "display": {
      "name": "Client Metrics",
      "description": "Per-client SDK metrics from @dxos/observability. Gauges are read at collection time and exported every 60s, so every panel aggregates ACROSS clients: avg/p90/max answer \"what does a typical or bad client look like\", sum answers \"how much is out there in total\". ctx.tag isolates a single local run from deployed traffic."
    },
    "duration": "",
    "refreshInterval": "",
    "links": [],
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "deployment.environment",
          "display": {
            "name": "deployment.environment",
            "description": "Deployment environment; local runs report 'unknown' unless DX_ENVIRONMENT is set."
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "capturingRegexp": "",
          "customAllValue": "",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "deployment.environment",
              "signal": "metrics"
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "ctx.tag",
          "display": {
            "name": "ctx.tag",
            "description": "Client tag from DX_TELEMETRY_TAG; use it to isolate one run."
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "capturingRegexp": "",
          "customAllValue": "",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "signoz/DynamicVariable",
            "spec": {
              "name": "ctx.tag",
              "signal": "metrics"
            }
          }
        }
      }
    ],
    "panels": {
      "stat-spaces": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Spaces per client (avg)",
            "description": ""
          },
          "links": [],
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "formatting": {
                "decimalPrecision": "1",
                "unit": "none"
              },
              "thresholds": null,
              "visualization": {
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "signal": "metrics",
                    "aggregations": [
                      {
                        "metricName": "dxos.client.spaces.count",
                        "reduceTo": "last",
                        "spaceAggregation": "avg",
                        "temporality": "",
                        "timeAggregation": "avg"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "deployment.environment in $deployment.environment AND ctx.tag in $ctx.tag"
                    },
                    "functions": [],
                    "groupBy": [],
                    "having": {
                      "expression": ""
                    },
                    "legend": "",
                    "name": "A",
                    "order": [],
                    "source": ""
                  }
                }
              }
            }
          ]
        }
      },
      "stat-docs": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Documents loaded per client (avg)",
            "description": "location=local \u2014 the resident document count."
          },
          "links": [],
          "plugin": {
            "kind": "signoz/NumberPanel",
