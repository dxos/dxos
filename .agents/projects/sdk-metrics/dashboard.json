                    "disabled": false,
                    "filter": {
                      "expression": "deployment.environment in $deployment.environment AND ctx.tag in $ctx.tag AND location = 'local'"
                    },
                    "functions": [],
                    "groupBy": [],
                    "having": {
                      "expression": ""
                    },
                    "legend": "",
                    "name": "A",
                    "order": [],
                    "source": ""
                  }
                }
              }
            }
          ]
        }
      },
