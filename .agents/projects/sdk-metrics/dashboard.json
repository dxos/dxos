                      "expression": ""
                    },
                    "legend": "",
                    "name": "A",
                    "order": [],
                    "source": ""
                  }
                }
              }
            }
          ]
        }
      },
      "stat-heap-pressure": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Heap pressure (worst client %)",
            "description": "heapUsed / heapSizeLimit. Above ~90% the browser is close to an OOM kill."
          },
          "links": [],
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "formatting": {
                "decimalPrecision": "1",
                "unit": "percent"
              },
              "thresholds": [
                {
                  "color": "Red",
                  "format": "background",
                  "operator": "above",
                  "unit": "percent",
                  "value": 90
                }
              ],
              "visualization": {
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "signal": "metrics",
                          "aggregations": [
                            {
                              "metricName": "dxos.client.runtime.heapUsed",
                              "reduceTo": "last",
                              "spaceAggregation": "max",
                              "temporality": "",
                              "timeAggregation": "max"
                            }
                          ],
                          "disabled": true,
                          "filter": {
                            "expression": "deployment.environment in $deployment.environment AND ctx.tag in $ctx.tag"
                          },
                          "functions": [],
                          "groupBy": [],
                          "having": {
                            "expression": ""
                          },
                          "legend": "used",
                          "name": "A",
                          "order": [],
                          "source": "",
                          "stepInterval": 0
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "signal": "metrics",
                          "aggregations": [
                            {
                              "metricName": "dxos.client.runtime.heapSizeLimit",
                              "reduceTo": "last",
                              "spaceAggregation": "max",
                              "temporality": "",
                              "timeAggregation": "max"
                            }
                          ],
                          "disabled": true,
                          "filter": {
                            "expression": "deployment.environment in $deployment.environment AND ctx.tag in $ctx.tag"
                          },
                          "functions": [],
                          "groupBy": [],
                          "having": {
                            "expression": ""
                          },
                          "legend": "limit",
                          "name": "B",
                          "order": [],
                          "source": "",
                          "stepInterval": 0
                        }
                      },
                      {
                        "type": "builder_formula",
                        "spec": {
                          "disabled": false,
                          "expression": "A / B * 100",
                          "functions": null,
                          "having": {
                            "expression": ""
                          },
                          "legend": "heap pressure %",
                          "name": "F1",
                          "order": null
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
