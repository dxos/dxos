---
import Default from '@astrojs/starlight/components/Footer.astro';

import logoBlack from '../../node_modules/@dxos/brand/assets/logotypes/dxos-horizontal-block.svg?url';
import logoWhite from '../../node_modules/@dxos/brand/assets/logotypes/dxos-horizontal-white.svg?url';
import { siteLinks } from './site-links.ts';
---
<Default />
<footer class="site-footer">
  <div>
    <a href="/" aria-label="DXOS home">
      <img class="logo on-light" src={logoBlack} alt="DXOS" />
      <img class="logo on-dark" src={logoWhite} alt="DXOS" />
    </a>
  </div>
  <div>
    <h4 class="label-mono">DXOS</h4>
    <ul>
      {siteLinks.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
    </ul>
  </div>
  <div>
    <h4 class="label-mono">Docs</h4>
    <ul>
      <li><a href="/docs/echo/why-echo/">ECHO</a></li>
      <li><a href="/docs/plex/introduction/">Composer</a></li>
      <li><a href="/docs/halo/overview/">HALO</a></li>
    </ul>
  </div>
  <div>
    <h4 class="label-mono">Community</h4>
    <ul>
      <li><a href="https://github.com/dxos/dxos">GitHub</a></li>
      <li><a href="https://dxos.org/discord">Discord</a></li>
    </ul>
  </div>
  <div>
    <h4 class="label-mono">For agents</h4>
    <ul>
      <li><a href="/echo/llms.txt">ECHO llms.txt</a></li>
      <li><a href="/echo/llms-full.txt">ECHO llms-full.txt</a></li>
    </ul>
  </div>
  <div class="legal">
    FSL-1.1-Apache-2.0. Copyright DXOS.org. <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a>
  </div>
</footer>
