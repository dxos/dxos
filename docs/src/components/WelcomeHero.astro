---
import dxos from '../../../packages/ui/brand/assets/backgrounds/bg-dxos.svg?raw';
import { SUITE_BACKGROUNDS } from './topic-nav/suite.ts';

/** Keyed by the `welcome.background` values that `content.config.ts` allows; each suite hero has its mark on the right. */
const BACKGROUNDS = { dxos, ...SUITE_BACKGROUNDS } as const;

type Props = {
  /** Product name shown as the page's heading, e.g. `ECHO`; the frontmatter title only labels the sidebar and tab. */
  section: string;
  tagline: string;
  background: keyof typeof BACKGROUNDS;
};

const { section, tagline, background } = Astro.props;

// Inlined, so the art paints with the page and costs no request; `slice` fills the banner at any aspect ratio, and
// `xMax` crops from the left so the icon on the right edge stays whole.
const art = BACKGROUNDS[background].replace('<svg ', '<svg preserveAspectRatio="xMaxYMid slice" aria-hidden="true" ');
---

<header class="welcome-hero">
  <div class="art" set:html={art} />
  <div class="text">
    <!-- Starlight's skip link and the TOC's "Overview" entry target the page title by this id. -->
    <h1 id="_top">{section}</h1>
    <p class="tagline">{tagline}</p>
  </div>
</header>

<style>
  .welcome-hero {
    position: relative;
    /* Top-aligned: while the HTML streams in, lines parsed later extend the text downward instead of pushing what is painted. */
    display: flex;
    align-items: flex-start;
    height: 15rem;
    margin-top: 1rem;
    overflow: hidden;
    border-radius: 0;
    background: rgb(29, 31, 32);
    color: #fff;
  }

  /* The art sits on the right and fades out to the left, so no stroke crosses the text. */
  .art {
    position: absolute;
    inset: 0 0 0 auto;
    width: 60%;
    mask-image: linear-gradient(to right, transparent, black 40%);
  }

  .art :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .text {
    position: relative;
    max-width: 55%;
    padding: 1.5rem;
  }

  /* By id, to outrank the theme's `h1#_top`, which colors the title for the page ground rather than this dark banner. */
  .welcome-hero #_top {
    margin: 0;
    font-family: 'Sharp Sans', var(--sl-font);
    font-weight: 500;
    font-size: 4.5rem;
    line-height: 1;
    letter-spacing: 0.08em;
    /* The name is one word; in a narrow banner it runs onto the art's faded edge rather than breaking. */
    white-space: nowrap;
    color: #fff;
  }

  .tagline {
    margin: 0.5rem 0 0;
    font-size: var(--sl-text-lg);
    color: rgb(255 255 255 / 0.85);
  }

  /* Light: the art's ground is the page's own, as the dark banner's is in dark mode, so the hero blends in; its lines keep the section's color. */
  :global(:root[data-theme='light']) .welcome-hero {
    --dx-bg-fill: var(--c-bg);
    --dx-bg-icon: var(--c-fg);
    background: var(--c-bg);
  }

  :global(:root[data-theme='light']) .welcome-hero #_top {
    color: var(--c-fg);
  }

  :global(:root[data-theme='light']) .tagline {
    color: var(--c-muted);
  }

  @media (max-width: 50rem) {
    .welcome-hero {
      height: 12rem;
    }

    /* A phone has no room beside the text, so the art spans the banner, dimmed behind it. */
    .art {
      width: 100%;
      mask-image: none;
      opacity: 0.3;
    }

    .text {
      max-width: none;
      padding: 1rem;
    }

    .welcome-hero #_top {
      font-size: 3rem;
    }

    .tagline {
      font-size: var(--sl-text-base);
    }
  }
</style>
