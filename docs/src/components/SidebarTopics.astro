---
import { Badge, Icon } from '@astrojs/starlight/components';

import { TOPICS } from './topic-nav/topics.ts';

/** Brand logotypes by topic link; a topic without one falls back to its Starlight `icon` and label. */
const LOGOTYPES: Record<string, string> = Object.fromEntries(
  TOPICS.flatMap(({ href, logotype }) => (href && logotype ? [[href, logotype]] : [])),
);

const { topics } = Astro.locals.starlightSidebarTopics;
---

<ul class="sidebar-topics">
  {
    topics.map((topic) => {
      const { class: className, ...attrs } = topic.attrs || {};
      const logotype = LOGOTYPES[topic.link];
      return (
        <li>
          <a {...attrs} href={topic.link} class:list={[{ current: topic.isCurrent }, className]}>
            {logotype ? (
              <div class="logotype">
                <Fragment set:html={logotype} />
              </div>
            ) : (
              <>
                {topic.icon && (
                  <div class="icon">
                    <Icon name={topic.icon} />
                  </div>
                )}
                <span>{topic.label}</span>
              </>
            )}
            <div>
              {logotype && <span class="sr-only">{topic.label}</span>}
              {topic.badge && (
                <>
                  {' '}
                  <Badge class="badge" text={topic.badge.text} variant={topic.badge.variant} />
                </>
              )}
            </div>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  ul {
    list-style: none;
    padding: 0;
  }

  ul::after {
    content: '';
    display: block;
    margin-top: 1rem;
    height: 1px;
    border-top: 1px solid var(--sl-color-hairline-light);
  }

  li {
    overflow-wrap: anywhere;
  }

  li + li {
    margin-top: 0.25rem;
  }

  a {
    align-items: center;
    color: var(--sl-color-white);
    display: flex;
    font-size: var(--sl-text-base);
    font-weight: 600;
    gap: 0.5rem;
    line-height: 1.5;
    padding: 0.3em 0.5rem;
    text-decoration: none;
  }

  /* Follows the header logotype, which sits 1% of the page plus 16px from the edge, so the marks line up under it. */
  @media (min-width: 50rem) {
    a {
      padding-inline-start: calc(0.5rem + 1vw - 13.8px);
    }
  }

  a:is(.current, :hover, :focus-visible) {
    color: var(--sl-color-accent-high);
  }

  :global([data-theme='light']) a.current {
    color: var(--sl-color-accent);
  }

  /* The logotype takes the label's color, so active, hover and idle states need no rules of their own. */
  .icon,
  .logotype {
    align-items: center;
    display: flex;
  }

  /* Sized so the mark is 28px tall: it fills 962 × 0.64 of the logotype's 1024-unit height. */
  .logotype :global(svg) {
    fill: currentColor;
    height: 46.6px;
    width: auto;
    /* The view box leaves 9px above and below the mark. */
    margin-block: -8px;
  }

  .badge {
    margin-inline-start: 0.25em;
  }
</style>
