---
import { NARRATIVES } from '../demos/narratives.ts';

interface Props {
  /** The demo's id in `DEMOS`. */
  id: string;
}

const { id } = Astro.props;
const narrative = NARRATIVES[id];
---

<h3>{narrative.title}</h3>
<p set:html={narrative.plugins} />
<!-- The demo runs on its own page so that its CSS stays off the docs pages; see `pages/embed/demo.astro`. -->
<div class="demo-embed dx-wide not-content" role="status">
  <span>Loading live demo…</span>
  <iframe data-src={`/embed/demo/?id=${id}`} title={narrative.title}></iframe>
</div>

<script>
  import { DEMO_READY } from '../demos/frames.ts';

  // A frame shares the page's main thread, so its demos load one at a time, each once the one before it shows its
  // content: the one in view first, then the rest in page order. A demo scrolled into view loads at once unless the
  // one loading is in view too.
  const TURN_TIMEOUT = 20_000;
  const waiting = [...document.querySelectorAll<HTMLIFrameElement>('.demo-embed > iframe[data-src]')];
  const loading = new Set<HTMLIFrameElement>();
  /** How much of the frame's height is in view. */
  const shown = (frame: HTMLIFrameElement) => {
    const rect = frame.getBoundingClientRect();
    return Math.max(0, Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, 0)) / rect.height;
  };
  const inView = (frame: HTMLIFrameElement) => shown(frame) > 0;
  const mostInView = () => [...waiting].sort((a, b) => shown(b) - shown(a))[0];
  const idle = (callback: () => void) =>
    typeof requestIdleCallback === 'function' ? requestIdleCallback(callback, { timeout: 2_000 }) : setTimeout(callback, 200);

  const load = (frame: HTMLIFrameElement) => {
    waiting.splice(waiting.indexOf(frame), 1);
    loading.add(frame);
    const release = () => {
      clearTimeout(timeout);
      window.removeEventListener('message', onReady);
      if (loading.delete(frame)) {
        // The frame reports on mount, before it paints; let that finish first.
        idle(next);
      }
    };
    const onReady = (event: MessageEvent) => {
      if (event.source === frame.contentWindow && event.data?.type === DEMO_READY) {
        release();
      }
    };
    const timeout = setTimeout(release, TURN_TIMEOUT);
    window.addEventListener('message', onReady);
    frame.addEventListener('load', () => frame.closest('.demo-embed')?.removeAttribute('role'), { once: true });
    frame.src = frame.dataset.src!;
  };

  const next = () => {
    if (loading.size === 0 && waiting.length > 0) {
      load(waiting.some(inView) ? mostInView() : waiting[0]);
    }
  };

  const observer = new IntersectionObserver(() => {
    if (waiting.some(inView) && ![...loading].some(inView)) {
      load(mostInView());
    }
  });
  waiting.forEach((frame) => observer.observe(frame));
  next();
</script>

<style>
  .demo-embed {
    display: grid;
    width: 100%;
    height: 32rem;
    margin-block: 1rem 2rem;
    border-radius: var(--c-radius);
    overflow: hidden;
  }

  .demo-embed > * {
    grid-area: 1 / 1;
  }

  .demo-embed > span {
    place-self: center;
    color: var(--sl-color-gray-3);
  }

  .demo-embed > iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
