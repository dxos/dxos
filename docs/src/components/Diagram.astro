---
interface Props {
  name: string;
  alt: string;
  /** Draws the diagram on a dark ground in both themes, for a page that is always dark. */
  dark?: boolean;
}

const { name, alt, dark } = Astro.props;
const urls = import.meta.glob<string>('../assets/diagrams/*.dx.svg', { query: '?url', import: 'default', eager: true });
const sources = import.meta.glob<string>('../assets/diagrams/*.dx.svg', { query: '?raw', import: 'default', eager: true });
const path = `../assets/diagrams/${name}.dx.svg`;
if (!urls[path]) {
  throw new Error(`Unknown diagram: ${name}`);
}

// The renderer tags elements with Tailwind `dark:` variants but compiles only the light rules; these supply the dark
// ones on the given ground. The SVG is an image, so the page's CSS variables cannot reach it.
const darkRules = (ground: string) => `
  svg { color: #e5e5e5; background: ${ground}; --surface-bg: ${ground}; }
  .dark\\:fill-neutral-200 { fill: #e5e5e5; }
  .dark\\:fill-neutral-800 { fill: #262626; }
  .dark\\:text-neutral-500 { color: #737373; }
  .dark\\:stroke-neutral-200 { stroke: #e5e5e5; }
  .dark\\:text-neutral-200 { color: #e5e5e5; }
  .dark\\:text-neutral-400 { color: #a3a3a3; }
`;
const darkSrc = (ground: string) =>
  `data:image/svg+xml,${encodeURIComponent(sources[path].replace('</style>', `${darkRules(ground)}</style>`))}`;
---
{
  dark ? (
    <img class="diagram diagram--always-dark" src={darkSrc('oklch(0.205 0.001 190)')} alt={alt} />
  ) : (
    <>
      <img class="diagram diagram--light" src={urls[path]} alt={alt} />
      <img class="diagram diagram--dark" src={darkSrc('#1d1f20')} alt={alt} />
    </>
  )
}
