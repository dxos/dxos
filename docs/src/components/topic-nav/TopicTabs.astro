---
// Variant "tabs": a row of topic tabs under the header bar, like a product switcher.
import { TOPICS, currentTopic } from './topics.ts';

const topic = currentTopic(Astro.url.pathname);
---

<nav class="topic-tabs" aria-label="Docs topics">
  {
    TOPICS.map((item) =>
      item.href ? (
        <a href={item.href} class:list={{ current: item.id === topic?.id }} aria-current={item.id === topic?.id ? 'page' : undefined}>
          {item.label}
        </a>
      ) : (
        <span class="soon" aria-disabled="true" title="Coming soon">
          {item.label}
        </span>
      ),
    )
  }
</nav>

<style>
  .topic-tabs {
    align-items: stretch;
    border-top: 1px solid var(--sl-color-hairline-light);
    display: flex;
    gap: 1.5rem;
    height: var(--topic-tabs-height);
    inset-inline: 0;
    overflow-x: auto;
    padding-inline: var(--sl-nav-pad-x);
    position: absolute;
    bottom: 0;
    scrollbar-width: none;
  }
  @media (min-width: 50rem) {
    .topic-tabs {
      padding-inline-start: calc(var(--sl-nav-pad-x) + 0.25rem);
    }
  }
  a,
  span {
    align-items: center;
    border-bottom: 2px solid transparent;
    display: flex;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: -1px;
    white-space: nowrap;
  }
  a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  a:hover {
    color: var(--sl-color-white);
  }
  a.current {
    border-bottom-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .soon {
    color: var(--sl-color-gray-4);
    cursor: default;
  }
</style>
