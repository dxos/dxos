---
// Exploration: picks a topic-nav design from `?nav=` or the last choice before first paint, on docs and marketing pages.
import { DEFAULT_NAV_VARIANT, NAV_VARIANTS } from './topics.ts';

/** Shows `[data-nav-only~=id]` and hides `[data-nav-hide~=id]` under the chosen design; tabs also deepen the header. */
const TOPIC_NAV_CSS = [
  'div[data-nav-only], div[data-nav-hide] { display: contents; }',
  ...NAV_VARIANTS.map(
    ({ id }) =>
      `html[data-topic-nav='${id}'] [data-nav-only]:not([data-nav-only~='${id}']), ` +
      `html[data-topic-nav='${id}'] [data-nav-hide~='${id}'] { display: none !important; }`,
  ),
  `html[data-topic-nav='tabs'] { --topic-tabs-height: 2.75rem; --sl-nav-height: calc(3.5rem + var(--topic-tabs-height)); }`,
  `@media (min-width: 50rem) { html[data-topic-nav='tabs'] { --sl-nav-height: calc(4rem + var(--topic-tabs-height)); } }`,
  // The Effect designs match the marketing nav's 72px bar (plus Starlight's 1px border), so Docs sits at the same height on both sides.
  `@media (min-width: 50rem) { html[data-topic-nav^='effect'] { --sl-nav-height: 73px; } }`,
  `html[data-topic-nav='tabs'] body > .page > header { padding-bottom: calc(var(--sl-nav-pad-y) + var(--topic-tabs-height)); }`,
].join('\n');
---

<script is:inline define:vars={{ variants: NAV_VARIANTS.map(({ id }) => id), fallback: DEFAULT_NAV_VARIANT }}>
  {
    let stored = null;
    try {
      stored = localStorage.getItem('dx-topic-nav');
    } catch {}
    const asked = new URLSearchParams(location.search).get('nav');
    const variant = [asked, stored].find((id) => variants.includes(id)) ?? fallback;
    if (asked === variant) {
      try {
        localStorage.setItem('dx-topic-nav', variant);
      } catch {}
    }
    document.documentElement.dataset.topicNav = variant;
  }
</script>
<style is:inline set:html={TOPIC_NAV_CSS} />
