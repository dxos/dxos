---
// Variant "logo-menu": the current topic replaces the top-left logo and opens a menu of every topic.
import dxosMark from '../../../../packages/ui/brand/assets/logotypes/dxos-logo-black.svg?raw';
import TopicList from './TopicList.astro';
import TopicMark from './TopicMark.astro';
import { currentTopic } from './topics.ts';

const topic = currentTopic(Astro.url.pathname);
---

<details class="topic-menu" data-topic-popover>
  <summary>
    <span class="dxos" aria-label="DXOS"><Fragment set:html={dxosMark} /></span>
    <span class="slash" aria-hidden="true">/</span>
    {topic ? <TopicMark topic={topic} size={24} /> : <span class="docs">Docs</span>}
    <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
  </summary>
  <div class="panel">
    <TopicList current={topic?.id} />
    <a class="home" href="/">← dxos.org</a>
  </div>
</details>

<style>
  .topic-menu {
    position: relative;
  }
  summary {
    align-items: center;
    border-radius: 0.5rem;
    color: var(--sl-color-white);
    cursor: pointer;
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0.25rem 0.5rem 0.25rem 0.25rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover,
  .topic-menu[open] summary {
    background: var(--sl-color-gray-6);
  }
  .dxos :global(svg) {
    display: block;
    fill: currentColor;
    height: 1.75rem;
    width: 1.75rem;
  }
  .slash {
    color: var(--sl-color-gray-4);
    font-size: 1.25rem;
    font-weight: 300;
  }
  .docs {
    font-weight: 600;
  }
  .chevron {
    fill: none;
    height: 1rem;
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.5;
    transition: transform 120ms;
    width: 1rem;
  }
  .topic-menu[open] .chevron {
    transform: rotate(180deg);
  }
  .panel {
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.75rem;
    box-shadow: var(--sl-shadow-lg);
    display: grid;
    gap: 0.5rem;
    inset-inline-start: 0;
    padding: 0.5rem;
    position: absolute;
    top: calc(100% + 0.5rem);
    width: 20rem;
    z-index: 100;
  }
  .home {
    border-top: 1px solid var(--sl-color-hairline-light);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    padding: 0.5rem 0.625rem 0.25rem;
    text-decoration: none;
  }
  .home:hover {
    color: var(--sl-color-white);
  }
</style>
