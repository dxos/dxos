---
// The docs header's left side: the logo and Docs where the marketing nav has them, a separator, then the topic picker.
// The docs home lists every topic itself, so it has no picker [D-278].
import DxosLogo from '../svg/DxosLogo.astro';
import TopicList from './TopicList.astro';
import TopicMark from './TopicMark.astro';
import { currentTopic } from './topics.ts';

const topic = currentTopic(Astro.url.pathname);
const isHome = Astro.url.pathname.replace(/\/$/, '') === '/docs';
---

<div class="topic-nav">
  <a class="logo" href="/" aria-label="DXOS home"><DxosLogo /></a>
  <a class="docs" href="/docs/" aria-current="page">Docs</a>
  {
    !isHome && (
      <>
        <span class="sep" aria-hidden="true" />
        <details class="picker">
          <summary>
            {topic ? <TopicMark topic={topic} size={20} /> : <span>Topics</span>}
            <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M5 6.5l3-3 3 3M5 9.5l3 3 3-3" />
            </svg>
          </summary>
          <div class="panel">
            <TopicList current={topic?.id} />
          </div>
        </details>
      </>
    )
  }
</div>

<!-- Non-blocking: a pending stylesheet here stalls the parser, and Firefox paints the half-parsed page. -->
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@400&display=swap"
  media="print"
  onload="this.media='all'"
/>

<script>
  // Closes the picker on a click outside it or on Escape.
  const picker = document.querySelector<HTMLDetailsElement>('.topic-nav .picker');
  document.addEventListener('click', (event) => {
    if (picker?.open && !picker.contains(event.target as Node)) {
      picker.open = false;
    }
  });
  document.addEventListener('keydown', (event) => {
    if (picker?.open && event.key === 'Escape') {
      picker.open = false;
    }
  });
</script>

<style>
  .topic-nav {
    align-items: center;
    display: flex;
    flex: none;
    /* Pixels throughout: the marketing nav is laid out on a 16px root, the docs on 17px. */
    gap: 16px;
    /*
     * The same logo and Docs at the marketing nav's spots, so neither moves when crossing into the docs: the logo
     * 1% + 16px from the edge, the Docs text a 16px gap and 16px link padding past it.
     */
    margin-inline-start: calc(1vw + 16px - var(--sl-nav-pad-x));
  }
  .logo {
    color: var(--sl-color-white);
    display: flex;
  }
  .logo :global(svg) {
    display: block;
    height: 30px;
    width: 89px;
  }
  .docs {
    color: var(--sl-color-white);
    font: 400 16px / 24px 'Kumbh Sans', sans-serif;
    margin-inline-start: 16px;
    padding: 8px 0;
    text-decoration: none;
  }
  .sep {
    background: var(--sl-color-gray-5);
    height: 1.5rem;
    width: 1px;
  }
  /* The topic you are reading is the one thing in the bar in the accent. */
  summary > :global(:first-child) {
    color: var(--sl-color-text-accent);
  }
  .picker {
    position: relative;
  }
  summary {
    align-items: center;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0;
    color: var(--sl-color-white);
    cursor: pointer;
    display: flex;
    gap: 0.75rem;
    list-style: none;
    padding: 0.375rem 0.625rem 0.375rem 0.75rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover,
  .picker[open] summary {
    background: var(--sl-color-gray-6);
  }
  .chevron {
    fill: none;
    height: 1rem;
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.5;
    width: 1rem;
  }
  .panel {
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0;
    box-shadow: var(--sl-shadow-lg);
    left: 0;
    padding: 0.375rem;
    position: absolute;
    top: calc(100% + 0.5rem);
    width: 20rem;
    z-index: 100;
  }

  /* Phones have room for the logo and the picker only; the logo is the way back, and the panel spans the screen. */
  @media (max-width: 49.99rem) {
    .topic-nav {
      margin-inline-start: 0;
    }
    .docs,
    .sep {
      display: none;
    }
    .panel {
      inset-inline: 1rem;
      position: fixed;
      top: calc(var(--sl-nav-height) - 0.25rem);
      width: auto;
      /* Fixed content past the viewport can't be scrolled to, so a short landscape screen scrolls the panel instead. */
      max-height: calc(100dvh - var(--sl-nav-height) - 1rem);
      overflow-y: auto;
    }
  }
</style>
