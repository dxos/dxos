---
// Opens the tutorial app as a new StackBlitz project in its own tab. A form post to stackblitz.com/run is what the
// StackBlitz SDK's `openProject` sends; posting it directly keeps the files in the page, so the tab opens on the click.

import logo from '../assets/brands/stackblitz.svg?raw';
import { type TutorialProjectId, type TutorialProjectKind, tutorialProject } from '../echo/tutorial-project.ts';

type Props = {
  kind: TutorialProjectKind;
  label: string;
  /** The file the editor opens on. */
  file: string;
  /** Whose learning path the app is. */
  project?: TutorialProjectId;
};

const { kind, label, file, project = 'echo' } = Astro.props;

const TITLES: Record<TutorialProjectId, Record<TutorialProjectKind, string>> = {
  echo: { complete: 'ECHO contacts', starter: 'ECHO contacts: follow along' },
  halo: { complete: 'HALO contact book', starter: 'HALO contact book: follow along' },
};

const DESCRIPTIONS: Record<TutorialProjectId, string> = {
  echo: 'The app the ECHO learning path builds.',
  halo: 'The app the HALO learning path builds.',
};

const files = tutorialProject(kind, project);
---

<form
  class="stackblitz not-content"
  method="post"
  target="_blank"
  action={`https://stackblitz.com/run?${new URLSearchParams({ file })}`}
>
  <input type="hidden" name="project[title]" value={TITLES[project][kind]} />
  <input type="hidden" name="project[description]" value={DESCRIPTIONS[project]} />
  <input type="hidden" name="project[template]" value="node" />
  {Object.entries(files).map(([path, content]) => <input type="hidden" name={`project[files][${path}]`} value={content} />)}
  <button type="submit"><Fragment set:html={logo} />{label}</button>
</form>

<style>
  .stackblitz {
    margin-block: 1rem;
  }

  button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--sl-color-text-accent);
    border-radius: 0;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-black);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  button :global(svg) {
    flex: none;
    width: 1.1em;
    height: 1.1em;
  }

  button:hover {
    filter: brightness(1.1);
  }
</style>
