---
import { type Stage } from '../halo-tutorial/stage.ts';
import { type Scene } from '../halo-tutorial/runtime.ts';

interface Props {
  stage: Stage;
  scene: Scene;
}

const { stage, scene } = Astro.props;

/** How many devices each scene shows side by side. */
const DEVICES: Record<Scene, number> = { new: 1, named: 1, invite: 2, book: 3, phone: 2, laptop: 1 };
---

<!-- The app runs on its own page so that its CSS stays off the docs pages; see `pages/embed/halo.astro`. -->
<iframe
  class="halo-embed not-content"
  data-devices={DEVICES[scene]}
  src={`/embed/halo/?${new URLSearchParams({ stage, scene })}`}
  title="The contact book"
  loading="lazy"></iframe>

<style>
  .halo-embed {
    display: block;
    width: 100%;
    height: 24rem;
    margin-block: 1.5rem;
    border: 1px solid var(--c-hairline);
    border-radius: var(--c-radius);
  }

  .halo-embed:not([data-devices='1']) {
    height: 30rem;
  }
</style>
