.worktrees/
.claude/worktrees/

# Claude Code harness session lock — per-machine runtime state, not source.
.claude/scheduled_tasks.lock

# Response-verbosity toggle state — per-user runtime, not repo policy.
.claude/.mode
# The focus pin that rides alongside it — a task, so even less repo policy.
.claude/.focus
# Transitional: pre-rename state file, deleted on first mode.sh run.
.claude/.response-mode

# Logs
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
debug-storybook.log
.log*
debug-storybook.log
# vite-plugin-log dev file sink (default filename is `app.log`), plus rotated captures.
app.log
app.log.*
# vite-plugin-log Vitest NDJSON sink (per-package `test.log`), plus rotated captures.
test.log
test.log.*
# vite-plugin-log Vitest browser NDJSON sink (per-package `test-browser.log`), plus rotated captures.
test-browser.log
test-browser.log.*

# Vitest
vitest-results.json

# Runtime data
*.pid
*.seed
*.pid.lock
*.*~lock~

# Mocha
test-results

# Vitest
__screenshots__

