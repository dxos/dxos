{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "categories": {},
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [
    "*.d.ts",
    "**/*.astro",
    "**/tailwind.ts",
    "**/gen/*",
    "**/src/wasm/**",
    "**/typings/**",
    ".idea/**",
    ".vscode/**",
    ".claude/**",
    "templates/**",
    "scripts/**",
    "docs/legacy/**",
    "docs/public/webflow/**",
    "docs/scripts/**"
  ],
  "jsPlugins": [
    "@dxos/eslint-plugin-rules",
    "eslint-plugin-unused-imports",
    "eslint-plugin-perfectionist",
    {
      "name": "import-x-js",
      "specifier": "eslint-plugin-import-x"
    }
  ],
  "options": {
    "denyWarnings": true,
    "typeAware": true
  },
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-perf",
    "promise",
    "vitest",
    "jsdoc",
    "node",
    "import"
