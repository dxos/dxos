          "tools/code-index/src/webui/Canvas.tsx",
          "tools/code-index/src/webui/Snippet.tsx",
          "tools/code-index/src/webui/react/Diagram.tsx"
        ]
      }
    ],
    "@dxos/eslint-plugin-rules/prefer-sizing-utilities": "warn",
    "@dxos/eslint-plugin-rules/no-empty-promise-catch": "error",
    "@dxos/eslint-plugin-rules/no-similar-sibling-files": [
      "error",
      {
        "allow": [
          "packages/core/compute/assistant-toolkit/src/skills/delegation/operations/delegate-task.test.ts",
          "packages/core/compute/assistant-toolkit/src/skills/delegation/operations/delegate-task.ts",
          "packages/core/compute/assistant-toolkit/src/skills/delegation/operations/delegate-tasks.ts",
          "packages/core/echo/echo-panproto/src/lens/codec.ts",
          "packages/core/echo/echo-panproto/src/lens/codecs.ts",
          "packages/plugins/plugin-assistant/src/components/Chat/Thread.stories.tsx",
          "packages/plugins/plugin-assistant/src/components/Chat/thread.test.ts",
          "packages/plugins/plugin-assistant/src/components/Chat/thread.ts",
          "packages/plugins/plugin-crm/src/operations/EnrichImages.stories.tsx",
          "packages/plugins/plugin-crm/src/operations/enrich-images.test.ts",
          "packages/plugins/plugin-crm/src/operations/enrich-images.ts",
          "packages/plugins/plugin-space/src/types/SpaceCapabilities.ts",
          "packages/plugins/plugin-space/src/types/SpaceCapability.ts",
          "packages/plugins/plugin-support/src/hooks/useTour.tsx",
          "packages/plugins/plugin-support/src/hooks/useTours.ts",
